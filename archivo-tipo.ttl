    skos:prefLabel "SAS"@en,
        "SAS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/sb3> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Scratch 3.0"@en,
        "Scratch 3.0"@es ;
    skos:definition "Scratch 3.0 is a file format used to store exported Scratch 3.0 projects and sprites. These are ZIP archives which contain information encoded in a text-based JSON format and project media in separate files."@en,
        "Scratch 3.0 es un formato de archivo utilizado para almacenar proyectos y sprites exportados de Scratch 3.0. Son archivos ZIP que contienen información codificada en formato JSON basado en texto y medios del proyecto en archivos separados."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SB3>,
        <https://www.iana.org/assignments/media-types/application/x-sb3> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".sprite3; .sb3",
        "application/x-sb3" ;
    skos:prefLabel "sb3"@en,
        "sb3"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/sch> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Schematron file"@en,
        "Schematron file"@es ;
    skos:definition "rule-based validation language for making assertions about the structure and content of XML documents; it is expressed in XML using a small number of elements and XPath; it has been standardised as part of ISO/IEC 19757"@en,
        "Lenguaje de validación basado en reglas para hacer aserciones sobre la estructura y el contenido de documentos XML; se expresa en XML usando un pequeño número de elementos y XPath; ha sido estandarizado como parte de ISO/IEC 19757."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SCH>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".sch",
        "application/xml" ;
    skos:prefLabel "Schematron"@en,
        "Schematron"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/schema_xml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "XML Schema"@en,
        "XML Schema"@es ;
    skos:definition "An XML schema is a description of a type of XML document, typically expressed in terms of constraints on the structure and content of documents of that type, above and beyond the basic syntactical constraints imposed by XML itself."@en,
        "Un esquema XML es una descripción de un tipo de documento XML, típicamente expresada en términos de restricciones sobre la estructura y el contenido de los documentos de ese tipo, más allá de las restricciones sintácticas básicas impuestas por el propio XML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SCHEMA_XML>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xsd",
        "application/xml" ;
    skos:prefLabel "XML schema"@en,
        "XML schema"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/sdmx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Statistical Data and Metadata eXchange"@en,
        "Statistical Data and Metadata eXchange"@es ;
    skos:definition "SDMX is an initiative to foster standards for the exchange of statistical information. The SDMX message formats have two basic expressions, SDMX-ML (using XML syntax) and SDMX-EDI (using EDIFACT syntax and based on the GESMES/TS statistical message)."@en,
        "SDMX es una iniciativa para fomentar estándares para el intercambio de información estadística. Los formatos de mensaje SDMX tienen dos expresiones básicas: SDMX-ML (usando sintaxis XML) y SDMX-EDI (usando sintaxis EDIFACT y basado en el mensaje estadístico GESMES/TS)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SDMX>,
        <https://www.iana.org/assignments/media-types/application/EDIFACT>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml; .edi",
        "application/xml; application/EDIFACT" ;
    skos:prefLabel "SDMX"@en,
        "SDMX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/sgml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Standard Generalized Mark-up Language"@en,
        "Standard Generalized Mark-up Language"@es ;
    skos:definition "SGML – Standard Generalized Markup Language – is a standard for defining generalized markup languages for documents. Generalized markup is based on two postulates: markup should be declarative and rigorous."@en,
        "SGML – Standard Generalized Markup Language – es un estándar para definir lenguajes de marcado generalizados para documentos. El marcado generalizado se basa en dos postulados: el marcado debe ser declarativo y riguroso."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SGML>,
        <https://www.iana.org/assignments/media-types/text/sgml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".sgm; .sgml",
        "text/sgml" ;
    skos:prefLabel "SGML"@en,
        "SGML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/shp> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Environmental Systems Research Institute Shape"@en,
        "Environmental Systems Research Institute Shape"@es ;
    skos:definition "SHP – shapefile format – is a popular geospatial vector data format for geographic information system (GIS) software. Esri shapefile is a zip archive that contains at least the shp, shx and dbf files."@en,
        "SHP – shapefile format – es un formato de datos vectoriales geoespaciales popular para software de sistemas de información geográfica (SIG). El shapefile de Esri es un archivo zip que contiene al menos los archivos shp, shx y dbf."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SHP>,
        <https://www.iana.org/assignments/media-types/application/x-shapefile> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dbf; .shp; .shx",
        "application/x-shapefile" ;
    skos:prefLabel "Esri Shape"@en,
        "Esri Shape"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/skos_xml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Simple Knowledge Organization System"@en,
        "Simple Knowledge Organization System"@es ;
    skos:definition "SKOS – Simple Knowledge Organization System – is a W3C recommendation designed for representation of thesauri, classification schemes, taxonomies, subject-heading systems or any other type of structured controlled vocabulary. XML – Extensible Markup Language – is a markup language that defines a set of rules for encoding documents in a format that is both human-readable and machine-readable."@en,
        "SKOS – Simple Knowledge Organization System – es una recomendación del W3C diseñada para la representación de tesauros, esquemas de clasificación, taxonomías, sistemas de encabezamientos de materia o cualquier otro tipo de vocabulario controlado estructurado. XML – Extensible Markup Language – es un lenguaje de marcado que define un conjunto de reglas para codificar documentos en un formato legible tanto por humanos como por máquinas."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SKOS_XML>,
        <https://www.iana.org/assignments/media-types/application/rdf+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".rdf",
        "application/rdf+xml" ;
    skos:prefLabel "SKOS"@en,
        "SKOS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/sparqlq> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "SPARQL Query"@en,
        "SPARQL Query"@es ;
    skos:definition "SPARQL – a recursive acronym for SPARQL Protocol and RDF Query Language – is an RDF query language, that is, a semantic query language for databases, able to retrieve and manipulate data stored in Resource Description Framework (RDF) format. It is recognised as one of the key technologies of the semantic web."@en,
        "SPARQL – acrónimo recursivo de SPARQL Protocol and RDF Query Language – es un lenguaje de consulta RDF, es decir, un lenguaje de consulta semántico para bases de datos, capaz de recuperar y manipular datos almacenados en formato RDF. Es reconocido como una de las tecnologías clave de la web semántica."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SPARQLQ>,
        <https://www.iana.org/assignments/media-types/application/sparql-query> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".sparqlq; .rq",
        "application/sparql-query" ;
    skos:prefLabel "SPARQL"@en,
        "SPARQL"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/sparqlqres> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "SPARQL Query Results"@en,
        "SPARQL Query Results"@es ;
    skos:definition "Results of a SPARQL query. SPARQL – SPARQL Protocol and RDF Query Language – is an RDF query language, that is, a semantic query language for databases, able to retrieve and manipulate data stored in Resource Description Framework (RDF) format."@en,
        "Resultados de una consulta SPARQL. SPARQL – SPARQL Protocol and RDF Query Language – es un lenguaje de consulta RDF, es decir, un lenguaje de consulta semántico para bases de datos, capaz de recuperar y manipular datos almacenados en formato RDF (Resource Description Framework)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SPARQLQRES>,
        <https://www.iana.org/assignments/media-types/application/sparql-results+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".sparqlqr; .srx",
        "application/sparql-results+xml" ;
    skos:prefLabel "SPARQL results"@en,
        "SPARQL results"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

