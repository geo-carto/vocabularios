    skos:notation ".n3",
        "text/n3" ;
    skos:prefLabel "N3"@en,
        "N3"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/netcdf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Network Common Data Form"@en,
        "Network Common Data Form"@es ;
    skos:definition "NetCDF is a set of software libraries and self-describing, machine-independent data formats that support the creation, access and sharing of array-oriented scientific data."@en,
        "NetCDF es un conjunto de bibliotecas de software y formatos de datos autodescriptivos e independientes de la máquina que soportan la creación, acceso y compartición de datos científicos orientados a matrices."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/NETCDF>,
        <https://www.iana.org/assignments/media-types/application/x-netcdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".nc; .cdf",
        "application/x-netcdf" ;
    skos:prefLabel "NetCDF"@en,
        "NetCDF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/oapk> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Android Package (Oculus)"@en,
        "Android Package (Oculus)"@es ;
    skos:definition "An Android Package (APK) with special features used by the Android operating system for the distribution and installation of Oculus mobile apps."@en,
        "Un Android Package (APK) con características especiales utilizado por el sistema operativo Android para la distribución e instalación de aplicaciones móviles de Oculus."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/OAPK>,
        <https://www.iana.org/assignments/media-types/application/vnd.android.package-archive> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".apk; .xapk",
        "application/vnd.android.package-archive" ;
    skos:prefLabel "OAPK"@en,
        "OAPK"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/octet> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "Octet is the Internet media type for an arbitrary byte stream. A byte streamor octet stream is a series of bytes."@en,
        "Octet es el tipo de medio de Internet para un flujo de bytes arbitrario. Un flujo de bytes u octetos es una serie de bytes."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/OCTET>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".zoo",
        "application/octet-stream" ;
    skos:prefLabel "Octet Stream"@en,
        "Octet Stream"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/odb> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "OpenDocument is a standardized Open Document Format for Office Applications. Databases are organized collections of data."@en,
        "OpenDocument es un formato estandarizado de documento abierto para aplicaciones de oficina. Las bases de datos son colecciones organizadas de datos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ODB>,
        <https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.database> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".odb",
        "application/vnd.oasis.opendocument.database" ;
    skos:prefLabel "OpenDocument Database"@en,
        "OpenDocument Database"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/odc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "OpenDocument is a standardized Open Document Format for Office Applications. Charts define how to create graphical displays from numerical data."@en,
        "OpenDocument es un formato estandarizado de documento abierto para aplicaciones de oficina. Los gráficos definen cómo crear representaciones gráficas a partir de datos numéricos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ODC>,
        <https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.chart> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".odc",
        "application/vnd.oasis.opendocument.chart" ;
    skos:prefLabel "OpenDocument Chart"@en,
        "OpenDocument Chart"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/odf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "OpenDocument Format"@en,
        "OpenDocument Format"@es ;
    skos:definition "ODF – Open Document Format for Office Applications, also known as OpenDocument – is an XML-based file format for spreadsheets, charts, presentations and word processing documents. It was developed with the aim of providing an open, XML-based file format specification for office applications."@en,
        "ODF – Open Document Format for Office Applications, también conocido como OpenDocument – es un formato de archivo basado en XML para hojas de cálculo, gráficos, presentaciones y documentos de procesamiento de textos. Fue desarrollado con el objetivo de proporcionar una especificación de formato de archivo abierto basado en XML para aplicaciones de oficina."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ODF>,
        <https://www.iana.org/assignments/media-types/application/octet-stream>,
        <https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.formula> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".odf",
        "application/octet-stream; application/vnd.oasis.opendocument.formula" ;
    skos:prefLabel "ODF"@en,
        "ODF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/odg> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "OpenDocument is a standardized Open Document Format for Office Applications. Image files are composed of digital data and are used to organize and store digital images."@en,
        "OpenDocument es un formato estandarizado de documento abierto para aplicaciones de oficina. Los archivos de imagen están compuestos por datos digitales y se utilizan para organizar y almacenar imágenes digitales."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ODG>,
        <https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.graphics> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".odg",
        "application/vnd.oasis.opendocument.graphics" ;
    skos:prefLabel "OpenDocument Image"@en,
        "OpenDocument Image"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/odp> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "OpenDocument Presentation"@en,
        "OpenDocument Presentation"@es ;
    skos:definition "ODP is an OpenDocument file format for presentations. OpenDocument was developed with the aim of providing an open, XML-based file format specification for office applications."@en,
        "ODP es un formato de archivo OpenDocument para presentaciones. OpenDocument fue desarrollado con el objetivo de proporcionar una especificación de formato de archivo abierto basado en XML para aplicaciones de oficina."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ODP>,
        <https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.presentation> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".odp; .fodp",
        "application/vnd.oasis.opendocument.presentation" ;
    skos:prefLabel "ODP"@en,
        "ODP"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ods> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "OpenDocument Spreadsheet"@en,
        "OpenDocument Spreadsheet"@es ;
    skos:definition "ODS is an OpenDocument file format for spreadsheets. OpenDocument was developed with the aim of providing an open, XML-based file format specification for office applications."@en,
        "ODS es un formato de archivo OpenDocument para hojas de cálculo. OpenDocument fue desarrollado con el objetivo de proporcionar una especificación de formato de archivo abierto basado en XML para aplicaciones de oficina."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ODS>,
        <https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.spreadsheet> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ods",
        "application/vnd.oasis.opendocument.spreadsheet" ;
    skos:prefLabel "ODS"@en,
        "ODS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/odt> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Open Document Text"@en,
        "Open Document Text"@es ;
    skos:definition "ODT is the word processing file format of OpenDocument, an open standard for electronic documents."@en,
        "ODT es el formato de archivo de procesamiento de textos de OpenDocument, un estándar abierto para documentos electrónicos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ODT>,
        <https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.text> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".odt",
        "application/vnd.oasis.opendocument.text" ;
    skos:prefLabel "ODT"@en,
        "ODT"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ogcapi_coverages> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "OGC API Coverages service"@en,
        "Servicio OGC API Coverages"@es ;
    skos:definition "OGC API – Coverages is an Open Geospatial Consortium standard that defines a RESTful API for accessing coverages, i.e. digital geospatial information representing space/time-varying phenomena (raster data). It replaces the older Web Coverage Service (WCS) standard."@en,
        "OGC API – Coverages es un estándar del Open Geospatial Consortium que define una API RESTful para acceder a coberturas, es decir, información geoespacial digital que representa fenómenos que varían en el espacio y el tiempo (datos rasterizados). Reemplaza al estándar Web Coverage Service (WCS) anterior."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "image/tiff; application/json" ;
    skos:prefLabel "OGC API Coverages"@en,
        "OGC API Coverages"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ogcapi_features> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "OGC API Features service"@en,
        "Servicio OGC API Features"@es ;
    skos:definition "OGC API – Features is an Open Geospatial Consortium standard that defines a RESTful API for querying, creating, modifying, and accessing geospatial features on the web. It replaces the older Web Feature Service (WFS) standard, using modern web principles such as JSON, HTML, and OpenAPI."@en,
        "OGC API – Features es un estándar del Open Geospatial Consortium que define una API RESTful para consultar, crear, modificar y acceder a características geoespaciales en la web. Reemplaza al estándar Web Feature Service (WFS) anterior, utilizando principios modernos de la web como JSON, HTML y OpenAPI."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/geo+json> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "application/geo+json; text/html; application/xml" ;
    skos:prefLabel "OGC API Features"@en,
        "OGC API Features"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ogcapi_maps> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "OGC API Maps service"@en,
        "Servicio OGC API Maps"@es ;
    skos:definition "OGC API – Maps is an Open Geospatial Consortium standard that defines a RESTful API for accessing rendered representations of geospatial maps. It provides dynamically generated georeferenced map images. It replaces the older Web Map Service (WMS) standard, using modern web principles."@en,
        "OGC API – Maps es un estándar del Open Geospatial Consortium que define una API RESTful para acceder a representaciones renderizadas de mapas geoespaciales. Proporciona imágenes de mapas georreferenciados generados dinámicamente. Reemplaza al estándar Web Map Service (WMS) anterior, utilizando principios modernos de la web."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "image/png; image/jpeg" ;
    skos:prefLabel "OGC API Maps"@en,
        "OGC API Maps"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ogcapi_tiles> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "OGC API Tiles service"@en,
        "Servicio OGC API Tiles"@es ;
    skos:definition "OGC API – Tiles is an Open Geospatial Consortium standard that defines a RESTful API for accessing geospatial data in the form of predefined tiles. It supports both raster map tiles and vector tiles. It replaces the older WMTS standard, using modern web principles."@en,
        "OGC API – Tiles es un estándar del Open Geospatial Consortium que define una API RESTful para acceder a datos geoespaciales en forma de teselas predefinidas. Soporta tanto teselas de mapas rasterizados como teselas vectoriales. Reemplaza al estándar WMTS anterior, utilizando principios modernos de la web."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "image/png; image/jpeg; application/vnd.mapbox-vector-tile" ;
    skos:prefLabel "OGC API Tiles"@en,
        "OGC API Tiles"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/op_datpro> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "Provisional data"@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/OP_DATPRO> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:prefLabel "Provisional data"@en,
        "Provisional data"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ovf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Open Virtualization Format"@en,
        "Open Virtualization Format"@es ;
    skos:definition "OVF – Open Virtualization Format – is an open standard for packaging and distributing virtual appliances or more generally software to be run in virtual machines."@en,
        "OVF – Open Virtualization Format – es un estándar abierto para empaquetar y distribuir appliances virtuales o, de forma más general, software para ejecutar en máquinas virtuales."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/OVF>,
        <https://www.iana.org/assignments/media-types/application/ovf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ovf",
        "application/ovf" ;
    skos:prefLabel "OVF"@en,
        "OVF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/owl> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Web Ontology Language"@en,
        "Web Ontology Language"@es ;
    skos:definition "OWL – Web Ontology Language – is a family of knowledge representation languages for authoring ontologies."@en,
        "OWL – Web Ontology Language – es una familia de lenguajes de representación del conocimiento para la creación de ontologías."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/OWL>,
        <https://www.iana.org/assignments/media-types/application/owl+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".rdf; .owl; .owx",
        "application/owl+xml" ;
    skos:prefLabel "OWL"@en,
        "OWL"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/parquet> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Apache Parquet file"@en,
        "Apache Parquet file"@es ;
    skos:definition "Apache columnar storage format available to any project in the Hadoop ecosystem, regardless of the choice of data processing framework, data model or programming language; explicitly designed to separate the metadata from the data"@en,
        "Formato de almacenamiento columnar de Apache disponible para cualquier proyecto del ecosistema Hadoop, independientemente del marco de procesamiento de datos, modelo de datos o lenguaje de programación elegido; diseñado explícitamente para separar los metadatos de los datos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PARQUET>,
        <https://www.iana.org/assignments/media-types/application/vnd.apache.parquet> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".parquet",
        "application/vnd.apache.parquet" ;
    skos:prefLabel "Parquet"@en,
        "Parquet"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Portable Document Format"@en,
        "Portable Document Format"@es ;
    skos:definition "PDF – Portable Document Format – is a file format developed to present documents, including text formatting and images, in a manner independent of application software, hardware and operating systems. Based on the PostScript language, each PDF file encapsulates a complete description of a fixed-layout flat document, including the text, fonts, vector graphics, raster images and other information needed to display it. PDF was standardized as an open format and does not require any royalties for its implementation."@en,
        "PDF – Portable Document Format – es un formato de archivo desarrollado para presentar documentos, incluyendo formato de texto e imágenes, de manera independiente del software de aplicación, hardware y sistemas operativos. Basado en el lenguaje PostScript, cada archivo PDF encapsula una descripción completa de un documento de diseño fijo. PDF fue estandarizado como formato abierto y no requiere regalías para su implementación."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDF>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF"@en,
        "PDF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdf1x> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "PDF printing format extension"@en,
        "PDF printing format extension"@es ;
    skos:definition "PDF1X is a PDF specification used mainly for high quality color printing."@en,
        "PDF1X es una especificación PDF utilizada principalmente para impresión en color de alta calidad."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDF1X>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF1X"@en,
        "PDF1X"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfa1a> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "PDF archiving format, Level A conformance"@en,
        "PDF archiving format, Level A conformance"@es ;
    skos:definition "PDF/A-1 is the Part 1 of the PDF standard and specifies two levels of conformance for PDF files. PDF/A-1a – Level A (accessible) conformance was intended to increase the accessibility of conforming files for physically impaired users by allowing assistive software, such as screen readers, to more precisely extract and interpret a file's contents."@en,
        "PDF/A-1 es la Parte 1 del estándar PDF y especifica dos niveles de conformidad para archivos PDF. PDF/A-1a – Conformidad de Nivel A (accesible) estaba destinada a aumentar la accesibilidad de los archivos conformes para usuarios con discapacidades físicas, permitiendo que el software de asistencia, como los lectores de pantalla, extraiga e interprete con mayor precisión el contenido de un archivo."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFA1A>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/A-1a"@en,
        "PDF/A-1a"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfa1b> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "PDF archiving format, Level B conformance"@en,
        "PDF archiving format, Level B conformance"@es ;
    skos:definition "PDF/A-1 is the Part 1 of the PDF standard and specifies two levels of conformance for PDF files. Level B (basic) conformance requires only that standards necessary for the reliable reproduction of a document's visual appearance be followed."@en,
        "PDF/A-1 es la Parte 1 del estándar PDF y especifica dos niveles de conformidad para archivos PDF. La conformidad de Nivel B (básico) requiere únicamente que se sigan los estándares necesarios para la reproducción fiable de la apariencia visual de un documento."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFA1B>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/A-1b"@en,
        "PDF/A-1b"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfa2a> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "PDF/A-2 is the Part 2 of the PDF standard and specifies three levels of conformance for PDF files. PDF/A-2a corresponds to conformance level a in PDF/A-1 (accessible)."@en,
        "PDF/A-2 es la Parte 2 del estándar PDF y especifica tres niveles de conformidad para archivos PDF. PDF/A-2a corresponde al nivel de conformidad a en PDF/A-1 (accesible)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFA2A>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/A-2a"@en,
        "PDF/A-2a"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfa2b> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "PDF/A-2 is the Part 2 of the PDF standard and specifies three levels of conformance for PDF files. PDF/A-2b corresponds to conformance level a in PDF/A-2 (basic)."@en,
        "PDF/A-2 es la Parte 2 del estándar PDF y especifica tres niveles de conformidad para archivos PDF. PDF/A-2b corresponde al nivel de conformidad b en PDF/A-2 (básico)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFA2B>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/A-2b"@en,
        "PDF/A-2b"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfa3> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "ISO-standardised version of the Portable Document Format specialized for use in the archiving and long-term preservation of electronic documents; PDF/A-3 is the Part 3 of the standard which differs from PDF/A-2 in only one regard – it allows embedding of arbitrary file formats (such as XML, CSV, CAD, word-processing documents, spreadsheet documents and others) into PDF/A conforming documents"@en,
        "Versión estandarizada por ISO del Portable Document Format especializada para el archivado y la preservación a largo plazo de documentos electrónicos; PDF/A-3 es la Parte 3 del estándar que difiere de PDF/A-2 únicamente en que permite la incrustación de formatos de archivo arbitrarios (como XML, CSV, CAD, documentos de procesamiento de textos, hojas de cálculo y otros) en documentos conformes a PDF/A."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFA3>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/A-3"@en,
        "PDF/A-3"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfa3a> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "PDF/A-3 subtype ensuring both accessibility and structure preservation, similar to PDF/A-2a"@en,
        "Subtipo de PDF/A-3 que garantiza tanto la accesibilidad como la preservación de la estructura, similar a PDF/A-2a."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFA3A>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/A-3a"@en,
        "PDF/A-3a"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfa3b> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "PDF/A-3 subtype that guarantees visual fidelity without regard for structure"@en,
        "Subtipo de PDF/A-3 que garantiza la fidelidad visual sin considerar la estructura."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFA3B>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/A-3b"@en,
        "PDF/A-3b"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfa3u> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "PDF/A-3 subtype that supports Unicode, ensuring that non-Latin text is correctly represented"@en,
        "Subtipo de PDF/A-3 que soporta Unicode, asegurando que el texto no latino se represente correctamente."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFA3U>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/A-3u"@en,
        "PDF/A-3u"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfua> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "PDF/Universal Accessibility"@en,
        "PDF/Universal Accessibility"@es ;
    skos:definition "PDF/UA (PDF/Universal Accessibility), formally ISO 14289, is an International Organization for Standardization (ISO) standard for accessible PDF technology. A technical specification intended for developers implementing PDF writing and processing software, PDF/UA provides definitive terms and requirements for accessibility in PDF documents and applications. For those equipped with appropriate software, conformance with PDF/UA ensures accessibility for people with disabilities who use assistive technology such as screen readers, screen magnifiers, joysticks and other technologies to navigate and read electronic content."@en,
        "PDF/UA (PDF/Universal Accessibility), formalmente ISO 14289, es un estándar de la Organización Internacional de Normalización (ISO) para tecnología PDF accesible. Es una especificación técnica destinada a desarrolladores que implementan software de escritura y procesamiento de PDF; PDF/UA proporciona términos y requisitos definitivos para la accesibilidad en documentos y aplicaciones PDF. Para aquellos equipados con software apropiado, la conformidad con PDF/UA garantiza la accesibilidad para personas con discapacidades que utilizan tecnología de asistencia."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFUA>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/UA"@en,
        "PDF/UA"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "PDF printing format, Blind eXchange"@en,
        "PDF printing format, Blind eXchange"@es ;
    skos:definition "PDF/X is a subset of the PDF standard. The purpose of PDF/X is to facilitate graphics exchange, and it therefore has a series of printing related requirements which do not apply to standard PDF files."@en,
        "PDF/X es un subconjunto del estándar PDF. El propósito de PDF/X es facilitar el intercambio de gráficos, y por lo tanto tiene una serie de requisitos relacionados con la impresión que no se aplican a los archivos PDF estándar."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFX>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/X"@en,
        "PDF/X"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfx1a> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "PDF/X-1a is a PDF specification which completes exchange using CMYK data and spots colour printing data."@en,
        "PDF/X-1a es una especificación PDF que completa el intercambio utilizando datos CMYK y datos de impresión de colores directos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFX1A>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/X-1a"@en,
        "PDF/X-1a"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfx2a> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "PDF/X-2a is a PDF specification in which colour-managed, CMYK and spot colour data are supported in any combination."@en,
        "PDF/X-2a es una especificación PDF en la que se soportan datos de color gestionados CMYK y datos de colores directos en cualquier combinación."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFX2A>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/X-2a"@en,
        "PDF/X-2a"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pdfx4> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "PDF/X-4 is a PDF specification in which colour-managed, CMYK, gray, RGB or spot colour data are supported, as are PDF transparency and optional content."@en,
        "PDF/X-4 es una especificación PDF en la que se soportan datos de color gestionados CMYK, gris, RGB o colores directos, así como transparencia PDF y contenido opcional."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PDFX4>,
        <https://www.iana.org/assignments/media-types/application/pdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pdf",
        "application/pdf" ;
    skos:prefLabel "PDF/X-4"@en,
        "PDF/X-4"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pl> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "Source code written in the Perl programming language."@en,
        "Código fuente escrito en el lenguaje de programación Perl."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PL>,
        <https://www.iana.org/assignments/media-types/text/x-perl> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pm; .t; .pl; .pod",
        "text/x-perl" ;
    skos:prefLabel "Perl script"@en,
        "Perl script"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/png> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Portable Network Graphics"@en,
        "Portable Network Graphics"@es ;
    skos:definition "PNG – Portable Network Graphics – is a raster graphics file format that supports lossless data compression. PNG was created as an improved, non-patented replacement for Graphics Interchange Format (GIF), and is the most widely used lossless image compression format on the Internet."@en,
        "PNG – Portable Network Graphics – es un formato de archivo de gráficos rasterizados que admite compresión de datos sin pérdida. PNG fue creado como un reemplazo mejorado y no patentado del formato GIF (Graphics Interchange Format), y es el formato de compresión de imagen sin pérdida más utilizado en Internet."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PNG>,
        <https://www.iana.org/assignments/media-types/image/png> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".png",
        "image/png" ;
    skos:prefLabel "PNG"@en,
        "PNG"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pps> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Microsoft PowerPoint Slide Show"@en,
        "Microsoft PowerPoint Slide Show"@es ;
    skos:definition "PPS – PowerPoint 97–2003 binary slide show – is a binary filaname extension of Microsoft PowerPoint presentation program. PowerPoint was originally designed to provide visuals for group presentations within business organizations, but has come to be very widely used in many other communication situations, both in business and beyond."@en,
        "PPS – PowerPoint 97–2003 binary slide show – es una extensión de archivo binaria del programa de presentaciones Microsoft PowerPoint. PowerPoint fue diseñado originalmente para proporcionar elementos visuales para presentaciones grupales en organizaciones empresariales, pero ha llegado a ser ampliamente utilizado en muchas otras situaciones de comunicación."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PPS>,
        <https://www.iana.org/assignments/media-types/application/vnd.ms-powerpoint> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pps",
        "application/vnd.ms-powerpoint" ;
    skos:prefLabel "PowerPoint Slide Show"@en,
        "PowerPoint Slide Show"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ppsx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "PowerPoint Open XML Slide Show"@en,
        "PowerPoint Open XML Slide Show"@es ;
    skos:definition "PPSX – PowerPoint 2007 XML slide show – is an XML filename extension of Microsoft PowerPoint presentation program. PowerPoint was originally designed to provide visuals for group presentations within business organizations, but has come to be very widely used in many other communication situations, both in business and beyond."@en,
        "PPSX – PowerPoint 2007 XML slide show – es una extensión de archivo XML del programa de presentaciones Microsoft PowerPoint. PowerPoint fue diseñado originalmente para proporcionar elementos visuales para presentaciones grupales en organizaciones empresariales, pero ha llegado a ser ampliamente utilizado en muchas otras situaciones de comunicación."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PPSX>,
        <https://www.iana.org/assignments/media-types/application/vnd.openxmlformats-officedocument.presentationml.slideshow> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ppsx",
        "application/vnd.openxmlformats-officedocument.presentationml.slideshow" ;
    skos:prefLabel "PowerPoint PPSX"@en,
        "PowerPoint PPSX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ppt> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Microsoft PowerPoint Presentation"@en,
        "Microsoft PowerPoint Presentation"@es ;
    skos:definition "PPT is a binary media type of Microsoft PowerPoint presentation program. PowerPoint was originally designed to provide visuals for group presentations within business organizations, but has come to be very widely used in many other communication situations, both in business and beyond."@en,
        "PPT es un tipo de medio binario del programa de presentaciones Microsoft PowerPoint. PowerPoint fue diseñado originalmente para proporcionar elementos visuales para presentaciones grupales en organizaciones empresariales, pero ha llegado a ser ampliamente utilizado en muchas otras situaciones de comunicación."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PPT>,
        <https://www.iana.org/assignments/media-types/application/vnd.ms-powerpoint> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ppt",
        "application/vnd.ms-powerpoint" ;
    skos:prefLabel "PowerPoint PPT"@en,
        "PowerPoint PPT"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pptx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Office Open XML Presentation"@en,
        "Office Open XML Presentation"@es ;
    skos:definition "PPTX – PowerPoint 2007 XML presentation – is an XML filename extension of Office Open XML version of Microsoft PowerPoint presentation program. PowerPoint was originally designed to provide visuals for group presentations within business organizations, but has come to be very widely used in many other communication situations, both in business and beyond."@en,
        "PPTX – PowerPoint 2007 XML presentation – es una extensión de archivo XML de la versión Office Open XML del programa de presentaciones Microsoft PowerPoint. PowerPoint fue diseñado originalmente para proporcionar elementos visuales para presentaciones grupales en organizaciones empresariales, pero ha llegado a ser ampliamente utilizado en muchas otras situaciones de comunicación."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PPTX>,
        <https://www.iana.org/assignments/media-types/application/vnd.openxmlformats-officedocument.presentationml.presentation> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".pptx",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" ;
    skos:prefLabel "PowerPoint PPTX"@en,
        "PowerPoint PPTX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ps> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "PostScript File"@en,
        "PostScript File"@es ;
    skos:definition "PS – PostScript – is a page description language in the electronic publishing and desktop publishing business. It is a dynamically typed, concatenative programming language."@en,
        "PS – PostScript – es un lenguaje de descripción de páginas en el negocio de la publicación electrónica y la autoedición. Es un lenguaje de programación de tipo dinámico y concatenativo."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PS>,
        <https://www.iana.org/assignments/media-types/application/postscript> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ps",
        "application/postscript" ;
    skos:prefLabel "PS"@en,
        "PS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/psd> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Adobe Photoshop Document"@en,
        "Adobe Photoshop Document"@es ;
    skos:definition "PSD – Photoshop Document – stores an image with support for most imaging options available in Adobe Photoshop. Photoshop is a raster graphics editor."@en,
        "PSD – Photoshop Document – almacena una imagen con soporte para la mayoría de las opciones de imagen disponibles en Adobe Photoshop. Photoshop es un editor de gráficos rasterizados."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PSD>,
        <https://www.iana.org/assignments/media-types/application/x-photoshop> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".psd",
        "application/x-photoshop" ;
    skos:prefLabel "PSD"@en,
        "PSD"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/pwp> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Packaged Web Publications"@en,
        "Packaged Web Publications"@es ;
    skos:definition "Transmitting, storing, sharing or archiving a web publication is easier if it can be packaged as a single file. A Web Publication (WP) is a collection of one or more constituent resources, organized together in a uniquely identifiable grouping that may be presented using standard Open Web Platform technologies. A Packaged Web Publication (PWP) is a Web Publication whose constituent resources are combined into a single distributable file, using some standard packaging format."@en,
        "Transmitir, almacenar, compartir o archivar una publicación web es más fácil si se puede empaquetar como un único archivo. Una Web Publication (WP) es una colección de uno o más recursos constituyentes, organizados en una agrupación identificable de forma única que puede presentarse utilizando tecnologías estándar de la plataforma web abierta. Una Packaged Web Publication (PWP) es una Web Publication cuyos recursos se combinan en un único archivo distribuible."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/PWP>,
        <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "application/zip" ;
    skos:prefLabel "PWP"@en,
        "PWP"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/py> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Python Script"@en,
        "Script Python"@es ;
    skos:definition "A PY file is a source code file written in the Python programming language. Python is an interpreted, high-level, general-purpose programming language. Python files contain source code that can be executed directly by the Python interpreter."@en,
        "Un archivo PY es un archivo de código fuente escrito en el lenguaje de programación Python. Python es un lenguaje de programación interpretado, de alto nivel y de propósito general. Los archivos Python contienen código fuente que puede ejecutarse directamente por el intérprete de Python."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".py; .pyw",
        "text/x-python" ;
    skos:prefLabel "PY"@en,
        "PY"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/qgs> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Quantum GIS project"@en,
        "Quantum GIS project"@es ;
    skos:definition "QGS file is a Quantum GIS project. Quantum GIS (QGIS) is a cross-platform free and open source desktop geographic information systems (GIS) application that provides data viewing, editing, and analysis capabilities."@en,
        "Un archivo QGS es un proyecto de Quantum GIS. Quantum GIS (QGIS) es una aplicación de escritorio de sistemas de información geográfica (SIG) multiplataforma, libre y de código abierto, que proporciona capacidades de visualización, edición y análisis de datos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/QGS>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".qgs",
        "application/octet-stream" ;
    skos:prefLabel "QGS"@en,
        "QGS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/qgz> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Compressed QGIS project"@en,
        "Proyecto QGIS comprimido"@es ;
    skos:definition "A QGZ file is a compressed QGIS project. It is a ZIP archive containing the QGS project file and any auxiliary resources (such as data sources, styles). QGZ is the default project format starting from QGIS 3.2, replacing the uncompressed QGS file."@en,
        "Un archivo QGZ es un proyecto de QGIS comprimido. Es un archivo ZIP que contiene el archivo de proyecto QGS y cualquier recurso auxiliar (como datos de fuentes, estilos). QGZ es el formato de proyecto predeterminado a partir de QGIS 3.2, reemplazando al archivo QGS sin comprimir."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".qgz",
        "application/zip" ;
    skos:prefLabel "QGZ"@en,
        "QGZ"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/qml> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "QGIS Style File"@en,
        "Archivo de estilo QGIS"@es ;
    skos:definition "A QML (QGIS Layer Style) file is an XML file that stores the styling information for a layer in QGIS, including symbology, labeling, form actions, and other display properties. It is used to save and share layer styles between QGIS projects."@en,
        "Un archivo QML (QGIS Layer Style) es un archivo XML que almacena la información de estilo de una capa en QGIS, incluyendo la simbología, el etiquetado, las acciones de formulario y otras propiedades de visualización. Se utiliza para guardar y compartir estilos de capas entre proyectos QGIS."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".qml",
        "application/xml" ;
    skos:prefLabel "QML"@en,
        "QML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rar> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Roshal Archive"@en,
        "Roshal Archive"@es ;
    skos:definition "RAR is a proprietary archive file format that supports data compression, error recovery and file spanning."@en,
        "RAR es un formato de archivo propietario que soporta compresión de datos, recuperación de errores y expansión de archivos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RAR>,
        <https://www.iana.org/assignments/media-types/application/vnd.rar> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".r01; .rar; .r00; .rev",
        "application/vnd.rar" ;
    skos:prefLabel "RAR"@en,
        "RAR"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdata> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "R Data format"@en,
        "R Data format"@es ;
    skos:definition "open source data format of the statistical computing and graphic software R"@en,
        "Formato de datos de código abierto del software de computación estadística y gráficos R."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDATA>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".rdata; .r",
        "application/octet-stream" ;
    skos:prefLabel "RData"@en,
        "RData"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Resource Description Framework (RDF)"@en,
        "Resource Description Framework (RDF)"@es ;
    skos:definition "RDF – Resource Description Framework – is a standard model for data interchange on the Web. RDF has features that facilitate data merging. RDF extends the linking structure of the Web to use URIs to name the relationship between things as well as the two ends of the link (this is usually referred to as a ‘triple’). Using this simple model, it allows structured and semi-structured data to be mixed, exposed and shared across different applications. This linking structure forms a directed, labeled graph, where the edges represent the named link between two resources, represented by the graph nodes."@en,
        "RDF – Resource Description Framework – es un modelo estándar para el intercambio de datos en la Web. RDF tiene características que facilitan la fusión de datos. RDF extiende la estructura de enlaces de la Web para usar URIs para nombrar la relación entre cosas así como los dos extremos del enlace (esto se conoce generalmente como un 'triple'). Usando este modelo simple, permite mezclar, exponer y compartir datos estructurados y semiestructurados entre diferentes aplicaciones."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDF>,
        <https://www.iana.org/assignments/media-types/application/rdf+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".rdf",
        "application/rdf+xml" ;
    skos:prefLabel "RDF"@en,
        "RDF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdf_n_quads> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Resource Description Framework N-Quads"@en,
        "Resource Description Framework N-Quads"@es ;
    skos:definition "N-Quads is a line-based, plain text format for encoding an RDF dataset. N-quads statements are a sequence of RDF terms representing the subject, predicate, object and graph label of an RDF Triple and the graph it is part of in a dataset."@en,
        "N-Quads es un formato basado en líneas, de texto plano, para codificar un conjunto de datos RDF. Las declaraciones N-Quads son una secuencia de términos RDF que representan el sujeto, predicado, objeto y etiqueta de grafo de una Triple RDF y el grafo del que forma parte en un conjunto de datos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDF_N_QUADS>,
        <https://www.iana.org/assignments/media-types/application/n-quads> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".nq",
        "application/n-quads" ;
    skos:prefLabel "RDF N-Quads"@en,
        "RDF N-Quads"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdf_n_triples> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Resource Description Framework N-Triples"@en,
        "Resource Description Framework N-Triples"@es ;
    skos:definition "RDF N-Triples is a line-based, plain text format for encoding an RDF graph; a concrete syntax for RDF, an easy to parse line-based subset of Turtle."@en,
        "RDF N-Triples es un formato basado en líneas, de texto plano, para codificar un grafo RDF; una sintaxis concreta para RDF, un subconjunto de Turtle fácil de analizar y basado en líneas."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDF_N_TRIPLES>,
        <https://www.iana.org/assignments/media-types/application/n-triples> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".nt",
        "application/n-triples" ;
    skos:prefLabel "RDF N-Triples"@en,
        "RDF N-Triples"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdf_thrift> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "RDF Binary Thrift"@en,
        "RDF Binary Thrift"@es ;
    skos:definition "RDF Binary using Apache Thrift (‘RDF Thrift’) is a binary format for RDF and RDF-related data. Binary formats are faster to process – they do not incur the parsing costs of text-base formats. RDF Thrift defines basic encoding for RDF terms, then builds data formats for RDF graphs, RDF datasets and for SPARQL result sets. This gives a basis for high-performance linked data systems."@en,
        "RDF Binary usando Apache Thrift ('RDF Thrift') es un formato binario para RDF y datos relacionados con RDF. Los formatos binarios son más rápidos de procesar, ya que no incurren en los costes de análisis de los formatos basados en texto. RDF Thrift define codificación básica para términos RDF, y luego construye formatos de datos para grafos RDF, conjuntos de datos RDF y conjuntos de resultados SPARQL."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDF_THRIFT>,
        <https://www.iana.org/assignments/media-types/application/rdf+thrift> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".rt; .trdf",
        "application/rdf+thrift" ;
    skos:prefLabel "RDF Thrift"@en,
        "RDF Thrift"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdf_trig> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Resource Description Framework TriG"@en,
        "Resource Description Framework TriG"@es ;
    skos:definition "TriG allows an RDF dataset to be completely written in a compact and natural text form, with abbreviations for common usage patterns and datatypes. TriG is an extension of the Turtle format."@en,
        "TriG permite escribir un conjunto de datos RDF de forma completa en un formato de texto compacto y natural, con abreviaturas para patrones de uso y tipos de datos comunes. TriG es una extensión del formato Turtle."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDF_TRIG>,
        <https://www.iana.org/assignments/media-types/application/trig> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".trig",
        "application/trig" ;
    skos:prefLabel "RDF TriG"@en,
        "RDF TriG"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdf_trix> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Triples in XML"@en,
        "Triples in XML"@es ;
    skos:definition "TriX (Triples in XML) is a serialization format for RDF (Resource Description Framework) graphs. It is an XML format for serializing Named Graphs and RDF Datasets which offers a compact and readable alternative to the XML-based RDF/XML syntax."@en,
        "TriX (Triples in XML) es un formato de serialización para grafos RDF (Resource Description Framework). Es un formato XML para serializar grafos con nombre (Named Graphs) y conjuntos de datos RDF que ofrece una alternativa compacta y legible a la sintaxis RDF/XML basada en XML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDF_TRIX>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml; .trix",
        "application/xml" ;
    skos:prefLabel "RDF TriX"@en,
        "RDF TriX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdf_turtle> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Terse RDF Triple Language"@en,
        "Terse RDF Triple Language"@es ;
    skos:definition "Turtle – Terse RDF Triple Language – is a format for expressing data in the Resource Description Framework (RDF) data model with a syntax similar to SPARQL. RDF, in turn, represents information using ‘triples’, each of which consists of a subject, a predicate and an object. Each of those items is expressed as a Web URI."@en,
        "Turtle – Terse RDF Triple Language – es un formato para expresar datos en el modelo de datos RDF (Resource Description Framework) con una sintaxis similar a SPARQL. RDF, a su vez, representa información usando 'triples', cada uno de los cuales consta de un sujeto, un predicado y un objeto. Cada uno de esos elementos se expresa como una URI Web."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDF_TURTLE>,
        <https://www.iana.org/assignments/media-types/text/turtle> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ttl",
        "text/turtle" ;
    skos:prefLabel "RDF Turtle"@en,
        "RDF Turtle"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdf_xml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Resource Description Framework XML syntax"@en,
        "Resource Description Framework XML syntax"@es ;
    skos:definition "RDF XML is a syntax, defined by the W3C, to express (i.e. serialize) an RDF graph as an XML document."@en,
        "RDF XML es una sintaxis, definida por el W3C, para expresar (es decir, serializar) un grafo RDF como un documento XML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDF_XML>,
        <https://www.iana.org/assignments/media-types/application/rdf+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".rdf",
        "application/rdf+xml" ;
    skos:prefLabel "RDF XML"@en,
        "RDF XML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rdfa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Resource Description Framework in Attributes"@en,
        "Resource Description Framework in Attributes"@es ;
    skos:definition "RDFa is a technique that provides a set of markup attributes to augment the visual information on the Web with machine-readable hints."@en,
        "RDFa es una técnica que proporciona un conjunto de atributos de marcado para aumentar la información visual en la Web con indicaciones legibles por máquinas."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RDFA>,
        <https://www.iana.org/assignments/media-types/application/rdfa> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".rdfa",
        "application/rdfa" ;
    skos:prefLabel "RDFa"@en,
        "RDFa"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rest> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Esri Representational State Transfer"@en,
        "Esri Representational State Transfer"@es ;
    skos:definition "Esri REST is a standard way for web clients to communicate with geographic information system (GIS) servers through Representational State Transfer (REST) technology."@en,
        "Esri REST es una forma estándar para que los clientes web se comuniquen con servidores de sistemas de información geográfica (SIG) a través de la tecnología REST (Representational State Transfer)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/REST>,
        <https://www.iana.org/assignments/media-types/arcgis_rest> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "arcgis_rest" ;
    skos:prefLabel "Esri REST"@en,
        "Esri REST"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rpm> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "RPM Package"@en,
        "RPM Package"@es ;
    skos:definition "File format for RPM Package Manager (originally Red Hat Package Manager), free and open-source package management system."@en,
        "Formato de archivo para RPM Package Manager (originalmente Red Hat Package Manager), sistema de gestión de paquetes libre y de código abierto."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RPM>,
        <https://www.iana.org/assignments/media-types/application/x-rpm> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".rpm",
        "application/x-rpm" ;
    skos:prefLabel "RPM"@en,
        "RPM"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rss> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Really Simple Syndication"@en,
        "Really Simple Syndication"@es ;
    skos:definition "RSS – Rich Site Summary; originally RDF Site Summary; often called Really Simple Syndication – is a type of web feed which allows users to access updates to online content in a standardized, computer-readable format. These feeds can, for example, allow a user to keep track of many different websites in a single news aggregator. Websites usually use RSS feeds to publish frequently updated information, such as blog entries, news headlines, audio, video. An RSS document (called ‘feed’, ‘web feed’ or ‘channel’) includes full or summarized text and metadata."@en,
        "RSS – Rich Site Summary; originalmente RDF Site Summary; frecuentemente llamado Really Simple Syndication – es un tipo de fuente web que permite a los usuarios acceder a actualizaciones de contenido en línea en un formato estandarizado y legible por computadora. Los sitios web generalmente usan fuentes RSS para publicar información actualizada frecuentemente, como entradas de blog, titulares de noticias, audio y vídeo."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RSS>,
        <https://www.iana.org/assignments/media-types/application/rss+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml; .rss",
        "application/rss+xml" ;
    skos:prefLabel "RSS feed"@en,
        "RSS feed"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/rtf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Rich Text Format File"@en,
        "Rich Text Format File"@es ;
    skos:definition "RTF – Rich Text Format – is a proprietary document file format developed for cross-platform document interchange with Microsoft products."@en,
        "RTF – Rich Text Format – es un formato de archivo de documento propietario desarrollado para el intercambio de documentos multiplataforma con productos de Microsoft."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/RTF>,
        <https://www.iana.org/assignments/media-types/text/rtf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".rtf",
        "text/rtf" ;
    skos:prefLabel "RTF"@en,
        "RTF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/sas> a skos:Concept ;
