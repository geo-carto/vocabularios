<https://geo-carto.github.io/vocabularios/archivo-tipo/7z> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "7-Zip compressed file"@en,
        "7-Zip compressed file"@es ;
    skos:definition "7z is a compressed archive file format that supports several different data compression, encryption and pre-processing algorithms."@en,
        "7z es un formato de archivo comprimido que soporta varios algoritmos diferentes de compresión de datos, cifrado y preprocesamiento."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/7Z>,
        <https://www.iana.org/assignments/media-types/application/x-7z-compressed> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".7z",
        "application/x-7z-compressed" ;
    skos:prefLabel "7z"@en,
        "7z"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/aab> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Android App Bundle"@en,
        "Android App Bundle"@es ;
    skos:definition "An Android App Bundle (AAB) is a package file format used by the Android operating system. It includes an app’s compiled code and resources, and defers APK generation and signing to Google Play."@en,
        "Un Android App Bundle (AAB) es un formato de archivo de paquete utilizado por el sistema operativo Android. Incluye el código compilado y los recursos de una aplicación, y delega la generación y firma del APK a Google Play."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/AAB>,
        <https://www.iana.org/assignments/media-types/application/x-authorware-bin> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".aab",
        "application/x-authorware-bin" ;
    skos:prefLabel "AAB"@en,
        "AAB"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/aac> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Advanced Audio Coding"@en,
        "Advanced Audio Coding"@es ;
    skos:definition "Advanced Audio Coding (AAC) is an audio coding standard for lossy digital audio compression. Designed to be the successor of the MP3 format, AAC generally achieves higher sound quality than MP3 at the same bit rate."@en,
        "Advanced Audio Coding (AAC) es un estándar de codificación de audio para compresión de audio digital con pérdida. Diseñado como sucesor del formato MP3, AAC generalmente logra mayor calidad de sonido que MP3 a la misma tasa de bits."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/AAC>,
        <https://www.iana.org/assignments/media-types/audio/aac> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".adts; .ass; .aac; .loas",
        "audio/aac" ;
    skos:prefLabel "AAC"@en,
        "AAC"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/akn4eu> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Akoma Ntoso file"@en,
        "Akoma Ntoso file"@es ;
    skos:definition "AKN4EU file is an Akoma Ntoso XML file conforming to the AKN4EU (Akoma Ntoso for European Union) specifications. One or more AKN4EU files can be part of an AKN4EU ZIP file. A special AKN4EU file called ‘main.xml’ is the entry point of an AKN4EU ZIP file."@en,
        "Un archivo AKN4EU es un archivo XML Akoma Ntoso que cumple con las especificaciones AKN4EU (Akoma Ntoso for European Union). Uno o más archivos AKN4EU pueden formar parte de un archivo ZIP AKN4EU. Un archivo AKN4EU especial llamado 'main.xml' es el punto de entrada de un archivo ZIP AKN4EU."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/AKN4EU>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml; .akn",
        "application/xml" ;
    skos:prefLabel "AKN4EU file"@en,
        "AKN4EU file"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/akn4eu_leg> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Akoma Ntoso ZIP archive"@en,
        "Akoma Ntoso ZIP archive"@es ;
    skos:definition "ZIP archive containing an AKN4EU manifestation of a document in one linguistic variant issued in the legal decision-making process; it must contain at least an AKN4EU file starting with the prefix ‘main-’, which constitutes the entry point, and may contain other associated files and subfolders"@en,
        "Archivo ZIP que contiene una manifestación AKN4EU de un documento en una variante lingüística emitida en el proceso de toma de decisiones legales; debe contener al menos un archivo AKN4EU que comience con el prefijo 'main-', que constituye el punto de entrada, y puede contener otros archivos y subcarpetas asociados."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/AKN4EU_LEG>,
        <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".leg",
        "application/zip" ;
    skos:prefLabel "AKN4EU LEG"@en,
        "AKN4EU LEG"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/akn4eu_zip> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Akoma Ntoso ZIP archive"@en,
        "Akoma Ntoso ZIP archive"@es ;
    skos:definition "retired concept; replaced by AKN4EU_LEG"@en,
        "Concepto retirado; reemplazado por AKN4EU_LEG."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/AKN4EU_ZIP> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:prefLabel "AKN4EU ZIP"@en,
        "AKN4EU ZIP"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/apk> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Android Package"@en,
        "Android Package"@es ;
    skos:definition "Android Package (APK) is the package file format used by the Android operating system for distribution and installation of mobile apps, mobile games and middleware."@en,
        "Android Package (APK) es el formato de archivo de paquete utilizado por el sistema operativo Android para la distribución e instalación de aplicaciones móviles, juegos móviles y middleware."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/APK>,
        <https://www.iana.org/assignments/media-types/application/vnd.android.package-archive> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".apk; .xapk",
        "application/vnd.android.package-archive" ;
    skos:prefLabel "APK"@en,
        "APK"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/appx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Microsoft AppX application package"@en,
        "Microsoft AppX application package"@es ;
    skos:definition "AppX is a file format used to distribute and install apps on Windows 8.x and 10, Windows Phone 8.1, Windows 10 Mobile, Xbox One, Hololens and Windows 10 IoT Core."@en,
        "AppX es un formato de archivo utilizado para distribuir e instalar aplicaciones en Windows 8.x y 10, Windows Phone 8.1, Windows 10 Mobile, Xbox One, Hololens y Windows 10 IoT Core."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/APPX>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".appxbundle; .appx",
        "application/octet-stream" ;
    skos:prefLabel "AppX"@en,
        "AppX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/aprx> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS Pro Project"@en,
        "Proyecto ArcGIS Pro"@es ;
    skos:definition "An APRX file is an ArcGIS Pro project. It stores the project information, including maps, map layouts, data connections, geoprocessing tools, and other resources used in the project. It is the main project file format of Esri's ArcGIS Pro desktop application."@en,
        "Un archivo APRX es un proyecto de ArcGIS Pro. Almacena la información del proyecto, incluyendo mapas, diseños de mapa, conexiones a datos, herramientas de geoprocesamiento y otros recursos utilizados en el proyecto. Es el formato de archivo de proyecto principal de la aplicación de escritorio ArcGIS Pro de Esri."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".aprx",
        "application/octet-stream" ;
    skos:prefLabel "APRX"@en,
        "APRX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Internet Archive ARC file format"@en,
        "Internet Archive ARC file format"@es ;
    skos:definition "ARC is the archive file format of Internet Archive. ARC files are large aggregate files."@en,
        "ARC es el formato de archivo de Internet Archive. Los archivos ARC son grandes archivos agregados."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ARC>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".arc",
        "application/octet-stream" ;
    skos:prefLabel "ARC"@en,
        "ARC"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arc_gz> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Compressed Internet Archive ARC file format"@en,
        "Compressed Internet Archive ARC file format"@es ;
    skos:definition "ARC is the archive file format of Internet Archive. ARC files are large aggregate files. ARC GZ is ARC compressed by GZIP."@en,
        "ARC es el formato de archivo de Internet Archive. Los archivos ARC son grandes archivos agregados. ARC GZ es ARC comprimido con GZIP."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ARC_GZ>,
        <https://www.iana.org/assignments/media-types/application/gzip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".arc.gz",
        "application/gzip" ;
    skos:prefLabel "ARC GZ"@en,
        "ARC GZ"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arcgis_img_srvc> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS Image Service"@en,
        "Servicio de imágenes ArcGIS"@es ;
    skos:definition "An ArcGIS Image Service provides access to large collections of raster data and imagery through the ArcGIS REST API. It supports accessing data as pre-generated static tiles and dynamically generated images. It is suitable for sharing satellite imagery, aerial photography, digital elevation models, and other raster data."@en,
        "Un servicio de imágenes (Image Service) de ArcGIS proporciona acceso a grandes colecciones de datos rasterizados e imágenes a través de la API REST de ArcGIS. Soporta el acceso a datos como teselas estáticas pregeneradas e imágenes generadas dinámicamente. Es adecuado para compartir imágenes de satélite, fotografía aérea, modelos digitales de elevación y otros datos rasterizados."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "arcgis_image_service" ;
    skos:prefLabel "ArcGIS Image Service"@en,
        "ArcGIS Image Service"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arcgis_map_srvc> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS Map Service"@en,
        "Servicio de mapas ArcGIS"@es ;
    skos:definition "An ArcGIS Map Service makes the contents of a map document available through the ArcGIS REST API. It can operate dynamically, generating map images on demand, or as a cached service with pre-generated tiles for faster performance. It supports multiple optional capabilities such as Feature Access, WMS, WFS, and KML."@en,
        "Un servicio de mapas (Map Service) de ArcGIS hace disponible los contenidos de un documento de mapa a través de la API REST de ArcGIS. Puede funcionar de forma dinámica, generando imágenes de mapa bajo demanda, o como servicio cacheado con teselas pregeneradas para un rendimiento más rápido. Soporta múltiples capacidades opcionales como acceso a entidades (Feature Access), WMS, WFS y KML."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "arcgis_map_service" ;
    skos:prefLabel "ArcGIS Map Service"@en,
        "ArcGIS Map Service"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arcgis_vt_srvc> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS Vector Tile Service"@en,
        "Servicio de teselas vectoriales ArcGIS"@es ;
    skos:definition "An ArcGIS Vector Tile Service provides access to pre-cached vector data in PBF (Protocol Buffer Format) through the ArcGIS REST API. Vector tiles enable high-performance client-side rendering by leveraging the browser GPU. Styling is applied dynamically on the client side using the Mapbox Style specification."@en,
        "Un servicio de teselas vectoriales (Vector Tile Service) de ArcGIS proporciona acceso a datos vectoriales precacheados en formato PBF (Protocol Buffer Format) a través de la API REST de ArcGIS. Las teselas vectoriales permiten la representación de alto rendimiento en el cliente aprovechando la GPU del navegador. El estilo se aplica dinámicamente en el lado del cliente utilizando la especificación Mapbox Style."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "arcgis_vector_tile_service" ;
    skos:prefLabel "ArcGIS Vector Tile Service"@en,
        "ArcGIS Vector Tile Service"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arcinfo_cov> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ESRI ArcInfo Coverage"@en,
        "ESRI ArcInfo Coverage"@es ;
    skos:definition "An ESRI ArcInfo coverage is a georelational data model that stores vector data – it contains both the spatial (location) and attribute (descriptive) data for geographic features. Coverages use a set of feature classes to represent geographic features. Each feature class stores a set of points, lines (arcs), polygons, or annotation (text). Coverages can have topology, which determines the relationships between features. A coverage is stored as a directory within which each feature class is stored as a set of files."@en,
        "Una cobertura ESRI ArcInfo es un modelo de datos georrelacional que almacena datos vectoriales – contiene tanto los datos espaciales (ubicación) como los datos de atributos (descriptivos) para las características geográficas. Las coberturas utilizan un conjunto de clases de características para representar características geográficas. Una cobertura se almacena como un directorio dentro del cual cada clase de característica se almacena como un conjunto de archivos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ARCINFO_COV>,
        <https://www.iana.org/assignments/media-types/multipart/mixed> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "multipart/mixed" ;
    skos:prefLabel "ArcInfo coverage"@en,
        "ArcInfo coverage"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arff> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Attribute-Relation File Format"@en,
        "Attribute-Relation File Format"@es ;
    skos:definition "ASCII text file that describes a list of instances sharing a set of attributes"@en,
        "Archivo de texto ASCII que describe una lista de instancias que comparten un conjunto de atributos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ARFF>,
        <https://www.iana.org/assignments/media-types/text/plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".arff",
        "text/plain" ;
    skos:prefLabel "ARFF"@en,
        "ARFF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arj> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ARJ archive"@en,
        "ARJ archive"@es ;
    skos:definition "Compressed archive file produced by ARJ software. ARJ (Archived by Robert Jung) is a software tool designed by Robert K. Jung for creating high-efficiency compressed file archives."@en,
        "Archivo comprimido producido por el software ARJ. ARJ (Archived by Robert Jung) es una herramienta de software diseñada por Robert K. Jung para crear archivos comprimidos de alta eficiencia."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ARJ>,
        <https://www.iana.org/assignments/media-types/application/x-arj> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".arj",
        "application/x-arj" ;
    skos:prefLabel "ARJ"@en,
        "ARJ"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arrow_file> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Apache Arrow file"@en,
        "Apache Arrow file"@es ;
    skos:definition "Apache columnar format that includes a language-agnostic in-memory data structure specification, metadata serialisation, and a protocol for serialisation and generic data transport; file (random access) format is used for serialising a fixed number of record batches"@en,
        "Formato columnar de Apache que incluye una especificación de estructura de datos en memoria independiente del lenguaje, serialización de metadatos y un protocolo para serialización y transporte genérico de datos; el formato de archivo (acceso aleatorio) se utiliza para serializar un número fijo de lotes de registros."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ARROW_FILE>,
        <https://www.iana.org/assignments/media-types/application/vnd.apache.arrow.file> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".arrow",
        "application/vnd.apache.arrow.file" ;
    skos:prefLabel "Arrow file"@en,
        "Arrow file"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/arrow_stream> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Apache Arrow stream"@en,
        "Apache Arrow stream"@es ;
    skos:definition "Apache columnar format that includes a language-agnostic in-memory data structure specification, metadata serialisation, and a protocol for serialisation and generic data transport; streaming format is used for sending an arbitrary length sequence of record batches"@en,
        "Formato columnar de Apache que incluye una especificación de estructura de datos en memoria independiente del lenguaje, serialización de metadatos y un protocolo para serialización y transporte genérico de datos; el formato de flujo se utiliza para enviar una secuencia de longitud arbitraria de lotes de registros."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ARROW_STREAM>,
        <https://www.iana.org/assignments/media-types/application/vnd.apache.arrow.stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".arrows",
        "application/vnd.apache.arrow.stream" ;
    skos:prefLabel "Arrow stream"@en,
        "Arrow stream"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/atom> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Atom Syndication Format"@en,
        "Atom Syndication Format"@es ;
    skos:definition "The Atom Feed or Atom Syndication Format is an XML language used for web feeds. Web feeds allow software programs to check for updates published on a website."@en,
        "El formato Atom Feed o Atom Syndication Format es un lenguaje XML utilizado para fuentes web. Las fuentes web permiten a los programas de software verificar actualizaciones publicadas en un sitio web."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ATOM>,
        <https://www.iana.org/assignments/media-types/application/atom+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml; .atom",
        "application/atom+xml" ;
    skos:prefLabel "Atom Feed"@en,
        "Atom Feed"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/azw> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Amazon Kindle eBook format"@en,
        "Amazon Kindle eBook format"@es ;
    skos:definition "AZW Kindle File Format is a proprietary e-book file format created by Amazon.com that can be downloaded and read on devices like smartphones, tablets, computers or e-readers that have Amazon's Kindle application."@en,
        "AZW Kindle File Format es un formato de archivo de libro electrónico propietario creado por Amazon.com que puede descargarse y leerse en dispositivos como teléfonos inteligentes, tabletas, ordenadores o lectores electrónicos que tengan la aplicación Kindle de Amazon."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/AZW>,
        <https://www.iana.org/assignments/media-types/application/vnd.amazon.ebook> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".azw",
        "application/vnd.amazon.ebook" ;
    skos:prefLabel "Amazon Kindle eBook"@en,
        "Amazon Kindle eBook"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/bin> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "A binary file is a computer file that is not a text file."@en,
        "Un archivo binario es un archivo informático que no es un archivo de texto."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/BIN>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".bin",
        "application/octet-stream" ;
    skos:prefLabel "Binary Data"@en,
        "Binary Data"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/bits> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Book Interchange Tag Suite"@en,
        "Book Interchange Tag Suite"@es ;
    skos:definition "BITS – Book Interchange Tag Suite – is the ‘book version’ of Journal Article Tag Suite (JATS); an XML format used to describe books published online. BITS provides a common XML format in which publishers and archivists can describe textual and graphical content elements. In order to facilitate the reusability, BITS makes a tag set adequate for supporting interchange, archiving, format-conversion and publishing."@en,
        "BITS – Book Interchange Tag Suite – es la 'versión de libro' de Journal Article Tag Suite (JATS); un formato XML utilizado para describir libros publicados en línea. BITS proporciona un formato XML común en el que editores y archivistas pueden describir elementos de contenido textual y gráfico. Para facilitar la reutilización, BITS proporciona un conjunto de etiquetas adecuado para soportar intercambio, archivado, conversión de formato y publicación."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/BITS>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "application/xml" ;
    skos:prefLabel "BITS XML"@en,
        "BITS XML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/bmp> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "The bitmap image (BMP) or device independent bitmap (DIB) is a raster graphics image file format used to store bitmap digital images, independently of the display device."@en,
        "La imagen de mapa de bits (BMP) o mapa de bits independiente del dispositivo (DIB) es un formato de archivo de imagen de gráficos rasterizados utilizado para almacenar imágenes digitales de mapa de bits, independientemente del dispositivo de visualización."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/BMP>,
        <https://www.iana.org/assignments/media-types/image/x-ms-bmp> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".bm; .dib; .bmp",
        "image/x-ms-bmp" ;
    skos:prefLabel "Bitmap Image File"@en,
        "Bitmap Image File"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/bwf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Broadcast Wave File"@en,
        "Broadcast Wave File"@es ;
    skos:definition "BWF – Broadcast Wave Format – is an extension of the Microsoft WAV audio format and is the recording format of most file-based non-linear digital recorders used for motion picture, radio and television production. The purpose of this file format is the addition of metadata to facilitate the seamless exchange of sound data between different computer platforms and applications."@en,
        "BWF – Broadcast Wave Format – es una extensión del formato de audio Microsoft WAV y es el formato de grabación de la mayoría de grabadoras digitales no lineales basadas en archivos utilizadas para la producción cinematográfica, radiofónica y televisiva. El propósito de este formato es la adición de metadatos para facilitar el intercambio fluido de datos de sonido entre diferentes plataformas y aplicaciones."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/BWF>,
        <https://www.iana.org/assignments/media-types/audio/vnd.wave> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".wav; .bwf",
        "audio/vnd.wave" ;
    skos:prefLabel "BWF"@en,
        "BWF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/bzip2> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "bzip2 compressed file"@en,
        "bzip2 compressed file"@es ;
    skos:definition "An open source, patent- and royalty-free compression format. The compression algorithm is a Burrows-Wheeler transform followed by a move-to-front transform and finally Huffman coding."@en,
        "Un formato de compresión de código abierto, libre de patentes y regalías. El algoritmo de compresión es una transformada de Burrows-Wheeler seguida de una transformada de movimiento al frente y finalmente una codificación Huffman."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/BZIP2>,
        <https://www.iana.org/assignments/media-types/application/x-bzip2> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".bz2",
        "application/x-bzip2" ;
    skos:prefLabel "bzip2"@en,
        "bzip2"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/cog> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Cloud Optimized GeoTIFF"@en,
        "GeoTIFF Optimizado para la Nube"@es ;
    skos:definition "Cloud Optimized GeoTIFF (COG) is a variant of the GeoTIFF image format that specifies a particular layout of internal data to allow for optimized (subsetted or aggregated) access over a network. It relies on two characteristics of the TIFF v6 format (tiles and reduced resolution subfiles), GeoTIFF keys for georeference, and HTTP range requests for efficient downloading of parts of imagery and grid coverage data on the web."@en,
        "Cloud Optimized GeoTIFF (COG) es una variante del formato de imagen GeoTIFF que especifica una organización interna particular de los datos para permitir el acceso optimizado (subconjuntos o agregados) a través de una red. Se basa en dos características del formato TIFF v6 (teselas y subarchivos de resolución reducida), claves GeoTIFF para georreferenciación y solicitudes HTTP range para la descarga eficiente de partes de datos de imágenes y coberturas de cuadrícula en la web."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/image/tiff> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tiff; .tif",
        "image/tiff" ;
    skos:prefLabel "COG"@en,
        "COG"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/copc> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Cloud Optimized Point Cloud"@en,
        "Nube de Puntos Optimizada para la Nube"@es ;
    skos:definition "Cloud Optimized Point Cloud (COPC) is a file format that stores point cloud data organized in a clustered octree within a LAZ 1.4 file. It enables efficient streaming access to spatial and resolution subsets of large point cloud datasets through HTTP range requests, analogous to Cloud Optimized GeoTIFF (COG) for raster data. It is backward compatible with any LAZ 1.4 reader."@en,
        "Cloud Optimized Point Cloud (COPC) es un formato de archivo que almacena datos de nubes de puntos organizados en un octree agrupado dentro de un archivo LAZ 1.4. Permite el acceso eficiente por streaming a subconjuntos espaciales y de resolución de grandes conjuntos de datos de nubes de puntos a través de solicitudes HTTP range, de forma análoga a Cloud Optimized GeoTIFF (COG) para datos rasterizados. Es retrocompatible con cualquier lector LAZ 1.4."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/x-laz> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".copc.laz",
        "application/x-laz" ;
    skos:prefLabel "COPC"@en,
        "COPC"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/css> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Cascading Style Sheet"@en,
        "Cascading Style Sheet"@es ;
    skos:definition "CSS – Cascading Style Sheets – is a style sheet language used for describing the presentation of a document written in a markup language."@en,
        "CSS – Cascading Style Sheets – es un lenguaje de hojas de estilo utilizado para describir la presentación de un documento escrito en un lenguaje de marcado."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/CSS>,
        <https://www.iana.org/assignments/media-types/text/css> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".css",
        "text/css" ;
    skos:prefLabel "CSS"@en,
        "CSS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/csv> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Comma-Separated Values"@en,
        "Comma-Separated Values"@es ;
    skos:definition "CSV – comma-separated values – files store tabular data (numbers and text) in plain text. Each line of the file is a data record. Each record consists of one or more fields, separated by commas."@en,
        "CSV – comma-separated values (valores separados por comas) – almacenan datos tabulares (números y texto) en texto plano. Cada línea del archivo es un registro de datos. Cada registro consta de uno o más campos, separados por comas."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/CSV>,
        <https://www.iana.org/assignments/media-types/text/csv> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".csv",
        "text/csv" ;
    skos:prefLabel "CSV"@en,
        "CSV"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dapk> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Android Package (Daydream)"@en,
        "Android Package (Daydream)"@es ;
    skos:definition "An Android Package (APK) with special features used by the Android operating system for the distribution and installation of Daydream mobile apps."@en,
        "Un Android Package (APK) con características especiales utilizado por el sistema operativo Android para la distribución e instalación de aplicaciones móviles de Daydream."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DAPK>,
        <https://www.iana.org/assignments/media-types/application/vnd.android.package-archive> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".apk; .xapk",
        "application/vnd.android.package-archive" ;
    skos:prefLabel "DAPK"@en,
        "DAPK"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dbf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "dBase File"@en,
        "dBase File"@es ;
    skos:definition "DBF – dBase database file – is supported by a number of database products. dBase was one of the first database management systems for microcomputers."@en,
        "DBF – dBase database file – es soportado por varios productos de bases de datos. dBase fue uno de los primeros sistemas de gestión de bases de datos para microcomputadoras."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DBF>,
        <https://www.iana.org/assignments/media-types/application/x-dbase> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dbf",
        "application/x-dbase" ;
    skos:prefLabel "DBF"@en,
        "DBF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dcr> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "DCR is a file type for Adobe Shockwave Media files. DCR files are used to create games and other highly interactive content."@en,
        "DCR es un tipo de archivo para archivos multimedia de Adobe Shockwave. Los archivos DCR se utilizan para crear juegos y otros contenidos altamente interactivos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DCR>,
        <https://www.iana.org/assignments/media-types/application/x-director> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dcr",
        "application/x-director" ;
    skos:prefLabel "DCR File"@en,
        "DCR File"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/deb> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Debian package"@en,
        "Debian package"@es ;
    skos:definition "Debian package is a standard Unix ar archive that includes two tar archives. One archive holds the control information and another contains the installable data."@en,
        "El paquete Debian es un archivo estándar Unix ar que incluye dos archivos tar. Un archivo contiene la información de control y otro contiene los datos instalables."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DEB>,
        <https://www.iana.org/assignments/media-types/application/vnd.debian.binary-package> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".deb",
        "application/vnd.debian.binary-package" ;
    skos:prefLabel "deb"@en,
        "deb"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dgn> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "DGN file"@en,
        "DGN file"@es ;
    skos:definition "A DGN file is a 2D/3D drawing created by various construction CAD software, such as MicroStation and Intergraph Interactive Graphics Design System. It may be saved in one of two formats, either the Intergraph Standard File Format (ISFF) or the newer V8 DGN standard. DGN files are typically used to save designs for construction projects for highways, bridges, and buildings."@en,
        "Un archivo DGN es un dibujo 2D/3D creado por diversos programas CAD de construcción, como MicroStation e Intergraph Interactive Graphics Design System. Puede guardarse en uno de dos formatos: el Intergraph Standard File Format (ISFF) o el más reciente estándar V8 DGN. Los archivos DGN se utilizan típicamente para guardar diseños de proyectos de construcción de autopistas, puentes y edificios."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DGN>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dgn",
        "application/octet-stream" ;
    skos:prefLabel "DGN"@en,
        "DGN"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dmg> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Apple Disk Image"@en,
        "Apple Disk Image"@es ;
    skos:definition "Apple Disk Image is a disk image format commonly used by the macOS operating system."@en,
        "Apple Disk Image es un formato de imagen de disco comúnmente utilizado por el sistema operativo macOS."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DMG>,
        <https://www.iana.org/assignments/media-types/application/x-apple-diskimage> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dmg",
        "application/x-apple-diskimage" ;
    skos:prefLabel "DMG"@en,
        "DMG"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dmp> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "DMP is the media type which shall be used for Oracle dumps. This media type is incomplete as it lacks a reference to the specification of the format."@en,
        "DMP es el tipo de medio que se utilizará para volcados de Oracle. Este tipo de medio está incompleto ya que carece de una referencia a la especificación del formato."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DMP>,
        <https://www.iana.org/assignments/media-types/application/x-oracledump> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dmp",
        "application/x-oracledump" ;
    skos:prefLabel "Oracle Dump"@en,
        "Oracle Dump"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/doc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Microsoft Word"@en,
        "Microsoft Word"@es ;
    skos:definition "DOC is a proprietary binary Word document format used by Microsoft Word word processor."@en,
        "DOC es un formato de documento Word binario propietario utilizado por el procesador de textos Microsoft Word."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DOC>,
        <https://www.iana.org/assignments/media-types/application/msword> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".doc",
        "application/msword" ;
    skos:prefLabel "Word DOC"@en,
        "Word DOC"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/docx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Office Open XML Document"@en,
        "Office Open XML Document"@es ;
    skos:definition "DOCX is an Office Open XML international standard for Office documents. It is used by Microsoft Word and by a growing number of applications from other vendors in word processing programs."@en,
        "DOCX es un estándar internacional de Office Open XML para documentos de oficina. Es utilizado por Microsoft Word y por un número creciente de aplicaciones de otros proveedores en programas de procesamiento de textos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DOCX>,
        <https://www.iana.org/assignments/media-types/application/vnd.openxmlformats-officedocument.wordprocessingml.document> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".docx",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ;
    skos:prefLabel "Word DOCX"@en,
        "Word DOCX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dtd_sgml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "SGML Document Type Definition (DTD)"@en,
        "SGML Document Type Definition (DTD)"@es ;
    skos:definition "SGML – Standard Generalized Markup Language – is a standard for defining generalized markup languages for documents. DTD – document type definition – is a set of markup declarations that define a document type for an SGML-family markup language (SGML, XML, HTML). It defines the legal building blocks of an XML document, the document structure with a list of legal elements and attributes."@en,
        "SGML – Standard Generalized Markup Language – es un estándar para definir lenguajes de marcado generalizados para documentos. DTD – document type definition – es un conjunto de declaraciones de marcado que definen un tipo de documento para un lenguaje de marcado de la familia SGML (SGML, XML, HTML). Define los bloques de construcción legales de un documento XML, la estructura del documento con una lista de elementos y atributos legales."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DTD_SGML>,
        <https://www.iana.org/assignments/media-types/application/sgml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dtd",
        "application/sgml" ;
    skos:prefLabel "SGML DTD"@en,
        "SGML DTD"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dtd_xml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "XML Document Type Definition (DTD)"@en,
        "XML Document Type Definition (DTD)"@es ;
    skos:definition "XML – Extensible Markup Language – is a markup language that defines a set of rules for encoding documents in a format that is both human-readable and machine-readable. DTD – document type definition – is a set of markup declarations that define a document type for an SGML-family markup language (SGML, XML, HTML). It defines the legal building blocks of an XML document, the document structure with a list of legal elements and attributes. XML uses a subset of SGML DTD."@en,
        "XML – Extensible Markup Language – es un lenguaje de marcado que define un conjunto de reglas para codificar documentos en un formato legible tanto por humanos como por máquinas. DTD – document type definition – es un conjunto de declaraciones de marcado que definen un tipo de documento para un lenguaje de marcado de la familia SGML. Define los bloques de construcción legales de un documento XML. XML utiliza un subconjunto de SGML DTD."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DTD_XML>,
        <https://www.iana.org/assignments/media-types/application/xml-dtd> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dtd",
        "application/xml-dtd" ;
    skos:prefLabel "XML DTD"@en,
        "XML DTD"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dwca> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Darwin Core Archive"@en,
        "Darwin Core Archive"@es ;
    skos:definition "biodiversity informatics data standard that makes use of the Darwin Core terms to produce a single, self contained dataset for sharing species-level (taxonomic), species-occurrence data, and sampling-event data; an archive is a set of text files, in standard comma- or tab-delimited format, with a simple descriptor file (called meta.xml) to inform others how the files are organized"@en,
        "Estándar de datos de informática de la biodiversidad que utiliza los términos Darwin Core para producir un único conjunto de datos autocontenido para compartir datos a nivel de especie (taxonómicos), datos de ocurrencia de especies y datos de eventos de muestreo; un archivo es un conjunto de archivos de texto, en formato estándar separado por comas o tabulaciones, con un archivo descriptor simple (llamado meta.xml)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DWCA>,
        <https://www.iana.org/assignments/media-types/application/gzip>,
        <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tar.gz; .zip",
        "application/gzip; application/zip" ;
    skos:prefLabel "DwC-A"@en,
        "DwC-A"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dwg> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "DWG file"@en,
        "DWG file"@es ;
    skos:definition "A DWG file is a 2D or 3D drawing created with Autodesk AutoCAD, a professional CAD program. It contains vector image data and metadata that AutoCAD and other CAD applications use to load a drawing. DWG files are related to .DXF files, which are ASCII versions of DWG files."@en,
        "Un archivo DWG es un dibujo 2D o 3D creado con Autodesk AutoCAD, un programa CAD profesional. Contiene datos de imagen vectorial y metadatos que AutoCAD y otras aplicaciones CAD utilizan para cargar un dibujo. Los archivos DWG están relacionados con los archivos .DXF, que son versiones ASCII de los archivos DWG."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DWG>,
        <https://www.iana.org/assignments/media-types/application/dwg>,
        <https://www.iana.org/assignments/media-types/image/vnd.dwg> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dwg",
        "image/vnd.dwg; application/dwg" ;
    skos:prefLabel "DWG"@en,
        "DWG"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/dxf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Drawing Interchange Format"@en,
        "Drawing Interchange Format"@es ;
    skos:definition "A DXF file is a data file saved in a format developed by Autodesk and used for CAD (computer-aided design) vector image files, such as AutoCAD documents. DXF files are similar to .DWG files, but are more compatible with other programs since they are ASCII (text) based."@en,
        "Un archivo DXF es un archivo de datos guardado en un formato desarrollado por Autodesk y utilizado para archivos de imágenes vectoriales CAD (diseño asistido por ordenador), como documentos de AutoCAD. Los archivos DXF son similares a los archivos .DWG, pero son más compatibles con otros programas ya que están basados en ASCII (texto)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/DXF>,
        <https://www.iana.org/assignments/media-types/image/vnd.dxf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".dxf",
        "image/vnd.dxf" ;
    skos:prefLabel "DXF"@en,
        "DXF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/e00> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ESRI Arc/Info interchange file"@en,
        "ESRI Arc/Info interchange file"@es ;
    skos:definition "E00 is an ArcInfo interchange file format. ArcInfo is a full-featured geographic information system produced by Esri."@en,
        "E00 es un formato de archivo de intercambio de ArcInfo. ArcInfo es un sistema de información geográfica completo producido por Esri."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/E00>,
        <https://www.iana.org/assignments/media-types/application/x-e00> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".e00",
        "application/x-e00" ;
    skos:prefLabel "E00"@en,
        "E00"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ear> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Enterprise Application Archive"@en,
        "Enterprise Application Archive"@es ;
    skos:definition "EAR (Enterprise Application aRchive) is a file format used by Java EE for packaging one or more modules into a single archive."@en,
        "EAR (Enterprise Application aRchive) es un formato de archivo utilizado por Java EE para empaquetar uno o más módulos en un único archivo."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/EAR>,
        <https://www.iana.org/assignments/media-types/application/java-archive> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ear",
        "application/java-archive" ;
    skos:prefLabel "EAR"@en,
        "EAR"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ecw> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Enhanced Compressed Wavelet"@en,
        "Enhanced Compressed Wavelet"@es ;
    skos:definition "ECW – Enhanced Compressed Wavelet – is the media type which shall be used for a proprietary wavelet compression image format optimized for aerial and satellite imagery."@en,
        "ECW – Enhanced Compressed Wavelet – es el tipo de medio que se utilizará para un formato propietario de compresión de imágenes por wavelets optimizado para imágenes aéreas y de satélite."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ECW>,
        <https://www.iana.org/assignments/media-types/application/x-ecw> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ecw",
        "application/x-ecw" ;
    skos:prefLabel "ECW"@en,
        "ECW"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/eforms_xml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "eForms XML file"@en,
        "eForms XML file"@es ;
    skos:definition "EU legislative XML standard for procurement data used by public buyers to publish notices on Tenders Electronic Daily (TED), the European public procurement advertising website. The standard forms (eForms) have been established by the Commission Implementing Regulation (EU) 2019/1780 of 23 September 2019, and need to be implemented in national eProcurement systems by being tailored to national needs."@en,
        "Estándar legislativo XML de la UE para datos de contratación pública utilizado por los compradores públicos para publicar anuncios en Tenders Electronic Daily (TED), el sitio web europeo de publicidad de contratación pública. Los formularios estándar (eForms) fueron establecidos por el Reglamento de Ejecución (UE) 2019/1780 de la Comisión, de 23 de septiembre de 2019, y deben implementarse en los sistemas nacionales de contratación electrónica adaptándolos a las necesidades nacionales."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/EFORMS_XML>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "application/xml" ;
    skos:prefLabel "eForms XML"@en,
        "eForms XML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/eps> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "EPS – Encapsulated PostScript – files are more-or-less self-contained, reasonably predictable PostScript documents that describe an image or drawing and can be placed within another PostScript document."@en,
        "Los archivos EPS – Encapsulated PostScript – son documentos PostScript más o menos autónomos y razonablemente predecibles que describen una imagen o dibujo y pueden insertarse dentro de otro documento PostScript."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/EPS>,
        <https://www.iana.org/assignments/media-types/application/postscript> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".eps",
        "application/postscript" ;
    skos:prefLabel "Encapsulated Postscript"@en,
        "Encapsulated Postscript"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/epub> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "eBook standard of the International Digital Publishing Forum (IDPF)"@en,
        "eBook standard of the International Digital Publishing Forum (IDPF)"@es ;
    skos:definition "EPUB – electronic publication – is an e-book file format that can be downloaded and read on devices like smartphones, tablets, computers or e-readers. It is a technical standard published by the International Digital Publishing Forum (IDPF)."@en,
        "EPUB – electronic publication – es un formato de archivo de libro electrónico que puede descargarse y leerse en dispositivos como teléfonos inteligentes, tabletas, ordenadores o lectores electrónicos. Es un estándar técnico publicado por el International Digital Publishing Forum (IDPF)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/EPUB>,
        <https://www.iana.org/assignments/media-types/application/epub+zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".epub",
        "application/epub+zip" ;
    skos:prefLabel "EPUB"@en,
        "EPUB"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/etsi_tsl> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ETSI Trusted List"@en,
        "ETSI Trusted List"@es ;
    skos:definition "file containing information related to the qualified trust service providers and the qualified trust services provided by them"@en,
        "Archivo que contiene información relacionada con los proveedores de servicios de confianza cualificados y los servicios de confianza cualificados proporcionados por ellos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ETSI_TSL>,
        <https://www.iana.org/assignments/media-types/application/vnd.etsi.tsl+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml; .xtsl",
        "application/vnd.etsi.tsl+xml" ;
    skos:prefLabel "ETSI TSL"@en,
        "ETSI TSL"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/etsi_xml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "European Telecommunications Standards Institute signature validation report XML"@en,
        "European Telecommunications Standards Institute signature validation report XML"@es ;
    skos:definition "ETSI signature validation report is a European Telecommunications Standards Institute (ETSI) signature validation report XML file."@en,
        "El informe de validación de firma ETSI es un archivo XML de informe de validación de firma del Instituto Europeo de Normas de Telecomunicaciones (ETSI)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ETSI_XML>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "application/xml" ;
    skos:prefLabel "ETSI signature validation report"@en,
        "ETSI signature validation report"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/exe> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Executable file"@en,
        "Executable file"@es ;
    skos:definition "An executable file (the main execution point of a computer program) for DOS, OpenVMS, Microsoft Windows, Symbian or OS/2. Besides the executable program, many .exe files contain other components called resources, such as bitmap graphics and icons which the executable program may use for its graphical user interface."@en,
        "Un archivo ejecutable (el punto de ejecución principal de un programa informático) para DOS, OpenVMS, Microsoft Windows, Symbian u OS/2. Además del programa ejecutable, muchos archivos .exe contienen otros componentes llamados recursos, como gráficos de mapa de bits e iconos que el programa ejecutable puede usar para su interfaz gráfica de usuario."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/EXE>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".exe",
        "application/octet-stream" ;
    skos:prefLabel "EXE"@en,
        "EXE"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/feature_srvc> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS Feature Service"@en,
        "Servicio de entidades ArcGIS"@es ;
    skos:definition "An ArcGIS Feature Service provides access to vector geospatial features through the ArcGIS REST API. It allows querying, editing, updating, exporting, and displaying records of geographic data (points, lines, polygons) with their attributes. Features can be output in JSON, GeoJSON, and PBF formats."@en,
        "Un servicio de entidades (Feature Service) de ArcGIS proporciona acceso a características geoespaciales vectoriales a través de la API REST de ArcGIS. Permite consultar, editar, actualizar, exportar y visualizar registros de datos geográficos (puntos, líneas, polígonos) con sus atributos. Las entidades pueden devolvorse en formatos JSON, GeoJSON y PBF."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "arcgis_feature_service" ;
    skos:prefLabel "ArcGIS Feature Service"@en,
        "ArcGIS Feature Service"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/fgb> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "FlatGeobuf format"@en,
        "Formato FlatGeobuf"@es ;
    skos:definition "FlatGeobuf is a binary file format for geographic vector data (points, lines, polygons) based on FlatBuffers. It is designed to be suitable for large volumes of static data, significantly faster than legacy formats, without size limitations, and suitable for streaming and random access. It optionally supports a packed Hilbert R-Tree spatial index."@en,
        "FlatGeobuf es un formato de archivo binario para datos vectoriales geográficos (puntos, líneas, polígonos) basado en FlatBuffers. Está diseñado para ser adecuado para grandes volúmenes de datos estáticos, significativamente más rápido que los formatos heredados, sin limitaciones de tamaño y apto para streaming y acceso aleatorio. Soporta opcionalmente un índice espacial R-Tree de Hilbert empaquetado."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".fgb",
        "application/flatgeobuf" ;
    skos:prefLabel "FlatGeobuf"@en,
        "FlatGeobuf"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/fmx2> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Formalized Exchange of Electronic Publications (Formex), version 2"@en,
        "Formalized Exchange of Electronic Publications (Formex), version 2"@es ;
    skos:definition "Formex describes the format for the exchange of data between the Publication Office and its contractors. In particular, it defines the logical markup for documents which are published in the different series of the Offical Journal of the European Union. Formex 2 was a previous version of Formex actually used."@en,
        "Formex describe el formato para el intercambio de datos entre la Oficina de Publicaciones y sus contratistas. En particular, define el marcado lógico para documentos publicados en las diferentes series del Diario Oficial de la Unión Europea. Formex 2 fue una versión anterior de Formex utilizada efectivamente."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/FMX2>,
        <https://www.iana.org/assignments/media-types/text/sgml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "text/sgml" ;
    skos:prefLabel "Formex 2"@en,
        "Formex 2"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/fmx3> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Formalized Exchange of Electronic Publications (Formex), version 3"@en,
        "Formalized Exchange of Electronic Publications (Formex), version 3"@es ;
    skos:definition "Formex describes the format for the exchange of data between the Publication Office and its contractors. In particular, it defines the logical markup for documents which are published in the different series of the Offical Journal of the European Union. Formex 3 was a previous version of Formex actually used."@en,
        "Formex describe el formato para el intercambio de datos entre la Oficina de Publicaciones y sus contratistas. En particular, define el marcado lógico para documentos publicados en las diferentes series del Diario Oficial de la Unión Europea. Formex 3 fue una versión anterior de Formex utilizada efectivamente."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/FMX3>,
        <https://www.iana.org/assignments/media-types/text/sgml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "text/sgml" ;
    skos:prefLabel "Formex 3"@en,
        "Formex 3"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/fmx4> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Formalized Exchange of Electronic Publications (Formex), version 4"@en,
        "Formalized Exchange of Electronic Publications (Formex), version 4"@es ;
    skos:definition "Formex describes the format for the exchange of data between the Publication Office and its contractors. In particular, it defines the logical markup for documents which are published in the different series of the Offical Journal of the European Union. Formex V4 is based on the international standard XML."@en,
        "Formex describe el formato para el intercambio de datos entre la Oficina de Publicaciones y sus contratistas. En particular, define el marcado lógico para documentos publicados en las diferentes series del Diario Oficial de la Unión Europea. Formex V4 se basa en el estándar internacional XML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/FMX4>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "application/xml" ;
    skos:prefLabel "Formex 4"@en,
        "Formex 4"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/fmx4_zip> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Formex 4 ZIP archive"@en,
        "Formex 4 ZIP archive"@es ;
    skos:definition "FMX4 ZIP is a ZIP archive containing files that all belong to a Formex 4 instance."@en,
        "FMX4 ZIP es un archivo ZIP que contiene archivos pertenecientes a una instancia de Formex 4."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/FMX4_ZIP>,
        <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".zip",
        "application/zip" ;
    skos:prefLabel "FMX4 ZIP"@en,
        "FMX4 ZIP"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/gdb> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Environmental Systems Research Institute File Geodatabase"@en,
        "Environmental Systems Research Institute File Geodatabase"@es ;
    skos:definition "GDB is an Esri's file-based geodatabase format, stored as folders in a file system. It shall be used for Esri file geodatabases. The file is a zip archive that contains the gdb directory."@en,
        "GDB es un formato de geodatabase basado en archivos de Esri, almacenado como carpetas en un sistema de archivos. Se utilizará para geodatabases de archivo de Esri. El archivo es un archivo zip que contiene el directorio gdb."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GDB>,
        <https://www.iana.org/assignments/media-types/application/x-filegdb> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".gdb",
        "application/x-filegdb" ;
    skos:prefLabel "Esri File Geodatabase"@en,
        "Esri File Geodatabase"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/geojson> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Geographical JavaScript Object Notation"@en,
        "Geographical JavaScript Object Notation"@es ;
    skos:definition "GeoJSON is an open standard format designed for representing simple geographical features, along with their non-spatial attributes, based on JSON."@en,
        "GeoJSON es un formato de estándar abierto diseñado para representar características geográficas simples, junto con sus atributos no espaciales, basado en JSON."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GEOJSON>,
        <https://www.iana.org/assignments/media-types/application/geo+json> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".json; .geojson",
        "application/geo+json" ;
    skos:prefLabel "GeoJSON"@en,
        "GeoJSON"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/geoparquet> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Apache GeoParquet"@en,
        "Apache GeoParquet"@es ;
    skos:definition "GeoParquet is a specification for storing geospatial vector data (points, lines, polygons) in Apache Parquet format. It defines how geospatial data should be stored in Parquet, including the representation of geometries and the required additional metadata. It is an open-source standardized columnar storage format optimized for read-heavy analytic workflows."@en,
        "GeoParquet es una especificación para almacenar datos vectoriales geoespaciales (puntos, líneas, polígonos) en formato Apache Parquet. Define cómo deben almacenarse los datos geoespaciales en Parquet, incluyendo la representación de geometrías y los metadatos adicionales necesarios. Es un formato columnar de código abierto estandarizado, optimizado para flujos de trabajo analíticos de lectura intensiva."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/vnd.apache.parquet> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".parquet",
        "application/vnd.apache.parquet" ;
    skos:prefLabel "GeoParquet"@en,
        "GeoParquet"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/geotiff> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "OGC GeoTIFF"@en,
        "OGC GeoTIFF"@es ;
    skos:definition "GeoTIFF is a public domain metadata standard which allows georeferencing information to be embedded within a TIFF file. The potential additional information includes map projection, coordinate systems, ellipsoids, datums, and everything else necessary to establish the exact spatial reference for the file."@en,
        "GeoTIFF es un estándar de metadatos de dominio público que permite incrustar información de georreferenciación dentro de un archivo TIFF. La información adicional potencial incluye proyección cartográfica, sistemas de coordenadas, elipsoides, datums y todo lo necesario para establecer la referencia espacial exacta del archivo."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GEOTIFF>,
        <https://www.iana.org/assignments/media-types/image/tiff> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tiff",
        "image/tiff" ;
    skos:prefLabel "GeoTIFF"@en,
        "GeoTIFF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/gif> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Graphics Interchange Format"@en,
        "Graphics Interchange Format"@es ;
    skos:definition "GIF – Graphics Interchange Format – is a bitmap image format that was developed by a team at the bulletin board service (BBS) provider CompuServe."@en,
        "GIF – Graphics Interchange Format – es un formato de imagen de mapa de bits desarrollado por un equipo del proveedor de servicios de tablón de anuncios (BBS) CompuServe."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GIF>,
        <https://www.iana.org/assignments/media-types/image/gif> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".gif",
        "image/gif" ;
    skos:prefLabel "GIF"@en,
        "GIF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/gml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Geography Markup Language"@en,
        "Geography Markup Language"@es ;
    skos:definition "GML – Geography Markup Language – is the XML grammar defined by the Open Geospatial Consortium (OGC) to express geographical features. GML serves as a modeling language for geographic systems as well as an open interchange format for geographic transactions on the Internet."@en,
        "GML – Geography Markup Language – es la gramática XML definida por el Open Geospatial Consortium (OGC) para expresar características geográficas. GML sirve tanto como lenguaje de modelado para sistemas geográficos como formato de intercambio abierto para transacciones geográficas en Internet."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GML>,
        <https://www.iana.org/assignments/media-types/application/gml+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".gml .xml",
        "application/gml+xml" ;
    skos:prefLabel "GML"@en,
        "GML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/gmz> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Zipped Geography Markup Language"@en,
        "Zipped Geography Markup Language"@es ;
    skos:definition "GMZ is the media type which shall be used for a zip archive that contains one or more GML documents."@en,
        "GMZ es el tipo de medio que se utilizará para un archivo zip que contiene uno o más documentos GML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GMZ>,
        <https://www.iana.org/assignments/media-types/application/x-gmz> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".gmz",
        "application/x-gmz" ;
    skos:prefLabel "Zipped GML"@en,
        "Zipped GML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/gpkg> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "OGC GeoPackage"@en,
        "OGC GeoPackage"@es ;
    skos:definition "An OGC GeoPackage is an open, standards-based, platform-independent, portable, self-describing, compact format for transferring geospatial information. It is implemented as a SQLite database container."@en,
        "Un OGC GeoPackage es un formato abierto, basado en estándares, independiente de la plataforma, portátil, autodescriptivo y compacto para la transferencia de información geoespacial. Se implementa como un contenedor de base de datos SQLite."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GPKG>,
        <https://www.iana.org/assignments/media-types/application/geopackage+sqlite3> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".gpkg",
        "application/geopackage+sqlite3" ;
    skos:prefLabel "GeoPackage"@en,
        "GeoPackage"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/gpx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "GPS Exchange Format"@en,
        "GPS Exchange Format"@es ;
    skos:definition "light-weight XML data format for the interchange of GPS data (waypoints, routes, and tracks) between applications and web services"@en,
        "Formato de datos XML ligero para el intercambio de datos GPS (puntos de referencia, rutas y tracks) entre aplicaciones y servicios web."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GPX>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".gpx",
        "application/octet-stream" ;
    skos:prefLabel "GPX"@en,
        "GPX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/grid> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Environmental Systems Research Institute binary grid"@en,
        "Environmental Systems Research Institute binary grid"@es ;
    skos:definition "Esri binary grid is a proprietary binary variation of an Esri grid, a raster GIS file format developed by Esri. It is also known as an ARC/INFO GRID or ARC GRID. It differs from the other Esri grid variation, a non-proprietary ASCII format."@en,
        "Esri binary grid es una variación binaria propietaria de Esri grid, un formato de archivo SIG rasterizado desarrollado por Esri. También se conoce como ARC/INFO GRID o ARC GRID. Difiere de la otra variación de Esri grid, un formato ASCII no propietario."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GRID>,
        <https://www.iana.org/assignments/media-types/application/x-esri-grid>,
        <https://www.iana.org/assignments/media-types/application/x-grid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "application/x-esri-grid; application/x-grid" ;
    skos:prefLabel "Esri binary grid"@en,
        "Esri binary grid"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/grid_ascii> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Environmental Systems Research Institute ASCII grid"@en,
        "Environmental Systems Research Institute ASCII grid"@es ;
    skos:definition "Esri ASCII grid is the media type which shall be used for ASCII GRID files. ASCII GRID is one of the two formats of Esri grid, a raster GIS file format, a non-proprietary ASCII format, also known as an ArcInfo ASCII GRID."@en,
        "Esri ASCII grid es el tipo de medio que se utilizará para archivos ASCII GRID. ASCII GRID es uno de los dos formatos de Esri grid, un formato de archivo SIG rasterizado, un formato ASCII no propietario, también conocido como ArcInfo ASCII GRID."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GRID_ASCII>,
        <https://www.iana.org/assignments/media-types/application/x-ascii-grid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".asc",
        "application/x-ascii-grid" ;
    skos:prefLabel "Esri ASCII grid"@en,
        "Esri ASCII grid"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/gtfs> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "General Transit Feed Specification"@en,
        "General Transit Feed Specification"@es ;
    skos:definition "The General Transit Feed Specification (GTFS) is a data specification that allows public transit agencies to publish their transit data in a format that can be consumed by a wide variety of software applications. GTFS is split into a schedule component that contains schedule, fare, and geographic transit information and a real-time component that contains arrival predictions, vehicle positions and service advisories."@en,
        "La General Transit Feed Specification (GTFS) es una especificación de datos que permite a las agencias de transporte público publicar sus datos de tránsito en un formato que puede ser consumido por una amplia variedad de aplicaciones de software. GTFS se divide en un componente de horarios que contiene información de horarios, tarifas y geografía del tránsito, y un componente en tiempo real que contiene predicciones de llegada, posiciones de vehículos y avisos de servicio."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GTFS>,
        <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".zip",
        "application/zip" ;
    skos:prefLabel "GTFS"@en,
        "GTFS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/gzip> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "GZIP – GNU zip – is a file format and a software application used for file compression and decompression."@en,
        "GZIP – GNU zip – es un formato de archivo y una aplicación de software utilizada para la compresión y descompresión de archivos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/GZIP>,
        <https://www.iana.org/assignments/media-types/application/gzip>,
        <https://www.iana.org/assignments/media-types/application/x-gzip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".gz",
        "application/gzip; application/x-gzip" ;
    skos:prefLabel "GNU zip"@en,
        "GNU zip"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/hdf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Hierarchical Data Format"@en,
        "Hierarchical Data Format"@es ;
    skos:definition "HDF is a set of file formats (HDF4, HDF5) designed to store and organize large amounts of numerical data."@en,
        "HDF es un conjunto de formatos de archivo (HDF4, HDF5) diseñados para almacenar y organizar grandes cantidades de datos numéricos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/HDF>,
        <https://www.iana.org/assignments/media-types/application/x-hdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".h5; .hdf5; .h4; .hdf; .he2; .hdf4; .he5",
        "application/x-hdf" ;
    skos:prefLabel "HDF"@en,
        "HDF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/hdf5> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Hierarchical Data Format version 5"@en,
        "Hierarchical Data Format versión 5"@es ;
    skos:definition "HDF5 (Hierarchical Data Format version 5) is a file format and set of tools designed for managing complex data collections. It allows storing and organizing large amounts of heterogeneous numerical data in a hierarchical structure of groups and datasets within a single file. It is widely used in scientific research, engineering, and Earth observation."@en,
        "HDF5 (Hierarchical Data Format versión 5) es un formato de archivo y un conjunto de herramientas diseñados para gestionar colecciones de datos complejas. Permite almacenar y organizar grandes cantidades de datos numéricos heterogéneos en una estructura jerárquica de grupos y conjuntos de datos dentro de un único archivo. Es ampliamente utilizado en investigación científica, ingeniería y observación de la Tierra."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/x-hdf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".h5; .hdf5",
        "application/x-hdf5" ;
    skos:prefLabel "HDF5"@en,
        "HDF5"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/hdt> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Header Dictionary Triples"@en,
        "Header Dictionary Triples"@es ;
    skos:definition "HDT (Header, Dictionary, Triples) is a compact data structure and binary serialization format for Resource Description Framework (RDF) that keeps big datasets compressed to save space while maintaining search and browse operations without prior decompression."@en,
        "HDT (Header, Dictionary, Triples) es una estructura de datos compacta y un formato de serialización binaria para RDF que mantiene grandes conjuntos de datos comprimidos para ahorrar espacio mientras mantiene operaciones de búsqueda y exploración sin descompresión previa."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/HDT>,
        <https://www.iana.org/assignments/media-types/application/vnd.hdt> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".hdt",
        "application/vnd.hdt" ;
    skos:prefLabel "HDT"@en,
        "HDT"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/html> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "HyperText Mark-up Language"@en,
        "HyperText Mark-up Language"@es ;
    skos:definition "HTML is the standard markup language used to create web pages and its elements form the building blocks of all websites."@en,
        "HTML es el lenguaje de marcado estándar utilizado para crear páginas web y sus elementos forman los bloques de construcción de todos los sitios web."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/HTML>,
        <https://www.iana.org/assignments/media-types/text/html> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".html; .htm",
        "text/html" ;
    skos:prefLabel "HTML"@en,
        "HTML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/html5> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "HyperText Mark-up Language 5"@en,
        "HyperText Mark-up Language 5"@es ;
    skos:definition "HTML5 is a markup language used for structuring and presenting content on the World Wide Web. It is the fifth and last major HTML version that is a World Wide Web Consortium (W3C) recommendation. The current specification is known as the HTML Living Standard. It is maintained by the Web Hypertext Application Technology Working Group (WHATWG), a consortium of the major browser vendors (Apple, Google, Mozilla, and Microsoft)."@en,
        "HTML5 es un lenguaje de marcado utilizado para estructurar y presentar contenido en la World Wide Web. Es la quinta y última versión principal de HTML que es una recomendación del W3C. La especificación actual se conoce como HTML Living Standard y es mantenida por el WHATWG, un consorcio de los principales proveedores de navegadores (Apple, Google, Mozilla y Microsoft)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/HTML5>,
        <https://www.iana.org/assignments/media-types/text/html> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".html; .htm",
        "text/html" ;
    skos:prefLabel "HTML5"@en,
        "HTML5"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/html_simpl> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "HyperText Mark-up Language, simplified"@en,
        "HyperText Mark-up Language, simplified"@es ;
    skos:definition "HTML is a markup language for describing web documents. Its simplified version is used for storage in the Publications Office."@en,
        "HTML es un lenguaje de marcado para describir documentos web. Su versión simplificada se utiliza para el almacenamiento en la Oficina de Publicaciones."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/HTML_SIMPL>,
        <https://www.iana.org/assignments/media-types/text/html> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".html; .htm",
        "text/html" ;
    skos:prefLabel "HTML simplified"@en,
        "HTML simplified"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ics> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "iCalendar"@en,
        "iCalendar"@es ;
    skos:definition "iCalendar is a computer file format which allows Internet users to send meeting requests and tasks to other Internet users by sharing or sending files in this format through various methods."@en,
        "iCalendar es un formato de archivo informático que permite a los usuarios de Internet enviar solicitudes de reuniones y tareas a otros usuarios de Internet compartiendo o enviando archivos en este formato a través de diversos métodos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ICS>,
        <https://www.iana.org/assignments/media-types/text/calendar> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ical; .icalendar; .ifb; .ics",
        "text/calendar" ;
    skos:prefLabel "ICalendar"@en,
        "ICalendar"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/immc_xml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "Files exchanged within the context of the Interinstitutional Metadata Maintenance Committee (IMMC) communication protocol."@en,
        "Archivos intercambiados en el contexto del protocolo de comunicación del Comité Interinstitucional de Mantenimiento de Metadatos (IMMC)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/IMMC_XML>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "_immc.xml",
        "application/xml" ;
    skos:prefLabel "IMMC XML message"@en,
        "IMMC XML message"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/indd> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Adobe InDesign Document"@en,
        "Adobe InDesign Document"@es ;
    skos:definition "INDD is a file format for a page layout file used by Adobe InDesign. InDesign is a desktop publishing software application."@en,
        "INDD es un formato de archivo de maquetación de página utilizado por Adobe InDesign. InDesign es una aplicación de software de autoedición."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/INDD>,
        <https://www.iana.org/assignments/media-types/application/x-indesign> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".indd",
        "application/x-indesign" ;
    skos:prefLabel "INDD"@en,
        "INDD"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ipa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "iOS App Store Package"@en,
        "iOS App Store Package"@es ;
    skos:definition "An .ipa (iOS App Store Package) file is an application archive file used by the iOS operating system."@en,
        "Un archivo .ipa (iOS App Store Package) es un archivo de aplicación utilizado por el sistema operativo iOS."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/IPA>,
        <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ipa",
        "application/zip" ;
    skos:prefLabel "IPA"@en,
        "IPA"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ipynb> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Jupyter Notebook"@en,
        "Jupyter Notebook"@es ;
    skos:definition "An IPYNB (IPython Notebook) file is a Jupyter Notebook document stored in JSON format. It contains an ordered list of input/output cells that can include executable code, rich text (Markdown), mathematics (LaTeX), plots, and images. It is widely used in data science, scientific research, and education."@en,
        "Un archivo IPYNB (IPython Notebook) es un documento Jupyter Notebook almacenado en formato JSON. Contiene una lista ordenada de celdas de entrada/salida que pueden incluir código ejecutable, texto enriquecido (Markdown), matemáticas (LaTeX), gráficos e imágenes. Es ampliamente utilizado en ciencia de datos, investigación científica y educación."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".ipynb",
        "application/x-ipynb+json" ;
    skos:prefLabel "IPYNB"@en,
        "IPYNB"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/iso> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ISO Disc Image file"@en,
        "ISO Disc Image file"@es ;
    skos:definition "Archive file containing the content from (or destined for) an optical disk. Originally it was limited to data formatted to comply with the ISO 9660 standard (1988), hence the format name and the iso file extension. The ISO Disk Image File Format is typically used to package or bundle software, databases, authored DVD video programs, and the like. ISO image files, unlike normal files, are not opened but rather are mounted. ISO image files contain the data contents of every written sector of an optical disc, including the optical disc file system if one is present."@en,
        "Archivo de imagen que contiene el contenido de (o destinado a) un disco óptico. Originalmente se limitaba a datos formateados conforme al estándar ISO 9660 (1988), de ahí el nombre del formato y la extensión iso. El formato de imagen de disco ISO se utiliza típicamente para empaquetar software, bases de datos, programas de vídeo DVD y similares. Los archivos de imagen ISO, a diferencia de los archivos normales, no se abren sino que se montan. Contienen los datos de cada sector escrito de un disco óptico, incluyendo el sistema de archivos del disco óptico si existe."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ISO>,
        <https://www.iana.org/assignments/media-types/application/x-iso9660-image> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".iso; .img",
        "application/x-iso9660-image" ;
    skos:prefLabel "ISO image"@en,
        "ISO image"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/iso_zip> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Zipped ISO Disc Image file"@en,
        "Zipped ISO Disc Image file"@es ;
    skos:definition "ZIP archive containing an ISO disc image file."@en,
        "Archivo ZIP que contiene un archivo de imagen de disco ISO."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ISO_ZIP>,
        <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".zip",
        "application/zip" ;
    skos:prefLabel "Zipped ISO image"@en,
        "Zipped ISO image"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/jar> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Java Archive"@en,
        "Java Archive"@es ;
    skos:definition "JAR (Java Archive) is an archive file that includes a Java-specific manifest file. It is built on the ZIP format."@en,
        "JAR (Java Archive) es un archivo que incluye un archivo de manifiesto específico de Java. Está construido sobre el formato ZIP."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/JAR>,
        <https://www.iana.org/assignments/media-types/application/java-archive> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".jar",
        "application/java-archive" ;
    skos:prefLabel "JAR"@en,
        "JAR"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/jats> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Journal Article Tag Suite"@en,
        "Journal Article Tag Suite"@es ;
    skos:definition "JATS – Journal Article Tag Suite – is an XML format used to describe scientific literature published online. It is a technical standard developed by the National Information Standards Organization (NISO)."@en,
        "JATS – Journal Article Tag Suite – es un formato XML utilizado para describir literatura científica publicada en línea. Es un estándar técnico desarrollado por la National Information Standards Organization (NISO)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/JATS>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "application/xml" ;
    skos:prefLabel "JATS XML"@en,
        "JATS XML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/jpeg> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "JPEG – Joint Photographic Experts Group – is a commonly used method of lossy compression for digital images, particularly for those images produced by digital photography. The degree of compression can be adjusted, allowing a selectable tradeoff between storage size and image quality."@en,
        "JPEG – Joint Photographic Experts Group – es un método de compresión con pérdida ampliamente utilizado para imágenes digitales, particularmente para aquellas producidas por fotografía digital. El grado de compresión puede ajustarse, permitiendo un equilibrio seleccionable entre tamaño de almacenamiento y calidad de imagen."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/JPEG>,
        <https://www.iana.org/assignments/media-types/image/jpeg> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".jpeg; .jpg",
        "image/jpeg" ;
    skos:prefLabel "JPEG"@en,
        "JPEG"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/jpeg2000> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Joint Photographic Experts Group 2000"@en,
        "Joint Photographic Experts Group 2000"@es ;
    skos:definition "JPEG 2000 – Joint Photographic Experts Group 2000 – is an image coding system that uses state-of-the-art compression techniques based on wavelet technology."@en,
        "JPEG 2000 – Joint Photographic Experts Group 2000 – es un sistema de codificación de imágenes que utiliza técnicas de compresión de última generación basadas en tecnología wavelet."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/JPEG2000>,
        <https://www.iana.org/assignments/media-types/image/jp2> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".jpg2; .jp2",
        "image/jp2" ;
    skos:prefLabel "JPEG 2000"@en,
        "JPEG 2000"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/js> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "JavaScript is a high-level, interpreted programming language. It is a language which is also characterized as dynamic, weakly typed, prototype-based and multi-paradigm."@en,
        "JavaScript es un lenguaje de programación de alto nivel e interpretado. Es un lenguaje que también se caracteriza por ser dinámico, débilmente tipado, basado en prototipos y multiparadigma."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/JS>,
        <https://www.iana.org/assignments/media-types/application/javascript>,
        <https://www.iana.org/assignments/media-types/text/javascript> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".js",
        "text/javascript; application/javascript" ;
    skos:prefLabel "JavaScript"@en,
        "JavaScript"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/json> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "JavaScript Object Notation"@en,
        "JavaScript Object Notation"@es ;
    skos:definition "JSON is an open-standard file format that uses human-readable text to transmit data objects consisting of attribute–value pairs and array data types (or any other serializable value). It is a very common data format used for asynchronous browser/server communication."@en,
        "JSON es un formato de archivo de estándar abierto que utiliza texto legible por humanos para transmitir objetos de datos que consisten en pares atributo-valor y tipos de datos de matriz (o cualquier otro valor serializable). Es un formato de datos muy común utilizado para la comunicación asíncrona navegador/servidor."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/JSON>,
        <https://www.iana.org/assignments/media-types/application/json> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".json",
        "application/json" ;
    skos:prefLabel "JSON"@en,
        "JSON"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/json_ld> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "JavaScript Object Notation for Linked Data"@en,
        "JavaScript Object Notation for Linked Data"@es ;
    skos:definition "JSON-LD is a JSON-based format to serialize Linked Data. It is primarily intended to be a way to use Linked Data in Web-based programming environments, to build interoperable Web services, and to store Linked Data in JSON-based storage engines."@en,
        "JSON-LD es un formato basado en JSON para serializar datos enlazados (Linked Data). Está destinado principalmente a ser una forma de utilizar datos enlazados en entornos de programación basados en web, para construir servicios web interoperables y para almacenar datos enlazados en motores de almacenamiento basados en JSON."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/JSON_LD>,
        <https://www.iana.org/assignments/media-types/application/ld+json> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".jsonld",
        "application/ld+json" ;
    skos:prefLabel "JSON-LD"@en,
        "JSON-LD"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/kml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Keyhole Markup Language"@en,
        "Keyhole Markup Language"@es ;
    skos:definition "KML – Keyhole Markup Language – is an XML notation for expressing geographic annotation and visualization within Internet-based, two-dimensional maps and three-dimensional Earth browsers. KML was developed for use with Google Earth and became an international standard."@en,
        "KML – Keyhole Markup Language – es una notación XML para expresar anotaciones geográficas y visualización dentro de mapas bidimensionales y navegadores terrestres tridimensionales basados en Internet. KML fue desarrollado para su uso con Google Earth y se convirtió en un estándar internacional."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/KML>,
        <https://www.iana.org/assignments/media-types/application/vnd.google-earth.kml+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".kml",
        "application/vnd.google-earth.kml+xml" ;
    skos:prefLabel "KML"@en,
        "KML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/kmz> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Keyhole Markup Language, Zipped"@en,
        "Keyhole Markup Language, Zipped"@es ;
    skos:definition "A KMZ file consists of a main KML file and zero or more supporting files that are packaged using a Zip utility into one unit, called an archive. The KMZ file can then be stored and emailed as a single entity. A NetworkLink can fetch a KMZ file from a web server. When the KMZ file is unzipped, the main .kml file and its supporting files are separated into their original formats and directory structure, with their original filenames and extensions. In addition to being an archive format, the Zip format is also compressed, so an archive can include only a single large KML file. Depending on the content of the KML file, this process typically results in 10:1 compression. Your 10 Kbyte KML file can be served with a 1 Kbyte KMZ file."@en,
        "Un archivo KMZ consiste en un archivo KML principal y cero o más archivos de soporte que se empaquetan usando una utilidad Zip en una unidad llamada archivo. El archivo KMZ puede almacenarse y enviarse por correo electrónico como una única entidad. Un NetworkLink puede obtener un archivo KMZ desde un servidor web. Cuando el archivo KMZ se descomprime, el archivo .kml principal y sus archivos de soporte se separan en sus formatos originales y estructura de directorios."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/KMZ>,
        <https://www.iana.org/assignments/media-types/application/vnd.google-earth.kmz> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".kmz",
        "application/vnd.google-earth.kmz" ;
    skos:prefLabel "KMZ"@en,
        "KMZ"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/las> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "LAS – LASer file format – is the media type which shall be used for a public file format for the interchange of 3-dimensional point cloud data data between data users."@en,
        "LAS – LASer file format – es el tipo de medio que se utilizará para un formato de archivo público para el intercambio de datos de nubes de puntos tridimensionales entre usuarios de datos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/LAS>,
        <https://www.iana.org/assignments/media-types/application/x-las> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".las",
        "application/x-las" ;
    skos:prefLabel "LASer file"@en,
        "LASer file"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/laz> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Compressed LASer file"@en,
        "Compressed LASer file"@es ;
    skos:definition "LAZ is the media type which shall be used for compressed LAS files. This media type is incomplete as it lacks a reference to the specification of the format."@en,
        "LAZ es el tipo de medio que se utilizará para archivos LAS comprimidos. Este tipo de medio está incompleto ya que carece de una referencia a la especificación del formato."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/LAZ>,
        <https://www.iana.org/assignments/media-types/application/x-laz> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".laz",
        "application/x-laz" ;
    skos:prefLabel "Compressed LAS file"@en,
        "Compressed LAS file"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/leg> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "retired concept; see AKN4EU_LEG"@en,
        "Concepto retirado; véase AKN4EU_LEG."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/LEG> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:prefLabel "LEG"@en,
        "LEG"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/legalhtml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "LegalHTML file"@en,
        "LegalHTML file"@es ;
    skos:definition "extension of the HTML language designed for representing legal acts; it provides an explicit domain language addressing all structural aspects of an act such as articles, paragraphs, items and references; it also supports the description of the editorial and jurisdictional history of an act and the semantic annotation of domain entities; furthermore, LegalHTML addresses the consolidation of an act and its subsequent modifications into a single document using a tree-like representation of the original content and of its modified versions; finally, a JavaScript API enhances the representation as an active document, enabling the visualization of a consolidated act as it applies at different points in time"@en,
        "Extensión del lenguaje HTML diseñada para representar actos jurídicos; proporciona un lenguaje de dominio explícito que aborda todos los aspectos estructurales de un acto, como artículos, párrafos, elementos y referencias; también soporta la descripción del historial editorial y jurisdiccional de un acto y la anotación semántica de entidades de dominio; además, LegalHTML aborda la consolidación de un acto y sus modificaciones posteriores en un único documento; finalmente, una API JavaScript mejora la representación como documento activo, permitiendo la visualización de un acto consolidado en diferentes momentos temporales."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/LEGALHTML>,
        <https://www.iana.org/assignments/media-types/application/xhtml+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".html",
        "application/xhtml+xml" ;
    skos:prefLabel "LegalHTML"@en,
        "LegalHTML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/lha> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "LHA compressed file"@en,
        "LHA compressed file"@es ;
    skos:definition "Compressed file produced by LHA, a freeware compression utility."@en,
        "Archivo comprimido producido por LHA, una utilidad de compresión gratuita."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/LHA>,
        <https://www.iana.org/assignments/media-types/application/x-lzh-compressed> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".lha; .lzh",
        "application/x-lzh-compressed" ;
    skos:prefLabel "LHA"@en,
        "LHA"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/lpk> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS layer package"@en,
        "ArcGIS layer package"@es ;
    skos:definition "A layer package packages one or more layers and all referenced data sources to create a single compressed .lpk file."@en,
        "Un paquete de capas empaqueta una o más capas y todas las fuentes de datos referenciadas para crear un único archivo comprimido .lpk."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/LPK>,
        <https://www.iana.org/assignments/media-types/application/x-7z-compressed>,
        <https://www.iana.org/assignments/media-types/multipart/mixed> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".lpk",
        "application/x-7z-compressed; multipart/mixed" ;
    skos:prefLabel "Layer package"@en,
        "Layer package"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/lyrx> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS Pro Layer File"@en,
        "Archivo de capa ArcGIS Pro"@es ;
    skos:definition "A LYRX file is an ArcGIS Pro layer file that stores the path to the source data as well as display properties of the layer, including symbology, labeling, query definitions, and other rendering settings. It is a JSON format file used exclusively by ArcGIS Pro, replacing the binary .lyr format from ArcMap."@en,
        "Un archivo LYRX es un archivo de capa de ArcGIS Pro que almacena la ruta a los datos de origen así como propiedades de visualización de la capa, incluyendo simbología, etiquetado, definiciones de consulta y otros ajustes de representación. Es un archivo en formato JSON utilizado exclusivamente por ArcGIS Pro, reemplazando al formato binario .lyr de ArcMap."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/json> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".lyrx",
        "application/json" ;
    skos:prefLabel "LYRX"@en,
        "LYRX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/lzip> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "lzip compressed file"@en,
        "lzip compressed file"@es ;
    skos:definition "Compressed file produced by lzip, free, command-line tool for the compression of data that employs the Lempel-Ziv-Markov chain algorithm (LZMA)."@en,
        "Archivo comprimido producido por lzip, una herramienta gratuita de línea de comandos para la compresión de datos que emplea el algoritmo LZMA (Lempel-Ziv-Markov chain algorithm)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/LZIP>,
        <https://www.iana.org/assignments/media-types/application/x-lzip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".lz",
        "application/x-lzip" ;
    skos:prefLabel "lzip"@en,
        "lzip"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/lzma> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "lzma compressed file"@en,
        "lzma compressed file"@es ;
    skos:definition "Compressed file produced using LZMA (Lempel-Ziv-Markov) chain algorithm."@en,
        "Archivo comprimido producido utilizando el algoritmo LZMA (Lempel-Ziv-Markov chain algorithm)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/LZMA>,
        <https://www.iana.org/assignments/media-types/application/x-lzma> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".lzma",
        "application/x-lzma" ;
    skos:prefLabel "lzma"@en,
        "lzma"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/lzo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "lzo compressed file"@en,
        "lzo compressed file"@es ;
    skos:definition "Compressed file produced using LZO (Lempel-Ziv-Oberhumer), a lossless data compression algorithm that is focused on decompression speed."@en,
        "Archivo comprimido producido utilizando LZO (Lempel-Ziv-Oberhumer), un algoritmo de compresión de datos sin pérdida enfocado en la velocidad de descompresión."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/LZO>,
        <https://www.iana.org/assignments/media-types/application/x-lzop> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".lzo",
        "application/x-lzop" ;
    skos:prefLabel "lzo"@en,
        "lzo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/map_prvw> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "Esri's ArcGIS is a geographic information system (GIS) for working with maps and geographic information. Map previews are normal raster background maps."@en,
        "ArcGIS de Esri es un sistema de información geográfica (SIG) para trabajar con mapas e información geográfica. Las previsualizaciones de mapas son mapas de fondo rasterizados normales."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MAP_PRVW>,
        <https://www.iana.org/assignments/media-types/arcgis_map_preview> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "arcgis_map_preview" ;
    skos:prefLabel "ArcGIS Map Preview"@en,
        "ArcGIS Map Preview"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/map_srvc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "Esri's ArcGIS is a geographic information system (GIS) for working with maps and geographic information. Map services offer access to map and layer content."@en,
        "ArcGIS de Esri es un sistema de información geográfica (SIG) para trabajar con mapas e información geográfica. Los servicios de mapas ofrecen acceso al contenido de mapas y capas."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MAP_SRVC>,
        <https://www.iana.org/assignments/media-types/arcgis_map_service> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "arcgis_map_service" ;
    skos:prefLabel "ArcGIS Map Service"@en,
        "ArcGIS Map Service"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/markdown> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Markdown file"@en,
        "Markdown file"@es ;
    skos:definition "lightweight markup language for creating formatted text using a plain-text editor"@en,
        "Lenguaje de marcado ligero para crear texto formateado usando un editor de texto plano."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MARKDOWN>,
        <https://www.iana.org/assignments/media-types/text/markdown> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".md; .markdown",
        "text/markdown" ;
    skos:prefLabel "Markdown"@en,
        "Markdown"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mathml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Mathematical Markup Language"@en,
        "Mathematical Markup Language"@es ;
    skos:definition "mathematical markup language, an application of XML for describing mathematical notations and capturing both its structure and content"@en,
        "Lenguaje de marcado matemático, una aplicación de XML para describir notaciones matemáticas y capturar tanto su estructura como su contenido."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MATHML>,
        <https://www.iana.org/assignments/media-types/application/mathml+xml>,
        <https://www.iana.org/assignments/media-types/application/mathml-content+xml>,
        <https://www.iana.org/assignments/media-types/application/mathml-presentation+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mathml; .mml",
        "application/mathml+xml; application/mathml-content+xml; application/mathml-presentation+xml" ;
    skos:prefLabel "MathML"@en,
        "MathML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/matlab_mat> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "MATLAB MAT-File"@en,
        "MATLAB MAT-File"@es ;
    skos:definition "proprietary, binary data container format used by MATLAB software from MathWorks"@en,
        "Formato de contenedor de datos binario propietario utilizado por el software MATLAB de MathWorks."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MATLAB_MAT>,
        <https://www.iana.org/assignments/media-types/application/octet-stream> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mat",
        "application/octet-stream" ;
    skos:prefLabel "MATLAB MAT"@en,
        "MATLAB MAT"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mbox> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Mbox"@en,
        "Mbox"@es ;
    skos:definition "MBOX is a generic term for a family of related file formats used for holding collections of email messages. All messages in an mbox mailbox are concatenated and stored as plain text in a single file."@en,
        "MBOX es un término genérico para una familia de formatos de archivo relacionados utilizados para almacenar colecciones de mensajes de correo electrónico. Todos los mensajes en un buzón mbox se concatenan y almacenan como texto plano en un único archivo."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MBOX>,
        <https://www.iana.org/assignments/media-types/application/mbox> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mbox",
        "application/mbox" ;
    skos:prefLabel "MBOX"@en,
        "MBOX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mdb> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Microsoft Access Database"@en,
        "Microsoft Access Database"@es ;
    skos:definition "MDB – Microsoft Database – is a proprietary file format used by 2003 and earlier versions of Microsoft Access. Microsoft Access is a database management system."@en,
        "MDB – Microsoft Database – es un formato de archivo propietario utilizado por las versiones 2003 y anteriores de Microsoft Access. Microsoft Access es un sistema de gestión de bases de datos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MDB>,
        <https://www.iana.org/assignments/media-types/application/vnd.ms-access>,
        <https://www.iana.org/assignments/media-types/application/x-msaccess> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mdb",
        "application/vnd.ms-access; application/x-msaccess" ;
    skos:prefLabel "MDB"@en,
        "MDB"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mets> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Metadata Encoding and Transmission Standard – Logical METS container"@en,
        "Metadata Encoding and Transmission Standard – Logical METS container"@es ;
    skos:definition "METS – Metadata Encoding and Transmission Standard – is a metadata standard for encoding descriptive, administrative and structural metadata regarding objects within a digital library, expressed using the XML schema language."@en,
        "METS – Metadata Encoding and Transmission Standard – es un estándar de metadatos para codificar metadatos descriptivos, administrativos y estructurales relativos a objetos dentro de una biblioteca digital, expresados mediante el lenguaje de esquemas XML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/METS>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "application/xml" ;
    skos:prefLabel "METS XML"@en,
        "METS XML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mets_zip> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Metadata Encoding and Transmission Standard – Physical METS container"@en,
        "Metadata Encoding and Transmission Standard – Physical METS container"@es ;
    skos:definition "METS package is a zip file containing METS XML files."@en,
        "Un paquete METS es un archivo zip que contiene archivos XML METS."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/METS_ZIP>,
        <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".zip",
        "application/zip" ;
    skos:prefLabel "METS package"@en,
        "METS package"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mhtml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "MIME HTML"@en,
        "MIME HTML"@es ;
    skos:definition "MHTML – MIME Encapsulation of Aggregate HTML Documents – is a web page archive format used to combine in a single document the HTML code and its companion resources that are otherwise represented by external links (such as images, Flash animations, Java applets and audio files). The content of an MHTML file is encoded as if it were an HTML e-mail message."@en,
        "MHTML – MIME Encapsulation of Aggregate HTML Documents – es un formato de archivo de página web utilizado para combinar en un único documento el código HTML y sus recursos complementarios que de otro modo estarían representados por enlaces externos (como imágenes, animaciones Flash, applets Java y archivos de audio). El contenido de un archivo MHTML se codifica como si fuera un mensaje de correo electrónico HTML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MHTML>,
        <https://www.iana.org/assignments/media-types/multipart/related> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mhtml; .mht",
        "multipart/related" ;
    skos:prefLabel "MHTML"@en,
        "MHTML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mif_mid> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "MapInfo interchange format"@en,
        "MapInfo interchange format"@es ;
    skos:definition "MapInfo interchange format is a map and database exporting file format of MapInfo software product. The MIF-file filename usually ends with .mif-suffix. Some MIF-files also have a related MID-file. The filename of a MID-file usually ends with .mid-suffix."@en,
        "El formato de intercambio MapInfo es un formato de archivo de exportación de mapas y bases de datos del producto de software MapInfo. El nombre de archivo MIF generalmente termina con el sufijo .mif. Algunos archivos MIF también tienen un archivo MID relacionado. El nombre de archivo MID generalmente termina con el sufijo .mid."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MIF_MID>,
        <https://www.iana.org/assignments/media-types/text/plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mid; .mif",
        "text/plain" ;
    skos:prefLabel "MIF/MID"@en,
        "MIF/MID"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mobi> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Mobipocket eBook format"@en,
        "Mobipocket eBook format"@es ;
    skos:definition "Mobipocket eBook is a proprietary e-book file format of Mobipocket SA company that can be used by mobile phones, personal digital assistants (PDA) and desktop operating systems."@en,
        "Mobipocket eBook es un formato de archivo de libro electrónico propietario de la empresa Mobipocket SA que puede ser utilizado por teléfonos móviles, asistentes digitales personales (PDA) y sistemas operativos de escritorio."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MOBI>,
        <https://www.iana.org/assignments/media-types/application/x-mobipocket-ebook> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mobi; .prc",
        "application/x-mobipocket-ebook" ;
    skos:prefLabel "Mobipocket eBook"@en,
        "Mobipocket eBook"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mop> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "MOPAC Input Format"@en,
        "MOPAC Input Format"@es ;
    skos:definition "MOP is a chemical file format used by MOPAC. MOPAC is a popular computer program used in computational chemistry. It is designed to implement semi-empirical quantum chemistry algorithms."@en,
        "MOP es un formato de archivo químico utilizado por MOPAC. MOPAC es un programa informático popular utilizado en química computacional. Está diseñado para implementar algoritmos de química cuántica semiempírica."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MOP>,
        <https://www.iana.org/assignments/media-types/chemical/x-mopac-input> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mop",
        "chemical/x-mopac-input" ;
    skos:prefLabel "MOP"@en,
        "MOP"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mov> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "QuickTime Movie"@en,
        "QuickTime Movie"@es ;
    skos:definition "computer file format used natively by the QuickTime framework; the format specifies a multimedia container file that contains one or more tracks, each of which stores a particular type of data: audio, video, or text (e.g. for subtitles)"@en,
        "Formato de archivo informático utilizado nativamente por el framework QuickTime; el formato especifica un contenedor multimedia que contiene una o más pistas, cada una de las cuales almacena un tipo particular de datos: audio, vídeo o texto (p. ej. para subtítulos)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MOV>,
        <https://www.iana.org/assignments/media-types/video/quicktime> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mov",
        "video/quicktime" ;
    skos:prefLabel "MOV"@en,
        "MOV"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mp3> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "MPEG-1/MPEG-2 Audio Layer III"@en,
        "MPEG-1/MPEG-2 Audio Layer III"@es ;
    skos:definition "An MP3 is a format for digital audio. It uses the lossy compression to reduce the data without losing audio quality."@en,
        "MP3 es un formato de audio digital. Utiliza compresión con pérdida para reducir los datos sin perder calidad de audio."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MP3>,
        <https://www.iana.org/assignments/media-types/audio/MPA>,
        <https://www.iana.org/assignments/media-types/audio/mpa-robust>,
        <https://www.iana.org/assignments/media-types/audio/mpeg> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mp3",
        "audio/mpa-robust; audio/MPA; audio/mpeg" ;
    skos:prefLabel "MP3"@en,
        "MP3"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mpeg2> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Moving Picture Experts Group 2"@en,
        "Moving Picture Experts Group 2"@es ;
    skos:definition "MPEG-2 – Moving Picture Experts Group – is a standard for the generic coding of moving pictures and associated audio information. It describes a combination of lossy video compression and lossy audio data compression methods, which permit storage and transmission of movies using currently available storage media and transmission bandwidth."@en,
        "MPEG-2 – Moving Picture Experts Group – es un estándar para la codificación genérica de imágenes en movimiento e información de audio asociada. Describe una combinación de métodos de compresión de vídeo y audio con pérdida que permiten el almacenamiento y la transmisión de películas utilizando los medios de almacenamiento y el ancho de banda de transmisión disponibles actualmente."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MPEG2>,
        <https://www.iana.org/assignments/media-types/audio/mpeg>,
        <https://www.iana.org/assignments/media-types/video/mpeg> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mpeg; mpg; mp3; mp2; m2v",
        "audio/mpeg; video/mpeg" ;
    skos:prefLabel "MPEG-2"@en,
        "MPEG-2"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mpeg4> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Moving Picture Experts Group 4"@en,
        "Moving Picture Experts Group 4"@es ;
    skos:definition "MPEG-4 – Moving Picture Experts Group – is a method of defining compression of audio and visual (AV) digital data. It was designated a standard for a group of audio and video coding formats and related technology."@en,
        "MPEG-4 – Moving Picture Experts Group – es un método de definición de compresión de datos digitales de audio y vídeo (AV). Fue designado como estándar para un grupo de formatos de codificación de audio y vídeo y tecnología relacionada."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MPEG4>,
        <https://www.iana.org/assignments/media-types/application/mp4>,
        <https://www.iana.org/assignments/media-types/audio/mp4>,
        <https://www.iana.org/assignments/media-types/video/mp4> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mpeg; mpg; mp4",
        "audio/mp4; video/mp4; application/mp4" ;
    skos:prefLabel "MPEG-4"@en,
        "MPEG-4"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mpeg4_avc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Moving Picture Experts Group 4 Advanced Video Coding"@en,
        "Moving Picture Experts Group 4 Advanced Video Coding"@es ;
    skos:definition "MPEG-4 – Moving Picture Experts Group – Part 10, Advanced Video Coding is a block-oriented motion-compensation-based video compression standard. It is one of the most commonly used formats for the recording, compression and distribution of video content."@en,
        "MPEG-4 – Moving Picture Experts Group – Parte 10, Advanced Video Coding, es un estándar de compresión de vídeo basado en compensación de movimiento orientado a bloques. Es uno de los formatos más utilizados para la grabación, compresión y distribución de contenido de vídeo."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MPEG4_AVC>,
        <https://www.iana.org/assignments/media-types/application/mp4>,
        <https://www.iana.org/assignments/media-types/audio/mp4>,
        <https://www.iana.org/assignments/media-types/video/mp4> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mpeg; mpg; mp4",
        "audio/mp4; video/mp4; application/mp4" ;
    skos:prefLabel "MPEG-4 AVC"@en,
        "MPEG-4 AVC"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mrsid> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Multiresolution seamless image database"@en,
        "Multiresolution seamless image database"@es ;
    skos:definition "Multiresolution seamless image database (MrSID) is a file format developed and patented by LizardTech for encoding of georeferenced raster graphics, such as orthophotos. With this format, large raster image files such as aerial photographs or satellite imagery are compressed and can be quickly viewed without having to decompress the entire file."@en,
        "Multiresolution seamless image database (MrSID) es un formato de archivo desarrollado y patentado por LizardTech para la codificación de gráficos rasterizados georreferenciados, como ortofotografías. Con este formato, archivos de imágenes rasterizadas grandes como fotografías aéreas o imágenes de satélite se comprimen y pueden visualizarse rápidamente sin necesidad de descomprimir el archivo completo."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MRSID>,
        <https://www.iana.org/assignments/media-types/image/x-mrsid>,
        <https://www.iana.org/assignments/media-types/image/x-mrsid-image>,
        <https://www.iana.org/assignments/media-types/image/x.mrsid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".sid",
        "image/x.mrsid; image/x-mrsid; image/x-mrsid-image" ;
    skos:prefLabel "MrSID"@en,
        "MrSID"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/msg_http> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "HTTP Message Syntax and Routing"@en,
        "HTTP Message Syntax and Routing"@es ;
    skos:definition "HTTP – Hypertext Transfer Protocol – is a stateless application-level request/response protocol that uses extensible semantics and self-descriptive message payloads for flexible interaction with network-based hypertext information systems. Message Syntax and Routing is part of the HTTP/1.1 specification."@en,
        "HTTP – Hypertext Transfer Protocol – es un protocolo de solicitud/respuesta a nivel de aplicación sin estado que utiliza semántica extensible y cargas de mensaje autodescriptivas para la interacción flexible con sistemas de información hipertextual basados en red. Message Syntax and Routing es parte de la especificación HTTP/1.1."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MSG_HTTP>,
        <https://www.iana.org/assignments/media-types/message/http> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "message/http" ;
    skos:prefLabel "HTTP Message"@en,
        "HTTP Message"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/msi> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Windows Installer Package"@en,
        "Windows Installer Package"@es ;
    skos:definition "Archive file for Windows Installer containing the installation information and an optional .cab file payload."@en,
        "Archivo de instalación para Windows Installer que contiene la información de instalación y una carga útil opcional de archivo .cab."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MSI>,
        <https://www.iana.org/assignments/media-types/application/x-ole-storage> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".msi; .msp",
        "application/x-ole-storage" ;
    skos:prefLabel "MSI"@en,
        "MSI"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mvt> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Mapbox Vector Tile"@en,
        "Tesela Vectorial de Mapbox"@es ;
    skos:definition "Mapbox Vector Tile (MVT) is an open-source specification for encoding tiled geospatial vector data. It uses Google Protocol Buffers as the binary encoding format. Vector tiles enable efficient representation of geospatial data in web clients with client-side styling."@en,
        "Mapbox Vector Tile (MVT) es una especificación de código abierto para codificar datos geoespaciales vectoriales teselados. Utiliza Protocol Buffers de Google como formato de codificación binaria. Las teselas vectoriales permiten la representación eficiente de datos geoespaciales en clientes web con estilizado del lado del cliente."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/vnd.mapbox-vector-tile> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mvt; .pbf",
        "application/vnd.mapbox-vector-tile" ;
    skos:prefLabel "MVT"@en,
        "MVT"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/mxd> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS Map Document"@en,
        "ArcGIS Map Document"@es ;
    skos:definition "MXD – Map Exchange Document – is a file format in which the maps created from ArcGIS software can be stored."@en,
        "MXD – Map Exchange Document – es un formato de archivo en el que se pueden almacenar los mapas creados con el software ArcGIS."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/MXD>,
        <https://www.iana.org/assignments/media-types/application/x-mxd> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".mxd",
        "application/x-mxd" ;
    skos:prefLabel "MXD"@en,
        "MXD"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/n3> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Notation3"@en,
        "Notation3"@es ;
    skos:definition "Non-XML serialization of Resource Description Framework models."@en,
