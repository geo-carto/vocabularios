<https://geo-carto.github.io/vocabularios/archivo-tipo/stl> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "StereoLithography"@en,
        "StereoLithography"@es ;
    skos:definition "An StL (‘StereoLithography’) file is a triangular representation of a 3-dimensional surface geometry. The surface is tessellated or broken down logically into a series of small triangles (facets). Each facet is described by a perpendicular direction and three points representing the vertices (corners) of the triangle. These data are used by a slicing algorithm to determine the cross sections of the 3-dimensional shape to be built by the fabber. The StL standard includes two data formats, ASCII and binary."@en,
        "Un archivo StL ('StereoLithography') es una representación triangular de una geometría de superficie tridimensional. La superficie se divide lógicamente en una serie de pequeños triángulos (facetas). Cada faceta se describe mediante una dirección perpendicular y tres puntos que representan los vértices del triángulo. Estos datos son utilizados por un algoritmo de corte para determinar las secciones transversales de la forma tridimensional. El estándar StL incluye dos formatos de datos: ASCII y binario."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/STL>,
        <https://www.iana.org/assignments/media-types/model/stl>,
        <https://www.iana.org/assignments/media-types/model/x.stl-ascii>,
        <https://www.iana.org/assignments/media-types/model/x.stl-binary> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".stl",
        "model/x.stl-ascii; model/x.stl-binary; model/stl" ;
    skos:prefLabel "StL"@en,
        "StL"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/stylx> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS Pro Style File"@en,
        "Archivo de estilo ArcGIS Pro"@es ;
    skos:definition "A STYLX file is a style file used by Esri's ArcGIS Pro and ArcGIS Online. It contains style elements such as map symbols (points, lines, polygons), labels, color settings, font information, and fill patterns, used to unify and manage the visual presentation of maps. It is based on the SQLite database format and stores symbols and style elements in the database."@en,
        "Un archivo STYLX es un archivo de estilo utilizado por ArcGIS Pro y ArcGIS Online de Esri. Contiene elementos de estilo como símbolos de mapa (puntos, líneas, polígonos), etiquetas, configuraciones de color, información de fuentes y patrones de relleno, utilizados para unificar y gestionar la presentación visual de los mapas. Está basado en el formato de base de datos SQLite y almacena símbolos y elementos de estilo en la base de datos."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".stylx",
        "application/x-sqlite3" ;
    skos:prefLabel "STYLX"@en,
        "STYLX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/svg> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Scalable Vector Graphics"@en,
        "Scalable Vector Graphics"@es ;
    skos:definition "Open standard for two-dimensional vector graphics."@en,
        "Estándar abierto para gráficos vectoriales bidimensionales."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SVG>,
        <https://www.iana.org/assignments/media-types/image/svg+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".svgz; .svg",
        "image/svg+xml" ;
    skos:prefLabel "SVG"@en,
        "SVG"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/swm> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Split WIM file"@en,
        "Split WIM file"@es ;
    skos:definition "Split WIM file is a Windows Imaging Format file that has been split into multiple parts."@en,
        "Un archivo Split WIM es un archivo de formato de imagen de Windows que se ha dividido en múltiples partes."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SWM>,
        <https://www.iana.org/assignments/media-types/application/x-ms-wim> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".swm",
        "application/x-ms-wim" ;
    skos:prefLabel "SWM"@en,
        "SWM"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/tab> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "MapInfo TAB is the media type which shall be used for the MapInfo TAB format. The file is a zip archive that contains at least the tab, dat, map and id files."@en,
        "MapInfo TAB es el tipo de medio que se utilizará para el formato MapInfo TAB. El archivo es un archivo zip que contiene al menos los archivos tab, dat, map e id."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TAB>,
        <https://www.iana.org/assignments/media-types/application/x-tab> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tab",
        "application/x-tab" ;
    skos:prefLabel "MapInfo TAB file"@en,
        "MapInfo TAB file"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/tab_rstr> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "MapInfo TAB raster file is the media type which shall be used for the MapInfo Raster TAB format. This media type is incomplete as it lacks a reference to the specification of the format."@en,
        "El archivo rasterizado MapInfo TAB es el tipo de medio que se utilizará para el formato MapInfo Raster TAB. Este tipo de medio está incompleto ya que carece de una referencia a la especificación del formato."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TAB_RSTR>,
        <https://www.iana.org/assignments/media-types/application/x-tab-raster> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tab",
        "application/x-tab-raster" ;
    skos:prefLabel "MapInfo TAB raster file"@en,
        "MapInfo TAB raster file"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/tar> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Tape Archive"@en,
        "Tape Archive"@es ;
    skos:definition "TAR – tape archive – is a computer software utility for collecting many files into one archive file for distribution or backup purposes."@en,
        "TAR – tape archive – es una utilidad de software informático para recopilar muchos archivos en un único archivo de almacenamiento para distribución o copia de seguridad."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TAR>,
        <https://www.iana.org/assignments/media-types/application/x-tar> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tar",
        "application/x-tar" ;
    skos:prefLabel "TAR"@en,
        "TAR"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/tar_gz> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Compressed Tarball File"@en,
        "Compressed Tarball File"@es ;
    skos:definition "TAR – tape archive – is a computer software utility for collecting many files into one archive file, often referred to as a tarball, for distribution or backup purposes. GZ – gzip – is a file format and a software application used for file compression and decompression."@en,
        "TAR – tape archive – es una utilidad de software para recopilar muchos archivos en un único archivo, frecuentemente denominado tarball, para distribución o copia de seguridad. GZ – gzip – es un formato de archivo y una aplicación de software utilizada para la compresión y descompresión de archivos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TAR_GZ>,
        <https://www.iana.org/assignments/media-types/application/gzip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tar.gz",
        "application/gzip" ;
    skos:prefLabel "TAR GZ"@en,
        "TAR GZ"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/tar_xz> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "XZ Compressed Tar Archive"@en,
        "XZ Compressed Tar Archive"@es ;
    skos:definition "TAR – tape archive – is a computer software utility for collecting many files into one archive file, often referred to as a tarball, for distribution or backup purposes. XZ is a lossless compression program and file format."@en,
        "TAR – tape archive – es una utilidad de software para recopilar muchos archivos en un único archivo, frecuentemente denominado tarball, para distribución o copia de seguridad. XZ es un programa y formato de compresión sin pérdida."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TAR_XZ>,
        <https://www.iana.org/assignments/media-types/application/x-compressed> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tar.xz",
        "application/x-compressed" ;
    skos:prefLabel "TAR XZ"@en,
        "TAR XZ"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/thrift_binary> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Apache Thrift binary format"@en,
        "Apache Thrift binary format"@es ;
    skos:definition "interface definition language and binary communication protocol used for defining and creating services for programming languages; binary format"@en,
        "Lenguaje de definición de interfaces y protocolo de comunicación binario utilizado para definir y crear servicios para lenguajes de programación; formato binario."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/THRIFT_BINARY>,
        <https://www.iana.org/assignments/media-types/application/vnd.apache.thrift.binary> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "application/vnd.apache.thrift.binary" ;
    skos:prefLabel "Thrift binary"@en,
        "Thrift binary"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/thrift_compact> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Apache Thrift compact binary format"@en,
        "Apache Thrift compact binary format"@es ;
    skos:definition "interface definition language and binary communication protocol used for defining and creating services for programming languages; more compact binary format"@en,
        "Lenguaje de definición de interfaces y protocolo de comunicación binario utilizado para definir y crear servicios para lenguajes de programación; formato binario más compacto."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/THRIFT_COMPACT>,
        <https://www.iana.org/assignments/media-types/application/vnd.apache.thrift.compact> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "application/vnd.apache.thrift.compact" ;
    skos:prefLabel "Thrift compact"@en,
        "Thrift compact"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/thrift_json> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Apache Thrift JSON format"@en,
        "Apache Thrift JSON format"@es ;
    skos:definition "interface definition language and binary communication protocol used for defining and creating services for programming languages; JSON format"@en,
        "Lenguaje de definición de interfaces y protocolo de comunicación binario utilizado para definir y crear servicios para lenguajes de programación; formato JSON."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/THRIFT_JSON>,
        <https://www.iana.org/assignments/media-types/application/vnd.apache.thrift.json> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "application/vnd.apache.thrift.json" ;
    skos:prefLabel "Thrift JSON"@en,
        "Thrift JSON"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/tiff> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Tagged Image Format File"@en,
        "Tagged Image Format File"@es ;
    skos:definition "TIFF – Tagged Image File Format – is a computer file format for storing raster graphics images, popular among graphic artists, the publishing industry and photographers. TIFF is widely supported by scanning, faxing, word processing, optical character recognition, image manipulation, desktop publishing and page-layout applications. The format was created by Aldus Corporation for use in desktop publishing."@en,
        "TIFF – Tagged Image File Format – es un formato de archivo informático para almacenar imágenes de gráficos rasterizados, popular entre artistas gráficos, la industria editorial y los fotógrafos. TIFF es ampliamente soportado por aplicaciones de escaneo, fax, procesamiento de textos, reconocimiento óptico de caracteres, manipulación de imágenes, autoedición y maquetación. El formato fue creado por Aldus Corporation para su uso en autoedición."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TIFF>,
        <https://www.iana.org/assignments/media-types/image/tiff> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tif; .tiff",
        "image/tiff" ;
    skos:prefLabel "TIFF"@en,
        "TIFF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/tiff_fx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Tagged Image Format File Fax eXtended"@en,
        "Tagged Image Format File Fax eXtended"@es ;
    skos:definition "TIFF-FX is a TIFF-based file format created for fax sendings over the Internet."@en,
        "TIFF-FX es un formato de archivo basado en TIFF creado para el envío de faxes a través de Internet."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TIFF_FX>,
        <https://www.iana.org/assignments/media-types/image/tiff-fx> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tif; .tiff",
        "image/tiff-fx" ;
    skos:prefLabel "TIFF FX"@en,
        "TIFF FX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/tmx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Translation Memory eXchange"@en,
        "Translation Memory eXchange"@es ;
    skos:definition "TMX – Translation Memory eXchange – is an XML specification for the exchange of translation memory data between computer-aided translation and localization tools with little or no loss of critical data."@en,
        "TMX – Translation Memory eXchange – es una especificación XML para el intercambio de datos de memoria de traducción entre herramientas de traducción asistida por ordenador y de localización con poca o ninguna pérdida de datos críticos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TMX>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "application/xml" ;
    skos:prefLabel "TMX"@en,
        "TMX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/tsv> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Tab-Separated Value"@en,
        "Tab-Separated Value"@es ;
    skos:definition "TSV – tab-separated values – files are a simple text format for storing data in a tabular structure, e.g. database table or spreadsheet data, and a way of exchanging information between databases. Each record in the table is one line of the text file. Each field value of a record is separated from the next by a tab character."@en,
        "TSV – tab-separated values (valores separados por tabulaciones) – son un formato de texto simple para almacenar datos en una estructura tabular, como tablas de bases de datos u hojas de cálculo, y una forma de intercambiar información entre bases de datos. Cada registro de la tabla es una línea del archivo de texto. Cada valor de campo de un registro está separado del siguiente por un carácter de tabulación."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TSV>,
        <https://www.iana.org/assignments/media-types/text/tab-separated-values> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tsv; .tab",
        "text/tab-separated-values" ;
    skos:prefLabel "TSV"@en,
        "TSV"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/txt> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Text file"@en,
        "Text file"@es ;
    skos:definition "Plain text is the data (e.g. file contents) that represent only characters of readable material but not its graphical representation nor other objects. It may also include a limited number of characters that control simple arrangement of text, such as line breaks or tabulation characters. Plain text is different from formatted text, where style information is included, and from ‘binary files’ in which some portions must be interpreted as binary objects (encoded integers, real numbers, images, etc.)."@en,
        "El texto plano son datos (p. ej. contenido de archivos) que representan únicamente caracteres de material legible pero no su representación gráfica ni otros objetos. También puede incluir un número limitado de caracteres que controlan la disposición simple del texto, como saltos de línea o caracteres de tabulación. El texto plano es diferente del texto formateado y de los archivos binarios."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/TXT>,
        <https://www.iana.org/assignments/media-types/text/plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".txt",
        "text/plain" ;
    skos:prefLabel "Plain text"@en,
        "Plain text"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/ungen> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "ArcGIS ungenerate"@en,
        "ArcGIS ungenerate"@es ;
    skos:definition "ArcGIS ungenerate creates a text file of x,y coordinates from the input coverage. It provides a useful mechanism to create simple coordinate files from coverages. This allows you to easily transfer coverages to other mapping systems or view and update individual coordinates using your computer’s text editor."@en,
        "ArcGIS ungenerate crea un archivo de texto de coordenadas x,y a partir de la cobertura de entrada. Proporciona un mecanismo útil para crear archivos de coordenadas simples a partir de coberturas, permitiendo transferir coberturas fácilmente a otros sistemas de cartografía o ver y actualizar coordenadas individuales."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/UNGEN>,
        <https://www.iana.org/assignments/media-types/text/plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "text/plain" ;
    skos:prefLabel "Ungen"@en,
        "Ungen"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/vcf> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Variant Call Format"@en,
        "Variant Call Format"@es ;
    skos:definition "standard text file format used in bioinformatics for storing gene sequence or DNA sequence variations"@en,
        "Formato estándar de archivo de texto utilizado en bioinformática para almacenar secuencias genéticas o variaciones de secuencias de ADN."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/VCF>,
        <https://www.iana.org/assignments/media-types/text/vnd.vcf> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".vcf; .vcf.gz",
        "text/vnd.vcf" ;
    skos:prefLabel "VCF"@en,
        "VCF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/war> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Web Archive"@en,
        "Web Archive"@es ;
    skos:definition "A WAR file is used to distribute a collection of JAR-files, JavaServer Pages, Java Servlets, Java classes, XML files, tag libraries, static web pages and other resources that together constitute a web application."@en,
        "Un archivo WAR se utiliza para distribuir una colección de archivos JAR, JavaServer Pages, Java Servlets, clases Java, archivos XML, bibliotecas de etiquetas, páginas web estáticas y otros recursos que en conjunto constituyen una aplicación web."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WAR>,
        <https://www.iana.org/assignments/media-types/application/java+zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".war",
        "application/java+zip" ;
    skos:prefLabel "WAR"@en,
        "WAR"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/warc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Web Archive format"@en,
        "Web Archive format"@es ;
    skos:definition "WARC is a web archive format which specifies a method for combining multiple digital resources into an aggregate archive file together with related information."@en,
        "WARC es un formato de archivo web que especifica un método para combinar múltiples recursos digitales en un archivo agregado junto con información relacionada."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WARC>,
        <https://www.iana.org/assignments/media-types/application/warc> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".warc",
        "application/warc" ;
    skos:prefLabel "WARC"@en,
        "WARC"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/warc_gz> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Compressed Web Archive format"@en,
        "Compressed Web Archive format"@es ;
    skos:definition "WARC is a web archive format which specifies a method for combining multiple digital resources into an aggregate archive file together with related information. WARC GZ is WARC compressed by GZIP."@en,
        "WARC es un formato de archivo web que especifica un método para combinar múltiples recursos digitales en un archivo agregado junto con información relacionada. WARC GZ es WARC comprimido con GZIP."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WARC_GZ>,
        <https://www.iana.org/assignments/media-types/application/gzip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".warc.gz",
        "application/gzip" ;
    skos:prefLabel "WARC GZ"@en,
        "WARC GZ"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/wav> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Waveform Audio File"@en,
        "Waveform Audio File"@es ;
    skos:definition "Waveform Audio File (WAV) is a format is used for storing uncompressed digital audio files. It is the default audio format for Windows but it is supported by most operating systems."@en,
        "El formato de archivo de audio Waveform (WAV) se utiliza para almacenar archivos de audio digital sin comprimir. Es el formato de audio predeterminado para Windows, pero es soportado por la mayoría de los sistemas operativos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WAV>,
        <https://www.iana.org/assignments/media-types/audio/vnd.wave>,
        <https://www.iana.org/assignments/media-types/audio/wav>,
        <https://www.iana.org/assignments/media-types/audio/wave>,
        <https://www.iana.org/assignments/media-types/audio/x-wav> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".wav; .wave",
        "audio/vnd.wave; audio/wav; audio/wave; audio/x-wav" ;
    skos:prefLabel "WAV"@en,
        "WAV"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/wcs_srvc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Web Coverage Service"@en,
        "Web Coverage Service"@es ;
    skos:definition "The Open Geospatial Consortium Web Coverage Service Interface Standard (WCS) defines Web-based retrieval of coverages – that is, digital geospatial information representing space/time-varying phenomena."@en,
        "El estándar de interfaz Web Coverage Service (WCS) del Open Geospatial Consortium define la recuperación basada en web de coberturas, es decir, información geoespacial digital que representa fenómenos que varían en espacio y tiempo."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WCS_SRVC>,
        <https://www.iana.org/assignments/media-types/multipart/related>,
        <https://www.iana.org/assignments/media-types/text/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "text/xml; multipart/related" ;
    skos:prefLabel "WCS"@en,
        "WCS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/webp> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "WebP image"@en,
        "WebP image"@es ;
    skos:definition "WebP is an image file format developed by Google intended as a replacement for JPEG, PNG, and GIF file formats. It supports both lossy and lossless compression, as well as animation and alpha transparency."@en,
        "WebP es un formato de archivo de imagen desarrollado por Google como reemplazo de los formatos JPEG, PNG y GIF. Soporta tanto compresión con pérdida como sin pérdida, así como animación y transparencia alfa."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WEBP>,
        <https://www.iana.org/assignments/media-types/image/webp> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".webp",
        "image/webp" ;
    skos:prefLabel "WebP"@en,
        "WebP"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/wfs_srvc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Web Feature Service"@en,
        "Web Feature Service"@es ;
    skos:definition "The Open Geospatial Consortium Web Feature Service (WFS) Interface Standard provides an interface allowing requests for geospatial features across the web using platform-independent mechanisms and is independent of the underlying data store."@en,
        "El estándar de interfaz Web Feature Service (WFS) del Open Geospatial Consortium proporciona una interfaz que permite solicitudes de características geoespaciales a través de la web utilizando mecanismos independientes de la plataforma y es independiente del almacén de datos subyacente."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WFS_SRVC>,
        <https://www.iana.org/assignments/media-types/application/gml+xml>,
        <https://www.iana.org/assignments/media-types/text/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "application/gml+xml; text/xml" ;
    skos:prefLabel "WFS"@en,
        "WFS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/wim> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Windows Imaging Format"@en,
        "Windows Imaging Format"@es ;
    skos:definition "The Windows Imaging Format (WIM) is a file-based disk image format."@en,
        "El Windows Imaging Format (WIM) es un formato de imagen de disco basado en archivos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WIM>,
        <https://www.iana.org/assignments/media-types/application/x-ms-wim> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".swm",
        "application/x-ms-wim" ;
    skos:prefLabel "WIM"@en,
        "WIM"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/wms_srvc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Web Map Service"@en,
        "Web Map Service"@es ;
    skos:definition "A Web Map Service (WMS) is a standard protocol developed by the Open Geospatial Consortium (OGC) for serving georeferenced map images over the Internet. These images are typically produced by a map server from data provided by a geographic information system (GIS) database."@en,
        "Un Web Map Service (WMS) es un protocolo estándar desarrollado por el Open Geospatial Consortium (OGC) para servir imágenes de mapas georreferenciados a través de Internet. Estas imágenes son típicamente producidas por un servidor de mapas a partir de datos proporcionados por una base de datos de sistema de información geográfica (SIG)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WMS_SRVC>,
        <https://www.iana.org/assignments/media-types/application/vnd.ogc.wms_xml>,
        <https://www.iana.org/assignments/media-types/text/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "text/xml; application/vnd.ogc.wms_xml" ;
    skos:prefLabel "WMS"@en,
        "WMS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/wmts_srvc> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Web Map Tile Service"@en,
        "Web Map Tile Service"@es ;
    skos:definition "Open Geospatial Consortium’s standard for serving digital maps using predefined image tiles"@en,
        "Estándar del Open Geospatial Consortium para servir mapas digitales utilizando teselas de imagen predefinidas."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WMTS_SRVC>,
        <https://www.iana.org/assignments/media-types/application/gml+xml>,
        <https://www.iana.org/assignments/media-types/text/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "application/gml+xml; text/xml" ;
    skos:prefLabel "WMTS"@en,
        "WMTS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/world> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "A world file is a plain text computer data file used by geographic information systems (GIS) to georeference raster map images. The file extension usually depends on the format of the associated image, e.g. .jgw for JPEG (2000) or .tfw for TIFF."@en,
        "Un archivo world es un archivo de datos informáticos de texto plano utilizado por los sistemas de información geográfica (SIG) para georreferenciar imágenes de mapas rasterizados. La extensión del archivo generalmente depende del formato de la imagen asociada, p. ej. .jgw para JPEG (2000) o .tfw para TIFF."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/WORLD>,
        <https://www.iana.org/assignments/media-types/application/x-worldfile> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".tfw; .jgw",
        "application/x-worldfile" ;
    skos:prefLabel "World file"@en,
        "World file"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xhtml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Extensible Hypertext Markup Language"@en,
        "Extensible Hypertext Markup Language"@es ;
    skos:definition "XHTML is a family of current and future document types and modules that reproduce, subset and extend HTML 4. XHTML family document types are XML based."@en,
        "XHTML es una familia de tipos de documentos actuales y futuros y módulos que reproducen, subconjuntan y extienden HTML 4. Los tipos de documento de la familia XHTML están basados en XML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XHTML>,
        <https://www.iana.org/assignments/media-types/application/xhtml+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".html; .htm; .xhtml; .xht",
        "application/xhtml+xml" ;
    skos:prefLabel "XHTML"@en,
        "XHTML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xhtml5> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Extensible Hypertext Markup Language 5"@en,
        "Extensible Hypertext Markup Language 5"@es ;
    skos:definition "XML documents must be served with an XML Internet media type (often called ‘MIME type’) such as application/xhtml+xml or application/xml, and must conform to strict, well-formed syntax of XML. XHTML 5 is simply XML-serialized HTML 5 data (that is, HTML 5 constrained to XHTML’s strict requirements, e.g., not having any unclosed tags), sent with one of XML media types. HTML that has been written to conform to both the HTML and XHTML specifications and therefore produces the same DOM tree whether parsed as HTML or XML is known as polyglot markup. There is no DTD for XHTML5."@en,
        "Los documentos XML deben servirse con un tipo de medio Internet XML (frecuentemente llamado 'tipo MIME') como application/xhtml+xml o application/xml, y deben cumplir con la sintaxis estricta y bien formada de XML. XHTML 5 es simplemente datos HTML 5 serializados como XML, enviados con uno de los tipos de medio XML. El HTML escrito para conformar tanto las especificaciones HTML como XHTML se conoce como marcado políglota. No existe DTD para XHTML5."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XHTML5>,
        <https://www.iana.org/assignments/media-types/application/xhtml+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".html; .htm; .xhtml; .xht",
        "application/xhtml+xml" ;
    skos:prefLabel "XHTML5"@en,
        "XHTML5"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xhtml_simpl> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Extensible Hypertext Markup Language, simplified"@en,
        "Extensible Hypertext Markup Language, simplified"@es ;
    skos:definition "XHTML is HTML written as XML. Its simplified version is used for storage in the Publications Office."@en,
        "XHTML es HTML escrito como XML. Su versión simplificada se utiliza para el almacenamiento en la Oficina de Publicaciones."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XHTML_SIMPL>,
        <https://www.iana.org/assignments/media-types/application/xhtml+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".html; .htm; .xhtml; .xht",
        "application/xhtml+xml" ;
    skos:prefLabel "XHTML simplified"@en,
        "XHTML simplified"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xliff> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "XML Localisation Interchange File Format"@en,
        "XML Localisation Interchange File Format"@es ;
    skos:definition "XLIFF is the XML Localisation Interchange File Format designed by a group of multilingual content publishers, software providers, localization service providers, localization tools providers and researchers. It is intended to give any multilingual content owner a single interchange file format that can be understood by any localization provider, using any conformant localization tool. While the primary focus is on being a lossless interchange format, usage of XLIFF as a processing format is neither encouraged nor discouraged or prohibited."@en,
        "XLIFF es el formato de archivo de intercambio de localización XML diseñado por un grupo de editores de contenido multilingüe, proveedores de software, proveedores de servicios de localización, proveedores de herramientas de localización e investigadores. Está destinado a proporcionar a cualquier propietario de contenido multilingüe un formato de archivo de intercambio único que pueda ser entendido por cualquier proveedor de localización utilizando cualquier herramienta conforme."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XLIFF>,
        <https://www.iana.org/assignments/media-types/application/xliff+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xlf",
        "application/xliff+xml" ;
    skos:prefLabel "XLIFF"@en,
        "XLIFF"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xls> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Microsof Excel Workbook"@en,
        "Microsof Excel Workbook"@es ;
    skos:definition "XLS is a proprietary binary file format used for Microsoft Excel spreadsheet which features calculation, graphing tools, pivot tables and a macro programming language."@en,
        "XLS es un formato de archivo binario propietario utilizado para hojas de cálculo de Microsoft Excel con funciones de cálculo, herramientas de gráficos, tablas dinámicas y un lenguaje de programación de macros."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XLS>,
        <https://www.iana.org/assignments/media-types/application/vnd.ms-excel> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xls",
        "application/vnd.ms-excel" ;
    skos:prefLabel "Excel XLS"@en,
        "Excel XLS"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xlsb> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Excel Binary Workbook"@en,
        "Excel Binary Workbook"@es ;
    skos:definition "A file with the XLSB file extension is an Excel Binary Workbook file. They store information in binary format instead of XML like with most other Excel files (like XLSX). Since XLSB files are binary, they can be read from and written to much faster, making them extremely useful for very large spreadsheets."@en,
        "Un archivo con la extensión XLSB es un archivo de libro de Excel binario. Almacenan información en formato binario en lugar de XML como la mayoría de los otros archivos de Excel (como XLSX). Dado que los archivos XLSB son binarios, se pueden leer y escribir mucho más rápido, lo que los hace extremadamente útiles para hojas de cálculo muy grandes."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XLSB>,
        <https://www.iana.org/assignments/media-types/application/vnd.ms-excel.sheet.binary.macroEnabled.12> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xlsb",
        "application/vnd.ms-excel.sheet.binary.macroEnabled.12" ;
    skos:prefLabel "XLSB"@en,
        "XLSB"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xlsm> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Excel Macro-enabled Workbook"@en,
        "Excel Macro-enabled Workbook"@es ;
    skos:definition "An Excel Macro-enabled Workbook contains worksheets of cells arranged by rows and columns as well as embedded macros programmed in the Visual Basic for Applications (VBA) language. XLSM files are saved in the Open XML format introduced in Microsoft Office 2007. XLSM files are XLSX files, but with macros enabled."@en,
        "Un libro de Excel habilitado para macros contiene hojas de cálculo de celdas organizadas por filas y columnas, así como macros incrustadas programadas en el lenguaje Visual Basic for Applications (VBA). Los archivos XLSM se guardan en el formato Open XML introducido en Microsoft Office 2007. Los archivos XLSM son archivos XLSX con macros habilitadas."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XLSM>,
        <https://www.iana.org/assignments/media-types/application/vnd.ms-excel.sheet.macroEnabled.12> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xlsm",
        "application/vnd.ms-excel.sheet.macroEnabled.12" ;
    skos:prefLabel "XLSM"@en,
        "XLSM"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xlsx> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Office Open XML Workbook"@en,
        "Office Open XML Workbook"@es ;
    skos:definition "XLSX is the default file format for Excel 2007 and later workbook used for Microsoft Excel spreadsheet which features calculation, graphing tools, pivot tables and a macro programming language. XLSX is in reality a ZIP compressed archive with a directory structure of XML text documents."@en,
        "XLSX es el formato de archivo predeterminado para libros de Excel 2007 y posteriores, utilizado para hojas de cálculo de Microsoft Excel con funciones de cálculo, herramientas de gráficos, tablas dinámicas y un lenguaje de programación de macros. XLSX es en realidad un archivo comprimido ZIP con una estructura de directorios de documentos de texto XML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XLSX>,
        <https://www.iana.org/assignments/media-types/application/vnd.openxmlformats-officedocument.spreadsheetml.sheet> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xlsx",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" ;
    skos:prefLabel "Excel XLSX"@en,
        "Excel XLSX"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Extensible Markup Language"@en,
        "Extensible Markup Language"@es ;
    skos:definition "XML – Extensible Markup Language – is a markup language that defines a set of rules for encoding documents in a format that is both human-readable and machine-readable. The design goals of XML emphasize simplicity, generality and usability across the Internet."@en,
        "XML – Extensible Markup Language – es un lenguaje de marcado que define un conjunto de reglas para codificar documentos en un formato legible tanto por humanos como por máquinas. Los objetivos de diseño de XML enfatizan la simplicidad, la generalidad y la usabilidad a través de Internet."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XML>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xml",
        "application/xml" ;
    skos:prefLabel "XML"@en,
        "XML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xslfo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Extensible Stylesheet Language – Formatting Objects"@en,
        "Extensible Stylesheet Language – Formatting Objects"@es ;
    skos:definition "XSL-FO – XSL Formatting Objects – is a markup language for XML document formatting that is most often used to generate PDF files. XSL-FO is part of XSL (Extensible Stylesheet Language), a set of W3C technologies designed for the transformation and formatting of XML data."@en,
        "XSL-FO – XSL Formatting Objects – es un lenguaje de marcado para el formateo de documentos XML que se utiliza más frecuentemente para generar archivos PDF. XSL-FO es parte de XSL (Extensible Stylesheet Language), un conjunto de tecnologías del W3C diseñadas para la transformación y el formateo de datos XML."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XSLFO>,
        <https://www.iana.org/assignments/media-types/application/xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".fo",
        "application/xml" ;
    skos:prefLabel "XSL-FO"@en,
        "XSL-FO"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xslt> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Extensible Stylesheet Language Transformations"@en,
        "Extensible Stylesheet Language Transformations"@es ;
    skos:definition "XSLT – Extensible Stylesheet Language Transformations – is a language for transforming XML documents into other XML documents or other formats such as HTML for web pages, plain text or XSL Formatting Objects, which may subsequently be converted to other formats, such as PDF, PostScript and PNG."@en,
        "XSLT – Extensible Stylesheet Language Transformations – es un lenguaje para transformar documentos XML en otros documentos XML u otros formatos como HTML para páginas web, texto plano o XSL Formatting Objects, que pueden convertirse posteriormente en otros formatos como PDF, PostScript y PNG."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XSLT>,
        <https://www.iana.org/assignments/media-types/application/xslt+xml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xsl; .xslt",
        "application/xslt+xml" ;
    skos:prefLabel "XSLT"@en,
        "XSLT"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xyz> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "The XYZ file format is a chemical file format. There is no formal standard and several variations exist, but a typical XYZ format specifies the molecule geometry by giving the number of atoms with Cartesian coordinates that will be read on the first line, a comment on the second, and the lines of atomic coordinates in the following lines."@en,
        "El formato de archivo XYZ es un formato de archivo químico. No existe un estándar formal y existen varias variaciones, pero un formato XYZ típico especifica la geometría molecular dando el número de átomos con coordenadas cartesianas en la primera línea, un comentario en la segunda, y las líneas de coordenadas atómicas en las líneas siguientes."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XYZ>,
        <https://www.iana.org/assignments/media-types/chemical/x-xyz> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xyz",
        "chemical/x-xyz" ;
    skos:prefLabel "XYZ Chemical File"@en,
        "XYZ Chemical File"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xyz_tiles> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Slippy Map Tiles"@en,
        "Teselas XYZ"@es ;
    skos:definition "XYZ Tiles (also known as Slippy Map Tiles) is a web map tiling scheme where raster tiles are organized by their zoom coordinate (z), column (x), and row (y). It is the most widely used tiling scheme in web mapping, popularized by OpenStreetMap and Google Maps."@en,
        "XYZ Tiles (también conocido como Slippy Map Tiles) es un esquema de teselado de mapas web donde las teselas rasterizadas se organizan según su coordenada de zoom (z), columna (x) y fila (y). Es el esquema de teselado más ampliamente utilizado en cartografía web, popularizado por OpenStreetMap y Google Maps."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation "image/png; image/jpeg" ;
    skos:prefLabel "XYZ Tiles"@en,
        "XYZ Tiles"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/xz> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "xz compressed file"@en,
        "xz compressed file"@es ;
    skos:definition "Compressed file produced using XZ Utils (free software command-line lossless data compressors, including LZMA and xz)."@en,
        "Archivo comprimido producido utilizando XZ Utils (compresores de datos sin pérdida de línea de comandos de software libre, incluyendo LZMA y xz)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/XZ>,
        <https://www.iana.org/assignments/media-types/application/x-xz> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".xz",
        "application/x-xz" ;
    skos:prefLabel "xz"@en,
        "xz"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/yaml> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "YAML Ain't Markup Language"@en,
        "YAML Ain't Markup Language"@es ;
    skos:definition "YAML is a human-friendly, cross language, Unicode based data serialization language designed around the common native data types of dynamic programming languages. It is broadly useful for programming needs ranging from configuration files to internet messaging to object persistence to data auditing and visualization."@en,
        "YAML es un lenguaje de serialización de datos amigable para humanos, multilenguaje, basado en Unicode, diseñado en torno a los tipos de datos nativos comunes de los lenguajes de programación dinámicos. Es ampliamente útil para necesidades de programación que van desde archivos de configuración hasta mensajería por Internet, persistencia de objetos, auditoría y visualización de datos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/YAML>,
        <https://www.iana.org/assignments/media-types/application/yaml> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".yml; .yaml",
        "application/yaml" ;
    skos:prefLabel "YAML"@en,
        "YAML"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/z> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Unix compressed file"@en,
        "Unix compressed file"@es ;
    skos:definition "Compressed file produced by Unix shell compression program based on the LZW (Lempel-Ziv-Welch) compression algorithm."@en,
        "Archivo comprimido producido por el programa de compresión de shell Unix basado en el algoritmo de compresión LZW (Lempel-Ziv-Welch)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/Z>,
        <https://www.iana.org/assignments/media-types/application/x-compress> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".Z",
        "application/x-compress" ;
    skos:prefLabel "Z"@en,
        "Z"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/archivo-tipo/zarr> a skos:Concept ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Zarr format"@en,
        "Formato Zarr"@es ;
    skos:definition "Zarr is a data storage format designed for chunked, compressed, N-dimensional arrays. It supports storage across multiple backends (file system, cloud storage, databases) and is suitable for scientific and Earth observation data. It enables parallel and concurrent access to data chunks."@en,
        "Zarr es un formato de almacenamiento de datos diseñado para matrices multidimensionales N-dimensionales chunked, comprimidas. Soporta almacenamiento en múltiples backends (sistema de archivos, almacenamiento en la nube, bases de datos) y es adecuado para datos científicos y de observación de la Tierra. Permite el acceso paralelo y concurrente a fragmentos de datos."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".zarr",
        "application/x-zarr" ;
    skos:prefLabel "Zarr"@en,
        "Zarr"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> .

<https://geo-carto.github.io/vocabularios/archivo-tipo/zip> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:definition "ZIP is an archive file format that supports lossless data compression. A ZIP file may contain one or more files or directories that may have been compressed."@en,
        "ZIP es un formato de archivo que soporta compresión de datos sin pérdida. Un archivo ZIP puede contener uno o más archivos o directorios que pueden haber sido comprimidos."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/ZIP>,
        <https://www.iana.org/assignments/media-types/application/zip> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".zip",
        "application/zip" ;
    skos:prefLabel "ZIP"@en,
        "ZIP"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

