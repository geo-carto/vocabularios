<https://geo-carto.github.io/vocabularios/archivo-tipo/sql> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:altLabel "Structured Query Language"@en,
        "Structured Query Language"@es ;
    skos:definition "SQL – Structured Query Language – is a domain-specific language used in programming and designed for managing data held in a relational database management system (RDBMS) or for stream processing in a relational data stream management system (RDSMS)."@en,
        "SQL – Structured Query Language – es un lenguaje de dominio específico utilizado en programación y diseñado para gestionar datos almacenados en un sistema de gestión de bases de datos relacionales (RDBMS) o para el procesamiento de flujos en un sistema de gestión de flujos de datos relacionales (RDSMS)."@es ;
    skos:exactMatch <http://publications.europa.eu/resource/authority/archivo-tipo/SQL>,
        <https://www.iana.org/assignments/media-types/application/sql> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    skos:notation ".sql",
        "application/sql" ;
    skos:prefLabel "SQL"@en,
        "SQL"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/archivo-tipo> ;
    adms:status "Válido" .

