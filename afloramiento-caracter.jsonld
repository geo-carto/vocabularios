{"id":"https://geo-carto.github.io/vocabularios/afloramiento-caracter","type":"ConceptScheme","title":{"en":"Outcrop character","es":"Carácter del afloramiento"},"prefLabel":{"en":"Outcrop character","es":"Carácter del afloramiento"},"description":{"en":"The property outcropCharacter provides a term that describes the nature of outcrops formed by a geologic unit. Examples are: bouldery, cliff-forming, ledge-forming, slope-forming, poorly exposed.","es":"Términos que describen la naturaleza de los afloramientos formados por una unidad geológica. Ejemplos: con bloques, formadora de acantilado, formadora de repisa, formadora de ladera, pobremente expuesta."},"publisher":{"id":"https://www.igme.es/"},"created":"2026-03-01","modified":"2026-03-01","creator":"https://www.igme.es","provenance":"Términos propios definidos por el IGME","versionInfo":"1.0.0","theme":"GE","license":{"id":"https://creativecommons.org/licenses/by/4.0/"},"hasTopConcept":[{"id":"https://geo-carto.github.io/vocabularios/afloramiento-caracter/con-afloramiento","prefLabel":{"en":"with outcrop","es":"con afloramiento"},"definition":{"es":"con afloramiento"},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/afloramiento-caracter/acantilado","prefLabel":{"en":"cliff-forming","es":"acantilado"},"definition":{"en":"Outcrop that gives rise to vertical walls, often inaccessible","es":"Afloramiento que da lugar a paredes verticales, frecuentemente inaccesibles"}},{"id":"https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-aceptable","prefLabel":{"en":"medium quality outcrop","es":"afloramiento aceptable"},"definition":{"en":"Outcrop with a moderate quality of exposure (the composition of the unit can be further detailed and, where appropriate, some textural or structural features can be outlined)","es":"Afloramiento con una moderada calidad de exposición (se puede detallar algo más la composición de la unidad y, en su caso, esbozar algún rasgo textural o estructural)"}},{"id":"https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-alterado","prefLabel":{"en":"weathered outcrop","es":"afloramiento alterado"},"definition":{"en":"Bad outcrops, affected by non mappable alteration","es":"Afloramiento deficiente por estar afectada por una alteración no cartografiable"}},{"id":"https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-bueno","prefLabel":{"en":"well exposed","es":"afloramiento bueno"},"definition":{"en":"Good outcrops which allows to a precise description of the unit in terms of  composition, texture, internal organisation  and structure","es":"Afloramiento que permite una descripción detallada de la unidad, al menos en cuanto a composición, textura organización interna y estructura"}},{"id":"https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-deficiente","prefLabel":{"en":"poorly exposed","es":"afloramiento deficiente"},"definition":{"en":"Bad exposed outrops, only suitable for determining the overall unit composition","es":"Afloramiento con muy mala calidad de exposición (como mucho se puede señalar la composición general de la unidad)"}},{"id":"https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-en-bloques","prefLabel":{"en":"bouldery","es":"afloramiento en bloques"},"definition":{"en":"Outcrops made up of large blocks, individualized by erosion or weathering","es":"Afloramientos constituido por grandes bloques, individualizados por la erosión  o la meteorización"}}]},{"id":"https://geo-carto.github.io/vocabularios/afloramiento-caracter/sin-afloramiento","prefLabel":{"en":"no outcrop","es":"sin afloramiento"},"definition":{"en":"Covered, not outcropping unit","es":"Unidad cubierta (y que por tanto no aflora) por suelos, vegetación, construcciones, etc."}}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","dcat":"http://www.w3.org/ns/dcat#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","contributor":"dct:contributor","provenance":"dct:provenance","publisher":"dct:publisher","versionInfo":"owl:versionInfo","status":{"@id":"http://www.w3.org/ns/adms#status"},"preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","theme":"dcat:theme","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container":"@language"},"narrower":{"@container":"@set"},"related":{"@container":"@set"},"relatedMatch":{"@container":"@set"},"narrowerTransitive":{"@container":"@set"},"broaderTransitive":{"@container":"@set"},"broadMatch":{"@container":"@set"},"narrowMatch":{"@container":"@set"},"closeMatch":{"@container":"@set"},"exactMatch":{"@container":"@set"},"hasTopConcept":{"@container":"@set"},"inScheme":{"@container":"@set"},"topConceptOf":{"@container":"@set"},"deprecated":{"@id":"owl:deprecated","@type":"xsd:boolean"},"isReplacedBy":{"@id":"dct:isReplacedBy","@container":"@set"}}}