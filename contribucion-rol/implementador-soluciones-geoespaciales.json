{
  "id": "https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales",
  "type": "Concept",
  "prefLabel": {
    "en": "geospatial systems implementer",
    "es": "implementador de soluciones geoespaciales"
  },
  "definition": {
    "en": "Person or entity responsible for implementing and maintaining systems, tools and processes for managing, processing and publishing geospatial information. This role may involve the integrated execution of several functions represented by the more specific roles it encompasses.",
    "es": "Persona o entidad responsable de implementar y mantener sistemas, herramientas y procesos para la gestión, tratamiento y publicación de información geoespacial. Puede desempeñar de forma integrada varias de las funciones representadas por los roles específicos que engloba."
  },
