{
  "id": "https://geo-carto.github.io/vocabularios/contribucion-rol/desarrollador-geoespacial",
  "type": "Concept",
  "prefLabel": {
    "en": "geospatial developer",
    "es": "desarrollador geoespacial"
  },
  "definition": {
    "en": "Person or entity responsible for developing applications, tools, scripts and software components for managing, processing or visualising geospatial information.",
    "es": "Persona o entidad responsable de desarrollar aplicaciones, herramientas, scripts y componentes de software para la gestión, procesamiento o visualización de información geoespacial."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales",
    "prefLabel": {
      "en": "geospatial systems implementer",
      "es": "implementador de soluciones geoespaciales"
    }
  },
