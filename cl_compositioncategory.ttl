    skos:prefLabel "very low silica chemistry"@en,
        "ultrabásica"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ultramafico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ferromagnesiano> ;
    skos:definition "Material consists of greater than 90 percent ferromagnesian silicate minerals"@en,
        "Material compuesto por más del 90 por ciento de silicatos ferromagnesianos"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/ultramafic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "ultramafic"@en,
        "ultramáfico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "General sandstone petrography term for a sandstone in which the ratio of feldspar to lithic fragments is greater than 1:1 and less than 75 percent quartz is present in the detrital mode. Subsumes lithic arkosic and arkosic sandstone petrographic composition classes. Usage of modifier feldspathic is consistent with petrographic subdivisions of Dott (1964) and Williams, Turner and Gilbert (1982)"@en,
        "Término de composición petrográfica para arenitas en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de feldespatos es mayor que el de fragmentos de otras rocas. Incluye clases de composición petrográfica de arenisca arcosica y arcosa lítica. El uso del modificador feldespático es consistente con las subdivisiones petrográficas de Dott (1964) y Williams, Turner y Gilbert (1982"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/feldspathic_detrital_mode> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litarcosa> ;
    skos:prefLabel "feldspathic detrital mode"@en,
        "arcosa"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosa-litica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Sandstone petrographic composition term indicating that detrital mode for clastic rock (Q-F-L) includes less than 75 percent quartz and the feldspar to lithic ratio is between 1 to 1 and 1 to 3. This corresponds to the feldspathic litharenite field of Folk (1968). Rocks in this class are likely to be quartzo-feldspathic in terms of mineralogical composition terms in this vocablary, but because the mineralogical composition of the lithic fraction is not constrainged, this correlation is not necessary"@en,
        "Término de composición petrográfica para arenitas en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que la relación entre feldespatos y fragmentos de otras rocas no supera 3:1. Esto corresponde al campo de litarenita feldespática de Folk (1968). Es probable que las rocas de esta clase sean cuarzo-feldespáticas en términos de composición mineralógica en este vocabulario, pero debido a que la composición mineralógica de la fracción lítica no está restringida, esta correlación no es necesaria"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/feldspathic_lithic_detrital_mode> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosico> ;
    skos:prefLabel "feldspathic lithic detrital mode"@en,
        "arcosa lítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonaceo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Material containing significant carbon or hydrocarbon mineral phases, including graphite, coal, oil, gas, lignite, peat"@en,
        "Material que contiene importantes fases minerales de carbono o hidrocarburos, incluidos grafito, carbón, petróleo, gas, lignito, turba"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/carbonaceous> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/asfaltico> ;
    skos:prefLabel "carbonaceous"@en,
        "carbonáceo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-con-hierro> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonatico> ;
    skos:definition "CO3 is the predominant anion, and iron is greater than 5 mole percent of the cations (includes Fe, Mg, Mn, Ba, Sr, Ca...)"@en,
        "El CO3 es el anión predominante y el hierro es superior al 5 por ciento en moles de los cationes (incluye Fe, Mg, Mn, Ba, Sr, Ca ...)"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/iron_bearing_carbonate_chemistry> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-ferruginoso> ;
    skos:prefLabel "iron bearing carbonate chemistry"@en,
        "carbonato con hierro"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-impuro> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Material consists of greater than 50 percent calcsilicate or carbonate minerals and relative proportion of calcsilicate and carbonate minerals is unknown or not specified"@en,
        "Contiene más del 50 por ciento de calcosilicatos o carbonatos y se desconoce o no se especifica la proporción relativa de calcosilicatos y carbonatos"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/impure_calcsilicate_or_carbonate> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/calcosilicato> ;
    skos:prefLabel "impure calcsilicate or carbonate"@en,
        "carbonato impuro"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-sulfuros> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Greater than accessory amount (greater than 5 percent by volume) of sulfide mineral are present"@en,
        "Contiene una proporción de sulfuros superior a la de componente accesorio (más del 5 por ciento en volumen)"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/sulfide_bearing> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfuro> ;
    skos:prefLabel "sulfide bearing"@en,
        "con sulfuros"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarzofeldespatico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/pelitico-cuarzofeldespatico> ;
    skos:definition "Material for which the sum of modal quartz+feldspar+ mica + aluminous mineral is greater than or equal to 70 percent, and quartz + feldspar (sensu Robertson, 1999) greater than 60 percent"@en,
        "Material para el cual la suma de cuarzo modal + feldespato + mica + mineral alumínico es mayor o igual del 70%, y cuarzo + feldespato (sensu Robertson, 1999) mayor del 60%"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/quartzo_feldspathic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarcitico> ;
    skos:prefLabel "quartzo feldspathic"@en,
        "cuarzofeldespático"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/haluros> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "One or more of halide group elements (F, Cl, Br, I) are most abundant (mole percent) anion"@en,
        "Uno o más de los elementos del grupo de los haluros (F, Cl, Br, I) son el anión más abundante (porcentaje en moles)"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/halide_chemistry> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-nitratos> ;
    skos:prefLabel "halide chemistry"@en,
        "haluros"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfuroso> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Sulfur is the most abundant anion, cations are metals or semimetals"@en,
        "El azufre es el anión más abundante, los cationes son metales o semimetales"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/sulfide_chemistry> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfosales> ;
    skos:prefLabel "sulfide chemistry"@en,
        "sulfuroso"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Material consists of greater than 50 percent calcsilicate or carbonate minerals and carbonate minerals greater than calcsilicate minerals in mineral mode. Metacarbonate of NADMSC SLTTm (2004) terminology, adopted here for non-genetic use"@en,
        "Material compuesto por más del 50 por ciento de calcosilicatos o carbonatos en el que la proporción de carbonatos es mayor que la de los calcosilicatos.  Corresponde al término metacarbonato de la terminología NADMSC SLTT (2004), que se adopta aquí sin consideraciones genéticas"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/carbonate> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-con-barita>,
        <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-monomineralico> ;
    skos:prefLabel "carbonate"@en,
        "carbonato"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-monomineralico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato> ;
    skos:definition "Rock in which carbonate minerals form greater than 75 percent of rock"@en,
        "Roca compuesta por mas de un 75%  de minerales de carbonato"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/monomineralic_carbonate> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/calcareo-monomineralico>,
        <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/dolomita> ;
    skos:prefLabel "monomineralic carbonate"@en,
        "carbonato monominerálico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-carbonatos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Carbonate minerals of any sort are present, but less than 50 percent of rock"@en,
        "Presenta minerales de carbonato de cualquier tipo, pero en una proporción inferior al  50 por ciento de la roca"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/carbonate_bearing> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/calcareo>,
        <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/dolomitico> ;
    skos:prefLabel "carbonate bearing"@en,
        "con carbonatos"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ferromagnesiano> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Material consists of greater than 40 percent dark ferromagnesian silicate minerals. Standard term defined by Bates and Jackson (1987) to mean 'containing iron and magnesium'. Subsumes mafic and ultramafic"@en,
        "Material que tiene más del 40 por ciento de silicatos ferromagnesianos oscuros. Término estándar definido por Bates y Jackson (1987) como \"que contiene hierro y magnesio\". Incluye máficos y ultramáficos"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/ferromagnesian> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/mafico>,
        <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ultramafico> ;
    skos:prefLabel "ferromagnesian"@en,
        "ferromagnesiano"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonatico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "The carbonate (CO3) anion is the predominant anion (by mole percent) in chemical analysis. Sub-categories may be defined by dominant cation. Material in this chemical class overlaps with the monomineralic carbonate class, and probably overlaps with the Carbonate class in the mineralogical composition classification"@en,
        "El anión carbonato (CO3) es el anión predominante (por porcentaje molar) en el análisis químico. Las subcategorías pueden definirse por el catión dominante. El material de esta clase química se superpone con la clase de carbonato monomineral y probablemente se superpone con la clase de carbonato en la clasificación de composición mineralógica"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/carbonate_chemistry> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-rico-en-calcio> ;
    skos:prefLabel "carbonate chemistry"@en,
        "carbonático"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/pelitico-cuarzofeldespatico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Material for which the sum of modal quartz+feldspar+ mica + aluminous mineral is greater than or equal to 70 percent"@en,
        "Material para el cual la suma de cuarzo modal + feldespato + mica + mineral alumínico es mayor o igual al 70%"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/quartz_feldspar_pelitic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarzofeldespatico>,
        <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/pelitico>,
        <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/semipelitico> ;
    skos:prefLabel "quartz feldspar pelitic"@en,
        "pelítico cuarzofeldespático"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/roca-silicatada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Composed of minerals whose crystal structure contains SiO4 tetrahedra, either isolated or joined through one or more oxygen atoms to form groups, chains, sheets or three-dimensional structures with metallic cations. Composition ranges from 20-100 percent SiO2. Typically some Al substitutues for silica. A survey of chemical analyses in the Georock database (query FOR ALL GEOLOGICAL SETTINGS, MATERIAL: WHOLE ROCK (AND VOLCANIC GLASS), PUB. YEARS: 2005-1970), 10/10/2005, http://georoc.mpch-mainz.gwdg.de/georoc/Entry.html) discovered that the lowest silica (Si02) content for igneous rock is about 20 percent. This is consistent with the lowest silica content found for a silicate mineral is about 21 percent for a chlorite variety found by scanning the mineral analyses in Deer, Howie, and Zussman (1966)"@en,
        "Compuesto por minerales cuya estructura cristalina contiene tetraedros de SiO4, ya sea aislados o unidos a través de uno o más átomos de oxígeno para formar grupos, cadenas, láminas o estructuras tridimensionales con cationes metálicos. La composición varía entre el 20 y el 100 por ciento de SiO2. Típicamente, algunos sustitutos de la sílice son Al. Una encuesta de análisis químicos en la base de datos de Georock (consulta PARA TODOS LOS ENTORNOS GEOLÓGICOS, MATERIAL: ROCA ENTERA (Y VIDRIO VOLCÁNICO), PUB. AÑOS: 2005-1970), 10/10/2005, http: //georoc.mpch-mainz .gwdg.de / georoc / Entry.html) descubrió que el contenido más bajo de sílice (Si02) para las rocas ígneas es de aproximadamente el 20 por ciento. Esto concuerda con que el contenido de sílice más bajo encontrado para un mineral de silicato es aproximadamente un 21 por ciento para una variedad de clorita que se encuentra al escanear los análisis de minerales en Deer, Howie y Zussman (1966)"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/silicate_chemistry> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/acida>,
        <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/basica>,
        <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/roca-intermedia>,
        <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ultrabasica> ;
    skos:prefLabel "silicate chemistry"@en,
        "roca silicatada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

