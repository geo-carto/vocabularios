<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-oxidos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Greater than accessory amounts (greater than 5 percent by volume) of base metal oxide minerals such as magnetite (Fe3O4) or pyrolusite (MnO2) are present"@en,
        "(Hay una cantidad mayor)Contiene cantidades de óxidos metálicos como magnetita (Fe3O4) o pirolusita (MnO2) que como componentes accesorios (5% en volumen)"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/metallic_oxide_bearing> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "metallic oxide bearing"@en,
        "con óxidos"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarcitico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarzofeldespatico> ;
    skos:definition "Material consists of greater than or equal to 75 percent quartz"@en,
        "Material compuesto por un porcentaje igual o superior al 75% de cuarzo"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/quartzose> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "quartzose"@en,
        "cuarcítico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarzarenita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Detrital mineral grains in a granular rock consist of greater than 95 percent quartz. This petrographic criteria follows the most restrictive definition of the composition field at the quartz vertex of the sandstone QFL triangle (Folk, 1968). This use of term quartzose is more restrictive that that used in the mineralogical composition term vocabulary, reflecting the interpretive significance of pure quartz sandstones in sedimentary petrology"@en,
        "Arenita en la que más del 95% de los granos son de cuarzo. Este criterio petrográfico sigue la definición más restrictiva del campo de composición en el vértice de cuarzo del triángulo QFL de las areniscas (Folk, 1968). Este uso del término cuarzo es más restrictivo que el usado en el vocabulario de términos de composición mineralógica, lo que refleja el significado interpretativo de las areniscas de cuarzo puro en la petrología sedimentaria"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/quartzose_detrital_mode> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "quartzose detrital mode"@en,
        "cuarzarenita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/dolomita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-monomineralico> ;
    skos:definition "Carbonate minerals form greater than 75 percent of rock, and dolomite forms greater than 75 percent of carbonate minerals"@en,
        "Los minerales carbonatados forman más del 75 por ciento de la roca y la dolomita forma más del 75 por ciento de los minerales carbonatados"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/dolomite_monomineralic_carbonate> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "dolomite monomineralic carbonate"@en,
        "dolomita"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/dolomitico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-carbonatos> ;
    skos:definition "Dolomite is present, carbonate minerals form less than 50 percent of rock"@en,
        "Contiene dolomita  pero los minerales de carbonato forman menos del 50 por ciento de la roca"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/dolomitic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "dolomitic"@en,
        "dolomítico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/epiclastico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Sedimentary material contains significant broken volcanic rock fragments or vitric fragments, irrespective of their pyroclastic or epiclastic origin"@en,
        "Material sedimentario  que contiene importantes fragmentos de roca volcánica rotos o fragmentos vítreos, independientemente de su origen piroclástico o epiclástico"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/volcanic_lithic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "volcanic lithic"@en,
        "epiclástico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/feldespatico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Sedimentary material contains significant feldspar mineral content"@en,
        "El material sedimentario tiene un impotante contenido de feldespatos"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/feldspathic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "feldspathic"@en,
        "feldespático"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ferruginoso> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Greater than accessory amount (greater than 5 percent by volume) of non-silicate iron minerals (hematite, magnetite, siderite...) are present. Rocks containing abundant iron-rich silicate minerals would use the 'Ferromagnesian' terms"@en,
        "Presenta una cantidad mayor que como componente accesorio (más del 5 por ciento en volumen) de minerales de hierro no silicatados (hematita, magnetita, siderita ...). Las rocas que contienen abundantes silicatos ricos en hierro corresponderían a los términos 'ferromagnesianos'"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/ferruginous> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "ferruginous"@en,
        "ferruginoso"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/fluoruros> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Fluorine is the most abundant (mole percent) anion"@en,
        "El flúor es el anión más abundante (porcentaje en moles)"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/fluoride_chemistry> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
