    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Greater than accessory amount (greater than 5 percent by volume) of chlorite group minerals are present"@en,
        "Presenta una cantidad mayor de minerales del grupo de la clorita que como componente accesorio (5 por ciento en volumen)"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/chloritic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
