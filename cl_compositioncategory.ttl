    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Aluminum oxide within 10 percent of sum of Na and K oxide"@en,
        "Con una proporción de óxido de aluminio inferior al 10 por ciento de la suma de  los óxidos de Na y K"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/subaluminous> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
