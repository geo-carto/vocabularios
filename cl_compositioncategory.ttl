    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/fosfatico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Greater than accessory amount (greater than 5 percent by volume) of phosphate minerals are present"@en,
        "Presenta una cantidad mayor que la accesoria (más del 5 por ciento en volumen) de minerales de fosfato"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/phosphatic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "phosphatic"@en,
        "fosfático"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/fosfato> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Phosphate (PO4) is the most abundant (mole percent) anion"@en,
        "El fosfato (PO4) es el anión más abundante (en porcentaje molar)"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/phosphate_chemistry> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "phosphate chemistry"@en,
        "fosfato"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/intracastico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Carbonate sedimentary material contains signficant intraclast content"@en,
        "Carbonatos sedimentarios con un contenido importante de intraclastos"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/intraclastic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "intraclastic"@en,
        "intracástico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litarcosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosa> ;
    skos:definition "Sandstone petrographic composition term indicating that detrital mode for clastic rock (Q-F-L) includes less than 75 percent quartz and the ratio of lithic fragments to feldspar is between 1:1 and 1:3. This corresponds to the lithic arkose field of Folk (1968), the 75 percent quartz boundary is chosen to be consistent with quartzsose composition as defined in the mineralogic compostion terms vocabulary. Because of the abundance of lithic fragments for which the mineralogic composition is not specified, and the presence of undiscernible matrix and cement that are not incuded in the detrital mode, corresondence with the mineralogical composition terms is very approximate"@en,
        "Término de composición petrográfica para arenitas en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de fragmentos de otras rocas respecto al de feldespatos está comprendido entre 1: 1 y 1: 3. Esto corresponde al campo arcoso lítico de Folk (1968). Debido a la abundancia de fragmentos líticos para los cuales no se especifica la composición mineralógica, y la presencia de matriz y cemento no discernibles no incluidos como componentes detríticos, la correspondencia con los términos de composición mineralógica es muy aproximada"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/lithic_arkosic_detrital_mode> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "lithic arkosic detrital mode"@en,
        "litarcosa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litarenita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Sandstone petrographic composition term indicating that detrital mode for clastic rock (Q-F-L) includes less than 75 percent quartz and the lithic to feldspar ratio is greater than 3 to 1. This corresponds to the litharenite field of Folk (1968). Because the mineralogy of the lithic fragments is not constrained, the mineralogical composition is largely independent of the detrital mode composition for this class"@en,
        "Término de composición petrográfica para arenitas en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de fragmentos de otras rocas respecto al de feldespatos es mayor de 3 a 1. Esto corresponde al campo de litarenita de Folk (1968). Debido a que la mineralogía de los fragmentos líticos no está definida, no puede establecerse una composición mineralógica determinada"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/lithic_detrital_mode> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "lithic detrital mode"@en,
        "litarenita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litarenitico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Sandstone petrographic composition term indicating that the ratio of lithic fragments to feldspar is greater than 1:1, and less than 75 percent quartz is present in the detrital mode. Because the mineralogy of the lithic fragments is not constrained, the mineralogical composition is largely independent of the detrital mode composition for this class"@en,
        "Término de composición petrográfica para en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de fragmentos de otras rocas es mayor que el de feldespatos. Debido a que la mineralogía de los fragmentos líticos no está definida, no puede establecerse una composición mineralógica determinada"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/lithic_rich_detrital_mode> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "lithic rich detrital mode"@en,
        "litarenítico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Sedimentary material contains significant detrital rock fragments derived by erosion from older, pre-existing rock materials"@en,
        "El material sedimentario tiene un contenido significativo de fragmentos de roca derivados de la erosión de materiales rocosos preexistentes"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/lithic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "lithic"@en,
        "lítico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/mafico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ferromagnesiano> ;
    skos:definition "Material consists of greater than or equal to 40 percent and less than 90 percent ferromagnesian silicate minerals"@en,
        "Material compuesto por silicatos ferromagnesianos con proporciones comprendidas entre el 40% y 90%"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/mafic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "mafic"@en,
        "máfico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/metaluminoso> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Chemical composition term used for igneous rocks, denoting that content of aluminum oxide is greater than sodium oxide plus potassium oxide, but aluminum oxide less than sum of Na, K and Ca oxide"@en,
        "Término de composición química utilizado para rocas ígneas, que indica que el contenido de óxido de aluminio es mayor que el óxido de sodio más el óxido de potasio, pero el óxido de aluminio es menor que la suma de óxido de Na, K y Ca"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/metaluminous> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "metaluminous"@en,
        "metaluminoso"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

