    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-calcosilicatos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:definition "Calcsilicate minerals of any sort are present, but less than 50 percent of rock"@en,
        "Incluye minerales de silicato de calcio de cualquier tipo, pero en una proporción inferior al 50 por ciento de la roca"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/calcsilicate_bearing> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:prefLabel "calcsilicate bearing"@en,
        "con calcosilicatos"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-nitratos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
    skos:broader <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/haluros> ;
    skos:definition "Nitrate (NO3) is most abundant (mole percent) anion"@en,
        "El nitrato (NO3) es el anión más abundante (porcentaje en moles)"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/compositioncategory/nitrate_chemistry> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/unidad-geologica-composicion> ;
