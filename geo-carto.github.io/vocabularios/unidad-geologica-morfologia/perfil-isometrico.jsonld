{
  "id": "https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-isometrico",
  "type": "Concept",
  "prefLabel": {
    "en": "equant profile",
    "es": "perfil isometrico"
  },
  "definition": {
    "en": "Profile for which the ratio of length of longest chord to shortest chord is less than 1.4",
    "es": "Perfil para el que la relación entre la longitud del lado más largo y del más corto es menor que 1.4"
  },
