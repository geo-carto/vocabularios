{
  "id": "https://geo-carto.github.io/vocabularios/material-igme/roca-vitrea",
  "type": "Concept",
  "prefLabel": {
    "en": "glassy rock",
    "es": "roca vítrea"
  },
  "altLabel": {
    "es": [
      "roca holohialina"
    ]
  },
  "definition": {
    "en": "Igneous rock that has undergone rapid cooling, giving rise to an amorphous, crystal-free mass, exhibiting the characteristics of a glass: brittleness, conchoidal fracture and absence of cleavage",
    "es": "Roca ígnea que ha sufrido un enfriamiento rápido, dando lugar a una masa amorfa, sin cristales, presentando las características de un vidrio: fragilidad, fractura concoidea y ausencia de exfoliación"
  },
  "relatedMatch": [
    {
