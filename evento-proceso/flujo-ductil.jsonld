{
  "id": "https://geo-carto.github.io/vocabularios/evento-proceso/flujo-ductil",
  "type": "Concept",
  "prefLabel": {
    "en": "ductile flow",
    "es": "flujo dúctil"
  },
  "definition": {
    "en": "Deformation without apparent loss of continuity at the scale of observation.",
    "es": "Deformación sin aparente pérdida de continuidad a la escala de observación."
  },
