{
  "id": "https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-por-descompresion",
  "type": "Concept",
  "prefLabel": {
    "en": "pressure release weathering",
    "es": "meteorización por descompresión"
  },
  "definition": {
    "en": "Propagation of fractures near the surface of solid rock due to expansion related to release of confining pressure when deeply buried rock is unroofed. fractures typically propagate along surfaces close to and subparallel to the surface of the outcrop.",
    "es": "Propagación de fracturas cerca de la superficie de la roca dura debido a la expansión relacionada con el descenso de la presión confinante cuando una roca profundamente enterrada es exhumada. las fracturas típicamente se propagan a lo largo de superficies cercanas y subparalelas a la superficie del afloramiento."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-fisica",
    "prefLabel": {
      "en": "physical weathering",
      "es": "meteorización física"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/EventProcessValue/pressureReleaseWeathering"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/eventprocess/pressure_release_weathering"
    }
  ],
