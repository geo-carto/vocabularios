{
  "id": "https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-por-choque-termico",
  "type": "Concept",
  "prefLabel": {
    "en": "thermal shock weathering",
    "es": "meteorización por choque térmico"
  },
  "definition": {
    "en": "Propagation of fractures near the surface of solid rock due to expansion and contraction caused by temperature changes. fractures typically propagate along surfaces close to and subparallel to the surface of the outcrop.",
    "es": "Propagación de fracturas cerca de la la superficie de la roca dura debida a la expansión y contracción causadas por cambios de temperatura. las fracturas típicamente se propagan a lo largo de superficies cercanas y subparalelas a la superficie del afloramiento."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-fisica",
    "prefLabel": {
      "en": "physical weathering",
      "es": "meteorización física"
    }
  },
