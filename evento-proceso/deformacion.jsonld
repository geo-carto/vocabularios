      "prefLabel": {
        "en": "faulting",
        "es": "fallamiento"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-proceso/flujo-ductil",
      "prefLabel": {
        "en": "ductile flow",
        "es": "flujo dúctil"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-proceso/fracturacion",
      "prefLabel": {
        "en": "fracturing",
        "es": "fracturación"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-proceso/plegamiento",
      "prefLabel": {
        "en": "folding",
        "es": "plegamiento"
      }
    }
  ],
