{
  "id": "https://geo-carto.github.io/vocabularios/evento-proceso/deformacion",
  "type": "Concept",
  "prefLabel": {
    "en": "deformation",
    "es": "deformación"
  },
  "definition": {
    "en": "Movement of rock bodies by displacement on fault or shear zones, or change in shape of a body of earth material.",
    "es": "Movimiento de masas de roca por desplazamiento en zonas de falla o de cizalla, o cambio en la forma de una masa de material terrestre."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-proceso/cizallamiento",
