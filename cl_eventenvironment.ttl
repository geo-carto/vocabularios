<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-abisal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "The ocean environment at water depths between 3,500 and 6,000 metres. The Abyssal zone is a part of the deep sea floor that exhibits a uniform fauna and is generally noted for its lack of nutrients, high oxygen content, and almost total lack of sunlight. The zone is characterized by continuously cold waters of approximately. The Abyssal zone is a part of the deep sea floor that exhibits a uniform fauna and is generally noted for its lack of nutrients, high oxygen content, and almost total lack of sunlight. The zone is characterized by continuously cold waters of approximately"@en,
        "El medio o ambiente marino de aguas con profundidades entre 3.500 y 6.000 metros. La zona abisal es parte del fondo marino profundo que exhibe una fauna uniformes y se caracteriza generalmente por su falta de nutrientes, alto contenido de oxígeno, y la casi total falta de luz solar. La zona se caracteriza por las aguas frías de continuamente. La zona abisal es parte del fondo marino profundo que exhibe una fauna uniformes y se caracteriza generalmente por su falta de nutrientes, alto contenido de oxígeno, y la casi total falta de luz solar. La zona se caracteriza por las aguas frías de continuamente"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/abyssalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/abyssal> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "abyssal setting"@en,
        "ambiente abisal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-anoxico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Setting depleted in oxygen, typically subaqueous."@en,
        "Ambiente pobre en oxígeno, normalmente subacuático."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/anoxicSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/anoxic_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "anoxic setting"@en,
        "ambiente anóxico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-inferior> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial> ;
    skos:definition "The ocean environment at depths between 1000 and 3500 metres."@en,
        "El ambiente oceánico en las profundidades entre los 1.000 y 3.500 metros."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerBathyalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_bathyal> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "lower bathyal setting"@en,
        "ambiente batial inferior"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-medio> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial> ;
    skos:definition "The ocean environment at water depths between 600 and 1000 metres."@en,
        "El ambiente océanico en aguas de profundidades comprendidas entre 600 y 1.000 metros."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/middleBathyalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/middle_bathyal> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "middle bathyal setting"@en,
        "ambiente batial medio"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-superior> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial> ;
    skos:definition "The ocean environment at water depths between 200 and 600 metres."@en,
        "El ambiente oceánico en aguas con profundidades comprendidas entre 200 y 600 metros."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperBathyalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_bathyal> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "upper bathyal setting"@en,
        "ambiente batial superior"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-aluvial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte> ;
    skos:definition "A low, outspread, relatively flat to gently sloping mass of loose rock material, shaped like an open fan or a segment of a cone, deposited by a stream (esp. in a semiarid region) at the place where it issues from a narrow mountain valley upon a plain or broad valley, or where a tributary stream is near or at its junction with the main stream, or wherever a constriction in a valley abruptly ceases or the gradient of the stream suddenly decreases; it is steepest near the mouth of the valley where its apex points upstream, and it slopes gently and convexly outward with gradually decreasing gradient."@en,
        "Una masa de materiales rocosos sueltos, baja y extendida, relativamente plana a ligeramente inclinada, en forma de un abanico abierto o de segmento de cono, depositado por una corriente (especialmente en regiones semiáridas) en el lugar donde desemboca desde un estrecho valle de montaña hacia un valle llano o amplio, o donde una corriente afluente está próxima a su unión con la corriente principal, o donde la constricción de un valle cesa bruscamente o el gradiente de la corriente disminuye repentinamente; es más empinado cerca de la desembocadura del valle donde su vértice o paice apunta aguas arriba, y su se inclina suavemente y de forma convexa hacia el exterior mediante la disminución gradual de la pendiente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/alluvialFanSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/alluvial_fan> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "alluvial fan setting"@en,
        "ambiente de abanico aluvial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-deltaico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "A debris-flow or sheetflood-dominated alluvial fan build out into a lake or the sea."@en,
        "Un abanico aluvial dominado por coladas de derrubios o laminares construido sobre un lago o el mar."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/fanDeltaSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "fan delta setting"@en,
        "ambiente de abanico deltaico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-submarino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "Large fan-shaped cones of sediment on the ocean floor, generally associated with submarine canyons that provide sediment supply to build the fan."@en,
        "Los grandes conos de sedimentos en forma de abanico en el fondo océanico, generalmente asociados con los cañones submarinos que proporcionan el suministro de sedimentos para construir el abanico."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/submarineFanSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/submarine_fan_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "submarine fan setting"@en,
        "ambiente de abanico submarino"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-acumulacion-de-polvo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Setting in which finegrained particles accumulate, e.g. loess deposition."@en,
        "Ambiente en el que se acumulan partículas de grano fino, por ejemplo, deposición de loess."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/dustAccumulationSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "dust accumulation setting"@en,
        "ambiente de acumulación de polvo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-antearco> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa> ;
    skos:definition "Tectonic setting between a subduction-related trench and a volcanic arc."@en,
        "Ambiente tectónico situado entre una trinchera relacionada con una zona de subducción y un arco volcánico."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/forearcSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/forearc_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "forearc setting"@en,
        "ambiente de antearco"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arco-volcanico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa> ;
    skos:definition "A generally curvillinear belt of volcanoes above a subduction zone."@en,
        "Un cinturón generalmente curvilíneo de volcanes por encima de una zona de subducción."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/volcanicArcSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/volcanic_arc_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "volcanic arc setting"@en,
        "ambiente de arco volcánico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-area-de-morada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Dwelling area setting."@en,
        "ambiente de area de morada"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/dwellingAreaSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "dwelling area setting"@en,
        "ambiente de area de morada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-area-minera> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Human influence setting in which mineral resources are extracted from the ground."@en,
        "Ambiente con influencia humana en el que los recursos minerales se extraen de la tierra"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/miningAreaSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "mining area setting"@en,
        "ambiente de área minera"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-baja-presion-y-alta-temperatura> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra> ;
    skos:definition "Setting characterized by temperatures significantly higher that those associated with normal continental geothermal gradient."@en,
        "Ambiente caracterizado por temperaturas significativamente más altas que aquellas asociadas a un gradiente geotérmico continental normal."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowPressureHighTemperatureSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/low_pressure_high_temperature_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "low pressure high temperature setting"@en,
        "ambiente de baja presión y alta temperatura"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-borde-continental> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "An area of the continental margin between the shoreline and the continental slope that is topographically more complex than the continental shelf. It is characterized by ridges and basins, some of which are below the depth of the continental shelf. An example is the southern California continental borderland (Jackson, 1997, p. 138)."@en,
        "Un área del margen continental situado entre entre la costa y el talud continental que es topográficamente más compleja que la plataforma continental. Se caracteriza por presentar crestas y cuencas, algunas de las cuales están por debajo de la profundidad de la plataforma continental. Un ejemplo es el borde continental del sur de California (Jackson, 1997, p. 138)."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/continentalBorderlandSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/continental_borderland_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "continental borderland setting"@en,
        "ambiente de borde continental"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-borde-transformante-de-placa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa> ;
    skos:definition "Plate boundary at which the adjacent plates are moving laterally relative to each other."@en,
        "Borde de placa en el que las placas adyacentes se mueven lateralmente la una relativa a la otra."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/transformPlateBoundarySetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/transform_plate_boundary_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "transform plate boundary setting"@en,
        "ambiente de borde transformante de placa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas-litoral> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas> ;
    skos:definition "A dune field on low-lying land recently abandoned or built up by the sea; the dunes may ascend a cliff and travel inland."@en,
        "Un campo de dunas en tierras bajas recientemente abandonado o construido por el mar; las dunas puede trepar por un acantilado y desplazarse tierra adentro."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/coastalDuneFieldSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/coastal_dune_field> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "coastal dune field setting"@en,
        "ambiente de campo de dunas litoral"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-de-rio-meandriforme> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-fluvial> ;
    skos:definition "Produced by a mature stream swinging from side to side as it flows across its floodplain or shifts its course laterally toward the convex side of an original curve."@en,
        "Producido por una corriente madura que oscila de un lado al otro a medida que fluye a través de su llanura de inundación o que cambia su curso lateralmente hacia el lado convexo de una curva previa."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/meanderingRiverChannelSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/meandering_channel> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "meandering river channel setting"@en,
        "ambiente de canal de río meandriforme"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-distributario-de-delta> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico> ;
    skos:definition "A divergent stream flowing away from the main stream and not returning to it, as in a delta or on an alluvial plain."@en,
        "Una corriente que fluye divergiendo y alejadose de la corriente principal y no regresar a ella, como ocurre en un delta o en una llanura aluvial."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaDistributaryChannelSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/distributary_channel> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "delta distributary channel setting"@en,
        "ambiente de canal distributario de delta"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cauce-fluvial-abandonado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial> ;
    skos:definition "A drainage channel along which runoff no longer occurs, as on an alluvial fan."@en,
        "Un canal de drenaje a lo largo del cual ya no hay escorrentía ya no se produce, como por ejemplo en un abanico aluvial."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/abandonedRiverChannelSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/abandoned_channel> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "abandoned river channel setting"@en,
        "ambiente de cauce fluvial abandonado"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-velocidad-media> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo> ;
    skos:definition "Spreading center at which the opening rate is between 50 and 100 mm per year."@en,
        "Centro de expansión en el que la velocidad de apertura es entre 50 y 100 mm por año."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/medium-rateSpreadingCenterSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/medium_spreading_center_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "medium-rate spreading center setting"@en,
        "ambiente de centro de expansión de velocidad media"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-rapido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo> ;
    skos:definition "Spreading center at which the opening rate is greater than 100 mm per year."@en,
        "Centro de expansión en el que el ritmo de apertura es mayor que 100 mm por año."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/fastSpreadingCenterSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/fast_spreading_center_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "fast spreading center setting"@en,
        "ambiente de centro de expansión rápido"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-humedo-y-templado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Setting with seasonal climate having hot to cold or humid to arid seasons."@en,
        "Ambiente con clima estacional que tiene estaciones de calurosas a frías o húmedas a áridas."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/humidTemperateClimaticSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/humid_temperate_climatic_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "humid temperate climatic setting"@en,
        "ambiente de clima húmedo y templado"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-humedo-y-tropical> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Setting with hot, humid climate influenced by equatorial air masses, no winter season."@en,
        "Ambiente con clima cálido y húmedo influenciado por las masas de aire ecuatoriales, sin estación invernal."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/humidTropicalClimaticSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/humid_tropical_climatic_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "humid tropical climatic setting"@en,
        "ambiente de clima húmedo y tropical"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-inferior> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental> ;
    skos:definition "Continental crustal setting characterized by upper amphibolite to granulite facies metamorphism, in situ melting, residual anhydrous metamorphic rocks, and ductile flow of rock bodies."@en,
        "Ambiente cortical continental caracterizado por metamorfismo de las facies de anfibolitas superiores a las granulitas, fusión in situ, rocas metamórficas anhidras residuales, y flujo dúctil de los cuerpos de roca."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerContinental-crustalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_continental_crust> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "lower continental-crustal setting"@en,
        "ambiente de corteza continental inferior"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-media> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental> ;
    skos:definition "Continental crustal setting characterized by greenschist to upper amphibolite facies metamorphism, plutonic igneous rocks, and ductile deformation."@en,
        "Ambiente cortical continental caracterizado por metamorfismo en facies de los esquistos verdes a las anfibolitas superiores, rocas ígneas plutónicas y deformación dúctil."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/middleContinentalCrustSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/middle_continental_crust_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "middle continental crust setting"@en,
        "ambiente de corteza continental media"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-superior> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental> ;
    skos:definition "Continental crustal setting dominated by non metamorphosed to low greenschist facies metamorphic rocks, and brittle deformation."@en,
        "Ambiente de corteza continental dominado por rocas no metamorfizadas a metamórficas de la facies de los esquistos verdes, y deformación frágil."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperContinentalCrustalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_continental_crustal_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "upper continental crustal setting"@en,
        "ambiente de corteza continental superior"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica-inferior> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica> ;
    skos:definition "Setting characterized by dominantly intrusive mafic rocks, with sheeted dike complexes in upper part and gabbroic to ultramafic intrusive or metamorphic rocks in lower part."@en,
        "Ambiente caracterizado por rocas dominantemente intrusivas máficas, con complejos de diques inyectados en su parte superior y rocas intrusivas gabroicas a ultramáficas o metamórficas en su parte inferior."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerOceanic-crustalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_oceanic_crustal_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "lower oceanic-crustal setting"@en,
        "ambiente de corteza oceánica inferior"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica-superior> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica> ;
    skos:definition "Oceanic crustal setting dominated by extrusive rocks, abyssal oceanic sediment, with increasing mafic intrusive rock in lower part."@en,
        "Ambiente de corteza oceánica dominado por rocas extrusivas, sedimentos oceánicos abisales, con crecientes rocas máficas intrusivas en su parte inferior."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperOceanicCrustalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_oceanic_crustal_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "upper oceanic crustal setting"@en,
        "ambiente de corteza oceánica superior"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-transicional> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical> ;
    skos:definition "Crust formed in the transition zone between continental and oceanic crust, during the history of continental rifting that culminates in the formation of a new ocean."@en,
        "Corteza formada en la zona de transición entre las cortezas continental y oceánica, durante la historia de rifting continental que culmina con la formación de un nuevo océano."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/transitional-crustalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/transitional_crust> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "transitional-crustal setting"@en,
        "ambiente de corteza transicional"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cuenca-pantanosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso> ;
    skos:definition "An ombrotrophic or ombrogene peat/bog whose nutrient supply is exclusively from rain water (including snow and atmospheric fallout) therefore making nutrients extremely oligotrophic."@en,
        "Una turbera o pantano ombrotróphica u ombrogénica cuyo aporte en nutrientes procede exclusivamente del agua de lluvia (incluyendo nieve y precipitación atmosférica) lo que la hace extremadamente oligotrófica en nutrientes."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/basinBogSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/basin_bog> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "basin bog setting"@en,
        "ambiente de cuenca pantanosa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cueva> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "A natural underground open space; it generally has a connection to the surface, is large enough for a person to enter, and extends into darkness. The most common type of cave is formed in limestone by dissolution."@en,
        "Un espacio natural abierto y subterránea; generalmente tiene una conexión con la superficie, es suficiente grande para que una persona penetre, y se prolonga en la oscuridad. El tipo más común de cueva se forma en las calizas por disolución."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/caveSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/cave> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "cave setting"@en,
        "ambiente de cueva"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-desembocadura-de-distributario-de-delta> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico> ;
    skos:definition "The mouth of a delta distributary channel where fluvial discharge moves from confined to unconfined flow conditions."@en,
        "La desembocadura de un canal distributario de delta donde descarga fluvial pasa de un movimiento confinado a unas condiciones de flujo no confinado."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaDistributaryMouthSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/distributary_mouth> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "delta distributary mouth setting"@en,
        "ambiente de desembocadura de distributario de delta"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-dorsal-central-oceanica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-elevaciones-oceanicas> ;
    skos:definition "Ocean highland associated with a divergent continental margin (spreading center). Setting is characterized by active volcanism, locally steep relief, hydrothermal activity, and pelagic sedimentation."@en,
        "Elevación oceánica asociada con una margen continental divergente (centro de expansión). El ambiente se caracteriza por vulcanismo activo, localmente relieve muy inclinado, actividad hidrotermal, y sedimentación pelágica."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/midOceanRidgeSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/mid_ocean_ridge_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "mid ocean ridge setting"@en,
        "ambiente de dorsal central oceánica"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-fosa-de-aguas-profundas> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "Deep ocean basin with steep (average 10 degrees) slope toward land, more gentle slope (average 5 degrees) towards the sea, and abundant seismic activity on landward side of trench. Does not denote water depth, but may be very deep."@en,
        "Cuenca oceánica profunda con pendientes empinadas (promedio de 10 grados) hacia la tierra, y pendientes más suave (promedio de 5 grados) hacia el mar, y abundante actividad sísmica en el lado de la fosa hacia tierra. No se designa por la profundidad del agua, pero puede llegar a ser muy profunda."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deepSeaTrenchSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/deep_sea_trench> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "deep sea trench setting"@en,
        "ambiente de fosa de aguas profundas"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-frente-arrecifal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arrecife-biologico> ;
    skos:definition "The seaward side of a reef; the slope covered with deposits of coarse reef talus."@en,
        "El flanco marítimo de un arrecife; la pendiente cubierta de depósitos gruesos del talud arrecifal."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/forereefSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/forereef> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "forereef setting"@en,
        "ambiente de frente arrecifal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-frente-de-delta> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico> ;
    skos:definition "A narrow zone where deposition in deltas is most active, consisting of a continuous sheet of sand, and occurring within the effective depth of wave erosion (10 m or less). It is the zone separating the prodelta from the delta plain, and it may or may not be steep\""@en,
        "Una zona estrecha, en la que la deposición de los deltas es más activa, que consiste en una lámina continua de arena, y ocurre dentro de la zona de profundidad de erosión efectiva de las olas (10 m o menos). Es la zona que separa el prodelta de la llanura deltaica, y puede o no puede ser escarpada"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaFrontSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/delta_front> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "delta front setting"@en,
        "ambiente de frente de delta"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laderas> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Earth surface setting characterized by surface slope angles high enough that gravity alone becomes a significant factor in geomorphic development, as well as base-of-slope areas influenced by hillslope processes. Hillslope activities include creep, sliding, slumping, falling, and other downslope movements caused by slope collapse induced by gravitational influence on earth materials. May be subaerial or subaqueous."@en,
        "Ambiente situado en la superficie terrestre que se caracteriza por una superficie cuyo de la ángulo de pendiente es lo suficientemente alta para que la gravedad por sí sola se convierta en un factor significativo en la evolución geomorfológica, así como las áreas en la base de la pendiente influenciadas por los procesos de ladera. Las actividades de ladera incluyen la reptación, corrimientos, deslizamientos, caídas, y otros movimientos descendentes causadas por la rotura de la ladera provocada por la acción gravitatoria sobre los materiales terrestres. Puede ser subaéreo o subacuático."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hillslopeSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/hillslope_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "hillslope setting"@en,
        "ambiente de laderas"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-litoral-rocoso> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> ;
    skos:definition "Shoreline with significant relief and abundant rock outcrop."@en,
        "Litoral con un relieve importante y abundantes afloramientos rocosos."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/rockyCoastSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/rocky_coast_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "rocky coast setting"@en,
        "ambiente de litoral rocoso"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte> ;
    skos:definition "An assemblage landforms produced by alluvial and fluvial processes (braided streams, terraces, etc.,) that form low gradient, regional ramps along the flanks of mountains and extend great distances from their sources (e.g., High Plains of North America). (NRCS GLOSSARY OF LANDFORM AND GEOLOGIC TERMS). A level or gently sloping tract or a slightly undulating land surface produced by extensive deposition of alluvium... Synonym-- wash plain;...river plain; aggraded valley plain;... (Jackson, 1997, p. 17). May include one or more River plain systems."@en,
        "Una conjunto de formas del terreno producidas por procesos aluviales y fluviales (ríos trenzados, terrazas, etc.,) que forman áreas de baja pendiente, rampas en las regiones situadas a lo largo de los flancos de las montañas y se extienden grandes distancias de sus fuentes (por ejemplo, altas planicies de América del Norte). (NRCS GLOSARIO DE geomorfología y términos geológicos). Un territorio de pendiente suave o una superficie ligeramente ondulada producida por extensa deposición de aluviones. Synonimos - lavar llanura fluvial; llanura de agradación fluvial. (Jackson, 1997, p. 17). Puede incluir uno o más sistemas de llanuras aluviales"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/alluvialPlainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/alluvial_plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "alluvial plain setting"@en,
        "ambiente de llanura aluvial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arrecifal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arrecife-biologico> ;
    skos:definition "A stony platform of reef rock, landward of the reef crest at or above the low tide level, occasionally with patches of living coral and associated organisms, and commonly strewn with coral fragments and coral sand."@en,
        "Una plataforma pedregosa de roca arrecifal, tierra adentro de la cresta del arrecife en o por encima del nivel de la bajamar, en ocasiones con parches de coral vivo y sus organismos asociados, y comúnmente salpicada de fragmentos de coral y arena coralina."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/reefFlatSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/reef_flat> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "reef flat setting"@en,
        "ambiente de llanura arrecifal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-cuenca> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "Near flat areas of ocean floor, slope less than 1:1000; generally receive only distal turbidite and pelagic sediments."@en,
        "La zona plana del fondo del océano, de pendiente inferior a 1: 1000; generalmente solo recibe turbiditas distal y sedimentos pelágicos."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/basinPlainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/basin_plain_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "basin plain setting"@en,
        "ambiente de llanura de cuenca"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-inundacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial> ;
    skos:definition "The surface or strip of relatively smooth land adjacent to a river channel, constructed by the present river in its existing regimen and covered with water when the river overflows its banks. It is built of alluvium carried by the river during floods and deposited in the sluggish water beyond the influence of the swiftest current. A river has one floodplain and may have one or more terraces representing abandoned floodplains."@en,
        "La superficie o franja de tierra relativamente lisa junto a un canal fluvial, construida por el río en su régimen actual y que queda cubierta por el agua cuando el río se desborda. Está construido por los aluviones transportados por el río durante las crecidas y depositado en aguas estancadas alejadas de la influencia de las corrientes más rápidas. Un río tiene una llanura de inundación y puede tener una o varias terrazas que representan llanuras de inundación abandonadas."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/floodplainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/floodplain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "floodplain setting"@en,
        "ambiente de llanura de inundación"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-fangosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia> ;
    skos:definition "A relatively level area of fine grained material (e.g. silt) along a shore (as in a sheltered estuary or chenier-plain) or around an island, alternately covered and uncovered by the tide or covered by shallow water, and barren of vegetation. Includes most tidal flats, but lacks denotation of tidal influence."@en,
        "Un área relativamente nivelada de material de grano fino (por ejemplo, limo) a lo largo de la costa (como en un estuario protegido o la llanura asociada a un chenier) o alrededor de una isla, alternativamente cubierto y descubierto por la marea o cubierto por agua someras, y yermo de vegetación. Incluye la mayoría de las llanuras de marea, pero le falta la denotación de la influencia mareal."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/mudFlatSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/mud_flat_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "mud flat setting"@en,
        "ambiente de llanura fangosa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanuras-algares> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia> ;
    skos:definition "Modern \"algal flats are found on rock or mud in areas flooded only by the highest tides and are often subject to high evaporation rates. Algal flats survive only when an area is salty enough to eliminate snails and other herbivorous animals that eat algae, yet is not so salty that the algae cannot survive. The most common species of algae found on algal flats are blue-green algae of the genera Scytonema and Schizothrix. These algae can tolerate the daily extremes in temperature and oxygen that typify conditions on the flats. Other plants sometimes found on algal flats include one-celled green algae, flagellates, diatoms, bacteria, and isolated scrubby red and black mangroves, as well as patches of saltwort. Animals include false cerith, cerion snails, fiddler crabs, and great land crabs. Flats with well developed algal mats are restricted for the most part to the Keys, with Sugarloaf and Crane Keys offering prime examples of algal flat habitat.\" (Audubon, 1991)"@en,
        "Las llanuras de algas actuales se encuentran en zonas rocosas o fangosas inundadas solamente por las mareas más altas y que están a menudo sujetas a altas tasas de evaporación. Las llanuras algares sobreviven sólo cuando una zona es lo suficientemente salada para eliminar a los caracoles y otros herbívoros que se alimentan de algas, pero es no tan salada que las algas no puedan sobrevivir. Las especies más comunes de algas que se encuentran en las llanuras de algares son algas azul-verdosas de los géneros Scytonema y Schizothrix. Estas algas pueden tolerar las variaciones diarias extremas de temperatura y oxígeno que caracterizan las condiciones de estas llanuras. Otras plantas que a veces se encuentran las llanuras algares incluyen las algas verdes unicelulares, flagelados, diatomeas, bacterias y manglares arbustivos solitarios rojos y negros, así como parches de salicornias. La fauna incluye el Cerith falso, caracoles Cerion, cangrejos violinistas, y grandes cangrejos de tierra. Las llanuras con alfombras algares bien desarrolladas se limitan en su mayor parte a los Cayos, siendo Sugarloaf y Crane Keys excelentes ejemplos del hábitat de llanuras de algas. (Audubon, 1991)"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/algalFlatSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/algal_flat_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "algal flat setting"@en,
        "ambiente de llanuras algares"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manantial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Setting characterized by a place where groundwater flows naturally from a rock or the soil onto the land surface or into a water body."@en,
        "Ambiente que se caracteriza por ser el lugar donde el agua subterránea fluye de manera natural de la roca o el suelo a la superficie del terreno o a una masa de agua."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/springSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "spring setting"@en,
        "ambiente de manantial"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-inferior> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mantelico> ;
    skos:definition "That part of the mantle that lies below a depth of about 660 km. With increasing depth, density increases from ~4.4 g/cm3 to ~5.6 g/cm3, and velocity of compressional seismic waves increases from ~10.7 km/s to ~13.7 km/s (Dziewonski and Anderson, 1981)."@en,
        "Aquella parte del manto que yace bajo una profundidad de cerca de 660 km. Con el incremento en profundidad, la densidad crece de  ~4.4 g/cm3 a ~5.6 g/cm3, y la velocidad de las ondas sísmicas compresionales crece de ~10.7 km/s a ~13.7 km/s (Dziewonski and Anderson, 1981)."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerMantleSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_mantle> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "lower mantle setting"@en,
        "ambiente de manto inferior"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-pantanoso> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso> ;
    skos:definition "Topogeneous bog/peat whose moisture content is largely dependent on surface water. It is relatively rich in plant nutrients, nitrogen, and mineral matter, is mildly acidic to nearly neutral, and contains little or no cellulose; forms in topographic depressions with essential stagnat or non-moving minerotrophic water supply"@en,
        "Pantano o turbera topogénica cuyo contenido de humedad depende en gran medida de las aguas superficiales. Es relativamente rica en nutrientes vegetales, nitrógeno, y materia mineral, es ligeramente ácida a casi neutra, y contiene poco o nada de celulosa; depresiones topográficas esencialmente con suministro de agua minerotrófica estancadas o quietas"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/blanketBog>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/blanket_bog> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "blanket bog"@en,
        "ambiente de manto pantanoso"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-superior> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mantelico> ;
    skos:definition "That part of the mantle which lies above a depth of about 660 km and has a density of 3.4 g/cm3 to 4.0 g/cm3 with increasing depth. Similarly, P-wave velocity increases from about 8 to 11 km/sec with depth and S wave velocity increases from about 4.5 to 6 km/sec with depth. It is presumed to be peridotitic in composition. It includes the subcrustal lithosphere the asthenosphere and the transition zone."@en,
        "Aquella parte del manto que yace por encima de una profundidad de cerca de 660 km y tiene una densidad de 3.4 g/cm3 a 4.0 g/cm3 creciente con la profundidad. Similarmente, la velocidad de la ondas P crece desde cerca de 8 a 11 km/s con la profundidad y la velocidad de las ondas S crece de cerca de 4.5 a 6 km/s con la profundidad. Se presume que su composición es peridotítica. Incluye la litosfera infracortical, la astenosfera y la zona de transición."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperMantleSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_mantle> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "upper mantle setting"@en,
        "ambiente de manto superior"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-continental-activo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa> ;
    skos:definition "Plate margin setting on continental crust."@en,
        "Ambiente de margen de placa sobre corteza continental"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/activeContinentalMarginSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/active_continental_margin_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "active continental margin setting"@en,
        "ambiente de margen continental activo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-continental-pasivo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "Boundary of continental crust into oceanic crust of an oceanic basin that is not a subduction zone or transform fault system. Generally is rifted margin formed when ocean basin was initially formed."@en,
        "Límite de la corteza continental con la corteza oceánica de una cuenca oceánica que no es una zona de subducción o un sistema de fallas transformantes. Generalmente se formó por rifting del margen continental cuando se inició la formación de la cuenca oceánica."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/passiveContinentalMarginSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/passive_continental_margin_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "passive continental margin setting"@en,
        "ambiente de margen continental pasivo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-medioambiente-humano> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Human environment setting."@en,
        "ambiente de medioambiente humano"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/humanEnvironmentSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/human_environment> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "human environment setting"@en,
        "ambiente de medioambiente humano"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-meseta-oceanica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-elevaciones-oceanicas> ;
    skos:definition "Region of elevated ocean crust that commonly rises to within 2-3 km of the surface above an abyssal sea floor that lies several km deeper. Climate and water depths are such that a marine carbonate platform does not develop."@en,
        "Región de corteza oceánica elevada que comúnmente sube a 2-3 km de la superficie por encima de un fondo marino abisal que está varios kilómetros más profundo. El clima y la profundidad del agua es tal que no se desarrolla una plataforma carbonatada marina."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/oceanicPlateauSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/oceanic_plateau_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "oceanic plateau setting"@en,
        "ambiente de meseta oceánica"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-metamorfismo-de-contacto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra> ;
    skos:definition "Metamorphism of country rock at the contact of an igneous body."@en,
        "Metamorfismo de las rocas encajantes en el contacto con un cuerpo ígneo."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/contactMetamorphicSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/contact_metamorphic_origin> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "contact metamorphic setting"@en,
        "ambiente de metamorfismo de contacto"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-metamorfismo-regional> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra> ;
    skos:definition "Metamorphism not obviously localized along contacts of igneous bodies; includes burial metamorphism and ocean ridge metamorphism."@en,
        "Metamorfismo no obviamente localizado a lo largo de contactos de cuerpos ígneos; incluye al metamorfismo de enterramiento y al metamorfismo de fondo oceánico."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/regionalMetamorphicSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/regional_metamorphic_origin> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "regional metamorphic setting"@en,
        "ambiente de metamorfismo regional"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pedimento> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte> ;
    skos:definition "A gently sloping erosional surface developed at the foot of a receding hill or mountain slope. The surface may be essentially bare, exposing earth material that extends beneath adjacent uplands; or it may be thinly mantled with alluvium and colluvium, ultimately in transit from upland front to basin or valley lowland. In hill-foot slope terrain the mantle is designated \"pedisediment.\" The term has been used in several geomorphic contexts: Pediments may be classed with respect to (a) landscape positions, for example, intermontane-basin piedmont or valley-border footslope surfaces (respectively, apron and terrace pediments (Cooke and Warren, 1973)); (b) type of material eroded, bedrock or regolith; or (c) combinations of the above. compare - Piedmont slope."@en,
        "Una superficie erosiva suavemente inclinada desarrollada al pie de la ladera en retroceso de una colina o una montaña. La superficie puede estar básicamente desnuda, exponiendo los materiales que se extienden debajo de las elevaciones adyacentes; o puede estar cubierta por un fino manto de aluviones y coluviones, finalmente está situada en el tránsito entre el frente de las elevaciones y la zona deprimida de una cuenca o un valle. En las áreas situadas al pie de laderas de colinas ese manto se suele denominar pedisedimento, pedimento cubierto o glacis de cobertera. El término se ha utilizado en varios contextos geomorfológicos: los pedimentos pueden clasificarse con respecto a (a) su posición en el paisaje, por ejemplo, en el piedemonte de una cuenca intermontana o al pie de la ladera del borde de un valle (respectivamente denominados, pedimento de falda montañosa y pedimento en terraza o glacis terraza (Cooke y Warren, 1973) ); (b) por el tipo de material erosionado, rocoso o regolítico; o (c) combinaciones de los anteriores. Comparar – ladera de piedemonte."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/pedimentSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/pediment_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "pediment setting"@en,
        "ambiente de pedimento"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-plataforma-carbonatada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "A type of carbonate platform that is attached to a continental landmass and a region of sedimentation that is analogous to shelf environments for terrigenous clastic deposition. A carbonate shelf may receive some supply of material from the adjacent landmass."@en,
        "Un tipo de plataforma de carbonatos adjunta a una masa de tierra continental y a una zona de sedimentación que es análoga a los ambientes de plataforma para la deposición clástica terrígena. Una plataforma carbonatada puede recibir algún aporte de material de la masa de tierra adyacente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/carbonateShelfSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "carbonate shelf setting"@en,
        "ambiente de plataforma carbonatada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-plataforma-continental> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "That part of the ocean floor that is between the shoreline and the continental slope (or, when there is no noticeable continental slope, a depth of 200 m). It is characterized by its gentle slope of 0.1 degree (Jackson, 1997, p. 138). Continental shelves have a classic shoreline-shelf-slope profile termed 'clinoform'."@en,
        "La parte del fondo oceánico que se encuentra entre la costa y el talud continental (o, cuando no hay un talud continental apreciable, una profundidad de 200 m). Se caracteriza por su suave pendiente de 0.1 grados (Jackson, 1997, Pág. 138). Las plataformas continentales tienen un perfil clásico de costa-plataforma-talud denominado 'clinoforma'."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/continentalShelfSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/continental_shelf_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "continental shelf setting"@en,
        "ambiente de plataforma continental"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-punto-caliente> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "Setting in a zone of high heat flow from the mantle. Typically identified in intraplate settings, but hot spot may also interact with active plate margins (Iceland...). Includes surface manifestations like volcanic center, but also includes crust and mantle manifestations as well."@en,
        "Ambiente en una zona de alto flujo de calor del manto. Típicamente identificado en ambientes de intraplaca, pero el punto caliente puede también interactuar con márgenes activos de placa (Islandia…). Incluye manifestaciones superficiales como los centros volcánicos, pero también incluye igualmente manifestaciones corticales y mantélicas."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hotSpotSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/hot_spot_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "hot spot setting"@en,
        "ambiente de punto caliente"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-rift-continental> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-terreno-extendido> ;
    skos:definition "Extended terrane in a zone of continental breakup, may include incipient oceanic crust. Examples include Red Sea, East Africa Rift, Salton Trough."@en,
        "Terrreno extendido en una zona de ruptura continental, puede incluir corteza oceánica incipiente. Los ejemplos incluyen el Mar Rojo, el Rift de África Oriental, el Salton Trough."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/continentalRiftSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/continental_rift_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "continental rift setting"@en,
        "ambiente de rift continental"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-rio-de-canal-trenzado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-fluvial> ;
    skos:definition "A stream that divides into or follows an interlacing or tangled network of several small branching and reuniting shallow channels separated from each other by ephemeral branch islands or channel bars, resembling in plan the strands of a complex braid. Such a stream is generally believed to indicate an inability to carry all of its load, such as an overloaded and aggrading stream flowing in a wide channel on a floodplain."@en,
        "Una corriente que se divide en o presenta una red entrelazada o enmarañada de varios canales pequeños y poco profundos que se ramifican y reúnen y están separados uno del otro por islas o barras de canal efímeras, que se asemejan en planta a las hebras de una compleja trenza. Se cree que este tipo de corriente generalmente indica incapacidad para transportar a la totalidad de la carga sólida, tal como una corriente sobrecargada y en agradación que fluye en un canal ancho sobre la llanura de inundación."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/braidedRiverChannelSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/braided_channel> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "braided river channel setting"@en,
        "ambiente de rio de canal trenzado"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-talud> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "The part of a subaqueous basin that is between a bordering shelf setting, which separate the basin from an adjacent landmass, and a very low-relief basin plain setting."@en,
        "La parte de una cuenca subacuática que se localiza entre la orla del ambiente de plataforma, que separa la cuenca de la masa terrestre adyacente, y el ambiente de relieve muy bajo de la llanura de cuenca."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/slope-riseSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/slope_rise_settings> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "slope-rise setting"@en,
        "ambiente de talud"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-talud-deltaico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Slope setting within the deltaic  system."@en,
        "Ambiente de talud en un sistema deltaico."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaSlopeSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "delta slope setting"@en,
        "ambiente de talud deltaico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-terrenos-agricolas-y-forestales> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Human influence setting with intensive agricultural activity or forestry land use,  including forest plantations."@en,
        "Ambiente con influencia humana debido a la agricultura intensiva o uso forestal del suelo, incluyendo las plantaciones forestales."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/agriculturalAndForestryLandSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "agricultural and forestry land setting"@en,
        "ambiente de terrenos agrícolas y forestales"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-tierras-recuperadas> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Human influence setting making land capable of more intensive use by changing its general character, as by drainage of excessively wet land, irrigation of arid or semiarid land; or recovery of submerged land from seas, lakes and rivers, restoration after human-induced degradation by removing toxic substances."@en,
        "Ambiente con influencia humana para hacer que el territorio sea capaz de un uso más intensivo modificando sus características generales, como el drenado de terrenos excesivamente húmedos, el riego de tierras áridas o semiáridas; o la recuperación de tierra sumergida de mares, lagos y ríos, la restauración de zonas degradadas por la acción humana mediante la eliminación de sustancias tóxicas."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/landReclamationSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "land reclamation setting"@en,
        "ambiente de tierras recuperadas"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-trasera-de-arco> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "Tectonic setting adjacent to a volcanic arc formed above a subduction zone. The back arc setting is on the opposite side of the volcanic arc from the trench at which oceanic crust is consumed in a subduction zone. Back arc setting includes terrane that is affected by plate margin and arc-related processes."@en,
        "Ambiente tectónico adyacente a un arco volcánico formado por encima de una zona de subducción. El ambiente de trasera de arco está en el lado opuesto del arco volcánico a la fosa en la que la corteza oceánica se consume en una zona de subducción. El ambiente de trasera de arco incluye terreno que es afectado por procesos de márgenes de placa y procesos relacionados con los arcos."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/backArcSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/back_arc_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "back arc setting"@en,
        "ambiente de trasera de arco"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-ultra-alta-presion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra> ;
    skos:definition "Setting characterized by pressures characteristic of upper mantle, but indicated by mineral assemblage in crustal composition rocks."@en,
        "Ambiente caracterizado por presiones características del manto superior, pero indicada por la asociación mineral en rocas de composición cortical."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/ultraHighPressureCrustalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/ultra_high_pressure_crustal_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "ultra high pressure crustal setting"@en,
        "ambiente de ultra-alta presión"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-zona-de-deposicion-de-residuos-y-materiales> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Human influence setting in which non-natural or natural materials from elsewhere are deposited."@en,
        "Ambiente de influencia humana en el que se depositan materiales no naturales o materiales naturales procedentes de otros lugares."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/wasteAndMaterialDepositionAreaSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "waste and material deposition area setting"@en,
        "ambiente de zona de deposición de residuos y materiales"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-zona-de-subducion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa> ;
    skos:definition "Tectonic setting at which a tectonic plate, usually oceanic, is moving down into the mantle beneath another overriding plate."@en,
        "Ambiente tectónico en el que una placa tectónica, por lo general oceánica, se desplaza hacia el interior del manto por debajo de otra placa superior."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/subductionZoneSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/subduction_zone_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "subduction zone setting"@en,
        "ambiente de zona de subdución"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-englacial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares> ;
    skos:definition "Contained, embedded, or carried within the body of a glacier or ice sheet; said of meltwater streams, till, drift, moraine."@en,
        "Contenido en, incorporado o transportando en el interior del cuerpo de un glaciar o un manto de hielo; dicho de las corrientes de agua de deshielo, till, derrubios, morrena."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/englacialSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/englacial_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "englacial setting"@en,
        "ambiente englacial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-extraterrestre> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Material originated outside of the Earth or its atmosphere."@en,
        "Material originado fuera de la Tierra o de su atmósfera."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/extra-terrestrialSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/extra_terrestrial_origin> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "extra-terrestrial setting"@en,
        "ambiente extraterrestre"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciofluvial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "A setting influenced by glacial meltwater streams. This setting can be sub- en-, supra- and proglacial."@en,
        "Un ambiente influenciado por las corrientes de agua de deshielo glacial. Este ambiente puede ser englaciar, sub-, supra- y proglacial."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glaciofluvialSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "glaciofluvial setting"@en,
        "ambiente glaciofluvial"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciolacuste> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Ice margin lakes and other lakes related to glaciers. Where meltwater streams enter the lake, sands and gravels are deposited in deltas. At the lake floor, typivally rhythmites (varves) are deposited.Ice margin lakes and other lakes related to glaciers."@en,
        "Lagos en las áreas marginales del hielo y otros lagos relacionados con glaciares. En el lugar donde los arroyos de deshielo entran al lago, las arenas y gravas se depositan formando deltas. En el fondo del lago, se depositan ritmitas típicas (varvas)."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glaciolacustrineSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "glaciolacustrine setting"@en,
        "ambiente glaciolacuste"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciomarino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "A marine environment influenced by glaciers. Dropstone diamictons and dropstone muds are typical deposits in this environment."@en,
        "Un medio marino con fluencia de los glaciares. Los dropstones, el diamicton y los fangos con dropstones son los depósitos típicos en este ambiente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glaciomarineSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "glaciomarine setting"@en,
        "ambiente glaciomarino"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-hadal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "The deepest oceanic environment, i.e., over 6,000 m in depth. Always in deep sea trench."@en,
        "El ambiente oceánico más profundo, es decir, a más de 6.000 m de profundidad. Siempre se asocia a las fosas de aguas profundas."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hadalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/hadal> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "hadal setting"@en,
        "ambiente hadal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-hipoabisal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra> ;
    skos:definition "Igneous environment close to the Earth's surface, characterized by more rapid cooling than plutonic setting to produce generally fine-grained intrusive igneous rock that is commonly associated with co-magmatic volcanic rocks."@en,
        "Ambiente ígneo cercano a la superficie terráquea, caracterizado por un enfriamiento más rápido que en el ambiente plutónico para producir rocas ígneas intrusivas generalmente de grano fino que están comúnmente asociadas con rocas volcánicas co-magmáticas."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hypabyssalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/hypabyssal_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "hypabyssal setting"@en,
        "ambiente hipoabisal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-humedo-a-subhumedo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "A Wet to sub-humid climate is according Thornthwaite's climate classification system associated with rain forests (wet), forests (humid) and grassland (sub-humid)."@en,
        "Según el sistema de clasificación climática de Thornthwaite un clima húmedo a subhúmedo está asociados a la pluviselva (húmedos), los bosques (húmedos) y los pastizales (sub-húmedo)."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/wetToSub-humidSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "wet to sub-humid setting"@en,
        "ambiente húmedo a subhúmedo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intracratonico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "A basin formed within the interior region  of a continent, away from plate boundaries."@en,
        "Una cuenca formada dentro de la región interior de un continente, lejos de los bordes de placa."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/intracratonicSetting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "intracratonic setting"@en,
        "ambiente intracratónico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-dominado-por-carbonatos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> ;
    skos:definition "A shoreline setting in which terrigenous input is minor compared to local carbonate sediment production. Constructional biogenic activity is an important element in geomorphic development."@en,
        "Un ambiente litoral en la que de entrada de terrígeno es comparativamente menor que la producción local de sedimentos de carbonato. La actividad biogénica constructiva es un factor importante en su desarrollo geomorfológico."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/carbonateDominatedShorelineSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/carbonate_dominated_shoreline_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "carbonate dominated shoreline setting"@en,
        "ambiente litoral dominado por carbonatos"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino-epicontinental> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "Marine setting situated within the interior of the continent, rather than at the edge of a continent."@en,
        "ambiente marino situado en el interior de un continente, en lugar de en el borde del continente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/epicontinentalMarineSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/epicontinental_marine_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "epicontinental marine setting"@en,
        "ambiente marino epicontinental"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-meandro-estrangulado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial> ;
    skos:definition "The abandoned, bow- or horseshoe-shaped channel of a former meander, left when the stream formed a cutoff across a narrow meander neck. Note that these are typically lakes, thus also lacustrine."@en,
        "El canal, en forma de collera o herradura de un antiguo meandro, abandonado cuando la corriente forma un corte a través de un estrecho cuello meandro. Téngase en cuenta que en general suelen formar lagos, y por tanto también son lacustres."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/cutoffMeanderSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/cutoff_meander> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "cutoff meander setting"@en,
        "ambiente meandro estrangulado"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-externo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico> ;
    skos:definition "The ocean environment at depths between 100 meters and approximately the edge of the continental shelf or between 100 and 200 meters."@en,
        "El ambiente oceánico a profundidades comprendidas entre 100 metros y aproximadamente el borde de la plataforma continental o entre 100 y 200 metros."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/outerNeriticSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/outer_neritic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "outer neritic setting"@en,
        "ambiente nerítico externo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-interno> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico> ;
    skos:definition "The ocean environment at depths between low tide level and 30 metres."@en,
        "Ambiente oceánico situado a profundidades comprendidas entre el nivel de marea baja y 30 metros."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/innerNeriticSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/inner_neritic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "inner neritic setting"@en,
        "ambiente nerítico interno"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-medio> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico> ;
    skos:definition "The ocean environment at depths between 30 and 100 metres."@en,
        "El ambiente océanico en aguas de profundidades comprendidas entre 30 y 100 metros."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/middleNeriticSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/middle_neritic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "middle neritic setting"@en,
        "ambiente nerítico medio"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-plataforma-carbonatada-marina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "A shallow submerged plateau separated from continental landmasses, on which high biological carbonate production rates produce enough sediment to maintain the platform surface near sea level. Grades into atoll as area becomes smaller and ringing coral reefs become more prominent part of the setting."@en,
        "Una meseta sumergida somera separada de las masas de tierra continentales, en la que las altas tasas de producción de carbonato biológico generan suficientes sedimentos para mantener la superficie de la plataforma próxima al nivel del mar. Pasan gradualmente a un atolón cuando su área se hace más pequeña y el anillo  de arrecifes de coral se convierten en la parte más prominente del ambiente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/marineCarbonatePlatformSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/marine_carbonate_platform_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "marine carbonate platform setting"@en,
        "ambiente plataforma carbonatada marina"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-por-debajo-de-la-profundidad-de-compensacion-del-carbonato> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "Marine environment in which water is deep enough that carbonate sediment goes into solution before it can accumulate on the sea floor."@en,
        "Ambiente marino en el que el agua es lo suficientemente profunda como para que los sedimentos de carbonato se disuelvan antes de que lleguen a acumularse en el fondo del mar."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/belowCarbonateCompensationDepthSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/below_carbonate_compensation_depth_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "below carbonate compensation depth setting"@en,
        "ambiente por debajo de la profundidad de compensación del carbonato"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-por-encima-de-la-profundidad-de-compensacion-del-carbonato> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "Marine environment in which carbonate sediment does not dissolve before reaching the sea floor and can accumulate."@en,
        "Medio marino en el que los sedimentos de carbonato no se disuelve antes de llegar al fondo del mar y se puede acumular."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/aboveCarbonateCompensationDepthSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/above_carbonate_compensation_depth_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "above carbonate compensation depth setting"@en,
        "ambiente por encima de la profundidad de compensación del carbonato"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-postarrecifal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arrecife-biologico> ;
    skos:definition "The landward side of a reef. The term is often used adjectivally to refer to deposits within the restricted lagoon behind a barrier reef, such as the \"back-reef facies\" of lagoonal deposits. In some places, as on a platform-edge reef tract, \"back reef\" refers to the side of the reef away from the open sea, even though no land may be nearby."@en,
        "El paraje situado hacía tierra de un arrecife. El término se utiliza a menudo como adjetivo para referirse a los depósitos de la laguna costera restringida o albufera situada detrás de una barra arrecifal, como los \"facies postarrecifales\" de depósitos lagunares. En algunos casos, como en las plataformas arrecifales, \" postarrecifales \" se refiere a la parte del arrecife alejado del mar abierto, a pesar de que la tierra puede no estar próxima."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/backreefSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/backreef> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "backreef setting"@en,
        "ambiente postarrecifal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subglacial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares> ;
    skos:definition "Formed or accumulated in or by the bottom parts of a glacier or ice sheet; said of meltwater streams, till, moraine, etc."@en,
        "Formado o acumulada en o por el fondo de un glaciar o manto de hielo; dicho de las corrientes de agua de deshielo, el till, morrenas, etc."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/subglacialSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/subglacial_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "subglacial setting"@en,
        "ambiente subglacial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supraglacial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares> ;
    skos:definition "\"Carried upon, deposited from, or pertaining to the top surface of a glacier or ice sheet; said of meltwater streams, till, drift, etc. \" (Jackson, 1997, p. 639). Dreimanis (1988, p. 39) recommendation that \"supraglacial\" supersede \"superglacial\" is followed."@en,
        "\"Transportado sobre, depositado a partir de, o en relación con la superficie superior de un manto de hielo o un glaciar; dicho de corrientes de agua de deshielo, el till, derrubios, etc.\" (Jackson, 1997, p 639.). Dreimanis (1988, p. 39) recomienda que \"supraglacial\" reemplace \"superglacial\"."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/supraglacialSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/supraglacial_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "supraglacial setting"@en,
        "ambiente supraglacial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terminal-del-glaciar> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-proglacial> ;
    skos:definition "Region of sediment deposition at the glacier terminus due to melting of glacier ice, melt-out, ablation and flow till setting."@en,
        "Región en la zona de terminación del glaciar de deposición de sedimentos debidos al derretimiento del hielo glaciar, la fusión, la ablación y los flujos en masa de till."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glacierTerminusSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/glacier_terminus_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "glacier terminus setting"@en,
        "ambiente terminal del glaciar"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terraqueo-interno-de-alta-presion-y-baja-temperatura> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra> ;
    skos:definition "High pressure environment characterized by geothermal gradient significantly lower than standard continental geotherm; environment in which blueschist facies metamorphic rocks form. Typically associated with subduction zones."@en,
        "Ambiente de alta presión caracterizado por un gradiente geotérmico significantemente menor que la geoterma continental estándar; ambiente en el que se forman las rocas metamórficas de la facies de los esquistos azules. Típicamente asociado a la zonas de subducción."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/highPressureLowTemperatureEarthInteriorSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/high_pressure_low_temperature_earth_interior_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "high pressure low temperature Earth interior setting"@en,
        "ambiente terráqueo interno de alta presión y baja temperatura"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-yuxtaglaciar> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares> ;
    skos:definition "Settings adjacent to edges of confined glacier."@en,
        "Ambiente adyacente a los bordes de los glaciares confinados."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glacierLateralSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/glacier_lateral_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "glacier lateral setting"@en,
        "ambiente yuxtaglaciar"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/antecosta> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "A foreshore is the region between mean high water and mean low water marks of the tides. Depending on the tidal range this may be a vertical distance of anything from a few tens of centimetres to many meters."@en,
        "La antecosta es la región situada entre la pleamar media y la media de las marcas de la bajamar de las mareas. Dependiendo de la amplitud de la marea puede ser una distancia vertical cualquiera, desde unas pocas decenas de centímetros a varios metros."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/foreshore> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "foreshore"@en,
        "antecosta"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/centro-de-expansion-lenta> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo> ;
    skos:definition "Spreading center at which the opening rate is less than 50 mm per year."@en,
        "Centro de expansión en el que la velocidad de apertura es menor que 50 mm por año."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/slowSpreadingCenterSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/slow_spreading_center_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "slow spreading center setting"@en,
        "centro de expansión lenta"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/graben> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "An elongate trough or basin, bounded on both sides by high-angle normal faults that dip toward one another. It is a structual form that may or may not be geomorphologically expressed as a rift valley."@en,
        "Un surco o cuenca alargada, limitada en ambos lados por fallas normales de alto ángulo que buzan la una hacia la otra. Es una forma estructural que puede estar expresada geomorfológicamente como un valle de rift o no estarlo."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/graben> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "graben"@en,
        "graben"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/salina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "A small, undrained, shallow depression in which water accumulates and evaporates, leaving a salt deposit."@en,
        "Una depresión pequeña sin drenaje, somera en la cual el agua se acumula y se evapora, dejando un depósito de sal"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/saltPan> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "salt pan"@en,
        "salina"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/semi-graben> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "A elongate , asymmetric trough or basin bounded on one side by a normal fault."@en,
        "Un surco o cuenca asimétrica alargada, limitada en un lado por una falla normal."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/half-graben> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "half-graben"@en,
        "semi-graben"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-colisional> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "tectonic setting in which two continental crustal plates impact and are sutured together after intervening oceanic crust is entirely consumed at a subduction zone separating the plates. Such collision typically involves major mountain forming events, exemplified by the modern Alpine and Himalayan mountain chains."@en,
        "Ambiente tectónico en el que dos placas de corteza continental impactan y son suturadas juntas después de que la corteza oceánica interviniente haya sido enteramente consumida en una zona de subducción que separe las placas. Tal colisión típicamente involucra eventos mayores de formación de montañas, ejemplificados por las cadenas de montañas modernas Alpina y del Himalaya."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/collisionalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/collisional_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "collisional setting"@en,
        "ambiente colisional"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-antepais> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "The exterior area of an orogenic belt where deformation occurs without significant metamorphism. Generally the foreland is closer to the continental interior than other portions of the orogenic belt are."@en,
        "El área exterior de un cinturón orogénico donde la deformación ocurre sin un metamorfismo significativo. Generalmente el antepaís está más proximo al interior del continente de lo que lo están otras partes del cinturón orogénico."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/forelandSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/foreland_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "foreland setting"@en,
        "ambiente de antepaís"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos> ;
    skos:definition "Extensive deposits on sand in an area where the supply is abundant. As a characteristic, individual dunes somewhat resemble barchans but are highly irregular in shape and crowded; erg areas of the Sahara are an example."@en,
        "Depósitos extensos sobre arena en una zona donde el suministro es abundante. Característicamente, las dunas individuales se asemejan algo a los barjanes pero son de forma muy irregulares y están apiladas; por ejemplo las áreas de erg del Sahara."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/dunefieldSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/dunefield> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas-litoral> ;
    skos:prefLabel "dunefield setting"@en,
        "ambiente de campo de dunas"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-mareal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico> ;
    skos:definition "A major channel followed by the tidal currents, extending from offshore into a tidal marsh or a tidal flat."@en,
        "Un canal principal recorrido por las corrientes de marea, que se extiende desde el mar abierto hacia el interior de una marisma mareal o una llanura mareal."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/tidalChannelSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/tidal_channel> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "tidal channel setting"@en,
        "ambiente de canal mareal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-inactivo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-placa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-intraplaca> ;
    skos:definition "Setting on oceanic crust formed at a spreading center that has been abandoned."@en,
        "Ambiente en la corteza oceánica formado en un centro de expansión que ha sido abandonado."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/inactiveSpreadingCenterSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/inactive_spreading_center> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "inactive spreading center setting"@en,
        "ambiente de centro de expansión inactivo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-polar> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Setting with climate dominated by temperatures below the freezing temperature of water. Includes polar deserts because precipitation is generally scant at high latitude. Climatically controlled by arctic air masses, cold dry environment with short summer."@en,
        "Ambiente con clima sujeto a temperaturas por debajo de la temperatura la congelación del agua. Incluye desiertos polares debido a que la precipitación es generalmente escasa a latitudes altas. Climáticamente controlado por las masas de aire ártico, ambiente frío y seco con verano corto."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/polarClimaticSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/polar_climatic_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares> ;
    skos:prefLabel "polar climatic setting"@en,
        "ambiente de clima polar"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cordon-litoral> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo> ;
    skos:definition "A prograded shore built seaward by waves and currents, and continuous for some distance along the coast. It is characterized by subparallel beach ridges and swales, in places with associated dunes."@en,
        "Litoral progradante construido mar adentro por el oleaje y las corrientes, y que continua durante alguna distancia a lo largo de la costa. Se caracteriza por los cordones y surcos de playa subparalelos, en lugares con dunas asociadas."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/strandplainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/strandplain_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "strandplain setting"@en,
        "ambiente de cordon litoral"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-estuarino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-estuarino> ;
    skos:definition "A delta that has filled, or is in the process of filling, an estuary."@en,
        "Un delta que ha llenado, o se encuentra en el proceso de llenar, un estuario."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/estuarineDeltaSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/estuarine_delta> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "estuarine delta setting"@en,
        "ambiente de delta estuarino"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-lacustre> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-lacustre> ;
    skos:definition "The low, nearly flat, alluvial tract of land at or near the mouth of a river, commonly forming a triangular or fan-shaped plain of considerable area, crossed by many distributaries of the main river, perhaps extending beyond the general trend of the lake shore, resulting from the accumulation of sediment supplied by the river in such quantities that it is not removed by waves or currents. Most deltas are partly subaerial and partly below water."@en,
        "Porción de tierra aluvial baja, casi plana, en o cerca de la desembocadura de un río, comúnmente formando una llanura triangular o en forma de abanico de superficie considerable, atravesada por numerosos distributarios del río principal, que puede extenderse más allá de la línea de costa general del lago, que resulta de la acumulación de sedimentos suministrada por el río en cantidades tales que no se removilizan por las olas o las corrientes. La mayoría de los deltas son parcialmente subaéreos y en parte se ubican por debajo del agua."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lacustrineDeltaSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/lacustrine_delta> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "lacustrine delta setting"@en,
        "ambiente de delta lacustre"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-la-bahia-interdistributaria> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico> ;
    skos:definition "A pronounced indentation of the delta front between advancing stream distributaries, occupied by shallow water, and either open to the sea or partly enclosed by minor distributaries."@en,
        "Una indentación pronunciada del frente del delta entre corrientes distributarias avanzadas, ocupada por aguas poco profundas, y ya sea abierta al mar o parcialmente delimitada por distributarios menores."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/interdistributaryBaySetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/interdistributary_bay> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "interdistributary bay setting"@en,
        "ambiente de la bahía interdistributaria"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-de-barrera> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-isla-barrera> ;
    skos:definition "A lagoon that is roughly parallel to the coast and is separated from the open ocean by a strip of land or by a barrier reef. Tidal influence is typically restricted and the lagoon is commonly hypersaline."@en,
        "Una laguna o albufera que es más o menos paralela a la costa y está separada del mar abierto por una franja de tierra o por una barrera de arrefices. La influencia de las mareas típicamente está restringida y la laguna costera comúnmente es hipersalina."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/barrierLagoonSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/barrier_lagoon> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "barrier lagoon setting"@en,
        "ambiente de laguna litoral de barrera"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-estuarina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-estuarino> ;
    skos:definition "A lagoon produced by the temporary sealing of a river estuary by a storm barrier. Such lagoons are usually seasonal and exist until the river breaches the barrier; they occur in regions of low or spasmodic rainfall."@en,
        "Una laguna costera producida por el cierre temporal del estuario de un río por una barrera de tormenta. Estas lagunas son generalmente temporales y duran hasta que el río rompe la barrera; ocurren en regiones de precipitación escasa y de caracter súbito."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/estuarineLagoonSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/estuarine_lagoon> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "estuarine lagoon setting"@en,
        "ambiente de laguna litoral estuarina"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial-glacial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "A broad, gently sloping sheet of outwash deposited by meltwater streams flowing in front of or beyond a glacier, and formed by coalescing outwahs fans; the surface of a broad body of outwash."@en,
        "Una llanura amplia y de pendiente suave formada por aluviones depositados por corrientes de deshielo que fluyen frente o por delante de un glaciar, y que se forma mediante la coalescencia de abanicos aluviales; la superficie de un amplio depósito de aluviones procedentes de un glaciar."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glacialOutwashPlainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/glacial_outwash_plain_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "glacial outwash plain setting"@en,
        "ambiente de llanura aluvial glacial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-mareal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal> ;
    skos:definition "An extensive, nearly horizontal, barren tract of land that is alternately covered and uncovered by the tide, and consisting of unconsolidated sediment (mostly mud and sand). It may form the top surface of a deltaic deposit."@en,
        "Un terreno extenso, casi horizontal, y yermo cubierto y descubierto alternativamente por las mareas, y que consiste en sedimentos no consolidados (en su mayoría fango y arena). Puede formarse en la superficie superior de un depósito deltaico."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/tidalFlatSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/tidal_flat_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "tidal flat setting"@en,
        "ambiente de llanura de mareal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-alta> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "The part of a delta plain essentially unaffected by basinal processes. They do not differ substantially from alluvial environments except that areas of swamp, marsh and lakes are usually more widespread and channels may bifurcate downstream."@en,
        "La parte de una llanura deltaica afectadas fundamentalmente por los procesos de cuenca. No difieren sustancialmente de los ambientes aluviales, excepto que las zonas con pantanos, marismas y lagos suelen ser más frecuentes y que los canales pueden bifurcarse aguas abajo."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperDeltaPlainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_delta_plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "upper delta plain setting"@en,
        "ambiente de llanura deltaica alta"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-baja> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal> ;
    skos:definition "The part of a delta plain which is penetrated by saline water and is subject to tidal processes."@en,
        "La parte de una llanura deltaica en la que penetra el agua salina y está sometida a los procesos de marea."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerDeltaPlainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_delta_plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "lower delta plain setting"@en,
        "ambiente de llanura deltaica baja"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-litoral> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo> ;
    skos:definition "A low relief plain bordering a water body extending inland to the nearest elevated land, sloping very gently towards the water body. Distinguished from alluvial plain by presence of relict shoreline-related deposits or morphology."@en,
        "Una llanura de relieve bajo al borde de una masa de agua que se extiende tierra adentro en las elevaciones más cercanas, con una pendiente muy suave hacia la masa de agua. Se distingue de llanura aluvial por la presencia de depósitos o morfologías relictas relacionadas con el litoral."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/coastalPlainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/coastal_plain_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "coastal plain setting"@en,
        "ambiente de llanura litoral"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-marisma-mareal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-mareal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pantano-o-marisma> ;
    skos:definition "A marsh bordering a coast (as in a shallow lagoon or sheltered bay), formed of mud and of the resistant mat of roots of salt-tolerant plants, and regularly inundated during high tides; a marshy tidal flat."@en,
        "Un marisma que bordea una costa (como en una laguna litoral somera o una bahía protegida), formado por fango y un resistente tapiz de raíces de plantas que toleran la sal, e inundado con regularidad durante la pleamar; un llanura mareal marismeña."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/tidalMarshSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/tidal_marsh> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-marisma-mareal> ;
    skos:prefLabel "tidal marsh setting"@en,
        "ambiente de marisma mareal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-monte-submarino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-elevaciones-oceanicas>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-intraplaca> ;
    skos:definition "Setting that consists of a conical mountain on the ocean floor (guyot). Typically characterized by active volcanism, pelagic sedimentation. If the mountain is high enough to reach the photic zone, carbonate production may result in reef building to produce a carbonate platform or atoll setting."@en,
        "Ambiente que consiste de una montaña cónica sobre el fondo oceánico (guyot). Típicamente caracterizado por vulcanismo activo y sedimentación pelágica. Si la montaña es suficientemente alta como para alcanzar la zona fótica, la producción de carbonatos puede resultar en la construcción de arrecifes para producir un ambiente de plataforma carbonatada o de atolón."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/seamountSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/seamount_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "seamount setting"@en,
        "ambiente de monte submarino"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pantano-o-marisma> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-humedales> ;
    skos:definition "A water-saturated, periodically wet or continually flooded area with the surface not deeply submerged, essentially without the formation of peat. Marshes are characterized by sedges, cattails, rushes, or other aquatic and grasslike vegetation. Swamps are characterized by tree and brush vegetation."@en,
        "Área saturada en agua, periódicamente húmeda o constantemente inundada con su superficie sumergida poco profundamente, sin que básicamente se forme turba. Las marismas se caracterizan por las ciperáceas, espadañas, juncáceas, u otra vegetación acuática y de praderas. Los pantanos se caracterizan por vegetación arbórea y de matorral."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/swampOrMarshSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/swamp_or_marsh_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-marisma-mareal> ;
    skos:prefLabel "swamp or marsh setting"@en,
        "ambiente de pantano o marisma"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> ;
    skos:definition "The unconsolidated material at the shoreline that covers a gently sloping zone, typically with a concave profile, extending landward from the low-water line to the place where there is a definite change in material or physiographic form (such as a cliff), or to the line of permanent vegetation (usually the effective limit of the highest storm waves); at the shore of a body of water, formed and washed by waves or tides, usually covered by sand or gravel, and lacking a bare rocky surface."@en,
        "El material no consolidado en la línea de costa que cubre una zona de poca profundidad, por lo general con un perfil cóncavo, que se extiende hacia tierra desde la línea de bajamar al lugar donde hay un cambio definitivo de material o forma fisiográfica (como por ejemplo un acantilado), o la línea de vegetación permanente (por lo general el límite efectivo de las olas más altas de tormenta); en la orilla de un cuerpo de agua, formado y bañada por las olas o mareas, por lo general cubiertos por arena o grava, y que carecen de una superficie rocosa desnuda."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/beachSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/beach> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-de-barrera> ;
    skos:prefLabel "beach setting"@en,
        "ambiente de playa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-de-barrera> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-isla-barrera> ;
    skos:definition "A narrow, elongate sand or gravel ridge rising slightly above the high-tide level and extending generally parallel with the shore, but separated from it by a lagoon (Shepard, 1954, p.1904), estuary, or marsh; it is extended by longshore transport and is rarely more than several kilometers long."@en,
        "Un cordón estrecho y alargado de arena o grava que se eleva ligeramente por encima del nivel de la marea alta y se extiende paralelo a la costa, pero separada de ella por una laguna costera o albufera (Shepard, 1954, p.1904), estuario o marisma; que se prolonga mediante el transporte litoral y rara vez se extiende a lo largo de más de varios kilómetros."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/barrierBeachSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/barrier_beach> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "barrier beach setting"@en,
        "ambiente de playa de barrera"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-prodelta> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico> ;
    skos:definition "The part of a delta that is below the effective depth of wave erosion, lying beyond the delta front, and sloping gently down to the floor of the basin into which the delta is advancing and where clastic river sediment ceases to be a significant part of the basin-floor deposits; it is entirely below the water level."@en,
        "La parte de un delta que está por debajo de la profundidad de erosión efectiva de las olas, yace más allá del frente del delta, y se inclina suavemente hacia el fondo de la cuenca en la que el delta está avanzando y donde los sedimentos clásticos del río dejan de ser una parte importante de la depósitos del fondo de cuenca; está completamente por debajo del nivel de agua."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/prodeltaSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/prodelta> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "prodelta setting"@en,
        "ambiente de prodelta"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-terreno-extendido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "Tectonic setting characterized by extension of the upper crust, manifested by formation of rift valleys or basin and range physiography, with arrays of low to high angle normal faults. Modern examples include the North Sea, East Africa, and the Basin and Range of the North American Cordillera. Typically applied in continental crustal settings."@en,
        "Ambiente tectónico caracterizado por la extensión de la corteza superior, manifestada por la formación de fisiografía en valles de rift o en basin and range."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/extendedTerraneSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/extended_terrane> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-rift-continental> ;
    skos:prefLabel "extended terrane setting"@en,
        "ambiente de terreno extendido"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intermareal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico> ;
    skos:definition "Pertaining to the benthic ocean environment or depth zone between high water and low water; also, pertaining to the organisms of that environment."@en,
        "Perteneciente al ambiente marino bentónico o zona de profundidad entre la pleamar y la bajamar; también, relativo a los organismos de ese ambiente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/intertidalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/intertidal> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "intertidal setting"@en,
        "ambiente intermareal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-lacustre> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "Setting associated with a lake. Always overlaps with terrestrial, may overlap with subaerial, subaqueous, or shoreline."@en,
        "Marco asociado a un lago. Siempre solapa con terrestres pueden solaparse con subaéreos, subacuático, o costa."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lacustrineSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/lacustrine_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-lacustre> ;
    skos:prefLabel "lacustrine setting"@en,
        "ambiente lacustre"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-proglacial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares> ;
    skos:definition "Immediately in front of or just beyond the outer limits of a glacier or ice sheet, generally at or near its lower end; said of lakes, streams, deposits, and other features produced by or derived from the glacier ice."@en,
        "Inmediatamente por delante o poco más allá de los límites exteriores de un glaciar o manto de hielo, generalmente en o cerca de su extremo inferior; dicho de lagos, arroyos, depósitos y otras características producidas por o derivados del hielo glaciar."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/proglacialSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/proglacial_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terminal-del-glaciar> ;
    skos:prefLabel "proglacial setting"@en,
        "ambiente proglacial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-sabkha-marina-marginal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia> ;
    skos:definition "Setting characterized by arid to semi-arid conditions on restricted coastal plains mostly above normal high tide level, with evaporite-saline mineral, tidal-flood, and eolian deposits. Boundaries with intertidal setting and non-tidal terrestrial setting are gradational. (Jackson, 1997, p. 561)."@en,
        "Ambiente caracterizado por condiciones áridas a semiáridas en llanuras costeras restringidas mayoritariamente sobre el nivel normal de la marea alta, con minerales evaporitico-salinos, inundación mareal, y depósitos eólicos. Sus límites con los ambientes intermareales y los ambientes terrestres no mareales son graduales. (Jackson, 1997, p. 561)."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/marginalMarineSabkhaSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/marginal_marine_sabkha_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "marginal marine sabkha setting"@en,
        "ambiente sabkha marina marginal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supramareal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo> ;
    skos:definition "Pertaining to the shore area marginal to the littoral zone, just above high-tide level."@en,
        "Perteneciente a la zona costera marginal a la zona litoral, justo por encima del nivel pleamar."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/supratidalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/supratidal> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "supratidal setting"@en,
        "ambiente supramareal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-traspais> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "Tectonic setting in the internal part of an orogenic belt, characterized by plastic deformation of rocks accompanied by significant metamorphism, typically involving crystalline basement rocks. Typically denotes the most structurally thickened part of an orogenic belt, between a magmatic arc or collision zone and a more 'external' foreland setting."@en,
        "Ambiente tectónico en la parte interna de un cinturón orogénico, caracterizado por la deformación plástica de las rocas acompañada de un metamorfismo significativo, típicamente involucrando a rocas del basamento cristalino. Típicamente denota la parte más engrosada estructuralmente de un cinturón orogénico, entre un arco magmático o zona de colisión y un ambiente más \"externo\" de antepaís."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hinterlandTectonicSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/hinterland_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "hinterland tectonic setting"@en,
        "ambiente tectónico de traspaís"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-fluvial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial> ;
    skos:definition "The bed where a natural body of surface water flows or may flow; a natural passageway or depression of perceptible extent containing continuously or periodically flowing water, or forming a connecting link between two bodies of water; a watercourse."@en,
        "El lecho en el que un masa natural de agua superficial fluye o puede fluir; un conducto natural o una depresión de medidas perceptibles conteniendo de forma continua o periódica agua que fluye, o formando la conexión entre dos masas de agua; una corriente de agua."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/riverChannelSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/river_channel> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-de-rio-meandriforme>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-rio-de-canal-trenzado> ;
    skos:prefLabel "river channel setting"@en,
        "ambiente de canal fluvial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-placa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "Tectonic setting where new oceanic crust is being or has been formed at a divergent plate boundary. Includes active and inactive spreading centers."@en,
        "Ambiente tectónico donde se está formando o ha sido formada nueva corteza oceánica en un límite divergente de placas. Incluye centros de expansión activos e inactivos."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/plateSpreadingCenterSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/plate_spreading_center> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-inactivo> ;
    skos:prefLabel "plate spreading center setting"@en,
        "ambiente de centro de expansión de placa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical> ;
    skos:definition "That type of the Earth's crust which underlies the ocean basins. The oceanic crust is 5-10 km thick; it has a density of 2.9 g/cm3, and compressional seismic-wave velocities travelling through it at 4-7.2 km/sec. Setting in crust produced by submarine volcanism at a mid ocean ridge."@en,
        "Aquel tipo de corteza terrestre que subyace a las cuencas oceánicas. La corteza oceánica tiene un espesor de 5-10 km; tiene una densidad de 2.9 g/cm3, y velocidades de las ondas sísmicas compresionales al viajar a través de ella de 4-7.2 km/s. ambiente de la corteza producido por el vulcanismo submarino en una dorsal meso-oceánica."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/oceanic-crustalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/oceanic_crust> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica-inferior>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica-superior> ;
    skos:prefLabel "oceanic-crustal setting"@en,
        "ambiente de corteza oceánica"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-humedales> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Setting characterized by gentle surface slope, and at least intermittent presence of standing water, which may be fresh, brackish, or saline. Wetland may be terrestrial setting or shoreline setting."@en,
        "Ambiente que se caracteriza por una superficie de pendiente suave, y al menos por la presencia intermitente de agua estanca, que puede ser dulce, salobre o salina. Los Humedales pueden ser de ambiente terrestre o de ambiente litoral."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/wetlandSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/wetland_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pantano-o-marisma>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso> ;
    skos:prefLabel "wetland setting"@en,
        "ambiente de humedales"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> ;
    skos:definition "A shallow stretch of salt or brackish water, partly or completely separated from a sea or lake by an offshore reef, barrier island, sand or spit (Jackson, 1997). Water is shallow, tidal and wave-produced effects on sediments; strong light reaches sediment."@en,
        "Una extensión de somera de agua salada o salobre, en parte o completamente separado del mar o un lago por un arrecife de mar abierto, una isla barrera, arena o un cordón litoral (Jackson, 1997). El agua es poco profunda, las mareas y oleaje producen efectos en los sedimentos; la luminosidad en el sedimento es fuerte."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lagoonalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/lagoonal_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-de-barrera>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-estuarina> ;
    skos:prefLabel "lagoonal setting"@en,
        "ambiente de laguna litoral"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arenosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "A sand-covered plain dominated by aeolian processes."@en,
        "Una llanura cubierta de arena dominada por procesos eólicos."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/sandPlainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/sand_plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "sand plain setting"@en,
        "ambiente de llanura arenosa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico> ;
    skos:definition "The level or nearly level surface composing the landward part of a large or compound delta; strictly, an alluvial plain characterized by repeated channel bifurcation and divergence, multiple distributary channels, and interdistributary flood basins."@en,
        "La superficie llana o casi llana que compone la parte terrestre de un delta grande o complejo; en sentido estricto, una llanura aluvial caracteriza por la bifurcación y divergencia repetida de canales, numerosos canales distributarios, y cuencas de inundación interdistributarias."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaPlainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/delta_plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-alta>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-baja> ;
    skos:prefLabel "delta plain setting"@en,
        "ambiente de llanura deltaica"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-pedregosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "A desert plain strewn with wind-abraded pebbles, or gibbers; a gravelly desert."@en,
        "Llanura desértica cubierta de cantos desgastado por el viento (gibbers); un desierto pedregoso."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/gibberPlainSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/gibber_plain> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "gibber plain setting"@en,
        "ambiente de llanura pedregosa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-endorreica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "The usually dry and nearly level plain that occupies the lowest parts of closed depressions, such as those occurring on intermontane basin floors. Temporary flooding occurs primarily in response to precipitation-runoff events."@en,
        "La llanura normalmente seca y casi plana que ocupa las partes bajas de las depresiones cerradas, como las que se producen en los fondos de las cuencas intermontanas. Las inundaciones temporales se producen principalmente como respuesta a eventos de precipitación-escorrentía."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/playaSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/playa_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:prefLabel "playa setting"@en,
        "ambiente de playa endorreica"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-estuarino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> ;
    skos:definition "Environments at the seaward end or the widened funnel-shaped tidal mouth of a river valley where fresh water comes into contact with seawater and where tidal effects are evident (adapted from Glossary of Geology, Jackson, 1997, p. 217)."@en,
        "Ambientes situados en el extremo marítimo o la desembocadura mareal en forma de embudo ensanchado de un valle fluvial donde el agua dulce entra en contacto con agua de mar y donde los efectos de marea son evidentes (adaptado de Glosario de Geología, Jackson, 1997, p. 217)."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/estuarySetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/estuary_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-estuarino>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-estuarina> ;
    skos:prefLabel "estuary setting"@en,
        "ambiente estuarino"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-isla-barrera> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> ;
    skos:definition "Setting meant to include all the various geographic elements typically associated with a barrier island coastline, including the barrier islands, and geomorphic/geographic elements that are linked by processes associated with the presence of the island (e.g. wash over fans, inlet channel, back barrier lagoon)."@en,
        "Ambiente que trata de incluir los diversos elementos geográficos típicamente asociados con una costa de isla barrera, incluyendo las islas barrera y los elementos geográficos/geomorfológicos que están vinculados con los procesos asociados con la presencia de la isla (por ejemplo, abanicos de derrame, canal de entrada o grao, laguna costera o albufera)."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/barrierIslandCoastlineSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/barrier_island_coastline_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-de-barrera>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-de-barrera> ;
    skos:prefLabel "barrier island coastline setting"@en,
        "ambiente litoral de isla barrera"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-intraplaca> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "Tectonically stable setting far from any active plate margins."@en,
        "Ambiente tectónicamente estable alejado de cualquier margen activo de placa."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/intraplateTectonicSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/intraplate_tectonic_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-inactivo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-monte-submarino> ;
    skos:prefLabel "intraplate tectonic setting"@en,
        "ambiente tectónico de intraplaca"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "The ocean environment at water depths between 200 and 3500 metres."@en,
        "El ambiente marino de aguas con profundidades entre 200 y 3.500 metros."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/bathyalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/bathyal> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-inferior>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-medio>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-superior> ;
    skos:prefLabel "bathyal setting"@en,
        "ambiente batial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arrecife-biologico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "A ridgelike or moundlike structure, layered or massive, built by sedentary calcareous organisms, esp. corals, and consisting mostly of their remains; it is wave-resistant and stands topographically above the surrounding contemporaneously deposited sediment."@en,
        "Una estructura similar a una cresta o montículo, estratificada o masiva, construida por organismos sedentarios calcáreos, esp. corales, y que consiste en su mayor parte de sus restos; es resistente al oleaje y topográficamente se sitúa por encima de los sedimentos circundantes depositados simultáneamente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/biologicalReefSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/biological_reef_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-frente-arrecifal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arrecifal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-postarrecifal> ;
    skos:prefLabel "biological reef setting"@en,
        "ambiente de arrecife biológico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-elevaciones-oceanicas> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "Broad category for subaqueous marine settings characterized by significant relief above adjacent sea floor."@en,
        "Categoría amplia de ambientes marinos subacuáticos caracterizados por un relieve prominente que se eleva por encima del fondo marino adyacente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/oceanHighlandSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/ocean_highland_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-dorsal-central-oceanica>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-meseta-oceanica>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-monte-submarino> ;
    skos:prefLabel "ocean highland setting"@en,
        "ambiente de elevaciones océanicas"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "Sedimentary setting in which wind is the dominant process producing, transporting, and depositing sediment. Typically has low-relief plain or piedmont slope physiography."@en,
        "Ambiente sedimentario en el que el viento es el proceso dominante que produce, transporta y deposita los sedimentos. Normalmente presenta un relieve bajo, llano o con fisiografía de piedemonte."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/aeolianProcessSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/aeolian_process_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arenosa> ;
    skos:prefLabel "aeolian process setting"@en,
        "ambiente de procesos eólicos"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> ;
    skos:definition "Settings characterized by very low surface slope and proximity to shoreline. Generally within peritidal setting, but characterized by low surface gradients and generally low-energy sedimentary processes."@en,
        "ambientes caracterizados por una superficie de pendiente muy baja y proximidad a la costa. Generalmente dentro del ambiente perimareal, pero caracterizada por superficies de gradientes bajos y en general por los procesos sedimentarios de baja energía."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowEnergyShorelineSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/low_energy_shoreline_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-fangosa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanuras-algares>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-sabkha-marina-marginal> ;
    skos:prefLabel "low energy shoreline setting"@en,
        "ambiente litoral de baja energía"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mantelico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "The zone of the Earth below the crust and above the core, which is divided into the upper mantle and the lower mantle, with a transition zone separating them."@en,
        "La zona de La Tierra por debajo de la corteza y por encima del núcleo, que se divide en el manto superior y el manto inferior, con una zona de transición separándolos."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/mantleSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/mantle> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-inferior>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-superior> ;
    skos:prefLabel "mantle setting"@en,
        "ambiente mantélico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:definition "The ocean environment at depths between low-tide level and 200 metres, or between low-tide level and approximately the edge of the continental shelf."@en,
        "El ambiente oceánico a profundidades comprendidas entre el nivel de marea baja y 200 metros, o entre el nivel de marea baja y aproximadamente el borde de la plataforma continental."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/neriticSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/neritic> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-externo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-interno>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-medio> ;
    skos:prefLabel "neritic setting"@en,
        "ambiente nerítico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-humedales>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "Waterlogged, spongy ground, consisting primarily of mosses, containing acidic, decaying vegetation that may develop into peat."@en,
        "Suelo esponjoso y empapado en agua, principalmente consistente en musgos, que contiene vegetación ácida en descomposición que puede convertirse en turba."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/bogSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/bog> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cuenca-pantanosa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-pantanoso> ;
    skos:prefLabel "bog setting"@en,
        "ambiente pantanoso"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Setting characterized by mean annual precipitation of 10 inches (25 cm) or less. (Jackson, 1997, p. 172). Equivalent to SLTT 'Desert setting', but use 'Arid' to emphasize climatic nature of setting definition."@en,
        "Ambiente caracterizado por una precipitación media anual de 25 cm (10 pulgadas) o inferior. (Jackson, 1997, p. 172). Equivalente en sentido amplio al ambiente desertico, pero se usa 'árido' para enfatizar la naturaleza climática de la definición del ambiente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/aridOrSemiAridEnvironmentSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/arid_or_semi_arid_environment_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arenosa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-pedregosa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-endorreica>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-sabkha-marina-marginal> ;
    skos:prefLabel "arid or semi arid environment setting"@en,
        "ambiente árido o semiárido"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "The outermost layer or shell of the Earth, defined according to various criteria, including seismic velocity, density and composition; that part of the Earth above the Mohorovicic discontinuity, made up of the sial and the sima."@en,
        "La capa o envoltura más externa de La Tierra, definida de acuerdo con varios criterios, incluyendo velocidad sísmica, densidad y composición; aquella parte de La Tierra por encima de la discontinuidad de Mohorovicic, constituida por el sial y el sima."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/crustalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/crust> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-transicional> ;
    skos:prefLabel "crustal setting"@en,
        "ambiente cortical"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-placa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa> ;
    skos:definition "Divergent plate margin at which new oceanic crust is being formed."@en,
        "Margen divergente de placas en el que se está formando nueva corteza oceánica"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/activeSpreadingCenterSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/active_spreading_center> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-velocidad-media>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-rapido>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/centro-de-expansion-lenta> ;
    skos:prefLabel "active spreading center setting"@en,
        "ambiente de centro de expansión activo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "Location on gentle slope at the foot of a mountain; generally used in terms of intermontane-basin terrain. Main components include: (a) An erosional surface on bedrock adjacent to the receding mountain front (pediment, rock pediment); (b) A constructional surface comprising individual alluvial fans and interfan valleys, also near the mountain front; and (c) A distal complex of coalescent fans (bajada), and alluvial slopes without fan form. Piedmont slopes grade to basin-floor depressions with alluvial and temporary lake plains or to surfaces associated with through drainage."@en,
        "Se localiza en las suaves pendientes a los pies de una montaña; utilizado habitualmente para áreas situadas en cuencas intermontanas. Sus componentes principales incluyen: (a) Una superficie de erosión sobre lecho rocoso adyacente al frente montañoso en retroceso (pedimento, pedimento rocoso); (b) Una superficie constructiva que comprende abanicos aluviales individuales y valles inter abanico, también próxima al frente montañoso; y (c) Un complejo distal de abanicos coalescentes (bajada), y vertientes aluviales sin forma de abanico. Las vertientes del piedemonte pasan gradualmente a llanuras aluviales y lagos temporales de las depresiones del fondo de la cuenca o a superficies asociadas con el drenaje externo."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/piedmontSlopeSystemSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/piedmont_slope_system_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-aluvial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pedimento> ;
    skos:prefLabel "piedmont slope system setting"@en,
        "ambiente de sistema vertiente de piedemonte"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> ;
    skos:definition "Setting subject to tidal processes."@en,
        "Ambientes sujetos a los procesos mareales."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/tidalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/tidal_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-mareal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-mareal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-baja>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intermareal> ;
    skos:prefLabel "tidal setting"@en,
        "ambiente mareal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> ;
    skos:definition "Geologic setting dominated by a river system; river plains may occur in any climatic setting. Includes active channels, abandoned channels, levees, oxbow lakes, flood plain. May be part of an alluvial plain that includes terraces composed of abandoned river plain deposits."@en,
        "El ambiente geológico dominado por un sistema fluvial; las llanuras fluviales pueden aparecer en cualquier contexto climático. Comprende los canales activos, canales abandonados, albardones o diques naturales, lagos de meandro abandonado o galachos, llanura de inundación. Puede ser parte de una llanura aluvial que incluye terrazas formadas por los depósitos de llanuras fluviales abandonadas."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/riverPlainSystemSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/river_plain_system_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-fluvial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cauce-fluvial-abandonado>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-inundacion>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-meandro-estrangulado> ;
    skos:prefLabel "river plain system setting"@en,
        "ambiente de sistema de llanura fluvial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Setting situated in or under permanent, standing water. Used for marine and lacustrine settings, but not for fluvial settings."@en,
        "Ambiente situado en o por debajo del agua retenida permanente. Se utiliza para la ambientes marinos y lacustres, pero no para ambientes fluviales."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/subaqueousSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/subaqueous_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-mareal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-la-bahia-interdistributaria>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-prodelta>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intermareal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino> ;
    skos:prefLabel "subaqueous setting"@en,
        "ambiente subacuático"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical> ;
    skos:definition "That type of the Earth's crust which underlies the continents and the continental shelves; it is equivalent to the sial and continental sima and ranges in thickness from about 25 km to more than 70 km under mountain ranges, averaging ~40 km. The density of the continental crust averages ~2.8 g/cm3 and is ~2.7 g.cm3 in the upper layer. The velocities of compressional seismic waves through it average ~6.5 km/s and are less than ~7.0 km/sec."@en,
        "Aquel tipo de corteza terrestre que subyace a los continentes y a las plataformas continentales; es equivalente al sial y al sima continental y varía en espesor desde cerca de 25 km a más de 70 km bajo las cordilleras de montañas, con un promedio de ~40 km. La densidad promedio de la corteza continental es de ~2.8 g/cm3 y es de ~2.7 g.cm3 en la capa superior. Las velocidades promedio de las ondas sísmicas compresionales que la atraviesan son de ~6.5 km/s y son menores de  ~7.0 km/s."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/continental-crustalSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/continental_crust> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-colisional>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-antepais>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-inferior>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-media>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-superior>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-traspais> ;
    skos:prefLabel "continental-crustal setting"@en,
        "ambiente de corteza continental"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> ;
    skos:definition "Tectonic setting at the boundary between two tectonic plates."@en,
        "Ambiente tectónico en el límite entre dos placas tectónicas"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/plateMarginSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/plate_margin_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-antearco>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arco-volcanico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-borde-transformante-de-placa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-continental-activo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-zona-de-subducion> ;
    skos:prefLabel "plate margin setting"@en,
        "ambiente de margen de placa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-polar>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Earth surface setting with geography defined by spatial relationship to glaciers (e.g. on top of a glacier, next to a glacier, in front of a glacier...). Processes related to moving ice dominate sediment transport and deposition and landform development."@en,
        "Ambiente situado en la superficie terrestre definido geográficamente por su relación espacial con los glaciares (por ejemplo, encima de un glaciar, yuxtaglaciar o al lado de un glaciar, en frente de un glaciar ...). Los procesos relacionados con el hielo en movimiento dominan el transporte y deposición de sedimentos y el desarrollo de las formas de relieve."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glacierRelatedSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/glacier_related_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial-glacial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-englacial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-proglacial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subglacial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supraglacial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-yuxtaglaciar> ;
    skos:prefLabel "glacier related setting"@en,
        "ambiente relacionado con glaciares"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> ;
    skos:definition "Environments at the mouth of a river or stream that enters a standing body of water (ocean or lake). The delta forms a triangular or fan-shaped plain of considerable area. Subaerial parts of the delta are crossed by many distributaries of the main river,"@en,
        "Ambientes en la desembocadura de un río o arroyo que entra en un cuerpo permanente de agua (océano o lago). El delta constituye una llanura triangular o en forma de abanico de área considerable. La parte subaérea del delta está atravesada por numerosos cursos distributarios del río principal"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaicSystemSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/deltaic_system_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-distributario-de-delta>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-estuarino>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-lacustre>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-desembocadura-de-distributario-de-delta>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-frente-de-delta>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-la-bahia-interdistributaria>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-prodelta> ;
    skos:prefLabel "deltaic system setting"@en,
        "ambiente de sistema deltaico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:definition "Geologic environments within the solid Earth."@en,
        "Ambiente geológico dentro del planeta Tierra ."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/earthInteriorSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/earth_interior_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-baja-presion-y-alta-temperatura>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-metamorfismo-de-contacto>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-metamorfismo-regional>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-ultra-alta-presion>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-hipoabisal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mantelico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terraqueo-interno-de-alta-presion-y-baja-temperatura> ;
    skos:prefLabel "earth interior setting"@en,
        "ambiente en el interior de la Tierra"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Setting at the interface between the solid earth and the atmosphere, includes some shallow subaqueous settings in river channels and playas. Characterized by conditions and processes, such as erosion, that exist or operate in the open air on or immediately adjacent to the land surface."@en,
        "Ambiente en la interfaz entre la tierra sólida y la atmosfera, incluye algunos ambientes subacuáticos someros en cauces fluviales y playas endorreicas. Caracterizado por condiciones ambientales y procesos, como la erosión, presentes o funcionales al aire libre o inmediatamente adyacentes a la superficie terrestre."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/subaerialSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/subaerial_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cordon-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-pedregosa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-endorreica>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supramareal> ;
    skos:prefLabel "subaerial setting"@en,
        "ambiente subaéreo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Setting characterized by absence of direct marine influence. Most of the subaerial settings are also terrestrial, but lacustrine settings, while terrestrial, are not subaerial, so the subaerial settings are not included as subcategories."@en,
        "Ambiente caracterizado por la ausencia de influencia marina directa. La mayor parte de los ambientes subaéreos también son terrestres, pero los ambientes lacustres, aunque son terrestres, no son subaéreos, por lo que los ambientes subaéreos no están incluidos como una subcategoría."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/terrestrialSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/terrestrial_setting> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial-glacial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arenosa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-alta>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-pedregosa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-endorreica>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-lacustre>,
