    skos:prefLabel "terrestrial setting"@en,
        "ambiente terrestre"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:broader <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra> ;
    skos:definition "Geologic settings characterized by location adjacent to the ocean or a lake. A zone of indefinite width (may be many kilometers), bordering a body of water that extends from the water line inland to the first major change in landform features. Includes settings that may be subaerial, intermittently subaqueous, or shallow subaqueous, but are intrinsically associated with the interface between land areas and water bodies."@en,
        "Ambiente geológico caracterizado por su ubicación junto al mar o un lago. Una zona de anchura indefinida (puede tener muchos kilómetros), en borde de una masa de agua que se extiende tierra adentro desde la orilla hasta el primer cambio importante en los rasgos geomorfológicos. Comprende ambientes que pueden ser subaéreos, intermitentemente subacuático, o subacuáticos someros, pero que están intrínsecamente asociados a la interfaz entre la zona terrestre y la masa de agua."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/shorelineSetting>,
        <http://resource.geosciml.org/classifier/cgi/eventenvironment/shoreline_settings> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/evento-ambiente> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cordon-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-litoral-rocoso>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-litoral>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-estuarino>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-isla-barrera>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-dominado-por-carbonatos>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supramareal> ;
    skos:prefLabel "shoreline setting"@en,
        "ambiente litoral"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
