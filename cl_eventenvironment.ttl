<https://geo-carto.github.io/vocabularios/evento-ambiente> a skos:ConceptScheme ;
    dcterms:created "2026-03-01"^^xsd:date ;
    dcterms:creator "https://commission.europa.eu/" ;
    dcterms:description "Términos que describen el entorno geológico en el que ocurre un evento geológico. El entorno puede referirse, por ejemplo, a condiciones deposicionales, tectónicas, metamórficas o magmáticas en las que tuvo lugar el evento."@es ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-03-01"^^xsd:date ;
    dcterms:provenance "Términos originales de INSPIRE" ;
    dcterms:publisher <https://www.igme.es/> ;
    owl:versionInfo "1.0.0" ;
    skos:definition "Terms describing the geological environment in which a geological event occurs. The environment may refer, for example, to depositional, tectonic, metamorphic, or magmatic conditions under which the event took place."@en,
        "Términos que describen el entorno geológico en el que ocurre un evento geológico. El entorno puede referirse, por ejemplo, a condiciones deposicionales, tectónicas, metamórficas o magmáticas en las que tuvo lugar el evento."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Ambiente asociado a evento."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-deltaico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-acumulacion-de-polvo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-area-de-morada>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-area-minera>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manantial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-medioambiente-humano>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-plataforma-carbonatada>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-talud>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-talud-deltaico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-terrenos-agricolas-y-forestales>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-tierras-recuperadas>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-zona-de-deposicion-de-residuos-y-materiales>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-extraterrestre>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciofluvial>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciolacuste>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciomarino>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-humedo-a-subhumedo>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intracratonico>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/antecosta>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/graben>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/salina>,
        <https://geo-carto.github.io/vocabularios/evento-ambiente/semi-graben> ;
    skos:prefLabel "Event Environment"@en,
        "Ambiente asociado a evento"@es .

