{"id":"https://geo-carto.github.io/vocabularios/void-reason","type":"ConceptScheme","prefLabel":{"en":"Void Reason Value","es":"Razón de valor vacío"},"description":{"es":"Términos que describen las razones por las que un valor puede estar vacío o no proporcionado en un atributo."},"publisher":{"id":"https://www.igme.es/"},"created":"2026-03-01","modified":"2026-03-01","creator":"https://commission.europa.eu/","provenance":"Términos originales de INSPIRE","versionInfo":"1.0.0","license":{"id":"https://creativecommons.org/licenses/by/4.0/"},"hasTopConcept":[{"id":"https://geo-carto.github.io/vocabularios/void-reason/desconocido","prefLabel":{"en":"unknown","es":"desconocido"},"definition":{"en":"The correct value for the specific spatial data type is not known to, or not provided by the data provider, or the data source is not available.","es":"El valor correcto del tipo de datos específico no se conoce o no está proporcionado por la fuente de datos, o la fuente de datos no está disponible."}},{"id":"https://geo-carto.github.io/vocabularios/void-reason/no-poblado","prefLabel":{"en":"unpopulated","es":"no poblado"},"definition":{"en":"The attribute or field has not been provided or populated yet, but may be provided in the future.","es":"El campo o atributo todavía no se ha proporcionado o rellenado, pero puede ser proporcionado en el futuro."}},{"id":"https://geo-carto.github.io/vocabularios/void-reason/retenido","prefLabel":{"en":"withheld","es":"retenido"},"definition":{"en":"The value is not made publicly available for confidentiality, security, or other policy reasons.","es":"El valor no se hace público por motivos de confidencialidad, seguridad u otra política."}}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www