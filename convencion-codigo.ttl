    dcterms:provenance "Términos originales de INSPIRE" ;
    dcterms:publisher <https://www.igme.es/> ;
    dcterms:title "Convention Code"@en,
        "Código de convención"@es ;
    owl:versionInfo "1.0.0" ;
    skos:definition "Convention code used for expressing the orientation of a structural measurement."@en,
        "Código de convención utilizado para expresar la orientación de una medida estructural."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Código de convención."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/convencion-codigo/direccion-de-buzamiento>,
        <https://geo-carto.github.io/vocabularios/convencion-codigo/regla-de-la-mano-derecha> ;
    skos:prefLabel "Convention Code"@en,
        "Código de convención"@es ;
    dcat:theme "GE" .

