<https://geo-carto.github.io/vocabularios/material-igme/deposito-hemipelagico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "hemipelagita"@es ;
    skos:definition "Sediment consisting of muddy, marly or calcareous muds, deposited in the sedimentary environment comprising the continental slope and glacis"@en,
        "Sedimento constituido por lodos lutíticos, margosos o calcáreos, depositados en el medio sedimentario que comprende el talud y el glacis continental"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "hemipelagic deposit"@en,
        "depósito hemipelágico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSediment>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/mud>,
        <http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mud> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/deposito-hibrido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "sedimento híbrido"@es ;
    skos:definition "Sediment composed of three or more components, each of which constitutes between 5 and 50% of the total, and which cannot be included in any other sediment category by its composition or origin"@en,
        "Sedimento integrado por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% del mismo, y que no puede incluirse en ninguna otra categoría de sedimento por su composición u origen"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sediment> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "hybrid deposit"@en,
        "depósito híbrido"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/deposito-piroclastico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "tefra"@es ;
    skos:definition "Deposit formed, by at least 75% of its volume, by pyroclasts"@en,
        "Depósito formado, al menos en un 75% de su volumen, por piroclastos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/tephra>,
        <http://resource.geosciml.org/classifier/cgi/lithology/tephra> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pyroclastic deposit"@en,
        "depósito piroclástico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/deposito-piroclastico-de-caida> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Pyroclastic fall deposit originated by the individual fall of pyroclasts, transported along ballistic trajectories or through the horizontal dispersal of the eruptive column and deposited as a rain"@en,
        "Depósito piroclástico originado por la caída individualizada de piroclastos, transportados siguiendo trayectorias balísticas o mediante la dispersión horizontal de las columna eruptiva y depositados como una lluvia"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pyroclastic fall deposit"@en,
        "depósito piroclástico de caída"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/tephra>,
        <http://resource.geosciml.org/classifier/cgi/lithology/tephra> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/deposito-piroclastico-epiclastico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Deposit of mixed character consisting of both pyroclastic and epiclastic fragments, each in a percentage between 25 and 75% of the deposit volume"@en,
        "Depósito de carácter mixto constituido tanto por fragmentos de origen piroclástico como de origen epiclástico, ambos en un porcentaje comprendido entre el 25 y el 75% del volumen del depósito"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pyroclastic-epiclastic deposit"@en,
        "depósito piroclástico-epiclástico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/sediment>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/tephra>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/tephra> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/deposito-rico-en-materia-organica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "sedimento rico en materia orgánica"@es ;
    skos:definition "Sediment whose organic matter content is sufficiently high to have notable effects on the lithology"@en,
        "Sedimento cuyo contenido en materia orgánica es suficientemente alto como para tener efectos notables en la litología"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sediment> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "organic matter-rich deposit"@en,
        "depósito rico en materia orgánica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/deposito-siliceo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "sedimento silíceo"@es ;
    skos:definition "Sediment composed of more than 50% silica of biogenic or chemical origin. Detrital sediments are excluded"@en,
        "Sedimento compuesto en más de un 50% por sílice de origen biogénico o químico. se excluyen los sedimentos detríticos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sediment> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "siliceous deposit"@en,
        "depósito silíceo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/deposito-volcano-sedimentario> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Deposit in whose formation the participation of both volcanic and sedimentary processes is recognized"@en,
        "Depósito en cuya formación se reconoce la participación de procesos volcánicos y sedimentarios"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "volcano-sedimentary deposit"@en,
        "depósito volcano-sedimentario"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousMaterial>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_material>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/deposito-volcanoclastico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Deposit composed of at least 10% by volume of fragments of volcanic nature, regardless of the fragmentation and accumulation mechanism"@en,
        "Depósito compuesto, al menos en un 10% de su volumen, por fragmentos de naturaleza volcánica, independientemente del mecanismo de fragmentación y de acumulación"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "volcaniclastic deposit"@en,
        "depósito volcanoclástico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/compoundMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/compound_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/desdolomita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Limestone formed from a dolomite by the effect of dedolomitization"@en,
        "Caliza formada a partir de una dolomía, por efecto de la desdolomitización"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "desdolomite"@en,
        "desdolomita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/limestone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/limestone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/desecho> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Deposit of solid by-products of any nature, such as domestic or industrial waste"@en,
        "Depósito de subproductos sólidos de cualquier naturaleza, como residuos domésticos o industriales"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/waste> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "waste"@en,
        "desecho"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/diabasa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "dolerita"@es ;
    skos:definition "Subvolcanic rock, generally massive and compact, of grain size intermediate between basalt and gabbro, composed of plagioclase, pyroxene and opaque minerals, sometimes with olivine; occasionally with doleritic texture and, more frequently, ophitic texture"@en,
        "Roca subvolcánica, generalmente masiva y compacta, de tamaño de grano intermedio entre basalto y gabro, compuesta por plagioclasa, piroxeno y minerales opacos, a veces con olivino, ocasionalmente presenta textura dolerítica y, más frecuentemente, ofítica"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "diabase"@en,
        "diabasa"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/diamictita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Detrital rock containing clasts of a wide size range, from grains to boulders, surrounded by a predominantly clayey matrix"@en,
        "Roca detrítica que contiene clastos de un amplio rango de tamaños desde granos a bloques, rodeados de matriz fundamentalmente arcillosa"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/diamictite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/diamictite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "diamictite"@en,
        "diamictita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/diamicton> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Unconsolidated, poorly sorted detrital sediment containing clasts of a wide size range, from particles to boulders"@en,
        "Sedimento detrítico no consolidado y mal clasificado que contiene clastos de un amplio rango de tamaños, desde partículas hasta bloques"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/diamicton>,
        <http://resource.geosciml.org/classifier/cgi/lithology/diamicton> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "diamicton"@en,
        "diamictón"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/diatexita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Migmatite formed almost exclusively by neosome, with little or no mesosome"@en,
        "Migmatita formada casi exclusivamente por neosoma, con escaso o ningún mesosoma"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "diatexite"@en,
        "diatexita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/migmatite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/migmatite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/diatomita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "trípoli"@es ;
    skos:definition "Lightweight, light-coloured siliceous rock, generally with 50-90% porosity and formed mainly by diatom frustules"@en,
        "Roca silícea ligera, de color claro, generalmente con una porosidad del 50-90% y formada principalmente por caparazones de diatomeas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "diatomite"@en,
        "diatomita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/siliceousOoze>,
        <http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/diorita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock of intermediate composition generally formed by calcic plagioclase (andesine) and hornblende, often with biotite or augite, as well as quartz in an amount not exceeding 5% of the felsic minerals. It is the plutonic equivalent of andesite"@en,
        "Roca plutónica de composición intermedia que generalmente está formada por plagioclasa cálcica andesina y hornblenda, a menudo con biotita o augita, así como cuarzo en una cantidad que no supera el 5% de los minerales félsicos. es el equivalente plutónico de la andesita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/diorite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/diorite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "diorite"@en,
        "diorita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/diorita-con-foides> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock belonging to the group of dioritic rocks, containing feldspathoids"@en,
        "Roca plutónica perteneciente al grupo de las rocas dioríticas, que contiene feldespatoides"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingDiorite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_diorite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "foid-bearing diorite"@en,
        "diorita con foides"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/diorita-foidica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock belonging to the group of foidic dioritic rocks, in which plagioclase constitutes more than 90% of the feldspars. It is the intrusive equivalent of tephrite"@en,
        "Roca plutónica perteneciente al grupo de las rocas dioríticas foídicas, en la que la plagioclasa constituye más del 90% de los feldespatos. es el equivalente intrusivo de la tefrita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidDiorite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foid_diorite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "foidic diorite"@en,
        "diorita foídica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/diorita-nefelinica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Foid diorite in which nepheline constitutes the dominant feldspathoid"@en,
        "Diorita foídica en la que la nefelina constituye el feldespatoide dominante"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "nepheline diorite"@en,
        "diorita nefelínica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingDiorite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_diorite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/dioritoide> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Name used in the provisional description of plutonic rocks of diorite or monzodiorite type"@en,
        "Nombre utilizado en la descripción provisional de rocas plutónicas de tipo diorita o monzodiorita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/dioritoid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/dioritoid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "dioritoid"@en,
        "dioritoide"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/dioritoide-foidico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "roca diorítica foídica"@es ;
    skos:definition "Name used in the provisional description of foidic diorite and monzodiorite type rocks"@en,
        "Nombre utilizado en la descripción provisional de las rocas de tipo diorita y monzodiorita foídicas"@es ;
