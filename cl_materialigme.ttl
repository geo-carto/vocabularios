<https://geo-carto.github.io/vocabularios/material-igme/framestone> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Carbonate rock built by organisms that develop rigid frameworks, such as corals"@en,
        "Roca carbonatada construida por organismos que desarrollan armazones rígidos, como los corales"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/framestone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/framestone> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "framestone"@en,
        "framestone"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
