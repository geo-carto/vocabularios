<https://geo-carto.github.io/vocabularios/material-igme/colada-de-ceniza> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Pyroclastic flow formed predominantly by ash"@en,
        "Colada piroclástica formada mayoritariamente por cenizas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ash flow"@en,
