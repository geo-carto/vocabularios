    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/carnalita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed by the mineral of the same name, with the formula KCl, belonging to the class of chlorides, crystallizing in the orthorhombic system forming granular or nodular masses. It is colourless when pure and white with different shades when containing impurities, with vitreous to greasy lustre and varying from transparent to translucent"@en,
        "Roca formada por el mineral del mismo nombre, de fórmula kcl, perteneciente a la clase de los cloruros, que cristaliza en el sistema rómbico formando masas granudas o nodulares. es incoloro cuando es puro y de color blanco con diferentes tonalidades cuando contiene impurezas, tiene brillo vítreo a graso y varía de transparente a translúcido"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "carnallite"@en,
        "carnalita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/evaporite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/carniola> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Carbonate rock, rich in magnesium, of cavernous and massive appearance, reddish, orange or yellowish in colour"@en,
        "Roca carbonatada, rica en magnesio, de aspecto cavernoso y masivo, de color rojizo, anaranjado o amarillento"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "carniola"@en,
