    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/colada-piroclastica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Deposit originating from a dense flow of volcanic material produced in a volcanic eruption, consisting essentially of hot fragments of volcanic glass, pumice, rock fragments and gas, which moves along the slopes of a volcano and tends to accumulate in the lowest areas"@en,
        "Depósito originado por un flujo denso de material volcánico producido en una erupción volcánica y constituido esencialmente por fragmentos calientes de vidrio volcánico, pómez, fragmentos de rocas y gas, que se desplaza rasante sobre la ladera de un volcán y tiende a acumularse en las zonas más bajas del mismo"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pyroclastic flow"@en,
        "colada piroclástica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/colemanita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed by the mineral of the same name, with the formula Ca2B6O11·5H2O, belonging to the class of borates, crystallizing in the monoclinic system forming colourless or white prismatic crystals, or granular masses"@en,
        "Roca formada por el mineral del mismo nombre, de fórmula ca2b6o11.5h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema monoclínico formando cristales prismáticos incoloros o blancos, o masas granudas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "colemanite"@en,
        "colemanita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/evaporite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/comendita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Variety of peralkaline rhyolite, richer in aluminium oxide relative to ferrous oxide than pantellerite"@en,
        "Variedad de riolita peralcalina, más rica en óxido de aluminio frente a óxido ferroso que la pantellerita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "comendite"@en,
