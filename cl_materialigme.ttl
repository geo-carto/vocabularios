    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "roca gabroica foídica"@es ;
    skos:definition "Name used in the provisional description of foidic gabbro and monzogabbro type rocks"@en,
        "Nombre utilizado en la descripción provisional de las rocas de tipo gabro y monzogabro foídicos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidGabbroid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foid_gabbroid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "foidic gabbroid"@en,
