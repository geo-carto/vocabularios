<https://geo-carto.github.io/vocabularios/material-igme/intramicrita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Micritic allochemical limestone in which more than 25% of the allochems correspond to intraclasts"@en,
        "Caliza aloquímica micrítica en la que más del 25% de los aloquímicos corresponden a intraclastos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "intramicrite"@en,
