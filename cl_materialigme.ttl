    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "baritina"@es ;
    skos:definition "Rock formed by the mineral of the same name, with the formula BaSO4, belonging to the class of sulfates, crystallizing in the orthorhombic system, forming compact sparitic, fibrous or granular masses of marble-like or stalactitic appearance. It is colourless, white or yellowish and varies from transparent to opaque"@en,
        "Roca formada por el mineral del mismo nombre, de fórmula baso4, perteneciente a la clase de los sulfatos, que cristaliza en el sistema rómbico, formando masas espáticas compactas, fibrosas o granudas, de apariencia marmórea o estalactítica. es incoloro, blanco o amarillento y varía de transparente a opaco"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "barite"@en,
        "barita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/evaporite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/barro> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "lodo"@es ;
    skos:definition "Water-saturated pelitic sediment, which may include materials of other sizes in very low proportions"@en,
        "sedimento pelítico impregnado de agua, que puede incluir materiales de otros tamaños, en muy baja proporción"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/mud>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mud> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "mud"@en,
        "barro"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/basalto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Basic, subalkaline or alkaline volcanic rock, generally black, with microcrystalline or porphyritic texture, containing calcic plagioclase and pyroxene, normally augite, with or without olivine, frequently with accessory magnetite or ilmenite and, more rarely, quartz or feldspathoids. It is distinguished from andesite by the plagioclase composition (labradorite or more calcic), the absence of amphibole and its melanocratic character"@en,
        "Roca volcánica básica, subalcalina o alcalina, generalmente de color negro, con textura microcristalina o porfídica, que contiene plagioclasa cálcica y piroxeno, normalmente augita, con o sin olivino, frecuentemente presenta magnetita o ilmenita accesorias y, más raramente, cuarzo o feldespatoides. se distingue de la andesita por la composición de la plagioclasa labradorita o más cálcica, la ausencia de anfíbol y su carácter melanocrático"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/basalt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/basalt> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "basalt"@en,
        "basalto"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/basalto-alcalino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Undersaturated alkali-rich basalt, characterized by the absence of orthopyroxene and quartz, as well as by the presence of olivine, titanium-rich augite and normative nepheline"@en,
        "Basalto subsaturado rico en álcalis, caracterizado por la ausencia de ortopiroxeno y cuarzo, así como por la presencia de olivino, augita rica en titanio y nefelina normativa"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliOlivineBasalt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/alkali-olivine_basalt> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "alkaline basalt"@en,
        "basalto alcalino"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/basalto-picritico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Magnesium-rich basalt with abundant olivine and augite phenocrysts"@en,
        "Basalto rico en magnesio, con abundantes fenocristales de olivino y augita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "picritic basalt"@en,
        "basalto picrítico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/basalt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/basalt> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/basalto-toleitico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "toleíta"@es ;
    skos:definition "Low-alkali basalt with normative enstatite, plagioclase and augite, with or without olivine and, occasionally, with pigeonite"@en,
        "Basalto pobre en álcalis, con enstatita normativa, plagioclasa y augita, con o sin olivino y, en ocasiones, con pigeonita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/tholeiiticBasalt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/tholeiitic_basalt> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "tholeiitic basalt"@en,
        "basalto toleítico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/basanita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Basic or ultrabasic volcanic rock belonging to the tephrite family, black and generally porphyritic with plagioclase phenocrysts constituting more than 90% of the feldspars, clinopyroxene, feldspathoids and olivine in proportions exceeding 10% normative, generally in a microcrystalline groundmass. Its plutonic equivalent is foid gabbro"@en,
        "Roca volcánica básica o ultrabásica perteneciente a la familia de las rocas tefríticas, de color negro y textura generalmente porfídica con fenocristales de plagioclasa que constituyen más del 90% de los feldespatos, clinopiroxeno, feldespatoides y olivino en proporción superior al 10% normativo, generalmente en una matriz microcristalina. su equivalente plutónico es el gabro foídico"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/basanite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/basanite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "basanite"@en,
        "basanita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/basanita-fonolitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Basic volcanic rock belonging to the tephrite family, in which plagioclase constitutes less than 90% of the feldspars, with olivine in proportions exceeding 10% normative. Its plutonic equivalent is foid monzogabbro"@en,
        "Roca volcánica básica perteneciente a la familia de las rocas tefríticas, en la que la plagioclasa constituye menos del 90% de los feldespatos, con olivino en proporción superior al 10% normativo. su equivalente plutónico es el monzogabro foídico"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/phonoliticBasanite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_basanite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "phonolitic basanite"@en,
        "basanita fonolítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bauxita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "laterita alumínica"@es ;
    skos:definition "Highly aluminous material containing abundant aluminium hydroxides (gibbsite, less commonly boehmite, diaspore) and aluminium-substituted iron oxides or hydroxides and generally minor or negligible kaolin minerals; may contain up to 20 percent quartz. Commonly has a pisolitic or nodular texture, and may be cemented"@en,
        "Duricreta de origen residual, formada por minerales cuya composición es de hidratos de aluminio, entre los que destacan la gibbsita, la boehmita y el diásporo, que se forma por la meteorización de los feldespatos y los feldespatoides en condiciones ambientales cálidas y húmedas"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/bauxite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/bauxite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "bauxite"@en,
        "bauxita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/beforsita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Dolomitic carbonatite of medium to fine grain, generally occurring as dykes"@en,
        "Carbonatita dolomítica de grano medio a fino, que se manifiesta generalmente en forma de diques"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "bef orsite"@en,
        "beforsita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/carbonatite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/carbonatite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/benmoreita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Alkaline intermediate volcanic rock of intermediate composition, sodic variety of trachyandesite"@en,
        "Roca volcánica alcalina de composición intermedia, variedad sódica de la traquiandesita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "benmoreite"@en,
        "benmoreíta"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/andesite>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/andesite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bentonita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plastic claystone, light-coloured, composed mainly of montmorillonite (hydrated aluminium silicate) and minerals of the smectite group, normally generated by alteration of volcanic ashes"@en,
        "Roca arcillosa plástica, de color claro, compuesta principalmente por montmorillonita silicato alumínico hidratado y minerales del grupo de las esmectitas, generada normalmente por alteración de cenizas volcánicas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "bentonite"@en,
        "bentonita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/claystone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/claystone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bindstone> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Carbonate rock produced by organisms bound together during sedimentation, by the activity of encrusting and enveloping organisms"@en,
        "Roca carbonatada originada por organismos ligados entre sí durante la sedimentación, por actividad de organismos encostrantes y envolventes"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "bindstone"@en,
        "bindstone"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/boundstone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bioclasto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Clastic element derived from the hard part of an organism, present in a sedimentary rock"@en,
        "Elemento clástico procedente de la parte dura de un organismo, presente en una roca sedimentaria"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "bioclast"@en,
        "bioclasto"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bioesparita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sparitic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio exceeding 3:1"@en,
        "Caliza aloquímica esparítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides superior a 3:1"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "biosparite"@en,
        "bioesparita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/limestone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/limestone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bioesparrudita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Biosparite in which more than 25% of the allochems have a diameter exceeding 2 mm"@en,
        "Bioesparita en la que más del 25% de los aloquímicos tienen un diámetro superior a 2 mm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "biosparrudite"@en,
        "bioesparrudita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/limestone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/limestone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/biolitita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Bioclastic limestone formed by reef-building organisms, generally in life position, such as those forming in reefs"@en,
        "Caliza bioconstruida, formada por organismos en posición de vida, como las que se forman en los arrecifes"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
