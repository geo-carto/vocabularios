<https://geo-carto.github.io/vocabularios/material-igme/varva> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sediment formed by associations of laminae alternating lighter levels (silt or very fine sand) with darker levels (clay), characteristic of lacustrine environments, and whose origin is linked to seasonal climatic changes"@en,
        "Sedimento formado por asociaciones de láminas en las que alternan niveles más claros limo o arena muy fina con otros más oscuros arcilla, característico de medios lacustres, y cuyo origen va ligado a los cambios climáticos estacionales"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "varve"@en,
        "varva"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/varva-glaciolacustre> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Varve characteristic of lakes located at the head of a glacier, in which the light silt and sand laminae are deposited in summer when the lake is free of ice, while the dark clay laminae are deposited in winter when the lake is frozen"@en,
        "Varva propia de lagos localizados en la cabecera de un glaciar, en los que las láminas claras de limos y arenas se depositan en verano, cuando el lago está desprovisto de hielo, mientras que las láminas oscuras de arcilla se depositan en invierno, cuando el lago está helado"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "glaciolacustrine varve"@en,
        "varva glaciolacustre"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/vaugnerita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Monzodiorite or monzogabbro with high MgO and K2O content. Also quartz monzodiorite or quartz monzogabbro, although there are transitional terms to monzonite and monzosyenite"@en,
        "Monzodiorita o monzogabro con altos contenidos en mgo y k2o. también cuarzomonzodiorita o cuarzomonzogabro, aunque existen términos transicionales a monzonita y monzosienita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "vaugnerite"@en,
        "vaugnerita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/monzodioriticRock>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/monzogabbroicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/monzodioritic_rock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/monzogabbroic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/verita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "lamproíta con vidrio-olivino-diópsido-flogopita"@es ;
    skos:definition "Volcanic rock belonging to the lamproite family, black in colour, with phenocrysts of phlogopite, olivine and diopside in a glassy groundmass"@en,
        "Roca volcánica perteneciente a la familia de las lamproítas, de color negro, con fenocristales de flogopita, olivino y diópsido, en una matriz vítrea"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "verite"@en,
        "verita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

