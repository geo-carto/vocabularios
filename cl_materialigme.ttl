    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/hornblendita-piroxenica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Ultramafic rock consisting essentially of hornblende and, in lesser proportion, pyroxene"@en,
        "Roca ultramáfica constituida esencialmente por hornblenda y, en menor proporción, piroxeno"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
