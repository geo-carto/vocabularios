<https://geo-carto.github.io/vocabularios/material-igme/fanglomerado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sedimentary rock formed by angular materials of diverse sizes deposited in an alluvial fan, generally associated with mudflows"@en,
        "Roca sedimentaria formada por materiales angulosos de tamaños diversos, depositados en un abanico aluvial, generalmente asociados a corrientes de barro"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "fanglomerate"@en,
