    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/biopelmicrita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Micritic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio between 1:3 and 3:1"@en,
        "Caliza aloquímica micrítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides comprendida entre 1:3 y 3:1"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
