        "limo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/limo-arenoso> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Detrital sediment in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 10 and 50% and the silt-to-clay ratio exceeds 2:1"@en,
        "Sedimento detrítico en el que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 10 y el 50% y la relación de limo a arcilla es superior a 2:1"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "sandy silt"@en,
        "limo arenoso"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/silt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/silt> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

