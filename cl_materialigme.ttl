<https://geo-carto.github.io/vocabularios/material-igme/pizarra> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Very fine-grained metamorphic rock exhibiting slaty cleavage, formed from mudstones under conditions of very low metamorphic grade"@en,
        "Roca metamórfica de grano muy fino que presenta una esquistosidad pizarrosa, formada a partir de lutitas bajo condiciones de grado metamórfico muy bajo"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/slate>,
