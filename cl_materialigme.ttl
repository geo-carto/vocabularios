<https://geo-carto.github.io/vocabularios/material-igme/halita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "sal, sal gema"@es ;
    skos:definition "Rock formed by the mineral of the same name, with the formula NaCl, belonging to the class of chlorides, crystallizing in the cubic system, frequently in the form of cubes. It is colourless or white with different shades, with vitreous lustre, varying from transparent to translucent and characterized by its salty taste"@en,
        "Roca formada por el mineral del mismo nombre, de fórmula nacl, perteneciente a la clase de los cloruros, que cristaliza en el sistema cúbico, frecuentemente en forma de cubos. es incoloro o blanco con diferentes tonalidades, tiene brillo vítreo, varía de transparente a translúcido y se caracteriza por su sabor salado"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/rockSalt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/rock_salt> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "halite"@en,
        "halita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

