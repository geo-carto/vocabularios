        "porcelanita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/porfido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Subvolcanic or dyke rock of porphyritic texture, containing quartz or feldspar phenocrysts enclosed in a glassy or microcrystalline groundmass"@en,
        "Roca subvolcánica o filoniana de textura porfídica, que contiene fenocristales de cuarzo o feldespato, incluidos en una matriz vítrea o microcristalina"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/porphyry>,
        <http://resource.geosciml.org/classifier/cgi/lithology/porphyry> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "porphyry"@en,
        "pórfido"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/protocataclasita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Cataclastic rock whose matrix constitutes less than 50% of the rock volume"@en,
        "Roca cataclástica cuya matriz constituye menos del 50% del volumen de la roca"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries>,
        <http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "protocataclasitee"@en,
        "protocataclasita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/protomilonita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mylonitic rock whose matrix constitutes less than 50% of the rock volume"@en,
        "Roca milonítica cuya matriz constituye menos del 50% del volumen de la roca"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "protomylonite"@en,
        "protomilonita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/pseudotaquilita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Glassy-appearing, extra-fine-grained, black cataclastic rock, originating as a consequence of partial melting due to the heat generated by friction of rocks sliding along a fault surface. Its formation may also be due to meteorite impact"@en,
        "Roca cataclástica de aspecto vítreo, grano extrafino y color negro, originada como consecuencia de la fusión parcial debida al calor generado por el rozamiento de las rocas al deslizarse a lo largo de una superficie de falla. su formación puede deberse también al impacto de un meteorito"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pseudotachylite"@en,
        "pseudotaquilita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries>,
        <http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/pudinga> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Conglomerate consisting of rounded pebbles"@en,
        "Conglomerado constituido por cantos rodados"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pudding stone"@en,
        "pudinga"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/radiolarita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Siliceous rock, generally with 50-90% porosity, formed mainly by radiolarian skeletons. It is frequently coloured red or red-violet by iron oxides"@en,
        "Roca silícea, generalmente con una porosidad del 50-90%, formada principalmente por esqueletos de radiolarios. frecuentemente se encuentra coloreada de rojo o rojo-violáceo por óxidos de hierro"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "radiolarite"@en,
        "radiolarita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/relleno> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Earthy materials used mainly to improve, level or raise the ground surface"@en,
        "Materiales térreos que se usan principalmente para mejorar, nivelar o elevar la superficie del terreno"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "fill"@en,
        "relleno"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicUnconsolidatedMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_unconsolidated_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/riodacita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock of intermediate composition between rhyolite and dacite, with quartz, potassic feldspar and plagioclase as principal constituents"@en,
        "Roca de composición intermedia entre riolita y dacita, con cuarzo, feldespato potásico y plagioclasa como constituyentes principales"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "rhyodacite"@en,
        "riodacita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/dacite>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/dacite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/rhyolite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/riolita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Leucocratic volcanic rock belonging to the rhyolitic rock family, of fluidal texture, composed mainly of quartz and alkali feldspar crystals constituting between 35 and 90% of the feldspars, with lesser amounts of biotite and plagioclase, in a glassy or microcrystalline groundmass; may contain amphibole and, in hyperalkaline varieties, alkalic pyroxene. Its plutonic equivalent is granite"@en,
        "Roca volcánica leucocrática, perteneciente a la familia de las rocas riolíticas, de textura fluidal, compuesta principalmente por cristales de cuarzo y feldespato alcalino, que constituye entre el 35 y el 90% de los feldespatos, con cantidades menores de biotita y plagioclasa, en una matriz vítrea o microcristalina, puede contener anfíbol y, en las variedades hiperalcalinas, piroxeno alcalino. su equivalente plutónico es el granito"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/rhyolite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "rhyolite"@en,
        "riolita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/riolita-de-feldespato-alcalino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Leucocratic volcanic rock of the rhyolitic rock family, in which alkali feldspar constitutes more than 90% of the total feldspars. Its plutonic equivalent is alkali feldspar granite"@en,
        "Roca volcánica leucocrática de la familia de las rocas riolíticas, en la que el feldespato alcalino constituye más del 90% del total de los feldespatos. su equivalente plutónico es el granito de feldespato alcalino"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparRhyolite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_rhyolite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "alkali feldspar rhyolite"@en,
        "riolita de feldespato alcalino"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/ritmita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Facies consisting of repeated alternations of strata of two different rock types"@en,
        "Facies constituida por la alternancia repetida de estratos de dos tipos de rocas diferentes"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "rhythmite"@en,
        "ritmita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Solid, compacted material of natural origin formed, in most cases, by an association of minerals of the same or different species; exceptionally, some volcanic rocks may consist of minerals and glass or of glass only"@en,
        "Material sólido y compactado de origen natural formado, en la mayor parte de los casos, por una asociación de minerales de la misma o de distintas especies, excepcionalmente, algunas rocas volcánicas pueden estar constituidas por minerales y vidrio o solamente por vidrio"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/rock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "rock"@en,
        "roca"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-acida> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock containing more than 66% silica"@en,
        "Roca ígnea que contiene más del 66% de sílice"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/acidicIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/acidic_igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "acidic rock"@en,
        "roca ácida"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-afanitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "afanita"@es ;
    skos:definition "Igneous rock in which mineral grains are not distinguishable with the naked eye"@en,
        "Roca ígnea en la que los granos minerales no se distinguen a simple vista"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/aphanite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/aphanite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "aphanitic rock"@en,
        "roca afanítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-alcalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock with a high concentration of alkalis Na2O, K2O that cannot be accommodated exclusively in the feldspars. This excess causes the formation of feldspathoids, pyroxenes and/or sodic amphiboles, as well as other phases rich in these elements. This definition is somewhat strict and it is common to use the term 'alkaline' for rocks that simply have high Na2O and K2O contents for given SiO2 contents"@en,
        "Roca ígnea con una elevada concentración de álcalis na2o, k2o que no puede ser acomodada exclusivamente en los feldespatos. este exceso hace que se formen feldespatoides, piroxenos y/o anfíboles sódicos, así como otras fases ricas en estos elementos. esta definición es algo estricta y es frecuente el uso del término “alcalino/a” para rocas que simplemente tienen elevados contenidos de na2o y k2o para determinados contenidos de sio2"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "alkaline rock"@en,
        "roca alcalina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-andesitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Intermediate, calc-alkaline volcanic/subvolcanic rock, composed mainly of plagioclase, pyroxene and amphibole, and possibly including lesser amounts of biotite, olivine or quartz"@en,
        "Roca volcánica/subvolcánica intermedia, calcoalcalina, constituida principalmente por plagioclasa, piroxeno y anfíbol, pudiendo incluir cantidades menores de biotita, olivino o cuarzo"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "andesitic rock"@en,
        "roca andesítica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/andesite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/andesite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-anortositica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Leucocratic plutonic rock in which plagioclase constitutes more than 90% of the rock, with pyroxene being its most common mafic mineral"@en,
        "Roca plutónica leucocrática en la que la plagioclasa constituye más del 90% de la roca, siendo el piroxeno su mineral máfico más frecuente"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/anorthositicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/anorthositic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "anorthositic rock"@en,
        "roca anortosítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-basaltica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Dark, basic, subalkaline or alkaline volcanic rock, composed mainly of plagioclase constituting more than 65% of the feldspars, pyroxene and, occasionally, olivine, and possibly including lesser amounts of quartz or feldspathoids"@en,
        "Roca volcánica oscura, básica, subalcalina o alcalina, compuesta principalmente por plagioclasa, que constituye más del 65% de los feldespatos, piroxeno y, en ocasiones, olivino, pudiendo incluir cantidades menores de cuarzo o feldespatoides"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/basalt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/basalt> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "basaltic rock"@en,
        "roca basáltica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-basica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock whose silica content is between 45 and 52%"@en,
        "Roca ígnea cuyo contenido en sílice está comprendido entre el 45 y el 52%"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/basicIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/basic_igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "basic rock"@en,
        "roca básica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-biogenica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock produced by the action or presence of living organisms or their remains"@en,
        "Roca producida por la acción o la presencia de organismos vivos o de sus restos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "biogenic rock"@en,
        "roca biogénica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSilicaSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/biogenic_silica_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-biogenica-silicea> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sedimentary rock composed of at least 50% siliceous mineral material deposited as a result of biological processes"@en,
        "Roca sedimentaria compuesta, al menos en un 50%, por material mineral silíceo sedimentado como resultado de procesos biológicos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSilicaSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/biogenic_silica_sedimentary_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "biogenic siliceous rock"@en,
        "roca biogénica silícea"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-calcarea> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sedimentary carbonate rock whose principal constituent is calcium carbonate; of the remaining components, magnesium carbonate is the most frequent and dominant, with silicates or their alteration products (clay and silica) as well as pyrite and siderite being accessory. The pure variety has at least 95% CaCO3 and the impure varieties more than 10% dolomite or impurities. Its origin may be predominantly biological, chemical or mixed"@en,
        "Roca sedimentaria carbonatada cuyo constituyente principal es el carbonato cálcico, de los componentes restantes, el más frecuente y dominante es el carbonato de magnesio, siendo accesorios los silicatos o los productos de su alteración como arcillas y sílice, así como la pirita y la siderita. la variedad pura tiene, al menos, un 95% de caco3 y las variedades impuras, más del 10% de dolomita o de impurezas. su origen puede ser predominantemente biológico, químico o mixto"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sedimentary_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "calcareous rock"@en,
        "roca calcárea"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-calcoalcalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock forming part of a suite of generally basic-intermediate rocks. It is characterized by being saturated or oversaturated in silica, with a Peacock index between 56 and 61, and by maintaining the Fe/Fe+Mg ratio relatively constant throughout the differentiation sequence"@en,
        "Roca ígnea que forma parte de una suite de rocas generalmente básico-intermedias. se caracteriza por ser saturada o sobresaturada en sílice, con índice de peacok entre 56 y 61, y por mantener la relación fe/fe+mg relativamente constante a lo largo de la secuencia de diferenciación"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "calc-alkaline rock"@en,
        "roca calcoalcalina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-carbonatada-lutitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Carbonate rock with a mudstone content between 10 and 50% of the total"@en,
        "Roca carbonatada con un contenido lutítico comprendido entre el 10 y el 50% del total"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateMudstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mudstone> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "lutaceous carbonate rock"@en,
        "roca carbonatada lutítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-cataclastica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Cohesive fault rock, without tectonic foliation or with poorly developed foliation, consisting of porphyroclasts, usually angular, and rock fragments embedded in a matrix of similar composition, produced by brittle deformation with crystal grain size reduction and slightly recrystallized. Some authors propose that the matrix content should exceed 30%"@en,
        "Roca de falla cohesiva, sin foliación tectónica o con un desarrollo pobre de ella y constituida por porfiroclastos, habitualmente angulosos, y fragmentos de roca embebidos en una matriz de composición similar, producida por deformación frágil con reducción del tamaño de grano cristalino y ligeramente recristalizada. algunos autores proponen que el contenido en matriz debe ser superior al 30%"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries>,
        <http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "cataclastic rock"@en,
        "roca cataclástica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-charnoquitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Anhydrous igneous or igneous-derived rock, generally of acid-intermediate composition, with orthopyroxene as the principal mafic mineral, with absent or scarce hydrated minerals such as micas or amphiboles"@en,
        "Roca ígnea o ígnea-derivada anhidra, generalmente de composición ácida-intermedia, con ortopiroxeno como mineral máfico principal, sin o con escasos minerales hidratados como micas o anfíboles"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "charnockitic rock"@en,
        "roca charnoquítica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granulite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granulite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-clastica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "roca detrítica"@es ;
    skos:definition "Rock composed of more than 50% fragments from pre-existing rocks and minerals"@en,
        "Roca compuesta en más de un 50% por fragmentos de otras rocas y minerales preexistentes"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "clastic rock"@en,
        "roca clástica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-criptocristalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock that has crystals perceptible only by electron microscopy"@en,
        "Roca ígnea que tiene cristales solamente perceptibles mediante microscopio electrónico"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "cryptocrystalline rock"@en,
        "roca criptocristalina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fineGrainedIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fine_grained_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-dacitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Acid, subalkaline or alkaline volcanic rock whose principal components are quartz, constituting between 20 and 60% of the felsic minerals, and plagioclase, constituting more than 65% of the feldspars"@en,
        "Roca volcánica ácida, subalcalina o alcalina, cuyos componentes principales son el cuarzo, que constituye entre el 20 y el 60% de los minerales félsicos, y la plagioclasa, que constituye más del 65% de los feldespatos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/dacite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/dacite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "dacitic rock"@en,
        "roca dacítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-de-falla> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed as a result of deformation in a fault zone"@en,
        "Roca formada como resultado de la deformación en una zona de falla"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "fault rock"@en,
        "roca de falla"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-de-fundido-de-impacto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock consisting, in at least 50% of its volume, of material resulting from the solidification of a melt produced by an impact"@en,
        "Roca constituida, al menos en un 50% de su volumen, por material resultante de la solidificación de un fundido producido por un impacto"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "impact melt rock"@en,
        "roca de fundido de impacto"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/impactGeneratedMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/impact_generated_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-de-impacto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "impactita"@es ;
    skos:definition "Any material produced by the impact of an extraterrestrial body"@en,
        "Cualquier material producido por el impacto de un cuerpo extraterrestre"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/impactGeneratedMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/impact_generated_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "impact rock"@en,
        "roca de impacto"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-de-silicatos-calcicos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Metamorphic rock derived from impure carbonate rocks or marls, consisting fundamentally of calcium silicates such as epidote, zoisite, vesuvianite, diopside, actinolite, hornblende, calcic garnet, wollastonite, anorthite or scapolite"@en,
        "Roca metamórfica derivada de rocas carbonatadas impuras o margas, constituida fundamentalmente por silicatos con calcio, como epidota, zoisita, vesubianita, diópsido, actinolita, hornblenda, granate cálcico, wollastonita, anortita o escapolita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "calc-silicate rock"@en,
        "roca de silicatos cálcicos"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-dioritica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Dioritoid in which plagioclase, predominantly calcic, constitutes more than 90% of the feldspars"@en,
        "Dioritoide en el que la plagioclasa, predominantemente cálcica, constituye más del 90% de los feldespatos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/dioriticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/dioritic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "dioritic rock"@en,
        "roca diorítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-doleritica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Dark subvolcanic rock of gabbroic-basaltic or dioritic-andesitic composition, generally massive and compact, of grain size intermediate between basalt and gabbro, composed of plagioclase, pyroxene and opaque minerals, sometimes with olivine; occasionally with doleritic texture and, more frequently, ophitic texture. Includes dolerite, microdiorite, diabase and microgabbro"@en,
        "Roca subvolcánica oscura de composición gabroica basáltica o diorítica andesítica, generalmente masiva y compacta, de tamaño de grano intermedio entre basalto y gabro, compuesta por plagioclasa, piroxeno y minerales opacos, a veces con olivino, ocasionalmente presenta textura dolerítica y, más frecuentemente, ofítica. incluye a dolerita, microdiorita, diabasa y microgabro"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "doleritic rock"@en,
        "roca dolerítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-dolomitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sedimentary carbonate rock whose principal constituents are dolomite or carbonates of similar composition. The pure variety has at least 95% dolomite and the impure varieties more than 10% calcite or impurities. It originates by chemical precipitation (primary dolomite) or, more frequently, during diagenesis (secondary dolomite)"@en,
        "roca sedimentaria carbonatada cuyos constituyentes principales son la dolomita o carbonatos de composición parecida. la variedad pura tiene, al menos, un 95% de dolomita y las variedades impuras, más del 10% de calcita o de impurezas. se origina por precipitación química dolomía primaria o, más frecuentemente, durante la diagénesis dolomía secundaria"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/dolomiticOrMagnesianSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "dolomitic rock"@en,
        "roca dolomítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-epiclastica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "epiclastita"@es ;
    skos:definition "Volcaniclastic rock containing volcanic fragments showing evidence of having been transported by some sedimentary medium"@en,
        "Roca volcanoclástica que contiene fragmentos de origen volcánico con evidencias de haber sido transportados por algún medio sedimentario"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "epiclastic rock"@en,
        "roca epiclástica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-evaporitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed by chemical precipitation of non-carbonate salts, mainly sulfates, chlorates and borates"@en,
        "Roca formada a partir de la precipitación química de sales no carbonatadas, principalmente por sulfatos, cloratos y boratos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/evaporite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "evaporitic rock"@en,
        "roca evaporítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-exotica-alcalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mafic or ultramafic potassic igneous rock, whose olivine (frequently serpentinized in kimberlite) and phlogopite content is significant. Includes kimberlite, lamproite and lamprophyre"@en,
        "Roca ígnea potásica máfica o ultramáfica, cuyo contenido en olivino frecuentemente serpentinizado en la kimberlita y flogopita es significativo. incluye la kimberlita, la lamproíta y el lamprófido"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "exotic alkaline rock"@en,
        "roca exótica alcalina"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-faneritica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock in which mineral grains are distinguishable with the naked eye"@en,
        "Roca ígnea en la que los granos minerales se distinguen a simple vista"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/phaneriticIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "phaneritic rock"@en,
        "roca fanerítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-felsica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock whose content of quartz and light-coloured minerals feldspar and plagioclase exceeds 50% by volume"@en,
        "Roca cuyo contenido en cuarzo y minerales de color claro feldespato y plagioclasa es superior al 50% en volumen"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "felsic rock"@en,
        "roca félsica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-foidica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "foiditoide"@es ;
    skos:definition "Name used in the provisional description of basic or ultrabasic, ultraalkaline volcanic rocks in which feldspathoids represent more than 60% of the total felsic minerals, containing lesser amounts of ferromagnesian minerals, such as pyroxene and, occasionally, amphibole"@en,
        "nombre utilizado en la descripción provisional de rocas volcánicas básicas o ultrabásicas, ultraalcalinas, en las que los feldespatoides representan más del 60% del total de los minerales félsicos, contienen cantidades menores de minerales ferromagnesianos, como piroxeno y, en ocasiones, anfíbol"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foiditoid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foiditoid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "foidic rock"@en,
        "roca foídica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-foliada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Metamorphic rock in which at least 10% of its mineral components exhibit a planar or linear fabric. Cataclastic or glassy nature excludes classification under this concept"@en,
        "Roca metamórfica en la que al menos el 10% de sus componentes minerales tienen una fábrica planar o linear. la naturaleza cataclástica o vítrea excluyen la clasificación bajo este concepto"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foliatedMetamorphicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foliated_metamorphic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "foliated rock"@en,
        "roca foliada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-fonolitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "fonolitoide"@es ;
    skos:definition "Name used in the provisional description of basic or intermediate, strongly alkaline volcanic rocks, composed essentially of feldspars, of which alkali feldspar constitutes more than 50%, and feldspathoids, constituting between 10% and 60% of the felsic minerals, containing lesser amounts of ferromagnesian minerals, such as pyroxene and, occasionally, amphibole"@en,
        "Nombre utilizado en la descripción provisional de rocas volcánicas básicas o intermedias, fuertemente alcalinas, compuestas esencialmente por feldespatos, de los que el feldespato alcalino constituye más del 50%, y feldespatoides, que constituyen entre el 10% y el 60% de los minerales félsicos, contienen cantidades menores de minerales ferromagnesianos, como piroxeno y, en ocasiones, anfíbol"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/phonolitoid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/phonolitoid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "phonolitic rock"@en,
        "roca fonolítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-gabroica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Melanocratic gabbroid in which plagioclase, predominantly calcic, constitutes more than 90% of the feldspars"@en,
        "Gabroide melanocrato en el que la plagioclasa, predominantemente cálcica, constituye más del 90% de los feldespatos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "gabbroic rock"@en,
        "roca gabroica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-granitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "granitoide"@es ;
    skos:definition "Name used in the provisional description of plutonic rocks whose essential minerals are quartz, alkali feldspar and/or plagioclase, tentatively identified as granite, granodiorite and tonalite"@en,
        "Nombre utilizado en la descripción provisional de rocas plutónicas que tienen como minerales esenciales cuarzo, feldespato alcalino y/o plagioclasa, tentativamente identificadas como granito, granodiorita y tonalita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granitoid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granitoid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "granitic rock"@en,
        "roca granítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-granoblastica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "granoblastita, granofelsita"@es ;
    skos:definition "Granular, non-foliated, massive metamorphic rock of any composition"@en,
        "Roca metamórfica granuda, no foliada y masiva, de cualquier composición"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granofels>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granofels> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "granoblastic rock"@en,
        "roca granoblástica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-hialocristalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock formed by crystals and glass"@en,
        "Roca ígnea formada por cristales y vidrio"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "hyalocrystalline rock"@en,
        "roca hialocristalina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/glassRichIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/glass_rich_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-hidrotermal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock whose characteristics are the result of the action of hydrothermal solutions"@en,
        "Roca cuyas características son el resultado de la acción de soluciones hidrotermales"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "hydrothermal rock"@en,
        "roca hidrotermal"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-holocristalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock formed exclusively by crystals"@en,
        "Roca ígnea formada exclusivamente por cristales"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "holocrystalline rock"@en,
        "roca holocristalina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/phaneriticIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-ignea> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "roca magmática"@es ;
    skos:definition "Rock resulting from the cooling and solidification of a magma. It can be volcanic or plutonic, depending on whether it is emplaced at the surface or in the interior of the Earth's crust"@en,
        "Roca resultante del enfriamiento y la solidificación de un magma. puede ser volcánica o plutónica, según se emplace en la superficie o en el interior de la corteza terrestre"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "igneous rock"@en,
        "roca ígnea"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-ignea-exotica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock with uncommon mineralogical, textural or outcrop characteristics, including: a melilite or leucite content greater than 10%, the presence of kalsilite, or a carbonate mineral percentage exceeding 50%. Generally dark and with abundant phenocrysts, it includes carbonatites, kalsilitic and melilitic rocks, kimberlites, lamproites, leucitites and lamprophyres"@en,
        "Roca ígnea con características mineralógicas, texturales o de afloramiento poco comunes, entre las que se encuentran: un contenido mayor del 10% de melilita o leucita, la presencia de kalsilita o un porcentaje superior al 50% de minerales carbonatados. generalmente oscura y con abundantes fenocristales, incluye las carbonatitas, rocas kalsilíticas y melilíticas, kimberlitas, lamproítas, leucititas y los lamprófidos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/exoticCompositionIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/exotic_composition_igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "exotic igneous rock"@en,
        "roca ígnea exótica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-ignea-fragmentaria> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock consisting of more than 75% fragments produced by igneous processes. Includes pyroclastic rocks and intrusive and volcanic breccias"@en,
        "Roca ígnea constituida en más del 75% por fragmentos producidos por procesos ígneos. incluye a las rocas piroclásticas y las brechas intrusivas y volcánicas"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "fragmental igneous rock"@en,
        "roca ígnea fragmentaria"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-intermedia> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock whose silica content is between 52 and 66%"@en,
        "Roca ígnea cuyo contenido en sílice está comprendido entre el 52 y el 66%"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/intermediateCompositionIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/intermediate_composition_igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "intermediate rock"@en,
        "roca intermedia"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-intrusiva> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "roca plutónica"@es ;
    skos:definition "Igneous rock solidified in the interior of the Earth's crust from a silicate magma. Plutonic rocks are generally medium- to coarse-grained, although they may have related fine-grained facies"@en,
        "Roca ígnea solidificada en el interior de la corteza terrestre, a partir de un magma silicatado. las rocas plutónicas son generalmente de grano medio-grueso, aunque pueden tener facies de grano fino relacionadas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "intrusive rock"@en,
        "roca intrusiva"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/phaneriticIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-kalsilitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock containing kalsilite, in addition to clinopyroxene, olivine, melilite, leucite or phlogopite"@en,
        "Roca ígnea que contiene kalsilita, además de clinopiroxeno, olivino, melilita, leucita o flogopita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "kalsilitic rock"@en,
        "roca kalsilítica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-kalsilitica-melilitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Undersaturated, generally mafic or ultramafic igneous rock, containing more than 10% kalsilite (kalsilitic rock) or melilite (melilitic rock)"@en,
        "Roca ígnea subsaturada, generalmente máfica o ultramáfica, que contiene más de un 10% de kalsilita roca kalsilítica o melilita roca melilítica"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "kalsilitic-melilitic rock"@en,
        "roca kalsilítica-melilítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-komatiitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Ultramafic volcanic rock formed from very high-temperature magmas, with a SiO2 content of 30-52%, more than 18% MgO and less than 2% Na2O+K2O. It exhibits spinifex textures formed by elongated dendritic crystals of olivine, resulting from very rapid cooling"@en,
        "Roca volcánica ultramáfica formada a partir de magmas de muy alta temperatura, con un contenido en sio2 del 30-52%, mayor del 18% en mgo y menor del 2% en na2o+k2o. presenta texturas spinifex formadas por cristales alargados y dendríticos de olivino, resultado de un enfriamiento muy rápido"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/komatiiticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/komatiitic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "komatiitic rock"@en,
        "roca komatiítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-lamproitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "lamproíta"@es ;
    skos:definition "Basaltic to basanitic rock of ultrapotassic composition. Its mineralogy varies considerably; phlogopite, olivine, diopside, richterite, sanidine and leucite (the latter two only in the groundmass) are frequent; it may also contain very uncommon potassic minerals such as Ti-K-richterite, priderite, wadeite and gepite"@en,
        "Roca basáltica a basanítica de composición ultrapotásica. su mineralogía varía considerablemente, siendo frecuente la presencia de flogopita, olivino, diópsido, richterita, sanidina y leucita, los dos últimos sólo en la matriz, también puede contener minerales potásicos muy poco frecuentes como ti-k-richterita, priderita, wadeíta y gepita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "lamproitic rock"@en,
        "roca lamproítica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-latitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Intermediate, alkaline volcanic rock belonging to the group of trachytoids, in which alkali feldspar and plagioclase are in similar proportions, between 35 and 65% of the feldspars"@en,
        "Roca volcánica intermedia, alcalina, perteneciente al grupo de los traquitoides, en la que el feldespato alcalino y la plagioclasa se encuentran en proporciones similares, entre el 35 y el 65% de los feldespatos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "latitic rock"@en,
        "roca latítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-leucocratica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock with a content of dark minerals below 35% by volume"@en,
        "Roca ígnea con un contenido en minerales oscuros inferior al 35% en volumen"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "leucocratic rock"@en,
        "roca leucocrática"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-madre> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "substrato rocoso"@es ;
    skos:definition "General term to designate the solid rock underlying soil or other unconsolidated material exposed at the Earth's surface"@en,
        "Término general para designar la roca sólida que subyace a un suelo u otro material no consolidado expuesto en la superficie terrestre"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "bedrock"@en,
        "roca madre"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/compoundMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/compound_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-mafica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock with a dark mineral content between 50 and 90% by volume"@en,
        "Roca con un contenido de minerales oscuros comprendido entre el 50 y el 90% en volumen"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "mafic rock"@en,
        "roca máfica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-melanocratica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock with a dark mineral content between 65% and 90% by volume"@en,
        "Roca ígnea con un contenido en minerales oscuros comprendido entre el 65% y el 90% en volumen"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "melanocratic rock"@en,
        "roca melanocrática"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-melilitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "melilitoide"@es ;
    skos:definition "Ultrabasic, ultraalkaline igneous rock having melilite in proportions exceeding 10%, pyroxene and, frequently, olivine and nepheline as essential minerals. In plutonic facies it is called melilitolite and in volcanic facies, melilitite if melilite is more abundant than the feldspathoids; otherwise it is called melilite-bearing foidite"@en,
        "Roca ígnea ultrabásica y ultraalcalina que tiene como minerales esenciales melilita en proporción superior al 10%, piroxeno y, con frecuencia, olivino y nefelina. en facies plutónicas recibe el nombre de melilitolita y en facies volcánicas, el de melilitita si la melilita es más abundante que los feldespatoides, en caso contrario, se denomina foidita con melilita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "melilitic rock"@en,
        "roca melilítica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-mesocratica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock with a dark mineral content between 35% and 65% by volume"@en,
        "Roca ígnea con un contenido en minerales oscuros comprendido entre el 35% y el 65% en volumen"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "mesocratic rock"@en,
        "roca mesocrática"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-metaignea> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "roca ortoderivada"@es ;
    skos:definition "Metamorphic rock whose protolith is an igneous rock"@en,
        "Roca metamórfica cuyo protolito es una roca ígnea"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "meta-igneous rock"@en,
        "roca metaígnea"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-metaluminosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock whose alumina saturation index Al2O3/K2O+Na2O+CaO, in molar proportions, and agpaitic index [Na2O+K2O/Al2O3, in molar proportions] are less than unity. It usually contains calcium-rich minerals such as hornblende, augite or epidote"@en,
        "Roca cuyos índices de saturación en alúmina al2o3/k2o+na2o+cao, en proporciones molares y agpaítico [na2o+k2o/al2o3, en proporciones molares] son menores que la unidad. suele tener minerales ricos en calcio como hornblenda, augita o epidota"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "metaluminous rock"@en,
        "roca metaluminosa"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-metamorfica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock derived from a pre-existing rock, through mineralogical, chemical or structural changes, essentially in solid state and without significantly changing the overall chemical composition of the rock, in response to physicochemical variations, mainly of pressure and temperature, excluding rocks derived from weathering or soil-forming processes"@en,
        "Roca derivada de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales, esencialmente en estado sólido y sin cambiar significativamente la composición química del conjunto de la roca, en respuesta a variaciones físico-químicas, principalmente de presión y temperatura, quedando excluidas las rocas derivadas de procesos de meteorización o formación de suelos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "metamorphic rock"@en,
        "roca metamórfica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-metasomatica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock derived from a metamorphic process in which an important change in the chemical composition of the rock subject to metamorphism occurs, due to interaction with hydrothermal fluids or magmas"@en,
        "Roca derivada de un proceso metamórfico por el que se produce un cambio importante en la composición química de la roca sujeta a metamorfismo, debido a interacción con fluidos hidrotermales o magmas"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "metasomatic rock"@en,
        "roca metasomática"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-microcristalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock that has crystals identifiable under the microscope"@en,
        "Roca ígnea que tiene cristales identificables al microscopio"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "microcrystalline rock"@en,
        "roca microcristalina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fineGrainedIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fine_grained_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-milonitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Cohesive, strongly foliated fault rock, usually with a marked mineral lineation on foliation surfaces. It consists essentially of elongated ribbon-shaped grains embedded in a matrix of small grains of the same mineral composition, which results from dynamic recrystallization"@en,
        "Roca de falla cohesiva, fuertemente foliada y habitualmente con una marcada lineación de minerales sobre las superficies de foliación. está constituida esencialmente por granos alargados con forma de tiras embebidos en una matriz de pequeños granos de la misma composición mineral, que es el resultado de una recristalización dinámica"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "mylonitic rock"@en,
        "roca milonítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-monzodioritica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mesocratic dioritoid in which plagioclase, predominantly sodic, constitutes between 65 and 90% of the feldspars"@en,
        "Dioritoide mesocrato en el que la plagioclasa, predominantemente sódica, constituye entre el 65 y el 90% de los feldespatos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/monzodioriticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/monzodioritic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "monzodioritic rock"@en,
        "roca monzodiorítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-monzogabroica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mesocratic gabbroid in which plagioclase, predominantly calcic, constitutes between 65 and 90% of the feldspars"@en,
        "Gabroide mesocrato en el que la plagioclasa, predominantemente cálcica, constituye entre el 65 y el 90% de los feldespatos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/monzogabbroicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/monzogabbroic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "monzogabbroic rock"@en,
        "roca monzogabroica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-monzonitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Syenitoid in which alkali feldspar and plagioclase are in similar proportions (35-65% of feldspars), with clinopyroxene being prominent among the mafic components. It is the intrusive equivalent of latitic rock"@en,
        "Sienitoide en el que el feldespato alcalino y la plagioclasa se encuentran en proporciones similares 35-65% de los feldespatos, destacando el clinopiroxeno entre los componentes máficos. es el equivalente intrusivo de la roca latítica"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/monzoniticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/monzonitic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "monzonitic rock"@en,
        "roca monzonítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-peralcalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock with an agpaitic index [Na2O+K2O/Al2O3, in molar proportions] greater than unity. It usually contains alkali-rich and aluminium-poor minerals, such as sodic pyroxenes or amphiboles"@en,
        "Roca con un índice agpaítico [na2o+k2o/al2o3, en proporciones molares] mayor que la unidad. suele tener minerales ricos en álcalis y pobres en aluminio, como piroxenos o anfíboles sódicos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "peralkaline rock"@en,
        "roca peralcalina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-peraluminosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock with an alumina saturation index Al2O3/K2O+Na2O+CaO, in molar proportions, greater than unity. It usually contains aluminium-rich minerals such as muscovite, cordierite, sillimanite, garnet, tourmaline and/or andalusite"@en,
        "Roca con un índice de saturación en alúmina al2o3/k2o+na2o+cao, en proporciones molares mayor que la unidad. suele tener minerales ricos en aluminio como moscovita, cordierita, sillimanita, granate, turmalina y/o andalucita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "peraluminous rock"@en,
        "roca peraluminosa"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-piroclastica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "toba"@es ;
    skos:definition "Rock formed by more than 75% by volume of pyroclasts"@en,
        "Roca formada en más de un 75% de su volumen por piroclastos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pyroclastic rock"@en,
        "roca piroclástica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-poligenica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed by geological modification of pre-existing rocks outside of igneous and sedimentary processes. Includes metamorphic rocks and those generated in alteration processes developed at the Earth's surface"@en,
        "Roca formada por modificación geológica de rocas preexistentes al margen de los procesos ígneos y sedimentarios. incluye las rocas metamórficas y las generadas en procesos de alteración desarrollados en la superficie terrestre"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "polygenetic rock"@en,
        "roca poligénica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-rica-en-materia-organica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock whose organic matter content is sufficiently high to have notable effects on the lithology"@en,
        "Roca cuyo contenido en materia orgánica es suficientemente alto como para tener efectos notables en la litología"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "organic matter-rich rock"@en,
        "roca rica en materia orgánica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-riolitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "riolitoide"@es ;
    skos:definition "Name used in the provisional description of acid volcanic rocks similar to rhyolite, subalkaline or alkaline, whose principal components are quartz, constituting between 20 and 60% of the felsic minerals, and feldspars, of which alkali feldspar accounts for at least 35%"@en,
        "Nombre utilizado en la descripción provisional de rocas volcánicas ácidas similares a la riolita, subalcalinas o alcalinas, cuyos componentes principales son el cuarzo, que constituye entre el 20 y el 60% de los minerales félsicos, y los feldespatos, de entre los que el feldespato alcalino supone al menos el 35%"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolitoid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/rhyolitoid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "rhyolitic rock"@en,
        "roca riolítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-salica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock that has more silica and aluminosilicates than ferromagnesian and calcic silicates"@en,
        "Roca ígnea que tiene más sílice y silicatos alumínicos que silicatos ferromagnesianos y cálcicos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "salic rock"@en,
        "roca sálica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed outside the Earth's crust by a sedimentary process. It exhibits characteristic structures, primarily stratification"@en,
        "Roca formada en el exterior de la corteza terrestre mediante un proceso de sedimentación. presenta estructuras características, como, principalmente, la estratificación"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "sedimentary rock"@en,
        "roca sedimentaria"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-carbonatada> a skos:Concept ;
