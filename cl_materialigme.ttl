<https://geo-carto.github.io/vocabularios/material-igme/material-biogenico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material produced by the action or presence of living organisms or their remains"@en,
        "Material producido por la acción o la presencia de organismos vivos o de sus restos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "biogenic material"@en,
        "material biogénico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSediment>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSilicaSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/biogenic_sediment>,
