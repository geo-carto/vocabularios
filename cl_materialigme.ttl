<https://geo-carto.github.io/vocabularios/material-igme/peridotita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Holocrystalline ultramafic rock composed of more than 40% olivine, in addition to clinopyroxene, orthopyroxene and spinel in variable proportions; may contain lesser amounts of plagioclase, garnet, amphibole and phlogopite"@en,
        "Roca holocristalina ultramáfica, compuesta en más de un 40% por olivino, además de clinopiroxeno, ortopiroxeno y espinela, en proporciones variables, puede contener cantidades menores de plagioclasa, granate, anfíbol y flogopita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/peridotite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "peridotite"@en,
        "peridotita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

