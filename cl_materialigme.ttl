<https://geo-carto.github.io/vocabularios/material-igme/fenita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Metasomatic rock, generally formed around intrusions of carbonatites, ijolites or, more rarely, nepheline syenites, composed of alkali feldspars, sodic pyroxenes and amphiboles and, occasionally, feldspathoids and carbonates"@en,
        "Roca metasomática, generalmente formada en torno a intrusiones de carbonatitas, ijolitas o, más raramente, sienitas nefelínicas, compuesta por feldespatos alcalinos, piroxenos y anfíboles sódicos y, ocasionalmente, feldespatoides y carbonatos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "fenite"@en,
        "fenita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/fergusita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock of the foidolite family, composed of similar amounts of leucite and clinopyroxene"@en,
        "Roca plutónica de la familia de las foidolitas, compuesta por cantidades similares de leucita y clinopiroxeno"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
