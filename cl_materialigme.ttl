<https://geo-carto.github.io/vocabularios/material-igme/polihalita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed by the mineral of the same name, with the formula K2MgCa2(SO4)4·2H2O, belonging to the class of sulfates, crystallizing in the triclinic system and occurring as compact lamellar masses. It has a pink or red colour"@en,
        "Roca formada por el mineral del mismo nombre, de fórmula k2mgca2so44.2h2o, perteneciente a la clase de los sulfatos, que cristaliza en el sistema triclínico y se presenta en masas lamelares compactas. posee color rosa o rojo"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "polyhalite"@en,
        "polihalita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/evaporite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/porcelanita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Siliceous sedimentary rock, generally with 15-30% porosity, of porcelain-like appearance"@en,
        "Roca sedimentaria silícea, generalmente con una porosidad del 15-30%, de aspecto semejante a la porcelana"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
