<https://geo-carto.github.io/vocabularios/material-igme/melilitita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Ultrabasic, ultraalkaline volcanic rock of the melilitoid group having melilite in proportions exceeding 10%, pyroxene and, frequently, olivine and nepheline as essential minerals"@en,
