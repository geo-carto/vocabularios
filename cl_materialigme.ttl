<https://geo-carto.github.io/vocabularios/material-igme/geiserita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "White opaline rock, lightweight, deposited as crusts or concretions by precipitation of geyser waters around the vent"@en,
        "Roca de composición opalina blanca, ligera, depositada en forma de costras o concreciones por precipitación de las aguas de un géiser alrededor de la boca del mismo"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "geyserite"@en,
        "geiserita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/gilsonita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Extraordinarily pure asphaltite, black, shiny and with conchoidal fracture. It has a hardness of 2 to 2.5 and a specific gravity of 1.07. It contains 10 to 20% carbon and burns readily with a luminous flame"@en,
        "Asfaltita extraordinariamente pura, negra, brillante y de fractura concoidea. tiene una dureza de 2 a 2,5 y un peso específico de 1,07. contiene del 10 al 20% de carbono y arde fácilmente con llama luminosa"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "gilsonite"@en,
        "gilsonita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/bitumen> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/gneis> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Granular metamorphic rock showing a gneissic structure, defined by the preferred orientation of medium- to coarse-grained minerals, which imparts to the rock a coarse, less well-defined, more widely spaced and more discontinuous foliation than schistose structure, and in which the bands are usually of contrasting mineralogy, grain size or texture"@en,
        "Roca metamórfica granuda que presenta estructura gnéisica, estructura definida por la orientación preferente de minerales de grano medio a grueso, que confiere a la roca una foliación grosera, peor definida, más espaciada y más discontinua que la estructura esquistosa, y en la que las bandas suelen ser de mineralogía, tamaño de grano o textura contrastados"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/gneiss>,
        <http://resource.geosciml.org/classifier/cgi/lithology/gneiss> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "gneiss"@en,
        "gneis"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/gneis-bandeado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Equigranular gneiss with regular and well-marked light and dark bands"@en,
        "Gneis equigranular, con franjas claras y oscuras regulares y bien marcadas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "banded gneiss"@en,
        "gneis bandeado"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/gneiss>,
        <http://resource.geosciml.org/classifier/cgi/lithology/gneiss> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/gneis-glandular> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "augen gneiss"@es ;
    skos:definition "Gneiss with large elliptical or lenticular porphyroblasts of potassic feldspar"@en,
        "Gneis con grandes porfidoblastos elípticos o lenticulares de feldespato potásico"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "glandular gneiss"@en,
        "gneis glandular"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/gneiss>,
        <http://resource.geosciml.org/classifier/cgi/lithology/gneiss> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/grainstone> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Carbonate rock consisting fundamentally of grains, without micritic matrix, according to the Dunham (1962) classification"@en,
        "Roca carbonatada constituida fundamentalmente por granos, sin matriz micrítica, según la clasificación de dunham 1962"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/grainstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/grainstone> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "grainstone"@en,
        "grainstone"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granito> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Leucocratic plutonic rock composed of similar amounts of quartz, potassic feldspar and sodic plagioclase as essential minerals, and lesser amounts of one or more minerals such as biotite, muscovite, cordierite, hornblende, garnet, etc. Quartz constitutes between 20 and 60% of the felsic minerals and alkali feldspar between 35 and 90% of the feldspars. It is the plutonic equivalent of rhyolite"@en,
        "Roca plutónica leucocrática compuesta por cantidades similares de cuarzo, feldespato potásico y plagioclasa sódica, como minerales esenciales, y cantidades menores de uno o más minerales como biotita, moscovita, cordierita, hornblenda, granate, etc. el cuarzo constituye entre el 20 y el 60% de los minerales félsicos y el feldespato alcalino, entre el 35 y el 90% de los feldespatos. es el equivalente plutónico de la riolita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "granite"@en,
        "granito"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granito-alcalino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Metaluminous or slightly peraluminous granite, with Al2O3/Na2O+K2O values in molar proportions close to 1 and slightly depleted in Ca. It contains abundant alkali feldspar (potassic feldspar). As varietal minerals, in addition to biotite, it may present aegirine (sodic pyroxene) and/or riebeckite (sodic amphibole)"@en,
        "Granito metaluminoso o ligeramente peraluminoso, con valores de al2o3/na2o+k2o en proporciones molares próximos a 1 y algo empobrecidos en ca. contiene abundante feldespato alcalino feldespato potásico. como minerales varietales, además de biotita, puede presentar egirina piroxeno sódico y/o riebeckita anfíbol sódico"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "alkaline granite"@en,
        "granito alcalino"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granito-calcoalcalino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Metaluminous or slightly peraluminous granite, with Al2O3/Na2O+K2O values in molar proportions greater than 1 and relatively rich in calcium. As varietal minerals it usually contains biotite ± calcic amphibole ± titanite"@en,
        "Granito metaluminoso o ligeramente peraluminoso, con valores de al2o3/na2o+k2o en proporciones molares superiores a 1, y relativamente rico en calcio. como minerales varietales suele contener biotita ± anfíbol cálcico ± titanita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "calc-alkaline granite"@en,
        "granito calcoalcalino"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granito-de-feldespato-alcalino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Leucocratic plutonic rock of the granitoid family, in which alkali feldspar constitutes more than 90% of the total feldspars. It is the plutonic equivalent of alkali feldspar rhyolite"@en,
        "Roca plutónica leucocrática de la familia de los granitoides, en la que el feldespato alcalino constituye más del 90% del total de los feldespatos. es el equivalente plutónico de la riolita de feldespato alcalino"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparGranite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_granite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "alkali feldspar granite"@en,
        "granito de feldespato alcalino"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granito-peralcalino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Metaluminous granite with Al2O3/Na2O+K2O ratios in molar proportions less than 1. As varietal minerals it contains biotite and sodic pyroxenes or amphiboles (aegirine, arfvedsonite and riebeckite)"@en,
        "Granito metaluminoso y con relaciones al2o3/na2o+k2o en proporciones molares inferiores a 1. como minerales varietales contiene biotita y piroxenos o anfíboles sódicos egirina, arfvedsonita y riebeckita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "peralkaline granite"@en,
        "granito peralcalino"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granito-rico-en-cuarzo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Leucocratic plutonic rock in which quartz constitutes more than 60% of the felsic minerals"@en,
        "Roca plutónica leucocrática en la que el cuarzo constituye más del 60% de los minerales félsicos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "quartz-rich granite"@en,
        "granito rico en cuarzo"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granitoide-rico-en-cuarzo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Name used in the provisional description of leucocratic plutonic rocks in which quartz is the main constituent"@en,
        "Nombre utilizado en la descripción provisional de rocas plutónicas leucocráticas en las que el cuarzo es el constituyente principal"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/quartzRichIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/quartz_rich_igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "quartz-rich granitoid"@en,
        "granitoide rico en cuarzo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/grano> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Detrital mineral or rock fragment of sand size (0.062-2 mm)"@en,
        "Mineral detrítico o fragmento de roca de tamaño arena 0.062-2 mm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "grain"@en,
        "grano"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/sandSizeSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sand_size_sediment> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granodiorita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock of the granitoid family, in which plagioclase constitutes between 65 and 90% of the feldspars, containing lesser amounts of biotite, hornblende and, more rarely, pyroxene"@en,
        "Roca plutónica de la familia de los granitoides, en la que la plagioclasa constituye entre el 65 y el 90% de los feldespatos, contiene cantidades menores de biotita, hornblenda y, más raramente, piroxeno"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granodiorite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granodiorite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "granodiorite"@en,
        "granodiorita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granofido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Felsic rock of porphyritic appearance with a groundmass composed of graphic intergrowths of quartz and alkali feldspar"@en,
        "Roca félsica de apariencia porfídica con una matriz compuesta de intercrecimientos gráficos de cuarzo y feldespato alcalino"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "granophyre"@en,
        "granófido"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/granulita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "High- to very high-grade metamorphic rock, generally of granoblastic texture and gneissic or massive structure, dominated by anhydrous minerals and feldspars. In mafic composition, it consists of augitic clinopyroxene, orthopyroxene, calcic plagioclase, with or without garnet, and quartz. In quartz-feldspathic composition, it consists of quartz, plagioclase, potassic feldspar and orthopyroxene, with or without biotite, garnet, cordierite and sillimanite"@en,
        "Roca metamórfica de grado alto a muy alto, de textura generalmente granoblástica y estructura gnéisica o masiva, dominada por minerales anhidros y feldespatos. en caso de composición máfica, está constituida por clinopiroxeno augítico, ortopiroxeno, plagioclasa cálcica, con o sin granate, y cuarzo. en caso de composición cuarzo-feldespática, está constituida por cuarzo, plagioclasa, feldespato potásico y ortopiroxeno, con o sin biotita, granate, cordierita y sillimanita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/granulite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/granulite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "granulite"@en,
        "granulita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

