    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/breccia>,
        <http://resource.geosciml.org/classifier/cgi/lithology/breccia> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-osifera> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Breccia consisting of cemented bones and bone fragments, forming in caves or filling karst fissures or cavities"@en,
        "Brecha constituida por huesos y fragmentos de huesos cementados, que se forma en cuevas o rellena grietas o cavidades cársticas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ossiferrous breccia"@en,
        "brecha osífera"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/breccia>,
        <http://resource.geosciml.org/classifier/cgi/lithology/breccia> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-pelitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Detrital rock consisting of 30-50% angular clasts with a diameter exceeding 2 mm and with a pelite-size element content greater than that of sand-size elements"@en,
        "Roca detrítica constituida en un 30-50% por clastos angulosos de más de 2 mm de diámetro y con un contenido de elementos de tamaño pelita mayor que el de elementos de tamaño arena"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pelitic breccia"@en,
        "brecha pelítica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/breccia>,
        <http://resource.geosciml.org/classifier/cgi/lithology/breccia> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-piroclastica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Pyroclastic rock formed by more than 75% by volume of fragments with a diameter greater than 64 mm, among which pyroclastic blocks predominate"@en,
