    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "gravelly pelite"@en,
        "pelita gravosa"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/mud>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mud> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/pelita-s.l.> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sediment containing less than 30% gravel-size clasts (>2 mm diameter) and with a ratio of sand grains (0.062-2 mm) to mud particles (<0.062 mm) less than 1, without specifying composition or genesis"@en,
        "Sedimento que contiene menos de un 30% de clastos de tamaño grava >2 mm de diámetro y una relación entre granos de arena 0.062-2 mm y partículas de lutita <0.062 mm menor que 1, sin especificar su composición o su génesis"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/mudSizeSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mud_size_sediment> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pelite s.l."@en,
        "pelita s.l."@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/pelita-tobacea> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mixed pyroclastic-epiclastic deposit formed by more than 75% by volume of fragments with a diameter below 1/16 mm"@en,
        "Depósito mixto piroclástico-epiclástico formado en más de un 75% de su volumen por fragmentos de diámetro menor de 1/16 mm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "tuffaceous pelite"@en,
        "pelita tobácea"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/ashAndLapilli>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/mudSizeSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/ash_and_lapilli>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mud_size_sediment> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/pelmicrita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Micritic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio below 1:3"@en,
        "Caliza aloquímica micrítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides inferior a 1:3"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pelmicrite"@en,
        "pelmicrita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/limestone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/limestone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/peperita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock of clastic texture generated by the mixing of a lava or magma with water-saturated unconsolidated sediments"@en,
        "Roca de textura clástica generada por la mezcla de una lava o magma con sedimentos no consolidados saturados en agua"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
