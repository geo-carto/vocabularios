<https://geo-carto.github.io/vocabularios/material-igme/pelita-gravosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Poorly sorted detrital sediment with a pelite-size element content greater than that of sand-size elements and a gravel-size element content between 5 and 30% of the total"@en,
