<https://geo-carto.github.io/vocabularios/material-igme/evaporita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sediment or sedimentary rock formed by chemical precipitation of non-carbonate salts, mainly sulfates, chlorides and borates"@en,
