<https://geo-carto.github.io/vocabularios/material-igme/material-basico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous material whose silica content is between 45 and 52%"@en,
        "Material ígneo cuyo contenido en sílice está comprendido entre el 45 y el 52%"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/basicIgneousMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/basic_igneous_material> ;
