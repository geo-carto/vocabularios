<https://geo-carto.github.io/vocabularios/material-igme/ftanita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Variety of chert, grey to black in colour due to the presence of graphitic and carbonaceous matter, formed essentially of cryptocrystalline quartz and some opal, sometimes with some radiolarians; it has a finely splintery fracture"@en,
        "Variedad del sílex, de color gris a negro debido a la presencia de materia grafitosa y carbonosa, formada esencialmente por cuarzo criptocristalino y algo de ópalo, a veces con algunos radiolarios, tiene fractura finamente astillosa"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "phtanite"@en,
        "ftanita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/gabro> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Melanocratic plutonic rock consisting fundamentally of calcic plagioclase (labradorite-anorthite) and pyroxene. It is the plutonic equivalent of basalt"@en,
        "Roca plutónica melanocrática constituida fundamentalmente por plagioclasa cálcica labradorita-anortita y piroxeno. es el equivalente plutónico del basalto"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/gabbro>,
        <http://resource.geosciml.org/classifier/cgi/lithology/gabbro> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "gabbro"@en,
        "gabro"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/gabro-con-foides> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock belonging to the group of gabbroic rocks, containing feldspathoids"@en,
        "Roca plutónica perteneciente al grupo de las rocas gabroicas, que contiene feldespatoides"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingGabbro>,
