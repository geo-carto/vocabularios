        <http://resource.geosciml.org/classifier/cgi/lithology/impure_calcareous_carbonate_sediment> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "impure calcareous sediment"@en,
        "sedimento calcáreo impuro"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/sedimento-calcareo-pelitico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
