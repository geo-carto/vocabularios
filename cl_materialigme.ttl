<https://geo-carto.github.io/vocabularios/material-igme/fango-carbonatado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mud consisting of more than 50% carbonate skeletal remains"@en,
