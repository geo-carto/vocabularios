    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff>,
        <http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/ceniza-gruesa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "1. Pyroclast with a grain size between 1/16 mm and 2 mm. 2. Pyroclastic deposit formed by more than 75% by volume of fragments with a diameter between 1/16 and 2 mm"@en,
        "1. piroclasto de tamaño de grano comprendido entre 1/16 mm y 2 mm. 2. depósito piroclástico formado en más de un 75% de su volumen por fragmentos de diámetro comprendido entre 1/16 y 2 mm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "coarse ash"@en,
