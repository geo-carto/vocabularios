<https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-hibrido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material that cannot be included in any other category of sedimentary material by its composition or origin. It is composed of three or more components, each of which constitutes between 5 and 50% of the sediment"@en,
        "Material que no puede incluirse en ninguna otra categoría de material sedimentario por su composición u origen. está integrado por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% del sedimento"@es ;
