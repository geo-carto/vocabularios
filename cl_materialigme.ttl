<https://geo-carto.github.io/vocabularios/material-igme/calcimudstone> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Matrix-supported carbonate rock, consisting of less than 10% grains, with the remainder being micritic matrix, according to the Dunham (1962) classification"@en,
        "Roca carbonatada matriz-soportada, constituida por menos del 10% de granos, siendo el resto matriz micrítica, según la clasificación de Dunham 1962"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateMudstone> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "calcimudstone"@en,
