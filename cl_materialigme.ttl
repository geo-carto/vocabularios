<https://geo-carto.github.io/vocabularios/material-igme/essexita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Monzogabbro or monzodiorite with nepheline"@en,
        "Monzogabro o monzodiorita con nefelina"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "essexite"@en,
