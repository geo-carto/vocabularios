    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Pelite-size sediment composed of diatom frustules"@en,
        "Sedimento de tamaño pelita compuesto por caparazones de diatomeas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
