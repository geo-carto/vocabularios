    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-silicea> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sedimentary rock composed of more than 50% silica of biogenic or chemical origin. Detrital rocks are excluded"@en,
        "Roca sedimentaria compuesta en más de un 50% por sílice de origen biogénico o químico. se excluyen las rocas detríticas"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "siliceous sedimentary rock"@en,
        "roca sedimentaria silícea"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Whitish to pink or red syenitoid, in which alkali feldspar constitutes between 65 and 90% of the feldspars, with subordinate amounts of plagioclase, clinopyroxene, biotite, hornblende and quartz or nepheline. It is the intrusive equivalent of trachytic rock"@en,
        "Sienitoide de color blanquecino a rosado o rojo, en el que el feldespato alcalino constituye entre el 65 y el 90% de los feldespatos, con cantidades subordinadas de plagioclasa, clinopiroxeno, biotita, hornblenda y cuarzo o nefelina. es el equivalente intrusivo de la roca traquítica"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/syeniticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/syenitic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "syenitic rock"@en,
        "roca sienítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica-de-feldespato-alcalino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Leucocratic syenitoid in which alkali feldspar constitutes more than 90% of the feldspars, with subordinate amounts of plagioclase, clinopyroxene, biotite, hornblende and quartz or nepheline. It is the intrusive equivalent of alkali feldspar trachytic rock"@en,
        "Sienitoide leucocrático en el que el feldespato alcalino constituye más del 90% de los feldespatos, con cantidades subordinadas de plagioclasa, clinopiroxeno, biotita, hornblenda y cuarzo o nefelina. es el equivalente intrusivo de la roca traquítica de feldespato alcalino"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparSyeniticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenitic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "alkali feldspar syenitic rock"@en,
        "roca sienítica de feldespato alcalino"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica-foidica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "sienitoide foídico"@es ;
    skos:definition "Name used in the provisional description of foidic syenite and monzosyenite type rocks"@en,
        "Nombre utilizado en la descripción provisional de las rocas de tipo sienita y monzosienita foídicas"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidSyenitoid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foid_syenitoid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "foidic syenitic rock"@en,
        "roca sienítica foídica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-subalcalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Term used for igneous rocks that are not of alkaline nature. Subalkaline magmatic series include calc-alkaline, or aluminium-rich rocks, and tholeiitic, or potassium-poor rocks"@en,
        "Término utilizado para las rocas ígneas que no son de naturaleza alcalina. las series magmáticas subalcalinas incluyen las rocas calcoalcalinas, o ricas en aluminio, y toleíticas, o pobres en potasio"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "subalkaline rock"@en,
        "roca subalcalina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-subvolcanica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "roca hipoabisal"@es ;
    skos:definition "Rock formed by the solidification of a silicate magma in the interior of the Earth's crust at shallow depth, not exceeding 3 km. It is associated with plutonic rocks, forming apophyses or stocks, or with extrusive rocks in the deeper parts of volcanic complexes, and differs from both primarily in texture rather than composition"@en,
        "Roca originada por la solidificación de un magma silicatado en el interior de la corteza terrestre a escasa profundidad no superior a 3 km. se encuentra asociada a las rocas plutónicas, formando salientes o apófisis, o bien a las eruptivas, en la parte profunda de complejos volcánicos, y presenta diferencias texturales, más que de composición, con ambas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "subvolcanic rock"@en,
        "roca subvolcánica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-tefritica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Containing lesser amounts of ferromagnesian minerals, such as pyroxene, amphibole and, occasionally, olivine"@en,
        "Contienen cantidades menores de minerales ferromagnesianos, como piroxeno, anfíbol y, en ocasiones, olivino"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/tephritoid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/tephritoid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "tephritic rock"@en,
        "roca tefrítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-toleitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Term used for potassium-poor basaltic rocks forming part of subalkaline magmatic series with strong iron enrichment in the early stages of differentiation"@en,
        "Término utilizado para rocas basálticas pobres en potasio que forman parte de series magmáticas subalcalinas con fuerte enriquecimiento en hierro en las etapas iniciales de la diferenciación"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "tholeiitic rock"@en,
        "roca toleítica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/tholeiiticBasalt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/tholeiitic_basalt> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-traquitica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Leucocratic, intermediate or acid, alkaline volcanic rock belonging to the group of trachytoids, composed mainly of feldspars, of which alkali feldspar constitutes between 65 and 90%, in a microcrystalline groundmass, frequently with trachytic texture. Its plutonic equivalent is syenitic rock"@en,
        "Roca volcánica leucocrática, intermedia o ácida, alcalina, perteneciente al grupo de los traquitoides, compuesta principalmente por feldespatos, de entre los que el feldespato alcalino constituye entre el 65 y el 90%, en una matriz microcristalina, frecuentemente con textura traquítica. su equivalente plutónico es la roca sienítica"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/trachyticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/trachytic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "trachytic rock"@en,
        "roca traquítica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-traquitica-de-feldespato-alcalino> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Leucocratic, intermediate or acid, alkaline volcanic rock belonging to the group of trachytoids, whose principal component is alkali feldspar, constituting more than 90% of the feldspars, in a microcrystalline groundmass, frequently with trachytic texture. Its plutonic equivalent is alkali feldspar syenitic rock"@en,
        "Roca volcánica leucocrática, intermedia o ácida, alcalina, perteneciente al grupo de los traquitoides, cuyo componente principal es el feldespato alcalino, que constituye más del 90% de los feldespatos, en una matriz microcristalina, frecuentemente con textura traquítica. su equivalente plutónico es la roca sienítica de feldespato alcalino"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparTrachyticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachytic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "alkali feldspar trachytic rock"@en,
        "roca traquítica de feldespato alcalino"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-ultrabasica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock containing less than 45% silica"@en,
        "Roca ígnea que contiene menos de un 45% de sílice"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/ultrabasicIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/ultrabasic_igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ultrabasic rock"@en,
        "roca ultrabásica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-ultramafica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock with a dark mineral content exceeding 90% by volume"@en,
        "Roca ígnea con un contenido en minerales oscuros superior al 90% en volumen"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/ultramaficIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/ultramafic_igneous_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ultramafic rock"@en,
        "roca ultramáfica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-ultrapotasica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Ultramafic or mafic igneous rock enriched in potassium, with a molar K2O/Na2O ratio greater than 3"@en,
        "Roca ígnea ultramáfica o máfica enriquecida en potasio, con una relación molar de k2o/na2o mayor que 3"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ultrapotassic rock"@en,
        "roca ultrapotásica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-vitrea> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "roca holohialina"@es ;
    skos:definition "Igneous rock that has undergone rapid cooling, giving rise to an amorphous, crystal-free mass, exhibiting the characteristics of a glass: brittleness, conchoidal fracture and absence of cleavage"@en,
        "Roca ígnea que ha sufrido un enfriamiento rápido, dando lugar a una masa amorfa, sin cristales, presentando las características de un vidrio: fragilidad, fractura concoidea y ausencia de exfoliación"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "glassy rock"@en,
        "roca vítrea"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/glassyIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/glassy_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-volcanica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "roca efusiva, roca extrusiva"@es ;
    skos:definition "Igneous rock produced by volcanic activity, normally very fine-grained or glassy. It may frequently contain fragments of other rocks as well as phenocrysts"@en,
        "Roca ígnea producida por actividad volcánica, normalmente de grano muy fino o vítrea. con frecuencia puede contener fragmentos de otras rocas, así como fenocristales"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "volcanic rock"@en,
        "roca volcánica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fineGrainedIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fine_grained_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-volcanica-rica-en-magnesio> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Volcanic rock with an unusually high MgO concentration. In rocks with more than 52% SiO2, the MgO content must exceed 8%, and in rocks with less than 52% SiO2, the MgO content must exceed 12%"@en,
        "Roca volcánica con una concentración inusualmente elevada de mgo. en rocas con más del 52% de sio2, el contenido de mgo debe ser superior al 8% y en rocas con menos del 52% de sio2, el contenido de mgo debe ser superior al 12%"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "high-magnesium volcanic rock"@en,
        "roca volcánica rica en magnesio"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/highMagnesiumFineGrainedIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/high_magnesium_fine_grained_igneous_rocks> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-volcano-sedimentaria> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock in whose formation the participation of both volcanic and sedimentary processes is recognized"@en,
        "Roca en cuya formación se reconoce la participación de procesos volcánicos y sedimentarios"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "volcano-sedimentary rock"@en,
        "roca volcano-sedimentaria"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/roca-volcanoclastica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock composed of at least 10% by volume of fragments of volcanic nature, regardless of the fragmentation and accumulation mechanism"@en,
        "Roca compuesta, al menos en un 10% de su volumen, por fragmentos de naturaleza volcánica, independientemente del mecanismo de fragmentación y de acumulación"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "volcaniclastic rock"@en,
        "roca volcanoclástica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/rodingita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Calc-silicate rock associated with serpentinites, fine-grained and white, green or pink in colour, produced by metasomatism of mafic plutonic rocks associated with ultramafic complexes. Its characteristic mineral assemblage includes grossular, diopside, epidote, scapolite, vesuvianite and iron oxides"@en,
        "Roca de silicatos cálcicos asociada con serpentinitas, de grano fino y color blanco, verde o rosa, producida por metasomatismo de rocas plutónicas máficas asociadas a complejos ultramáficos. su asociación mineralógica característica está integrada por grosularia, diópsido, epidota, escapolita, vesubianita y óxidos de hierro"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "rodingite"@en,
        "rodingita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/rudacea> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "psefita, sefita"@es ;
    skos:definition "Class, group or texture of detrital sediments or sedimentary rocks whose mean grain size exceeds 2 mm"@en,
        "Clase, grupo o textura de los sedimentos o rocas sedimentarias detríticas cuyo tamaño medio de los granos es superior a 2 mm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "rudaceous"@en,
        "rudácea"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/gravel>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate>,
        <http://resource.geosciml.org/classifier/cgi/lithology/gravel> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/rudstone> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Grain-supported carbonate sediment or rock, with more than 10% clasts with a diameter exceeding 2 mm"@en,
        "Sedimento o roca carbonática, grano-soportados, con más del 10% de los clastos de tamaño superior a 2 mm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "rudstone"@en,
        "rudstone"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/salina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Coastal or inland lagoon, natural or artificial, where salt precipitation takes place"@en,
        "Laguna costera o continental, natural o artificial, donde se produce precipitación de sales"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "salt works"@en,
        "salina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sediment> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/sanaita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Alkaline lamprophyre with phenocrysts of olivine, titanium augite, amphibole and biotite, with alkali feldspar dominating over plagioclase in the groundmass"@en,
        "Lamprófido alcalino con fenocristales de olivino, augita titanada, anfíbol y biotita, con feldespato alcalino dominante sobre plagioclasa en la matriz"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "sannaite"@en,
        "sanaíta"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/sanukita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mg-rich andesite characterized by the presence of orthopyroxene and plagioclase in a glassy groundmass. Distinguished from boninite by having a TiO2 content above 0.5%"@en,
        "Andesita rica en mg caracterizada por la presencia de ortopiroxeno y plagioclasa en una matriz vítrea. se distingue de la boninita por tener un contenido en tio2 mayor del 0,5%"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "sanukite"@en,
        "sanukita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/andesite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/andesite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/sapropel> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Subaqueous, lacustrine or marine organic mud deposited in anoxic, stratified waters, formed by black mudstone with abundant macerated organic matter associated with anaerobic bacteria producing hydrogen sulfide, in a reducing medium. It usually presents parallel lamination"@en,
        "Fango orgánico subacuático, lacustre o marino, depositado en fondos de aguas anóxicas y estratificadas, formado por lutita negra con restos abundantes de materia orgánica macerada, asociados a bacterias anaerobias productoras de ácido sulfhídrico, en un medio reductor. suele presentar una laminación paralela"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/sapropel>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sapropel> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "sapropel"@en,
        "sapropel"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/sedimento-calcareo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Calcareous carbonate sediment with a calcite plus aragonite content greater than that of dolomite"@en,
        "Sedimento carbonatado con un contenido de calcita más aragonito superior al de dolomita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sediment> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "calcareous sediment"@en,
        "sedimento calcáreo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/sedimento-calcareo-impuro> a skos:Concept ;
