<https://geo-carto.github.io/vocabularios/material-igme/molasa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Tectofacies consisting of detrital rocks that can reach great thicknesses of up to several thousands of metres. It frequently presents fining-upward sequences starting with conglomerates. It is deposited in the subsiding areas adjacent to new mountain reliefs, immediately after folding"@en,
        "Tectofacies constituida por rocas detríticas que pueden alcanzar grandes espesores hasta de algunos miles de metros. con frecuencia presenta secuencias granodecrecientes que se inician con conglomerados. se deposita en las áreas subsidentes adyacentes a los nuevos relieves montañosos, inmediatamente después del plegamiento"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "molasse"@en,
        "molasa"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

