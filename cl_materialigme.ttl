    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Calcareous rock in which calcite and dolomite together constitute more than 90%, with a dolomite content exceeding 10% of the total"@en,
        "Roca calcárea en la que la calcita y la dolomita constituyen, conjuntamente, más del 90%, con un contenido de dolomita superior al 10% del total"@es ;
