        <http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/basalt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/traquidacita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mesocratic, intermediate or acid, alkaline volcanic rock belonging to the trachytic rock family, differentiated from trachyte by having more than 20% normative quartz"@en,
        "Roca volcánica mesocrática, intermedia o ácida, alcalina, perteneciente a la familia de las rocas traquíticas, diferenciada de la traquita por poseer más del 20% de cuarzo normativo"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/trachytoid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/trachytoid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "trachydacite"@en,
        "traquidacita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/traquita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Volcanic rock belonging to the group of trachytic rocks, whitish or grey, formed essentially by alkali feldspar and frequently with trachytic texture; may contain quartz in proportions below 5% of the felsic minerals. Its plutonic equivalent is syenite"@en,
        "Roca volcánica perteneciente al grupo de las rocas traquíticas, blanquecina o gris, formada esencialmente por feldespato alcalino y frecuentemente con textura traquítica, puede contener cuarzo, en proporción inferior al 5% de los minerales félsicos. su equivalente plutónico es la sienita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/trachyte>,
        <http://resource.geosciml.org/classifier/cgi/lithology/trachyte> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "trachyte"@en,
        "traquita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/traquita-alcalina> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "traquita de feldespato alcalino"@es ;
    skos:definition "Volcanic rock belonging to the group of alkali feldspar trachytic rocks, which may contain quartz in proportions below 5% of the felsic minerals. Its plutonic equivalent is alkali feldspar syenite"@en,
        "Roca volcánica perteneciente al grupo de las rocas traquíticas de feldespato alcalino, que puede contener cuarzo, en proporción inferior al 5% de los minerales félsicos. su equivalente plutónico es la sienita de feldespato alcalino"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "alkaline trachyte"@en,
        "traquita alcalina"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparTrachyte>,
        <http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachyte> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/traquita-con-foides> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Volcanic rock belonging to the group of trachytic rocks, containing feldspathoids. Its plutonic equivalent is foid-bearing syenite"@en,
        "Roca volcánica perteneciente al grupo de las rocas traquíticas, que contiene feldespatoides. su equivalente plutónico es la sienita con foides"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingTrachyte>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_trachyte> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "foid-bearing trachyte"@en,
        "traquita con foides"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/traquita-de-feldespato-alcalino-con-foides> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Volcanic rock belonging to the group of alkali feldspar trachytic rocks, containing feldspathoids. Its plutonic equivalent is alkali feldspar foid-bearing syenite"@en,
        "Roca volcánica perteneciente al grupo de las rocas traquíticas de feldespato alcalino, que contiene feldespatoides. su equivalente plutónico es la sienita de feldespato alcalino con foides"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAlkaliFeldsparTrachyte>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_alkali_feldspar_trachyte> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "alkali feldspar foid-bearing trachyte"@en,
        "traquita de feldespato alcalino con foides"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/traquitoide> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Name used in the provisional description of acid or intermediate, alkaline volcanic rocks similar to trachyte, generally leucocratic, composed mainly of feldspars, of which alkali feldspar constitutes at least 35%, in a microcrystalline or, more rarely, glassy groundmass; may also include lesser amounts of biotite, amphibole and pyroxene, as well as quartz or feldspathoids in proportions below 20 and 10%, respectively, of the felsic minerals. Its plutonic equivalent is syenitoid"@en,
        "Nombre utilizado en la descripción provisional de rocas volcánicas ácidas o intermedias, alcalinas, similares a la traquita, generalmente leucocráticas, compuestas principalmente por feldespatos, de los que el feldespato alcalino constituye al menos el 35%, en una matriz microcristalina o, más raramente, vítrea, también pueden incluir cantidades menores de biotita, anfíbol y piroxeno, además de cuarzo o feldespatoides en proporción inferior al 20 y al 10%, respectivamente, de los minerales félsicos. su equivalente plutónico es el sienitoide"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/trachytoid>,
        <http://resource.geosciml.org/classifier/cgi/lithology/trachytoid> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "trachytoid"@en,
        "traquitoide"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/troctolita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock of the gabbro family consisting of calcic plagioclase and having olivine as the dominant ferromagnesian mineral"@en,
        "Roca de la familia de los gabros constituida por plagioclasa cálcica y que tiene olivino como mineral ferromagnesiano dominante"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "troctolite"@en,
        "troctolita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/tsunamita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Clastic material deposited on the coast during the passage of a tsunami"@en,
        "Material clástico depositado en la costa durante el paso de un tsunami"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "tsunamite"@en,
        "tsunamita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/tufita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "tufita"@es ;
    skos:definition "Rock of mixed character consisting of both pyroclastic and epiclastic fragments, each in a percentage between 25 and 75% of the rock volume"@en,
        "Roca de carácter mixto constituida tanto por fragmentos de origen piroclástico como de origen epiclástico, ambos en un porcentaje comprendido entre el 25 y el 75% del volumen de la roca"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/tuffite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/tuffite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "tuffite"@en,
        "roca piroclástica-epiclástica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/turba> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Coal variety consisting of an organic matter-rich sediment, lightweight, brownish-yellow to black in colour, preserving plant structure. Its carbon content is below 60% and the volatile matter content exceeds 63%"@en,
        "Variedad de carbón constituida por un sedimento rico en materia orgánica, ligero, de color pardo amarillento a negro, que conserva la estructura vegetal. su contenido en carbono es inferior al 60% y el de volátiles, superior al 63%"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/peat>,
        <http://resource.geosciml.org/classifier/cgi/lithology/peat> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "peat"@en,
        "turba"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/turbidita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sediment or sedimentary rock formed by turbidity currents. They consist of sands or sandstones with graded bedding sequences and a very distinctive arrangement of internal sedimentary structures known as the Bouma sequence"@en,
        "Sedimento o roca sedimentaria formados por corrientes de turbidez. se trata de arenas o areniscas que presentan secuencias granodecrecientes con una ordenación de estructuras sedimentarias internas muy singular, denominada secuencia de bouma"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "turbidite"@en,
        "turbidita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/sand>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sand> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/ulexita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed by the mineral of the same name, with the formula NaCaB5O9·8H2O, belonging to the class of borates, crystallizing in the triclinic system in globular form with a cotton-ball external appearance and fibrous internal structure. It is colourless or white, with silky lustre and varying from transparent to translucent"@en,
        "Roca formada por el mineral del mismo nombre, de fórmula nacab5o9.8h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema triclínico bajo forma globular, con aspecto externo de bolas de algodón y estructura interna fibrosa. es incoloro o blanco, tiene brillo sedoso y varía de transparente a translúcido"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ulexite"@en,
        "ulexita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/evaporite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/ultracataclasita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Cataclastic rock consisting of more than 90% matrix"@en,
