        <http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sediment> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-poligenico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material, with an unspecified state of consolidation, generated by geological modification of pre-existing materials outside the scope of igneous and sedimentary processes. Includes metamorphic materials and alteration products developed at the Earth's surface"@en,
        "Material, con un estado de consolidación no especificado, generado por modificación geológica de materiales preexistentes fuera del ámbito de los procesos ígneos y sedimentarios. incluye los materiales metamórficos y los productos de alteración desarrollados en la superficie terrestre"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "polygenetic material"@en,
        "material poligénico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-rico-en-materia-organica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material whose organic matter content is sufficiently high to have notable effects on the lithology"@en,
