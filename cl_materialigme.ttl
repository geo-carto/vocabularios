<https://geo-carto.github.io/vocabularios/material-igme/lutita-carbonatada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Detrital sedimentary rock with a combined content of pelite-size elements and carbonates equal to or exceeding 90% of the total, and in which the ratio of pelite-size elements to carbonate is between 50 and 90%"@en,
        "Roca sedimentaria detrítica con un contenido conjunto de elementos de tamaño pelita y de carbonatos igual o superior al 90% del total y en la que la relación de elementos de tamaño pelita con respecto al carbonato está comprendida entre el 50 y el 90%"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "carbonate-rich mudstone"@en,
        "lutita carbonatada"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateRichMudstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mudstone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/lutita-con-materia-organica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mudstone with an organic matter content of 10-20% of the total rock"@en,
