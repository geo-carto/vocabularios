<https://geo-carto.github.io/vocabularios/material-igme/material-piroclastico-epiclastico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material of mixed character consisting of both pyroclastic and epiclastic fragments, each in a percentage between 25 and 75% of the deposit volume"@en,
        "Material de carácter mixto constituido tanto por fragmentos de origen piroclástico como de origen epiclástico, ambos en un porcentaje comprendido entre el 25 y el 75% del volumen del depósito"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
