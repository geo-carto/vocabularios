<https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-metamorficos-materiales-de-falla> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Collection of materials belonging to the subcategory of Metamorphic Materials / Fault Materials, characterized by grouping, within metamorphic materials, those materials formed as a result of deformation in a fault zone."@en,
        "Colección de materiales que pertenecen a la subcategoría de Materiales Metamórficos / Materiales de Falla, que se caracteriza por agrupar, dentro de los materiales metamórficos, aquellos materiales formados como resultado de la deformación en una zona de falla."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:member <https://geo-carto.github.io/vocabularios/material-igme/material-de-falla>,
        <https://geo-carto.github.io/vocabularios/material-igme/roca-de-falla> ;
