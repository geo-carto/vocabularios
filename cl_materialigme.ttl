<https://geo-carto.github.io/vocabularios/material-igme/hierro-de-los-pantanos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mineral or sedimentary rock, a variety of limonite, occurring as spongy black masses and currently forming in swampy areas"@en,
        "Mineral o roca sedimentaria, variedad de la limonita, que se presenta en masas esponjosas de color negro y se forma actualmente en zonas pantanosas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "bog iron"@en,
        "hierro de los pantanos"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/ironRichSedimentaryMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sedimentary_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/hormigon> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material resulting from mixing water, sand, gravel and cement or lime, which upon setting acquires greater resistance"@en,
        "Material que resulta de la mezcla de agua, arena, grava y cemento o cal, y que, al fraguar, adquiere más resistencia"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/concrete> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "concrete"@en,
        "hormigón"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/hornblendita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Ultramafic plutonic rock composed essentially of hornblende with pyroxenes, spinel and olivine, the latter in an amount below 40% of the mafic minerals; may contain lesser amounts of plagioclase, garnet and phlogopite. In a stricter sense, an ultramafic plutonic rock composed of more than 90% hornblende"@en,
        "Roca plutónica ultramáfica compuesta esencialmente por hornblenda con piroxenos, espinela y olivino, éste en cantidad inferior al 40% de los minerales máficos, puede contener cantidades menores de plagioclasa, granate y flogopita. en un sentido más estricto, roca plutónica ultramáfica, compuesta en más de un 90% por hornblenda"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/hornblendite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/hornblendite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "hornblendite"@en,
        "hornblendita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/hornblendita-olivinica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Ultramafic rock consisting essentially of hornblende and, in lesser proportion, olivine"@en,
        "Roca ultramáfica constituida esencialmente por hornblenda y, en menor proporción, olivino"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "olivine hornblendite"@en,
        "hornblendita olivínica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/hornblendite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/hornblendite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/hornblendita-olivino-piroxenica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Hornblendite with olivine and pyroxene in amounts exceeding 5%"@en,
