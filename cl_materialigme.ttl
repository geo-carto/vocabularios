    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/boundstone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/biomicrita> a skos:Concept ;
