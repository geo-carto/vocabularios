<https://geo-carto.github.io/vocabularios/material-igme/werlita-wehrlita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Ultramafic rock of the peridotite group composed of olivine and clinopyroxene as essential minerals"@en,
