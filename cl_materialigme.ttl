    skos:prefLabel "pelitic calcareous sediment"@en,
        "sedimento calcáreo pelítico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSediment>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/mud>,
