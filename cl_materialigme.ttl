<https://geo-carto.github.io/vocabularios/material-igme/biostromo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Stratified detrital rock resulting from the diagenesis of fragments derived from the bioherm and accumulated as a talus on the outer side of the barrier reef towards the open sea"@en,
        "Roca detrítica estratificada resultante de la diagénesis de los fragmentos desprendidos del biohermo y acumulados formando un talud en la parte exterior del arrecife barrera, hacia el mar libre"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "biostrome"@en,
        "biostromo"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bitumen> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Solid or semi-solid, black or dark brown, flammable natural hydrocarbon. Includes asphalts, resinous waxes and related products"@en,
        "Hidrocarburo natural sólido o semisólido, de color negro o pardo oscuro, inflamable. incluye a los asfaltos, las ceras resinosas y los productos afines"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/bitumen> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "bitumen"@en,
        "bitumen"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/blastomilonita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mylonitic rock that has undergone static recrystallization of part of its fabric after deformation"@en,
        "Roca milonítica que ha sufrido recristalización estática de parte de la fábrica después de la deformación"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "blastomylonite"@en,
        "blastomilonita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bloque> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Clast with a diameter exceeding 256 mm"@en,
        "Clasto de diámetro mayor de 256 mm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "block"@en,
        "bloque"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/gravelSizeSediment>,
        <http://resource.geosciml.org/classifier/cgi/lithology/gravel_size_sediment> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bloque-piroclastico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Angular or subangular pyroclast with a diameter exceeding 64 mm"@en,
        "Piroclasto anguloso o subanguloso de diámetro superior a 64 mm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "pyroclastic block"@en,
        "bloque piroclástico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/tephra>,
        <http://resource.geosciml.org/classifier/cgi/lithology/tephra> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/bomba-volcanica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Juvenile pyroclast with a diameter exceeding 64 mm, rounded or spindle-shaped in outline due to having completed its solidification while rotating in the air"@en,
        "Piroclasto juvenil de diámetro superior a 64 mm, de contorno redondeado o fusiforme por haber completado su consolidación girando en el aire"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "volcanic bomb"@en,
        "bomba volcánica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/ashBrecciaBombOrBlockTephra>,
        <http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/boninita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Andesite with high MgO content (more than 8%), TiO2 contents below 0.5% and SiO2 above 52%, which usually contains olivine and pyroxene in a glassy groundmass with textures characteristic of rapid growth"@en,
        "Andesita de alto contenido en mgo más del 8%, con cantidades de tio2 inferiores al 0,5% y de sio2 superiores al 52%, que suele contener olivino y piroxeno, en una matriz vítrea con texturas características de crecimiento rápido"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/boninite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/boninite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "boninite"@en,
        "boninita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/borax> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed by the mineral of the same name, with the formula Na2B4O7·10H2O, belonging to the class of borates, crystallizing in the monoclinic system forming large prismatic crystals or earthy masses. It is colourless or whitish, although it generally presents grey or bluish hues, with vitreous lustre and varying from transparent to translucent"@en,
        "Roca formada por el mineral del mismo nombre, de fórmula na2b4o7.10h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema monoclínico formando grandes cristales prismáticos o masas terrosas. es incoloro o blanquecino, aunque generalmente presenta tonalidades grises o azuladas, tiene brillo vítreo y varía de transparente a translúcido"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "borax"@en,
        "bórax"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/evaporite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sedimentary rock consisting of more than 50% angular detrital elements with a diameter exceeding 2 mm, bound by a cement or fine detrital matrix"@en,
        "Roca sedimentaria constituida, en más de un 50%, por elementos detríticos angulosos de más de 2 mm de diámetro y trabados por un cemento o una matriz detrítica fina"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/breccia>,
        <http://resource.geosciml.org/classifier/cgi/lithology/breccia> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "breccia"@en,
        "brecha"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-arenosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Detrital rock consisting of 30-50% angular clasts with a diameter exceeding 2 mm and with a sand-size element content greater than that of pelite-size elements"@en,
        "Roca detrítica constituida en un 30-50% por clastos angulosos de más de 2 mm de diámetro y con un contenido de elementos de tamaño arena mayor que el de elementos de tamaño pelita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "sandy breccia"@en,
        "brecha arenosa"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/breccia>,
        <http://resource.geosciml.org/classifier/cgi/lithology/breccia> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-autoclastica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Breccia composed of volcanic rock fragments generated by mechanical friction during lava movement"@en,
        "Brecha constituida por fragmentos de rocas volcánicas generados por fricción mecánica durante el movimiento de la lava"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "autoclastic breccia"@en,
        "brecha autoclástica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-de-explosion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Pyroclastic deposit consisting of lithic pyroclasts transported ballistically, characteristic of phreatic and phreatomagmatic eruptions"@en,
        "Depósito piroclástico constituido por piroclastos líticos transportados balísticamente, característico de erupciones freáticas y freatomagmáticas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "explosion breccia"@en,
        "brecha de explosión"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-de-falla> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Fault rock without tectonic foliation or with poorly developed foliation, consisting of more than 30% of porphyroclasts, usually angular, and rock fragments, embedded in a matrix of similar composition produced by brittle deformation with crystal grain size reduction and slightly recrystallized"@en,
        "Roca de falla sin foliación tectónica o con un desarrollo pobre de ella, constituida en más de un 30% por porfiroclastos, habitualmente angulosos, y fragmentos de roca, embebidos en una matriz de composición similar producida por deformación frágil con reducción del tamaño de grano cristalino y ligeramente recristalizada"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/breccia-gougeSeries>,
        <http://resource.geosciml.org/classifier/cgi/lithology/breccia_gouge_series> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "fault breccia"@en,
        "brecha de falla"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-de-impacto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Breccia containing fragments that show unequivocal evidence of having undergone shock metamorphism; typically produced around, within and below an impact crater"@en,
        "Brecha que contiene fragmentos que muestran evidencias inequívocas de haber sufrido un metamorfismo de choque, típicamente se produce alrededor, dentro y debajo de un cráter de impacto"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "impact breccia"@en,
        "brecha de impacto"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/impactGeneratedMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/impact_generated_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-intrusiva> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Breccia formed by angular fragments of an igneous rock enclosed within another igneous rock of different composition. It is produced by hydraulic or magmatic fracturing during the intrusion process"@en,
        "Brecha formada por fragmentos angulosos de una roca ígnea, englobados por otra roca ígnea de diferente composición. se produce por fracturación hidráulica o magmática durante el proceso de intrusión"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "intrusive breccia"@en,
        "brecha intrusiva"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/brecha-monogenica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
