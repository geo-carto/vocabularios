        "malecón"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicConsolidatedMaterial> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/malignita> a skos:Concept ;
