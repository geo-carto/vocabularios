<https://geo-carto.github.io/vocabularios/material-igme/ceniza> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "1. Pyroclast with a grain size below 2 mm. 2. Pyroclastic deposit formed by more than 75% by volume of fragments with a diameter below 2 mm"@en,
        "1. piroclasto de tamaño de grano inferior a 2 mm. 2. depósito piroclástico formado en más de un 75% de su volumen por fragmentos de diámetro inferior a 2 mm"@es ;
