<https://geo-carto.github.io/vocabularios/material-igme/monzodiorita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock belonging to the group of dioritoids, containing quartz in an amount not exceeding 5% of the felsic minerals, and which in addition to plagioclase contains alkali feldspar in amounts between 10 and 35% of the feldspars"@en,
        "Roca plutónica perteneciente al grupo de los dioritoides, que contiene cuarzo en una cantidad que no supera el 5% de los minerales félsicos y que además de plagioclasa contiene feldespato alcalino en cantidades comprendidas entre el 10 y el 35% de los feldespatos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/monzodiorite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/monzodiorite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
