    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/marga> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Earthy-looking and easily erodible sedimentary rock containing between 35 and 65% calcium carbonate and the remainder mudstone"@en,
        "Roca sedimentaria de aspecto terroso y fácilmente erosionable, que contiene entre un 35 y un 65% de carbonato cálcico y el resto, de lutita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "marl"@en,
        "marga"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateMudstone>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateRichMudstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mudstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mudstone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/margocaliza> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Regular alternation of decimetre-thick layers of limestones and marls. Its use is not recommended to designate a clayey or marly limestone"@en,
        "Alternancia regular de capas decimétricas de calizas y margas. no es recomendable su uso para designar una caliza arcillosa o margosa"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "limestone-marl alternation"@en,
        "margocaliza"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/limestone>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/limestone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/mariupolita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Variety of nepheline syenite lacking potassic feldspar"@en,
        "Variedad de sienita nefelínica carente de feldespato potásico"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "mariupolite"@en,
        "mariupolita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingSyenite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_syenite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/marmol> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Metamorphic rock formed by more than 50% carbonates (calcite, aragonite, dolomite), generally of granoblastic texture and massive structure, derived from limestones and dolomites. Pure marble contains more than 95% carbonates. When impure (50-95% carbonates) it contains other minerals, which may be very varied (calcic amphibole and clinopyroxene, epidote, grossular, olivine, talc, chlorite, micas, etc.)"@en,
        "Roca metamórfica formada en más del 50 % por carbonatos calcita, aragonito, dolomita, generalmente de textura granoblástica y estructura masiva, derivada de calizas y dolomías. el mármol puro contiene más del 95% de carbonatos. cuando es impuro 50-95% de carbonatos contiene otros minerales, que pueden ser muy variados anfíbol y clinopiroxeno cálcicos, epidota, grosularia, olivino, talco, clorita, micas, etc.."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/marble>,
        <http://resource.geosciml.org/classifier/cgi/lithology/marble> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "marble"@en,
        "mármol"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-acido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous material containing more than 66% silica"@en,
        "Material ígneo que contiene más del 66% de sílice"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/acidicIgneousMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/acidic_igneous_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "acidic material"@en,
        "material ácido"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-antropico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Accumulation of materials, compacted or uncompacted, due exclusively to human action"@en,
        "Acumulación de materiales, compactados o sin compactar, debida exclusivamente a la acción humana"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicMaterial>,
