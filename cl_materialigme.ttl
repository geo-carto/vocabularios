<https://geo-carto.github.io/vocabularios/material-igme/opalo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Amorphous mineral of the silica group, with the formula SiO2·nH2O, forming nodules and concretions. With very diverse colours and hues, varying from transparent to opaque, it has vitreous to resinous lustre and conchoidal fracture"@en,
        "Mineral amorfo del grupo de la sílice, de fórmula sio2.nh2o, que forma nódulos y concreciones. de coloraciones y tonalidades muy diversas, varía de transparente a opaco, posee brillo de vítreo a resinoso y tiene fractura concoidea"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "opal"@en,
        "ópalo"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

