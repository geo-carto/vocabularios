    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-clastico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "material detrítico"@es ;
    skos:definition "Sedimentary material composed of more than 50% fragments from pre-existing rocks and minerals"@en,
        "Dimentario compuesto en más de un 50% por fragmentos de otras rocas y minerales preexistentes"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "clastic material"@en,
        "material clástico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-compuesto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material consisting of a grouping of particles of terrestrial origin, which may include other composite materials"@en,
        "Material constituido por una agrupación de partículas de origen terrestre, pudiendo incluir otros materiales compuestos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/compoundMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/compound_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "composite material"@en,
        "material compuesto"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-de-falla> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material formed as a result of deformation in a fault zone"@en,
        "Material formado como resultado de la deformación en una zona de falla"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fault-relatedMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fault_related_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "fault material"@en,
        "material de falla"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-de-falla-no-cohesivo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Fault material with features indicating loss of cohesion during deformation, such as empty or filled void spaces or non-consolidated matrix material between the fragments. Includes breccias and fault gouges"@en,
        "Material de falla con rasgos que indican pérdida de cohesión durante la deformación, tales como espacios vacíos rellenos o no o material con matriz no consolidada entre los fragmentos. incluye las brechas y las harinas de falla"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "non-cohesive fault material"@en,
        "material de falla no cohesivo"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/breccia-gougeSeries>,
        <http://resource.geosciml.org/classifier/cgi/lithology/breccia_gouge_series> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-epiclastico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Volcaniclastic material containing volcanic fragments showing evidence of having been transported by some sedimentary medium"@en,
        "Material volcanoclástico que contiene fragmentos de origen volcánico con evidencias de haber sido transportados por algún medio sedimentario"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "epiclastic material"@en,
        "material epiclástico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-igneo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material resulting from the cooling and solidification of a magma. It can be volcanic or plutonic, depending on whether it is emplaced at the surface or in the interior of the Earth's crust"@en,
        "Material resultante del enfriamiento y la solidificación de un magma. puede ser volcánico o plutónico, según se emplace en la superficie o en el interior de la corteza terrestre"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/igneousMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/igneous_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "igneous material"@en,
        "material ígneo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-igneo-fragmentario> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material formed more than 75% by fragments resulting from an igneous process, regardless of its degree of consolidation. Includes pyroclastic materials and intrusive and volcanic breccias"@en,
        "Material formado en más del 75% por fragmentos resultantes de un proceso ígneo, independientemente de su grado de consolidación. incluye los materiales piroclásticos y las brechas intrusivas y volcánicas"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "fragmental igneous material"@en,
        "material ígneo fragmentario"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-igneo-intermedio> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous material whose silica content is between 52 and 66%"@en,
        "Material ígneo cuyo contenido en sílice está comprendido entre el 52 y el 66%"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/intermediateCompositionIgneousMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/intermediate_composition_igneous_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "intermediate igneous material"@en,
        "material ígneo intermedio"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-metamorfico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Material derived from a pre-existing rock, through mineralogical, chemical or structural changes, essentially in solid state, in response to physicochemical variations, mainly of pressure and temperature, excluding materials derived from weathering or soil-forming processes"@en,
        "Material derivado de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales, en estado sólido esencialmente, en respuesta a variaciones físico-químicas, principalmente de presión y temperatura, quedando excluidos los materiales derivados de procesos de meteorización o formación de suelos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "metamorphic material"@en,
        "material metamórfico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisRock>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/faultRelatedMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_rock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fault_related_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-natural-no-consolidado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Natural, unconsolidated material. Includes sediments, volcaniclastic deposits and non-cohesive fault materials"@en,
        "Material de origen natural sin compactar. incluye los sedimentos, los depósitos volcanoclásticos y los materiales de falla no cohesivos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/naturalUnconsolidatedMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/natural_unconsolidated_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "unconsolidated natural material"@en,
        "material natural no consolidado"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/material-no-consolidado> a skos:Concept ;
