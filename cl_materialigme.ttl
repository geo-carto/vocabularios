<https://geo-carto.github.io/vocabularios/material-igme/espeleotema> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Chemical precipitate, generally of calcium carbonate or sulfate, formed by the action of water in a cave. The most well-known are stalactites and stalagmites"@en,
        "Precipitado químico, generalmente de carbonato o sulfato cálcicos, formado por la acción del agua en una cueva. los más conocidos son las estalactitas y las estalagmitas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "speleothem"@en,
        "espeleotema"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/breccia>,
        <http://resource.geosciml.org/classifier/cgi/lithology/breccia> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/espesartita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Calc-alkaline lamprophyre rich in amphibole and plagioclase"@en,
        "Lamprófido calcoalcalino rico en anfíbol y plagioclasa"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "spessartite"@en,
