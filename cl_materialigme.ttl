    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "1. Limestone composed fundamentally of silt-size carbonate grains. 2. Siltstone consisting predominantly of carbonate clasts"@en,
