    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Mafic or near-ultramafic rock with high MgO and K2O content, which in addition to olivine contains amphibole, phlogopite or both minerals. A more mafic variety than appinite"@en,
