    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sediment with a calcite plus aragonite content greater than that of dolomite and in which carbonate minerals constitute between 50 and 90% of the total"@en,
