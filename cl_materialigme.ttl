    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Limestone with an allochem content exceeding 10% of the total rock"@en,
        "Caliza con un contenido en aloquímicos superior al 10% del total de la roca"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "allochemical limestone"@en,
