<https://geo-carto.github.io/vocabularios/material-igme/lutita-conglomeratica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Poorly sorted detrital rock with a pelite-size element content greater than that of sand-size elements and a gravel-size content between 5 and 30% of the total"@en,
        "Roca detrítica poco seleccionada, con un contenido de elementos de tamaño pelita superior al de elementos de tamaño arena y con un contenido de tamaño grava comprendido entre el 5 y el 30% del total"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "conglomeratic mudstone"@en,
        "lutita conglomerática"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/lutita-margosa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "lutita calcárea"@es ;
    skos:definition "Detrital sedimentary rock with a combined content of pelite-size elements and calcium carbonate equal to or exceeding 90% of the total, and in which the ratio of mudstone-size elements to carbonate is between 65 and 90%"@en,
        "Roca sedimentaria detrítica con un contenido conjunto de elementos de tamaño pelita y de carbonato cálcico igual o superior al 90% del total y en la que la relación de elementos de tamaño lutita con respecto al carbonato está comprendida entre el 65 y el 90%"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "marly mudstone"@en,
        "lutita margosa"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mud> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/lutita-s.l.> a skos:Concept ;
