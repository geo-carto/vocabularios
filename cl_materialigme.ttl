<https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-hibrida> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock composed of three or more components, each of which constitutes between 5 and 50% of the rock, and which cannot be included in any other rock category by its composition or origin"@en,
        "Roca integrada por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% de la misma, y que no puede incluirse en ninguna otra categoría de roca por su composición u origen"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "hybrid sedimentary rock"@en,
        "roca sedimentaria híbrida"@es ;
