        <http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/espiculita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Siliceous rock, generally with 50-90% porosity, formed mainly by sponge spicules"@en,
        "Roca silícea, generalmente con una porosidad del 50-90%, formada principalmente por espículas de esponjas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "spiculite"@en,
        "espiculita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/siliceousOoze>,
        <http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/espigon> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "rompeolas"@es ;
    skos:definition "Projecting mass constructed on a riverbank or sea coast to protect the margins or modify the current"@en,
        "Macizo saliente que se construye a la orilla de un río o en la costa del mar, para defender las márgenes o modificar la corriente"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "breakwater"@en,
        "espigón"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicUnconsolidatedMaterial>,
        <http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_unconsolidated_material> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/espilita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Retrograded, generally vesicular basaltic rock in which the feldspar has been albitized and is accompanied by chlorite, epidote, prehnite and other low-temperature hydrated minerals"@en,
        "Roca basáltica retrogradada, generalmente vesicular, en la que el feldespato ha sido albitizado y aparece acompañado de clorita, epidota, prehnita y otros minerales de baja temperatura hidratados"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/spilite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/spilite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "spilite"@en,
        "espilita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/esquisto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Medium-grained, foliated and fissile metamorphic rock composed essentially of quartz and micas"@en,
        "Roca metamórfica de grano medio, foliada y fisible, compuesta esencialmente por cuarzo y micas"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/schist>,
        <http://resource.geosciml.org/classifier/cgi/lithology/schist> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "schist"@en,
        "esquisto"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/esquisto-anfibolico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Low-temperature, medium- to low-pressure metamorphic rock, schistose and green in colour due to the presence of chlorite and calcic amphibole (typically actinolite), in addition to epidote and albite, generally resulting from the metamorphism of mafic igneous rocks of basaltic composition. Its use is recommended instead of 'greenschist', as that is a facies name"@en,
        "Roca metamórfica de baja temperatura y presión media-baja, esquistosa y de color verde debido a la presencia de clorita y anfíbol cálcico típicamente actinolita, además de epidota y albita, generalmente resultante del metamorfismo de rocas magmáticas de composición basáltica. se recomienda su uso en vez de esquisto verde, por ser éste un nombre de facies"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "amphibolic schist"@en,
        "esquisto anfibólico"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/chloriteActinoliteEpidoteMetamorphicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/chlorite_actinolite_epidote_metamorphic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/esquisto-glaucofanico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "High-pressure, medium- to low-temperature metamorphic rock, schistose and bluish in colour due to the presence of alkalic amphibole (typically glaucophane), generally resulting from the metamorphism of mafic igneous rocks of basaltic composition. Its use is recommended instead of 'blueschist', as that is a facies name"@en,
        "Roca metamórfica de alta presión y temperatura media-baja, esquistosa y de color azulado debido a la presencia de anfíbol alcalino típicamente glaucofana, generalmente resultante del metamorfismo de rocas magmáticas de composición basáltica. se recomienda su uso en vez de esquisto azul, por ser éste un nombre de facies"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/glaucophaneLawsoniteEpidoteMetamorphicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/glaucophane_lawsonite_epidote_metamorphic_rock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "glaucophane schist"@en,
        "esquisto glaucofánico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/esquisto-micaceo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
