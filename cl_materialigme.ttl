<https://geo-carto.github.io/vocabularios/material-igme/mangerita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock belonging to the charnockitic rock family, equivalent to a monzonite with orthopyroxene"@en,
        "Roca perteneciente a la familia de las rocas charnoquíticas, equivalente a una monzonita con ortopiroxeno"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
