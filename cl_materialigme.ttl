    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Intramicrite in which more than 25% of the allochems have a diameter exceeding 2 mm"@en,
        "Intramicrita en la que más del 25% de los aloquímicos tienen un diámetro superior a 2 mm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
