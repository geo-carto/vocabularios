    skos:definition "Plutonic rock consisting of calcic plagioclase and equal amounts of clinopyroxene and orthopyroxene"@en,
        "Roca plutónica constituida por plagioclasa cálcica e igual cantidad de clinopiroxeno y ortopiroxeno"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
