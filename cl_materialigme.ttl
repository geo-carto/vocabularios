<https://geo-carto.github.io/vocabularios/material-igme/arena-calcarea> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Detrital sediment in which the combined content of sand grains (regardless of composition) and calcium carbonate material equals or exceeds 90% of the total, and in which the ratio of sand grains to calcium carbonate material is between 50 and 90%"@en,
        "Sedimento detrítico en el que el contenido conjunto de granos de arena independientemente de su composición y de material constituido por carbonato cálcico es igual o superior al 90% del total y en el que la relación de los granos de arena con respecto al material constituido por carbonato cálcico está comprendida entre el 50 y el 90%"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "calcareous sand"@en,
        "arena calcárea"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/sand>,
        <http://resource.geosciml.org/classifier/cgi/lithology/sand> ;
