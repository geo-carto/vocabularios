    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparSyenite>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAlkaliFeldsparTrachyte>,
        <http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachyte> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/ambar> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Amorphous mineral of organic origin, translucent, yellow or brown in colour and with resinous lustre, resulting from the spontaneous polymerization of the resin of fossil conifers. It may contain fossils, mainly insects, well preserved"@en,
        "Roca o mineral amorfo de origen orgánico, translúcido, de color amarillo o pardo y brillo resinoso, resultante de la polimerización espontánea de la resina de coníferas fósiles. puede contener fósiles, principalmente insectos, bien conservados"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "amber"@en,
        "ámbar"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/andesita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Intermediate, calc-alkaline volcanic rock, light grey and generally porphyritic, formed by plagioclase accompanied by one or more ferromagnesian minerals (hornblende, biotite, orthopyroxene or clinopyroxene). It is distinguished from basalt by the composition of plagioclase (andesine or less calcic), the frequent presence of amphibole and its basic-intermediate composition. Its plutonic equivalent is diorite-quartz diorite-quartz monzodiorite"@en,
        "Roca volcánica intermedia, calcoalcalina, de color gris claro y generalmente porfídica, formada por plagioclasa acompañada por uno o más minerales ferromagnesianos hornblenda, biotita, ortopiroxeno o clinopiroxeno. se distingue del basalto por la composición de la plagioclasa andesina o menos cálcica, la frecuente presencia de anfíbol y su composición básica-intermedia. su equivalente plutónico es la diorita-cuarzodiorita-cuarzomonzodiorita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/andesite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/andesite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "andesite"@en,
        "andesita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/andesita-basaltica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Intermediate or basic, subalkaline or calc-alkaline volcanic rock, with plagioclase of similar composition to that of andesite and with ferromagnesian minerals characteristic of basalts"@en,
        "Roca volcánica intermedia o básica, subalcalina o calcoalcalina, con plagioclasa de composición similar a la de la andesita y con minerales ferromagnesianos característicos de los basaltos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "basaltic andesite"@en,
        "andesita basáltica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/andesite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/andesite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/anfibolita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Dark green metamorphic rock composed mainly of amphibole and plagioclase (more than 75% in total and more than 30% amphibole), which may contain, in more subordinate amounts, quartz, clinopyroxene, garnet, minerals of the epidote group, biotite, titanite, rutile, ilmenite and scapolite"@en,
        "Roca metamórfica de color verde oscuro, compuesta principalmente por anfíbol y plagioclasa más del 75 % en conjunto y más del 30% de anfíbol y que puede contener, en cantidades más subordinadas, cuarzo, clinopiroxeno, granate, minerales del grupo de la epidota, biotita, titanita, rutilo, ilmenita y escapolita"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/amphibolite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/amphibolite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "amphibolite"@en,
        "anfibolita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/anhidrita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock formed by the mineral of the same name, with the formula CaSO4, belonging to the class of sulfates, crystallizing in the orthorhombic system, generally forming massive or fibrous aggregates. It is colourless or white, grey or sometimes bluish, with vitreous to pearly lustre and varying from transparent to opaque"@en,
        "Roca formada por el mineral del mismo nombre, de fórmula caso4, perteneciente a la clase de los sulfatos, que cristaliza en el sistema rómbico, formando, generalmente, agregados masivos o fibrosos. es incoloro o de color blanco, gris o a veces azulado, tiene brillo de vítreo a nacarado y varía de transparente a opaco"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "anhydrite"@en,
        "anhidrita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/gypsumOrAnhydrite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/rock_gypsum_or_anhydrite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/ankaramita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Picritic basalt in which clinopyroxene phenocrysts are very abundant owing to the anomalously high Ca content of the parent magma"@en,
        "Basalto picrítico en el que son muy abundantes los fenocristales de clinopiroxeno debido al contenido anómalamente alto en ca del magma del que proceden"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ankaramite"@en,
        "ankaramita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/basalt>,
        <http://resource.geosciml.org/classifier/cgi/lithology/basalt> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/ankaratrita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Melanocratic olivine nephelinite with biotite"@en,
        "Nefelinita olivínica melanocrática con biotita"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ankaratrite"@en,
        "ankaratrita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foidite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/anortosita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock composed almost exclusively of calcic plagioclase; ferromagnesian minerals (olivine, pyroxenes and, less frequently, amphibole) constitute less than 10% of the rock volume"@en,
        "Roca plutónica compuesta casi exclusivamente por plagioclasa cálcica, los minerales ferromagmesianos olivino, piroxenos y, menos frecuentemente, anfíbol constituyen menos del 10% del volumen de la roca"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/anorthosite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/anorthosite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "anorthosite"@en,
        "anortosita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/anortosita-con-foides> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock belonging to the group of anorthositic rocks, containing feldspathoids"@en,
        "Roca plutónica perteneciente al grupo de las rocas anortosíticas, que contiene feldespatoides"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAnorthosite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_anorthosite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "foid-bearing anorthosite"@en,
        "anortosita con foides"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/antracita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Hard, black coal variety with semi-metallic lustre and semi-conchoidal fracture, which burns with difficulty and without smoke. Its carbon content exceeds 90% and the volatile matter content is below 14%"@en,
        "Variedad de carbón dura, negra, con brillo semimetálico y fractura semiconcoidea, que arde con dificultad y quema sin humo. su contenido en carbono es mayor del 90% y el de volátiles, menor del 14%"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/anthraciteCoal>,
        <http://resource.geosciml.org/classifier/cgi/lithology/anthracite_coal> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "anthracite"@en,
        "antracita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/aplita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Igneous rock of granitic composition, light-coloured and fine-grained, with aplitic or saccharoidal texture, sometimes associated with pegmatites. It may appear as dykes or small stocks within granitic plutons"@en,
        "Roca ígnea de composición granítica, color claro y grano fino, con textura aplítica o sacaroidea, a veces asociada a pegmatitas. puede aparecer como diques o como pequeños stocks dentro de los plutones graníticos"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/aplite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/aplite> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "aplite"@en,
        "aplita"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/appinita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Gabbro or monzogabbro with high MgO and K2O content, rich in amphibole and phlogopite, with frequent cumulate textures. It forms a series with more mafic, almost ultramafic rocks, such as cortlandtites"@en,
        "Gabro o monzogabro con alto contenido en mgo y k2o, rico en anfíbol y flogopita y con frecuentes texturas acumuladas. forma una serie con rocas más máficas, casi ultramáficas, como las cortlandtitas"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "appinite"@en,
        "appinita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/monzogabbroicRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/monzogabbroic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/arcilla> a skos:Concept ;
