<https://geo-carto.github.io/vocabularios/material-igme/meimechita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Komatiitic rock with a TiO2 content exceeding 1%. If the TiO2 content is below 1%, the rock is called komatiite"@en,
