<https://geo-carto.github.io/vocabularios/material-igme/chert> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:altLabel "pedernal, sílex"@es ;
    skos:definition "Siliceous sedimentary rock consisting of the cryptocrystalline quartz variety of the same name. It is dense, generally with porosity below 10%, very hard and commonly found in aggregates of variable colour, from brown to yellowish or black, associated with sedimentary formations. It has a vitreous lustre"@en,
        "Roca sedimentaria silícea constituida por la variedad criptocristalina del cuarzo del mismo nombre. es densa, generalmente de porosidad inferior al 10%, muy dura y suele encontrarse en agregados de color variable, de pardo a amarillento o negro, asociada a formaciones sedimentarias. posee brillo vítreo"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "chert"@en,
        "chert"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

