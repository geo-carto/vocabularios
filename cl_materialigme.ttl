<https://geo-carto.github.io/vocabularios/material-igme/brecha-volcanica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Breccia composed of volcanic rock fragments, including fragments of solidified lava and material torn from volcanic conduits during eruptions"@en,
        "Brecha constituida por fragmentos de rocas volcánicas, incluyendo fragmentos de lava solidificada y de material arrancado de los conductos volcánicos durante las erupciones"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "volcanic breccia"@en,
        "brecha volcánica"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/calcarenita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "1. Limestone composed fundamentally of sand-size carbonate grains. 2. Sandstone consisting predominantly of carbonate or bioclast clasts"@en,
        "1. Caliza compuesta fundamentalmente por granos carbonáticos de tamaño arena. 2. Arenisca constituida mayoritariamente por clastos de carbonatos o de bioclastos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
