    skos:definition "Fine-grained sedimentary rock with oily or bituminous impregnations from which liquid or gaseous hydrocarbons can be obtained by distillation or using solvents"@en,
        "Roca sedimentaria de grano fino con impregnaciones oleosas o bituminosas de las que, por destilación o mediante disolventes, pueden obtenerse hidrocarburos líquidos o gaseosos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "bituminous shale"@en,
        "lutita bituminosa"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone>,
        <http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
