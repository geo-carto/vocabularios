    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/ignimbrita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Rock originating from a pyroclastic flow of bomb- or lapilli-sized pumice fragments, and subordinate lithic fragments, immersed in a groundmass of glass fragments, lithics and ash-sized crystals. During compaction, juvenile pumice fragments are flattened and acquire lenticular shapes called fiamme"@en,
        "Roca originada por flujo piroclástico de fragmentos de pumita de tamaño bomba o lapilli, y fragmentos líticos subordinados, inmersos en una matriz de fragmentos de vidrio, líticos y cristales de tamaño ceniza. durante la compactación los fragmentos juveniles de pumita se aplastan y adquieren formas lenticulares denominadas fiames fiamme"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ignimbrite"@en,
        "ignimbrita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/ijolita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Plutonic rock of the foidolite family, composed of similar amounts of nepheline and clinopyroxene, generally aegirine-augite or aegirine"@en,
        "Roca plutónica de la familia de las foidolitas, compuesta por cantidades similares de nefelina y clinopiroxeno, generalmente augita egirínica o egirina"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "ijolite"@en,
        "ijolita"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foidolite> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/material-igme/intraesparita> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Sparitic allochemical limestone in which more than 25% of the allochems correspond to intraclasts"@en,
        "Caliza aloquímica esparítica en la que más del 25% de los aloquímicos corresponden a intraclastos"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "intrasparite"@en,
