<https://geo-carto.github.io/vocabularios/material-igme/clinopiroxenita-olivinica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Olivine pyroxenite consisting essentially of olivine and clinopyroxene"@en,
