        <https://geo-carto.github.io/vocabularios/material-igme/roca-madre>,
        <https://geo-carto.github.io/vocabularios/material-igme/roca-poligenica> ;
    skos:prefLabel "Collection - Major Material Groups"@en,
        "Colección - Grandes Grupos de Materiales"@es .

<https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-material-antropico> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Collection of materials belonging to the hierarchical category of Major Material Groups / Anthropic Material, characterized by representing the top-level classification that groups all accumulations of materials due exclusively to human action."@en,
        "Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Material Antrópico, que se caracteriza por representar el nivel superior de clasificación que agrupa todas las acumulaciones de materiales debidas exclusivamente a la acción humana."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:member <https://geo-carto.github.io/vocabularios/material-igme/material-antropico>,
        <https://geo-carto.github.io/vocabularios/material-igme/material-antropico-consolidado>,
        <https://geo-carto.github.io/vocabularios/material-igme/material-antropico-no-consolidado> ;
    skos:prefLabel "Collection - Major Material Groups / Anthropogenic Material"@en,
        "Colección - Grandes Grupos de Materiales / Material Antrópico"@es .

<https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-material-metamorfico> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Collection of materials belonging to the hierarchical category of Major Material Groups / Metamorphic Material, characterized by representing the top-level classification that groups all materials derived from pre-existing rocks, through mineralogical, chemical or structural changes, in solid state, in response to physicochemical variations of pressure and temperature."@en,
        "Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Material Metamórfico, que se caracteriza por representar el nivel superior de clasificación que agrupa todos los materiales derivados de rocas preexistentes, mediante cambios mineralógicos, químicos o estructurales, en estado sólido, en respuesta a variaciones físico-químicas de presión y temperatura."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:member <https://geo-carto.github.io/vocabularios/material-igme/material-metamorfico>,
        <https://geo-carto.github.io/vocabularios/material-igme/roca-metamorfica> ;
    skos:prefLabel "Collection - Major Material Groups / Metamorphic Material"@en,
        "Colección - Grandes Grupos de Materiales / Material Metamórfico"@es .

<https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-materiales-igneos> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Collection of materials belonging to the hierarchical category of Major Material Groups / Igneous Materials, characterized by representing the top-level classification that groups all materials resulting from the cooling and solidification of a magma, both volcanic and plutonic."@en,
        "Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Materiales Ígneos, que se caracteriza por representar el nivel superior de clasificación que agrupa todos los materiales resultantes del enfriamiento y la solidificación de un magma, tanto volcánicos como plutónicos."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:member <https://geo-carto.github.io/vocabularios/material-igme/material-igneo>,
        <https://geo-carto.github.io/vocabularios/material-igme/roca-ignea> ;
    skos:prefLabel "Collection - Major Material Groups / Igneous Material"@en,
        "Colección - Grandes Grupos de Materiales / Materiales Ígneos"@es .

<https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-materiales-sedimentarios> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Collection of materials belonging to the hierarchical category of Major Material Groups / Sedimentary Materials, characterized by representing the top-level classification that groups all materials formed outside the Earth's crust by a sedimentary process."@en,
        "Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Materiales Sedimentarios, que se caracteriza por representar el nivel superior de clasificación que agrupa todos los materiales formados en el exterior de la corteza terrestre mediante un proceso de sedimentación."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:member <https://geo-carto.github.io/vocabularios/material-igme/deposito>,
