    skos:altLabel "micacita, micaesquisto"@es ;
    skos:definition "Mica-rich schist derived from a pelitic protolith"@en,
        "Esquisto rico en mica, derivado de un protolito pelítico"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:prefLabel "micaceous schist"@en,
        "esquisto micáceo"@es ;
    skos:relatedMatch <http://inspire.ec.europa.eu/codelist/LithologyValue/foliatedMetamorphicRock>,
        <http://inspire.ec.europa.eu/codelist/LithologyValue/micaSchist>,
        <http://resource.geosciml.org/classifier/cgi/lithology/foliated_metamorphic_rock>,
        <http://resource.geosciml.org/classifier/cgi/lithology/mica_schist> ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/material-igme> ;
