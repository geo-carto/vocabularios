    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/material-igme> ;
    skos:definition "Micritic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio exceeding 3:1"@en,
        "Caliza aloquímica micrítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides superior a 3:1"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/material-igme> ;
