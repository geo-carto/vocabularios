    dcterms:publisher <https://www.igme.es/> ;
    owl:versionInfo "1.0.0" ;
    skos:definition "The property ContactTypeTerm classifies the contact (e.g. intrusive, unconformity, bedding surface, lithologic boundary, phase boundary) and is a term from a controlled vocabulary."@en,
        "Términos que clasifican el tipo de contacto (por ejemplo: intrusivo, discordancia, superficie de estratificación, límite litológico, límite de fase)."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Tipo de contacto."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/contacto-tipo/contacto> ;
    skos:prefLabel "Contact type"@en,
        "Tipo de contacto"@es .

