<https://geo-carto.github.io/vocabularios/contacto-tipo/collection> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contacto-tipo> ;
    skos:definition "Todos los conceptos en este vocabulario."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contacto-tipo> ;
    skos:member <https://geo-carto.github.io/vocabularios/contacto-tipo/contacto>,
        <https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-antropico>,
        <https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-concordante>,
        <https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-de-alteracion>,
        <https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-de-asociacion-mineral>,
