{"id":"https://geo-carto.github.io/vocabularios/litologia","type":"ConceptScheme","prefLabel":{"en":"Lithology","es":"Litología"},"description":{"es":"Términos que definen el material que constituye parte o la totalidad de la unidad geológica."},"publisher":{"id":"https://www.igme.es/"},"created":"2026-03-01","modified":"2026-03-01","creator":"https://commission.europa.eu/","provenance":"Términos originales de INSPIRE","versionInfo":"1.0.0","license":{"id":"https://creativecommons.org/licenses/by/4.0/"},"hasTopConcept":[{"id":"https://geo-carto.github.io/vocabularios/litologia/bitumen","prefLabel":{"en":"bitumen","es":"bitumen"},"definition":{"en":"A composite material composed primarily of bitumen and mineral aggregates, e.g. gravel","es":"Material compuesto formado principalmente por betún y agregados minerales, p. e. gravas."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/desecho","prefLabel":{"en":"waste","es":"desecho"},"definition":{"en":"Disposed, non-liquid by-products of any kind, e.g. domestic or industrial waste.","es":"Depósito de subproductos sólidos de cualquier naturaleza, p. e. residuos domésticos o industriales."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/escombera","prefLabel":{"en":"mine dump material","es":"escombera"},"definition":{"en":"Spoil, overburden and other material excavated in mining.","es":"Desechos procedentes de las excavaciones mineras."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/escombro","prefLabel":{"en":"building rubble","es":"escombro"},"definition":{"en":"Material of various size originating from broken down buildings or former road coatings.","es":"Material de tamaños distintos originado por el derribo de edificios o antiguos revestimientos de carreteras."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/escoria","prefLabel":{"en":"slag","es":"escoria"},"definition":{"en":"By-product of smelting ore and processing metals","es":"Subproducto de la fundición y el procesado de metales."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/fertilizante","prefLabel":{"en":"soil improver","es":"fertilizante"},"definition":{"en":"Material added to soil to improve plant growth and health","es":"Material que se añade al suelo para mejorar el crecimiento y la calidad de las plantas."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/horizonte-organico-del-suelo","prefLabel":{"en":"topsoil","es":"horizonte orgánico del suelo"},"definition":{"en":"The dark-colored upper portion af a soil, varying in depth according to soil type.","es":"Horizonte superior del suelo, de color oscuro, cuyo espesor varía en los distintos tipos de suelos."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/hormigon","prefLabel":{"en":"concrete","es":"hormigón"},"definition":{"en":"Hardening composite construction material composed primarily of coarse gravel, cement and water","es":"Material de construcción endurecido constituido principalmente de gravas gruesas, cemento y agua."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/lodo-industrial","prefLabel":{"en":"sludge","es":"lodo industrial"},"definition":{"en":"More or less liquid (when disposed) by-products of industrial processes","es":"Subproductos, más o menos líquidos (en el momento de su vertido), de procesos industriales."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/lodos-de-depuradora","prefLabel":{"en":"sewage sludge","es":"lodos de depuradora"},"definition":{"en":"More or less liquid (when disposed) by-products of wastewater treatment.","es":"Subproductos más o menos líquidos (en el momento de su vertido) procedentes del tratamiento de las aguas residuales."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-compuesto","prefLabel":{"en":"compound material","es":"material compuesto"},"definition":{"en":"An earth material composed of an aggregation of particles of earth material, possibly including other compound materials.","es":"Material terrestre compuesto por una agrupación de partículas de origen terrestre pudiendo incluir otros materiales compuestos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/brecha","prefLabel":{"en":"breccia","es":"brecha"},"definition":{"en":"Coarse-grained material composed of angular broken rock fragments; the fragments typically have sharp edges and unworn corners.","es":"Material de granulometría gruesa compuesto por fragmentos de roca angulares; los fragmentos suelen tener bordes afilados y esquinas sin desgastar."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-antropico","prefLabel":{"en":"anthropogenic material","es":"material antrópico"},"definition":{"en":"Material known to have artificial (human-related) origin; insufficient information to classify in more detail.","es":"Material de origen artificial (humano) conocido; la información es insuficiente para clasificarlo con mayor detalle."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/material-antropico-consolidado","prefLabel":{"en":"anthropogenic consolidated material","es":"material antrópico consolidado"},"definition":{"en":"Consolidated material known to have artificial (human-related) origin.","es":"Material consolidado de origen artificial (humano) conocido."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-antropico-no-consolidado","prefLabel":{"en":"anthropogenic unconsolidated material","es":"material antrópico no consolidado"},"definition":{"en":"Unconsolidated material known to have artificial (human-related) origin.","es":"Material no consolidado de origen artificial (humano) conocido."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-igneo","prefLabel":{"en":"igneous material","es":"material ígneo"},"definition":{"en":"Earth material formed as a result of igneous processes, e.g. intrusion and cooling of magma in the crust, volcanic eruption.","es":"Material terrestre formado como resultado de procesos ígneos, como la intrusión y enfriamiento del magma en la corteza o las erupciones volcánicas."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/material-igneo-acido","prefLabel":{"en":"acidic igneous material","es":"material ígneo ácido"},"definition":{"en":"Igneous material with more than 63 percent sio2.","es":"Material ígneo con un contenido de sio2 superior al 63 por ciento."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida","prefLabel":{"en":"acidic igneous rock","es":"roca ígnea ácida"},"definition":{"en":"Igneous rock with more than 63 percent sio2.","es":"Roca ígnea con un contenido de sio2 superior al 63 por ciento."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/dacita","prefLabel":{"en":"dacite","es":"dacita"},"definition":{"en":"Fine grained or porphyritic crystalline rock that contains less than 90 percent mafic minerals, between 20 and 60 percent quartz in the qapf fraction, and has a plagioclase to total feldspar ratio greater than 0.65. includes rocks defined modally in qapf fields 4 and 5 or chemically in tas field o3. typcially composed of quartz and sodic plagioclase with minor amounts of biotite and/or hornblende and/or pyroxene; fine-grained equivalent of granodiorite and tonalite.","es":"Roca volcánica porfídica o de grano fino compuesta generalmente por cuarzo y plagioclasa sódica, con cantidades menores de biotita y/o hornblenda y/o piroxeno; es el equivalente volcánico de la granodiorita y la tonalita. contiene menos de un 90 por ciento de minerales máficos, entre un 20 y un 60 por ciento de cuarzo, entre los componentes qapf, y una proporción entre la plagioclasa y el total de feldespato mayor del 65 por ciento. incluye a las rocas  asignadas modalmente a los sectores 4 y 5 del diagrama qapf o, químicamente, al sector o3 del diagrama tas."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/granitoide","prefLabel":{"en":"granitoid","es":"granitoide"},"definition":{"en":"Phaneritic crystalline igneous rock consisting of quartz, alkali feldspar and/or plagioclase. includes rocks defined modally in qapf fields 2, 3, 4 and 5 as alkali feldspar granite, granite, granodiorite or tonalite.","es":"Roca plutónica compuesta por cuarzo, feldespato alcalino y/o plagioclasa. incluye a las rocas de los sectores 2, 3, 4 y 5 del diagrama qapf que corresponden al granito de feldespato alcalino, granito, granodiorita y tonalita."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/granito","prefLabel":{"en":"granite","es":"granito"},"definition":{"en":"Phaneritic crystalline rock consisting of quartz, alkali feldspar and plagioclase (typically sodic) in variable amounts, usually with biotite and/or hornblende. includes rocks defined modally in qapf field 3.","es":"Granitoide compuesto por cuarzo, feldespato alcalino y plagioclasa (generalmente sódica) en proporciones variables, generalmente con biotita y/o hornblenda. incluye a las rocas del sector 3 del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/monzogranito","prefLabel":{"en":"monzogranite","es":"monzogranito"},"definition":{"en":"Granite that has a plagiolcase to total feldspar ratio between 0.35 and 0.65. qapf field 3b.","es":"Granito con una proporción de plagioclasa con respecto al total de feldespato superior 35 por ciento. incluye a las rocas del sector 3b del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sieno-granito","prefLabel":{"en":"syenogranite","es":"sieno-granito"},"definition":{"en":"Granite that has a plagioclase to total feldspar ratio between 0.10 and 0.35. qapf field 3a.","es":"Granito cuyo contenido en plagioclasa con respecto al total de feldespato es inferior al 35 por ciento. incluye a las rocas del sector 3a del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/granito-de-feldespato-alcalino","prefLabel":{"en":"alkali feldspar granite","es":"granito de feldespato alcalino"},"definition":{"en":"Granitic rock that has a plagioclase to total feldspar ratio less than 0.1. qapf field 2.","es":"Granitoide con una proporción entre la plagioclasa y el total de feldespato inferior al 10 por ciento. sector 2 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/granodiorita","prefLabel":{"en":"granodiorite","es":"granodiorita"},"definition":{"en":"Phaneritic crystalline rock consisting essentially of quartz, sodic plagioclase and lesser amounts of alkali feldspar with minor hornblende and biotite. includes rocks defined modally in qapf field 4.","es":"Granotoide compuesto principalmente por cuarzo, plagioclasa sódica y cantidades inferiores de feldespato alcalino, con contenidos menores de hornblenda y biotita. incluye a las rocas del sector 4 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/tonalita","prefLabel":{"en":"tonalite","es":"tonalita"},"definition":{"en":"Granitoid consisting of quartz and intermediate plagioclase, usually with biotite and amphibole. includes rocks defined modally in qapf field 5; ratio of plagioclase to total feldspar is greater than 0.9.","es":"Granitoide constituido por cuarzo y plagioclasa intermedia, generalmente con biotita y anfíbol, con una proporción de plagioclasa con respecto al total de feldespato mayor del 90 por ciento. incluye a las rocas del sector 5 del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/granitoide-rico-en-cuarzo","prefLabel":{"en":"quartz rich igneous rock","es":"granitoide rico en cuarzo"},"definition":{"en":"Phaneritic crystalline igneous rock that contains less than 90 percent mafic minerals and contains greater than 60 percent quartz in the qapf fraction.","es":"Roca plutónica que contiene menos de un 90 por ciento de minerales máficos y más de un 60 por ciento de cuarzo entre los componentes qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-riolitica","prefLabel":{"en":"rhyolitoid","es":"roca riolítica"},"definition":{"en":"Fine grained igneous rock consisting of quartz and alkali feldspar, with minor plagioclase and biotite, in a microcrystalline, cryptocrystalline or glassy groundmass. flow texture is common. includes rocks defined modally in qapf fields 2 and 3 or chemically in tas field r as rhyolite. qapf normative definition is based on modal mineralogy thus: less than 90 percent mafic minerals, between 20 and 60 percent quartz in the qapf fraction, and ratio of plagioclse to total feldspar is less than 0.65.","es":"Roca volcánica compuesta por cuarzo y feldespato alcalino, con presencia de plagioclasa y biotita en una  matriz microcristalina, criptocristalina o vítrea. es habitual la textura fluidal. contiene menos del 90 por ciento de minerales máficos y, en relación con sus componentes del diagrama qapf, entre un 20 y un 60 por ciento de cuarzo, así como un contenido de plagioclasa con respecto al total de feldespato inferior al 65 por ciento. engloba a las rocas incluidas modalmente en los sectores 2 y 3 del diagrama qapf, así como las incluidas químicamente en el sector r del diagrama tas."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/riolita","prefLabel":{"en":"rhyolite","es":"riolita"},"definition":{"en":"Rhyolitoid in which the ratio of plagioclase to total feldspar is between 0.1 and 0.65.","es":"Riolitoide con una proporción entre la plagioclasa y el total de feldespato superior al 10 por ciento."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/riolita-de-feldespato-alcalino","prefLabel":{"en":"alkali feldspar rhyolite","es":"riolita de feldespato alcalino"},"definition":{"en":"Rhyolitoid in which the ratio of plagioclase to total feldspar is less than 0.1. qapf field 2.","es":"Riolitoide con una proporción de plagioclasa con respecto al total de feldespato  inferior al 10 por ciento. sector 2 del diagrama qapf."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-igneo-basico","prefLabel":{"en":"basic igneous material","es":"material ígneo básico"},"definition":{"en":"Igneous material with between 45 and 52 percent sio2.","es":"Material ígneo con un contenido de sio2 entre el 45 y el 52 por ciento."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-basica","prefLabel":{"en":"basic igneous rock","es":"roca ígnea básica"},"definition":{"en":"Igneous rock with between 45 and 52 percent sio2.","es":"Roca ígnea con un contenido de sio2 comprendido entre el 45 y 52 por ciento."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/basalto","prefLabel":{"en":"basalt","es":"basalto"},"definition":{"en":"Fine-grained or porphyritic igneous rock with less than 20 percent quartz, and less than 10 percent feldspathoid minerals, in which the ratio of plagioclase to total feldspar is greater 0.65. typically composed of calcic plagioclase and clinopyroxene; phenocrysts typically include one or more of calcic plagioclase, clinopyroxene, orthopyroxene, and olivine. includes rocks defined modally in qapf fields 9 and 10 or chemically in tas field b as basalt. basalt and andesite are distinguished chemically based on silica content, with basalt defined to contain less than 52 weight percent silica. if chemical data are not available, the color index is used to distinguish the categories, with basalt defined to contain greater than 35 percent mafic minerals by volume or greater than 40 percent mafic minerals by weight.","es":"Roca volcánica porfídica o de grano fino con menos de un 20 por ciento de cuarzo y menos de un 10 por ciento de feldespatoide, entre los componentes qapf; la proporción de la plagioclasa con respecto al total de feldespato es mayor del 65 por ciento. generalmente está constituida por fenocristales de plagioclasa cálcica, clinopiroxeno y olivino. incluye a las rocas de los sectores 9 y 10 del diagrama qapf y del sector b del diagrama tas. el basalto y la andesita se diferencian químicamente por su contenido en sílice, siendo el del basalto inferior al 52 por ciento de su peso. si no se dispone de la composición química, se clasifican a partir del índice de color, en cuyo caso el basalto se define por contener más de un 35 por ciento de minerales máficos en volumen o más del 40 por ciento en peso."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/basalto-olivinico-alcalino","prefLabel":{"en":"alkali olivine basalt","es":"basalto olivínico alcalino"},"definition":{"en":"Alkali olivine basalt is silica-undersaturated, characterized by the absence of orthopyroxene, absence of quartz, presence of olivine, and typically contains some feldspathoid mineral, alkali feldspar or phlogopite in the groundmass. feldspar phenocrysts typically are labradorite to andesine in composition. augite is rich in titanium compared to augite in tholeiitic basalt. alkali olivine basalt is relatively rich in sodium.","es":"Basalto olivínico subsaturado en sílice, caracterizado por la ausencia de ortopiroxeno y cuarzo y por la presencia de olivino, así como de feldespatoide, feldespato alcalino o flogopita en la matriz. los fenocristales de feldespato varían de labradorita a andesina. la augita es rica en titanio en comparación con la augita de los basaltos toleíticos. el basalto olivínico alcalino es relativamente rico en sodio."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/basalto-toleitico","prefLabel":{"en":"tholeiitic basalt","es":"basalto toleítico"},"definition":{"en":"Tholeiitic basalt is defined here to contain 2 pyroxene phases and interstitial quartz or tridymite or cristobalite in the groundmass. pyroxene (augite and orthopyroxene or pigeonite) and calcium-rich plagioclase are common phenocryst minerals. olivine may also be a phenocryst, and when present, may have rims of pigeonite. only in tholeiitic basalt is olivine in reaction relationship with melt. interstitial siliceous residue may be present, and is often glassy. tholeiitic basalt is relatively poor in sodium. this category includes most basalts of the ocean floor, most large oceanic islands, and continental flood basalts such as the columbia river plateau.","es":"Basalto relativamente pobre en sodio, con fenocristales de piroxeno (augita y ortopiroxeno o pigeonita), plagioclasa rica en calcio y, con frecuencia, olivino que puede tener envueltas de reacción tipo \"rims\" de pigeonita, por reacción del olivino con el magma residual; se caracteriza por una matriz con dos fases de piroxeno, así como cuarzo, tridimita o cristobalita intersticiales y, a menudo, sílice intersticial de textura vítrea. esta categoría incluye a la mayoría de los basaltos de fondo oceánico y de las islas oceánicas, así como a las inundaciones basálticas continentales (\"traps\" basálticos), como la de la meseta del río columbia."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-gabroica","prefLabel":{"en":"gabbroic rock","es":"roca gabroica"},"definition":{"en":"Gabbroid that has a plagioclase to total feldspar ratio greater than 0.9 in the qapf fraction. includes qapf fields 10*, 10, and 10'. this category includes the various categories defined in lemaitre et al. (2002) based on the mafic mineralogy, but apparently not subdivided based on the quartz/feldspathoid content.","es":"Gabroide con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. engloba los sectores 10*, 10 y 10' del diagrama qapf. esta clase incluye las categorías definidas en le maitre et al. (2002) basadas en los minerales máficos, pero no subdivididas en función del contenido en cuarzo/feldespatoide."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-gabro","prefLabel":{"en":"quartz gabbro","es":"cuarzo-gabro"},"definition":{"en":"Gabbroic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 10*.","es":"Roca gabroica que contiene entre un 5 y un 20 por ciento de cuarzo entre los componentes qapf. incluye a las rocas del sector 10* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/gabro","prefLabel":{"en":"gabbro","es":"gabro"},"definition":{"en":"Gabbroic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the qapf fraction. includes rocks defined modally in qapf field 10 as gabbro.","es":"Roca gabroica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye a las rocas del sector 10 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/gabro-con-foides","prefLabel":{"en":"foid bearing gabbro","es":"gabro con foides"},"definition":{"en":"Gabbroic rock that contains 0-10 percent feldspathoid minerals and no quartz in the qapf fraction. qapf field 10'.","es":"Roca gabroica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 10' del diagrama qapf."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-igneo-de-composicion-intermedia","prefLabel":{"en":"intermediate composition igneous material","es":"material ígneo de composición intermedia"},"definition":{"en":"Igneous material with between 52 and 63 percent sio2.","es":"Material ígneo con un contenido de sio2 entre el 52 y el 63 por ciento."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-igneo-fragmentario","prefLabel":{"en":"fragmental igneous material","es":"material ígneo fragmentario"},"definition":{"en":"Igneous material of unspecified consolidation state in which greater than 75 percent of the rock consists of fragments produced as a result of igneous rock-forming process.","es":"Material ígneo con un estado de consolidación no especificado formado en más del 75 por ciento por fragmentos resultantes de un proceso ígneo."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/material-piroclastico","prefLabel":{"en":"pyroclastic material","es":"material piroclástico"},"definition":{"en":"Fragmental igneous material that consists of more than 75 percent of particles formed by disruption as a direct result of volcanic action.","es":"Material ígneo fragmentario con más de un 75 por ciento de partículas generadas como resultado directo de erupciones volcánicas."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-fragmentaria","prefLabel":{"en":"fragmental igneous rock","es":"roca ígnea fragmentaria"},"definition":{"en":"Igneous rock in which greater than 75 percent of the rock consists of fragments produced as a result of igneous rock-forming process. includes pyroclastic rocks, autobreccia associated with lava flows and intrusive breccias. excludes deposits reworked by epiclastic processes. (see tuffite).","es":"Roca ígnea en la que más del 75 por ciento son fragmentos producidos por procesos ígneos. incluye a las rocas piroclásticas, las autobrechas asociadas con flujos de lava y las brechas intrusivas. se excluyen los depósitos retrabajados por procesos epiclásticos. (ver tufita)."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-piroclastica","prefLabel":{"en":"pyroclastic rock","es":"roca piroclástica"},"definition":{"en":"Fragmental igneous rock that consists of greater than 75 percent fragments produced as a direct result of eruption or extrusion of magma from within the earth onto its surface. includes autobreccia associated with lava flows and excludes deposits reworked by epiclastic processes.","es":"Roca ígnea constituida por productos fragmentarios de los cuales más de un 75 por ciento se han producido como resultado de una erupción o extrusión de magma. incluye a las autobrechas asociadas con los flujos de lava y excluye a los depósitos retrabajados por procesos epiclásticos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/brecha-tobacea,-aglomerado-o-brecha-piroclastica","prefLabel":{"en":"tuff-breccia, agglomerate, or pyroclastic breccia","es":"brecha tobácea, aglomerado o brecha piroclástica"},"definition":{"en":"Pyroclastic rock in which greater than 25 percent of particles are greater than 64 mm in largest dimension. includes agglomerate, pyroclastic breccia of gillespie and styles (1999)","es":"Roca piroclástica en la que más del 25 por ciento de las partículas tienen más de 64 mm de longitud. incluye a los aglomerados y las brechas piroclásticas de gillespie y styles (1999)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/toba-de-ceniza,-lapillistone-y-toba-de-lapilli","prefLabel":{"en":"ash tuff, lapillistone, and lapilli tuff","es":"toba de ceniza, lapillistone y toba de lapilli"},"definition":{"en":"Pyroclastic rock in which less than 25 percent of rock by volume are more than 64 mm in longest diameter. includes tuff, lapilli tuff, and lapillistone.","es":"Roca piroclástica con un porcentaje inferior al 25 por ciento de su volumen constituido por piroclastos con más de 64 mm de longitud."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea","prefLabel":{"en":"igneous rock","es":"roca ígnea"},"definition":{"en":"Rock formed as a result of igneous processes, for example intrusion and cooling of magma in the crust, or volcanic eruption.","es":"Roca formada como resultado de procesos ígneos, como la intrusión y enfriamiento del magma en la corteza o las erupciones volcánicas."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/porfido","prefLabel":{"en":"porphyry","es":"pórfido"},"definition":{"en":"Igneous rock that contains conspicuous phenocrysts in a finer grained groundmass; groundmass itself may be phaneritic or fine-grained.","es":"Roca ígnea constituida por destacados fenocristales, en una matriz más fina, fanerítica o de grano fino."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-afanitica","prefLabel":{"en":"fine grained igneous rock","es":"roca afanítica"},"definition":{"en":"Igneous rock in which the framework of the rock consists of crystals that are too small to determine mineralogy with the unaided eye; framework may include up to 50 percent glass. a significant percentage of the rock by volume may be phenocrysts. includes rocks that are generally called volcanic rocks.","es":"Roca ígnea de matriz formada por cristales tan pequeños que no permiten su determinación mineralógica a simple vista; la pasta puede contener más de un 50 por ciento de vidrio. un porcentaje significativo de la roca pueden ser fenocristales. incluye a las rocas que generalmente se denominan volcánicas."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/andesita","prefLabel":{"en":"andesite","es":"andesita"},"definition":{"en":"Fine-grained igneous rock with less than 20 percent quartz and less than 10 percent feldspathoid minerals in the qapf fraction, in which the ratio of plagioclase to total feldspar is greater 0.65. includes rocks defined modally in qapf fields 9 and 10 or chemically in tas field o2 as andesite. basalt and andesite, which share the same qapf fields, are distinguished chemically based on silica content, with basalt defined to contain less than 52 weight percent silica. if chemical data are not available, the color index is used to distinguish the categories, with basalt defined to contain greater than 35 percent mafic minerals by volume or greater than 40 percent mafic minerals by weight. typically consists of plagioclase (frequently zoned from labradorite to oligoclase), pyroxene, hornblende and/or biotite. fine grained equivalent of dioritic rock.","es":"Roca volcánica con un contenido inferior al 20 por ciento de cuarzo y al 10 por ciento de feldespatoide, entre los componentes qapf; la relación entre la plagioclasa y el total de feldespato es superior al 65 por ciento. normalmente está formada por plagioclasa (frecuentemente zonada de labradorita a oligoclasa), piroxeno, hormblenda y/o biotita. es el equivalente de grano fino de las rocas dioríticas. incluye a las rocas cuya composición modal corresponde a los sectores 9 y 10 del diagrama qapf, o cuya composición química se sitúa en el campo o2 del diagrama tas. el basalto y la andesita comparten los mismos sectores en el diagrama qapf, diferenciándose químicamente por su contenido en sílice, siendo el del basalto inferior al 52 por ciento de su peso. si no se dispone de la composición química, se clasifican a partir del índice de color, en cuyo caso el basalto contiene más de un 35 por ciento de minerales máficos en volumen o más del 40 por ciento en peso."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/boninita","prefLabel":{"en":"boninite","es":"boninita"},"definition":{"en":"Andesitic rock that contains more than 8 percent mgo. typically consists of phenocrysts of protoenstatite, orthopyroxene, clinopyroxene, and olivine in a glassy base full of crystallites, and exhibits textures characterisitc of rapid crystal growth.","es":"Roca andesítica que contiene más de un 8 por ciento de mgo. habitualmente está constituida por fenocristales de protoenstatita, ortopiroxeno, clinopiroxeno y olivino en una pasta vítrea con microcristales y presenta texturas características de crecimiento mineral rápido."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/foiditoide","prefLabel":{"en":"foiditoid","es":"foiditoide"},"definition":{"en":"Fine grained crystalline rock containing less than 90 percent mafic minerals and more than 60 percent feldspathoid minerals in the qapf fraction. includes rocks defined modally in qapf field 15 or chemically in tas field f.","es":"Roca volcánica con menos del 90 por ciento de minerales máficos y más del 60 por ciento de feldespatoide entre los componentes qapf. incluye a las rocas del sector 15 del diagrama qapf y a las que su composición química sitúa en el sector f del diagrama tas."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/basanita-foiditica","prefLabel":{"en":"basanitic foidite","es":"basanita foidítica"},"definition":{"en":"Foiditoid that contains less than 90 percent feldspathoid minerals in the qapf fraction, and has a plagioclase to total feldspar ratio that is greater than 0.5, with greater than 10 percent normative olivine.","es":"Foiditoide que contiene menos del 90 por ciento de feldespatoide entre los componentes qapf, una proporción entre la plagioclasa y el total de feldespato mayor del 50 por ciento  y más de un 10 por ciento de olivino normativo (cipw)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/foidita","prefLabel":{"en":"foidite","es":"foidita"},"definition":{"en":"Foiditoid that contains greater than 90 percent feldspathoid minerals in the qapf fraction.","es":"Foiditoide con más del 90 por ciento de feldespatoide, entre los componentes qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/foidita-fonolitica","prefLabel":{"en":"phonolitic foidite","es":"foidita fonolítica"},"definition":{"en":"Foiditoid that contains less than 90 percent feldspathoid minerals in the qapf fraction, and has a plagioclase to total feldspar ratio that is less than 0.5","es":"Foiditoide que contiene menos de un 90 por ciento de feldespatoide, entre los componentes qapf, y cuya proporción de plagioclasa con respecto al total de feldespato es inferior al 50 por ciento."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/foidita-tefritica","prefLabel":{"en":"tephritic foidite","es":"foidita tefrítica"},"definition":{"en":"Foiditoid that contains less than 90 percent feldspathoid minerals in the qapf fraction, and has a plagioclase to total feldspar ratio that is greater than 0.5, with less than 10 percent normative olivine","es":"Foiditoide que contiene menos de un 90 por ciento de feldespatoide entre los componentes qapf y cuya proporción de plagioclasa con respecto al total de feldespato es superior al 50 por ciento, con menos de un 10 por ciento de olivino normativo (cipw)."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/fonolitoide","prefLabel":{"en":"phonolitoid","es":"fonolitoide"},"definition":{"en":"Fine grained igneous rock than contains less than 90 percent mafic minerals, between 10 and 60 percent feldspathoid mineral in the qapf fraction and has a plagioclase to total feldspar ratio less than 0.5. includes rocks defined modally in qapf fields 11 and 12, and tas field ph.","es":"Roca volcánica que contiene menos de un 90 por ciento de minerales máficos y entre un 10 y un 60 por ciento de feldespatoide entre los componentes qapf. su proporción de plagioclasa con respecto al total de feldespato es inferior al 50 por ciento. incluye a las rocas de los sectores 11 y 12 del diagrama qapf y a las del sector ph en el diagrama tas."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/fonolita","prefLabel":{"en":"phonolite","es":"fonolita"},"definition":{"en":"Phonolitoid in which the plagioclase to total feldspar ratio is less than 0.1. rock consists of alkali feldspar, feldspathoid minerals, and mafic minerals.","es":"Fonolitoide cuya proporción de plagioclasa con respecto al total de feldespato es inferior al 10 por ciento. está formada por feldespato alcalino, feldespatoide y minerales máficos."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/fonolita-tefritica","prefLabel":{"en":"tephritic phonolite","es":"fonolita tefrítica"},"definition":{"en":"Phonolitoid that has a plagioclase to total feldspar ratio between 0.1 and 0.5. broadly corresponds to tas tephriphonolite of tas field u3.","es":"Fonolitoide cuya proporción de plagioclasa con respecto al total de feldespato es superior al 10 por ciento. en sentido amplio corresponde a la tefrifonolita situada en el sector u3 del diagrama tas."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-volcanica-magnesica","prefLabel":{"en":"high magnesium fine grained igneous rock","es":"roca volcánica magnésica"},"definition":{"en":"Fine-grained igneous rock that contains unusually high concentration of mgo. for rocks that contain greater than 52 percent silica, mgo must be greater than 8 percent. for rocks containing less than 52 percent silica, mgo must be greater than 12 percent.","es":"Roca volcánica con una concentración inusualmente elevada de mgo. en rocas con un porcentaje superior al 52 de sílice, el contenido en mgo debe ser superior al 8 por ciento. en rocas con menos del 52 por ciento de sílice, el contenido de mgo debe ser superior al 12 por ciento."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-komatiitica","prefLabel":{"en":"komatiitic rock","es":"roca komatiítica"},"definition":{"en":"Ultramafic, magnesium-rich volcanic rock, typically with spinifex texture of intergrown skeletal and bladed olivine and pyroxene crystals set in abundant glass. includes komatiite and meimechite.","es":"Roca volcánica ultramáfica rica en magnesio, con típica textura spinifex constituida por intercrecimientos de cristales de olivino en forma de cuchillo y piroxeno, en una masa vítrea. incluye la komatiita y la meimechita."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/tefritoide","prefLabel":{"en":"tephritoid","es":"tefritoide"},"definition":{"en":"Fine grained igneous rock than contains less than 90 percent mafic minerals, between 10 and 60 percent feldspathoid mineral in the qapf fraction and has a plagioclase to total feldspar ratio greater than 0.5. includes rocks classified in qapf field 13 and 14 or chemically in tas field u1 as basanite or tephrite.","es":"Roca volcánica que contiene menos de un 90 por ciento de minerales máficos, de un 10 a un 60 por ciento de feldespatoide entre los componentes qapf y cuya proporción de plagioclasa con respecto al total de feldespato es superior al 50 por ciento. incluye a las rocas clasificadas modalmente en los sectores 13 y 14 del diagrama qapf, o químicamente en el campo u1 del diagrama tas como basanita o tefrita."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/basanita","prefLabel":{"en":"basanite","es":"basanita"},"definition":{"en":"Tephritoid that has a plagioclase to total feldspar ratio greater than 0.9, and contains more than 10 percent normative (cipw) olivine.","es":"Tefritoide con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento, con más de un 10 por ciento de olivino normativo (cipw)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/basanita-fonolitica","prefLabel":{"en":"phonolitic basanite","es":"basanita fonolítica"},"definition":{"en":"Tephritoid that has a plagioclase to total feldspar ratio between 0.5 and 0.9, and contains more than 10 percent normative (cipw) olivine.","es":"Tefritoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento y que contiene olivino normativo (cipw) en una proporción superior al 10 por ciento."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/tefrita","prefLabel":{"en":"tephrite","es":"tefrita"},"definition":{"en":"Tephritoid that has a plagioclase to total feldspar ratio greater than 0.9, and contains less than 10 percent normative (cipw) olivine.","es":"Tefritoide cuyo contenido en plagioclasa con respecto al total de feldespato es mayor del 90 por ciento, con menos de un 10 por ciento de olivino normativo (cipw)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/tefrita-fonolitica","prefLabel":{"en":"phonolitic tephrite","es":"tefrita fonolítica"},"definition":{"en":"Tephritoid that has a plagioclase to total feldspar ratio between 0.5 and 0.9, and contains less than 10 percent normative (cipw) olivine.","es":"Tefritoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento y que contiene olivino normativo (cipw) en una proporción inferior al 10 por ciento."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/traquitoide","prefLabel":{"en":"trachytoid","es":"traquitoide"},"definition":{"en":"Fine grained igneous rock than contains less than 90 percent mafic minerals, less than 10 percent feldspathoid mineral and less than 20 percent quartz in the qapf fraction and has a plagioclase to total feldspar ratio less than 0.65. mafic minerals typically include amphibole or mica; typically porphyritic. includes rocks defined modally in qapf fields 6, 7 and 8 (with subdivisions) or chemically in tas field t as trachyte or latite.","es":"Roca volcánica porfídica que contiene menos de un 90 por ciento de minerales máficos, menos de un 10 por ciento de feldespatoide y de un 20 por ciento de cuarzo, entre los componentes qapf, y con una proporción entre la plagioclasa y el total de feldespato inferior al 65 por ciento. entre los minerales máficos incluye habitualmente anfíbol o mica. engloba a las rocas de los sectores 6, 7 y 8 (con sus subdivisiones) del diagrama qapf o que químicamente se sitúan en el sector t del diagrama tas, como traquita o traquidacita."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-latitica","prefLabel":{"en":"latitic rock","es":"roca latítica"},"definition":{"en":"Trachytoid that has a plagioclase to total feldspar ratio between 0.35 and 0.65. qapf fields 8, 8' and 8*.","es":"Traquitoide con una proporción entre la plagioclasa y el total de feldespato superior al 65 por ciento. sectores 8, 8' y 8* del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-latita","prefLabel":{"en":"quartz latite","es":"cuarzo-latita"},"definition":{"en":"Latitic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 8*.","es":"Roca latítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 8* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/latita","prefLabel":{"en":"latite","es":"latita"},"definition":{"en":"Latitic rock that contains between 0 and 5 percent quartz and no feldspathoid in the qapf fraction. qapf field 8.","es":"Roca latítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. sector 8 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/latita-con-foides","prefLabel":{"en":"foid bearing latite","es":"latita con foides"},"definition":{"en":"Latitic rock that contains no quartz and between 0 and 10 percent feldspathoid minerals in the qapf fraction. qapf field 8'.","es":"Roca latítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 8' del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-traquitica","prefLabel":{"en":"trachytic rock","es":"roca traquítica"},"definition":{"en":"Trachytoid that has a plagioclase to total feldspar ratio between 0.1 and 0.35. qapf fields 7, 7', and 7*.","es":"Traquitoide con una proporción entre plagioclasa y el total de feldespato comprendida entre el 10 y el 35 por ciento. corresponde a los sectores 7, 7' y 7* del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-traquita","prefLabel":{"en":"quartz trachyte","es":"cuarzo-traquita"},"definition":{"en":"Trachytic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 7*.","es":"Roca traquítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 7* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/traquita","prefLabel":{"en":"trachyte","es":"traquita"},"definition":{"en":"Trachytoid that has a plagioclase to total feldspar ratio between 0.1 and 0.35, between 0 and 5 percent quartz in the qapf fraction, and no feldspathoid minerals. qapf field 7.","es":"Roca traquítica que contiene cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. corresponde al sector 7 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/traquita-con-foides","prefLabel":{"en":"foid bearing trachyte","es":"traquita con foides"},"definition":{"en":"Trachytic rock that contains between 0 and 10 percent feldspathoid in the qapf fraction, and no quartz. qapf field 7'.","es":"Roca traquítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 7' del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-traquitica-de-feldespato-alcalino","prefLabel":{"en":"alkali feldspar trachytic rock","es":"roca traquítica de feldespato alcalino"},"definition":{"en":"Trachytoid that has a plagioclase to total feldspar ratio less than 0.1. qapf fields 6, 6', and 6*.","es":"Traquitoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 10 por ciento. sectores 6, 6* y 6' del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-traquita-de-feldespato-alcalino","prefLabel":{"en":"quartz alkali feldspar trachyte","es":"cuarzo-traquita de feldespato alcalino"},"definition":{"en":"Alkali feldspar trachytic rock that contains and between 5 and 20 percent quartz mineral in the qapf fraction. qapf field 6*.","es":"Roca traquítica de feldespato alcalino que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 6* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/traquita-de-feldespato-alcalino","prefLabel":{"en":"alkali feldspar trachyte","es":"traquita de feldespato alcalino"},"definition":{"en":"Trachytoid that has a plagioclase to total feldspar ratio less than 0.1, between 0 and 5 percent quartz in the qapf fraction, and no feldspathoid minerals. qapf field 6.","es":"Roca traquítica de feldespato alcalino con cuarzo, en una proporción inferior al 5 por ciento, entre los componentes qapf. sector 6 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/traquita-de-feldespato-alcalino-con-foides","prefLabel":{"en":"foid bearing alkali feldspar trachyte","es":"traquita de feldespato alcalino con foides"},"definition":{"en":"Alkali feldspar trachytic rock that contains no quartz and between 0 and 10 percent feldspathoid mineral in the qapf fraction. qapf field 6'.","es":"Roca traquítica de feldespato alcalino con feldespatoide en proporción inferior al 10 por ciento, entre los componentes qapf. sector 6' del diagrama qapf."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-doleritica","prefLabel":{"en":"doleritic rock","es":"roca dolerítica"},"definition":{"en":"Dark colored gabbroic (basaltic) or dioritic (andesitic) rock intermediate in grain size between basalt and gabbro and composed of plagioclase, pyroxene and opaque minerals; often with ophitic texture. typically occurs as hypabyssal intrusions. includes dolerite, microdiorite, diabase and microgabbro.","es":"Roca gabroica (basáltica) o diorítica (andesítica) oscura, de tamaño de grano intermedio entre el del basalto y el gabro, compuesta por plagioclasa, piroxeno y minerales opacos, frecuentemente con textura ofítica. típica de intrusiones hipoabisales. incluye a la dolerita, microdolerita, diabasa y el microgabro."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-de-composicion-exotica","prefLabel":{"en":"exotic composition igneous rock","es":"roca ígnea de composición exótica"},"definition":{"en":"Rock with 'exotic' mineralogical, textural or field setting characteristics; typically dark colored, with abundant phenocrysts. criteria include: presence of greater than 10 percent melilite or leucite, or presence of kalsilite, or greater than 50 percent carbonate minerals. includes carbonatite, melilitic rock, kalsilitic rocks, kimberlite, lamproite, leucitic rock and lamprophyres.","es":"Roca con características mineralógicas, texturales o de afloramiento exóticas. típicamente oscura y con abundantes fenocristales. los criterios de inclusión son: un contenido mayor del 10 por ciento de melilita o leucita, o presencia de kalsilita, o un porcentaje superior al 50 por ciento de minerales carbonatados. incluye las carbonatitas, melilititas, rocas kalsilíticas, kimberlitas, lamproítas, leucititas y los lamprófidos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/carbonatita","prefLabel":{"en":"carbonatite","es":"carbonatita"},"definition":{"en":"Igneous rock composed of more than 50 percent modal carbonate minerals.","es":"Roca ígnea que en su composición modal contiene más de un 50 por ciento de minerales carbonatados."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-alcalina-exotica","prefLabel":{"en":"exotic alkaline rock","es":"roca alcalina exótica"},"definition":{"en":"Kimberlite, lamproite, or lamprophyre. generally are potassic, mafic or ultramafic rocks. olivine (commonly serpentinized in kimberlite), and phlogopite are significant constituents.","es":"Kimberlita, lamproíta o lamprófido. generalmente son rocas potásicas máficas o ultramáficas. su contenido en olivino (frecuentemente serpentinizado en la kimberlita) y en flogopita es significativo."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/rocas-kalsilititicas-y-melilititas","prefLabel":{"en":"kalsilitic and melilitic rock","es":"rocas kalsilitíticas y melilititas"},"definition":{"en":"Igneous rock containing greater than 10 percent melilite or kalsilite. typically undersaturated, ultrapotassic (kalsilitic rocks) or calcium-rich (melilitic rocks) mafic or ultramafic rocks.","es":"Rocas ígneas que contienen más de un 10 por ciento de kalsilita o melilita. generalmente son rocas máficas o ultramáficas, subsaturadas, ultrapotásicas (rocas kalsilitíticas) o ricas en calcio (melilititas)."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica","prefLabel":{"en":"phaneritic igneous rock","es":"roca ígnea fanerítica"},"definition":{"en":"Igneous rock in which the framework of the rock consists of individual crystals that can be discerned with the unaided eye. bounding grain size is on the order of 32 to 100 microns. igneous rocks with 'exotic' composition are excluded from this concept.","es":"Roca ígnea constituida por cristales que pueden distinguirse a simple vista. el tamaño de los granos es del orden de 32 a 100 micras. las rocas ígneas de composición poco habitual (exóticas) quedan excluidas de este concepto."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/aplita","prefLabel":{"en":"aplite","es":"aplita"},"definition":{"en":"Light coloured crystalline rock, characterized by a fine grained allotriomorphic-granular (aplitic, saccharoidal or xenomorphic) texture; typically granitic composition, consisting of quartz, alkali feldspar and sodic plagioclase.","es":"Roca cristalina leucocrática caracterizada por su textura alotriomórfica-equigranular de grano fino (aplítica, sacaroidea o xenomórfica), normalmente de composición granítica con cuarzo, feldespato alcalino y plagioclasa sódica."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/dioritoide-foiditico","prefLabel":{"en":"foid dioritoid","es":"dioritoide foidítico"},"definition":{"en":"Phaneritic crystalline igneous rock in which m is less than 90, the plagioclase to total feldspar ratio is greater than 0.5, feldspathoid minerals form 10-60 percent of the qapf fraction, plagioclase has anorthite content less than 50 percent. these rocks typically contain large amounts of mafic minerals. includes rocks defined modally in qapf fields 13 and 14.","es":"Roca plutónica en la que m es inferior a 90, la proporción entre la plagioclasa y el total de feldespato es mayor del 50 por ciento y el feldespatoide constituye entre un 10 y un 60 por ciento entre los componentes qapf; la plagioclasa contienen menos del 50 por ciento de anortita. comúnmente presenta un elevado contenido en minerales máficos. incluye las rocas de los sectores 13 y 14 del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/diorita-foiditica","prefLabel":{"en":"foid diorite","es":"diorita foidítica"},"definition":{"en":"Foid dioritoid in which the plagioclase to total feldspar ratio is greater than 0.9. includes rocks defined modally in qapf field 14.","es":"Dioritoide foidítico con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. incluye a las rocas del sector 14 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/monzodiorita-foiditica","prefLabel":{"en":"foid monzodiorite","es":"monzodiorita foidítica"},"definition":{"en":"Foid dioritoid in which the plagioclase to total feldspar ratio is between 0.1 and 0.9. includes rocks defined modally in qapf field 13.","es":"Dioritoide foidítico con una proporción entre la plagioclasa y el total de feldespato inferior al 90 por ciento. incluye a las rocas del sector 13 del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/foidolita","prefLabel":{"en":"foidolite","es":"foidolita"},"definition":{"en":"Phaneritic crystalline rock containing more than 60 percent feldspathoid minerals in the qapf fraction. includes rocks defined modally in qapf field 15","es":"Roca plutónica que contiene más del 60 por ciento de feldespatoide, entre los componentes qapf. incluye a las rocas del sector 15 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/gabroide","prefLabel":{"en":"gabbroid","es":"gabroide"},"definition":{"en":"Phaneritic crystalline igneous rock that contains less than 90 percent mafic minerals, and up to 20 percent quartz or up to 10 percent feldspathoid in the qapf fraction. the ratio of plagioclase to total feldspar is greater than 0.65, and anorthite content of the plagioclase is greater than 50 percent. includes rocks defined modally in qapf fields 9 and 10 and their subdivisions.","es":"Roca plutónica que contiene menos de un 90 por ciento de minerales máficos y hasta un 20 por ciento de cuarzo o un 10 por ciento de feldespatoide, entre los componentes qapf. la proporción de la plagioclasa con respecto al total de feldespato es mayor del 65 por ciento y el de anortita con respecto a la plagioclasa, mayor del 50 por ciento. incluye a las rocas de los sectores 9 y 10 (y sus subdivisiones) del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica","prefLabel":{"en":"monzogabbroic rock","es":"roca monzogabroica"},"definition":{"en":"Gabbroid with a plagioclase to total feldspar ratio between 0.65 and 0.9. qapf field 9, 9 prime and 9 asterisk","es":"Gabroide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento. incluye a las rocas de los sectores 9, 9' y 9* del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzogabro","prefLabel":{"en":"quartz monzogabbro","es":"cuarzo-monzogabro"},"definition":{"en":"Monzogabbroic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 9*.","es":"Roca monzogabroica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 9* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/monzogabro","prefLabel":{"en":"monzogabbro","es":"monzogabro"},"definition":{"en":"Monzogabbroic rock that contains between 0 an 5 percent quartz and no feldspathoid mineral in the qapf fraction. includes rocks defined modally in qapf field 9 .","es":"Roca monzogabroica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye a las rocas del sector 9 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/monzogabro-con-foides","prefLabel":{"en":"foid bearing monzogabbro","es":"monzogabro con foides"},"definition":{"en":"Monzogabbroic rock that contains 0 to 10 percent feldspathoid mineral in the qapf fraction. qapf field 9'.","es":"Roca monzogabroica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 9' del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/monzonita","prefLabel":{"en":"monzonite","es":"monzonita"},"definition":{"en":"Monzonitic rock that contains 0-5 percent quartz and no feldspathoid mineral in the qapf fraction. includes rocks defined modally in qapf field 8.","es":"Roca monzonítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye a las rocas del sector 8 del diagrama qapf."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/gabroide-foiditico","prefLabel":{"en":"foid gabbroid","es":"gabroide foidítico"},"definition":{"en":"Phaneritic crystalline igneous rock in which m is less than 90, the plagioclase to total feldspar ratio is greater than 0.5, feldspathoids form 10-60 percent of the qapf fraction, and plagioclase has anorthite content greater than 50 percent. these rocks typically contain large amounts of mafic minerals. includes rocks defined modally in qapf fields 13 and 14.","es":"Roca plutónica en la que m es inferior a 90, con una proporción entre la plagioclasa y el total de feldespato mayor del 50 por ciento y con feldespatoide en una proporción comprendida entre el 10 y el 60 por ciento entre los componentes qapf; la plagioclasa contiene más del 50 por ciento de anortita. comúnmente presenta un elevado contenido en minerales máficos. incluye a las rocas de los sectores 13 y 14 del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/gabro-foiditico","prefLabel":{"en":"foid gabbro","es":"gabro foidítico"},"definition":{"en":"Foid gabbroid that has a plagioclase to total feldspar ratio greater than 0.9. includes rocks defined modally in qapf field 14.","es":"Gabroide foidítico con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. incluye las rocas del sector 14 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/monzogabro-foiditico","prefLabel":{"en":"foid monzogabbro","es":"monzogabro foidítico"},"definition":{"en":"Foid gabbroid that has a plagioclase to total feldspar ratio between 0.5 and 0.9. includes rocks defined modally in qapf field 13.","es":"Gabroide foidítico con una proporción entre la plagioclasa y el total de feldespato inferior al 90 por ciento. incluye a las rocas del sector 13 del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/hornblendita","prefLabel":{"en":"hornblendite","es":"hornblendita"},"definition":{"en":"Ultramafic rock that consists of greater than 40 percent hornblende plus pyroxene and has a hornblende to pyroxene ratio greater than 1. includes olivine hornblendite, olivine-pyroxene hornblendite, pyroxene hornblendite, and hornblendite.","es":"Roca ultramáfica con un porcentaje superior al 40 por ciento de hornblenda más piroxeno, con una relación entre hornblenda y piroxeno mayor que 1. incluye a la hornblendita olivínica, la hornblendita olivino-piroxénica, la horblendita piroxénica y la hornblendita (s.s.)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/pegmatita","prefLabel":{"en":"pegmatite","es":"pegmatita"},"definition":{"en":"Exceptionally coarse grained crystalline rock with interlocking crystals; most grains are 1cm or more diameter; composition is generally that of granite, but the term may refer to the coarse grained facies of any type of igneous rock;usually found as irregular dikes, lenses, or veins associated with plutons or batholiths.","es":"Roca cristalina de grano excepcionalmente grueso, mayoritariamente de más de 1 cm de diámetro, con intercrecimiento de cristales; generalmente su composición es la del granito, pero se refiere a cualquier roca ígnea de grano grueso. habitualmente aparece como diques irregulares, lentejones o venas asociadas a plutones o batolitos."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/peridotita","prefLabel":{"en":"peridotite","es":"peridotita"},"definition":{"en":"Ultramafic rock consisting of more than 40 percent (by volume) olivine with pyroxene and/or amphibole and little or no feldspar. commonly altered to serpentinite. includes rocks defined modally in the ultramafic rock classification as dunite, harzburgite, lherzolite, wehrlite, olivinite, pyroxene peridotite, pyroxene hornblende peridotite or hornblende peridotite.","es":"Roca ultramáfica compuesta en más del 40 por ciento (en volumen) por olivino con piroxeno y/o anfíbol y sin, o muy escaso, feldespato. habitualmente se encuentra alterada a serpentinita. incluye las rocas definidas modalmente como dunita, harzburgita, lherzolita, wehrlita, peridotita piroxénica, peridotita hornbléndica-piroxénica o peridotita hornbléndica en la clasificación de rocas ultramáficas."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/piroxenita","prefLabel":{"en":"pyroxenite","es":"piroxenita"},"definition":{"en":"Ultramafic phaneritic igneous rock composed almost entirely of one or more pyroxenes and occasionally biotite, hornblende and olivine. includes rocks defined modally in the ultramafic rock classification as olivine pyroxenite, olivine-hornblende pyroxenite, pyroxenite, orthopyroxenite, clinopyroxenite and websterite.","es":"Roca plutónica ultramáfica formada casi en su totalidad por uno o más piroxenos y, ocasionalmente, biotita, hornblenda y olivino. incluye a las rocas definidas modalmente en las clasificaciones de rocas ultramáficas como piroxenita olivínica, piroxenita hornbléndica-olivínica, piroxenita s.s., ortopiroxenita, clinopiroxenita y websterita."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-anortositica","prefLabel":{"en":"anorthositic rock","es":"roca anortosítica"},"definition":{"en":"Leucocratic phaneritic crystalline igneous rock consisting essentially of plagioclase, often with small amounts of pyroxene. by definition, colour index m is less than 10, and plagiclase to total feldspar ratio is greater than 0.9. less than 20 percent quartz and less than 10 percent feldspathoid in the qapf fraction. qapf field 10, 10*, and 10'.","es":"Roca plutónica leucocrática constituida esencialmente por plagioclasa y habitualmente con un contenido de piroxeno muy bajo. por definición, su índice de color (m) es inferior a 10 y la proporción de la plagioclasa con respecto al total de feldespato es mayor del 90 por ciento. contiene menos del 20 por ciento de cuarzo y del 10 por ciento de feldespatoide, entre los componentes qapf. sectores 10, 10* y 10' del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/anortosita","prefLabel":{"en":"anorthosite","es":"anortosita"},"definition":{"en":"Anorthositic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the qapf fraction. qapf field 10.","es":"Roca anortosítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. sector 10 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/anortosita-con-foides","prefLabel":{"en":"foid bearing anorthosite","es":"anortosita con foides"},"definition":{"en":"Anorthositic rock that contains between 0 and 10 percent feldspathoid mineral and no quartz in the qapf fraction. qapf field 10'.","es":"Roca anortosítica con feldespatoide en proporción inferior al 10 por ciento, entre los componentes qapf. sector 10' del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-anortosita","prefLabel":{"en":"quartz anorthosite","es":"cuarzo-anortosita"},"definition":{"en":"Anorthositic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 10*.","es":"Roca anortosítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 10* del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/sienitoide","prefLabel":{"en":"syenitoid","es":"sienitoide"},"definition":{"en":"Phaneritic crystalline igneous rock with m less than 90, consisting mainly of alkali feldspar and plagioclase; minor quartz or nepheline may be present, along with pyroxene, amphibole or biotite. ratio of plagioclase to total feldspar is less than 0.65, quartz forms less than 20 percent of qapf fraction, and feldspathoid minerals form less than 10 percent of qapf fraction. includes rocks classified in qapf fields 6, 7 and 8 and their subdivisions.","es":"Roca plutónica con un índice de color m inferior a 90, compuesta principalmente por feldespato alcalino y plagioclasa; la proporción entre la plagioclasa y el total de feldespato es inferior al 65 por ciento. puede contener hasta un 20 por ciento de cuarzo, entre los componentes qapf, o hasta un 10 por ciento de feldespatoide, junto con piroxeno, anfíbol o biotita. incluye las rocas de los sectores 6, 7, 8, y sus subdivisiones, del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-monzonitica","prefLabel":{"en":"monzonitic rock","es":"roca monzonítica"},"definition":{"en":"Syenitoid with a plagioclase to total feldspar ratio between 0.35 and 0.65. includes rocks in qapf fields 8, 8*, and 8'.","es":"Sienitoide con una proporción de plagioclasa con respecto al total de feldespato superior al 35 por ciento. incluye a las rocas de los sectores 8, 8' y 8* del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzonita","prefLabel":{"en":"quartz monzonite","es":"cuarzo-monzonita"},"definition":{"en":"Monzonitic rock that contains 5-20 percent quartz iin the qapf fraction. includes rocks defined modally in qapf field 8*.","es":"Roca monzonítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 8* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/monzonita-con-foides","prefLabel":{"en":"foid bearing monzonite","es":"monzonita con foides"},"definition":{"en":"Monzonitic rock that contains 0-10 percent feldspathoid mineral and no quartz in the qapf fraction. includes rocks defined modally in qapf field 8'.","es":"Roca monzonítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 8' del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sienitica","prefLabel":{"en":"synitic rock","es":"roca sienítica"},"definition":{"en":"Syenitoid with a plagioclase to total feldspar ratio between 0.1 and 0.35. includes rocks in qapf fields 7, 7*, and 7'.","es":"Sienitoide en el que la proporción entre la plagioclasa y el total de feldespato está comprendida entre el 10 y el 35 por ciento. incluye las rocas de los sectores 7, 7' y 7* del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita","prefLabel":{"en":"quartz syenite","es":"cuarzo-sienita"},"definition":{"en":"Synitic rock that contains between 5 and 20 percent quartz in the qapf fraction. defined modally in qapf field 7*.","es":"Roca sienítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 7* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sienita","prefLabel":{"en":"syenite","es":"sienita"},"definition":{"en":"Synitic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the qapf fraction. defined modally in qapf field 7.","es":"Roca sienítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye las rocas del sector 7 del esquema qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sienita-con-foides","prefLabel":{"en":"foid bearing syenite","es":"sienita con foides"},"definition":{"en":"Synitic rock that contains between 0 and 10 percent feldspathoid mineral and no quartz in the qapf fraction. defined modally in qapf field 7'.","es":"Roca sienítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 7' del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino","prefLabel":{"en":"alkali feldspar synitic rock","es":"roca sienítica de feldespato alcalino"},"definition":{"en":"Syenitoid with a plagioclase to total feldspar ratio of less than 0.1. qapf fields 6, 6*, and 6'.","es":"Sienitoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 10 por ciento. sectores 6, 6* y 6' del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita-de-feldespato-alcalino","prefLabel":{"en":"quartz alkali feldspar syenite","es":"cuarzo-sienita de feldespato alcalino"},"definition":{"en":"Alkali feldspar synitic rock that contains 5 to 20 percent quartz and no feldspathoid in the qapf fraction. qapf field 6*.","es":"Roca sienítica de feldespato alcalino que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 6* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sienita-de-feldespato-alcalino","prefLabel":{"en":"alkali feldspar syenite","es":"sienita de feldespato alcalino"},"definition":{"en":"Alkali feldspar synitic rock that contains 0-5 percent quartz and no feldspathoid in the qapf fraction. qapf field 6.","es":"Roca sienítica de feldespato alcalino que contiene cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. sector 6 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sienita-de-feldespato-alcalino-con-foides","prefLabel":{"en":"foid bearing alkali feldspar syenite","es":"sienita de feldespato alcalino con foides"},"definition":{"en":"Alkali feldspar synitic rock that contains 0-10 percent feldspathoid mineral and no quartz in the qapf fraction. qapf field 6'.","es":"Roca sienítica de feldespato alcalino con feldespatoide en proporción inferior al 10 por ciento, entre los componentes qapf. sector 6' del diagrama qapf."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/sienitoide-foiditico","prefLabel":{"en":"foid syenitoid","es":"Sienitoide foidítico"},"definition":{"en":"Phaneritic crystalline igneous rock with m less than 90, contains between 10 and 60 percent feldspathoid mineral in the qapf fraction, and has a plagioclase to total feldspar ratio less than 0.5. includes qapf fields 11 and 12.","es":"Roca plutónica en la que el índice de color (m) es inferior a 90, la proporción entre la plagioclasa y el total de feldespato es inferior al 50 por ciento y el contenido de feldespatoide está comprendido entre el 10 y el 60 por ciento de los componentes qapf. incluye a las rocas de los sectores 11 y 12 del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/monzosienita-foiditica","prefLabel":{"en":"foid monzosyenite","es":"monzosienita foidítica"},"definition":{"en":"Foid syenitoid rock that has a plagioclase to total feldspar ratio of between 0.1 and 0.5. includes rocks defined modally in qapf field 12.","es":"Sienitoide foidítico con una proporción entre la plagioclasa y el total de feldespato superior al 10 por ciento. incluye a las rocas del sector 12 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sienita-foiditica","prefLabel":{"en":"foid syenite","es":"sienita foidítica"},"definition":{"en":"Foid syenitoid that has a plagioclase to total feldspar ratio of less than 0.1. includes rocks defined modally in qapf field 11.","es":"Sienitoide foidítico con una proporción entre la plagioclasa y el total de feldespato inferior al 10 por ciento. incluye a las rocas del sector 11 del diagrama qapf."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-intermedia","prefLabel":{"en":"intermediate composition igneous rock","es":"roca ígnea intermedia"},"definition":{"en":"Igneous rock with between 52 and 63 percent sio2.","es":"Roca ígnea con un porcentaje de sio2 comprendido entre el 52 y el 63 por ciento."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/dioritoide","prefLabel":{"en":"dioritoid","es":"dioritoide"},"definition":{"en":"Phaneritic crystalline igneous rock with m less than 90, consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite. plagioclase to total feldspar ratio is greater that 0.65, and anorthite content of plagioclase is less than 50 percent. less than 10 percent feldspathoid mineral and less than 20 percent quartz in the qapf fraction. includes rocks defined modally in qapf fields 9 and 10 (and their subdivisions).","es":"Roca plutónica compuesta por plagioclasa intermedia, comúnmente con hornblenda y de manera frecuente con biotita o augita. la proporción de la plagioclasa con respecto al total de feldespato es mayor del 65 por ciento y la proporción de anortita con respecto al total de plagioclasa es inferior al 50 por ciento. contiene menos de un 10 por ciento de feldespatoide y de un 20 por ciento de cuarzo, entre los componentes qapf. posee un índice de color m inferior a 90. incluye a las rocas modalmente incluidas en los campos 9 y 10 (y sus subdivisiones) del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-dioritica","prefLabel":{"en":"dioritic rock","es":"roca diorítica"},"definition":{"en":"Phaneritic crystalline rock with m less than 90, consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite. a dioritoid with a plagioclase to total feldspar ratio (in the qapf fraction) greater than 0.9. includes rocks defined modally in qapf fields 10, 10' and 10*.","es":"Dioritoide con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. está compuesta por plagioclasa intermedia, comúnmente con hornblenda y de manera frecuente con biotita o augita. posee un índice cromático m inferior a 90. engloba a las rocas modalmente incluidas en los campos 10, 10' y 10* del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-diorita","prefLabel":{"en":"quartz diorite","es":"cuarzo-diorita"},"definition":{"en":"Dioritic rock that contains between 5 to 20 percent quartz in the qapf fraction. qapf field 10*.","es":"Roca diorítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 10* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/diorita","prefLabel":{"en":"diorite","es":"diorita"},"definition":{"en":"Phaneritic crystalline rock consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite; colour index m less than 90, sodic plagioclase (an0-an50), no feldspathoid, and between 0 and 5 percent quartz. includes rocks defined modally in qapf field 10 as diorite.","es":"Roca diorítica que contiene cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. está compuesta por plagioclasa intermedia, comúnmente con horblenda y de manera frecuente con biotita o augita; contiene plagioclasa sódica (an0-an50). su índice de color m es inferior a 90. incluye a las rocas modalmente asignadas al campo 10 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/diorita-con-foides","prefLabel":{"en":"foid bearing diorite","es":"diorita con foides"},"definition":{"en":"Dioritic rock that contains between 0 and 10 percent feldspathoid minerals in the qapf fraction. qapf field 10'.","es":"Roca diorítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 10' del diagrama qapf."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-monzodioritica","prefLabel":{"en":"monzodioritic rock","es":"roca monzodiorítica"},"definition":{"en":"Phaneritic crystalline igneous rock consisting of sodic plagioclase (an0 to an50), alkali feldspar, hornblende and biotite, with or without pyroxene, and 0 to 10 percent feldspathoid or 0 to 20 percent quartz in the qapf fraction. plagioclase to total feldspar ratio in the qapf fraction is between 0.65 and 0.9. includes rocks defined modally in qapf field 9, 9' and 9* as monzodiorite, foid-bearing monzodiorite, and quartz monzodiorite.","es":"Dioritoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento. está compuesta por plagioclasa sódica (an0 a an50), feldespato alcalino, hornblenda y biotita, con ausencia o muy bajo contenido de piroxeno y hasta un 10 por ciento de feldespatoide o hasta un 20 por ciento de cuarzo entre los componentes qapf. incluye a las rocas de los sectores 9, 9' y 9* del diagrama qapf."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzodiorita","prefLabel":{"en":"quartz monzodiorite","es":"cuarzo-monzodiorita"},"definition":{"en":"Monzodioritic rock that contains between 5 and 20 percent quartz.","es":"Roca monzodiorítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 9* del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/monzodiorita","prefLabel":{"en":"monzodiorite","es":"monzodiorita"},"definition":{"en":"Phaneritic crystalline igneous rock consisting of sodic plagioclase (an0 to an50), alkali feldspar, hornblende and biotite, with or without pyroxene, and 0 to 5 percent quartz. includes rocks defined modally in qapf field 9.","es":"Roca monzodiorítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. contiene plagioclasa sódica (an0 a an50), feldespato alcalino, hornblenda y biotita, con ausencia o muy bajo contenido de piroxeno. incluye a las rocas del sector 9 del diagrama qapf."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/monzodiorita-con-foides","prefLabel":{"en":"foid bearing monzodiorite","es":"monzodiorita con foides"},"definition":{"en":"Monzodioritic rock that contains between 0 and 10 percent feldspathoid mineral.","es":"Roca monzodiorítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 9' del diagrama qapf."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-rica-en-vidrio","prefLabel":{"en":"glass rich igneous rock","es":"roca ígnea rica en vidrio"},"definition":{"en":"Igneous rock that contains greater than 50 percent massive glass.","es":"Roca ígnea con un porcentaje de vidrio superior al 50 por ciento."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-vitrea","prefLabel":{"en":"glassy igneous rock","es":"roca ígnea vítrea"},"definition":{"en":"Igneous rock that consists of greater than 80 percent massive glass.","es":"Roca ígnea con un porcentaje de vidrio superior al 80 por ciento."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-ultrabasica","prefLabel":{"en":"ultrabasic igneous rock","es":"roca ígnea ultrabásica"},"definition":{"en":"Igneous rock with less than 45 percent sio2.","es":"Roca ígnea con menos de un 45 por ciento de sio2."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-ignea-ultramafica","prefLabel":{"en":"ultramafic igneous rock","es":"roca ígnea ultramáfica"},"definition":{"en":"Igneous rock that consists of greater than 90 percent mafic minerals.","es":"Roca ígnea formada por más de un 90 por ciento de minerales máficos."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-no-consolidado","prefLabel":{"en":"unconsolidated material","es":"material no consolidado"},"definition":{"en":"Compoundmaterial composed of an aggregation of particles that do not adhere to each other strongly enough that the aggregate can be considered a solid in its own right.","es":"Material compuesto formado por agregación de partículas no tan estrechamente adheridas entre sí como para que el agregado pueda ser considerado un sólido por derecho propio."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/material-de-origen-natural-no-consolidado","prefLabel":{"en":"natural unconsolidated material","es":"material de origen natural no consolidado"},"definition":{"en":"Unconsolidated material known to have natural, i.e. not human-made, origin.","es":"Material no consolidado de origen natural, es decir, no antrópico."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento","prefLabel":{"en":"sediment","es":"sedimento"},"definition":{"en":"Unconsolidated material consisting of an aggregation of particles transported or deposited by air, water or ice, or that accumulated by other natural agents, such as chemical precipitation, and that forms in layers on the earth's surface.","es":"Material no consolidado formado por agregación de partículas transportadas o depositadas por el aire, el agua o el hielo, o acumulado por otros agentes naturales, como la precipitación química, que forma estratos en la superficie terrestre."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-biogenico","prefLabel":{"en":"biogenic sediment","es":"sedimento biogénico"},"definition":{"en":"Sediment composed of greater than 50 percent material of biogenic origin. because the biogenic material may be skeletal remains that are not organic, all biogenic sediment is not necessarily organic-rich.","es":"Sedimento compuesto  por material de origen biogénico, en más de un 50 por ciento. debido a que el material biogénico pueden ser restos de esqueletos que no son orgánicos, los sedimentos biogénicos no tienen que ser necesariamente  ricos en materia orgánica."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/fango","prefLabel":{"en":"ooze","es":"fango"},"definition":{"en":"Biogenic sediment consisting of less than 1 percent gravel-size (greater than or equal to 2 mm) particles, with a sand to mud ratio less than 1 to 9, and less than 50 percent carbonate minerals.","es":"Sedimento biogénico con una relación de arena a lutita inferior a 1 a 9, menos de un 50 por ciento de carbonatos y menos de un 1 por ciento de partículas de tamaño grava (2 mm de diámetro)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-rico-en-materia-organica","prefLabel":{"en":"organic rich sediment","es":"sedimento rico en materia orgánica"},"definition":{"en":"Sediment with color, composition, texture and apparent density indicating greater than 50 percent organic content by weight on a moisture-free basis.","es":"Sedimento cuyo color, composición, textura y densidad aparente indican que contiene más del 50 por ciento en peso (en seco) de materia orgánica."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/sapropel","prefLabel":{"en":"sapropel","es":"sapropel"},"definition":{"en":"Jelly like organic rich sediment composed of plant remains, usually algal. liptinite to inertinite ratio is greater than one (economic commission for europe, committee on sustainable energy- united nations (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.).","es":"Sedimento gelatinoso rico en materia orgánica formado por restos de plantas, habitualmente algas. la relación entre liptinita e inertinita es mayor de 1 (comisión económica para europa, comité de la energía sostenible - naciones unidas (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/turba","prefLabel":{"en":"peat","es":"turba"},"definition":{"en":"Unconsolidated organic-rich sediment composed of at least 50 percent semi-carbonised plant remains; individual remains commonly seen with unaided eye; yellowish brown to brownish black; generally fibrous texture; can be plastic or friable. in its natural state it can be readily cut and has a very high moisture content, generally greater than 90 percent. liptinite to inertinite ratio is less than one (economic commission for europe, committee on sustainable energy- united nations (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.).","es":"Sedimento no consolidado rico en materia orgánica con un mínimo del 50 por ciento de restos de plantas semicarbonificados, normalmente distinguibles a simple vista; de coloración marrón amarillento a marrón muy oscuro, habitualmente con textura fibrosa, puede ser plástico o friable. en su estado natural puede cortarse fácilmente y tiene un elevado grado de humedad, generalmente de más del 90 por ciento. la relación entre el contenido de liptinita e inertinita es inferior a 1 (comisión económica para europa, comité de la energía sostenible - naciones unidas (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.)."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-arena","prefLabel":{"en":"sand size sediment","es":"sedimento de tamaño arena"},"definition":{"en":"Sediment in which less than 30 percent of particles are gravel (greater than 2 mm in diameter) and the sand to mud ratio is at least 1. composition or genesis of clasts not specified.","es":"Sedimento con menos de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro) y una relación entre granos de arena y partículas de lutita mayor que 1. la composición o la génesis de los clastos no se especifican."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava","prefLabel":{"en":"gravel size sediment","es":"sedimento de tamaño grava"},"definition":{"en":"Sediment containing greater than 30 percent gravel-size particles (greater than 2.0 mm diameter). composition or genesis of clasts not specified.","es":"Sedimento que contiene más de un 30 por ciento de partículas de tamaño grava (más de 2,0 mm de diámetro). la composición o la génesis de los clastos no se especifican."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/bloques","prefLabel":{"en":"boulder gravel size sediment","es":"bloques"},"definition":{"en":"Sediment containing greater than 30 percent boulder-size particles (greater than 256 mm in diameter).","es":"Sedimento que contiene más de un 30 por ciento de partículas de tamaño bloque (diámetro mayor de 256 mm)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/grava-fina-media","prefLabel":{"en":"pebble gravel size sediment","es":"grava fina-media"},"definition":{"en":"Sediment containing greater than 30 percent pebble-size particles (2.0 -64 mm in diameter)","es":"Sedimento con más de un 30 por ciento de clastos de tamaño grava (2 - 64 mm de diámetro)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/grava-gruesa","prefLabel":{"en":"cobble gravel size sediment","es":"grava gruesa"},"definition":{"en":"Sediment containing greater than 30 percent cobble-size particles (64-256 mm in diameter)","es":"Sedimento que contiene más de un 30 por ciento de clastos de tamaño canto (64-256 mm de diámetro)."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-hibrido","prefLabel":{"en":"hybrid sediment","es":"sedimento híbrido"},"definition":{"en":"Sediment that does not fit any of the other sediment composition/genesis categories. sediment consisting of three or more components which form more than 5 percent but less than 50 precent of the material.","es":"Sedimento que no encaja en ninguna otra categoría de sedimento según la composición o el origen. sedimento formado por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50 por ciento del material."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-pelitico","prefLabel":{"en":"mud size sediment","es":"sedimento pelítico"},"definition":{"en":"Sediment consisting of less than 30 percent sand-size (0.6 mm) particles and with a mud-size to sand-size particle ratio greater than 1. grains may be of any composition or origin.","es":"Sedimento clástico con menos de un 30 por ciento de clastos de tamaño arena (0,6 - 2,0 mm de diámetro) y una relación entre partículas de lutita y granos de arena mayor que 1. los granos pueden ser de composición y origen diverso."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/fango-rico-en-carbonatos","prefLabel":{"en":"carbonate rich mud","es":"fango rico en carbonatos"},"definition":{"en":"Mud size sediment that contains between 10 and 50 percent carbonate minerals in any size fraction. carbonate origin is not specified.","es":"Sedimento de tamaño lutita que contiene entre el 10 y el 50 por ciento de minerales carbonatados de cualquier tamaño. no tiene un origen específico."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/fango-siliceo","prefLabel":{"en":"silicate mud","es":"fango silíceo"},"definition":{"en":"Mud size sediment that consists of less than 50 percent carbonate minerals.","es":"Sedimento de tamaño de grano arcilla formado por menos de un 50 por ciento de carbonatos."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/tefra","prefLabel":{"en":"tephra","es":"tefra"},"definition":{"en":"Unconsolidated pyroclastic material in which greater than 75 percent of the fragments are deposited as a direct result of volcanic processes and the deposit has not been reworked by epiclastic processes. includes ash, lapilli tephra, bomb tephra, block tephra and unconsolidated agglomerate.","es":"Material piroclástico no consolidado que contiene un porcentaje superior al 75 por ciento de productos fragmentarios que han sido depositados como resultado directo de los procesos volcánicos y que no han sido retrabajados por procesos epiclásticos. incluye a cenizas, tefra de lapilli, tefra de bombas, tefra de bloques y aglomerados no consolidados."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/brecha-de-cenizas,-tefra-de-bombas-o-bloques","prefLabel":{"en":"ash breccia, bomb, or block tephra","es":"brecha de cenizas, tefra de bombas o bloques"},"definition":{"en":"Tephra in which more than 25 percent of particles are greater than 64 mm in largest dimension. includes ash breccia, bomb tephra and block tephra of gillespie and styles (1999)","es":"Piroclastos (o tefra) con más del 25 por ciento de los fragmentos mayores de 64 mm de longitud. incluye las brechas de ceniza, las bombas y los bloques piroclásticos según la definición de gillespie y styles (1999)"}},{"id":"https://geo-carto.github.io/vocabularios/litologia/ceniza-y-lapilli","prefLabel":{"en":"ash and lapilli","es":"ceniza y lapilli"},"definition":{"en":"Tephra in which less than 25 percent of fragments are greater than 64 mm in longest dimension","es":"Piroclastos (o tefra) en los que menos de un 25 por ciento de los fragmentos tienen más de 64 mm de longitud."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-poligenico","prefLabel":{"en":"composite genesis material","es":"material poligénico"},"definition":{"en":"Material of unspecified consolidation state formed by geological modification of pre-existing materials outside the realm of igneous and sedimentary processes.","es":"Material con un estado de consolidación no especificado formado por modificación geológica de materiales preexistentes fuera del ámbito de los procesos ígneos y sedimentarios."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/alterita","prefLabel":{"en":"material formed in surficial environment","es":"Alterita"},"definition":{"en":"Material that is the product of weathering processes operating on pre-existing rocks or deposits, analogous to hydrothermal or metasomatic rocks, but formed at ambient earth surface temperature and pressure.","es":"Material resultante de procesos de meteorización activos en rocas o depósitos preexistentes, análogo a las rocas hidrotermales o metasomáticas, pero formado a la temperatura y presión ambiente de la superficie de la tierra."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/bauxita","prefLabel":{"en":"bauxite","es":"bauxita"},"definition":{"en":"Highly aluminous material containing abundant aluminium hydroxides (gibbsite, less commonly boehmite, diaspore) and aluminium-substituted iron oxides or hydroxides and generally minor or negligible kaolin minerals; may contain up to 20 percent quartz. commonly has a pisolitic or nodular texture, and may be cemented.","es":"Roca sedimentaria muy alumínica que contiene abundantes hidróxidos de aluminio (gibbsita y, de manera menos habitual, boehmita y diásporo) y óxidos e hidróxidos de hierro, generalmente con proporción muy baja o despreciable de minerales de caolín; puede contener más de un 20 por ciento de cuarzo. habitualmente presenta textura pisolítica o nodular y puede estar cementada."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/regolito","prefLabel":{"en":"residual material","es":"regolito"},"definition":{"en":"Material of composite origin resulting from weathering processes at the earth’s surface, with genesis dominated by removal of chemical constituents by aqueous leaching. minor clastic, chemical, or organic input may also contribute. consolidation state is not inherent in definition, but typically material is unconsolidated or weakly consolidated.","es":"Material de origen diverso resultante de procesos de meteorización en la superficie de la tierra, cuya génesis corresponde fundamentalmente a la sustitución por lixiviación de sus componentes químicos, aunque algunas aportaciones clásticas, químicas u orgánicas pueden contribuir a su formación en mucha menor medida. su grado de consolidación no está considerado en la definición, aunque normalmente no está consolidado o lo está débilmente."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-generado-por-un-impacto","prefLabel":{"en":"impact generated material","es":"material generado por un impacto"},"definition":{"en":"Material that contains features indicative of shock metamorphism, such as microscopic planar deformation features within grains or shatter cones, interpreted to be the result of extraterrestrial bolide impact. includes breccias and melt rocks.","es":"Material que presenta características indicativas de metamorfismo de choque, como una deformación microscópica planar en granos o conos de fractura, que se interpretan como resultado del impacto de un meteorito. incluye brechas y rocas fundidas."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-relacionado-con-una-falla","prefLabel":{"en":"fault-related material","es":"material relacionado con una falla"},"definition":{"en":"Material formed as a result of brittle faulting, composed of greater than 10 percent matrix; matrix is fine-grained material caused by tectonic grainsize reduction.","es":"Material formado como resultado de una falla frágil, compuesto por una matriz mayor del 10 por ciento; la matriz es material de granulometría fina producido por reducción tectónica del tamaño de grano."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-milonitica","prefLabel":{"en":"mylonitic rock","es":"roca milonítica"},"definition":{"en":"Metamorphic rock characterised by a foliation resulting from tectonic grain size reduction, in which more than 10 percent of the rock volume has undergone grain size reduction. includes protomylonite, mylonite, ultramylonite, and blastomylonite.","es":"Roca metamórfica que se caracteriza por una foliación debida a la disminución del tamaño de grano como consecuencia de esfuerzos tectónicos, y en la que más del 10 por ciento del volumen de la roca ha experimentado una reducción del tamaño de grano. incluye a las protomilonitas, milonitas, ultramilonitas y blastomilonitas."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/filonita","prefLabel":{"en":"phyllonite","es":"filonita"},"definition":{"en":"Mylonitic rock composed largely of fine-grained mica that imparts a sheen to foliation surfaces; may have flaser lamination, isoclinal folding, and deformed veins, which indicate significant shearing. macroscopically resembles phyllite, but formed by mechanical degradation of initially coarser rock.","es":"Roca milonítica compuesta principalmente por mica de grano fino que confiere brillo a las superficies de foliación; puede tener laminación tipo \"flaser\", pliegues isoclinales y venas deformadas, que indican un importante cizallamiento. macroscópicamente se parece a la filita, pero la filonita se ha formado por la degradación mecánica de una roca de grano inicialmente más grueso."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/series-de-las-brechas-harinas-de-falla","prefLabel":{"en":"breccia-gouge series","es":"series de las brechas-harinas de falla"},"definition":{"en":"Fault material with features such as void spaces (filled or unfilled), or unconsolidated matrix material between fragments, indicating loss of cohesion during deformation. includes fault-related breccia and gouge.","es":"Material de falla con rasgos que indican pérdida de cohesión durante la deformación, tales como espacios vacíos (rellenos o no) o material con matriz no consolidada entre fragmentos. incluye las brechas y las harinas de falla."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-poligenica","prefLabel":{"en":"composite genesis rock","es":"roca poligénica"},"definition":{"en":"Rock formed by geological modification of pre-existing rocks outside the realm of igneous and sedimentary processes.","es":"Roca formada por modificación geológica de rocas preexistentes al margen de los procesos ígneos y sedimentarios."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/encostramiento","prefLabel":{"en":"duricrust","es":"encostramiento"},"definition":{"en":"Rock forming a hard crust or layer at or near the earth's surface at the time of formation, e.g. in the upper horizons of a soil, characterized by structures indicative of pedogenic origin.","es":"Roca formando una costra o capa dura en la superficie de la tierra o cerca de ella, p. e. en los horizontes superiores de un suelo; se caracteriza por presentar estructuras indicativas de su origen pedogénico."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica","prefLabel":{"en":"metamorphic rock","es":"roca metamórfica"},"definition":{"en":"Rock formed by solid-state mineralogical, chemical and/or structural changes to a pre-existing rock, in response to marked changes in temperature, pressure, shearing stress and chemical environment.","es":"Roca generada por los cambios mineralógicos, texturales y/o estructurales, en estado sólido, producidos sobre una roca pre-existente, como respuesta a cambios importantes de temperatura, presión, esfuerzos de cizalla o condiciones químicas del ambiente."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/anfibolita","prefLabel":{"en":"amphibolite","es":"anfibolita"},"definition":{"en":"Metamorphic rock mainly consisting of green, brown or black amphibole and plagioclase (including albite), which combined form 75 percent or more of the rock, and both of which are present as major constituents. the amphibole constitutes 50 percent or more of the total mafic constituents and is present in an amount of 30 percent or more; other common minerals include quartz, clinopyroxene, garnet, epidote-group minerals, biotite, titanite and scapolite.","es":"Roca metamórfica compuesta en un 75 por ciento o más por anfíbol (verde, marrón o negro) y plagioclasa (incluyendo a la albita). el anfíbol constituye, al menos, un 30 por ciento de la roca y un 50 por ciento de los minerales máficos. otros minerales que suelen estar presentes son cuarzo, clinopiroxeno, granate, minerales del grupo de la epidota, biotita, titanita y escapolita."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/cuarcita","prefLabel":{"en":"quartzite","es":"cuarcita"},"definition":{"en":"Metamorphic rock consisting of greater than or equal to 75 percent quartz; typically granoblastic texture.","es":"Roca metamórfica compuesta, al menos, por un 75 por ciento de cuarzo; normalmente presenta textura granoblástica."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/eclogita","prefLabel":{"en":"eclogite","es":"eclogita"},"definition":{"en":"Metamorphic rock composed of 75 percent or more (by volume) omphacite and garnet, both of which are present as major constituents, the amount of neither of them being higher than 75 percent (by volume); the presence of plagioclase precludes classification as an eclogite.","es":"Roca metamórfica constituida al menos en un 75 por ciento (en volumen) por onfacita y granate, siendo ambos los componentes mayoritarios, sin superar ninguno de ellos el 75 por ciento en volumen. la presencia de plagioclasa descarta la clasificación como eclogita."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/esquisto-azul","prefLabel":{"en":"glaucophane lawsonite epidote metamorphic rock","es":"esquisto azul"},"definition":{"en":"A metamorphic rock of roughly basaltic composition, defined by the presence of glaucophane with lawsonite or epidote. other minerals that may be present include jadeite, albite, chlorite, garnet, and muscovite (phengitic white mica). typically fine-grained, dark colored. category for rocks commonly referred to as blueschist.","es":"Roca metamórfica con una composición próxima a la del basalto. se define por la presencia de glaucofana con lawsonita o epidota. otros minerales que pueden estar presentes son jadeíta, albita, clorita, granate y moscovita (mica blanca fengítica). generalmente es oscura y de grano fino."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/granofelsita-/-granoblastita","prefLabel":{"en":"granofels","es":"granofelsita / granoblastita"},"definition":{"en":"Metamorphic rock with granoblastic fabric and very little or no foliation (less than 10 percent of the mineral grains in the rock are elements in a planar or linear fabric). grainsize not specified.","es":"Roca metamórfica de fábrica granoblástica y sin foliación o con muy poca (menos del 10 por ciento de los granos minerales conforman la fábrica linear o planar)."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/corneana","prefLabel":{"en":"hornfels","es":"corneana"},"definition":{"en":"Granofels formed by contact metamorphism, composed of a mosaic of equidimensional grains in a characteristically granoblastic or decussate matrix; porphyroblasts or relict phenocrysts may be present. typically fine grained.","es":"Roca granoblástica generada por metamorfismo de contacto, compuesta por un mosaico de granos equidimensionales en una típica matriz granoblástica o decusada; puede contener porfiroblastos o fenocristales relictos. normalmente es de grano fino."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/granulita","prefLabel":{"en":"granulite","es":"granulita"},"definition":{"en":"Metamorphic rock of high metamorphic grade in which fe-mg silicate minerals are dominantly hydroxl-free; feldspar must be present, and muscovite is absent; rock contains less than 90 percent mafic minerals, less than 75 percent calcite and/or dolomite, less than 75 percent quartz, less than 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), and less than 50 percent calc-silicate minerals.","es":"Roca metamórfica de alto grado en la que los silicatos de fe-mg son predominantemente anhidros; contiene feldespato, menos de un 90 por ciento de minerales máficos, menos de un 75 por ciento de calcita y/o dolomita, menos de un 75 por ciento de cuarzo, menos de un 50 por ciento de minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro), menos de un 50 por ciento de minerales calcosilicatados y no presenta moscovita."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/marmol","prefLabel":{"en":"marble","es":"mármol"},"definition":{"en":"Metamorphic rock consisting of greater than 75 percent fine- to coarse-grained recrystallized calcite and/or dolomite; usually with a granoblastic, saccharoidal texture.","es":"Roca metamórfica con más de un 75 por ciento de granos de calcita y/o dolomita recristalizadas; normalmente tiene textura granoblástica sacaroidea."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/migmatita","prefLabel":{"en":"migmatite","es":"migmatita"},"definition":{"en":"Silicate metamorphic rock that is pervasively heterogeneous on a decimeter to meter scale that typically consists of darker and lighter parts; the darker parts usually exhibit features of metamorphic rocks whereas the lighter parts are of igneous-looking appearance.","es":"Roca metamórfica silicatada marcadamente heterogénea tanto a escala decimétrica como métrica. normalmente está formada por unas partes oscuras y otras más claras; las oscuras suelen mostrar características de rocas metamórficas, mientras que las más claras tienen apariencia de rocas ígneas."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-de-la-facies-de-la-clorita-actinolita-epidota","prefLabel":{"en":"chlorite actinolite epidote metamorphic rock","es":"roca metamórfica de la facies de la clorita-actinolita-epidota"},"definition":{"en":"Metamorphic rock characterized by 50 percent or more of combined chlorite, actinolite and epidote. category for rocks generally named greenschist or greenstone.","es":"Roca metamórfica caracterizada por la presencia, en una proporción igual o superior al 50 por ciento, de clorita, actinolita y epidota combinadas. corresponde a la categoría generalmente llamada esquistos verdes."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada","prefLabel":{"en":"foliated metamorphic rock","es":"roca metamórfica foliada"},"definition":{"en":"Metamorphic rock in which 10 percent or more of the contained mineral grains are elements in a planar or linear fabric. cataclastic or glassy character precludes classification with this concept.","es":"Roca metamórfica en la que el 10 por ciento o más de los componentes minerales tienen una fábrica planar o linear. la naturaleza cataclástica o vítrea excluyen la clasificación bajo este concepto."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/esquisto","prefLabel":{"en":"schist","es":"esquisto"},"definition":{"en":"Foliated phaneritic metamorphic rock with well developed, continuous schistosity, meaning that greater than 50 percent of the rock by volume is mineral grains with a thin tabular, lamellar, or acicular prismatic crystallographic habit that are oriented in a continuous planar or linear fabric.","es":"Roca metamórfica fanerítica y foliada que presenta una esquistosidad muy desarrollada y continua, lo que implica que más del 50 por ciento del volumen de la roca son granos minerales con hábito tabular, lamelar o prismático acicular, orientados en una fábrica continua planar o lineal."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/micaesquisto","prefLabel":{"en":"mica schist","es":"micaesquisto"},"definition":{"en":"A schist that consists of more than 50 percent mica minerals, typically muscovite or biotite. special type included to distinguish this common variety of schist.","es":"Esquisto formado por más de un 50 por ciento de micas, habitualmente moscovita o biotita. es una tipología específica para distinguir esta variedad común de esquistos."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/filita","prefLabel":{"en":"phyllite","es":"filita"},"definition":{"en":"Rock with a well developed, continuous schistosity, an average grain size between 0.1 and 0.5 millimeters, and a silvery sheen on cleavage surfaces. individual phyllosilicate grains are barely visible with the unaided eye.","es":"Roca que presenta foliación muy penetrativa, granulometría media, comprendida entre 0,1 y 0,5 mm, y brillo satinado en las superficies de foliación. a simple vista, los filosilicatos son difícilmente distinguibles de manera individualizada."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/gneis","prefLabel":{"en":"gneiss","es":"gneis"},"definition":{"en":"Foliated metamorphic rock with bands or lenticles rich in granular minerals alternating with bands or lenticles rich in minerals with a flaky or elongate prismatic habit. mylonitic foliation or well developed, continuous schistosity (greater than 50 percent of the rock consists of grains participate in a planar or linear fabric) precludes classification with this concept.","es":"Roca metamórfica foliada con bandas o lentejones ricos en minerales granulares que se alternan con bandas o lentejones ricos en minerales con hábito prismático o planar. la presencia de foliación milonítica muy bien desarrollada o una esquistosidad continua (más del 50 por ciento de la roca constituido por partículas que conforman una fábrica planar o lineal) descartan la clasificación bajo este término."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/ortogneis","prefLabel":{"en":"orthogneiss","es":"ortogneis"},"definition":{"en":"A gneiss with mineralogy and texture indicating derivation from a phaneritic igneous rock protolith. typically consists of abundant feldspar, with quartz, and variable hornblende, biotite, and muscovite, with a relatively homogeneous character.","es":"Gneis cuya mineralogía y textura indican un protolito de rocas ígneas faneríticas. normalmente está formado por abundante feldespato, con cuarzo y un contenido variable de hornblenda, biotita y moscovita; tiene un aspecto relativamente homogéneo."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/paragneis","prefLabel":{"en":"paragneiss","es":"paragneis"},"definition":{"en":"A gneiss with mineralogy and texture indicating derivation from a sedimentary rock protolith. typically consists of abundant quartz, mica, or calcsilicate minerals; aluminosilicate minerals or garnet commonly present. composition of rock tends to be more variable on a decimetric scale that in orthogneiss.","es":"Gneis cuya mineralogía y textura indican un protolito de rocas sedimentarias. normalmente está formado por abundante cuarzo y mica o calcosilicatos; suele contener  aluminosilicatos o granate. a escala decimétrica, su composición tiende a ser más variada que la del ortogneis."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/pizarra","prefLabel":{"en":"slate","es":"pizarra"},"definition":{"en":"Compact, fine grained rock with an average grain size less than 0.032 millimeter and a well developed schistosity (slaty cleavage), and hence can be split into slabs or thin plates.","es":"Roca compacta de grano fino, con una granulometría media inferior a 0,032 mm y que presenta una foliación muy bien desarrollada (clivaje pizarroso) y que por tanto puede ser separada en lajas o placas delgadas."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/serpentinita","prefLabel":{"en":"serpentinite","es":"serpentinita"},"definition":{"en":"Rock consisting of more than 75 percent serpentine-group minerals, eg. antigorite, chrysotile or lizardite; accessory chlorite, talc and magnetite may be present; derived from hydration of ferromagnesian silicate minerals such as olivine and pyroxene.","es":"Roca compuesta en más de un 75 por ciento por minerales del grupo de la sepentina, p. e. antigorita, crisotilo o lizardita, pudiendo contener clorita, talco y magnetita como minerales accesorios; se forma por hidratación de silicatos ferromagnesianos como olivino y piroxeno."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-metasomatica","prefLabel":{"en":"metasomatic rock","es":"roca metasomática"},"definition":{"en":"Rock that has fabric and composition indicating open-system mineralogical and chemical changes in response to interaction with a fluid phase, typically water rich.","es":"Roca cuya fábrica y composición indican cambios mineralógicos y  químicos en un sistema abierto, como respuesta a la interacción con una fase fluida, normalmente rica en agua."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/espilita","prefLabel":{"en":"spilite","es":"espilita"},"definition":{"en":"Altered basic to intermediate composition fine-grained igneous rock in which the feldspar is partially or completely composed of of albite, typically accompanied by chlorite, calcite, quartz, epidote, prehnite, and low-tempaerature hydrous crystallization products. preservation of eruptive volcanic features is typical.","es":"Roca ígnea alterada de grano fino y composición básica a  intermedia en la que el feldespato está compuesto parcial o totalmente por albita, habitualmente acompañada por clorita, calcita, cuarzo, epidota, prehnita y productos de cristalización hidratados de baja temperatura. habitualmente conserva las características volcánicas eruptivas."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/skarn","prefLabel":{"en":"skarn","es":"skarn"},"definition":{"en":"Metasomatic rock consisting mainly of ca-, mg-, fe-, or mn-silicate minerals, which are free from or poor in water. typically formed at the contact between a silicate rock or magma and a carbonate rock.","es":"Roca metasomática compuesta principalmente por silicatos de calcio, magnesio, hierro o manganeso anhidros o pobres en agua. normalmente se forman en el contacto entre una roca o un magma silicatado y una roca carbonatada."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/serie-de-las-cataclasitas","prefLabel":{"en":"cataclasite series","es":"serie de las cataclasitas"},"definition":{"en":"Fault-related rock that maintained primary cohesion during deformation, with matrix comprising greater than 10 percent of rock mass; matrix is fine-grained material formed through grain size reduction by fracture as opposed to crystal plastic process that operate in mylonitic rock. includes cataclasite, protocataclasite and ultracataclasite.","es":"Rocas de falla que han mantenido su cohesión primaria durante la deformación, cuya matriz constituye más del 10 por ciento del volumen de la roca. la matriz está formada por materiales de granulometría fina por reducción debida a fracturación, en oposición al proceso de cristalización plástica que caracteriza a las rocas miloníticas. incluye cataclasitas, protocataclasitas y ultracataclasitas."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario","prefLabel":{"en":"sedimentary material","es":"material sedimentario"},"definition":{"en":"Material formed by accumulation of solid fragmental material deposited by air, water or ice, or material that accumulated by other natural agents such as chemical precipitation from solution or secretion by organisms.","es":"Material formado por acumulación de fragmentos sólidos depositado por el aire, el agua o el hielo, o acumulado por la acción de otros agentes naturales, como la precipitación química de una solución o la secreción por organismos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado","prefLabel":{"en":"carbonate sedimentary material","es":"material sedimentario carbonatado"},"definition":{"en":"Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin.","es":"Material sedimentario en el que al menos el 50 de sus componentes primarios y/o recristalizados están formados por uno (o más) de los minerales carbonatados calcita, aragonito y dolomita, en partículas originarias de la misma cuenca de deposición."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-calcareo","prefLabel":{"en":"calcareous carbonate sedimentary material","es":"material sedimentario calcáreo"},"definition":{"en":"Carbonate sedimentary material of unspecified consolidation state with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes lime-sediments, limestone and dolomitic limestone.","es":"Material sedimentario carbonatado, en un estado de consolidación sin especificar, cuya proporción entre calcita (más aragonito) y dolomita es mayor que 1. incluye a los sedimentos calizos, las calizas y las calizas dolomíticas."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-calcarea","prefLabel":{"en":"calcareous carbonate sedimentary rock","es":"roca sedimentaria calcárea"},"definition":{"en":"Carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes limestone and dolomitic limestone.","es":"Roca sedimentaria carbonatada cuya proporción entre calcita (más aragonito) y dolomita es mayor que 1. incluye a las calizas y las calizas dolomíticas."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/caliza","prefLabel":{"en":"limestone","es":"caliza"},"definition":{"en":"Pure carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes limestone and dolomitic limestone.","es":"Roca sedimentaria carbonatada pura con una proporción entre calcita (incluyendo el aragonito) y dolomita mayor que 1. incluye a la caliza dolomítica."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/creta","prefLabel":{"en":"chalk","es":"creta"},"definition":{"en":"A generally soft, white, very fine-grained, extremely pure, porous limestone. it forms under marine conditions from the gradual accumulation of skeletal elements from minute planktonic green algae (cocoliths), associated with varying proportions of larger microscopic fragments of bivalves, foraminifera and ostracods. it is common to find flint and chert nodules embedded in chalk.","es":"Caliza, generalmente porosa, blanda, blanca, de grano muy fino y extremadamente pura. se forma en ambientes marinos por la acumulación gradual de esqueletos de diminutas algas verdes planctónicas (cocolitos), con proporciones variables de fragmentos microscópicos de bivalvos, foraminíferos y ostrácodos. de forma habitual incorpora nódulos de sílex y chert."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/caliza-impura","prefLabel":{"en":"impure limestone","es":"caliza impura"},"definition":{"en":"Impure carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1.","es":"Roca sedimentaria carbonatada impura con una relación de calcita (incluyendo el aragonito) con respecto a dolomita mayor que 1."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo","prefLabel":{"en":"calcareous carbonate sediment","es":"sedimento calcáreo"},"definition":{"en":"Carbonate sediment with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes lime-sediments.","es":"Sedimento carbonatado con una proporción entre calcita (más aragonito) y dolomita mayor que 1. incluye a los sedimentos calizos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo-impuro","prefLabel":{"en":"impure calcareous carbonate sediment","es":"sedimento calcáreo impuro"},"definition":{"en":"Carbonate sediment in which between 50 and 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin, and a calcite (plus aragonite) to dolomite ratio greater than 1 to 1.","es":"Sedimento carbonatado en el que entre el 50 y el 90 por ciento de los elementos integrantes están compuestos por uno (o más) carbonatos de origen intracuencal, con una relación entre calcita (incluyendo el aragonito) y dolomita mayor que 1."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo-puro","prefLabel":{"en":"pure calcareous carbonate sediment","es":"sedimento calcáreo puro"},"definition":{"en":"Carbonate sediment in which greater than 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin, and a calcite (plus aragonite) to dolomite ratio greater than 1 to 1.","es":"Sedimento carbonatado con más del 90 por ciento de sus constituyentes compuestos por uno (o más) carbonatos de origen intracuencal y con una proporción entre calcita (incluido el aragonito) y dolomita mayor que 1."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-dolomitico-o-magnesico","prefLabel":{"en":"dolomitic or magnesian sedimentary material","es":"material sedimentario dolomítico o magnésico"},"definition":{"en":"Carbonate sedimentary material of unspecified consolidation degree with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. includes dolomite sediment, dolostone, lime dolostone and magnesite-stone.","es":"Material sedimentario carbonatado, en un estado de consolidación sin especificar, con una relación entre carbonato de magnesio y carbonato cálcico (incluyendo el aragonito) superior a 1. incluye el material sedimentario dolomítico, la dolomía, la dolomía calcárea y la magnesita."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada","prefLabel":{"en":"carbonate sedimentary rock","es":"roca sedimentaria carbonatada"},"definition":{"en":"Sedimentary rock in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite, magnesite or dolomite.","es":"Roca sedimentaria en la que al menos el 50 por ciento de los componentes primarios y/o recristalizados están constituidos por uno (o más) de los minerales carbonatados calcita, aragonito, magnesita y dolomita."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/boundstone","prefLabel":{"en":"boundstone","es":"boundstone"},"definition":{"en":"Sedimentary carbonate rock with preserved biogenic texture, whose original components were bound and encrusted together during deposition by the action of plants and animals during deposition, and remained substantially in the position of growth.","es":"Roca sedimentaria carbonatada que ha preservado su textura biogénica. sus componentes originales se unieron e incrustaron durante la sedimentación por acción de plantas y animales y se han conservado de manera sustancial en posición de vida."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/carbonato-cristalino","prefLabel":{"en":"crystalline carbonate","es":"carbonato cristalino"},"definition":{"en":"Carbonate rock of indeterminate mineralogy in which diagenetic processes have obliterated any original depositional texture.","es":"Roca carbonatada de mineralogía indeterminada en la cual los procesos diagenéticos han destruido la textura deposicional original."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/framestone","prefLabel":{"en":"framestone","es":"framestone"},"definition":{"en":"Carbonate reef rock consisting of a rigid framework of colonies, shells or skeletons, with internal cavities filled with fine sediment; usually created through the activities of colonial organisms.","es":"Roca arrecifal carbonatada formada por una estructura rígida de colonias, conchas o esqueletos, con cavidades internas rellenas de sedimentos finos; normalmente su origen es debido a la actividad de organismos coloniales."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/grainstone","prefLabel":{"en":"grainstone","es":"grainstone"},"definition":{"en":"Carbonate sedimentary rock with recognizable depositional fabric that is grain-supported, and constituent particles are of intrabasinal origin; contains little or no mud matrix. distinction from sandstone is based on interpretation of intrabasinal origin of clasts and grain-supported fabric, but grainstone definition does not include a grain size criteria.","es":"Roca sedimentaria carbonatada con matriz original reconocible, grano-soportada, constituida fundamentalmente por aloquímicos y sin matriz micrítica. se diferencia de las areniscas por el carácter intracuencal de sus clastos y por su fábrica grano-soportada, pero la definición de grainstone no contempla el criterio del tamaño de grano."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/marga","prefLabel":{"en":"carbonate mudstone","es":"marga"},"definition":{"en":"Mudstone that consists of greater than 50 percent carbonate minerals of any origin in the mud size fraction.","es":"Lutita que, en la fracción lutítica, contiene un porcentaje superior al 50 por ciento de minerales carbonatados de cualquier origen."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/mudstone","prefLabel":{"en":"pure carbonate mudstone","es":"mudstone"},"definition":{"en":"Mudstone that consists of greater than 90 percent carbonate minerals of intrabasinal origin in the mud fraction, and contains less than 10 percent allochems. the original depositional texture is preserved and fabric is matrix supported. carbonate mudstone of dunham (1962)","es":"Roca carbonatada de textura original reconocible, matriz-soportada, compuesta en más de un 90 por ciento por carbonatos de origen intracuencal y con menos de un 10 por ciento de aloquímicos. mudstone carbonatado de dunham (1962)"}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/packstone","prefLabel":{"en":"packstone","es":"packstone"},"definition":{"en":"Carbonate sedimentary rock with discernible grain supported depositional texture, containing greater than 10 percent grains, and constituent particles are of intrabasinal origin; intergranular spaces are filled by matrix.","es":"Roca sedimentaria carbonatada de textura original reconocible, grano-soportada, con granos correspondientes a aloquímicos y espacios intersticiales rellenos de matriz micrítica."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada-impura","prefLabel":{"en":"impure carbonate sedimentary rock","es":"roca sedimentaria carbonatada impura"},"definition":{"en":"Sedimentary rock in which between 50 and 90 percent of the primary and/or recrystallized constituents are composed of carbonate minerals.","es":"Roca sedimentaria en la que entre el 50 y el 90 por ciento de los elementos primarios y/o recristalizados están compuestos por carbonatos."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada-pura","prefLabel":{"en":"pure carbonate sedimentary rock","es":"roca sedimentaria carbonatada pura"},"definition":{"en":"Sedimentary rock in which greater than 90 percent of the primary and/or recrystallized constituents are carbonate minerals.","es":"Roca sedimentaria en la cual más de un 90 por ciento de sus constituyentes primarios o recristalizados son carbonatos."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-dolomitica-o-magnesica","prefLabel":{"en":"dolomitic or magnesian sedimentary rock","es":"roca sedimentaria dolomítica o magnésica"},"definition":{"en":"Carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. includes dolostone, lime dolostone and magnesite-stone.","es":"Roca sedimentaria carbonatada con una relación entre carbonato de magnesio y carbonato cálcico (incluyendo el aragonito) superior a 1. incluye la dolomía, la dolomía calcárea y la magnesita."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/dolomia","prefLabel":{"en":"dolomite","es":"dolomía"},"definition":{"en":"Pure carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.","es":"Roca sedimentaria carbonatada pura, con una relación entre dolomita y calcita (incluyendo el aragonito) mayor que 1."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/dolomia-impura","prefLabel":{"en":"impure dolomite","es":"dolomía impura"},"definition":{"en":"Impure carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.","es":"Roca sedimentaria carbonatada impura con una relación de dolomita con respecto a calcita (incluyendo el aragonito)  mayor que 1."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/wackestone","prefLabel":{"en":"carbonate wackestone","es":"wackestone"},"definition":{"en":"Carbonate sedimentary rock with discernible mud supported depositional texture and containing greater than 10 percent allochems, and constituent particles are of intrabasinal origin. if particles are not intrabasinal, categorization as a mudstone or wackestone should be considered.","es":"Roca sedimentaria carbonatada con textura original reconocible, matriz-soportada, constituida por más de un 10 por ciento de aloquímicos, en el seno de una matriz micrítica. si las partículas no son aloquímicos, su clasificación como wackestone debe ser reconsiderada."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado","prefLabel":{"en":"carbonate sediment","es":"sedimento carbonatado"},"definition":{"en":"Sediment in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin.","es":"Sedimento en el cual como mínimo el 50 por ciento de los componentes primarios y/o recristalizados están constituidos por uno (o más) de los minerales carbonatados calcita, aragonito, magnesita y dolomita, de origen intracuencal."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1","prefLabel":{"en":"carbonate mud","es":"fango carbonatado 1"},"definition":{"en":"Carbonate sediment composed of less than 25 percent clasts that have a maximum diameter more than 2 mm, and the ratio of sand size to mud size clasts is less than one.","es":"Sedimento carbonatado con un contenido en clastos de hasta 2 mm de diámetro, inferior al 25 por ciento, y cuya proporción entre los componentes de tamaño arena y lutita es inferior a 1."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1","prefLabel":{"en":"carbonate mud","es":"fango carbonatado 1"},"definition":{"en":"Carbonate sediment composed of less than 25 percent clasts that have a maximum diameter more than 2 mm, and the ratio of sand size to mud size clasts is less than one.","es":"Sedimento carbonatado con un contenido en clastos de hasta 2 mm de diámetro, inferior al 25 por ciento, y cuya proporción entre los componentes de tamaño arena y lutita es inferior a 1."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1","prefLabel":{"en":"carbonate mud","es":"fango carbonatado 1"},"definition":{"en":"Carbonate sediment composed of less than 25 percent clasts that have a maximum diameter more than 2 mm, and the ratio of sand size to mud size clasts is less than one.","es":"Sedimento carbonatado con un contenido en clastos de hasta 2 mm de diámetro, inferior al 25 por ciento, y cuya proporción entre los componentes de tamaño arena y lutita es inferior a 1."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1","prefLabel":{"en":"carbonate mud","es":"fango carbonatado 1"},"definition":{"en":"Carbonate sediment composed of less than 25 percent clasts that have a maximum diameter more than 2 mm, and the ratio of sand size to mud size clasts is less than one.","es":"Sedimento carbonatado con un contenido en clastos de hasta 2 mm de diámetro, inferior al 25 por ciento, y cuya proporción entre los componentes de tamaño arena y lutita es inferior a 1."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1","prefLabel":{"en":"carbonate mud","es":"fango carbonatado 1"},"definition":{"en":"Carbonate sediment composed of less than 25 percent clasts that have a maximum diameter more than 2 mm, and the ratio of sand size to mud size clasts is less than one.","es":"Sedimento carbonatado con un contenido en clastos de hasta 2 mm de diámetro, inferior al 25 por ciento, y cuya proporción entre los componentes de tamaño arena y lutita es inferior a 1."}}]}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-impuro","prefLabel":{"en":"impure carbonate sediment","es":"sedimento carbonatado impuro"},"definition":{"en":"Carbonate sediment in which between 50 and 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin.","es":"Sedimento carbonatado en el que entre el 50 y el 90 por ciento de los elementos integrantes están compuestos por uno (o más) carbonatos de origen intracuencal."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-puro","prefLabel":{"en":"pure carbonate sediment","es":"sedimento carbonatado puro"},"definition":{"en":"Carbonate sediment in which greater than 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin.","es":"Sedimento carbonatado con más del 90 por ciento de sus constituyentes compuestos por uno (o más) carbonatos de origen intracuencal."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico","prefLabel":{"en":"dolomitic sediment","es":"sedimento dolomítico"},"definition":{"en":"Carbonate sediment with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.","es":"Sedimento carbonatado con una relación entre dolomita y calcita (incluyendo el aragonito) mayor que 1."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico-impuro","prefLabel":{"en":"impure dolomitic sediment","es":"sedimento dolomítico impuro"},"definition":{"en":"Carbonate sediment in which between 50 and 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin, and the ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.","es":"Sedimento carbonatado en el que entre el 50 y el 90 por ciento de los elementos integrantes están compuestos por uno (o más) carbonatos de origen intracuencal, con una relación entre dolomita y calcita (incluyendo el aragonito) superior a 1."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico-puro","prefLabel":{"en":"pure dolomitic sediment","es":"sedimento dolomítico puro"},"definition":{"en":"Carbonate sediment in which greater than 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin, and a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.","es":"Sedimento carbonatado con más del 90 por ciento de sus constituyentes compuestos por uno (o más) carbonatos de origen intracuencal y con una proporción entre dolomita y calcita (incluido el aragonito) mayor que 1."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-clastico","prefLabel":{"en":"clastic sedimentary material","es":"material sedimentario clástico"},"definition":{"en":"Sedimentary material of unspecified consolidation state in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity.","es":"Material sedimentario con un estado de consolidación no especificado en el que al menos el 50 por ciento de las partículas componentes derivan de la erosión, la meteorización o del movimiento en masa de materiales terrestres preexistentes y transportados al lugar de sedimentación por agentes mecánicos como el agua, el viento, el hielo o la gravedad."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica","prefLabel":{"en":"clastic sedimentary rock","es":"roca sedimentaria clástica"},"definition":{"en":"Sedimentary rock in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity.","es":"Roca sedimentaria en la que al menos el 50 por ciento de las partículas constituyentes provienen de la erosión, la meteorización o el movimiento en masa de materiales preexistentes, que han sido transportados hasta su lugar de depósito por agentes mecánicos, tales como el agua, el viento, el hielo y la gravedad."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/arenisca","prefLabel":{"en":"sandstone","es":"arenisca"},"definition":{"en":"Clastic sedimentary rock in which less than 30 percent of particles are greater than 2 mm in diameter (gravel) and the sand to mud ratio is at least 1.","es":"Roca sedimentaria clástica con menos de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro) y una relación entre granos de arena y partículas de lutita mayor que 1."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/arenita","prefLabel":{"en":"arenite","es":"arenita"},"definition":{"en":"Clastic sandstone that contains less than 10 percent matrix. matrix is mud-size silicate minerals (clay, feldspar, quartz, rock fragments, and alteration products) of detrital or diagenetic nature.","es":"Arenisca clástica que contiene menos del 10 por ciento de matriz. la matriz es de origen detrítico o diagenético y está formada por silicatos de tamaño lutita (arcilla, feldespatos, cuarzo, fragmentos de roca y productos de alteración)."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/grauvaca","prefLabel":{"en":"wacke","es":"grauvaca"},"definition":{"en":"Clastic sandstone with more than 10 percent matrix of indeterminate detrital or diagenetic nature. matrix is mud size silicate minerals (clay, feldspar, quartz, rock fragments, and alteration products).","es":"Arenisca clástica con más de un 10 por ciento de matriz de tamaño lutita (arcilla, feldespato, cuarzo, fragmentos de roca y productos de alteración) de origen indeterminado, detrítico o diagenético."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/conglomerado","prefLabel":{"en":"conglomerate","es":"conglomerado"},"definition":{"en":"Clastic sedimentary rock composed of at least 30 percent rounded to subangular fragments larger than 2 mm in diameter; typically contains finer grained material in interstices between larger fragments. if more than 15 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wackestone. if rock has unsorted or poorly sorted texture with a wide range of particle sizes, may also be categorized as diamictite.","es":"Roca sedimentaria clástica formada por un mínimo del 30 por ciento de clastos redondeados a subangulosos de diámetro superior a 2 mm; normalmente contiene material de grano fino en los intersticios entre los clastos. si no puede ser determinado el origen clástico o diagenético de más del 15 por ciento de la matriz de grano fino y la fábrica es matriz-soportada, puede ser considerada una grauvaca. si la roca está mal seleccionada, también puede ser considerada una diamictita."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/diamictita","prefLabel":{"en":"diamictite","es":"diamictita"},"definition":{"en":"Unsorted or poorly sorted, clastic sedimentary rock with a wide range of particle sizes including a muddy matrix. biogenic materials that have such texture are excluded. distinguished from conglomerate, sandstone, mudstone based on polymodality and lack of structures related to transport and deposition of sediment by moving air or water. if more than 10 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wacke.","es":"Roca sedimentaria clástica sin selección o mal seleccionada, de granulometría muy variada, con matriz lutítica. no incluye a los materiales biogénicos que tienen la misma textura. se diferencia de los conglomerados, las areniscas y las lutitas por la polimodalidad y la ausencia de estructuras relacionadas con su transporte y sedimentación por acción del aire o del agua. si no puede ser determinado el origen clástico o diagenético de más del 10 por ciento de la matriz de grano fino, y la fábrica es matriz soportada, puede ser considerada también como una grauvaca."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/lutita","prefLabel":{"en":"mudstone","es":"lutita"},"definition":{"en":"Clastic sedimentary rock consisting of less than 30 percent sand-size (0.6 mm) particles and with a mud to sand ratio greater than 1.","es":"Roca sedimentaria clástica con menos de un 30 por ciento de clastos de tamaño arena (0,6 - 2,0 mm de diámetro) y una relación entre partículas de lutita y granos de arena mayor que 1."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/arcillita","prefLabel":{"en":"claystone","es":"arcillita"},"definition":{"en":"Mudstone that contains no detectable silt, inferred to consist virtually entirely of clay-size particles.","es":"Lutita cuyo contenido de limos es indetectable y se considera que está formada exclusivamente por partículas de tamaño arcilla."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/limolita","prefLabel":{"en":"siltstone","es":"limolita"},"definition":{"en":"Mudstone that contains detectable silt. (see comments)","es":"Lutita que contiene más de un 50 por ciento de partículas de tamaño limo."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/shale","prefLabel":{"en":"shale","es":"shale"},"definition":{"en":"Laminated mudstone that will part or break along thin, closely spaced layers parallel to stratification.","es":"Lutita laminada que puede ser partida o rota a favor de niveles delgados paralelos a la estratificación."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico","prefLabel":{"en":"clastic sediment","es":"sedimento clástico"},"definition":{"en":"Sediment in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity.","es":"Sedimento en el que al menos el 50 por ciento de las partículas constituyentes provienen de la erosión, la meteorización o el movimiento en masa de materiales preexistentes, que han sido transportados hasta su lugar de depósito por agentes mecánicos, tales como el agua, el viento, el hielo y la gravedad."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/arena","prefLabel":{"en":"sand","es":"arena"},"definition":{"en":"Clastic sediment in which less than 30 percent of particles are gravel (greater than 2 mm in diameter) and the sand to mud ratio is at least 1. more than half of the particles are of epiclastic origin.","es":"Sedimento clástico con menos de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro) y una relación entre granos de arena y partículas de lutita mayor que 1. más de la mitad de las partículas son de origen epiclástico."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/diamicton","prefLabel":{"en":"diamicton","es":"diamictón"},"definition":{"en":"Unsorted or poorly sorted, clastic sediment with a wide range of particle sizes, including a muddy matrix. biogenic materials that have such texture are excluded. distinguished from conglomerate, sandstone, mudstone based on polymodality and lack of structures related to transport and deposition of sediment by moving air or water. assignment to an other size class can be used in conjunction to indicate the dominant grain size.","es":"Sedimento clástico sin selección o mal seleccionado, de granulometría muy variada, con matriz lutítica. no incluye a los materiales biogénicos que tienen la misma textura. se diferencia de los conglomerados, las areniscas y las lutitas por la polimodalidad y la ausencia de estructuras relacionadas con su transporte y depósito por acción del aire o del agua. su denominación puede complementarse con la granulometría predominante."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/grava","prefLabel":{"en":"gravel","es":"grava"},"definition":{"en":"Clastic sediment containing greater than 30 percent gravel-size particles (greater than 2.0 mm diameter). gravel in which more than half of the particles are of epiclastic origin","es":"Sedimento clástico que contiene más de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro). más de la mitad de los clastos son de origen epiclástico."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/pelita","prefLabel":{"en":"mud","es":"pelita"},"definition":{"en":"Clastic sediment consisting of less than 30 percent sand-size (0.6 mm) particles and with a mud-size to sand-size particle ratio greater than 1. more than half of the particles are of epiclastic origin.","es":"Sedimento clástico con menos de un 30 por ciento de clastos de tamaño arena (0,6 - 2,0 mm de diámetro) y una relación entre partículas de lutita y granos de arena mayor que 1. más de la mitad de las partículas son de origen epiclástico."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/arcilla","prefLabel":{"en":"clay","es":"arcilla"},"definition":{"en":"Mud that consists of greater than 50 percent particles with grain size less than 0.004 mm","es":"Fango que contiene más de un 50 por ciento de partículas de granulometría inferior a 0,004 mm."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/limo","prefLabel":{"en":"silt","es":"limo"},"definition":{"en":"Mud that consists of greater than 50 percent silt-size grains.","es":"Fango que contiene más de un 50 por ciento de partículas de tamaño limo."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-fosfatado","prefLabel":{"en":"phosphate rich sedimentary material","es":"material sedimentario fosfatado"},"definition":{"en":"Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are phosphate minerals.","es":"Material sedimentario, en un estado de consolidación sin especificar, en el que como mínimo el 50 por ciento de sus componentes, ya sean primarios o recristalizados, son fosfatos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/fosforita","prefLabel":{"en":"phosphorite","es":"fosforita"},"definition":{"en":"Sedimentary rock in which at least 50 percent of the primary or recrystallized constituents are phosphate minerals. most commonly occurs as a bedded primary or reworked secondary marine rock, composed of microcrystalline carbonate fluorapatite in the form of lamina, pellets, oolites and nodules, and skeletal, shell and bone fragments.","es":"Roca sedimentaria en la que al menos el 50 por ciento de sus componentes, ya sean primarios o recristalizados, son fosfatos. habitualmente corresponde a una roca marina estratificada o retrabajada, compuesta por microcristales de fluorapatito cálcico en forma de láminas, pellets, oolitos y nódulos, y fragmentos de esqueletos, conchas y huesos."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-fosfatado","prefLabel":{"en":"phosphate rich sediment","es":"sedimento fosfatado"},"definition":{"en":"Sediment in which at least 50 percent of the primary and/or recrystallized constituents are phosphate minerals.","es":"Sedimento en el que como mínimo el 50 por ciento de sus componentes, ya sean primarios o recristalizados, son fosfatos."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-quimico","prefLabel":{"en":"chemical sedimentary material","es":"material sedimentario químico"},"definition":{"en":"Sedimentary material that consists of at least 50 percent material produced by inorganic chemical processes within the basin of deposition. includes inorganic síliceous, carbonate, evaporite, iron-rich, and phosphatic sediment classes.","es":"Material sedimentario constituido al menos en el 50 por ciento por material producido por procesos químicos inorgánicos dentro de la cuenca de sedimentación. incluye sedimentos inorgánicos silíceos, carbonatados, evaporíticos, ferruginosos y fosfáticos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/evaporita","prefLabel":{"en":"evaporite","es":"evaporita"},"definition":{"en":"Nonclastic sedimentary rock composed of at least 50 percent non-carbonate salts, including chloride, sulfate or borate minerals; formed through precipitation of mineral salts from a saline solution (non-carbonate salt rock).","es":"Roca sedimentaria no clástica compuesta como mínimo por un 50 por ciento de sales no carbonatadas, incluyendo cloruros, sulfatos o boratos. se forma por la precipitación de sales minerales de una solución salina (rocas de sales no carbonatadas)."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/evaporita-exotica","prefLabel":{"en":"exotic evaporite","es":"evaporita exótica"},"definition":{"en":"Evaporite that is not 50 percent halite or 50 percent gypsum or anhydrite.","es":"Evaporita que no contiene un porcentaje del 50 por ciento de halita, yeso o anhidrita."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sal","prefLabel":{"en":"rock salt","es":"sal"},"definition":{"en":"Evaporite composed of at least 50 percent halite.","es":"Evaporita compuesta, al menos en un 50 por ciento, por halita."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/yeso-o-anhidrita","prefLabel":{"en":"gypsum or anhydrite","es":"yeso o anhidrita"},"definition":{"en":"Evaporite composed of at least 50 percent gypsum or anhydrite.","es":"Evaporita formada por un mínimo del 50 por ciento de yeso o anhidrita."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-ferruginoso","prefLabel":{"en":"iron rich sedimentary material","es":"material sedimentario ferruginoso"},"definition":{"en":"Sedimentary material of unspecified consolidation state that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. corresponds to a rock typically containing 15 percent iron by weight.","es":"Material sedimentario en un estado de consolidación sin especificar  compuesto, al menos en un 50 por ciento, por minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro) determinados mediante lupa o análisis petrográfico. generalmente contiene un 15 por ciento de hierro en peso."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimetaria-ferruginosa","prefLabel":{"en":"iron rich sedimentary rock","es":"roca sedimetaria ferruginosa"},"definition":{"en":"Sedimentary rock that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. corresponds to a rock typically containing 15 percent iron by weight.","es":"Roca sedimentaria compuesta, al menos en un 50 por ciento, por minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro), determinados mediante lupa o análisis petrográfico. generalmente contiene un 15 por ciento de hierro en peso."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-ferruginoso","prefLabel":{"en":"iron rich sediment","es":"sedimento ferruginoso"},"definition":{"en":"Sediment that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. corresponds to a rock typically containing 15 percent iron by weight.","es":"Sedimento compuesto, como mínimo en un 50 por ciento, por minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro) determinados mediante lupa o análisis petrográfico. generalmente contiene un 15 por ciento de hierro en peso."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/travertino","prefLabel":{"en":"travertine","es":"travertino"},"definition":{"en":"Biotically or abiotically precipitated calcium carbonate, from spring-fed, heated, or ambient-temperature water. may be white and spongy, various shades of orange, tan or gray, and ranges to dense, banded or laminated rock. macrophytes, bryophytes, algae, cyanobacteria and other organisms often colonize the surface of travertine and may be preserved, to produce the porous varieties.","es":"Caliza formada por precipitación biótica o abiótica de manantiales, ya sean de agua caliente o de temperatura ambiente. puede ser blanco y esponjoso, con sombreados de color naranja, marrón o gris, y varía de denso a bandeado o laminado. macrofitas, briofitas, algas, cianobacterias y otros organismos suelen colonizar la superficie del travertino y pueden conservarse, generando las variedades porosas."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-rico-en-materia-organica","prefLabel":{"en":"organic rich sedimentary material","es":"material sedimentario rico en materia orgánica"},"definition":{"en":"Sedimentary material in which 50 percent or more of the primary sedimentary material is organic carbon.","es":"Material sedimentario en el que al menos el 50 por ciento del material sedimentario primario es carbono orgánico."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-rica-en-materia-organica","prefLabel":{"en":"organic rich sedimentary rock","es":"roca rica en materia orgánica"},"definition":{"en":"Sedimentary rock with color, composition, texture and apparent density indicating greater than 50 percent organic content by weight on a moisture-free basis.","es":"Roca sedimentaria cuyo color, composición, textura y densidad aparente indican que contiene más del 50 por ciento en peso (en seco) de materia orgánica."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/carbon","prefLabel":{"en":"coal","es":"carbón"},"definition":{"en":"A consolidated organic sedimentary material having less than 75 por ciento moisture. this category includes low, medium, and high rank coals according to international classification of in-seam coal (united nations, 1998), thus including lignite. sapropelic coal is not distinguished in this category from humic coals. formed from the compaction or induration of variously altered plant remains similar to those of peaty deposits.","es":"Material sedimentario orgánico consolidado que tiene menos de un 75 por ciento de humedad. incluye a los carbones de rangos bajo, medio y alto según la clasificación internacional de carbones en veta (naciones unidas, 1998), por lo tanto incluye al lignito. el carbón sapropélico no se diferencia de los carbones húmicos dentro de esta denominación. se forma a partir de la compactación o el endurecimiento de restos de plantas, de manera similar a los depósitos de turba."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/antracita","prefLabel":{"en":"anthracite coal","es":"antracita"},"definition":{"en":"Coal that has vitrinite mean random reflectance greater than 2.0 per cent (determined in conformance with iso 7404-5). less than 12-14 percent volatiles (dry, ash free), greater than 91 percent fixed carbon (dry, ash free basis). the highest rank coal; very hard, glossy, black, with semimetallic luster, semi conchoidal fracture.","es":"Carbón que contiene vitrinita con un valor medio de reflectancia (ro) superior al 2 por ciento (determinado según la iso 7404-5). contiene (en seco y libre de cenizas) valores inferiores al 12-14 por ciento de volátiles y un porcentaje superior al 91 por ciento de carbono fijado. es el carbón de mayor rango. es muy duro, satinado, negro, con brillo semimetálico y fractura semi-concoidea."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/hulla","prefLabel":{"en":"bituminous coal","es":"hulla"},"definition":{"en":"Coal that has vitrinite mean random reflectance greater than 0.6 por ciento and less than 2.0 por ciento (determined in conformance with iso 7404-5), or has a gross calorific value greater than 24 mj/kg (determined in conformance with iso 1928). hard, black, organic rich sedimentary rock; contains less than 91 percent fixed carbon on a dry, mineral-matter-free basis, and greater than 13-14 percent volatiles (dry, ash free). formed from the compaction or induration of variously altered plant remains similar to those of peaty deposits.","es":"Carbón que contiene vitrinita con un valor medio de reflectancia (ro) superior a 0,6 por ciento/ro e inferior a 2,0 por ciento  (determinado según la iso 7404-5) y con un poder calorífico mayor de 24mj/kg (determinado según la iso 1928). se trata de una roca sedimentaria rica en materia orgánica, dura y negra; contiene menos de un 91 por ciento de carbono en seco y sin impurezas, y presenta valores superiores al 13-14 por ciento de volátiles, también en seco y sin contar las cenizas. se forma a partir de la compactación o el endurecimiento de restos de plantas, de manera similar a los depósitos de turba."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/lignito","prefLabel":{"en":"lignite","es":"lignito"},"definition":{"en":"Coal that has a gross calorific value less than 24 mj/kg (determined in conformance with iso 1928), and vitrinite mean random reflectance less than 0.6 por ciento (determined in conformance with iso 7404-5). gross calorific value is recalculated to a moist, ash free basis using bed moisture (determined according to iso 1015 or iso 5068). includes all low-rank coals, including sub-bitiminous coal. a consolidated, dull, soft brown to black coal having many readily discernible plant fragments set in a finer grained organic matrix. tends to crack and fall apart on drying. operationally sub-bituminous and bitiminous coal are qualitatively distinguished based on brown streak for sub-bitiminous coal and black streak for bituminous coal.","es":"Carbón consolidado, sin brillo, de marrón suave a negro, en el que pueden distinguirse fragmentos de plantas en una matriz orgánica de grano fino. incluye a todos los carbones de bajo rango, incluido el carbón sub-bituminoso, cuyas vetas marrones permiten su distinción con respecto al carbón bituminoso, de vetas negras. tiende a fracturarse al secarse. tiene un poder calorífico inferior a 24mj/kg (determinado según la iso 1928) y la reflectancia de la vitrinita es inferior al 0,6 por ciento (determinada según la iso 7404-5). el valor calorífico bruto se recalcula libre de cenizas y humedad usando la humedad inherente (determinado según la iso 1015 o la iso 5068)."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-siliceo-no-clastico","prefLabel":{"en":"non-clastic siliceous sedimentary material","es":"material sedimentario silíceo no clástico"},"definition":{"en":"Sedimentary material that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition.","es":"Material sedimentario formado al menos en el 50 por ciento por material mineral de silicatos, depositado en la superficie de deposición directamente por procesos químicos o biológicos o en partículas formadas por procesos químicos o biológicos dentro de la cuenca de deposición."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-no-clastica","prefLabel":{"en":"non-clastic siliceous sedimentary rock","es":"roca sedimentaria silícea no clástica"},"definition":{"en":"Sedimentary rock that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition.","es":"Roca sedimentaria compuesta, como mínimo en un 50 por ciento, por material silíceo depositado por procesos biológicos o químicos sobre la superficie de sedimentación, o por partículas formadas por procesos químicos o biológicos en la cuenca de sedimentación."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-biogenica","prefLabel":{"en":"biogenic silica sedimentary rock","es":"roca sedimentaria silícea biogénica"},"definition":{"en":"Sedimentary rock that consists of at least 50 percent silicate mineral material, deposited directly by biological processes at the depositional surface, or in particles formed by biological processes within the basin of deposition.","es":"Roca sedimentaria compuesta, al menos en un 50 por ciento, por material mineral silíceo, sedimentado como resultado de procesos biológicos sobre la superficie de depósito o en partículas dentro de la cuenca sedimentaria."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/sedimento-siliceo-no-clastico","prefLabel":{"en":"non-clastic siliceous sediment","es":"sedimento silíceo no clástico"},"definition":{"en":"Sediment that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition.","es":"Sedimento compuesto, como mínimo en un 50 por ciento, por material silíceo depositado por procesos biológicos o químicos sobre la superficie de sedimentación, o por partículas formadas por procesos químicos o biológicos en la cuenca sedimentaria."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/barro-de-radiolarios","prefLabel":{"en":"siliceous ooze","es":"barro de radiolarios"},"definition":{"en":"Ooze that consists of more than 50 percent siliceous skeletal remains","es":"Fango constituido, en más de un 50 por ciento, por restos de esqueletos silíceos."}}]}]}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca","prefLabel":{"en":"rock","es":"roca"},"definition":{"en":"Consolidated aggregate of one or more earth materials, or a body of undifferentiated mineral matter, or of solid organicmaterial.","es":"Agregado consolidado de uno o más materiales terrestres, o cuerpo de materia mineral indiferenciada o de materia orgánica sólida."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/afanita","prefLabel":{"en":"aphanite","es":"afanita"},"definition":{"en":"Rock that is too fine grained to categorize in more detail.","es":"Roca de granulometría demasiado fina para clasificarla con mayor detalle."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria","prefLabel":{"en":"sedimentary rock","es":"roca sedimentaria"},"definition":{"en":"Rock formed by accumulation and cementation of solid fragmental material deposited by air, water or ice, or as a result of other natural agents, such as precipitation from solution, the accumulation of organicmaterial, or from biogenic processes, including secretion by organisms.","es":"Roca formada por acumulación y cementación de material detrítico sólido depositado por el aire, el agua o el hielo, o resultante de la acción de otros agentes naturales, como la precipitación de una solución, la acumulación de material orgánico o procesos biogénicos como la secreción por organismos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/arenisca-generica","prefLabel":{"en":"generic sandstone","es":"arenisca genérica"},"definition":{"en":"Sedimentary rock in which less than 30 percent of particles are greater than 2 mm in diameter (gravel) and the sand to mud ratio is at least 1.","es":"Roca sedimentaria con menos de un 30 por ciento de componentes mayores de 2 mm de diámetro (grava) y cuya relación entre el contenido de granos de arena y de partículas de lutita es al menos 1."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/conglomerado-generico","prefLabel":{"en":"generic conglomerate","es":"conglomerado genérico"},"definition":{"en":"Sedimentary rock composed of at least 30 percent rounded to subangular fragments larger than 2 mm in diameter; typically contains finer grained material in interstices between larger fragments. if more than 15 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wackestone. if rock has unsorted or poorly sorted texture with a wide range of particle sizes, may also be categorized as diamictite.","es":"Roca sedimentaria compuesta al menos por un 30 por ciento de clastos redondeados o subangulosos de diámetro superior a 2 mm; generalmente, los huecos entre los fragmentos están rellenos de material más fino. si no puede ser determinado el origen clástico o diagenético de más del 15 por ciento de la matriz de grano fino y la fábrica es matriz-soportada, puede ser considerada como una grauvaca. si la roca está mal seleccionada, con granulometría muy variada, también puede ser considerada una diamictita."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/lutita-generica","prefLabel":{"en":"generic mudstone","es":"lutita genérica"},"definition":{"en":"Sedimentary rock consisting of less than 30 percent gravel-size (2 mm) particles and with a mud to sand ratio greater than 1. clasts may be of any composition or origin.","es":"Roca sedimentaria con menos de un 30 por ciento de componentes mayores de 2 mm de diámetro (grava) y cuya relación entre las partículas de lutita y los granos de arena es mayor que 1. los clastos pueden ser de cualquier composición y origen."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/litologia/lutita-organica","prefLabel":{"en":"organic bearing mudstone","es":"lutita orgánica"},"definition":{"en":"Mudstone that contains a significant amount of organic carbon, typically kerogen. commonly finely laminated, brown or black in color.","es":"Lutita con un contenido elevado de carbono orgánico, normalmente querógeno. suele presentar una fina laminación y su color es marrón o negro."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/lutita-rica-en-carbonatos","prefLabel":{"en":"carbonate rich mudstone","es":"lutita rica en carbonatos"},"definition":{"en":"Mudstone that contains between 10 and 50 percent carbonate minerals in the mud size fraction. carbonate origin is not specified.","es":"Lutita que contiene entre el 10 y el 50 por ciento de minerales carbonatados. no tiene un origen específico."}},{"id":"https://geo-carto.github.io/vocabularios/litologia/lutita-siliciclastica","prefLabel":{"en":"silicate mudstone","es":"lutita siliciclástica"},"definition":{"en":"Mudstone that contains less than 10 percent carbonate minerals.","es":"Lutita que contiene menos de un 10 por ciento de carbonatos."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-hibrida","prefLabel":{"en":"hybrid sedimentary rock","es":"roca sedimentaria híbrida"},"definition":{"en":"Sedimentary rock that does not fit any of the other composition/genesis categories. sedimentary rock consisting of three or more components which form more than 5 percent but less than 50 precent of the material.","es":"Roca sedimentaria que no encaja en ninguna otra de las categorías de roca sedimentaria según la composición o el origen. roca sedimentaria formada por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50 por ciento del material."}}]},{"id":"https://geo-carto.github.io/vocabularios/litologia/tufita","prefLabel":{"en":"tuffite","es":"tufita"},"definition":{"en":"Rock consists of more than 50 percent particles of indeterminate pyroclastic or epiclastic origin and less than 75 percent particles of clearly pyroclastic origin.","es":"Roca constituida en más del 50 por ciento por partículas de origen epiclástico o piroclástico indeterminado y en menos del 75 por ciento por partículas de origen claramente piroclástico."}}]}]}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","contributor":"dct:contributor","provenance":"dct:provenance","publisher":"dct:publisher","versionInfo":"owl:versionInfo","status":{"@id":"http://www.w3.org/ns/adms#status"},"preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container":"@language"},"narrower":{"@container":"@set"},"related":{"@container":"@set"},"relatedMatch":{"@container":"@set"},"narrowerTransitive":{"@container":"@set"},"broaderTransitive":{"@container":"@set"},"broadMatch":{"@container":"@set"},"narrowMatch":{"@container":"@set"},"closeMatch":{"@container":"@set"},"exactMatch":{"@container":"@set"},"hasTopConcept":{"@container":"@set"},"inScheme":{"@container":"@set"},"topConceptOf":{"@container":"@set"},"deprecated":{"@id":"owl:deprecated","@type":"xsd:boolean"},"isReplacedBy":{"@id":"dct:isReplacedBy","@container":"@set"}}}