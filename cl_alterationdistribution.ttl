@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geo-carto.github.io/vocabularios/alteracion-distribucion/collection> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:definition "Todos los conceptos en este vocabulario."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:member <https://geo-carto.github.io/vocabularios/alteracion-distribucion/bandeada>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/completa>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/diseminada>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/irregular>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/moteada>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/veteada> ;
    skos:prefLabel "Distribución de la alteración - Todos los conceptos"@es .

<https://linked.data.gov.au/org/cgi-gtwg> a sdo:Organization ;
    sdo:affiliation <https://linked.data.gov.au/org/cgi> ;
    sdo:name "CGI Geoscience Terminology Working Group" ;
    sdo:url <http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html> .

<https://linked.data.gov.au/org/cgi> a sdo:Organization ;
    sdo:name "Commission for the Management and Application of Geoscience Information" ;
    sdo:url <http://www.cgi-iugs.org> .

<https://geo-carto.github.io/vocabularios/alteracion-distribucion/bandeada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:definition "Alternating layers that differ in color, texture and/or composition."@en,
        "Alternancia de niveles que difieren en color, textura y/o composición."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:prefLabel "banded"@en,
        "bandeada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-distribucion/completa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:definition "Homogeneous distribution of color, texture and/or composition."@en,
        "Distribución homogénea de color, textura y/o composición."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:prefLabel "complete"@en,
        "completa"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-distribucion/diseminada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:definition "Irregular presence of spots characterized by color, texture and/or composition."@en,
        "Presencia irregular de concentraciones con color, textura y/o composición característicos."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:prefLabel "disseminated"@en,
        "diseminada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-distribucion/irregular> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:definition "Heterogeneous distribution of zones that differ in color, texture and/or composition."@en,
        "Distribución heterogénea de zonas que difieren en color, textura y/o composición."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:prefLabel "irregular"@en,
        "irregular"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-distribucion/moteada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:definition "Regular presence of spots characterized by color, texture and/or composition."@en,
        "Presencia regular de concentraciones con color, textura y/o composición característicos."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:prefLabel "spotted"@en,
        "moteada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-distribucion/veteada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:definition "Presence of layers, more or less tabular and irregular, characterized by color, texture and/or composition."@en,
        "Presencia de niveles, más o menos tabulares e irregulares, con color, textura y/o composición característicos."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    skos:prefLabel "veined"@en,
        "veteada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/alteracion-distribucion> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-distribucion> a skos:ConceptScheme ;
    dcterms:created "2026-03-01"^^xsd:date ;
    dcterms:creator "https://www.igme.es" ;
    dcterms:description "Términos que describen la distribución espacial o la geometría de las zonas de alteración (por ejemplo: irregular, moteada, bandeada, con vetas, brecha de vetas, generalizada, diseminada, etc.)."@es ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-03-01"^^xsd:date ;
    dcterms:provenance "Términos propios definidos por el IGME" ;
    dcterms:publisher <https://www.igme.es/> ;
    owl:versionInfo "1.0.0" ;
    skos:definition "The alterationDistribution property describes the spatial distribution or geometry of alteration zones using a term from a controlled vocabulary (e.g., patchy, spotted, banded, veins, vein breccia, pervasive, disseminated)."@en,
        "Términos que describen la distribución espacial o la geometría de las zonas de alteración (por ejemplo: irregular, moteada, bandeada, con vetas, brecha de vetas, generalizada, diseminada, etc.)."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Distribución de la alteración."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/alteracion-distribucion/bandeada>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/completa>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/diseminada>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/irregular>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/moteada>,
        <https://geo-carto.github.io/vocabularios/alteracion-distribucion/veteada> ;
    skos:prefLabel "Alteration distribution"@en,
        "Distribución de la alteración"@es .

