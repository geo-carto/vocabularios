<https://geo-carto.github.io/vocabularios/contribucion-rol/collection> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Todos los conceptos en este vocabulario."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:member <https://geo-carto.github.io/vocabularios/contribucion-rol/administrador-base-de-datos>,
        <https://geo-carto.github.io/vocabularios/contribucion-rol/autor>,
