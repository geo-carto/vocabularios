<https://geo-carto.github.io/vocabularios/mime-type/application-geo-json> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mime-type> ;
    skos:definition "GeoJSON format."@en,
        "Formato GeoJSON."@es ;
    skos:exactMatch <https://www.iana.org/assignments/media-types/application/geo+json>,
        <https://www.w3.org/ns/iana/media-types/application/geo+json> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mime-type> ;
    skos:prefLabel "application/geo+json"@en,
        "application/geo+json"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/mime-type> ;
    adms:status "Válido" .

