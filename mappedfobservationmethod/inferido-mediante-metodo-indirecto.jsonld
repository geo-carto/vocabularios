        "es": "inferido a partir de levantamiento radiométrico"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-registro-geofisico-de-sondeo",
      "prefLabel": {
