{
  "id": "https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto",
  "type": "Concept",
  "prefLabel": {
    "en": "inferred using indirect method",
    "es": "inferido mediante método indirecto"
  },
  "definition": {
    "en": "Location and specification inferred based on properties related to lithology, e.g. geophysical or geochemical signature, vegetation, surface texture, reflectance.",
    "es": "La ubicación y especificación se infieren a partir de propiedades relacionadas con la litología, como firmas geofísicas o geoquímicas, vegetación, textura superficial o reflectancia."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-datos-gravimetricos",
