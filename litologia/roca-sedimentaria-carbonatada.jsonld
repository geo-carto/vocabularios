{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada",
  "type": "Concept",
  "prefLabel": {
    "es": "roca sedimentaria carbonatada",
    "en": "carbonate sedimentary rock"
  },
  "definition": {
    "es": "Roca sedimentaria en la que al menos el 50 por ciento de los componentes primarios y/o recristalizados están constituidos por uno (o más) de los minerales carbonatados calcita, aragonito, magnesita y dolomita.",
    "en": "Sedimentary rock in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite, magnesite or dolomite."
  },
