{
  "id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava",
  "type": "Concept",
  "prefLabel": {
    "en": "gravel size sediment",
    "es": "sedimento de tamaño grava"
  },
  "definition": {
    "en": "Sediment containing greater than 30 percent gravel-size particles (greater than 2.0 mm diameter). composition or genesis of clasts not specified.",
    "es": "Sedimento que contiene más de un 30 por ciento de partículas de tamaño grava (más de 2,0 mm de diámetro). la composición o la génesis de los clastos no se especifican."
  },
