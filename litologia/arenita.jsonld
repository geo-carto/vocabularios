{
  "id": "https://geo-carto.github.io/vocabularios/litologia/arenita",
  "type": "Concept",
  "prefLabel": {
    "en": "arenite",
    "es": "arenita"
  },
  "definition": {
    "en": "Clastic sandstone that contains less than 10 percent matrix. matrix is mud-size silicate minerals (clay, feldspar, quartz, rock fragments, and alteration products) of detrital or diagenetic nature.",
    "es": "Arenisca clástica que contiene menos del 10 por ciento de matriz. la matriz es de origen detrítico o diagenético y está formada por silicatos de tamaño lutita (arcilla, feldespatos, cuarzo, fragmentos de roca y productos de alteración)."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/arenisca",
    "prefLabel": {
      "en": "sandstone",
      "es": "arenisca"
    }
  },
