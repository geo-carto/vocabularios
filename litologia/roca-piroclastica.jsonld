{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-piroclastica",
  "type": "Concept",
  "prefLabel": {
    "en": "pyroclastic rock",
    "es": "roca piroclástica"
  },
  "definition": {
    "en": "Fragmental igneous rock that consists of greater than 75 percent fragments produced as a direct result of eruption or extrusion of magma from within the earth onto its surface. includes autobreccia associated with lava flows and excludes deposits reworked by epiclastic processes.",
    "es": "Roca ígnea constituida por productos fragmentarios de los cuales más de un 75 por ciento se han producido como resultado de una erupción o extrusión de magma. incluye a las autobrechas asociadas con los flujos de lava y excluye a los depósitos retrabajados por procesos epiclásticos."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/brecha-tobacea,-aglomerado-o-brecha-piroclastica",
      "prefLabel": {
        "en": "tuff-breccia, agglomerate, or pyroclastic breccia",
        "es": "brecha tobácea, aglomerado o brecha piroclástica"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/toba-de-ceniza,-lapillistone-y-toba-de-lapilli",
      "prefLabel": {
        "en": "ash tuff, lapillistone, and lapilli tuff",
        "es": "toba de ceniza, lapillistone y toba de lapilli"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-fragmentaria",
    "prefLabel": {
      "en": "fragmental igneous rock",
      "es": "roca ígnea fragmentaria"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/pyroclasticRock"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"
    }
  ],
  "inScheme": [
    {
