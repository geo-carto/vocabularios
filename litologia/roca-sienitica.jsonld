{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sienitica",
  "type": "Concept",
  "prefLabel": {
    "en": "synitic rock",
    "es": "roca sienítica"
  },
  "definition": {
    "en": "Syenitoid with a plagioclase to total feldspar ratio between 0.1 and 0.35. includes rocks in qapf fields 7, 7*, and 7'.",
    "es": "Sienitoide en el que la proporción entre la plagioclasa y el total de feldespato está comprendida entre el 10 y el 35 por ciento. incluye las rocas de los sectores 7, 7' y 7* del diagrama qapf."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita",
      "prefLabel": {
        "en": "quartz syenite",
        "es": "cuarzo-sienita"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/sienita",
      "prefLabel": {
        "en": "syenite",
        "es": "sienita"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/sienita-con-foides",
      "prefLabel": {
        "en": "foid bearing syenite",
        "es": "sienita con foides"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/sienitoide",
    "prefLabel": {
      "en": "syenitoid",
      "es": "sienitoide"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/syniticRock"
    },
