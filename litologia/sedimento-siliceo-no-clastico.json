{
  "id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-siliceo-no-clastico",
  "type": "Concept",
  "prefLabel": {
    "en": "non-clastic siliceous sediment",
    "es": "sedimento silíceo no clástico"
  },
  "definition": {
    "en": "Sediment that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition.",
    "es": "Sedimento compuesto, como mínimo en un 50 por ciento, por material silíceo depositado por procesos biológicos o químicos sobre la superficie de sedimentación, o por partículas formadas por procesos químicos o biológicos en la cuenca sedimentaria."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/barro-de-radiolarios",
      "prefLabel": {
        "en": "siliceous ooze",
        "es": "barro de radiolarios"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-siliceo-no-clastico",
