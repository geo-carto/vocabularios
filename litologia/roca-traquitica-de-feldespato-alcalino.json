{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-traquitica-de-feldespato-alcalino",
  "type": "Concept",
  "prefLabel": {
    "es": "roca traquítica de feldespato alcalino",
    "en": "alkali feldspar trachytic rock"
  },
  "definition": {
    "es": "Traquitoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 10 por ciento. sectores 6, 6* y 6' del diagrama qapf.",
    "en": "Trachytoid that has a plagioclase to total feldspar ratio less than 0.1. qapf fields 6, 6', and 6*."
  },
