{
  "id": "https://geo-carto.github.io/vocabularios/litologia/skarn",
  "type": "Concept",
  "prefLabel": {
    "es": "skarn",
    "en": "skarn"
  },
  "definition": {
    "es": "Roca metasomática compuesta principalmente por silicatos de calcio, magnesio, hierro o manganeso anhidros o pobres en agua. normalmente se forman en el contacto entre una roca o un magma silicatado y una roca carbonatada.",
    "en": "Metasomatic rock consisting mainly of ca-, mg-, fe-, or mn-silicate minerals, which are free from or poor in water. typically formed at the contact between a silicate rock or magma and a carbonate rock."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/roca-metasomatica",
    "prefLabel": {
      "es": "roca metasomática",
      "en": "metasomatic rock"
    }
  },
