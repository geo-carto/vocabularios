{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada",
  "type": "Concept",
  "prefLabel": {
    "en": "foliated metamorphic rock",
    "es": "roca metamórfica foliada"
  },
  "definition": {
    "en": "Metamorphic rock in which 10 percent or more of the contained mineral grains are elements in a planar or linear fabric. cataclastic or glassy character precludes classification with this concept.",
    "es": "Roca metamórfica en la que el 10 por ciento o más de los componentes minerales tienen una fábrica planar o linear. la naturaleza cataclástica o vítrea excluyen la clasificación bajo este concepto."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/esquisto",
      "prefLabel": {
        "en": "schist",
        "es": "esquisto"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/filita",
