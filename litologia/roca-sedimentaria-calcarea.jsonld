{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-calcarea",
  "type": "Concept",
  "prefLabel": {
    "es": "roca sedimentaria calcárea",
    "en": "calcareous carbonate sedimentary rock"
  },
  "definition": {
    "es": "Roca sedimentaria carbonatada cuya proporción entre calcita (más aragonito) y dolomita es mayor que 1. incluye a las calizas y las calizas dolomíticas.",
    "en": "Carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes limestone and dolomitic limestone."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/caliza",
      "prefLabel": {
        "es": "caliza",
        "en": "limestone"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/caliza-impura",
      "prefLabel": {
        "es": "caliza impura",
        "en": "impure limestone"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-calcareo",
    "prefLabel": {
      "es": "material sedimentario calcáreo",
      "en": "calcareous carbonate sedimentary material"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/calcareousCarbonateSedimentaryRock"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sedimentary_rock"
    }
  ],
