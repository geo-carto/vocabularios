{
  "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-clastico",
  "type": "Concept",
  "prefLabel": {
    "es": "material sedimentario clástico",
    "en": "clastic sedimentary material"
  },
  "definition": {
    "es": "Material sedimentario con un estado de consolidación no especificado en el que al menos el 50 por ciento de las partículas componentes derivan de la erosión, la meteorización o del movimiento en masa de materiales terrestres preexistentes y transportados al lugar de sedimentación por agentes mecánicos como el agua, el viento, el hielo o la gravedad.",
    "en": "Sedimentary material of unspecified consolidation state in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica",
