{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica",
  "type": "Concept",
  "prefLabel": {
    "en": "metamorphic rock",
    "es": "roca metamórfica"
  },
  "definition": {
    "en": "Rock formed by solid-state mineralogical, chemical and/or structural changes to a pre-existing rock, in response to marked changes in temperature, pressure, shearing stress and chemical environment.",
    "es": "Roca generada por los cambios mineralógicos, texturales y/o estructurales, en estado sólido, producidos sobre una roca pre-existente, como respuesta a cambios importantes de temperatura, presión, esfuerzos de cizalla o condiciones químicas del ambiente."
  },
