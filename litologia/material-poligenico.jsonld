{
  "id": "https://geo-carto.github.io/vocabularios/litologia/material-poligenico",
  "type": "Concept",
  "prefLabel": {
    "en": "composite genesis material",
    "es": "material poligénico"
  },
  "definition": {
    "en": "Material of unspecified consolidation state formed by geological modification of pre-existing materials outside the realm of igneous and sedimentary processes.",
    "es": "Material con un estado de consolidación no especificado formado por modificación geológica de materiales preexistentes fuera del ámbito de los procesos ígneos y sedimentarios."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/alterita",
      "prefLabel": {
        "en": "material formed in surficial environment",
        "es": "Alterita"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-generado-por-un-impacto",
      "prefLabel": {
        "en": "impact generated material",
        "es": "material generado por un impacto"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-relacionado-con-una-falla",
      "prefLabel": {
        "en": "fault-related material",
        "es": "material relacionado con una falla"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/roca-poligenica",
      "prefLabel": {
        "en": "composite genesis rock",
        "es": "roca poligénica"
      }
    }
  ],
  "broader": {
