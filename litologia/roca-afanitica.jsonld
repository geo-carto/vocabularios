      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/roca-volcanica-magnesica",
      "prefLabel": {
        "en": "high magnesium fine grained igneous rock",
        "es": "roca volcánica magnésica"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/tefritoide",
      "prefLabel": {
        "en": "tephritoid",
        "es": "tefritoide"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/traquitoide",
      "prefLabel": {
        "en": "trachytoid",
        "es": "traquitoide"
      }
    }
  ],
