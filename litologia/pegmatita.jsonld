{
  "id": "https://geo-carto.github.io/vocabularios/litologia/pegmatita",
  "type": "Concept",
  "prefLabel": {
    "en": "pegmatite",
    "es": "pegmatita"
  },
  "definition": {
    "en": "Exceptionally coarse grained crystalline rock with interlocking crystals; most grains are 1cm or more diameter; composition is generally that of granite, but the term may refer to the coarse grained facies of any type of igneous rock;usually found as irregular dikes, lenses, or veins associated with plutons or batholiths.",
    "es": "Roca cristalina de grano excepcionalmente grueso, mayoritariamente de más de 1 cm de diámetro, con intercrecimiento de cristales; generalmente su composición es la del granito, pero se refiere a cualquier roca ígnea de grano grueso. habitualmente aparece como diques irregulares, lentejones o venas asociadas a plutones o batolitos."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica",
    "prefLabel": {
      "en": "phaneritic igneous rock",
      "es": "roca ígnea fanerítica"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/pegmatite"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/pegmatite"
    }
  ],
