{
  "id": "https://geo-carto.github.io/vocabularios/litologia/lutita-generica",
  "type": "Concept",
  "prefLabel": {
    "es": "lutita genérica",
    "en": "generic mudstone"
  },
  "definition": {
    "es": "Roca sedimentaria con menos de un 30 por ciento de componentes mayores de 2 mm de diámetro (grava) y cuya relación entre las partículas de lutita y los granos de arena es mayor que 1. los clastos pueden ser de cualquier composición y origen.",
    "en": "Sedimentary rock consisting of less than 30 percent gravel-size (2 mm) particles and with a mud to sand ratio greater than 1. clasts may be of any composition or origin."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/lutita-organica",
      "prefLabel": {
        "es": "lutita orgánica",
