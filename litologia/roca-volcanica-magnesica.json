{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-volcanica-magnesica",
  "type": "Concept",
  "prefLabel": {
    "en": "high magnesium fine grained igneous rock",
    "es": "roca volcánica magnésica"
  },
  "definition": {
    "en": "Fine-grained igneous rock that contains unusually high concentration of mgo. for rocks that contain greater than 52 percent silica, mgo must be greater than 8 percent. for rocks containing less than 52 percent silica, mgo must be greater than 12 percent.",
    "es": "Roca volcánica con una concentración inusualmente elevada de mgo. en rocas con un porcentaje superior al 52 de sílice, el contenido en mgo debe ser superior al 8 por ciento. en rocas con menos del 52 por ciento de sílice, el contenido de mgo debe ser superior al 12 por ciento."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/roca-komatiitica",
      "prefLabel": {
        "en": "komatiitic rock",
        "es": "roca komatiítica"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/roca-afanitica",
    "prefLabel": {
      "en": "fine grained igneous rock",
      "es": "roca afanítica"
    }
  },
