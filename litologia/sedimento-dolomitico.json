{
  "id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico",
  "type": "Concept",
  "prefLabel": {
    "es": "sedimento dolomítico",
    "en": "dolomitic sediment"
  },
  "definition": {
    "es": "Sedimento carbonatado con una relación entre dolomita y calcita (incluyendo el aragonito) mayor que 1.",
    "en": "Carbonate sediment with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1."
  },
