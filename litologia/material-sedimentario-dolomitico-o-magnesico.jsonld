{
  "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-dolomitico-o-magnesico",
  "type": "Concept",
  "prefLabel": {
    "en": "dolomitic or magnesian sedimentary material",
    "es": "material sedimentario dolomítico o magnésico"
  },
  "definition": {
    "en": "Carbonate sedimentary material of unspecified consolidation degree with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. includes dolomite sediment, dolostone, lime dolostone and magnesite-stone.",
    "es": "Material sedimentario carbonatado, en un estado de consolidación sin especificar, con una relación entre carbonato de magnesio y carbonato cálcico (incluyendo el aragonito) superior a 1. incluye el material sedimentario dolomítico, la dolomía, la dolomía calcárea y la magnesita."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado",
    "prefLabel": {
      "en": "carbonate sedimentary material",
      "es": "material sedimentario carbonatado"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/dolomiticOrMagnesianSedimentaryMaterial"
    },
