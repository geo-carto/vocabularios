{
  "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-ferruginoso",
  "type": "Concept",
  "prefLabel": {
    "en": "iron rich sedimentary material",
    "es": "material sedimentario ferruginoso"
  },
  "definition": {
    "en": "Sedimentary material of unspecified consolidation state that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. corresponds to a rock typically containing 15 percent iron by weight.",
    "es": "Material sedimentario en un estado de consolidación sin especificar  compuesto, al menos en un 50 por ciento, por minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro) determinados mediante lupa o análisis petrográfico. generalmente contiene un 15 por ciento de hierro en peso."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimetaria-ferruginosa",
      "prefLabel": {
        "en": "iron rich sedimentary rock",
        "es": "roca sedimetaria ferruginosa"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-ferruginoso",
      "prefLabel": {
        "en": "iron rich sediment",
        "es": "sedimento ferruginoso"
      }
    }
  ],
  "broader": {
