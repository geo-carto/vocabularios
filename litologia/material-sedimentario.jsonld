{
  "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario",
  "type": "Concept",
  "prefLabel": {
    "en": "sedimentary material",
    "es": "material sedimentario"
  },
  "definition": {
    "en": "Material formed by accumulation of solid fragmental material deposited by air, water or ice, or material that accumulated by other natural agents such as chemical precipitation from solution or secretion by organisms.",
    "es": "Material formado por acumulación de fragmentos sólidos depositado por el aire, el agua o el hielo, o acumulado por la acción de otros agentes naturales, como la precipitación química de una solución o la secreción por organismos."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado",
      "prefLabel": {
        "en": "carbonate sedimentary material",
        "es": "material sedimentario carbonatado"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-clastico",
      "prefLabel": {
        "en": "clastic sedimentary material",
        "es": "material sedimentario clástico"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-fosfatado",
      "prefLabel": {
        "en": "phosphate rich sedimentary material",
        "es": "material sedimentario fosfatado"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-quimico",
      "prefLabel": {
        "en": "chemical sedimentary material",
        "es": "material sedimentario químico"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-rico-en-materia-organica",
      "prefLabel": {
        "en": "organic rich sedimentary material",
        "es": "material sedimentario rico en materia orgánica"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-siliceo-no-clastico",
      "prefLabel": {
        "en": "non-clastic siliceous sedimentary material",
        "es": "material sedimentario silíceo no clástico"
      }
    }
  ],
  "broader": {
