{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea",
  "type": "Concept",
  "prefLabel": {
    "en": "igneous rock",
    "es": "roca ígnea"
  },
  "definition": {
    "en": "Rock formed as a result of igneous processes, for example intrusion and cooling of magma in the crust, or volcanic eruption.",
    "es": "Roca formada como resultado de procesos ígneos, como la intrusión y enfriamiento del magma en la corteza o las erupciones volcánicas."
  },
