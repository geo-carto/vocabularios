  "type": "Concept",
  "prefLabel": {
    "es": "sedimento rico en materia orgánica",
    "en": "organic rich sediment"
  },
  "definition": {
    "es": "Sedimento cuyo color, composición, textura y densidad aparente indican que contiene más del 50 por ciento en peso (en seco) de materia orgánica.",
    "en": "Sediment with color, composition, texture and apparent density indicating greater than 50 percent organic content by weight on a moisture-free basis."
  },
