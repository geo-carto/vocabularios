        "en": "ash breccia, bomb, or block tephra",
        "es": "brecha de cenizas, tefra de bombas o bloques"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/ceniza-y-lapilli",
      "prefLabel": {
        "en": "ash and lapilli",
        "es": "ceniza y lapilli"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/material-de-origen-natural-no-consolidado",
