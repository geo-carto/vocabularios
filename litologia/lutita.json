{
  "id": "https://geo-carto.github.io/vocabularios/litologia/lutita",
  "type": "Concept",
  "prefLabel": {
    "en": "mudstone",
    "es": "lutita"
  },
  "definition": {
    "en": "Clastic sedimentary rock consisting of less than 30 percent sand-size (0.6 mm) particles and with a mud to sand ratio greater than 1.",
    "es": "Roca sedimentaria clástica con menos de un 30 por ciento de clastos de tamaño arena (0,6 - 2,0 mm de diámetro) y una relación entre partículas de lutita y granos de arena mayor que 1."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/arcillita",
      "prefLabel": {
        "en": "claystone",
