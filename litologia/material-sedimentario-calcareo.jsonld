{
  "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-calcareo",
  "type": "Concept",
  "prefLabel": {
    "en": "calcareous carbonate sedimentary material",
    "es": "material sedimentario calcáreo"
  },
  "definition": {
    "en": "Carbonate sedimentary material of unspecified consolidation state with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes lime-sediments, limestone and dolomitic limestone.",
    "es": "Material sedimentario carbonatado, en un estado de consolidación sin especificar, cuya proporción entre calcita (más aragonito) y dolomita es mayor que 1. incluye a los sedimentos calizos, las calizas y las calizas dolomíticas."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-calcarea",
      "prefLabel": {
        "en": "calcareous carbonate sedimentary rock",
        "es": "roca sedimentaria calcárea"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo",
      "prefLabel": {
        "en": "calcareous carbonate sediment",
        "es": "sedimento calcáreo"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado",
    "prefLabel": {
      "en": "carbonate sedimentary material",
      "es": "material sedimentario carbonatado"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/calcareousCarbonateSedimentaryMaterial"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sedimentary_material"
    }
  ],
  "inScheme": [
