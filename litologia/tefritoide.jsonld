{
  "id": "https://geo-carto.github.io/vocabularios/litologia/tefritoide",
  "type": "Concept",
  "prefLabel": {
    "es": "tefritoide",
    "en": "tephritoid"
  },
  "definition": {
    "es": "Roca volcánica que contiene menos de un 90 por ciento de minerales máficos, de un 10 a un 60 por ciento de feldespatoide entre los componentes qapf y cuya proporción de plagioclasa con respecto al total de feldespato es superior al 50 por ciento. incluye a las rocas clasificadas modalmente en los sectores 13 y 14 del diagrama qapf, o químicamente en el campo u1 del diagrama tas como basanita o tefrita.",
    "en": "Fine grained igneous rock than contains less than 90 percent mafic minerals, between 10 and 60 percent feldspathoid mineral in the qapf fraction and has a plagioclase to total feldspar ratio greater than 0.5. includes rocks classified in qapf field 13 and 14 or chemically in tas field u1 as basanite or tephrite."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/basanita",
      "prefLabel": {
        "es": "basanita",
        "en": "basanite"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/basanita-fonolitica",
      "prefLabel": {
        "es": "basanita fonolítica",
        "en": "phonolitic basanite"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/tefrita",
      "prefLabel": {
        "es": "tefrita",
        "en": "tephrite"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/tefrita-fonolitica",
      "prefLabel": {
        "es": "tefrita fonolítica",
        "en": "phonolitic tephrite"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/roca-afanitica",
    "prefLabel": {
      "es": "roca afanítica",
      "en": "fine grained igneous rock"
    }
  },
