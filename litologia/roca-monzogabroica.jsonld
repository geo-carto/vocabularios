{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica",
  "type": "Concept",
  "prefLabel": {
    "en": "monzogabbroic rock",
    "es": "roca monzogabroica"
  },
  "definition": {
    "en": "Gabbroid with a plagioclase to total feldspar ratio between 0.65 and 0.9. qapf field 9, 9 prime and 9 asterisk",
    "es": "Gabroide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento. incluye a las rocas de los sectores 9, 9' y 9* del diagrama qapf."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzogabro",
      "prefLabel": {
        "en": "quartz monzogabbro",
        "es": "cuarzo-monzogabro"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/monzogabro",
      "prefLabel": {
        "en": "monzogabbro",
        "es": "monzogabro"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/monzogabro-con-foides",
      "prefLabel": {
        "en": "foid bearing monzogabbro",
        "es": "monzogabro con foides"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/monzonita",
      "prefLabel": {
        "en": "monzonite",
        "es": "monzonita"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/gabroide",
