{
  "id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-fosfatado",
  "type": "Concept",
  "prefLabel": {
    "en": "phosphate rich sediment",
    "es": "sedimento fosfatado"
  },
  "definition": {
    "en": "Sediment in which at least 50 percent of the primary and/or recrystallized constituents are phosphate minerals.",
    "es": "Sedimento en el que como mínimo el 50 por ciento de sus componentes, ya sean primarios o recristalizados, son fosfatos."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-fosfatado",
    "prefLabel": {
      "en": "phosphate rich sedimentary material",
      "es": "material sedimentario fosfatado"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/phosphateRichSediment"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/phosphate_rich_sediment"
    }
  ],
