{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-biogenica",
  "type": "Concept",
  "prefLabel": {
    "es": "roca sedimentaria silícea biogénica",
    "en": "biogenic silica sedimentary rock"
  },
  "definition": {
    "es": "Roca sedimentaria compuesta, al menos en un 50 por ciento, por material mineral silíceo, sedimentado como resultado de procesos biológicos sobre la superficie de depósito o en partículas dentro de la cuenca sedimentaria.",
    "en": "Sedimentary rock that consists of at least 50 percent silicate mineral material, deposited directly by biological processes at the depositional surface, or in particles formed by biological processes within the basin of deposition."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-no-clastica",
    "prefLabel": {
      "es": "roca sedimentaria silícea no clástica",
      "en": "non-clastic siliceous sedimentary rock"
    }
  },
