{
  "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado",
  "type": "Concept",
  "prefLabel": {
    "en": "carbonate sedimentary material",
    "es": "material sedimentario carbonatado"
  },
  "definition": {
    "en": "Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin.",
    "es": "Material sedimentario en el que al menos el 50 de sus componentes primarios y/o recristalizados están formados por uno (o más) de los minerales carbonatados calcita, aragonito y dolomita, en partículas originarias de la misma cuenca de deposición."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-calcareo",
      "prefLabel": {
        "en": "calcareous carbonate sedimentary material",
        "es": "material sedimentario calcáreo"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-dolomitico-o-magnesico",
      "prefLabel": {
        "en": "dolomitic or magnesian sedimentary material",
        "es": "material sedimentario dolomítico o magnésico"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada",
      "prefLabel": {
        "en": "carbonate sedimentary rock",
        "es": "roca sedimentaria carbonatada"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado",
      "prefLabel": {
        "en": "carbonate sediment",
        "es": "sedimento carbonatado"
      }
    }
  ],
