{
  "id": "https://geo-carto.github.io/vocabularios/litologia/roca-gabroica",
  "type": "Concept",
  "prefLabel": {
    "en": "gabbroic rock",
    "es": "roca gabroica"
  },
  "definition": {
    "en": "Gabbroid that has a plagioclase to total feldspar ratio greater than 0.9 in the qapf fraction. includes qapf fields 10*, 10, and 10'. this category includes the various categories defined in lemaitre et al. (2002) based on the mafic mineralogy, but apparently not subdivided based on the quartz/feldspathoid content.",
    "es": "Gabroide con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. engloba los sectores 10*, 10 y 10' del diagrama qapf. esta clase incluye las categorías definidas en le maitre et al. (2002) basadas en los minerales máficos, pero no subdivididas en función del contenido en cuarzo/feldespatoide."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-gabro",
      "prefLabel": {
        "en": "quartz gabbro",
        "es": "cuarzo-gabro"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/gabro",
      "prefLabel": {
        "en": "gabbro",
        "es": "gabro"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/gabro-con-foides",
      "prefLabel": {
        "en": "foid bearing gabbro",
        "es": "gabro con foides"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-basica",
    "prefLabel": {
      "en": "basic igneous rock",
      "es": "roca ígnea básica"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/gabbroicRock"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"
    }
  ],
