{
  "id": "https://geo-carto.github.io/vocabularios/litologia/lutita-generica",
  "type": "Concept",
  "prefLabel": {
    "en": "generic mudstone",
    "es": "lutita genérica"
  },
  "definition": {
    "en": "Sedimentary rock consisting of less than 30 percent gravel-size (2 mm) particles and with a mud to sand ratio greater than 1. clasts may be of any composition or origin.",
    "es": "Roca sedimentaria con menos de un 30 por ciento de componentes mayores de 2 mm de diámetro (grava) y cuya relación entre las partículas de lutita y los granos de arena es mayor que 1. los clastos pueden ser de cualquier composición y origen."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/lutita-organica",
      "prefLabel": {
        "en": "organic bearing mudstone",
        "es": "lutita orgánica"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/lutita-rica-en-carbonatos",
      "prefLabel": {
        "en": "carbonate rich mudstone",
        "es": "lutita rica en carbonatos"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/lutita-siliciclastica",
      "prefLabel": {
        "en": "silicate mudstone",
        "es": "lutita siliciclástica"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria",
    "prefLabel": {
      "en": "sedimentary rock",
      "es": "roca sedimentaria"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/genericMudstone"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/generic_mudstone"
    }
  ],
  "inScheme": [
