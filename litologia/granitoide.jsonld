      "prefLabel": {
        "es": "granito de feldespato alcalino",
        "en": "alkali feldspar granite"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/granodiorita",
      "prefLabel": {
        "es": "granodiorita",
        "en": "granodiorite"
      }
    },
    {
