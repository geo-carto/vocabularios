{
  "id": "https://geo-carto.github.io/vocabularios/litologia/granitoide",
  "type": "Concept",
  "prefLabel": {
    "es": "granitoide",
    "en": "granitoid"
  },
  "definition": {
    "es": "Roca plutónica compuesta por cuarzo, feldespato alcalino y/o plagioclasa. incluye a las rocas de los sectores 2, 3, 4 y 5 del diagrama qapf que corresponden al granito de feldespato alcalino, granito, granodiorita y tonalita.",
    "en": "Phaneritic crystalline igneous rock consisting of quartz, alkali feldspar and/or plagioclase. includes rocks defined modally in qapf fields 2, 3, 4 and 5 as alkali feldspar granite, granite, granodiorite or tonalite."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/litologia/granito",
