{
  "id": "https://geo-carto.github.io/vocabularios/litologia/fango",
  "type": "Concept",
  "prefLabel": {
    "es": "fango",
    "en": "ooze"
  },
  "definition": {
    "es": "Sedimento biogénico con una relación de arena a lutita inferior a 1 a 9, menos de un 50 por ciento de carbonatos y menos de un 1 por ciento de partículas de tamaño grava (2 mm de diámetro).",
    "en": "Biogenic sediment consisting of less than 1 percent gravel-size (greater than or equal to 2 mm) particles, with a sand to mud ratio less than 1 to 9, and less than 50 percent carbonate minerals."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-biogenico",
    "prefLabel": {
      "es": "sedimento biogénico",
      "en": "biogenic sediment"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/Lithology/ooze"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/ooze"
    }
  ],
