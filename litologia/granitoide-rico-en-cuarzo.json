{
  "id": "https://geo-carto.github.io/vocabularios/litologia/granitoide-rico-en-cuarzo",
  "type": "Concept",
  "prefLabel": {
    "en": "quartz rich igneous rock",
    "es": "granitoide rico en cuarzo"
  },
  "definition": {
    "en": "Phaneritic crystalline igneous rock that contains less than 90 percent mafic minerals and contains greater than 60 percent quartz in the qapf fraction.",
    "es": "Roca plutónica que contiene menos de un 90 por ciento de minerales máficos y más de un 60 por ciento de cuarzo entre los componentes qapf."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida",
    "prefLabel": {
      "en": "acidic igneous rock",
      "es": "roca ígnea ácida"
    }
  },
