  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/afloramiento-caracter/sin-afloramiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <skos:prefLabel xml:lang="es">sin afloramiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">no outcrop</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad cubierta (y que por tanto no aflora) por suelos, vegetación, construcciones, etc.</skos:definition>
    <skos:definition xml:lang="en">Covered, not outcropping unit</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-deficiente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <skos:prefLabel xml:lang="es">afloramiento deficiente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">poorly exposed</skos:prefLabel>
    <skos:definition xml:lang="es">Afloramiento con muy mala calidad de exposición (como mucho se puede señalar la composición general de la unidad)</skos:definition>
    <skos:definition xml:lang="en">Bad exposed outrops, only suitable for determining the overall unit composition</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter/con-afloramiento"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-aceptable">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <skos:prefLabel xml:lang="es">afloramiento aceptable</skos:prefLabel>
    <skos:prefLabel xml:lang="en">medium quality outcrop</skos:prefLabel>
    <skos:definition xml:lang="es">Afloramiento con una moderada calidad de exposición (se puede detallar algo más la composición de la unidad y, en su caso, esbozar algún rasgo textural o estructural)</skos:definition>
    <skos:definition xml:lang="en">Outcrop with a moderate quality of exposure (the composition of the unit can be further detailed and, where appropriate, some textural or structural features can be outlined)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter/con-afloramiento"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/afloramiento-caracter/acantilado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <skos:prefLabel xml:lang="es">acantilado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cliff-forming</skos:prefLabel>
    <skos:definition xml:lang="es">Afloramiento que da lugar a paredes verticales, frecuentemente inaccesibles</skos:definition>
    <skos:definition xml:lang="en">Outcrop that gives rise to vertical walls, often inaccessible</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter/con-afloramiento"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-alterado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <skos:prefLabel xml:lang="es">afloramiento alterado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">weathered outcrop</skos:prefLabel>
    <skos:definition xml:lang="es">Afloramiento deficiente por estar afectada por una alteración no cartografiable</skos:definition>
    <skos:definition xml:lang="en">Bad outcrops, affected by non mappable alteration</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter/con-afloramiento"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-bueno">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <skos:prefLabel xml:lang="es">afloramiento bueno</skos:prefLabel>
    <skos:prefLabel xml:lang="en">well exposed</skos:prefLabel>
    <skos:definition xml:lang="es">Afloramiento que permite una descripción detallada de la unidad, al menos en cuanto a composición, textura organización interna y estructura</skos:definition>
    <skos:definition xml:lang="en">Good outcrops which allows to a precise description of the unit in terms of  composition, texture, internal organisation  and structure</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter/con-afloramiento"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
</rdf:RDF>
