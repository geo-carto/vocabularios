>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/afloramiento-caracter">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Carácter del afloramiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Outcrop character</skos:prefLabel>
    <dcterms:title xml:lang="es">Carácter del afloramiento</dcterms:title>
    <dcterms:title xml:lang="en">Outcrop character</dcterms:title>
    <skos:definition xml:lang="es">Términos que describen la naturaleza de los afloramientos formados por una unidad geológica. Ejemplos: con bloques, formadora de acantilado, formadora de repisa, formadora de ladera, pobremente expuesta.</skos:definition>
    <skos:definition xml:lang="en">Terms that describes the nature of outcrops formed by a geologic unit. Examples are: bouldery, cliff-forming, ledge-forming, slope-forming, poorly exposed.</skos:definition>
    <dcterms:description xml:lang="es">Términos que describen la naturaleza de los afloramientos formados por una unidad geológica. Ejemplos: con bloques, formadora de acantilado, formadora de repisa, formadora de ladera, pobremente expuesta.</dcterms:description>
    <dcterms:description xml:lang="en">Terms that describes the nature of outcrops formed by a geologic unit. Examples are: bouldery, cliff-forming, ledge-forming, slope-forming, poorly exposed.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos propios definidos por el IGME</dcterms:provenance>
    <dcterms:creator>https://www.igme.es</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Carácter del afloramiento.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter/sin-afloramiento"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter/con-afloramiento"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/afloramiento-caracter/afloramiento-en-bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter"/>
    <skos:prefLabel xml:lang="es">afloramiento en bloques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bouldery</skos:prefLabel>
    <skos:definition xml:lang="es">Afloramientos constituido por grandes bloques, individualizados por la erosión  o la meteorización</skos:definition>
    <skos:definition xml:lang="en">Outcrops made up of large blocks, individualized by erosion or weathering</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/afloramiento-caracter/con-afloramiento"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
