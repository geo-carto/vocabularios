>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metamorfismo-facies/facies-metamorfica-de-sub-esquistos-verdes">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-facies"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-facies"/>
    <skos:prefLabel xml:lang="es">facies metamórfica de sub-esquistos verdes</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subgreenschist metamorphic facies</skos:prefLabel>
    <skos:definition xml:lang="es">Facies metamórfica caracterizada en rocas de composición basáltica por prehnita-pumpellita, pumpellita-actinolita, prehnita-actinolita (prehnita y pumpellita son los silicatos de Ca-Al diagnósticos en lugar de minerales de los grupos de la epidota o de las zeolitas).</skos:definition>
    <skos:definition xml:lang="en">Metamorphic facies characterized in rocks of basaltic composition by prehnite-pumpellyite, pumpellyite-actinolite, prehnite-actinolite (prehnite and pumpellyite are the diagnostic Ca-Al silicates rather than minerals of the epidote or zeolite groups).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-facies/facies-metamorfica-sin-especificar"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/metamorphicfacies/subgreenschist_metamorphic_facies"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
