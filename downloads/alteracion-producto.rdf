    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/grus"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/gore"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/laterita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/laterita-aluminica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/laterita-ferrica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/caolin"/>
