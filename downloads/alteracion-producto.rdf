    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/calcreta"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla-de-descalcificacion"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla-de-descalcificacion-terra-rossa"/>
