>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-producto/silcreta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto"/>
    <skos:prefLabel xml:lang="es">silcreta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silcrete</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación predominantemente silícea, bien diferenciada, más o menos endurecida, que aparece en alteritas, depósitos superficiales o suelos.</skos:definition>
    <skos:definition xml:lang="en">Accumulation of mainly siliceous composition, well differentiated, indurated or not, in alterites, superficial deposits or soils.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/duricreta"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-producto/collection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto"/>
    <skos:prefLabel xml:lang="es">Producto de alteración - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Alteration product - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/regolito"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-producto/saprolito"/>
