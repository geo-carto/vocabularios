      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Una superficie de estratificación resaltante que se puede dibujar dentro de una unidad de rocas sedimentarias estratificadas, que representa una superficie original de deposición."
      },
      {
        "@language": "en",
        "@value": "A conspicuous  stratification surface, which can be delineated within a sedimentary stratified rock unit, representing an original surface of deposition."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/superficies-de-estratificacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "traza de capa"
      },
      {
        "@language": "en",
        "@value": "bedding surface"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
