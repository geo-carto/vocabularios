  {
    "@id": "https://geo-carto.github.io/vocabularios/superficies-de-estratificacion/biohorizonte",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/superficies-de-estratificacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un límite estratigráfico, superficie o interfaz a través del cual se observa un cambio significativo y distintivo en el carácter bioestratigráfico. Puede corresponder a una superficie límite entre biozonas o reconocerse dentro de una biozona. Las características en las que se basan comúnmente los biohorizontes en una sección estratigráfica incluyen los horizontes de primera aparición y los de última presencia, las ocurrencias distintivas, los cambios en la frecuencia y abundancia o los cambios en el carácter de taxones individuales."
      },
      {
        "@language": "en",
        "@value": "A stratigraphic boundary, surface or interface across which there is a significant and distinctive change in biostratigraphic character. It may correspond to a boundary surface between biozones or be recognized within a biozone. The features on which biohorizons are commonly based in a given stratigraphic section include lowest occurrences, highest occurrences, distinctive occurrences, changes in frequency and abundance, or changes in the character of individual taxa."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/superficies-de-estratificacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "biohorizonte"
      },
      {
        "@language": "en",
        "@value": "biohorizon"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/superficies-de-estratificacion"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  }
