  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-radiometrico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La ubicación y especificación se infieren a partir del flujo o intensidad de radiación relacionada con la desintegración de elementos radiactivos en el material terrestre observado. Se aplica tanto a sensores aerotransportados como de superficie."
      },
      {
        "@language": "en",
        "@value": "Location and specification inferred based on flux or intensity of radiation related to the decay of radioactive elements in observed Earth material. Use for both airborne and ground-surface based sensor."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_radiometric_survey"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "inferido a partir de levantamiento radiométrico"
      },
      {
        "@language": "en",
        "@value": "inferred radiometric survey"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento-lejano",
