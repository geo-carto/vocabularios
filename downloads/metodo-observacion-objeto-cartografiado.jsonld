        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La ubicación y especificación se infieren a partir de variaciones medidas en la aceleración de la gravedad, relacionadas con la masa del material terrestre subyacente."
      },
      {
        "@language": "en",
        "@value": "Location and specification inferred based on measured variations in the acceleration of gravity related to mass of underlying Earth material."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_gravity_data"
      }
    ],
