        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El elemento cartografiado se ubica mediante métodos de levantamiento inercial."
      },
      {
        "@language": "en",
        "@value": "mapped feature is located by inertial survey methods"
      }
    ],
