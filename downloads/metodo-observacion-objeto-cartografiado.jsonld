      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-imagenes-aereas"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-material-de-sondeo"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
