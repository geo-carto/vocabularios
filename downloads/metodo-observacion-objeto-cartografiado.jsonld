    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "observado en recortes de sondeo"
      },
      {
        "@language": "en",
        "@value": "observed in borehole cuttings"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
