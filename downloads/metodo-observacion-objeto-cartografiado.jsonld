      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Indica que el elemento cartografiado fue delimitado y caracterizado mediante observación visual directa."
      },
      {
        "@language": "en",
        "@value": "Indicates that mapped feature was delineated and a specifier assigned by direct visual observation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/direct_observation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
