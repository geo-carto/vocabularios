  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/ubicacion-de-afloramiento-observada-en-mapa-topografico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Fenómeno observado directamente en afloramiento y ubicado mediante posicionamiento sobre un mapa topográfico, en relación con elementos fisiográficos o culturales."
      },
      {
        "@language": "en",
        "@value": "Phenomenon observed directly in outcrop, and located by positioning on a topographic base map relative to physiographic or cultural features"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_outcrop__topographic_map_location"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ubicación de afloramiento observada en mapa topográfico"
      },
      {
        "@language": "en",
        "@value": "observed outcrop topographic map location"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Indica que el elemento cartografiado no es directamente observable; su ubicación y especificación se basan en inferencias a partir de la evidencia disponible."
      },
      {
        "@language": "en",
        "@value": "Indicates that mapped feature is not directly observable, location and specification based on inference from available evidence."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-recortes-de-sondeo"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-entre-ubicaciones-observadas"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "inferido"
      },
      {
        "@language": "en",
        "@value": "inferred"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-magnetico-terrestre",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La ubicación y especificación se infieren a partir de datos del campo magnético adquiridos por sensores en la superficie terrestre, ya sea en estaciones ocupadas manualmente o mediante sensores móviles en vehículos."
      },
      {
        "@language": "en",
        "@value": "Location and specification inferred based on magnetic field data acquired by sensor on the earth surface, either at manually occupied stations, or by a vehicle-based continuously collected sensor data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_ground_magnetic_survey"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "inferido a partir de levantamiento magnético terrestre"
      },
      {
        "@language": "en",
        "@value": "inferred ground magnetic survey"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La ubicación y especificación se infieren a partir de propiedades relacionadas con la litología, como firmas geofísicas o geoquímicas, vegetación, textura superficial o reflectancia."
      },
      {
        "@language": "en",
        "@value": "Location and specification inferred based on properties related to lithology, e.g. geophysical or geochemical signature, vegetation, surface texture, reflectance."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_indirect_method"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-aeromagnetico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-registro-geofisico-de-sondeo"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-datos-gravimetricos"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-magnetico-terrestre"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-radiometrico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-imagenes-de-teledeteccion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "inferido mediante método indirecto"
      },
      {
        "@language": "en",
        "@value": "inferred using indirect method"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-bajo-material-superficial-no-cartografiado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-entre-ubicaciones-observadas"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La ubicación y especificación se determinan por continuidad inferida entre ubicaciones observadas, asumiendo continuidad del elemento. No es observable debido a un manto superficial de suelo, detritos o coluvión, que no ha sido cartografiado como unidad geológica separada."
      },
      {
        "@language": "en",
        "@value": "Location and specification determined based on inferred continuity with observed locations, and assumption of continuity of the feature. Not observable because of covering mantle of soil, talus or colluvium, not mapped as separate geologic units."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection_unmapped_surficial_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "proyección inferida bajo material superficial no cartografiado"
      },
      {
        "@language": "en",
        "@value": "inferred projection beneath unmapped surficial material"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-entre-ubicaciones-observadas",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La ubicación y especificación se determinan por continuidad inferida entre ubicaciones observadas, asumiendo continuidad del elemento."
      },
      {
        "@language": "en",
        "@value": "Location and specification determined based on inferred continuity with observed locations, and assumption of continuity of the feature."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection__observed_locations"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-bajo-unidad-cartografiada-suprayacente"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-bajo-material-superficial-no-cartografiado"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-oculta-por-vegetacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "proyección inferida entre ubicaciones observadas"
      },
      {
        "@language": "en",
        "@value": "inferred projection between observed locations"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/mapa-publicado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La geometría del elemento cartografiado fue digitalizada a partir de un mapa publicado; su especificación se basa en la leyenda o explicación de unidades del mapa."
      },
      {
        "@language": "en",
        "@value": "Mapped feature geometry was digitized from a published map, specification of feature based on map unit explanation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/published_map"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "mapa publicado"
      },
      {
        "@language": "en",
        "@value": "published map"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
