      {
        "@id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Cualquier tipo de contacto, excepto  por falla, que separa cuerpos geológicos que tienen diferente carácter litológico o historia geológica."
      },
      {
        "@language": "en",
        "@value": "A non-faulted contact separating bodies of material in the earth that have different lithologic character or geologic history."
      }
    ],
