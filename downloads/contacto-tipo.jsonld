    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un contacto magnético entre cuerpos geológicos que se distingue en función de cualquier aspecto de la magnetización del material en la unidad."
      },
      {
        "@language": "en",
        "@value": "A magnetic contact between bodies of material distinguished based on any aspect of magnetization of material in the units."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/contacttype/magnetization_contact"
