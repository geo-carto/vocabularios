        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://purl.org/dc/terms/provenance": [
      {
        "@value": "Términos originales del estándar GeoSciML traducidos al español por el IGME"
      }
    ],
    "http://purl.org/dc/terms/publisher": [
      {
        "@id": "https://www.igme.es/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "es",
        "@value": "Tipo de contacto"
      },
      {
        "@language": "en",
        "@value": "Contact type"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0.0"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Términos que clasifican el tipo de contacto (por ejemplo: intrusivo, discordancia, superficie de estratificación, límite litológico, límite de fase)."
      },
      {
        "@language": "en",
        "@value": "The property ContactTypeTerm classifies the contact (e.g. intrusive, unconformity, bedding surface, lithologic boundary, phase boundary) and is a term from a controlled vocabulary."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "es",
        "@value": "Este archivo contiene el vocabulario Tipo de contacto."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
