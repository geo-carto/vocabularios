        "@id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Contacto que limita una unidad antrópica, es decir una unidad geológica producto de la actividad humana."
      },
      {
        "@language": "en",
        "@value": "Contact that limits an anthropic unit, that is, a geological unit resulting from human activity."
      }
    ],
