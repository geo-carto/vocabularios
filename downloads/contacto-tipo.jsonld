    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un contacto entre regiones caracterizadas por su historia geológica o por características estructurales, petrográficas o estratigráficas similares."
      },
      {
        "@language": "en",
        "@value": "A contact between regions characterised by their geological history or by similar structural, petrographic or stratigraphic features."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/contacttype/geologic_province_contact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/contacto-tipo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "contacto de provincia geológica"
      },
      {
        "@language": "en",
        "@value": "geologic province contact"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-de-magnetizacion",
