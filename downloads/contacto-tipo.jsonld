      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Contacto litogenético que separa cuerpos geológicos diferenciados en función de las propiedades litológicas relacionadas con la meteorización."
      },
      {
        "@language": "en",
        "@value": "A lithogenetic contact separating bodies of material differentiated based on lithologic properties related to weathering."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/contacttype/weathering_contact"
