  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/creador-metadatos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">creador de metadatos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metadata creator</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de crear y documentar los metadatos que describen el recurso y sus características.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for creating and documenting the metadata describing the resource and its characteristics.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-proyecto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">coordinador de proyecto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">project coordinator</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la coordinación organizativa y del seguimiento operativo del proyecto, incluyendo reuniones, plazos y comunicación entre participantes.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for the organisational coordination and operational monitoring of the project, including meetings, deadlines and communication among participants.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/creador-modelos-de-datos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">creador de modelos de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">data model creator</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de diseñar y documentar la estructura, las entidades, los atributos, las relaciones y las restricciones de un modelo de datos.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for designing and documenting the structure, entities, attributes, relationships and constraints of a data model.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/director-proyecto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">director de proyecto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">project director</skos:prefLabel>
    <skos:definition xml:lang="es">Persona responsable de la dirección general del proyecto y de la supervisión de su ejecución.</skos:definition>
    <skos:definition xml:lang="en">Person responsible for the overall direction of the project and the supervision of its implementation.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/administrador-base-de-datos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">administrador de base de datos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">database administrator</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la gestión, mantenimiento y administración de la base de datos que contiene la información del recurso.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for managing, maintaining and administering the database containing the resource information.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/editor-cartografico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">editor cartográfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cartographic editor</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la revisión y preparación cartográfica del recurso para su publicación.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for reviewing and preparing the cartographic resource for publication.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/creador-de-servicios-web">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">creador de servicios web</skos:prefLabel>
    <skos:prefLabel xml:lang="en">web service creator</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la creación y configuración de servicios web para la publicación y acceso al recurso.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for creating and configuring web services for publishing and accessing the resource.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/cartografo-de-campo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">cartógrafo de campo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">field cartographer</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la elaboración de la cartografía geológica mediante observaciones y levantamientos realizados en campo.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for producing geological cartography based on field observations and mapping.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
