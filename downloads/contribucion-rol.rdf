    <skos:prefLabel xml:lang="es">Rol de contribuyente - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Contributor role - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/investigador-principal"/>
