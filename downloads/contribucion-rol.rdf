   xmlns:adms="http://www.w3.org/ns/adms#"
   xmlns:dcat="http://www.w3.org/ns/dcat#"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:sdo="https://schema.org/"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/co-autor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">co-autor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">co-author</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad que contribuye significativamente a la creación intelectual del contenido del recurso junto con el autor principal.</skos:definition>
    <skos:definition xml:lang="en">Person or entity who significantly contributes to the intellectual creation of the resource content together with the main author.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/investigador-principal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">investigador principal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">principal investigator</skos:prefLabel>
    <skos:altLabel xml:lang="es">IP</skos:altLabel>
    <skos:altLabel xml:lang="en">PI</skos:altLabel>
    <skos:definition xml:lang="es">Persona responsable de la dirección científica del proyecto de investigación y del cumplimiento de sus objetivos científico-técnicos.</skos:definition>
    <skos:definition xml:lang="en">Person responsible for the scientific leadership of the research project and the achievement of its scientific and technical objectives.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/autor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">autor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">author</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la creación intelectual del contenido del recurso.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for the intellectual creation of the resource content.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/revisor-cientifico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">revisor científico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">scientific reviewer</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad encargada de revisar la calidad y exactitud científica del recurso.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for reviewing the scientific quality and accuracy of the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/tecnico-sig">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">técnico SIG</skos:prefLabel>
    <skos:prefLabel xml:lang="en">GIS technician</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de gestionar, editar, transformar, integrar, validar, analizar y representar información geoespacial mediante herramientas y procesos SIG.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for managing, editing, transforming, integrating, validating, analysing and representing geospatial information using GIS tools and processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/digitalizador"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/digitalizador">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">digitalizador</skos:prefLabel>
    <skos:prefLabel xml:lang="en">digitiser</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la digitalización de datos.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for the digitisation of data.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/tecnico-sig"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-tecnico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">coordinador técnico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">technical coordinator</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la coordinación de los aspectos técnicos del proyecto, incluyendo metodologías, herramientas y flujos de trabajo.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for coordinating the technical aspects of the project, including methodologies, tools and workflows.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/revisor-informacion-digital">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">revisor información digital</skos:prefLabel>
    <skos:prefLabel xml:lang="en">digital data reviewer</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de revisar la calidad, coherencia y consistencia de la información digital asociada al recurso.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for reviewing the quality, coherence and consistency of the digital information associated with the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/desarrollador-geoespacial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">desarrollador geoespacial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">geospatial developer</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de desarrollar aplicaciones, herramientas, scripts y componentes de software para la gestión, procesamiento o visualización de información geoespacial.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for developing applications, tools, scripts and software components for managing, processing or visualising geospatial information.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">implementador de soluciones geoespaciales</skos:prefLabel>
    <skos:prefLabel xml:lang="en">geospatial systems implementer</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de implementar y mantener sistemas, herramientas y procesos para la gestión, tratamiento y publicación de información geoespacial. Puede desempeñar de forma integrada varias de las funciones representadas por los roles específicos que engloba.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for implementing and maintaining systems, tools and processes for managing, processing and publishing geospatial information. This role may involve the integrated execution of several functions represented by the more specific roles it encompasses.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/creador-modelos-de-datos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/tecnico-sig"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/administrador-base-de-datos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/desarrollador-geoespacial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/creador-metadatos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/creador-de-servicios-web"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-cientifico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">coordinador científico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">scientific coordinator</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la coordinación de los aspectos científicos del proyecto y de garantizar la coherencia y calidad científica de los resultados.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for coordinating the scientific aspects of the project and ensuring the scientific consistency and quality of the results.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/collection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
