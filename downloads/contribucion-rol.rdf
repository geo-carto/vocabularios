  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Rol de contribuyente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Contributor role</skos:prefLabel>
    <dcterms:title xml:lang="es">Rol de contribuyente</dcterms:title>
    <dcterms:title xml:lang="en">Contributor role</dcterms:title>
    <skos:definition xml:lang="es">Términos que definen el rol desempañado por un contribuyente en relación a un conjunto de datos o parte de él.</skos:definition>
    <skos:definition xml:lang="en">Terms defining the role played by a contributor in relation to a dataset or part of it.</skos:definition>
    <dcterms:description xml:lang="es">Términos que definen el rol desempañado por un contribuyente en relación a un conjunto de datos o parte de él.</dcterms:description>
    <dcterms:description xml:lang="en">Terms defining the role played by a contributor in relation to a dataset or part of it.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos propios definidos por el IGME</dcterms:provenance>
    <dcterms:creator>https://www.igme.es</dcterms:creator>
    <owl:versionInfo>1.0.2</owl:versionInfo>
    <dcat:theme>TE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Rol de contribuyente.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/investigador-principal"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/director-proyecto"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-cientifico"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-proyecto"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-tecnico"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/autor"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/co-autor"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/cartografo-de-campo"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/revisor-cientifico"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/revisor-informacion-digital"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/editor-cartografico"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales"/>
