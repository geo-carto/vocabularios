  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/digitalizador">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">digitalizador</skos:prefLabel>
    <skos:prefLabel xml:lang="en">digitiser</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la digitalización de datos.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for the digitisation of data.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/revisor-científico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">revisor científico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">scientific reviewer</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad encargada de revisar la calidad y exactitud científica del recurso.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for reviewing the scientific quality and accuracy of the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/editor-cartográfico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">editor cartográfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cartographic editor</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de la revisión y preparación cartográfica del recurso para su publicación.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for reviewing and preparing the cartographic resource for publication.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contribucion-rol/creador-metadatos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contribucion-rol"/>
    <skos:prefLabel xml:lang="es">creador de metadatos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metadata creator</skos:prefLabel>
    <skos:definition xml:lang="es">Persona o entidad responsable de crear y documentar los metadatos que describen el recurso y sus características.</skos:definition>
    <skos:definition xml:lang="en">Person or entity responsible for creating and documenting the metadata describing the resource and its characteristics.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
</rdf:RDF>
