      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El elemento no ha sido rotado alrededor de un eje horizontal o subhorizontal más de 90 grados respecto a su orientación original."
      },
      {
        "@language": "en",
        "@value": "The feature has not been rotated around a horizontal or subhorizontal axis beyond 90 degrees from its original orientation."
      }
    ],
