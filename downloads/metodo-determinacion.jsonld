      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "estimación a partir de fotografía aérea"
      },
      {
        "@language": "en",
        "@value": "estimate from air photo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion"
