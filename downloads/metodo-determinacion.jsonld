  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion/orientacion-media-calculada",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El valor de orientación se especifica usando una media calculada de un conjunto de orientaciones relacionadas (generalización por computador)."
      },
      {
        "@language": "en",
        "@value": "Orientation value is specified using a calculated average of a collection of related orientations (computer generalization)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/determinationmethodorientation/calculated_average_orientation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "orientación media calculada"
      },
      {
        "@language": "en",
        "@value": "calculated average orientation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
