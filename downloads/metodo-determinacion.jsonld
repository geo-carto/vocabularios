        "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Orientación determinada ajustando un plano a tres o más puntos situados en la superficie geológica de interés."
      },
      {
        "@language": "en",
        "@value": "Orientation determined by fitting a plane to three or more points located on the geologic surface of interest."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/determinationmethodorientation/three_point_determination"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "determinación por tres puntos"
      },
      {
        "@language": "en",
        "@value": "three point determination"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
