      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion/medida-en-afloramiento"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Orientación medida usando brújula u otro instrumento directamente sobre o en un afloramiento de la estructura."
      },
      {
        "@language": "en",
        "@value": "Orientation measured using compass or other instrument directly on or at an outcrop of the structure."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/determinationmethodorientation/standard_on_site_measure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "medida instrumental en campo"
      },
      {
        "@language": "en",
        "@value": "standard on site measure"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/metodo-determinacion/estimacion-a-partir-de-fotografia-aerea",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
