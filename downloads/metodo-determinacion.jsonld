      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Orientación de una estructura geológica estimada a partir de la inspección o mediciones sobre una fotografía aérea."
      },
      {
        "@language": "en",
        "@value": "Orientation of a geologic structure estimated based on inspection or measurements on an air photograph."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/determinationmethodorientation/estimate_from_air_photo"
      }
    ],
