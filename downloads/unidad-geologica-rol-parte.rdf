    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/litosoma-irregular"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/litosoma-lenticular"/>
