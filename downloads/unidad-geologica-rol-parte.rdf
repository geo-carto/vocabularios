    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/cortina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/dique-o-vena"/>
