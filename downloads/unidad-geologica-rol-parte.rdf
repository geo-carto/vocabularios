  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/solo-una-parte">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <skos:prefLabel xml:lang="es">solo una parte</skos:prefLabel>
    <skos:prefLabel xml:lang="en">only part</skos:prefLabel>
    <skos:definition xml:lang="es">Toda la unidad descrita consta de una sola parte o constituyente</skos:definition>
    <skos:definition xml:lang="en">Entire described unit consists of a single part or constituent</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/CompositionPartRoleValue/onlyPart"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitpartrole/only_part"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/capa-litologica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <skos:prefLabel xml:lang="es">capa litológica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bed lithosome</skos:prefLabel>
    <skos:definition xml:lang="es">Litosoma en unidad litoestratigráfica que se presenta como lechos individuales intercalados con otros constituyentes en la escala de afloramiento (m) o mayor</skos:definition>
    <skos:definition xml:lang="en">Lithosome in lithostratigraphic unit that occurs as individual beds interleaved with other constituents on the outcrop (m) scale or larger</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/litosoma"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitpartrole/bed_lithosome"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/collection/coleccion-roles-de-partes-de-composicion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <skos:prefLabel xml:lang="es">Colección - Roles de partes de composición</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Composition part role</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de términos para especificar el atributo 'Rol de parte de composición'.</skos:definition>
    <skos:definition xml:lang="en">Collection of terms for specifying the atribute 'Composition part role'.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/facies"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/inclusion"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/litosoma"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/parte-de"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/parte-estratigrafica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/rol-no-especificado-de-una-parte"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/solo-una-parte"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/paquete-sedimentario-ciclico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <skos:prefLabel xml:lang="es">paquete sedimentario cíclico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cyclic bedding package</skos:prefLabel>
    <skos:definition xml:lang="es">Litosoma caracterizado por una secuencia interna de unidades, que se repite en una secuencia apilada, p. secuencia ascendente de afinación, secuencia ascendente de engrosamiento, secuencia bouma</skos:definition>
    <skos:definition xml:lang="en">Lithosome characterized by an internal sequence of units, which is repeated in a stacked sequence, e.g. fining-upward sequence, thickening upward sequence, bouma sequence</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/litosoma"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitpartrole/cyclic_bedding_package"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/enclave">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <skos:prefLabel xml:lang="es">enclave</skos:prefLabel>
    <skos:prefLabel xml:lang="en">enclave</skos:prefLabel>
    <skos:definition xml:lang="es">Término general para un agregado polimineral encerrado en un granitoide</skos:definition>
    <skos:definition xml:lang="en">General term for a polymineralic aggregate enclosed in a granitoid</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/inclusion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitpartrole/enclave"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/xenolito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <skos:prefLabel xml:lang="es">xenolito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">xenolith</skos:prefLabel>
    <skos:definition xml:lang="es">Inclusión de roca de campo pre-intrusiva en matriz ígnea intrusiva, de cm a unos 10 metros de diámetro en su dimensión más larga. Utilice término colgante para bloques más grandes</skos:definition>
    <skos:definition xml:lang="en">Inclusion of pre-intrusive country rock in intrusive igneous matrix, cm to about 10 meter diameter in longest dimension. Use term pendant for larger blocks</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/inclusion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitpartrole/xenolith"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/inclusion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <skos:prefLabel xml:lang="es">inclusión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inclusion</skos:prefLabel>
    <skos:definition xml:lang="es">Componente de la unidad geológica que está presente en forma de masas, de límites generalmente bien definidos, incluidas dentro de una matriz de otro material.</skos:definition>
    <skos:definition xml:lang="en">Geologic unit constituent is present as masses with generally sharp boundaries enclosed within a matrix of some other material</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/parte-de"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/bloques"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/concrecion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/enclave"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/retazos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/bloque-tectonico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/xenolito"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitpartrole/inclusion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/litosoma">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte"/>
    <skos:prefLabel xml:lang="es">litosoma</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithosome</skos:prefLabel>
    <skos:definition xml:lang="es">Un tipo de cuerpo rocoso que tiene múltiples ocurrencias en una sola unidad geológica. Masa de roca de carácter uniforme, caracterizada por su geometría, composición y estructura interna. Generalmente denota un macizo rocoso que es el producto de un proceso particular de formación de rocas o una secuencia relacionada de procesos en la unidad contenedora. Ejemplo: secuencia bouma, secuencia de barras de puntos. Un litosoma particular puede caracterizarse por la presencia de bloques, pero los bloques no se tratan como clases de litosoma porque el carácter interno de los bloques está determinado por una secuencia genética separada de la unidad descrita. Este vocabulario generaliza el concepto definido en Neuendorf et al 2005 para incluir cuerpos de rocas ígneas o metamórficas, así como rocas sedimentarias. Los NADM SLTT (2004) utilizaron el término 'litotopo' con un significado similar para las rocas sedimentarias</skos:definition>
    <skos:definition xml:lang="en">A kind of rock body that has multiple occurrences in a single geologic unit. A mass of rock of uniform character, characterized by geometry, composition, and internal structure. Generally denotes rock mass that is the product of a particular rock forming process or related sequence of processes in the containing unit. Example--bouma sequence, point bar sequence. A particular lithosome may be characterized by the presence of blocks, but blocks are not treated as kinds of lithosome because the internal character of the blocks is determined by a separate genetic sequence from the described unit. This vocabulary generalizes the concept defined in Neuendorf et al 2005 to include bodies of igneous or metamorphic rock as well as sedimentary rock. NADM SLTTs (2004) used the term 'lithotope' with similar meaning for sedimentary rocks</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/parte-de"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/capa-litologica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/paquete-sedimentario-ciclico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/matriz-de-unidad-geologica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/litosoma-irregular"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/litosoma-estratificado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/litosoma-lenticular"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-rol-parte/dique-o-vena"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/CompositionPartRoleValue/lithosome"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitpartrole/lithosome"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
