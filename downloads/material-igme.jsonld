  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-de-fundido-de-impacto",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca constituida, al menos en un 50% de su volumen, por material resultante de la solidificación de un fundido producido por un impacto"
      },
      {
        "@language": "en",
        "@value": "Rock consisting, in at least 50% of its volume, of material resulting from the solidification of a melt produced by an impact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
