    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente al grupo de las rocas latíticas, que contiene cuarzo en una cantidad superior al 5% de los minerales félsicos. su equivalente plutónico es la cuarzomonzonita"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the group of latitic rocks, containing quartz in an amount exceeding 5% of the felsic minerals. Its plutonic equivalent is quartz monzonite"
      }
    ],
