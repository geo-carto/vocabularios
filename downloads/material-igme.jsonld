  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-metasomaticas-e-hidrotermales",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Rocas Metasomáticas e Hidrotermales, que se caracteriza por incluir rocas derivadas de un proceso metamórfico por el que se produce un cambio importante en la composición química de la roca, debido a interacción con fluidos hidrotermales o magmas, así como rocas cuyas características son el resultado de la acción de soluciones hidrotermales."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Metasomatic and Hydrothermal Rocks, characterized by including rocks derived from a metamorphic process in which an important change in the chemical composition of the rock occurs, due to interaction with hydrothermal fluids or magmas, as well as rocks whose characteristics are the result of the action of hydrothermal solutions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/fenita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/greisen"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/rodingita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/skarn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Rocas Metasomáticas e Hidrotermales"
      },
      {
        "@language": "en",
        "@value": "Collection - Metasomatic And Hydrothermal Rocks"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-siliceos-no-clasticos",
