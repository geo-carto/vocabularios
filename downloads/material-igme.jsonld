      },
      {
        "@language": "en",
        "@value": "Detrital sedimentary rock with a combined content of sand-size elements and calcium carbonate equal to or exceeding 90% of the total, and in which the ratio of sand-size elements to carbonate is between 50 and 90%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
