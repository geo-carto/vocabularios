        "@value": "reef limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/boundstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
