  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/varva-glaciolacustre",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Varva propia de lagos localizados en la cabecera de un glaciar, en los que las láminas claras de limos y arenas se depositan en verano, cuando el lago está desprovisto de hielo, mientras que las láminas oscuras de arcilla se depositan en invierno, cuando el lago está helado"
      },
      {
        "@language": "en",
        "@value": "Varve characteristic of lakes located at the head of a glacier, in which the light silt and sand laminae are deposited in summer when the lake is free of ice, while the dark clay laminae are deposited in winter when the lake is frozen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "varva glaciolacustre"
      },
      {
        "@language": "en",
        "@value": "glaciolacustrine varve"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
