      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Tierra roja originada por meteorización en clima tropical, principalmente como residuo de lixiviación, que tiene como resultado la concentración de óxidos de hierro y alúmina"
      },
      {
        "@language": "en",
        "@value": "Red soil formed by weathering in a tropical climate, mainly as a residue of leaching, resulting in a concentration of iron oxides and alumina"
      }
    ],
