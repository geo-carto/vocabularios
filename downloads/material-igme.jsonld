  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/riolita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica leucocrática, perteneciente a la familia de las rocas riolíticas, de textura fluidal, compuesta principalmente por cristales de cuarzo y feldespato alcalino, que constituye entre el 35 y el 90% de los feldespatos, con cantidades menores de biotita y plagioclasa, en una matriz vítrea o microcristalina, puede contener anfíbol y, en las variedades hiperalcalinas, piroxeno alcalino. su equivalente plutónico es el granito"
      },
      {
        "@language": "en",
        "@value": "Leucocratic volcanic rock belonging to the rhyolitic rock family, of fluidal texture, composed mainly of quartz and alkali feldspar crystals constituting between 35 and 90% of the feldspars, with lesser amounts of biotite and plagioclase, in a glassy or microcrystalline groundmass; may contain amphibole and, in hyperalkaline varieties, alkalic pyroxene. Its plutonic equivalent is granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/rhyolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "riolita"
      },
      {
        "@language": "en",
        "@value": "rhyolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/fanglomerado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria formada por materiales angulosos de tamaños diversos, depositados en un abanico aluvial, generalmente asociados a corrientes de barro"
      },
      {
        "@language": "en",
        "@value": "Sedimentary rock formed by angular materials of diverse sizes deposited in an alluvial fan, generally associated with mudflows"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "fanglomerado"
      },
      {
        "@language": "en",
        "@value": "fanglomerate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
