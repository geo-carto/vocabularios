        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/siliceousOoze"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
