  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-exotica-alcalina",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea potásica máfica o ultramáfica, cuyo contenido en olivino frecuentemente serpentinizado en la kimberlita y flogopita es significativo. incluye la kimberlita, la lamproíta y el lamprófido"
      },
      {
        "@language": "en",
        "@value": "Mafic or ultramafic potassic igneous rock, whose olivine (frequently serpentinized in kimberlite) and phlogopite content is significant. Includes kimberlite, lamproite and lamprophyre"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca exótica alcalina"
      },
      {
        "@language": "en",
        "@value": "exotic alkaline rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
