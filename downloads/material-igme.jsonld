      {
        "@language": "es",
        "@value": "Variedad de riolita, peralcalina, más pobre en óxido de aluminio frente a óxido ferroso que la comendita"
      },
      {
        "@language": "en",
        "@value": "Variety of rhyolite, peralkaline, poorer in aluminium oxide relative to ferrous oxide than comendite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
