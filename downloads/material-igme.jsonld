  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/diorita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica de composición intermedia que generalmente está formada por plagioclasa cálcica andesina y hornblenda, a menudo con biotita o augita, así como cuarzo en una cantidad que no supera el 5% de los minerales félsicos. es el equivalente plutónico de la andesita"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock of intermediate composition generally formed by calcic plagioclase (andesine) and hornblende, often with biotite or augite, as well as quartz in an amount not exceeding 5% of the felsic minerals. It is the plutonic equivalent of andesite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/diorite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/diorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "diorita"
      },
      {
        "@language": "en",
