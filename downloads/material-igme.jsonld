      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Término general para designar la roca sólida que subyace a un suelo u otro material no consolidado expuesto en la superficie terrestre"
      },
      {
        "@language": "en",
        "@value": "General term to designate the solid rock underlying soil or other unconsolidated material exposed at the Earth's surface"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca madre"
      },
      {
        "@language": "en",
        "@value": "bedrock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
