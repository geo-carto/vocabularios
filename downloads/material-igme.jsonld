  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/shoshonita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica básica o intermedia, alcalina, variedad potásica de la traquiandesita basáltica. el término “shoshonítico” es utilizado para denominar series de rocas potásicas alcalinas"
      },
      {
        "@language": "en",
        "@value": "Basic or intermediate, alkaline volcanic rock, potassic variety of basaltic trachyandesite. The term 'shoshonitic' is used to designate series of alkaline potassic rocks"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "shoshonita"
      },
      {
        "@language": "en",
        "@value": "shoshonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"
      },
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"
