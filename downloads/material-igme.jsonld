      {
        "@language": "es",
        "@value": "caliza aloquímica esparítica"
      },
      {
        "@language": "en",
        "@value": "sparitic allochemical limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
