  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/traquiandesita-basaltica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica básica o intermedia, alcalina, con plagioclasa cálcica y piroxeno como minerales principales. la variedad sódica recibe el nombre de mugearita y la potásica, de shoshonita"
      },
      {
        "@language": "en",
        "@value": "Basic or intermediate, alkaline volcanic rock, with calcic plagioclase and pyroxene as principal minerals. The sodic variety is called mugearite and the potassic variety, shoshonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
