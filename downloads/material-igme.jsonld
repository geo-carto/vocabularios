  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-material-metamorfico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Material Metamórfico, que se caracteriza por representar el nivel superior de clasificación que agrupa todos los materiales derivados de rocas preexistentes, mediante cambios mineralógicos, químicos o estructurales, en estado sólido, en respuesta a variaciones físico-químicas de presión y temperatura."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the hierarchical category of Major Material Groups / Metamorphic Material, characterized by representing the top-level classification that groups all materials derived from pre-existing rocks, through mineralogical, chemical or structural changes, in solid state, in response to physicochemical variations of pressure and temperature."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-metamorfico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-metamorfica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Grandes Grupos de Materiales / Material Metamórfico"
      },
      {
        "@language": "en",
        "@value": "Collection - Major Material Groups / Metamorphic Material"
      }
    ]
  },
