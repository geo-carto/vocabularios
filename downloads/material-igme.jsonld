  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-metamorficas-en-funcion-del-protolito",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Rocas Metamórficas en Función del Protolito, que se caracteriza por incluir rocas derivadas de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales en estado sólido, clasificadas según la naturaleza de la roca original (protolito) a partir de la cual se formaron."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Metamorphic Rocks by Protolith, characterized by including rocks derived from a pre-existing rock, through mineralogical, chemical or structural changes in solid state, classified according to the nature of the original rock (protolith) from which they were formed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
