      {
        "@language": "es",
        "@value": "material sedimentario híbrido"
      },
      {
        "@language": "en",
        "@value": "hybrid sedimentary material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSediment"
      },
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sediment"
      },
      {
