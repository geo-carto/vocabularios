        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Nombre utilizado en la descripción provisional de rocas plutónicas leucocráticas en las que el cuarzo es el constituyente principal"
      },
      {
        "@language": "en",
        "@value": "Name used in the provisional description of leucocratic plutonic rocks in which quartz is the main constituent"
      }
    ],
