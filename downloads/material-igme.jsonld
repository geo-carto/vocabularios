    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Canto que se origina por una agregación de partículas de tamaño fino, como consecuencia de la erosión de las corrientes en materiales arcillosos"
      },
      {
        "@language": "en",
        "@value": "Clast originating by aggregation of fine-size particles, resulting from current erosion of clayey materials"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
