      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria detrítica con un contenido conjunto de elementos de tamaño pelita y de carbonatos igual o superior al 90% del total y en la que la relación de elementos de tamaño pelita con respecto al carbonato está comprendida entre el 50 y el 90%"
      },
      {
        "@language": "en",
        "@value": "Detrital sedimentary rock with a combined content of pelite-size elements and carbonates equal to or exceeding 90% of the total, and in which the ratio of pelite-size elements to carbonate is between 50 and 90%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
