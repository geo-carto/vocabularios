  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/pelita-carbonatada",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico con un contenido conjunto de elementos de tamaño pelita y de carbonatos igual o superior al 90% del total y en el que la relación de elementos de tamaño pelita con respecto al carbonato está comprendida entre el 50 y el 90%"
      },
      {
        "@language": "en",
        "@value": "Detrital sediment with a combined content of pelite-size elements and carbonates equal to or exceeding 90% of the total, and in which the ratio of pelite-size elements to carbonate is between 50 and 90%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateRichMud"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mud"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "pelita carbonatada"
      },
      {
        "@language": "en",
        "@value": "carbonate pelite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-detriticos-rocas-sedimentarias-y-sedimentos-carbonatados",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría mixta de Rocas Sedimentarias Detríticas y Carbonatadas, que se caracteriza por incluir rocas y sedimentos con componentes tanto detríticos (compuestos en más de un 50% por fragmentos de rocas preexistentes) como carbonatados (compuestos en más de un 50% por minerales carbonatados), representando mezclas o transiciones entre ambos tipos."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the mixed category of Detrital and Carbonate Sedimentary Rocks, characterized by including rocks and sediments with both detrital components (composed of more than 50% fragments from pre-existing rocks) and carbonate components (composed of more than 50% carbonate minerals), representing mixtures or transitions between both types."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/calcarenita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/calcilimolita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/calcilutita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/calcirrudita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Rocas Sedimentarias y Sedimentos Detríticos / Rocas Sedimentarias y Sedimentos Carbonatados"
      },
      {
        "@language": "en",
        "@value": "Collection - Detrital Sedimentary Rocks And Sediments / Carbonate Sedimentary Rocks And Sediments"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/calcoesquisto",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica derivada de margas o pelitas calcáreas, constituida fundamentalmente por carbonatos y silicatos de calcio y magnesio zoisita/clinozoisita, lawsonita, margarita, talco, tremolita y que presenta esquistosidad producida por el paralelismo de minerales de hábito laminar, principalmente filosilicatos"
      },
      {
        "@language": "en",
        "@value": "Metamorphic rock derived from marls or calcareous pelites, consisting fundamentally of calcium and magnesium silicates (zoisite/clinozoisite, lawsonite, margarite, talc, tremolite), and exhibiting schistosity produced by the parallel alignment of lamellar minerals, mainly phyllosilicates"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "calcoesquisto"
      },
      {
        "@language": "en",
        "@value": "calc-schist"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
