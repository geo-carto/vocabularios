      {
        "@language": "es",
        "@value": "pantelerita pantellerita"
      },
      {
        "@language": "en",
        "@value": "pantellerite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/rhyolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
