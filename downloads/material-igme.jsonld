      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica leucocrática de la familia de las rocas riolíticas, en la que el feldespato alcalino constituye más del 90% del total de los feldespatos. su equivalente plutónico es el granito de feldespato alcalino"
      },
      {
        "@language": "en",
