  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/grauvaca-feldespatica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Grauvaca en la que la proporción de cuarzo es inferior al 95% de los granos y el contenido de feldespatos es mayor que el de fragmentos de otras rocas"
      },
      {
        "@language": "en",
        "@value": "Greywacke in which the proportion of quartz is below 95% of the grains and the feldspar content is greater than that of rock fragments"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "grauvaca feldespática"
      },
      {
        "@language": "en",
        "@value": "feldspathic graywacke"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/wacke"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/wacke"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/rodingita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca de silicatos cálcicos asociada con serpentinitas, de grano fino y color blanco, verde o rosa, producida por metasomatismo de rocas plutónicas máficas asociadas a complejos ultramáficos. su asociación mineralógica característica está integrada por grosularia, diópsido, epidota, escapolita, vesubianita y óxidos de hierro"
      },
      {
        "@language": "en",
        "@value": "Calc-silicate rock associated with serpentinites, fine-grained and white, green or pink in colour, produced by metasomatism of mafic plutonic rocks associated with ultramafic complexes. Its characteristic mineral assemblage includes grossular, diopside, epidote, scapolite, vesuvianite and iron oxides"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "rodingita"
      },
      {
        "@language": "en",
        "@value": "rodingite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-metaluminosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca cuyos índices de saturación en alúmina al2o3/k2o+na2o+cao, en proporciones molares y agpaítico [na2o+k2o/al2o3, en proporciones molares] son menores que la unidad. suele tener minerales ricos en calcio como hornblenda, augita o epidota"
      },
      {
        "@language": "en",
        "@value": "Rock whose alumina saturation index Al2O3/K2O+Na2O+CaO, in molar proportions, and agpaitic index [Na2O+K2O/Al2O3, in molar proportions] are less than unity. It usually contains calcium-rich minerals such as hornblende, augite or epidote"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca metaluminosa"
      },
      {
        "@language": "en",
        "@value": "metaluminous rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-detriticos",
