      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca con un índice agpaítico [na2o+k2o/al2o3, en proporciones molares] mayor que la unidad. suele tener minerales ricos en álcalis y pobres en aluminio, como piroxenos o anfíboles sódicos"
      },
      {
        "@language": "en",
        "@value": "Rock with an agpaitic index [Na2O+K2O/Al2O3, in molar proportions] greater than unity. It usually contains alkali-rich and aluminium-poor minerals, such as sodic pyroxenes or amphiboles"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca peralcalina"
      },
      {
        "@language": "en",
        "@value": "peralkaline rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
