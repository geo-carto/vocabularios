  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-volcanica-rica-en-magnesio",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica con una concentración inusualmente elevada de mgo. en rocas con más del 52% de sio2, el contenido de mgo debe ser superior al 8% y en rocas con menos del 52% de sio2, el contenido de mgo debe ser superior al 12%"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock with an unusually high MgO concentration. In rocks with more than 52% SiO2, the MgO content must exceed 8%, and in rocks with less than 52% SiO2, the MgO content must exceed 12%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca volcánica rica en magnesio"
      },
      {
        "@language": "en",
        "@value": "high-magnesium volcanic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/highMagnesiumFineGrainedIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/high_magnesium_fine_grained_igneous_rocks"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/limolita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica constituida, al menos en un 50%, por elementos de tamaño comprendido entre 0.004 y 0.062 mm"
