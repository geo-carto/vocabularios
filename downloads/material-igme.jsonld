  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arena-calcarea",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico en el que el contenido conjunto de granos de arena independientemente de su composición y de material constituido por carbonato cálcico es igual o superior al 90% del total y en el que la relación de los granos de arena con respecto al material constituido por carbonato cálcico está comprendida entre el 50 y el 90%"
      },
      {
        "@language": "en",
        "@value": "Detrital sediment in which the combined content of sand grains (regardless of composition) and calcium carbonate material equals or exceeds 90% of the total, and in which the ratio of sand grains to calcium carbonate material is between 50 and 90%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arena calcárea"
      },
      {
        "@language": "en",
        "@value": "calcareous sand"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sand"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/sand"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/picrita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ultrabásica negra de textura dolerítica o microlítica, con un contenido en sio2 del 30-52%, mgo mayor del 12% y na2o+k2o menor del 3%. es rica en minerales ferromagnesianos, con olivino dominante, augita y, accesoriamente, anfíbol, biotita y plagioclasa"
      },
      {
        "@language": "en",
        "@value": "Black ultrabasic rock of doleritic or microlithic texture, with a SiO2 content of 30-52%, MgO greater than 12% and Na2O+K2O less than 3%. It is rich in ferromagnesian minerals, with dominant olivine, augite and, accessorily, amphibole, biotite and plagioclase"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "picrita"
      },
      {
        "@language": "en",
        "@value": "picrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/ultrabasicIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ultrabasic_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/piroclasto",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
