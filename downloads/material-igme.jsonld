  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/barita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "baritina"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca formada por el mineral del mismo nombre, de fórmula baso4, perteneciente a la clase de los sulfatos, que cristaliza en el sistema rómbico, formando masas espáticas compactas, fibrosas o granudas, de apariencia marmórea o estalactítica. es incoloro, blanco o amarillento y varía de transparente a opaco"
      },
      {
        "@language": "en",
        "@value": "Rock formed by the mineral of the same name, with the formula BaSO4, belonging to the class of sulfates, crystallizing in the orthorhombic system, forming compact sparitic, fibrous or granular masses of marble-like or stalactitic appearance. It is colourless, white or yellowish and varies from transparent to opaque"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "barita"
      },
      {
        "@language": "en",
        "@value": "barite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/evaporite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-leucocratica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
