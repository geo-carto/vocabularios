  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/calcarenita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "1. Caliza compuesta fundamentalmente por granos carbonáticos de tamaño arena. 2. Arenisca constituida mayoritariamente por clastos de carbonatos o de bioclastos"
      },
      {
        "@language": "en",
        "@value": "1. Limestone composed fundamentally of sand-size carbonate grains. 2. Sandstone consisting predominantly of carbonate or bioclast clasts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
