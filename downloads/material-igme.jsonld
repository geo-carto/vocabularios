      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Arenita en la que la proporción de cuarzo está comprendida entre el 75 y el 95% con respecto al total de elementos terrígenos y en la que el contenido de feldespatos es mayor que el de fragmentos de otras rocas"
      },
      {
        "@language": "en",
        "@value": "Arenite in which the proportion of quartz is between 75 and 95% of the total terrigenous elements and in which the feldspar content is greater than that of rock fragments"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
