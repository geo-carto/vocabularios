        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Migmatita formada casi exclusivamente por neosoma, con escaso o ningún mesosoma"
      },
      {
        "@language": "en",
        "@value": "Migmatite formed almost exclusively by neosome, with little or no mesosome"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "diatexita"
      },
      {
        "@language": "en",
        "@value": "diatexite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/migmatite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/migmatite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/toba-de-lapilli-y-ceniza",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca piroclástica en la que los fragmentos de tamaño inferior a 64 mm constituyen más del 75% en volumen de los piroclastos, pero ni los fragmentos de lapilli ni los de ceniza superan el 75% del volumen"
      },
      {
        "@language": "en",
        "@value": "Pyroclastic rock in which fragments smaller than 64 mm constitute more than 75% by volume of the pyroclasts, but neither the lapilli nor the ash fragments exceed 75% of the volume"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "toba de lapilli y ceniza"
      },
      {
        "@language": "en",
        "@value": "lapilli and ash tuff"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/colada-piroclastica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Depósito originado por un flujo denso de material volcánico producido en una erupción volcánica y constituido esencialmente por fragmentos calientes de vidrio volcánico, pómez, fragmentos de rocas y gas, que se desplaza rasante sobre la ladera de un volcán y tiende a acumularse en las zonas más bajas del mismo"
      },
      {
        "@language": "en",
        "@value": "Deposit originating from a dense flow of volcanic material produced in a volcanic eruption, consisting essentially of hot fragments of volcanic glass, pumice, rock fragments and gas, which moves along the slopes of a volcano and tends to accumulate in the lowest areas"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "colada piroclástica"
      },
      {
        "@language": "en",
        "@value": "pyroclastic flow"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/bomba-volcanica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Piroclasto juvenil de diámetro superior a 64 mm, de contorno redondeado o fusiforme por haber completado su consolidación girando en el aire"
      },
      {
        "@language": "en",
        "@value": "Juvenile pyroclast with a diameter exceeding 64 mm, rounded or spindle-shaped in outline due to having completed its solidification while rotating in the air"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "bomba volcánica"
      },
      {
        "@language": "en",
        "@value": "volcanic bomb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/ashBrecciaBombOrBlockTephra"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/lava-almohadillada",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Tipo de lava cuya superficie está conformada por una serie de abultamientos esferoidales, adosados o interferentes, con aspecto de almohadones. se genera en fondos subacuáticos por enfriamiento rápido de efusiones volcánicas, preferentemente submarinas, y es característica del volcanismo asociado a las dorsales centrooceánicas"
      },
      {
        "@language": "en",
        "@value": "Type of lava whose surface is shaped by a series of spheroidal bulges, adjoined or interfering, with a pillow-like appearance. It is generated on submarine floors by the rapid cooling of volcanic effusions, preferentially submarine, and is characteristic of volcanism associated with mid-oceanic ridges"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "lava almohadillada"
      },
      {
        "@language": "en",
        "@value": "pillow lava"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/igneousMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/igneous_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-hibridos",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Rocas Sedimentarias y Sedimentos Híbridos, que se caracteriza por incluir rocas integradas por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% de la misma, y que no pueden incluirse en ninguna otra categoría de roca por su composición u origen."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Hybrid Sedimentary Rocks and Sediments, characterized by including rocks composed of three or more components, each of which constitutes between 5 and 50% of the rock, and which cannot be included in any other rock category by their composition or origin."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/diamictita"
      },
