  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/flysch-siliceo",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Tectofacies constituida por una ritmita de de bancos de  areniscas turbidíticas con una mayoría de granos silíceos con un espesor de cientos o miles de metros, depositada en márgenes continentales en las etapas anteriores a su deformación orogénica"
      },
      {
        "@language": "en",
        "@value": "Tectofacies consisting of a rhythmite of turbiditic sandstone beds with a majority of siliceous grains, hundreds to thousands of metres thick, deposited on continental margins in the stages prior to their orogenic deformation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "flysch silíceo"
      },
      {
        "@language": "en",
        "@value": "silicious flysch"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
