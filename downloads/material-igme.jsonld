      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ultramáfica del grupo de las peridotitas compuesta por olivino y cantidades menores de ortopiroxeno y clinopiroxeno"
      },
      {
        "@language": "en",
        "@value": "Ultramafic rock of the peridotite group composed of olivine and lesser amounts of orthopyroxene and clinopyroxene"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
