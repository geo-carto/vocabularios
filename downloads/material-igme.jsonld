      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca carbonatada originada por organismos asociados durante la sedimentación, en grupos separados, que dan lugar a una pantalla que atrapa material fino"
      },
      {
        "@language": "en",
        "@value": "Carbonate rock produced by organisms associated during sedimentation in separate groups, creating a baffle that traps fine material"
      }
    ],
