  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/monzodiorita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de los dioritoides, que contiene cuarzo en una cantidad que no supera el 5% de los minerales félsicos y que además de plagioclasa contiene feldespato alcalino en cantidades comprendidas entre el 10 y el 35% de los feldespatos"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of dioritoids, containing quartz in an amount not exceeding 5% of the felsic minerals, and which in addition to plagioclase contains alkali feldspar in amounts between 10 and 35% of the feldspars"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/monzodiorite"
      },
