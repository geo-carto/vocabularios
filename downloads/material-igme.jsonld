        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento pelítico en el que la relación de componentes de tamaño limo a arcilla es superior a 2:1"
      },
      {
        "@language": "en",
