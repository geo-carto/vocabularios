      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/latita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica intermedia, alcalina, perteneciente al grupo de las rocas latíticas, con fenocristales de feldespato alcalino y plagioclasa en proporciones similares, en una matriz microcristalina o vítrea, puede contener cuarzo, en proporción inferior al 5% de los minerales félsicos. es la variedad potásica de la traquiandesita. su equivalente plutónico es la monzonita"
      },
      {
        "@language": "en",
        "@value": "Intermediate, alkaline volcanic rock belonging to the latitic rock group, with alkali feldspar and plagioclase phenocrysts in similar proportions in a microcrystalline or glassy groundmass; may contain quartz in proportions below 5% of felsic minerals. It is the potassic variety of trachyandesite. Its plutonic equivalent is monzonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/latite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/latite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "latita"
      },
      {
        "@language": "en",
        "@value": "latite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arenisca-s.l.",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria constituida por menos de un 30% de fragmentos de diámetro superior a 2 mm y cuya relación entre el contenido de granos de arena y de partículas de lutita es al menos 1. los fragmentos pueden ser de cualquier composición y origen"
      },
      {
        "@language": "en",
        "@value": "Sedimentary rock consisting of less than 30% fragments with a diameter exceeding 2 mm and whose ratio of sand grain content to mud particle content is at least 1. The fragments may be of any composition and origin"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/genericSandstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/generic_sandstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arenisca s.l."
      },
      {
        "@language": "en",
        "@value": "sandstone s.l."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/kieserita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca formada por el mineral del mismo nombre, de fórmula mgso4.h2o, perteneciente a la clase de los sulfatos, que cristaliza en el sistema monoclínico y se presenta en agregados granudos. es incoloro, blanco, gris o amarillento y presenta aspecto mate o brillo vítreo"
      },
      {
        "@language": "en",
        "@value": "Rock formed by the mineral of the same name, with the formula MgSO4·H2O, belonging to the class of sulfates, crystallizing in the monoclinic system and occurring in granular aggregates. It is colourless, white, grey or yellowish and has a matt or vitreous lustre"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "kieserita"
      },
      {
        "@language": "en",
        "@value": "kieserite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/evaporite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-peraluminosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca con un índice de saturación en alúmina al2o3/k2o+na2o+cao, en proporciones molares mayor que la unidad. suele tener minerales ricos en aluminio como moscovita, cordierita, sillimanita, granate, turmalina y/o andalucita"
      },
      {
        "@language": "en",
        "@value": "Rock with an alumina saturation index Al2O3/K2O+Na2O+CaO, in molar proportions, greater than unity. It usually contains aluminium-rich minerals such as muscovite, cordierite, sillimanite, garnet, tourmaline and/or andalusite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca peraluminosa"
      },
      {
        "@language": "en",
        "@value": "peraluminous rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-felsica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca cuyo contenido en cuarzo y minerales de color claro feldespato y plagioclasa es superior al 50% en volumen"
      },
      {
        "@language": "en",
        "@value": "Rock whose content of quartz and light-coloured minerals feldspar and plagioclase exceeds 50% by volume"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
