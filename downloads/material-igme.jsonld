      {
        "@language": "es",
        "@value": "ortobrecha"
      },
      {
        "@language": "en",
        "@value": "orthobreccia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/breccia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/cortlandtita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca máfica o casi ultramáfica con altos contenidos en mgo y k2o, que además de olivino tiene anfíbol, flogopita o ambos minerales. variedad más máfica que la appinita"
      },
      {
        "@language": "en",
        "@value": "Mafic or near-ultramafic rock with high MgO and K2O content, which in addition to olivine contains amphibole, phlogopite or both minerals. A more mafic variety than appinite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cortlandtita"
      },
      {
        "@language": "en",
        "@value": "cortlandtite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/carbon-de-la-serie-sapropelica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Carbón, consolidado o no, formado por procesos de putrefacción en medios subacuáticos y bajo condiciones anóxicas, de materia orgánica derivada de fitoplancton. presenta grano fino, aspecto compacto y homogéneo a simple vista, color oscuro, brillo mate y fractura concoidea"
      },
      {
        "@language": "en",
        "@value": "Consolidated or unconsolidated coal, formed by putrefaction in subaqueous environments and under anoxic conditions, from organic matter derived from phytoplankton. It is fine-grained, compact and homogeneous in appearance to the naked eye, dark in colour, with matt lustre and conchoidal fracture"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "carbón de la serie sapropélica"
      },
      {
        "@language": "en",
        "@value": "sapropelic series coal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/coal"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/coal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/conglomerado-s.l.",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria compuesta al menos por un 30% de fragmentos redondeados o subangulosos de diámetro superior a 2 mm. si la roca está mal seleccionada, con granulometría muy variada, también puede ser considerada una diamictita"
      },
      {
        "@language": "en",
        "@value": "Sedimentary rock composed of at least 30% rounded or subangular fragments with a diameter exceeding 2 mm. If the rock is poorly sorted with very variable grain size, it may also be considered a diamictite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/genericConglomerate"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/generic_conglomerate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "conglomerado s.l."
      },
      {
        "@language": "en",
        "@value": "conglomerate s.l."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/basalto",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica básica, subalcalina o alcalina, generalmente de color negro, con textura microcristalina o porfídica, que contiene plagioclasa cálcica y piroxeno, normalmente augita, con o sin olivino, frecuentemente presenta magnetita o ilmenita accesorias y, más raramente, cuarzo o feldespatoides. se distingue de la andesita por la composición de la plagioclasa labradorita o más cálcica, la ausencia de anfíbol y su carácter melanocrático"
      },
      {
        "@language": "en",
        "@value": "Basic, subalkaline or alkaline volcanic rock, generally black, with microcrystalline or porphyritic texture, containing calcic plagioclase and pyroxene, normally augite, with or without olivine, frequently with accessory magnetite or ilmenite and, more rarely, quartz or feldspathoids. It is distinguished from andesite by the plagioclase composition (labradorite or more calcic), the absence of amphibole and its melanocratic character"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/basalt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "basalto"
      },
      {
        "@language": "en",
        "@value": "basalt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arcosa-litica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Arcosa cuya relación entre feldespatos y fragmentos de otras rocas no supera 3:1"
      },
      {
        "@language": "en",
        "@value": "Arkose in which the ratio of feldspars to rock fragments does not exceed 3:1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arcosa lítica"
      },
      {
        "@language": "en",
        "@value": "lithic arkose"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/arenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-dacitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica ácida, subalcalina o alcalina, cuyos componentes principales son el cuarzo, que constituye entre el 20 y el 60% de los minerales félsicos, y la plagioclasa, que constituye más del 65% de los feldespatos"
      },
      {
        "@language": "en",
        "@value": "Acid, subalkaline or alkaline volcanic rock whose principal components are quartz, constituting between 20 and 60% of the felsic minerals, and plagioclase, constituting more than 65% of the feldspars"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/dacite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/dacite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca dacítica"
      },
      {
        "@language": "en",
        "@value": "dacitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/dacita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica ácida, subalcalina, leucocrática, de textura porfídica, compuesta por fenocristales de cuarzo y plagioclasa sódica englobados en una matriz vítrea o microcristalina. puede contener cantidades subordinadas de feldespato alcalino, biotita, hornblenda y piroxeno. sus equivalentes plutónicos son la granodiorita y la tonalita"
      },
      {
        "@language": "en",
        "@value": "Acid, subalkaline, leucocratic volcanic rock of porphyritic texture, composed of quartz and sodic plagioclase phenocrysts enclosed in a glassy or microcrystalline groundmass. It may contain subordinate amounts of alkali feldspar, biotite, hornblende and pyroxene. Its plutonic equivalents are granodiorite and tonalite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/dacite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/dacite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "dacita"
      },
      {
        "@language": "en",
        "@value": "dacite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
