  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/aplita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea de composición granítica, color claro y grano fino, con textura aplítica o sacaroidea, a veces asociada a pegmatitas. puede aparecer como diques o como pequeños stocks dentro de los plutones graníticos"
      },
      {
        "@language": "en",
        "@value": "Igneous rock of granitic composition, light-coloured and fine-grained, with aplitic or saccharoidal texture, sometimes associated with pegmatites. It may appear as dykes or small stocks within granitic plutons"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/aplite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/aplite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "aplita"
      },
      {
