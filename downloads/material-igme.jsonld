    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica constituida por elementos muy finos, de menos de 0.062 mm. contiene menos de un 10% de carbonatos"
      },
      {
        "@language": "en",
        "@value": "Detrital rock consisting of very fine elements, less than 0.062 mm. Contains less than 10% carbonates"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
