  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/cuarzotraquita-de-feldespato-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente al grupo de las rocas traquíticas de feldespato alcalino, que contiene cuarzo en una cantidad superior al 5% de los minerales félsicos. su equivalente plutónico es la cuarzosienita de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the group of alkali feldspar trachytic rocks, containing quartz in an amount exceeding 5% of the felsic minerals. Its plutonic equivalent is alkali feldspar quartz syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/quartzAlkaliFeldsparTrachyte"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/quartz_alkali_feldspar_trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cuarzotraquita de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar quartz trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/eclogita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica de alta presión formada a partir de rocas magmáticas de composición básica y constituida esencialmente por granate rico en magnesio y clinopiroxeno rico en sodio. puede contener cantidades subordinadas de otros minerales como lawsonita, epidota, glaucofana, barroisita, rutilo, cuarzo, coesita, paragonita o distena"
      },
      {
        "@language": "en",
        "@value": "High-pressure metamorphic rock formed from mafic igneous rocks, consisting essentially of magnesium-rich garnet and sodium-rich clinopyroxene. It may contain subordinate amounts of other minerals such as lawsonite, epidote, glaucophane, barroisite, rutile, quartz, coesite, paragonite or kyanite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/eclogite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/eclogite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "eclogita"
      },
      {
        "@language": "en",
        "@value": "eclogite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
