        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Materiales Sedimentarios, que se caracteriza por incluir materiales formados en el exterior de la corteza terrestre mediante un proceso de sedimentación, que presentan estructuras características, como, principalmente, la estratificación."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Sedimentary Materials, characterized by including materials formed outside the Earth's crust by a sedimentary process, exhibiting characteristic structures, primarily stratification."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
