    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas gabroicas foídicas, en la que la plagioclasa constituye más del 90% de los feldespatos. es el equivalente intrusivo de la basanita"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of foidic gabbroic rocks, in which plagioclase constitutes more than 90% of the feldspars. It is the intrusive equivalent of basanite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidGabbro"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_gabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "gabro foídico"
      },
      {
        "@language": "en",
        "@value": "foidic gabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
