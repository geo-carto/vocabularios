  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/foidita-basanitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente a la familia de las rocas foídicas en la que los feldespatoides representan menos del 90% del total de los minerales félsicos, la plagioclasa es más abundante que el feldespato alcalino y el olivino supera el 10% normativo"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the foidite family in which feldspathoids represent less than 90% of the total felsic minerals, plagioclase is more abundant than alkali feldspar, and olivine exceeds 10% normative"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/basaniticFoidite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/basanitic_foidite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "foidita basanítica"
      },
      {
        "@language": "en",
        "@value": "basanitic foidite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
