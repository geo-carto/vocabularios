      {
        "@language": "es",
        "@value": "contornita"
      },
      {
        "@language": "en",
        "@value": "contourite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/cumulado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca derivada de la cristalización, separación por gravedad y acumulación de cristales, a partir de un magma silicatado generalmente de composición máfica o intermedia"
      },
      {
        "@language": "en",
        "@value": "Rock derived from the crystallization, gravitational separation and accumulation of crystals from a silicate magma generally of mafic or intermediate composition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cumulado"
      },
      {
        "@language": "en",
        "@value": "cumulate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/phaneriticIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-foidica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "foiditoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "nombre utilizado en la descripción provisional de rocas volcánicas básicas o ultrabásicas, ultraalcalinas, en las que los feldespatoides representan más del 60% del total de los minerales félsicos, contienen cantidades menores de minerales ferromagnesianos, como piroxeno y, en ocasiones, anfíbol"
      },
      {
        "@language": "en",
        "@value": "Name used in the provisional description of basic or ultrabasic, ultraalkaline volcanic rocks in which feldspathoids represent more than 60% of the total felsic minerals, containing lesser amounts of ferromagnesian minerals, such as pyroxene and, occasionally, amphibole"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foiditoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foiditoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca foídica"
      },
      {
        "@language": "en",
        "@value": "foidic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/esquisto-glaucofanico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica de alta presión y temperatura media-baja, esquistosa y de color azulado debido a la presencia de anfíbol alcalino típicamente glaucofana, generalmente resultante del metamorfismo de rocas magmáticas de composición basáltica. se recomienda su uso en vez de esquisto azul, por ser éste un nombre de facies"
      },
      {
        "@language": "en",
        "@value": "High-pressure, medium- to low-temperature metamorphic rock, schistose and bluish in colour due to the presence of alkalic amphibole (typically glaucophane), generally resulting from the metamorphism of mafic igneous rocks of basaltic composition. Its use is recommended instead of 'blueschist', as that is a facies name"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/glaucophaneLawsoniteEpidoteMetamorphicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/glaucophane_lawsonite_epidote_metamorphic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "esquisto glaucofánico"
      },
      {
        "@language": "en",
        "@value": "glaucophane schist"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/caliza-bioconstruida",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "boundstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza formada por la actividad vital de los organismos coloniales y atrapadores de partículas sedimentarias, según la clasificación de dunham 1962"
      },
      {
        "@language": "en",
        "@value": "Limestone formed by the vital activity of colonial and sediment-trapping organisms, according to the Dunham (1962) classification"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/boundstone"
      }
    ],
