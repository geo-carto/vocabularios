    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Carbón de la serie sapropélica de aspecto variable entre finamente laminado y masivo. su contenido en carbono es superior al 70% y el de volátiles, inferior al 52%"
      },
      {
        "@language": "en",
        "@value": "Sapropelic series coal of variable appearance, between finely laminated and massive. Its carbon content exceeds 70% and the volatile matter content is below 52%"
      }
    ],
