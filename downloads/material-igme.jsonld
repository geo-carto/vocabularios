    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "roca tefrítica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Nombre utilizado en la descripción provisional de rocas volcánicas ultrabásicas o básicas, fuertemente alcalinas, compuestas esencialmente por feldespatos, de los que la plagioclasa constituye más del 50%, y feldespatoides, que constituyen entre el 10% y el 60% de los minerales félsicos, contienen cantidades menores de minerales ferromagnesianos, como piroxeno, anfíbol y, en ocasiones, olivino"
      },
      {
        "@language": "en",
        "@value": "Name used in the provisional description of ultrabasic or basic, strongly alkaline volcanic rocks, composed essentially of feldspars, of which plagioclase constitutes more than 50%, and feldspathoids, constituting between 10% and 60% of the felsic minerals, containing lesser amounts of ferromagnesian minerals, such as pyroxene, amphibole and, occasionally, olivine"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
