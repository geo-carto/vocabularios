  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/granito-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Granito metaluminoso o ligeramente peraluminoso, con valores de al2o3/na2o+k2o en proporciones molares próximos a 1 y algo empobrecidos en ca. contiene abundante feldespato alcalino feldespato potásico. como minerales varietales, además de biotita, puede presentar egirina piroxeno sódico y/o riebeckita anfíbol sódico"
      },
      {
        "@language": "en",
        "@value": "Metaluminous or slightly peraluminous granite, with Al2O3/Na2O+K2O values in molar proportions close to 1 and slightly depleted in Ca. It contains abundant alkali feldspar (potassic feldspar). As varietal minerals, in addition to biotite, it may present aegirine (sodic pyroxene) and/or riebeckite (sodic amphibole)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "granito alcalino"
      },
      {
        "@language": "en",
        "@value": "alkaline granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/granite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
