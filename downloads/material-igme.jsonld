    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica constituida en un 30-50% por clastos de más de 2 mm de diámetro y con un contenido de elementos de tamaño pelita mayor que el de elementos de tamaño arena"
      },
      {
        "@language": "en",
        "@value": "Detrital rock consisting of 30-50% clasts with a diameter exceeding 2 mm and with a pelite-size element content greater than that of sand-size elements"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
