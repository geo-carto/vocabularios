      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica básica perteneciente a la familia de las rocas tefríticas, en la que la plagioclasa constituye menos del 90% de los feldespatos, con olivino en proporción superior al 10% normativo. su equivalente plutónico es el monzogabro foídico"
      },
      {
        "@language": "en",
        "@value": "Basic volcanic rock belonging to the tephrite family, in which plagioclase constitutes less than 90% of the feldspars, with olivine in proportions exceeding 10% normative. Its plutonic equivalent is foid monzogabbro"
      }
    ],
