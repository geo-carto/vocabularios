    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas gabroicas foídicas, en la que la plagioclasa constituye menos del 90% de los feldespatos. es el equivalente intrusivo de la basanita fonolítica"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of foidic gabbroic rocks, in which plagioclase constitutes less than 90% of the feldspars. It is the intrusive equivalent of phonolitic basanite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidMonzogabbro"
