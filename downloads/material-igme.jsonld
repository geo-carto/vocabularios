  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-metamorficas-en-funcion-de-su-composicion",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Rocas Metamórficas en Función de su Composición, que se caracteriza por incluir rocas derivadas de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales, esencialmente en estado sólido, en respuesta a variaciones físico-químicas de presión y temperatura, clasificadas según su composición mineralógica resultante."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Metamorphic Rocks by Composition, characterized by including rocks derived from a pre-existing rock, through mineralogical, chemical or structural changes, essentially in solid state, in response to physicochemical variations of pressure and temperature, classified according to their resulting mineralogical composition."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
