      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/dolomia",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "roca dolomítica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria carbonatada cuyos constituyentes principales son la dolomita o carbonatos de composición parecida. La variedad pura tiene, al menos, un 95% de dolomita y las variedades impuras, más del 10% de calcita o de impurezas. Se origina por precipitación química dolomía primaria o, más frecuentemente, durante la diagénesis dolomía secundaria"
      },
      {
        "@language": "en",
        "@value": "Sedimentary carbonate rock whose principal constituents are dolomite or carbonates of similar composition. The pure variety has at least 95% dolomite and the impure varieties more than 10% calcite or impurities. It originates by chemical precipitation (primary dolomite) or, more frequently, during diagenesis (secondary dolomite)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/dolomite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/dolostone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "dolomía"
      },
      {
        "@language": "en",
        "@value": "dolostone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arena-limosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico en el que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 50 y el 90% y la relación de elementos de tamaño limo a tamaño arcilla es superior a 2:1"
      },
      {
        "@language": "en",
        "@value": "Detrital sediment in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 50 and 90% and the ratio of silt-size to clay-size elements exceeds 2:1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arena limosa"
      },
      {
        "@language": "en",
        "@value": "silty sand"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sand"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/sand"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/brecha-intrusiva",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Brecha formada por fragmentos angulosos de una roca ígnea, englobados por otra roca ígnea de diferente composición. se produce por fracturación hidráulica o magmática durante el proceso de intrusión"
      },
      {
        "@language": "en",
        "@value": "Breccia formed by angular fragments of an igneous rock enclosed within another igneous rock of different composition. It is produced by hydraulic or magmatic fracturing during the intrusion process"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "brecha intrusiva"
      },
      {
        "@language": "en",
        "@value": "intrusive breccia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/diorita-con-foides",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas dioríticas, que contiene feldespatoides"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of dioritic rocks, containing feldspathoids"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingDiorite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_diorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "diorita con foides"
      },
      {
        "@language": "en",
        "@value": "foid-bearing diorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/granodiorita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica de la familia de los granitoides, en la que la plagioclasa constituye entre el 65 y el 90% de los feldespatos, contiene cantidades menores de biotita, hornblenda y, más raramente, piroxeno"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock of the granitoid family, in which plagioclase constitutes between 65 and 90% of the feldspars, containing lesser amounts of biotite, hornblende and, more rarely, pyroxene"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/granodiorite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/granodiorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
