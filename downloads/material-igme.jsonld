  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/brecha-autoclastica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
