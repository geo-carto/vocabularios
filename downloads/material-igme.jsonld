  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/caliza-estromatolitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza caracterizada por una fina laminación de forma variable domo, convexa, columnar, esferoidal, etc., que se origina principalmente por la actividad metabólica de las algas cianofíceas, que atrapan material sedimentario"
      },
      {
        "@language": "en",
        "@value": "Limestone characterized by fine lamination of variable form (dome, convex, columnar, spheroidal, etc.), originating mainly by the metabolic activity of cyanobacteria, which trap sedimentary material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "caliza estromatolítica"
      },
      {
        "@language": "en",
        "@value": "stromatolitic limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/brecha-arenosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica constituida en un 30-50% por clastos angulosos de más de 2 mm de diámetro y con un contenido de elementos de tamaño arena mayor que el de elementos de tamaño pelita"
      },
      {
        "@language": "en",
        "@value": "Detrital rock consisting of 30-50% angular clasts with a diameter exceeding 2 mm and with a sand-size element content greater than that of pelite-size elements"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "brecha arenosa"
      },
      {
        "@language": "en",
        "@value": "sandy breccia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/breccia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arenisca-arcillosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica en la que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 50 y el 90% y la relación de elementos de tamaño arcilla a tamaño limo es superior a 2:1"
      },
      {
        "@language": "en",
        "@value": "Detrital rock in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 50 and 90% and the ratio of clay-size to silt-size elements exceeds 2:1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arenisca arcillosa"
      },
      {
        "@language": "en",
        "@value": "clayey sandstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/monzonita-con-foides",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas monzoníticas, que contiene feldespatoides. es el equivalente intrusivo de la latita con foides"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of monzonitic rocks, containing feldspathoids. It is the intrusive equivalent of foid-bearing latite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingMonzonite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "monzonita con foides"
      },
      {
        "@language": "en",
        "@value": "foid-bearing monzonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-monzonitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sienitoide en el que el feldespato alcalino y la plagioclasa se encuentran en proporciones similares 35-65% de los feldespatos, destacando el clinopiroxeno entre los componentes máficos. es el equivalente intrusivo de la roca latítica"
      },
      {
        "@language": "en",
        "@value": "Syenitoid in which alkali feldspar and plagioclase are in similar proportions (35-65% of feldspars), with clinopyroxene being prominent among the mafic components. It is the intrusive equivalent of latitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/monzoniticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzonitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca monzonítica"
      },
      {
        "@language": "en",
        "@value": "monzonitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-cataclastica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca de falla cohesiva, sin foliación tectónica o con un desarrollo pobre de ella y constituida por porfiroclastos, habitualmente angulosos, y fragmentos de roca embebidos en una matriz de composición similar, producida por deformación frágil con reducción del tamaño de grano cristalino y ligeramente recristalizada. algunos autores proponen que el contenido en matriz debe ser superior al 30%"
      },
      {
        "@language": "en",
        "@value": "Cohesive fault rock, without tectonic foliation or with poorly developed foliation, consisting of porphyroclasts, usually angular, and rock fragments embedded in a matrix of similar composition, produced by brittle deformation with crystal grain size reduction and slightly recrystallized. Some authors propose that the matrix content should exceed 30%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca cataclástica"
      },
      {
        "@language": "en",
        "@value": "cataclastic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/pelita-s.l.",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento que contiene menos de un 30% de clastos de tamaño grava >2 mm de diámetro y una relación entre granos de arena 0.062-2 mm y partículas de lutita <0.062 mm menor que 1, sin especificar su composición o su génesis"
      },
      {
        "@language": "en",
        "@value": "Sediment containing less than 30% gravel-size clasts (>2 mm diameter) and with a ratio of sand grains (0.062-2 mm) to mud particles (<0.062 mm) less than 1, without specifying composition or genesis"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/mudSizeSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/mud_size_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "pelita s.l."
      },
      {
        "@language": "en",
        "@value": "pelite s.l."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
