    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Monzogabro o monzodiorita con nefelina"
      },
      {
        "@language": "en",
        "@value": "Monzogabbro or monzodiorite with nepheline"
      }
    ],
