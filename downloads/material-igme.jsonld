    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas monzogabroicas, que contiene cuarzo en una cantidad comprendida entre el 5 y el 20% de los minerales félsicos"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of monzogabbroic rocks, containing quartz in an amount between 5 and 20% of the felsic minerals"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
