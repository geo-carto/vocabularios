      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca piroclástica en la que los fragmentos de ceniza constituyen más del 75% en volumen del contenido piroclástico"
      },
      {
        "@language": "en",
        "@value": "Pyroclastic rock in which ash fragments constitute more than 75% by volume of the pyroclastic content"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "toba de ceniza"
      },
      {
        "@language": "en",
        "@value": "ash tuff"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"
      }
    ],
