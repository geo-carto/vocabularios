    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica de grano muy fino que presenta una esquistosidad pizarrosa, formada a partir de lutitas bajo condiciones de grado metamórfico muy bajo"
      },
      {
        "@language": "en",
        "@value": "Very fine-grained metamorphic rock exhibiting slaty cleavage, formed from mudstones under conditions of very low metamorphic grade"
      }
