  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/carbon",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "carbón mineral"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria rica en materia orgánica utilizada como combustible, de color pardo a negro y de consistencia pétrea o terrosa, constituida por carbono amorfo acompañado de hidrocarburos, compuestos orgánicos complejos y materiales inorgánicos. tiene su origen en la carbonificación de vegetales en épocas geológicas pasadas, tras quedar sepultados en ambientes anóxicos"
      },
      {
        "@language": "en",
        "@value": "Fine-grained organic matter-rich sedimentary rock used as fuel, brown to black in colour and of stony or earthy consistency, consisting of amorphous carbon accompanied by hydrocarbons, complex organic compounds and inorganic materials. It originates from the carbonification of plants in past geological periods after being buried in anoxic environments"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/coal"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/coal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "carbón"
      },
      {
        "@language": "en",
        "@value": "coal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
