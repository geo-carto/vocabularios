        "@language": "es",
        "@value": "Hidrocarburo natural sólido o semisólido, de color negro o pardo oscuro, inflamable. incluye a los asfaltos, las ceras resinosas y los productos afines"
      },
      {
        "@language": "en",
        "@value": "Solid or semi-solid, black or dark brown, flammable natural hydrocarbon. Includes asphalts, resinous waxes and related products"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/bitumen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "bitumen"
      },
      {
        "@language": "en",
        "@value": "bitumen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
