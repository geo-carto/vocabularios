      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente a la familia de las lamproítas, de color negro, con fenocristales de flogopita, olivino y diópsido, en una matriz vítrea"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the lamproite family, black in colour, with phenocrysts of phlogopite, olivine and diopside in a glassy groundmass"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
