  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/leucitita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "roca leucítica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica ultrabásica, ultraalcalina, de color oscuro, perteneciente a la familia de las rocas foídicas, que tiene como minerales esenciales leucita, piroxeno y, en algunos tipos, olivino. es frecuente, además, la presencia de nefelina"
      },
      {
        "@language": "en",
        "@value": "Ultrabasic, ultraalkaline, dark-coloured volcanic rock belonging to the foidite family, having leucite, pyroxene and, in some types, olivine as essential minerals. The presence of nepheline is also frequent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "leucitita"
      },
      {
        "@language": "en",
        "@value": "leucitite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/exoticCompositionIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/exotic_composition_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
