    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica que contiene clastos de un amplio rango de tamaños desde granos a bloques, rodeados de matriz fundamentalmente arcillosa"
      },
      {
        "@language": "en",
        "@value": "Detrital rock containing clasts of a wide size range, from grains to boulders, surrounded by a predominantly clayey matrix"
      }
    ],
