  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/sienita-foidica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica leucocrática perteneciente al grupo de los sienitoides foídicos, en la que el feldespato alcalino constituye más del 90% de los feldespatos y cuyo contenido en feldespatoides está comprendido entre el 10 y el 60% de los minerales félsicos. es el equivalente intrusivo de la fonolita"
      },
      {
        "@language": "en",
        "@value": "Leucocratic plutonic rock belonging to the group of foid syenitoids, in which alkali feldspar constitutes more than 90% of the feldspars and whose feldspathoid content is between 10 and 60% of the felsic minerals. It is the intrusive equivalent of phonolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidSyenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sienita foídica"
      },
      {
        "@language": "en",
        "@value": "foidic syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/basanita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica básica o ultrabásica perteneciente a la familia de las rocas tefríticas, de color negro y textura generalmente porfídica con fenocristales de plagioclasa que constituyen más del 90% de los feldespatos, clinopiroxeno, feldespatoides y olivino en proporción superior al 10% normativo, generalmente en una matriz microcristalina. su equivalente plutónico es el gabro foídico"
      },
      {
        "@language": "en",
        "@value": "Basic or ultrabasic volcanic rock belonging to the tephrite family, black and generally porphyritic with plagioclase phenocrysts constituting more than 90% of the feldspars, clinopyroxene, feldspathoids and olivine in proportions exceeding 10% normative, generally in a microcrystalline groundmass. Its plutonic equivalent is foid gabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/basanite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/basanite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "basanita"
      },
      {
        "@language": "en",
        "@value": "basanite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/espiculita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
