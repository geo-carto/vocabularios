    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria de grano fino con impregnaciones oleosas o bituminosas de las que, por destilación o mediante disolventes, pueden obtenerse hidrocarburos líquidos o gaseosos"
      },
      {
        "@language": "en",
        "@value": "Fine-grained sedimentary rock with oily or bituminous impregnations from which liquid or gaseous hydrocarbons can be obtained by distillation or using solvents"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
