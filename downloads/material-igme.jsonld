    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica de la familia de las foidolitas, más melanocrática que la fergusita, compuesta por un 70-90% de augita egirínica o egirina y el resto, leucita"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock of the foidolite family, more melanocratic than fergussite, composed of 70-90% aegirine-augite or aegirine and the rest leucite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
