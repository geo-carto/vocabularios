      {
        "@language": "es",
        "@value": "Roca plutónica melanocrática perteneciente al grupo de los sienitoides foídicos, en la que el feldespato alcalino constituye más del 90% de los feldespatos"
      },
      {
        "@language": "en",
        "@value": "Melanocratic plutonic rock belonging to the group of foid syenitoids, in which alkali feldspar constitutes more than 90% of the feldspars"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
