  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/hornblendita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica ultramáfica compuesta esencialmente por hornblenda con piroxenos, espinela y olivino, éste en cantidad inferior al 40% de los minerales máficos, puede contener cantidades menores de plagioclasa, granate y flogopita. en un sentido más estricto, roca plutónica ultramáfica, compuesta en más de un 90% por hornblenda"
      },
      {
        "@language": "en",
        "@value": "Ultramafic plutonic rock composed essentially of hornblende with pyroxenes, spinel and olivine, the latter in an amount below 40% of the mafic minerals; may contain lesser amounts of plagioclase, garnet and phlogopite. In a stricter sense, an ultramafic plutonic rock composed of more than 90% hornblende"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/hornblendite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/hornblendite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "hornblendita"
      },
      {
        "@language": "en",
