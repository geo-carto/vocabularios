  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/pelesparita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza aloquímica esparítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides inferior a 1:3"
      },
      {
        "@language": "en",
        "@value": "Sparitic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio below 1:3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "pelesparita"
      },
      {
        "@language": "en",
        "@value": "pelsparite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-toleitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Término utilizado para rocas basálticas pobres en potasio que forman parte de series magmáticas subalcalinas con fuerte enriquecimiento en hierro en las etapas iniciales de la diferenciación"
      },
      {
        "@language": "en",
        "@value": "Term used for potassium-poor basaltic rocks forming part of subalkaline magmatic series with strong iron enrichment in the early stages of differentiation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca toleítica"
      },
      {
        "@language": "en",
        "@value": "tholeiitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/tholeiiticBasalt"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/tholeiitic_basalt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/tefrita-fonolitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica básica, perteneciente a la familia de las rocas tefríticas, en la que la plagioclasa constituye menos del 90% de los feldespatos, puede contener olivino en proporción inferior al 10% normativo. su equivalente plutónico es la monzodiorita foídica"
      },
      {
        "@language": "en",
        "@value": "Basic volcanic rock belonging to the tephrite family, in which plagioclase constitutes less than 90% of the feldspars; may contain olivine in proportions below 10% normative. Its plutonic equivalent is foid monzodiorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/phonoliticTephrite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_tephrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "tefrita fonolítica"
      },
      {
        "@language": "en",
        "@value": "phonolitic tephrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/ijolita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica de la familia de las foidolitas, compuesta por cantidades similares de nefelina y clinopiroxeno, generalmente augita egirínica o egirina"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock of the foidolite family, composed of similar amounts of nepheline and clinopyroxene, generally aegirine-augite or aegirine"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ijolita"
      },
      {
        "@language": "en",
        "@value": "ijolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foidolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica-de-feldespato-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sienitoide leucocrático en el que el feldespato alcalino constituye más del 90% de los feldespatos, con cantidades subordinadas de plagioclasa, clinopiroxeno, biotita, hornblenda y cuarzo o nefelina. es el equivalente intrusivo de la roca traquítica de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "Leucocratic syenitoid in which alkali feldspar constitutes more than 90% of the feldspars, with subordinate amounts of plagioclase, clinopyroxene, biotite, hornblende and quartz or nepheline. It is the intrusive equivalent of alkali feldspar trachytic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparSyeniticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca sienítica de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar syenitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/metabasalto",
