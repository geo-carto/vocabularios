  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-fosfatados",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Fosfatados, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos compuestos en más de un 50% por minerales fosfatados."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the subcategory of Sedimentary Materials / Phosphatic Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments composed of more than 50% phosphate minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/deposito-fosfatado"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/guano"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-fosfatado"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-fosfatada"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Fosfatados"
      },
      {
        "@language": "en",
        "@value": "Collection - Sedimentary Materials / Phosphatic Sedimentary Rocks And Sediments"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/caliza-travertinica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "masa travertínica, toba calcárea, travertino"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza de color claro, con textura a menudo porosa o tubular, formada por precipitación de carbonato cálcico en el seno del agua, muchas veces sobre restos vegetales"
      },
      {
        "@language": "en",
        "@value": "Light-coloured limestone, often with porous or tubular texture, formed by the precipitation of calcium carbonate in water, often around plant remains"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/travertine"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/travertine"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "caliza travertínica"
      },
      {
        "@language": "en",
        "@value": "travertine limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
