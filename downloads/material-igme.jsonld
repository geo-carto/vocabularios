        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Grandes Grupos de Materiales, que se caracteriza por representar el nivel más alto de la clasificación litológica, englobando las divisiones principales: materiales ígneos, sedimentarios, metamórficos, antrópicos y de impacto."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Major Material Groups, characterized by representing the highest level of lithological classification, encompassing the main divisions: igneous, sedimentary, metamorphic, anthropic, and impact materials."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-compuesto"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-natural-no-consolidado"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-no-consolidado"
      },
