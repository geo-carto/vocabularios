  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/toba-con-bombas-o-bloques",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca piroclástica cuyo contenido en fragmentos de diámetro superior a 64 mm constituye más del 25% en volumen de los piroclastos"
      },
      {
        "@language": "en",
        "@value": "Pyroclastic rock whose content of fragments with a diameter exceeding 64 mm constitutes more than 25% by volume of the pyroclasts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "toba con bombas o bloques"
      },
      {
        "@language": "en",
        "@value": "bomb or block tuff"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
