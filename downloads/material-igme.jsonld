        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza aloquímica con un contenido de esparita mayor que el de micrita"
      },
      {
        "@language": "en",
        "@value": "Allochemical limestone with a sparite content greater than that of micrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
