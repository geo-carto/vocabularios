        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Depósito piroclástico en el que los fragmentos de tamaño superior a 64 mm constituyen más del 25% en volumen de los piroclastos"
      },
      {
        "@language": "en",
        "@value": "Pyroclastic deposit in which fragments larger than 64 mm constitute more than 25% by volume of the pyroclasts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
