    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Vidrio volcánico de color negro brillante, frágil y con fractura concoidea. se origina por el enfriamiento rápido de lavas ácidas"
      },
      {
        "@language": "en",
        "@value": "Volcanic glass of bright black colour, brittle and with conchoidal fracture. It originates from the rapid cooling of acid lavas"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "obsidiana"
      },
      {
        "@language": "en",
        "@value": "obsidian"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/glassyIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/glassy_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
