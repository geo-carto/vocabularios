      {
        "@language": "es",
        "@value": "traquiandesita basáltica"
      },
      {
        "@language": "en",
        "@value": "basaltic trachyandesite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"
      },
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/andesite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/monzonita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica que contiene cuarzo en una cantidad que no supera el 5% de los minerales félsicos y en la que la plagioclasa y el feldespato alcalino se encuentran en cantidades comprendidas entre el 35 y el 65%. es el equivalente intrusivo de la latita"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock containing quartz in an amount not exceeding 5% of the felsic minerals, and in which plagioclase and alkali feldspar are present in amounts between 35 and 65%. It is the intrusive equivalent of latite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/monzonite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "monzonita"
      },
      {
        "@language": "en",
        "@value": "monzonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
