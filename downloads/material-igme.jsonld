  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/basalto-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Basalto subsaturado rico en álcalis, caracterizado por la ausencia de ortopiroxeno y cuarzo, así como por la presencia de olivino, augita rica en titanio y nefelina normativa"
      },
      {
        "@language": "en",
        "@value": "Undersaturated alkali-rich basalt, characterized by the absence of orthopyroxene and quartz, as well as by the presence of olivine, titanium-rich augite and normative nepheline"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
