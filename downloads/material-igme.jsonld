      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca de carácter mixto constituida tanto por fragmentos de origen piroclástico como de origen epiclástico, ambos en un porcentaje comprendido entre el 25 y el 75% del volumen de la roca"
      },
      {
        "@language": "en",
        "@value": "Rock of mixed character consisting of both pyroclastic and epiclastic fragments, each in a percentage between 25 and 75% of the rock volume"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
