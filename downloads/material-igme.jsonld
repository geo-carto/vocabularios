  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-igneos",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Materiales Ígneos, que se caracteriza por incluir materiales resultantes del enfriamiento y la solidificación de un magma, que pueden ser volcánicos o plutónicos, según se emplacen en la superficie o en el interior de la corteza terrestre."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Igneous Materials, characterized by including materials resulting from the cooling and solidification of a magma, which can be volcanic or plutonic, depending on whether they are emplaced at the surface or in the interior of the Earth's crust."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
