  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-siliceos-no-clasticos",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Silíceos No Clásticos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos compuestos en más de un 50% por sílice de origen biogénico o químico, excluyendo las rocas detríticas."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the subcategory of Sedimentary Materials / Non-Clastic Siliceous Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments composed of more than 50% silica of biogenic or chemical origin, excluding detrital rocks."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/deposito-siliceo"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-siliceo"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-silicea"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Silíceos No Clásticos"
      },
      {
        "@language": "en",
        "@value": "Collection - Sedimentary Materials / Non-Clastic Siliceous Sedimentary Rocks And Sediments"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/limolita-arenosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica en la que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 10 y el 50% y la relación de elementos de tamaño limo a tamaño arcilla es superior a 2:1"
      },
      {
        "@language": "en",
        "@value": "Detrital rock in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 10 and 50% and the ratio of silt-size to clay-size elements exceeds 2:1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "limolita arenosa"
      },
      {
        "@language": "en",
        "@value": "sandy siltstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/siltstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/siltstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
