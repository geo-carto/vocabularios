    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Arenisca en la que predominan los granos de diámetro comprendido entre 1.0 y 2.0 mm"
      },
      {
        "@language": "en",
        "@value": "Sandstone in which grains with a diameter between 1.0 and 2.0 mm predominate"
      }
    ],
