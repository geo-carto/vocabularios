  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/piroxenita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica ultramáfica compuesta esencialmente por piroxenos, con olivino en cantidad inferior al 40%, además de espinela y hornblenda, puede contener cantidades menores de plagioclasa, granate y flogopita. en un sentido más estricto, roca plutónica ultramáfica compuesta en más de un 90% por piroxenos"
      },
      {
        "@language": "en",
        "@value": "Ultramafic plutonic rock composed essentially of pyroxenes, with olivine in an amount below 40%, in addition to spinel and hornblende; may contain lesser amounts of plagioclase, garnet and phlogopite. In a stricter sense, an ultramafic plutonic rock composed of more than 90% pyroxenes"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "piroxenita"
      },
      {
        "@language": "en",
        "@value": "pyroxenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-otras-rocas-igneas",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Otras Rocas Ígneas, que se caracteriza por incluir rocas resultantes del enfriamiento y la solidificación de un magma que no se clasifican estrictamente como volcánicas, plutónicas o subvolcánicas, abarcando tipos transicionales o con características mixtas."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Other Igneous Rocks, characterized by including rocks resulting from the cooling and solidification of a magma that are not strictly classified as volcanic, plutonic, or subvolcanic, encompassing transitional types or those with mixed characteristics."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
