    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca carbonatada constituida fundamentalmente por granos, sin matriz micrítica, según la clasificación de dunham 1962"
      },
      {
        "@language": "en",
        "@value": "Carbonate rock consisting fundamentally of grains, without micritic matrix, according to the Dunham (1962) classification"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/grainstone"
