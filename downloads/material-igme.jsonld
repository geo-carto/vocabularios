      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/traquita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente al grupo de las rocas traquíticas, blanquecina o gris, formada esencialmente por feldespato alcalino y frecuentemente con textura traquítica, puede contener cuarzo, en proporción inferior al 5% de los minerales félsicos. su equivalente plutónico es la sienita"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the group of trachytic rocks, whitish or grey, formed essentially by alkali feldspar and frequently with trachytic texture; may contain quartz in proportions below 5% of the felsic minerals. Its plutonic equivalent is syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/trachyte"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "traquita"
      },
      {
        "@language": "en",
        "@value": "trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/pelita-calcarea",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "pelita margosa"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico con un contenido conjunto de elementos de tamaño pelita y de carbonato cálcico igual o superior al 90% del total y en el que la relación de elementos de tamaño lutita con respecto al carbonato está comprendida entre el 65 y el 90%"
      },
      {
        "@language": "en",
        "@value": "Detrital sediment with a combined content of pelite-size elements and calcium carbonate equal to or exceeding 90% of the total, and in which the ratio of mudstone-size elements to carbonate is between 65 and 90%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "pelita calcárea"
      },
      {
        "@language": "en",
        "@value": "calcareous pelite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/mud"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/mud"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
