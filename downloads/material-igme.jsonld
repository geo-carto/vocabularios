  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-fonolitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "fonolitoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Nombre utilizado en la descripción provisional de rocas volcánicas básicas o intermedias, fuertemente alcalinas, compuestas esencialmente por feldespatos, de los que el feldespato alcalino constituye más del 50%, y feldespatoides, que constituyen entre el 10% y el 60% de los minerales félsicos, contienen cantidades menores de minerales ferromagnesianos, como piroxeno y, en ocasiones, anfíbol"
      },
      {
        "@language": "en",
        "@value": "Name used in the provisional description of basic or intermediate, strongly alkaline volcanic rocks, composed essentially of feldspars, of which alkali feldspar constitutes more than 50%, and feldspathoids, constituting between 10% and 60% of the felsic minerals, containing lesser amounts of ferromagnesian minerals, such as pyroxene and, occasionally, amphibole"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/phonolitoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phonolitoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca fonolítica"
      },
      {
        "@language": "en",
        "@value": "phonolitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
