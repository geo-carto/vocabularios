      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/granito-calcoalcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Granito metaluminoso o ligeramente peraluminoso, con valores de al2o3/na2o+k2o en proporciones molares superiores a 1, y relativamente rico en calcio. como minerales varietales suele contener biotita ± anfíbol cálcico ± titanita"
      },
      {
        "@language": "en",
        "@value": "Metaluminous or slightly peraluminous granite, with Al2O3/Na2O+K2O values in molar proportions greater than 1 and relatively rich in calcium. As varietal minerals it usually contains biotite ± calcic amphibole ± titanite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "granito calcoalcalino"
      },
      {
        "@language": "en",
        "@value": "calc-alkaline granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/granite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/calcedonia",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca constituida por el mineral del mismo nombre, consistente en una variedad microcristalina del cuarzo. posee color variable entre gris, blanco, verde, amarillo y azulado, frecuentemente con zonas de distintos colores, varía de transparente a translúcido"
      },
      {
        "@language": "en",
        "@value": "Rock consisting of the mineral of the same name, a microcrystalline variety of quartz. It has variable colour between grey, white, green, yellow and bluish, frequently with zones of different colours, and varies from transparent to translucent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "calcedonia"
      },
      {
        "@language": "en",
        "@value": "chalcedony"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
