    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Variedad de carbón de aspecto consolidado, color pardo a negruzco, sin brillo, con fragmentos de plantas reconocibles y matriz orgánica de grano fino. su contenido en carbono es del 60-75% y el de volátiles, del 46-63%"
      },
      {
        "@language": "en",
        "@value": "Consolidated-appearing coal variety, brown to blackish in colour, without lustre, with recognizable plant fragments and fine-grained organic matrix. Its carbon content is 60-75% and the volatile matter content is 46-63%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
