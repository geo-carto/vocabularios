      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-mesocratica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
