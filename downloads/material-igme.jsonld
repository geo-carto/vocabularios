      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica melanocrática constituida fundamentalmente por plagioclasa cálcica labradorita-anortita y piroxeno. es el equivalente plutónico del basalto"
      },
      {
        "@language": "en",
        "@value": "Melanocratic plutonic rock consisting fundamentally of calcic plagioclase (labradorite-anorthite) and pyroxene. It is the plutonic equivalent of basalt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
