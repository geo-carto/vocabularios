      },
      {
        "@language": "en",
        "@value": "lithic graywacke"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/wacke"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/wacke"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
