      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Evaporitas, que se caracteriza por incluir sedimentos o rocas sedimentarias formados por precipitación química de sales no carbonatadas, principalmente por sulfatos, cloruros y boratos."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Evaporites, characterized by including sediments or sedimentary rocks formed by chemical precipitation of non-carbonate salts, mainly sulfates, chlorides, and borates."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
