      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Materiales Sedimentarios"
      },
      {
        "@language": "en",
        "@value": "Collection - Sedimentary Materials"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-subalcalina",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Término utilizado para las rocas ígneas que no son de naturaleza alcalina. las series magmáticas subalcalinas incluyen las rocas calcoalcalinas, o ricas en aluminio, y toleíticas, o pobres en potasio"
      },
      {
        "@language": "en",
        "@value": "Term used for igneous rocks that are not of alkaline nature. Subalkaline magmatic series include calc-alkaline, or aluminium-rich rocks, and tholeiitic, or potassium-poor rocks"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca subalcalina"
      },
      {
        "@language": "en",
        "@value": "subalkaline rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
