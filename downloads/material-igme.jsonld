  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/halita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "sal, sal gema"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca formada por el mineral del mismo nombre, de fórmula nacl, perteneciente a la clase de los cloruros, que cristaliza en el sistema cúbico, frecuentemente en forma de cubos. es incoloro o blanco con diferentes tonalidades, tiene brillo vítreo, varía de transparente a translúcido y se caracteriza por su sabor salado"
      },
      {
        "@language": "en",
        "@value": "Rock formed by the mineral of the same name, with the formula NaCl, belonging to the class of chlorides, crystallizing in the cubic system, frequently in the form of cubes. It is colourless or white with different shades, with vitreous lustre, varying from transparent to translucent and characterized by its salty taste"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/rockSalt"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/rock_salt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "halita"
      },
      {
        "@language": "en",
        "@value": "halite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/microconglomerado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
