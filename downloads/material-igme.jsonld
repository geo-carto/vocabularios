    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica intermedia, alcalina, perteneciente al grupo de las rocas latíticas, que contiene feldespatoides. su equivalente plutónico es la monzonita con foides"
      },
      {
        "@language": "en",
        "@value": "Intermediate, alkaline volcanic rock belonging to the latitic rock group, containing feldspathoids. Its plutonic equivalent is foid-bearing monzonite"
      }
    ],
