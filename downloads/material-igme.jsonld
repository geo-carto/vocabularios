    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas sieníticas, que contiene cuarzo en una cantidad comprendida entre el 5 y el 20% de los minerales félsicos. es el equivalente intrusivo de la cuarzotraquita"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of syenitic rocks, containing quartz in an amount between 5 and 20% of the felsic minerals. It is the intrusive equivalent of quartz trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/quartzSyenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/quartz_syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cuarzosienita"
      },
      {
        "@language": "en",
        "@value": "quartz syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
