      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca milonítica rica en mica que, macroscópicamente, tiene el aspecto de una filita, aunque más heterogéneo, pues suele incluir numerosas venas de cuarzo y abundantes superficies de cizalla"
      },
      {
        "@language": "en",
        "@value": "Mica-rich mylonitic rock that macroscopically resembles a phyllite, although more heterogeneous, as it usually includes numerous quartz veins and abundant shear surfaces"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
