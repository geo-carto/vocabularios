    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Andesita de alto contenido en mgo más del 8%, con cantidades de tio2 inferiores al 0,5% y de sio2 superiores al 52%, que suele contener olivino y piroxeno, en una matriz vítrea con texturas características de crecimiento rápido"
      },
      {
        "@language": "en",
        "@value": "Andesite with high MgO content (more than 8%), TiO2 contents below 0.5% and SiO2 above 52%, which usually contains olivine and pyroxene in a glassy groundmass with textures characteristic of rapid growth"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
