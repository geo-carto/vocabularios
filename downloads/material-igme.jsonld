      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Rocas Sedimentarias y Sedimentos Ricos en Materia Orgánica, que se caracteriza por incluir rocas y sedimentos con una proporción significativa de materia orgánica, como el carbón, las pizarras bituminosas y los sapropeles."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Organic-Rich Sedimentary Rocks and Sediments, characterized by including rocks and sediments with a significant proportion of organic matter, such as coal, oil shales, and sapropels."
      }
    ],
