  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/granulita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica de grado alto a muy alto, de textura generalmente granoblástica y estructura gnéisica o masiva, dominada por minerales anhidros y feldespatos. en caso de composición máfica, está constituida por clinopiroxeno augítico, ortopiroxeno, plagioclasa cálcica, con o sin granate, y cuarzo. en caso de composición cuarzo-feldespática, está constituida por cuarzo, plagioclasa, feldespato potásico y ortopiroxeno, con o sin biotita, granate, cordierita y sillimanita"
      },
      {
        "@language": "en",
        "@value": "High- to very high-grade metamorphic rock, generally of granoblastic texture and gneissic or massive structure, dominated by anhydrous minerals and feldspars. In mafic composition, it consists of augitic clinopyroxene, orthopyroxene, calcic plagioclase, with or without garnet, and quartz. In quartz-feldspathic composition, it consists of quartz, plagioclase, potassic feldspar and orthopyroxene, with or without biotite, garnet, cordierite and sillimanite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/granulite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "granulita"
      },
      {
        "@language": "en",
        "@value": "granulite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
