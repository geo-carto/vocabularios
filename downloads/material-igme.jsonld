      {
        "@language": "es",
        "@value": "arenisca de grano muy grueso"
      },
      {
        "@language": "en",
        "@value": "very coarse-grained sandstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
