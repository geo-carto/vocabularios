  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-volcanicas",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
