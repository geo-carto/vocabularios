  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-subvolcanicas",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría de Rocas Subvolcánicas, que se caracteriza por incluir rocas originadas por la solidificación de un magma silicatado en el interior de la corteza terrestre a escasa profundidad, no superior a 3 km, asociadas a las rocas plutónicas o a las eruptivas, y que presentan diferencias texturales, más que de composición, con ambas."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the category of Subvolcanic Rocks, characterized by including rocks formed by the solidification of a silicate magma in the interior of the Earth's crust at shallow depth, not exceeding 3 km, associated with plutonic rocks or extrusive rocks, and differing from both primarily in texture rather than composition."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
