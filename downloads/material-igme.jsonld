      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-melilitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "melilitoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea ultrabásica y ultraalcalina que tiene como minerales esenciales melilita en proporción superior al 10%, piroxeno y, con frecuencia, olivino y nefelina. en facies plutónicas recibe el nombre de melilitolita y en facies volcánicas, el de melilitita si la melilita es más abundante que los feldespatoides, en caso contrario, se denomina foidita con melilita"
      },
      {
        "@language": "en",
        "@value": "Ultrabasic, ultraalkaline igneous rock having melilite in proportions exceeding 10%, pyroxene and, frequently, olivine and nepheline as essential minerals. In plutonic facies it is called melilitolite and in volcanic facies, melilitite if melilite is more abundant than the feldspathoids; otherwise it is called melilite-bearing foidite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca melilítica"
      },
      {
        "@language": "en",
        "@value": "melilitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/melilitita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica ultrabásica y ultraalcalina del grupo de los melilitoides que tiene como minerales esenciales melilita en proporción superior al 10%, piroxeno y, con frecuencia, olivino y nefelina"
      },
      {
        "@language": "en",
        "@value": "Ultrabasic, ultraalkaline volcanic rock of the melilitoid group having melilite in proportions exceeding 10%, pyroxene and, frequently, olivine and nepheline as essential minerals"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "melilitita"
      },
      {
        "@language": "en",
        "@value": "melilitite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/anhidrita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca formada por el mineral del mismo nombre, de fórmula caso4, perteneciente a la clase de los sulfatos, que cristaliza en el sistema rómbico, formando, generalmente, agregados masivos o fibrosos. es incoloro o de color blanco, gris o a veces azulado, tiene brillo de vítreo a nacarado y varía de transparente a opaco"
      },
      {
        "@language": "en",
        "@value": "Rock formed by the mineral of the same name, with the formula CaSO4, belonging to the class of sulfates, crystallizing in the orthorhombic system, generally forming massive or fibrous aggregates. It is colourless or white, grey or sometimes bluish, with vitreous to pearly lustre and varying from transparent to opaque"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "anhidrita"
      },
      {
        "@language": "en",
        "@value": "anhydrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/gypsumOrAnhydrite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/rock_gypsum_or_anhydrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
