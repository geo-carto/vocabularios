  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/molasa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Tectofacies constituida por rocas detríticas que pueden alcanzar grandes espesores hasta de algunos miles de metros. con frecuencia presenta secuencias granodecrecientes que se inician con conglomerados. se deposita en las áreas subsidentes adyacentes a los nuevos relieves montañosos, inmediatamente después del plegamiento"
      },
      {
        "@language": "en",
        "@value": "Tectofacies consisting of detrital rocks that can reach great thicknesses of up to several thousands of metres. It frequently presents fining-upward sequences starting with conglomerates. It is deposited in the subsiding areas adjacent to new mountain reliefs, immediately after folding"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "molasa"
      },
      {
        "@language": "en",
        "@value": "molasse"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
