      {
        "@language": "es",
        "@value": "leucitita tefrítica"
      },
      {
        "@language": "en",
        "@value": "tephritic leucitite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
