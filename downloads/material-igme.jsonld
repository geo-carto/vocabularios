  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-hibridos",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Híbridos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellos materiales que no pueden incluirse en ninguna otra categoría por su composición u origen, integrados por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% del sedimento."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the subcategory of Sedimentary Materials / Hybrid Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those materials that cannot be included in any other category by their composition or origin, composed of three or more components, each of which constitutes between 5 and 50% of the sediment."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/deposito-hibrido"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-hibrido"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-hibrida"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Híbridos"
      },
      {
        "@language": "en",
        "@value": "Collection - Sedimentary Materials / Hybrid Sedimentary Rocks And Sediments"
      }
    ]
  },
