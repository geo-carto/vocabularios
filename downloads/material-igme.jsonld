        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "roca sedimentaria carbonatada cuyos constituyentes principales son la dolomita o carbonatos de composición parecida. la variedad pura tiene, al menos, un 95% de dolomita y las variedades impuras, más del 10% de calcita o de impurezas. se origina por precipitación química dolomía primaria o, más frecuentemente, durante la diagénesis dolomía secundaria"
      },
      {
        "@language": "en",
        "@value": "Sedimentary carbonate rock whose principal constituents are dolomite or carbonates of similar composition. The pure variety has at least 95% dolomite and the impure varieties more than 10% calcite or impurities. It originates by chemical precipitation (primary dolomite) or, more frequently, during diagenesis (secondary dolomite)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/dolomiticOrMagnesianSedimentaryRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca dolomítica"
      },
      {
        "@language": "en",
        "@value": "dolomitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/foidita-fonolitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente a la familia de las rocas foídicas que posee una mayor cantidad de feldespato alcalino que de plagioclasa y en la que los feldespatoides representan menos del 90% del total de los minerales félsicos"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the foidite family that has a greater amount of alkali feldspar than plagioclase, and in which feldspathoids represent less than 90% of the total felsic minerals"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/phonoliticFoidite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_foidite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "foidita fonolítica"
      },
      {
        "@language": "en",
        "@value": "phonolitic foidite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
