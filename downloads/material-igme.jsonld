  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-charnoquitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea o ígnea-derivada anhidra, generalmente de composición ácida-intermedia, con ortopiroxeno como mineral máfico principal, sin o con escasos minerales hidratados como micas o anfíboles"
      },
      {
        "@language": "en",
        "@value": "Anhydrous igneous or igneous-derived rock, generally of acid-intermediate composition, with orthopyroxene as the principal mafic mineral, with absent or scarce hydrated minerals such as micas or amphiboles"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca charnoquítica"
      },
      {
        "@language": "en",
        "@value": "charnockitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
