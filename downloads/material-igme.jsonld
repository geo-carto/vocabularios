    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria constituida por menos de un 30% de fragmentos de diámetro superior a 2 mm y cuya relación entre las partículas de lutita y los granos de arena es mayor que 1. los fragmentos pueden ser de cualquier composición y origen"
      },
      {
        "@language": "en",
        "@value": "Sedimentary rock consisting of less than 30% fragments with a diameter exceeding 2 mm and whose ratio of mud particles to sand grains is greater than 1. The fragments may be of any composition and origin"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
