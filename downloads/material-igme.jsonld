      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Arena en la que la proporción de granos de cuarzo es inferior al 75% y el contenido de granos de feldespatos es mayor que el de fragmentos de otras rocas"
      },
      {
        "@language": "en",
        "@value": "Sand in which the proportion of quartz grains is below 75% and the feldspar grain content is greater than that of rock fragments"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
