        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material resultante del enfriamiento y la solidificación de un magma. puede ser volcánico o plutónico, según se emplace en la superficie o en el interior de la corteza terrestre"
      },
      {
        "@language": "en",
        "@value": "Material resulting from the cooling and solidification of a magma. It can be volcanic or plutonic, depending on whether it is emplaced at the surface or in the interior of the Earth's crust"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/igneousMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/igneous_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material ígneo"
      },
      {
        "@language": "en",
        "@value": "igneous material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
