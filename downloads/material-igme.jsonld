    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "hulla"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Variedad de carbón dura, de color negro intenso, brillo mate o graso y fractura rectangular. su contenido en carbono es del 75-90% y el de volátiles, del 14-46%"
      },
      {
        "@language": "en",
        "@value": "Hard coal variety of intense black colour, with matt or oily lustre and rectangular fracture. Its carbon content is 75-90% and the volatile matter content is 14-46%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
