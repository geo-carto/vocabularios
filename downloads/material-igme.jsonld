        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material, consolidado o no, compuesto por fragmentos de naturaleza volcánica al menos en un 10% de su volumen, independientemente del mecanismo de fragmentación y de acumulación"
      },
      {
        "@language": "en",
        "@value": "Material, consolidated or unconsolidated, composed of fragments of volcanic nature in at least 10% of its volume, regardless of the fragmentation and accumulation mechanism"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
