  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/esquisto-anfibolico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica de baja temperatura y presión media-baja, esquistosa y de color verde debido a la presencia de clorita y anfíbol cálcico típicamente actinolita, además de epidota y albita, generalmente resultante del metamorfismo de rocas magmáticas de composición basáltica. se recomienda su uso en vez de esquisto verde, por ser éste un nombre de facies"
      },
      {
        "@language": "en",
        "@value": "Low-temperature, medium- to low-pressure metamorphic rock, schistose and green in colour due to the presence of chlorite and calcic amphibole (typically actinolite), in addition to epidote and albite, generally resulting from the metamorphism of mafic igneous rocks of basaltic composition. Its use is recommended instead of 'greenschist', as that is a facies name"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "esquisto anfibólico"
      },
      {
        "@language": "en",
        "@value": "amphibolic schist"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/chloriteActinoliteEpidoteMetamorphicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/chlorite_actinolite_epidote_metamorphic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
