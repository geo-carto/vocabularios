    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico no consolidado y mal clasificado que contiene clastos de un amplio rango de tamaños, desde partículas hasta bloques"
      },
      {
