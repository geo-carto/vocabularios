  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/leucitita-fonolitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente a la familia de las rocas foídicas, en la que el feldespato alcalino predomina sobre la plagioclasa y que tiene como minerales esenciales leucita y piroxeno"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the foidite family, in which alkali feldspar predominates over plagioclase and which has leucite and pyroxene as essential minerals"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "leucitita fonolítica"
      },
      {
        "@language": "en",
        "@value": "phonolitic leucitite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/phonolitoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phonolitoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
