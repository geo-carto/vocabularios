  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/basalto-toleitico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "toleíta"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Basalto pobre en álcalis, con enstatita normativa, plagioclasa y augita, con o sin olivino y, en ocasiones, con pigeonita"
      },
      {
        "@language": "en",
        "@value": "Low-alkali basalt with normative enstatite, plagioclase and augite, with or without olivine and, occasionally, with pigeonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/tholeiiticBasalt"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/tholeiitic_basalt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "basalto toleítico"
      },
      {
        "@language": "en",
        "@value": "tholeiitic basalt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/canto-estriado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Canto que presenta estrías a causa del roce a que durante su transporte ha sido sometido con las paredes y el lecho rocoso de un glaciar, o debido a deformación tectónica"
      },
      {
        "@language": "en",
        "@value": "Clast exhibiting striations resulting from friction during its transport against the walls and rocky floor of a glacier, or due to tectonic deformation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "canto estriado"
      },
      {
        "@language": "en",
        "@value": "striated pebble"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/komatiita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea considerada como el único equivalente volcánico de las rocas ultramáficas. está formada a partir de magmas de muy alta temperatura, con un contenido en sio2 del 30-52%, mayor del 18% en mgo, menor del 2% en na2o+k2o y menor del 1% en tio2. presenta texturas spinifex formadas por cristales alargados y dendríticos de olivino, resultado de un enfriamiento muy rápido"
      },
      {
        "@language": "en",
        "@value": "Igneous rock considered to be the only volcanic equivalent of ultramafic rocks. It is formed from very high-temperature magmas with a SiO2 content of 30-52%, more than 18% MgO, less than 2% Na2O+K2O and less than 1% TiO2. It exhibits spinifex textures formed by elongated dendritic crystals of olivine, resulting from very rapid cooling"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "komatiíta"
      },
      {
        "@language": "en",
        "@value": "komatiite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/exoticCompositionIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/exotic_composition_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/pelita-gravosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico poco seleccionado, con un contenido de elementos de tamaño pelita superior al de elementos de tamaño arena y con un contenido de elementos de tamaño grava comprendido entre el 5 y el 30% del total"
      },
      {
        "@language": "en",
        "@value": "Poorly sorted detrital sediment with a pelite-size element content greater than that of sand-size elements and a gravel-size element content between 5 and 30% of the total"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "pelita gravosa"
      },
      {
        "@language": "en",
        "@value": "gravelly pelite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/mud"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/mud"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/grava-pelitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico poco seleccionado, constituido en un 30-50% por clastos de más de 2 mm de diámetro y con un contenido de elementos de tamaño pelita mayor que el de elementos de tamaño arena"
      },
      {
        "@language": "en",
        "@value": "Poorly sorted detrital sediment consisting of 30-50% clasts with a diameter exceeding 2 mm and with a pelite-size element content greater than that of sand-size elements"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "grava pelítica"
      },
      {
        "@language": "en",
        "@value": "pelitic gravel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/gravel"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/gravel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/sedimento-dolomitico-puro",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento compuesto en más de un 90% por minerales carbonatados y con un contenido de dolomita superior al de calcita más aragonito"
      },
      {
        "@language": "en",
        "@value": "Sediment composed of more than 90% carbonate minerals and with a dolomite content greater than that of calcite plus aragonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/pureDolomiticSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pure_dolomitic_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento dolomítico puro"
      },
      {
        "@language": "en",
        "@value": "pure dolomitic sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/metacaliza",
