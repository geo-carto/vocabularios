  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-vitrea",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "roca holohialina"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea que ha sufrido un enfriamiento rápido, dando lugar a una masa amorfa, sin cristales, presentando las características de un vidrio: fragilidad, fractura concoidea y ausencia de exfoliación"
      },
      {
        "@language": "en",
        "@value": "Igneous rock that has undergone rapid cooling, giving rise to an amorphous, crystal-free mass, exhibiting the characteristics of a glass: brittleness, conchoidal fracture and absence of cleavage"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca vítrea"
      },
      {
        "@language": "en",
        "@value": "glassy rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/glassyIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/glassy_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
