    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca piroclástica formada por fragmentos angulosos de vidrio, más o menos desvitrificados, originados por el contacto súbito del magma que sale en una erupción volcánica submarina, con el agua o con sedimentos saturados en agua"
      },
      {
        "@language": "en",
        "@value": "Pyroclastic rock formed by angular glass fragments, more or less devitrified, originating from the sudden contact of magma emerging in a submarine volcanic eruption with water or water-saturated sediments"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
