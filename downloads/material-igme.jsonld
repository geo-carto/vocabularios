      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "caliza aloquímica"
      },
      {
        "@language": "en",
        "@value": "allochemical limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/foidolita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "roca foidolítica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica cuyo contenido en feldespatoides es mayor del 60% del total de los minerales félsicos, con cantidades menores de feldespato alcalino, plagioclasa, anfíbol, clinopiroxeno y, ocasionalmente, olivino"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock whose feldspathoid content exceeds 60% of the total felsic minerals, with lesser amounts of alkali feldspar, plagioclase, amphibole, clinopyroxene and, occasionally, olivine"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foidolite"
      }
    ],
