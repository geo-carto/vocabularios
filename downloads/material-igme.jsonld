  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/ortobrecha",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Brecha constituida por cantos y bloques angulosos dispuestos en contacto entre sí, entre los que la matriz arenosa o pelítica se presenta en proporción inferior al 15%"
      },
      {
        "@language": "en",
        "@value": "Breccia consisting of angular clasts and blocks in mutual contact, with a sandy or pelitic matrix in proportions below 15%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
