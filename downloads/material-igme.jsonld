  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/granito",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica leucocrática compuesta por cantidades similares de cuarzo, feldespato potásico y plagioclasa sódica, como minerales esenciales, y cantidades menores de uno o más minerales como biotita, moscovita, cordierita, hornblenda, granate, etc. el cuarzo constituye entre el 20 y el 60% de los minerales félsicos y el feldespato alcalino, entre el 35 y el 90% de los feldespatos. es el equivalente plutónico de la riolita"
      },
      {
        "@language": "en",
        "@value": "Leucocratic plutonic rock composed of similar amounts of quartz, potassic feldspar and sodic plagioclase as essential minerals, and lesser amounts of one or more minerals such as biotite, muscovite, cordierite, hornblende, garnet, etc. Quartz constitutes between 20 and 60% of the felsic minerals and alkali feldspar between 35 and 90% of the feldspars. It is the plutonic equivalent of rhyolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/granite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "granito"
      },
      {
        "@language": "en",
        "@value": "granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
