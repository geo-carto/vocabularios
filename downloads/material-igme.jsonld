        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas y Depósitos Volcanoclásticos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas compuestas, al menos en un 10% de su volumen, por fragmentos de naturaleza volcánica, independientemente del mecanismo de fragmentación y de acumulación."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the subcategory of Sedimentary Materials / Volcaniclastic Rocks and Deposits, characterized by grouping, within sedimentary materials, those rocks composed of at least 10% by volume of fragments of volcanic nature, regardless of the fragmentation and accumulation mechanism."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/deposito-volcano-sedimentario"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-volcano-sedimentaria"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Materiales Sedimentarios / Rocas y Depósitos Volcanoclásticos"
      },
      {
        "@language": "en",
        "@value": "Collection - Sedimentary Materials / Volcaniclastic Rocks And Deposits"
      }
    ]
  },
