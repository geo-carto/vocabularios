    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente a la familia de las rocas foídicas, en la que la plagioclasa predomina sobre el feldespato alcalino y que tiene como minerales esenciales leucita y piroxeno"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the foidite family, in which plagioclase predominates over alkali feldspar and which has leucite and pyroxene as essential minerals"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
