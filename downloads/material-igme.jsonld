      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria constituida, en más de un 50%, por elementos detríticos angulosos de más de 2 mm de diámetro y trabados por un cemento o una matriz detrítica fina"
      },
      {
        "@language": "en",
        "@value": "Sedimentary rock consisting of more than 50% angular detrital elements with a diameter exceeding 2 mm, bound by a cement or fine detrital matrix"
      }
    ],
