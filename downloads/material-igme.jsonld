  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-doleritica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca subvolcánica oscura de composición gabroica basáltica o diorítica andesítica, generalmente masiva y compacta, de tamaño de grano intermedio entre basalto y gabro, compuesta por plagioclasa, piroxeno y minerales opacos, a veces con olivino, ocasionalmente presenta textura dolerítica y, más frecuentemente, ofítica. incluye a dolerita, microdiorita, diabasa y microgabro"
      },
      {
        "@language": "en",
        "@value": "Dark subvolcanic rock of gabbroic-basaltic or dioritic-andesitic composition, generally massive and compact, of grain size intermediate between basalt and gabbro, composed of plagioclase, pyroxene and opaque minerals, sometimes with olivine; occasionally with doleritic texture and, more frequently, ophitic texture. Includes dolerite, microdiorite, diabase and microgabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca dolerítica"
      },
      {
        "@language": "en",
        "@value": "doleritic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/sedimento-calcareo-impuro",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
