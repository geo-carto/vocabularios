        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica formada casi enteramente por augita, con algo de nefelina, perovskita, apatito y granate. es el término ultramáfico de la familia de las foidolitas"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock formed almost entirely by augite, with some nepheline, perovskite, apatite and garnet. It is the ultramafic end-member of the foidolite family"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "jacupirangita"
      },
      {
        "@language": "en",
        "@value": "jacupirangite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foidolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
