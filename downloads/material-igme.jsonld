    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Piroxenita constituida en más del 90% por ortopiroxeno, con otros minerales ferromagnesianos como accesorios"
      },
      {
        "@language": "en",
        "@value": "Pyroxenite consisting of more than 90% orthopyroxene, with other ferromagnesian minerals as accessories"
      }
