  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/serpentinita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica compuesta mayoritariamente por minerales del grupo de la serpentina crisotilo, antigorita, con o sin cantidades subordinadas de talco, brucita, olivino, diópsido, tremolita y magnetita. se forma por hidratación de rocas ultramáficas lherzolitas, harzburgitas a temperaturas moderadas inferiores a 500ºc"
      },
      {
        "@language": "en",
        "@value": "Metamorphic rock composed predominantly of serpentine group minerals (chrysotile, antigorite), with or without subordinate amounts of talc, brucite, olivine, diopside, tremolite and magnetite. It is formed by hydration of ultramafic rocks (lherzolites, harzburgites) at moderate temperatures below 500°C"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/serpentinite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/serpentinite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "serpentinita"
      },
      {
        "@language": "en",
        "@value": "serpentinite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/protomilonita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca milonítica cuya matriz constituye menos del 50% del volumen de la roca"
      },
      {
        "@language": "en",
        "@value": "Mylonitic rock whose matrix constitutes less than 50% of the rock volume"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
