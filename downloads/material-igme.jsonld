        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-traquitica-de-feldespato-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica leucocrática, intermedia o ácida, alcalina, perteneciente al grupo de los traquitoides, cuyo componente principal es el feldespato alcalino, que constituye más del 90% de los feldespatos, en una matriz microcristalina, frecuentemente con textura traquítica. su equivalente plutónico es la roca sienítica de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "Leucocratic, intermediate or acid, alkaline volcanic rock belonging to the group of trachytoids, whose principal component is alkali feldspar, constituting more than 90% of the feldspars, in a microcrystalline groundmass, frequently with trachytic texture. Its plutonic equivalent is alkali feldspar syenitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparTrachyticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachytic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca traquítica de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar trachytic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
