    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento con un contenido de calcita más aragonito superior al de dolomita y en el que los minerales carbonatados constituyen entre el 50 y el 90% del total"
      },
      {
        "@language": "en",
        "@value": "Sediment with a calcite plus aragonite content greater than that of dolomite and in which carbonate minerals constitute between 50 and 90% of the total"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/impureCalcareousCarbonateSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/impure_calcareous_carbonate_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento calcáreo impuro"
      },
      {
        "@language": "en",
        "@value": "impure calcareous sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
