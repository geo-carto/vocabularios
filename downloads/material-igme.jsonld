  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-foliada",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica en la que al menos el 10% de sus componentes minerales tienen una fábrica planar o linear. la naturaleza cataclástica o vítrea excluyen la clasificación bajo este concepto"
      },
      {
        "@language": "en",
        "@value": "Metamorphic rock in which at least 10% of its mineral components exhibit a planar or linear fabric. Cataclastic or glassy nature excludes classification under this concept"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foliatedMetamorphicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foliated_metamorphic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca foliada"
      },
      {
        "@language": "en",
        "@value": "foliated rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
