    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca piroclástica en la que los fragmentos de ceniza gruesa constituyen más del 75% en volumen del contenido piroclástico"
      },
      {
        "@language": "en",
        "@value": "Pyroclastic rock in which coarse ash fragments constitute more than 75% by volume of the pyroclastic content"
      }
