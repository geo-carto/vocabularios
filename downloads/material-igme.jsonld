      },
      {
        "@language": "en",
        "@value": "fenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"
      }
