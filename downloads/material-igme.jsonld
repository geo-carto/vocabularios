      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-de-falla-no-cohesivo",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material de falla con rasgos que indican pérdida de cohesión durante la deformación, tales como espacios vacíos rellenos o no o material con matriz no consolidada entre los fragmentos. incluye las brechas y las harinas de falla"
      },
      {
        "@language": "en",
        "@value": "Fault material with features indicating loss of cohesion during deformation, such as empty or filled void spaces or non-consolidated matrix material between the fragments. Includes breccias and fault gouges"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material de falla no cohesivo"
      },
      {
        "@language": "en",
        "@value": "non-cohesive fault material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/breccia-gougeSeries"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/breccia_gouge_series"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
