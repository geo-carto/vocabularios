        "@language": "es",
        "@value": "Roca ígnea con un contenido en minerales oscuros comprendido entre el 35% y el 65% en volumen"
      },
      {
        "@language": "en",
        "@value": "Igneous rock with a dark mineral content between 35% and 65% by volume"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
