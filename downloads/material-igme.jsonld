        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/adakita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea ácida, de composición dacítica o granodiorítica-tonalítica, rica en na2o y con relaciones elevadas de la/yb y sr/y mayor de 40 en este último ratio. la adakita puede formarse por fusión directa de la corteza oceánica subducida o por fusión parcial de una corteza máfica en condiciones de alta presión"
      },
      {
        "@language": "en",
        "@value": "Acid igneous rock of dacitic or granodioritic-tonalitic composition, rich in Na2O and with high La/Yb and Sr/Y ratios (greater than 40 for the latter). Adakite may form by direct melting of subducted oceanic crust or by partial melting of a mafic crust under high-pressure conditions"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "adakita"
      },
      {
        "@language": "en",
        "@value": "adakite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/granodiorite"
      },
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/tonalite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/granodiorite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/tonalite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/larvikita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sienita alcalina caracterizada por la presencia de abundantes  fenocristales de feldespato con formas romboidales que, cuando están pulidos, causan reflexiones brillantes azules o verdosas, la augita es el principal mineral máfico, pudiendo contener, como accesorio, abundante apatito"
      },
      {
        "@language": "en",
        "@value": "Alkaline syenite characterized by the presence of abundant rhomboidal-shaped feldspar phenocrysts which, when polished, cause bright blue or greenish reflections; augite is the principal mafic mineral and it may contain, as an accessory, abundant apatite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "larvikita"
      },
      {
        "@language": "en",
        "@value": "larvikite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/syenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arenisca-de-grano-medio",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Arenisca en la que predominan los granos de diámetro comprendido entre 0.25 y 0.5 mm"
      },
      {
        "@language": "en",
        "@value": "Sandstone in which grains with a diameter between 0.25 and 0.5 mm predominate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arenisca de grano medio"
      },
      {
        "@language": "en",
        "@value": "medium-grained sandstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/traquidacita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica mesocrática, intermedia o ácida, alcalina, perteneciente a la familia de las rocas traquíticas, diferenciada de la traquita por poseer más del 20% de cuarzo normativo"
      },
      {
        "@language": "en",
        "@value": "Mesocratic, intermediate or acid, alkaline volcanic rock belonging to the trachytic rock family, differentiated from trachyte by having more than 20% normative quartz"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/trachytoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/trachytoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "traquidacita"
      },
      {
        "@language": "en",
        "@value": "trachydacite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/granito-de-feldespato-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica leucocrática de la familia de los granitoides, en la que el feldespato alcalino constituye más del 90% del total de los feldespatos. es el equivalente plutónico de la riolita de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "Leucocratic plutonic rock of the granitoid family, in which alkali feldspar constitutes more than 90% of the total feldspars. It is the plutonic equivalent of alkali feldspar rhyolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparGranite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "granito de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/contornita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico semejante a una turbidita, pero formado por la acción de las corrientes de contorno"
      },
      {
        "@language": "en",
        "@value": "Detrital sediment similar to a turbidite, but formed by the action of contour currents"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
