      {
        "@language": "es",
        "@value": "sedimento evaporítico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento formado por precipitación química de sales no carbonatadas, principalmente por sulfatos, cloratos y boratos"
      },
      {
        "@language": "en",
        "@value": "Sediment formed by chemical precipitation of non-carbonate salts, mainly sulfates, chlorates and borates"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "depósito evaporítico"
      },
      {
        "@language": "en",
        "@value": "evaporitic deposit"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/chemicalSedimentaryMaterial"
