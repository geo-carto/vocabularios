  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/deposito-epiclastico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Depósito volcanoclástico que contiene fragmentos de origen volcánico con evidencias de haber sido transportados por algún medio sedimentario"
      },
      {
        "@language": "en",
        "@value": "Volcaniclastic deposit containing volcanic fragments showing evidence of having been transported by some sedimentary medium"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
