      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-piroclastico-epiclastico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material de carácter mixto constituido tanto por fragmentos de origen piroclástico como de origen epiclástico, ambos en un porcentaje comprendido entre el 25 y el 75% del volumen del depósito"
      },
      {
        "@language": "en",
        "@value": "Material of mixed character consisting of both pyroclastic and epiclastic fragments, each in a percentage between 25 and 75% of the deposit volume"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material piroclástico-epiclástico"
      },
      {
        "@language": "en",
        "@value": "pyroclastic-epiclastic material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"
      },
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/sediment"
      }
