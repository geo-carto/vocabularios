  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/piedra-pomez",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "pómez, pumita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica vítrea de color claro, muy porosa y de baja densidad, que flota en el agua, formada a partir de fragmentos de lava viscosa proyectados al aire por un volcán y que sufren un gran descenso de presión que provoca una desgasificación y la formación de burbujas, separadas por delgadas paredes de vidrio volcánico"
      },
      {
        "@language": "en",
        "@value": "Light-coloured, very porous and low-density glassy volcanic rock that floats on water, formed from fragments of viscous lava projected into the air by a volcano and undergoing a large pressure drop causing degassing and the formation of bubbles separated by thin walls of volcanic glass"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "piedra pómez"
      },
      {
        "@language": "en",
        "@value": "pumice stone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
