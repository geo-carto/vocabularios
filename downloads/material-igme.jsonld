        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Porción de roca, vidrio o cristal volcánico, de dimensiones variables, formado por fragmentación del magma o de las rocas de la pared del conducto, proyectado al aire por una erupción volcánica explosiva"
      },
      {
        "@language": "en",
        "@value": "Portion of rock, glass or volcanic crystal, of variable dimensions, formed by fragmentation of the magma or of the conduit wall rocks, projected into the air by an explosive volcanic eruption"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/tephra"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/tephra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "piroclasto"
      },
      {
        "@language": "en",
        "@value": "pyroclast"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
