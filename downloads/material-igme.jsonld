      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza aloquímica esparítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides comprendida entre 1:3 y 3:1"
      },
      {
        "@language": "en",
        "@value": "Sparitic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio between 1:3 and 3:1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
