      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca subvolcánica o filoniana de textura porfídica, que contiene fenocristales de cuarzo o feldespato, incluidos en una matriz vítrea o microcristalina"
      },
      {
        "@language": "en",
        "@value": "Subvolcanic or dyke rock of porphyritic texture, containing quartz or feldspar phenocrysts enclosed in a glassy or microcrystalline groundmass"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
