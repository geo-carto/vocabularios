  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/varva",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento formado por asociaciones de láminas en las que alternan niveles más claros limo o arena muy fina con otros más oscuros arcilla, característico de medios lacustres, y cuyo origen va ligado a los cambios climáticos estacionales"
      },
      {
        "@language": "en",
        "@value": "Sediment formed by associations of laminae alternating lighter levels (silt or very fine sand) with darker levels (clay), characteristic of lacustrine environments, and whose origin is linked to seasonal climatic changes"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "varva"
      },
      {
        "@language": "en",
        "@value": "varve"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/tefra-de-bombas-y-bloques",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Depósito piroclástico cuyo contenido en fragmentos de diámetro superior a 64 mm está comprendido entre el 25 y el 75% del volumen de los piroclastos"
      },
      {
        "@language": "en",
        "@value": "Pyroclastic deposit whose content of fragments with a diameter exceeding 64 mm is between 25 and 75% of the pyroclast volume"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "tefra de bombas y bloques"
      },
      {
        "@language": "en",
        "@value": "bomb and block tephra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/ashBrecciaBombOrBlockTephra"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/absarokita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca basáltica compuesta por fenocristales de olivino y clinopiroxeno en una matriz de plagioclasa cálcica labradorita, feldespato alcalino sanidina, olivino y, ocasionalmente, leucita. es similar a la shoshonita, pero sin fenocristales de plagioclasa"
      },
      {
        "@language": "en",
        "@value": "Basaltic rock composed of olivine and clinopyroxene phenocrysts in a matrix of calcic plagioclase (labradorite), alkali feldspar (sanidine), olivine and, occasionally, leucite. It is similar to shoshonite but lacks plagioclase phenocrysts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "absarokita"
      },
      {
        "@language": "en",
        "@value": "absarokite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/basalt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/obsidiana",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
