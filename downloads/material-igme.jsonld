  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/melteigita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica de la familia de las foidolitas, más melanocrática que la ijolita, compuesta por un 70-90% de augita egirínica o egirina y el resto, nefelina"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock of the foidolite family, more melanocratic than ijolite, composed of 70-90% aegirine-augite or aegirine and the rest nepheline"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
