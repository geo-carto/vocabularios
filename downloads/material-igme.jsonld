  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/lutita-conglomeratica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica poco seleccionada, con un contenido de elementos de tamaño pelita superior al de elementos de tamaño arena y con un contenido de tamaño grava comprendido entre el 5 y el 30% del total"
      },
      {
        "@language": "en",
        "@value": "Poorly sorted detrital rock with a pelite-size element content greater than that of sand-size elements and a gravel-size content between 5 and 30% of the total"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
