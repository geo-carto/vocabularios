  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arena-gravosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico poco seleccionado, con un contenido de elementos de tamaño arena superior al de elementos de tamaño pelita y con un contenido de elementos de tamaño grava comprendido entre el 5 y el 30% del total"
      },
      {
        "@language": "en",
        "@value": "Poorly sorted detrital sediment with a sand-size element content greater than that of pelite-size elements and a gravel-size element content between 5 and 30% of the total"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arena gravosa"
      },
      {
        "@language": "en",
        "@value": "gravelly sand"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sand"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/sand"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-lamproitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "lamproíta"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca basáltica a basanítica de composición ultrapotásica. su mineralogía varía considerablemente, siendo frecuente la presencia de flogopita, olivino, diópsido, richterita, sanidina y leucita, los dos últimos sólo en la matriz, también puede contener minerales potásicos muy poco frecuentes como ti-k-richterita, priderita, wadeíta y gepita"
      },
      {
        "@language": "en",
        "@value": "Basaltic to basanitic rock of ultrapotassic composition. Its mineralogy varies considerably; phlogopite, olivine, diopside, richterite, sanidine and leucite (the latter two only in the groundmass) are frequent; it may also contain very uncommon potassic minerals such as Ti-K-richterite, priderite, wadeite and gepite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca lamproítica"
      },
      {
        "@language": "en",
        "@value": "lamproitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/pantelerita-pantellerita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
