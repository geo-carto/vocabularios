      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metasomática, generalmente formada en torno a intrusiones de carbonatitas, ijolitas o, más raramente, sienitas nefelínicas, compuesta por feldespatos alcalinos, piroxenos y anfíboles sódicos y, ocasionalmente, feldespatoides y carbonatos"
      },
      {
        "@language": "en",
        "@value": "Metasomatic rock, generally formed around intrusions of carbonatites, ijolites or, more rarely, nepheline syenites, composed of alkali feldspars, sodic pyroxenes and amphiboles and, occasionally, feldspathoids and carbonates"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
