    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Clase, grupo o textura de los sedimentos o rocas sedimentarias detríticas cuyo tamaño medio de los granos está comprendido entre 0.062 y 2 mm"
      },
      {
        "@language": "en",
        "@value": "Class, group or texture of detrital sediments or sedimentary rocks whose mean grain size is between 0.062 and 2 mm"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
