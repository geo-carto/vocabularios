      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-metamorficos-rocas-metasomaticas-e-hidrotermales",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la subcategoría de Materiales Metamórficos / Rocas Metasomáticas e Hidrotermales, que se caracteriza por agrupar, dentro de los materiales metamórficos, aquellas rocas derivadas de un proceso metamórfico por el que se produce un cambio importante en la composición química de la roca, debido a interacción con fluidos hidrotermales o magmas."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the subcategory of Metamorphic Materials / Metasomatic and Hydrothermal Rocks, characterized by grouping, within metamorphic materials, those rocks derived from a metamorphic process in which an important change in the chemical composition of the rock occurs, due to interaction with hydrothermal fluids or magmas."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-hidrotermal"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-metasomatica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Materiales Metamórficos / Rocas Metasomáticas e Hidrotermales"
      },
      {
        "@language": "en",
        "@value": "Collection - Metamorphic Materials / Metasomatic And Hydrothermal Rocks"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/diorita-foidica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas dioríticas foídicas, en la que la plagioclasa constituye más del 90% de los feldespatos. es el equivalente intrusivo de la tefrita"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of foidic dioritic rocks, in which plagioclase constitutes more than 90% of the feldspars. It is the intrusive equivalent of tephrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidDiorite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_diorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "diorita foídica"
      },
      {
        "@language": "en",
        "@value": "foidic diorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-de-silicatos-calcicos",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica derivada de rocas carbonatadas impuras o margas, constituida fundamentalmente por silicatos con calcio, como epidota, zoisita, vesubianita, diópsido, actinolita, hornblenda, granate cálcico, wollastonita, anortita o escapolita"
      },
      {
        "@language": "en",
        "@value": "Metamorphic rock derived from impure carbonate rocks or marls, consisting fundamentally of calcium silicates such as epidote, zoisite, vesuvianite, diopside, actinolite, hornblende, calcic garnet, wollastonite, anorthite or scapolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca de silicatos cálcicos"
      },
      {
        "@language": "en",
        "@value": "calc-silicate rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/cuarzoanortosita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas anortosíticas que contiene cuarzo en una cantidad superior al 5% de los minerales félsicos"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of anorthositic rocks, containing quartz in an amount exceeding 5% of the felsic minerals"
      }
