    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Carbón, consolidado o no, formado a partir de materia orgánica vegetal. presenta un bandeado correspondiente a distintas acumulaciones de restos de plantas superpuestas en el tiempo"
      },
      {
        "@language": "en",
        "@value": "Consolidated or unconsolidated coal, formed from plant organic matter. It exhibits banding corresponding to different accumulations of plant remains superimposed in time"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
