      {
        "@language": "es",
        "@value": "diamictita"
      },
      {
        "@language": "en",
        "@value": "diamictite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-intrusiva",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "roca plutónica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea solidificada en el interior de la corteza terrestre, a partir de un magma silicatado. las rocas plutónicas son generalmente de grano medio-grueso, aunque pueden tener facies de grano fino relacionadas"
      },
      {
        "@language": "en",
        "@value": "Igneous rock solidified in the interior of the Earth's crust from a silicate magma. Plutonic rocks are generally medium- to coarse-grained, although they may have related fine-grained facies"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca intrusiva"
      },
      {
        "@language": "en",
        "@value": "intrusive rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/phaneriticIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/monzogabro",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas monzogabroicas, que contiene cuarzo en una cantidad que no supera el 5% de los minerales félsicos y que además de plagioclasa cálcica contiene feldespato alcalino en cantidades comprendidas entre el 10 y el 35% de los feldespatos"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of monzogabbroic rocks, containing quartz in an amount not exceeding 5% of the felsic minerals, and which in addition to calcic plagioclase contains alkali feldspar in amounts between 10 and 35% of the feldspars"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/monzogabbro"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzogabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "monzogabro"
      },
      {
        "@language": "en",
        "@value": "monzogabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/grava-s.l.",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento constituido en más de un 30% por fragmentos de tamaño grava >2 mm de diámetro, sin especificar su composición o su génesis"
      },
      {
        "@language": "en",
        "@value": "Sediment consisting of more than 30% gravel-size fragments (>2 mm diameter), without specifying composition or genesis"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/gravelSizeSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/gravel_size_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "grava s.l."
      },
      {
        "@language": "en",
        "@value": "gravel s.l."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/tefra-de-lapilli-y-ceniza",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Depósito piroclástico en el que los fragmentos de tamaño inferior a 64 mm constituyen más del 75% en volumen de los piroclastos, pero ni los fragmentos de lapilli ni los de ceniza superan el 75% del volumen"
      },
      {
        "@language": "en",
        "@value": "Pyroclastic deposit in which fragments smaller than 64 mm constitute more than 75% by volume of the pyroclasts, but neither the lapilli nor the ash fragments exceed 75% of the volume"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/ashAndLapilli"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ash_and_lapilli"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "tefra de lapilli y ceniza"
      },
      {
        "@language": "en",
        "@value": "lapilli and ash tephra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-granoblastica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "granoblastita, granofelsita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica granuda, no foliada y masiva, de cualquier composición"
      },
      {
        "@language": "en",
        "@value": "Granular, non-foliated, massive metamorphic rock of any composition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/granofels"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/granofels"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca granoblástica"
      },
      {
        "@language": "en",
        "@value": "granoblastic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/ulexita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca formada por el mineral del mismo nombre, de fórmula nacab5o9.8h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema triclínico bajo forma globular, con aspecto externo de bolas de algodón y estructura interna fibrosa. es incoloro o blanco, tiene brillo sedoso y varía de transparente a translúcido"
      },
      {
        "@language": "en",
        "@value": "Rock formed by the mineral of the same name, with the formula NaCaB5O9·8H2O, belonging to the class of borates, crystallizing in the triclinic system in globular form with a cotton-ball external appearance and fibrous internal structure. It is colourless or white, with silky lustre and varying from transparent to translucent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ulexita"
      },
      {
        "@language": "en",
        "@value": "ulexite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/evaporite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/borax",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca formada por el mineral del mismo nombre, de fórmula na2b4o7.10h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema monoclínico formando grandes cristales prismáticos o masas terrosas. es incoloro o blanquecino, aunque generalmente presenta tonalidades grises o azuladas, tiene brillo vítreo y varía de transparente a translúcido"
      },
      {
        "@language": "en",
        "@value": "Rock formed by the mineral of the same name, with the formula Na2B4O7·10H2O, belonging to the class of borates, crystallizing in the monoclinic system forming large prismatic crystals or earthy masses. It is colourless or whitish, although it generally presents grey or bluish hues, with vitreous lustre and varying from transparent to translucent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "bórax"
      },
      {
        "@language": "en",
        "@value": "borax"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/evaporite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-natural-no-consolidado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material de origen natural sin compactar. incluye los sedimentos, los depósitos volcanoclásticos y los materiales de falla no cohesivos"
      },
      {
        "@language": "en",
        "@value": "Natural, unconsolidated material. Includes sediments, volcaniclastic deposits and non-cohesive fault materials"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/naturalUnconsolidatedMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/natural_unconsolidated_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material natural no consolidado"
      },
      {
        "@language": "en",
        "@value": "unconsolidated natural material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/packstone",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca carbonatada grano-soportada, con matriz micrítica entre los granos, según la clasificación de dunham 1962"
      },
      {
        "@language": "en",
        "@value": "Grain-supported carbonate rock, with micritic matrix between the grains, according to the Dunham (1962) classification"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/packstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/packstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "packstone"
      },
      {
        "@language": "en",
        "@value": "packstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-milonitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca de falla cohesiva, fuertemente foliada y habitualmente con una marcada lineación de minerales sobre las superficies de foliación. está constituida esencialmente por granos alargados con forma de tiras embebidos en una matriz de pequeños granos de la misma composición mineral, que es el resultado de una recristalización dinámica"
      },
      {
        "@language": "en",
        "@value": "Cohesive, strongly foliated fault rock, usually with a marked mineral lineation on foliation surfaces. It consists essentially of elongated ribbon-shaped grains embedded in a matrix of small grains of the same mineral composition, which results from dynamic recrystallization"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca milonítica"
      },
      {
