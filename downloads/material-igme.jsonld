      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/brecha-de-falla",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca de falla sin foliación tectónica o con un desarrollo pobre de ella, constituida en más de un 30% por porfiroclastos, habitualmente angulosos, y fragmentos de roca, embebidos en una matriz de composición similar producida por deformación frágil con reducción del tamaño de grano cristalino y ligeramente recristalizada"
      },
      {
        "@language": "en",
        "@value": "Fault rock without tectonic foliation or with poorly developed foliation, consisting of more than 30% of porphyroclasts, usually angular, and rock fragments, embedded in a matrix of similar composition produced by brittle deformation with crystal grain size reduction and slightly recrystallized"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/breccia-gougeSeries"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/breccia_gouge_series"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "brecha de falla"
      },
      {
        "@language": "en",
        "@value": "fault breccia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arenisca-de-grano-fino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
