    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material fundido viscoso que es expulsado al exterior por un volcán, a elevada temperatura, en el curso de una erupción. al enfriarse da lugar a la formación de rocas efusivas o a escorias volcánicas"
      },
      {
        "@language": "en",
        "@value": "Viscous molten material expelled to the exterior by a volcano at high temperature during an eruption. Upon cooling it gives rise to the formation of effusive rocks or volcanic scoria"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
