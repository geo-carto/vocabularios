  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/escoria-volcanica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Fragmento de lava vesicular y, por tanto, de baja densidad, de superficie irregular porosa, resultado del enfriamiento rápido de una proyección volcánica o de la superficie de una colada de lava"
      },
      {
        "@language": "en",
        "@value": "Fragment of vesicular and therefore low-density lava, with irregular porous surface, resulting from the rapid cooling of a volcanic projectile or the surface of a lava flow"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "escoria volcánica"
      },
      {
        "@language": "en",
        "@value": "volcanic scoria"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
