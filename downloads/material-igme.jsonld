        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material que resulta de la mezcla de agua, arena, grava y cemento o cal, y que, al fraguar, adquiere más resistencia"
      },
      {
        "@language": "en",
        "@value": "Material resulting from mixing water, sand, gravel and cement or lime, which upon setting acquires greater resistance"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/concrete"
