        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "1. Caliza compuesta fundamentalmente por granos carbonáticos de tamaño limo. 2. Limolita constituida mayoritariamente por clastos de carbonatos"
      },
      {
        "@language": "en",
        "@value": "1. Limestone composed fundamentally of silt-size carbonate grains. 2. Siltstone consisting predominantly of carbonate clasts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
