      {
        "@language": "es",
        "@value": "shonkinita"
      },
      {
        "@language": "en",
        "@value": "shonkinite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/syenitoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/syenitoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
