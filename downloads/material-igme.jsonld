      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica oscura, básica, subalcalina o alcalina, compuesta principalmente por plagioclasa, que constituye más del 65% de los feldespatos, piroxeno y, en ocasiones, olivino, pudiendo incluir cantidades menores de cuarzo o feldespatoides"
      },
      {
        "@language": "en",
        "@value": "Dark, basic, subalkaline or alkaline volcanic rock, composed mainly of plagioclase constituting more than 65% of the feldspars, pyroxene and, occasionally, olivine, and possibly including lesser amounts of quartz or feldspathoids"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"
      },
