      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/tilloide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Rocas Sedimentarias y Sedimentos Híbridos"
      },
      {
        "@language": "en",
        "@value": "Collection - Hybrid Sedimentary Rocks And Sediments"
      }
    ]
  },
