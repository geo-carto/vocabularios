        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Bitumen negro, muy viscoso o sólido, raramente en estado libre, pero frecuente en impregnaciones de determinadas rocas sedimentarias o sedimentos"
      },
      {
        "@language": "en",
        "@value": "Black, highly viscous or solid bitumen, rarely in a free state, but frequently as impregnations in certain sedimentary rocks or sediments"
      }
    ],
