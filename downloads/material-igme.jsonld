      {
        "@language": "es",
        "@value": "caliza dolomítica"
      },
      {
        "@language": "en",
        "@value": "dolomitic limestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/impureLimestone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/impure_limestone"
      }
    ],
