      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Materiales Ígneos, que se caracteriza por representar el nivel superior de clasificación que agrupa todos los materiales resultantes del enfriamiento y la solidificación de un magma, tanto volcánicos como plutónicos."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the hierarchical category of Major Material Groups / Igneous Materials, characterized by representing the top-level classification that groups all materials resulting from the cooling and solidification of a magma, both volcanic and plutonic."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
