  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/filita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica de grano fino a medio, caracterizada por una apariencia lustrosa y una esquistosidad bien definida que resulta de la orientación preferente de filosilicatos. generalmente, las filitas son rocas de grado metamórfico bajo"
      },
      {
        "@language": "en",
        "@value": "Fine- to medium-grained metamorphic rock characterized by a lustrous appearance and a well-developed schistosity resulting from the preferred orientation of phyllosilicates. Generally, phyllites are low-grade metamorphic rocks"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/phyllite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phyllite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "filita"
      },
      {
        "@language": "en",
        "@value": "phyllite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
