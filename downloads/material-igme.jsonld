  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/akerita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Microsienita o micromonzonita rica en ortosa y oligoclasa, que puede contener cantidades notables de biotita y clinopiroxeno, generalmente augita egirínica, así como cuarzo en cantidades accesorias"
      },
      {
        "@language": "en",
        "@value": "Microsyenite or micromonzonite rich in orthoclase and oligoclase, which may contain notable amounts of biotite and clinopyroxene, generally aegirine-augite, as well as accessory quartz"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "akerita"
      },
      {
        "@language": "en",
        "@value": "akerite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/syenite"
      },
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/monzonite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/syenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/andesita-basaltica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica intermedia o básica, subalcalina o calcoalcalina, con plagioclasa de composición similar a la de la andesita y con minerales ferromagnesianos característicos de los basaltos"
      },
      {
        "@language": "en",
        "@value": "Intermediate or basic, subalkaline or calc-alkaline volcanic rock, with plagioclase of similar composition to that of andesite and with ferromagnesian minerals characteristic of basalts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "andesita basáltica"
      },
      {
        "@language": "en",
        "@value": "basaltic andesite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/andesite"
      }
    ],
