      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "traquita de feldespato alcalino"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente al grupo de las rocas traquíticas de feldespato alcalino, que puede contener cuarzo, en proporción inferior al 5% de los minerales félsicos. su equivalente plutónico es la sienita de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the group of alkali feldspar trachytic rocks, which may contain quartz in proportions below 5% of the felsic minerals. Its plutonic equivalent is alkali feldspar syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
