  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/pseudotaquilita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca cataclástica de aspecto vítreo, grano extrafino y color negro, originada como consecuencia de la fusión parcial debida al calor generado por el rozamiento de las rocas al deslizarse a lo largo de una superficie de falla. su formación puede deberse también al impacto de un meteorito"
      },
      {
        "@language": "en",
        "@value": "Glassy-appearing, extra-fine-grained, black cataclastic rock, originating as a consequence of partial melting due to the heat generated by friction of rocks sliding along a fault surface. Its formation may also be due to meteorite impact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "pseudotaquilita"
      },
      {
        "@language": "en",
        "@value": "pseudotachylite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
