  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/tefrita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica básica o ultrabásica perteneciente a la familia de las rocas tefríticas, de color grisáceo y textura generalmente porfídica, con fenocristales de plagioclasa que constituyen más del 90% de los feldespatos, clinopiroxeno y feldespatoides, generalmente en una matriz microcristalina, puede contener olivino en proporción inferior al 10% normativo. su equivalente plutónico es la diorita foídica"
      },
      {
        "@language": "en",
        "@value": "Basic or ultrabasic volcanic rock belonging to the tephrite family, greyish and generally porphyritic, with plagioclase phenocrysts constituting more than 90% of the feldspars, clinopyroxene and feldspathoids, generally in a microcrystalline groundmass; may contain olivine in proportions below 10% normative. Its plutonic equivalent is foid diorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/tephrite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/tephrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "tefrita"
      },
      {
        "@language": "en",
        "@value": "tephrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
