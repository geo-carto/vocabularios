    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la subcategoría de Materiales Metamórficos / Materiales de Falla, que se caracteriza por agrupar, dentro de los materiales metamórficos, aquellos materiales formados como resultado de la deformación en una zona de falla."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the subcategory of Metamorphic Materials / Fault Materials, characterized by grouping, within metamorphic materials, those materials formed as a result of deformation in a fault zone."
