    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica perteneciente a la familia de las rocas fonolíticas, en la que el feldespato alcalino constituye menos del 90% de los feldespatos. su equivalente plutónico es la monzosienita foídica"
      },
      {
        "@language": "en",
        "@value": "Volcanic rock belonging to the phonolitic rock family, in which alkali feldspar constitutes less than 90% of the feldspars. Its plutonic equivalent is foid monzosyenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/tephriticPhonolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/tephritic_phonolite"
      }
    ],
