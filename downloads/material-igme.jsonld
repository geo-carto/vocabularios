        "@language": "es",
        "@value": "Roca silícea, generalmente con una porosidad del 50-90%, formada principalmente por espículas de esponjas"
      },
      {
        "@language": "en",
        "@value": "Siliceous rock, generally with 50-90% porosity, formed mainly by sponge spicules"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
