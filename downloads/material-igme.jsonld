    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Vidrio basáltico de color negro y opaco, debido a las inclusiones muy pequeñas de cristales. es el constituyente fundamental de la mayoría de las escorias basálticas"
      },
      {
        "@language": "en",
        "@value": "Black, opaque basaltic glass due to very small crystal inclusions. It is the fundamental constituent of most basaltic scorias"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
