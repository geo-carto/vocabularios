      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-evaporitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Materiales Sedimentarios / Evaporitas"
      },
      {
        "@language": "en",
        "@value": "Collection - Sedimentary Materials / Evaporites"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/toba-de-ceniza-fina",
    "@type": [
