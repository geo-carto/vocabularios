      {
        "@language": "es",
        "@value": "Clase, grupo o textura de las rocas sedimentarias o los sedimentos detríticos constituidos en más del 50% por partículas muy finas, de menos de 0.062 mm"
      },
      {
        "@language": "en",
        "@value": "Class, group or texture of sedimentary rocks or detrital sediments consisting of more than 50% very fine particles, less than 0.062 mm"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
