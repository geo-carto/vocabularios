      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica constituida, en más de un 50%, por cantos redondeados de entre 2 y 4 mm de diámetro, trabados por un cemento o una matriz detrítica fina"
      },
      {
        "@language": "en",
        "@value": "Detrital rock consisting of more than 50% rounded clasts between 2 and 4 mm in diameter, bound by a cement or fine detrital matrix"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "microconglomerado"
      },
      {
        "@language": "en",
        "@value": "microconglomerate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
