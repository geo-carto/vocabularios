  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-detriticos",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Detríticos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos compuestos en más de un 50% por fragmentos de otras rocas y minerales preexistentes."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the subcategory of Sedimentary Materials / Detrital Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments composed of more than 50% fragments from pre-existing rocks and minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/deposito-clastico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-clastico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-clastica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos detríticos"
      },
      {
        "@language": "en",
        "@value": "Collection - Sedimentary Materials / Detrital Sedimentary Rocks And Sediments"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/canto-blando",
