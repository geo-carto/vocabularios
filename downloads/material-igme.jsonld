    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza aloquímica esparítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides superior a 3:1"
      },
      {
        "@language": "en",
        "@value": "Sparitic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio exceeding 3:1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
