  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/traquitoide",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Nombre utilizado en la descripción provisional de rocas volcánicas ácidas o intermedias, alcalinas, similares a la traquita, generalmente leucocráticas, compuestas principalmente por feldespatos, de los que el feldespato alcalino constituye al menos el 35%, en una matriz microcristalina o, más raramente, vítrea, también pueden incluir cantidades menores de biotita, anfíbol y piroxeno, además de cuarzo o feldespatoides en proporción inferior al 20 y al 10%, respectivamente, de los minerales félsicos. su equivalente plutónico es el sienitoide"
      },
      {
        "@language": "en",
        "@value": "Name used in the provisional description of acid or intermediate, alkaline volcanic rocks similar to trachyte, generally leucocratic, composed mainly of feldspars, of which alkali feldspar constitutes at least 35%, in a microcrystalline or, more rarely, glassy groundmass; may also include lesser amounts of biotite, amphibole and pyroxene, as well as quartz or feldspathoids in proportions below 20 and 10%, respectively, of the felsic minerals. Its plutonic equivalent is syenitoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/trachytoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/trachytoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "traquitoide"
      },
      {
        "@language": "en",
        "@value": "trachytoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
