      {
        "@language": "es",
        "@value": "granitoide rico en cuarzo"
      },
      {
        "@language": "en",
        "@value": "quartz-rich granitoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
