  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-metamorfico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material derivado de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales, en estado sólido esencialmente, en respuesta a variaciones físico-químicas, principalmente de presión y temperatura, quedando excluidos los materiales derivados de procesos de meteorización o formación de suelos"
      },
      {
        "@language": "en",
        "@value": "Material derived from a pre-existing rock, through mineralogical, chemical or structural changes, essentially in solid state, in response to physicochemical variations, mainly of pressure and temperature, excluding materials derived from weathering or soil-forming processes"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material metamórfico"
      },
      {
        "@language": "en",
        "@value": "metamorphic material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisRock"
      },
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/faultRelatedMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_rock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/fault_related_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/deposito-evaporitico",
