    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Dolomía en la que se reconocen fantasmas de aloquímicos, de entre los que predominan los bioclastos"
      },
      {
        "@language": "en",
        "@value": "Dolostone in which ghosts of allochems are recognized, among which bioclasts predominate"
      }
    ],
