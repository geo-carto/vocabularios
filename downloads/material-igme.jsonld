      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/quartz_alkali_feldspar_syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cuarzosienita de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar quartz syenite"
      }
    ],
