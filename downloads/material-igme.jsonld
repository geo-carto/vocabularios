  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/antracita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Variedad de carbón dura, negra, con brillo semimetálico y fractura semiconcoidea, que arde con dificultad y quema sin humo. su contenido en carbono es mayor del 90% y el de volátiles, menor del 14%"
      },
      {
        "@language": "en",
        "@value": "Hard, black coal variety with semi-metallic lustre and semi-conchoidal fracture, which burns with difficulty and without smoke. Its carbon content exceeds 90% and the volatile matter content is below 14%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/anthraciteCoal"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/anthracite_coal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "antracita"
      },
      {
        "@language": "en",
        "@value": "anthracite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
