      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Ricos en Materia Orgánica, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos con contenido significativo de materia orgánica."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the subcategory of Sedimentary Materials / Organic-Rich Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments with significant organic matter content."
      }
    ],
