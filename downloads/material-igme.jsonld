      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/lutita-margosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "lutita calcárea"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria detrítica con un contenido conjunto de elementos de tamaño pelita y de carbonato cálcico igual o superior al 90% del total y en la que la relación de elementos de tamaño lutita con respecto al carbonato está comprendida entre el 65 y el 90%"
      },
      {
        "@language": "en",
        "@value": "Detrital sedimentary rock with a combined content of pelite-size elements and calcium carbonate equal to or exceeding 90% of the total, and in which the ratio of mudstone-size elements to carbonate is between 65 and 90%"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "lutita margosa"
      },
      {
        "@language": "en",
        "@value": "marly mudstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/mud"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-metamorfica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca derivada de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales, esencialmente en estado sólido y sin cambiar significativamente la composición química del conjunto de la roca, en respuesta a variaciones físico-químicas, principalmente de presión y temperatura, quedando excluidas las rocas derivadas de procesos de meteorización o formación de suelos"
      },
      {
        "@language": "en",
        "@value": "Rock derived from a pre-existing rock, through mineralogical, chemical or structural changes, essentially in solid state and without significantly changing the overall chemical composition of the rock, in response to physicochemical variations, mainly of pressure and temperature, excluding rocks derived from weathering or soil-forming processes"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca metamórfica"
      },
      {
        "@language": "en",
        "@value": "metamorphic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
