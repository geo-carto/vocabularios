  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/lutita-arenosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica en la que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 10 y el 50% y la relación de elementos de tamaño arcilla a tamaño limo está comprendida entre 1:2 y 2:1"
      },
      {
        "@language": "en",
        "@value": "Detrital rock in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 10 and 50% and the ratio of clay-size to silt-size elements is between 1:2 and 2:1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "lutita arenosa"
      },
      {
        "@language": "en",
        "@value": "sandy mudstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-material-antropico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Material Antrópico, que se caracteriza por representar el nivel superior de clasificación que agrupa todas las acumulaciones de materiales debidas exclusivamente a la acción humana."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the hierarchical category of Major Material Groups / Anthropic Material, characterized by representing the top-level classification that groups all accumulations of materials due exclusively to human action."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-antropico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-antropico-consolidado"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-antropico-no-consolidado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Grandes Grupos de Materiales / Material Antrópico"
      },
      {
        "@language": "en",
        "@value": "Collection - Major Material Groups / Anthropogenic Material"
      }
    ]
  },
  {
