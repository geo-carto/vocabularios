  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/greisen",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca granítica alterada por fluidos pneumatolíticos, compuesta esencialmente por cuarzo y moscovita, a veces con topacio y turmalina. puede estar mineralizada, generalmente por casiterita"
      },
      {
        "@language": "en",
        "@value": "Granitic rock altered by pneumatolytic fluids, composed essentially of quartz and muscovite, sometimes with topaz and tourmaline. It may be mineralized, generally by cassiterite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "greisen"
      },
      {
        "@language": "en",
        "@value": "greisen"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/gneis",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica granuda que presenta estructura gnéisica, estructura definida por la orientación preferente de minerales de grano medio a grueso, que confiere a la roca una foliación grosera, peor definida, más espaciada y más discontinua que la estructura esquistosa, y en la que las bandas suelen ser de mineralogía, tamaño de grano o textura contrastados"
      },
      {
        "@language": "en",
        "@value": "Granular metamorphic rock showing a gneissic structure, defined by the preferred orientation of medium- to coarse-grained minerals, which imparts to the rock a coarse, less well-defined, more widely spaced and more discontinuous foliation than schistose structure, and in which the bands are usually of contrasting mineralogy, grain size or texture"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/gneiss"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/gneiss"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "gneis"
      },
      {
        "@language": "en",
        "@value": "gneiss"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-kalsilitica-melilitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea subsaturada, generalmente máfica o ultramáfica, que contiene más de un 10% de kalsilita roca kalsilítica o melilita roca melilítica"
      },
      {
        "@language": "en",
        "@value": "Undersaturated, generally mafic or ultramafic igneous rock, containing more than 10% kalsilite (kalsilitic rock) or melilite (melilitic rock)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca kalsilítica-melilítica"
      },
      {
        "@language": "en",
        "@value": "kalsilitic-melilitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/sedimento-calcareo",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento carbonatado con un contenido de calcita más aragonito superior al de dolomita"
      },
      {
        "@language": "en",
        "@value": "Calcareous carbonate sediment with a calcite plus aragonite content greater than that of dolomite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento calcáreo"
      },
      {
        "@language": "en",
        "@value": "calcareous sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/marmol",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica formada en más del 50 % por carbonatos calcita, aragonito, dolomita, generalmente de textura granoblástica y estructura masiva, derivada de calizas y dolomías. el mármol puro contiene más del 95% de carbonatos. cuando es impuro 50-95% de carbonatos contiene otros minerales, que pueden ser muy variados anfíbol y clinopiroxeno cálcicos, epidota, grosularia, olivino, talco, clorita, micas, etc.."
      },
      {
        "@language": "en",
        "@value": "Metamorphic rock formed by more than 50% carbonates (calcite, aragonite, dolomite), generally of granoblastic texture and massive structure, derived from limestones and dolomites. Pure marble contains more than 95% carbonates. When impure (50-95% carbonates) it contains other minerals, which may be very varied (calcic amphibole and clinopyroxene, epidote, grossular, olivine, talc, chlorite, micas, etc.)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/marble"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/marble"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "mármol"
      },
      {
        "@language": "en",
        "@value": "marble"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arena-muy-gruesa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Arena en la que predominan los granos de diámetro comprendido entre 1.0 y 2.0 mm"
      },
      {
        "@language": "en",
        "@value": "Sand in which grains with a diameter between 1.0 and 2.0 mm predominate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
