  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/sienita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica cuyo componente principal son los feldespatos, de entre los que el feldespato alcalino constituye entre el 65 y el 90%, con cuarzo en proporción inferior al 5% de los minerales félsicos y cantidades subordinadas de plagioclasa sódica, biotita, piroxeno, anfíbol y, ocasionalmente, fayalita. es el equivalente intrusivo de la traquita"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock whose main component is feldspars, of which alkali feldspar constitutes between 65 and 90%, with quartz in proportions below 5% of the felsic minerals and subordinate amounts of sodic plagioclase, biotite, pyroxene, amphibole and, occasionally, fayalite. It is the intrusive equivalent of trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/syenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sienita"
      },
      {
        "@language": "en",
        "@value": "syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
