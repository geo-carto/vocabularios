      {
        "@language": "es",
        "@value": "traquita alcalina"
      },
      {
        "@language": "en",
        "@value": "alkaline trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparTrachyte"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachyte"
      }
