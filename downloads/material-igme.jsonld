  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/pegmatita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca de composición aproximadamente granítica, grano grueso o muy grueso, formada esencialmente por microclina, albita y cuarzo. como minerales varietales suele tener moscovita, turmalina, biotita y, más raramente, cordierita o granate. los cristales de cuarzo y ortosa aparecen formando intercrecimientos gráficos, con frecuencia perpendiculares a los contactos"
      },
      {
        "@language": "en",
        "@value": "Rock of approximately granitic composition, coarse- or very coarse-grained, formed essentially by microcline, albite and quartz. Muscovite, tourmaline, biotite and, more rarely, cordierite or garnet are common varietal minerals. Quartz and orthoclase crystals form graphic intergrowths, frequently perpendicular to contacts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/pegmatite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pegmatite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "pegmatita"
      },
      {
        "@language": "en",
        "@value": "pegmatite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
