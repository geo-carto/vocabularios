      {
        "@language": "es",
        "@value": "Caliza aloquímica micrítica en la que menos del 25% de los aloquímicos corresponden a intraclastos y más del 25%, a ooides"
      },
      {
        "@language": "en",
        "@value": "Micritic allochemical limestone in which less than 25% of the allochems correspond to intraclasts and more than 25% to ooids"
      }
    ],
