        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/granulite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
