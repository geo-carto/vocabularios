  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/tectita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Pequeño cuerpo vítreo, normalmente de tamaño inferior a 5 cm, de color negruzco, contorno redondeado y forma de gota, lágrima o pera, a veces de superficie no lisa, rico en sílice y con escaso contenido en agua. se supone que se trata de material fundido formado por el impacto de grandes meteoritos sobre la superficie de la tierra y lanzado a centenares de kilómetros de distancia, concentrándose en niveles estratigráficos muy concretos y en amplias extensiones"
      },
      {
        "@language": "en",
        "@value": "Small glassy body, generally smaller than 5 cm, blackish in colour, rounded in outline and droplet-, tear- or pear-shaped, sometimes with a non-smooth surface, rich in silica and with low water content. It is thought to be melted material formed by the impact of large meteorites on the Earth's surface and projected hundreds of kilometres away, concentrated in very specific stratigraphic levels and over large areas"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "tectita"
      },
      {
        "@language": "en",
        "@value": "tektite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/impactGeneratedMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/impact_generated_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
