        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "biohermo, caliza biohérmica, caliza recifal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza formada por organismos constructores de arrecifes, generalmente corales, que permanecen frecuentemente en posición de vida"
      },
      {
        "@language": "en",
        "@value": "Limestone formed by reef-building organisms, generally corals, which frequently remain in life position"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
