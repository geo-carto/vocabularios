  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/petroleo",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material sedimentario constituido por hidrocarburos y formado a partir de la descomposición anaerobia de la materia orgánica. en condiciones normales de presión y temperatura se presenta fundamentalmente líquido petróleo crudo y gaseoso gas natural, aunque a veces, por oxidación, es sólido asfalto"
      },
      {
        "@language": "en",
        "@value": "Sedimentary material consisting of hydrocarbons and formed from the anaerobic decomposition of organic matter. Under normal pressure and temperature conditions it occurs primarily as liquid (crude oil) and gas (natural gas), though it may sometimes, by oxidation, be solid (asphalt)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "petróleo"
      },
      {
        "@language": "en",
        "@value": "petroleum"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSedimentaryMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
