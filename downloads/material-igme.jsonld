      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica mesocrática básica, alcalina, formada esencialmente por plagioclasa y piroxeno, con contenidos menores de olivino. la variedad sódica recibe el nombre de hawaiita y la potásica, de traquibasalto potásico"
      },
      {
        "@language": "en",
        "@value": "Mesocratic, basic, alkaline volcanic rock formed essentially by plagioclase and pyroxene, with minor amounts of olivine. The sodic variety is called hawaiite and the potassic variety, potassic trachybasalt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
