      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas sieníticas, que contiene feldespatoides. es el equivalente intrusivo de la traquita con foides"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of syenitic rocks, containing feldspathoids. It is the intrusive equivalent of foid-bearing trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
