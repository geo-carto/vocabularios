    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico fino, generalmente de tamaño limo o arena fina, formado por la abrasión de un glaciar"
      },
      {
        "@language": "en",
        "@value": "Fine-grained detrital sediment, generally silt or very fine sand size, formed by glacial abrasion"
      }
    ],
