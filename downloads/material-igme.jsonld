  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/vaugnerita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Monzodiorita o monzogabro con altos contenidos en mgo y k2o. también cuarzomonzodiorita o cuarzomonzogabro, aunque existen términos transicionales a monzonita y monzosienita"
      },
      {
        "@language": "en",
        "@value": "Monzodiorite or monzogabbro with high MgO and K2O content. Also quartz monzodiorite or quartz monzogabbro, although there are transitional terms to monzonite and monzosyenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "vaugnerita"
      },
      {
        "@language": "en",
        "@value": "vaugnerite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/monzodioriticRock"
      },
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/monzogabbroicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzodioritic_rock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzogabbroic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/conglomerado-arenoso",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca detrítica constituida en un 30-50% por clastos de más de 2 mm de diámetro y con un contenido de elementos de tamaño arena mayor que el de elementos de tamaño pelita"
      },
      {
        "@language": "en",
        "@value": "Detrital rock consisting of 30-50% clasts with a diameter exceeding 2 mm and with a sand-size element content greater than that of pelite-size elements"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "conglomerado arenoso"
      },
      {
        "@language": "en",
        "@value": "sandy conglomerate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-poligenico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material, con un estado de consolidación no especificado, generado por modificación geológica de materiales preexistentes fuera del ámbito de los procesos ígneos y sedimentarios. incluye los materiales metamórficos y los productos de alteración desarrollados en la superficie terrestre"
      },
      {
        "@language": "en",
        "@value": "Material, with an unspecified state of consolidation, generated by geological modification of pre-existing materials outside the scope of igneous and sedimentary processes. Includes metamorphic materials and alteration products developed at the Earth's surface"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material poligénico"
      },
      {
        "@language": "en",
        "@value": "polygenetic material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/arena-pelitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico en el que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y de ellos, el contenido de granos de arena está comprendido entre el 50 y el 90% y la relación de arcilla a limo está comprendida entre 2:1 y 1:2"
      },
      {
        "@language": "en",
        "@value": "Detrital sediment in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 50 and 90% and the clay-to-silt ratio is between 2:1 and 1:2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arena pelítica"
      },
      {
        "@language": "en",
        "@value": "pelitic sand"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sand"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/sand"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/metabasita",
