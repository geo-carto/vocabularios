  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-alcalina",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea con una elevada concentración de álcalis na2o, k2o que no puede ser acomodada exclusivamente en los feldespatos. este exceso hace que se formen feldespatoides, piroxenos y/o anfíboles sódicos, así como otras fases ricas en estos elementos. esta definición es algo estricta y es frecuente el uso del término “alcalino/a” para rocas que simplemente tienen elevados contenidos de na2o y k2o para determinados contenidos de sio2"
      },
      {
        "@language": "en",
        "@value": "Igneous rock with a high concentration of alkalis Na2O, K2O that cannot be accommodated exclusively in the feldspars. This excess causes the formation of feldspathoids, pyroxenes and/or sodic amphiboles, as well as other phases rich in these elements. This definition is somewhat strict and it is common to use the term 'alkaline' for rocks that simply have high Na2O and K2O contents for given SiO2 contents"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca alcalina"
      },
      {
        "@language": "en",
        "@value": "alkaline rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
