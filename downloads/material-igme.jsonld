      },
      {
        "@language": "en",
        "@value": "Sand in which between 75 and 95% of the grains are quartz and the feldspar content is greater than that of rock fragments"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
