      {
        "@language": "es",
        "@value": "Grauvaca en la que la proporción de cuarzo es inferior al 95% de los granos y el contenido de fragmentos de otras rocas es mayor que el de feldespatos"
      },
      {
        "@language": "en",
        "@value": "Greywacke in which the proportion of quartz is below 95% of the grains and the rock fragment content is greater than that of feldspars"
      }
    ],
