      {
        "@language": "es",
        "@value": "protomilonita"
      },
      {
        "@language": "en",
        "@value": "protomylonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/grava-arenosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento detrítico poco seleccionado, constituido en un 30-50% por clastos de más de 2 mm de diámetro y que posee un contenido de elementos de tamaño arena mayor que el de elementos de tamaño pelita"
      },
      {
        "@language": "en",
        "@value": "Poorly sorted detrital sediment consisting of 30-50% clasts with a diameter exceeding 2 mm and with a sand-size element content greater than that of pelite-size elements"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "grava arenosa"
      },
      {
        "@language": "en",
        "@value": "sandy gravel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/gravel"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/gravel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/kernita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca formada por el mineral del mismo nombre, de fórmula na2b4o7.4h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema monoclínico en forma de masas espáticas. es incoloro o blanco, tiene brillo vítreo y varía de transparente a translúcido"
      },
      {
        "@language": "en",
        "@value": "Rock formed by the mineral of the same name, with the formula Na2B4O7·4H2O, belonging to the class of borates, crystallizing in the monoclinic system in the form of sparitic masses. It is colourless or white, with vitreous lustre and varying from transparent to translucent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "kernita"
      },
      {
        "@language": "en",
        "@value": "kernite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/evaporite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/sienita-de-feldespato-alcalino-con-foides",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica perteneciente al grupo de las rocas sieníticas de feldespato alcalino, que contiene feldespatoides. es el equivalente intrusivo de la traquita de feldespato alcalino con foides"
      },
      {
        "@language": "en",
        "@value": "Plutonic rock belonging to the group of alkali feldspar syenitic rocks, containing feldspathoids. It is the intrusive equivalent of alkali feldspar foid-bearing trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAlkaliFeldsparSyenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_alkali_feldspar_syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sienita de feldespato alcalino con foides"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar foid-bearing syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/brecha-de-impacto",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Brecha que contiene fragmentos que muestran evidencias inequívocas de haber sufrido un metamorfismo de choque, típicamente se produce alrededor, dentro y debajo de un cráter de impacto"
      },
      {
        "@language": "en",
        "@value": "Breccia containing fragments that show unequivocal evidence of having undergone shock metamorphism; typically produced around, within and below an impact crater"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "brecha de impacto"
      },
      {
