  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-traquitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica leucocrática, intermedia o ácida, alcalina, perteneciente al grupo de los traquitoides, compuesta principalmente por feldespatos, de entre los que el feldespato alcalino constituye entre el 65 y el 90%, en una matriz microcristalina, frecuentemente con textura traquítica. su equivalente plutónico es la roca sienítica"
      },
      {
        "@language": "en",
        "@value": "Leucocratic, intermediate or acid, alkaline volcanic rock belonging to the group of trachytoids, composed mainly of feldspars, of which alkali feldspar constitutes between 65 and 90%, in a microcrystalline groundmass, frequently with trachytic texture. Its plutonic equivalent is syenitic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/trachyticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/trachytic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca traquítica"
      },
      {
        "@language": "en",
        "@value": "trachytic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-ferruginosos",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Collection"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Ferruginosos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos compuestos en más de un 50% por minerales ferruginosos."
      },
      {
        "@language": "en",
        "@value": "Collection of materials belonging to the subcategory of Sedimentary Materials / Ferruginous Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments composed of more than 50% ferruginous minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#member": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/deposito-ferruginoso"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-ferruginoso"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-ferruginosa"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Ferruginosos"
      },
      {
        "@language": "en",
        "@value": "Collection - Sedimentary Materials / Ferruginous Sedimentary Rocks And Sediments"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/gabro",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
