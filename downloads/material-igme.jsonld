  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-metasomatica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca derivada de un proceso metamórfico por el que se produce un cambio importante en la composición química de la roca sujeta a metamorfismo, debido a interacción con fluidos hidrotermales o magmas"
      },
      {
        "@language": "en",
        "@value": "Rock derived from a metamorphic process in which an important change in the chemical composition of the rock subject to metamorphism occurs, due to interaction with hydrothermal fluids or magmas"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock"
