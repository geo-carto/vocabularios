  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-subvolcanica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "roca hipoabisal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca originada por la solidificación de un magma silicatado en el interior de la corteza terrestre a escasa profundidad no superior a 3 km. se encuentra asociada a las rocas plutónicas, formando salientes o apófisis, o bien a las eruptivas, en la parte profunda de complejos volcánicos, y presenta diferencias texturales, más que de composición, con ambas"
      },
      {
        "@language": "en",
        "@value": "Rock formed by the solidification of a silicate magma in the interior of the Earth's crust at shallow depth, not exceeding 3 km. It is associated with plutonic rocks, forming apophyses or stocks, or with extrusive rocks in the deeper parts of volcanic complexes, and differs from both primarily in texture rather than composition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca subvolcánica"
      },
      {
        "@language": "en",
        "@value": "subvolcanic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/diatexita",
    "@type": [
