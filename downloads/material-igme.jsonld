  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/lamprofido",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Grupo variado de rocas subvolcánicas de composición básica o ultrabásica, más raramente intermedia, que se caracterizan por una textura marcadamente porfídica. los fenocristales son exclusivamente de minerales máficos, generalmente anfíbol, biotita o flogopita y, ocasionalmente, piroxeno, en una matriz meso a melanocrática en la que están incluidos los feldespatos. suelen aparecer en diques y cuerpos intrusivos menores, asociados a rocas intrusivas"
      },
      {
        "@language": "en",
        "@value": "Varied group of subvolcanic rocks of basic or ultrabasic, more rarely intermediate composition, characterized by a markedly porphyritic texture. The phenocrysts are exclusively of mafic minerals, generally amphibole, biotite or phlogopite and, occasionally, pyroxene, in a meso- to melanocratic groundmass containing the feldspars. They commonly occur as dykes and minor intrusive bodies associated with intrusive rocks"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "lamprófido"
      },
      {
        "@language": "en",
        "@value": "lamprophyre"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
