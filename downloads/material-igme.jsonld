      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca arcillosa plástica, de color claro, compuesta principalmente por montmorillonita silicato alumínico hidratado y minerales del grupo de las esmectitas, generada normalmente por alteración de cenizas volcánicas"
      },
      {
        "@language": "en",
        "@value": "Plastic claystone, light-coloured, composed mainly of montmorillonite (hydrated aluminium silicate) and minerals of the smectite group, normally generated by alteration of volcanic ashes"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
