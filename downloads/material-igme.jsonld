    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca komatiítica con un contenido de tio2 superior al 1%. si el contenido en tio2 es menor del 1% la roca se llama komatiíta"
      },
      {
        "@language": "en",
        "@value": "Komatiitic rock with a TiO2 content exceeding 1%. If the TiO2 content is below 1%, the rock is called komatiite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
