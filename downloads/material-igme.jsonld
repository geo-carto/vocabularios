      {
        "@language": "es",
        "@value": "Roca ígnea producida por actividad volcánica, normalmente de grano muy fino o vítrea. con frecuencia puede contener fragmentos de otras rocas, así como fenocristales"
      },
      {
        "@language": "en",
        "@value": "Igneous rock produced by volcanic activity, normally very fine-grained or glassy. It may frequently contain fragments of other rocks as well as phenocrysts"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca volcánica"
      },
      {
        "@language": "en",
        "@value": "volcanic rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/fineGrainedIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/fine_grained_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
