  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/roca-dioritica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Dioritoide en el que la plagioclasa, predominantemente cálcica, constituye más del 90% de los feldespatos"
      },
      {
        "@language": "en",
        "@value": "Dioritoid in which plagioclase, predominantly calcic, constitutes more than 90% of the feldspars"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/dioriticRock"
