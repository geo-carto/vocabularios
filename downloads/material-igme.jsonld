  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/turbidita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento o roca sedimentaria formados por corrientes de turbidez. se trata de arenas o areniscas que presentan secuencias granodecrecientes con una ordenación de estructuras sedimentarias internas muy singular, denominada secuencia de bouma"
      },
      {
        "@language": "en",
        "@value": "Sediment or sedimentary rock formed by turbidity currents. They consist of sands or sandstones with graded bedding sequences and a very distinctive arrangement of internal sedimentary structures known as the Bouma sequence"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "turbidita"
      },
      {
        "@language": "en",
        "@value": "turbidite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"
      },
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/sand"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/sand"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
