  {
    "@id": "https://geo-carto.github.io/vocabularios/material-igme/silvina",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "silvita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "roca formada por el mineral del mismo nombre, de fórmula kcl, perteneciente a la clase de los cloruros, que cristaliza en el sistema cúbico, apareciendo en masas granudas o espáticas. es incoloro a blanco, tiene brillo vítreo y varía de transparente a translúcido"
      },
      {
        "@language": "en",
        "@value": "Rock formed by the mineral of the same name, with the formula KCl, belonging to the class of chlorides, crystallizing in the cubic system, occurring in granular or sparitic masses. It is colourless to white, with vitreous lustre and varying from transparent to translucent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/material-igme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "silvina"
      },
      {
        "@language": "en",
        "@value": "sylvine"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/evaporite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
