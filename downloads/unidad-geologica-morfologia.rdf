  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/tableta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">tableta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tablet</skos:prefLabel>
    <skos:definition xml:lang="es">Cilindro poligonal con una altura menor que la longitud o el ancho, disco con bordes que separan los lados en múltiples segmentos</skos:definition>
    <skos:definition xml:lang="en">Polygonal cylinder with height less than length or width, disc with edges separating side into multiple segments</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro-poligonal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/tablet"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-elipsoidal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lámina elipsoidal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sheet ellipsoid</skos:prefLabel>
    <skos:definition xml:lang="es">Elipsoide con un eje mucho más pequeño que los otros dos. H es del orden de 0,001 de L o W</skos:definition>
    <skos:definition xml:lang="en">Ellipsoid with one axis much smaller than others H on order of .001 of L or W</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/sheet_ellipsoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lámina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sheet</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo que es muy delgado en relación con la extensión lateral, tan delgado que se considera que consta de dos superficies limítrofes unidas en un borde. La relación de aspecto es L = W &gt;&gt;&gt; H. La geometría del borde que une las superficies no se especifica en la definición. Si la geometría del borde entra en juego en la definición, se convierte en cinta, disco o tableta (?). Incluye unidades geológicas en forma de dique, veta, sill y capa</skos:definition>
    <skos:definition xml:lang="en">Body that is very thin relative to lateral extent, so thin that is considered to consist of two bounding surfaces joined at an edge. Aspect ratio is L=W&gt;&gt;&gt;H. The geometry of the edge joining the surfaces is not specified in the definition. If the geometry of the edge comes into play in the definition, becomes ribbon, disc or tablet(?). Includes dike, vein, sill and bed-shaped geologic units</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-curvada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-conica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-domica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-planar"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-sigmoidal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/sheet"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/disco">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">disco</skos:prefLabel>
    <skos:prefLabel xml:lang="en">disc</skos:prefLabel>
    <skos:definition xml:lang="es">Cilindro con una altura menor que diámetro. L = W&gt; H, los bordes separan el lado de la parte superior y la inferior. Evoluciona a elipsoide a medida que los bordes pierden definición</skos:definition>
    <skos:definition xml:lang="en">Cylinder with height less than diameter. L=W&gt;H, edges separates side from top and bottom. Grades to oblate ellipsoid as edges lose definition</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/disc"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cuerpo tridimensional</skos:prefLabel>
    <skos:prefLabel xml:lang="en">three dimensional body</skos:prefLabel>
    <skos:definition xml:lang="es">Cualquier cuerpo tridimensional</skos:definition>
    <skos:definition xml:lang="en">Any three dimensional body</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/gota"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/segmento-de-cono"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/anillo-discoidal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lenticular"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/semiesfera"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/seccion-longitudinal-de-un-cilindro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/prisma"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/ribbon"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lagrima"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuna"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/three_dimensional_body"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/morfologia-arqueada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">morfología arqueada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">arch morphology</skos:prefLabel>
    <skos:definition xml:lang="es">Un cuerpo alargado elevado, morfológicamente equivalente a un canal invertido</skos:definition>
    <skos:definition xml:lang="en">A raised elongate body, morphologically equivalent to upside down channel</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/arch_morphology"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/rod">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">rod</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rod</skos:prefLabel>
    <skos:definition xml:lang="es">Cilindro de eje muy largo, generalmente de sección circular o elíptica (figura generadora). H &gt;&gt;&gt; W = L. El eje largo puede estar en cualquier orientación y puede ser curvo</skos:definition>
    <skos:definition xml:lang="en">Cylinder with very long axis, generally circular or elliptical cross section (generating figure). H&gt;&gt;&gt;W=L. Long axis may be in any orientation, and may be curved</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/rod"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/almohadilla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">almohadilla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pillow ellipsoid</skos:prefLabel>
    <skos:definition xml:lang="es">Elipsoide con H del orden de 0,1 de L o W</skos:definition>
    <skos:definition xml:lang="en">Ellipsoid with H on order of 0.1 of L or W</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/pillow_ellipsoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-eliptico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">perfil elíptico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">elliptical profile</skos:prefLabel>
    <skos:definition xml:lang="es">El perfil se aproxima a una elipse,  siendo la relación entre el eje largo y el eje corto mayor que 1.4</skos:definition>
    <skos:definition xml:lang="en">Profile approximates an ellipse, ratio of long axis to short axis is greater than 1.4</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-planar"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/elliptical_profile"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-irregular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">perfil irregular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">irregular profile</skos:prefLabel>
    <skos:definition xml:lang="es">El perfil no se ajusta a ninguna de las geometrías regulares asociadas con otras categorías en el vocabulario</skos:definition>
    <skos:definition xml:lang="en">Profile does not conform to any of the regular geometries associated with other categories in the vocabulary</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-planar"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/irregular_profile"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/boudin">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">boudin</skos:prefLabel>
    <skos:prefLabel xml:lang="en">boudin shape</skos:prefLabel>
    <skos:definition xml:lang="es">Capa o lecho de roca deformada en segmentos en forma de salchicha (boudins), separados o unidos por conexiones pinzadas. La morfología generalmente se define en una vista de perfil, la tercera dimensión no se denota.  El uso del término también implica que el cuerpo no está aislado, sino que está relacionado con un cuerpo original alargado en alguna dimensión que se ha estirado y separado en cuerpos separados</skos:definition>
    <skos:definition xml:lang="en">Layer or bed of rock deformed into sausage-shaped segments (boudins), either separated or joined by pinched connections. Morphology generally defined in a profile view, third dimension is not denoted, use of term also implies that the body is not isolated, but is related to an original body elongate on some dimension that has been stretched and separated into separate bodies</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/boudin_shape"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/dique">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">dique</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dike</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo rocoso intrusivo generalmente en forma de lámina que atraviesa la estratificación o la foliación de la roca encajante o intruye en una roca masiva</skos:definition>
    <skos:definition xml:lang="en">A generally sheet-like intrusive rock body that cuts across bedding or foliation in the host rock, or intrudes massive host rock</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/dike"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lopolito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lopolito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lopolith</skos:prefLabel>
    <skos:definition xml:lang="es">Una intrusión ígnea grande, concordante, típicamente estratificada, cuyo muro es convexo hacia abajo y cuyo techo puede ser convexo hacia abajo o plano</skos:definition>
    <skos:definition xml:lang="en">A large, concordant, typically layered igneous intrusion whose floor is convex-down and whose roof may be convex-down or flat</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/lopolith"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-planar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">perfil planar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">planar profile</skos:prefLabel>
    <skos:definition xml:lang="es">Forma definida por la intersección del cuerpo con alguna superficie, generalmente una sección transversal o una vista de mapa</skos:definition>
    <skos:definition xml:lang="en">Shape is defined by intersection of body with some surface, generally either a cross section or map view</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-eliptico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-isometrico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-irregular"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-lenticular"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-poligonal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/planar_profile"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/capa-de-forma-tabular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">capa de forma tabular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">layer shape</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo con geometría de carácter generalmente delgada en relación con su extensión lateral (del orden de 1: 100). Si la extensión es menor se considera una lente. Se aplica a un cuerpo no intrusivo, un cuerpo intrusivo equivalente sería  un dique (o sill). Indica que el cuerpo forma parte de  una secuencia de cuerpos similares en forma de láminas entre otros cuerpos rocosos</skos:definition>
    <skos:definition xml:lang="en">Body geometry characterized by generally thin character relative to the lateral extent of the body (on order of 1:100). Thin bodies of lesser extent are lenses. Connotes a non-intrusive body, equivalent intrusive body would be dike (or sill). Denotes that body is in a sequence of similar sheet-like bodies between other rock bodies</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/layer_shape"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lagrima">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lágrima</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tear drop</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo delimitado por un hemiesferioide en un lado y un cono en el otro, con simetría circular en torno al eje del cono</skos:definition>
    <skos:definition xml:lang="en">Body bounded by hemispheroid on one side, cone on other, with circular symmetry around cone axis</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/tear_drop"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuenca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cuenca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basin shape</skos:prefLabel>
    <skos:definition xml:lang="es">Se aplica a una geometría  de disco convexo hacia abajo, pero el término generalmente connota una forma de escala kilómetrica. En vista de mapa puede ser circular, elíptica o irregular, y un rasgo característico es el engrosamiento desde los bordes hacia el centro. Normalmente se utiliza para describir un cuerpo de roca sedimentaria depositado en un área deprimida de la corteza terrestre, lo que implica de que la parte superior es (o fue) una superficie de depósito</skos:definition>
    <skos:definition xml:lang="en">Geometric analog is convex down discoid, term generally connotes a kilometer-scale feature. Map view may be circular, elliptical, or irregular, characteristic feature is thickening from the edges towards the center. Typically used to describe a body of sedimentary rock deposited in a low area in the Earth's crust, in which case there is an implication that the top is (or was) a surface of deposition</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/basin_shape"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/vena-sigmoidal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">vena sigmoidal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sigmoidal vein</skos:prefLabel>
    <skos:definition xml:lang="es">Vena curvada con forma de S en la sección</skos:definition>
    <skos:definition xml:lang="en">Vein curved so as to resemble the letter S in section</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/vena"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/sigmoidal_vein"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/prisma">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">prisma</skos:prefLabel>
    <skos:prefLabel xml:lang="en">prism</skos:prefLabel>
    <skos:definition xml:lang="es">Un poliedro compuesto por dos bases poligonales de n lados con la misma orientación espacial y otras n caras (necesariamente todos paralelogramos) que unen los lados correspondientes entre las bases. Todas las secciones transversales paralelas a las caras de la base son congruentes con las bases. Los prismas se nombran por su base, por lo que un prisma con una base pentagonal se llama prisma pentagonal</skos:definition>
    <skos:definition xml:lang="en">A polyhedron with an n-sided polygonal base, another congruent parallel base (with the same rotational orientation), and n other faces (necessarily all parallelograms) joining corresponding sides of the two bases. All cross-sections parallel to the base faces are congruent to the bases. Prisms are named for their base, so a prism with a pentagonal base is called a pentagonal prism</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/prisma-tabular"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/prism"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cono">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cono</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cone shape</skos:prefLabel>
    <skos:definition xml:lang="es">Lenticular con un lado plano y simetría circular en el eje. Los conos geológicos típicamente tienen una altura muy inferior al diámetro</skos:definition>
    <skos:definition xml:lang="en">Discus with one planar side, and circular symmetry on axis, geologic cones typically have height &lt;(&lt;) diameter</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lenticular"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/cone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuna">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cuña</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wedge</skos:prefLabel>
    <skos:definition xml:lang="es">Una cuña es un poliedro definido por dos triángulos y tres caras trapezoidales. Dos de estas caras se articulan en un ángulo diedro muy agudo</skos:definition>
    <skos:definition xml:lang="en">A wedge is a polyhedron defined by two triangles and three trapezoid faces. A wedge has five faces, nine edges, and six vertices. A wedge is a subclass of the prismatoids with the base and opposite ridge in two parallel planes</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/wedge"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-cuadrado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">perfil cuadrado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">square profile</skos:prefLabel>
    <skos:definition xml:lang="es">perfil poligonal que se aproxima a un cuadrado</skos:definition>
    <skos:definition xml:lang="en">polygonal profile that approximates a square</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-poligonal"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro-poligonal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/square_profile"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/clindro-circular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">clindro circular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">circular cylinder</skos:prefLabel>
    <skos:definition xml:lang="es">Cilindro elíptico que tiene simetría circular sobre el eje largo. Las superficies laterales distintas no están definidas. La sección transversal es circular</skos:definition>
    <skos:definition xml:lang="en">Elliptical cylinder that has circular symmetry about long axis, distinct side surfaces are not defined. Cross section is circular</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro-eliptico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/circular_cylinder"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/seccion-longitudinal-de-un-cilindro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">sección longitudinal de un cilindro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">longitudinal section of cylinder</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo que es la sección de un cilindro circular o elíptico formado por el corte del cilindro a lo largo de una superficie aproximadamente paralela a su eje mayor. L &gt;&gt; W&gt; H</skos:definition>
    <skos:definition xml:lang="en">Body that is section of a circular or elliptical cylinder formed by a splitting the cylinder along a surface approximately parallel to its long axis. L&gt;&gt;W&gt;H</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/longitudinal_section_of_cylinder"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lacolito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lacolito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">laccolith</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo ígneo tabular o lenticular cuyas dimensiones largas son paralelas a las capas de la roca encajante y que presenta un techo convexo y un muro plano conocido o supuesto</skos:definition>
    <skos:definition xml:lang="en">A tabular or lenticular igneous body whose long dimensions parallel layering in the host rock, and which as a convex-up roof and a known or assumed flat floor</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/laccolith"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/esferoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">esferoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spheroid</skos:prefLabel>
    <skos:definition xml:lang="es">Elipsoide con dimensiones L, W y H aproximadamente iguales</skos:definition>
    <skos:definition xml:lang="en">Ellipsoid with L, W, and H dimensions all approximately equal</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/spheroid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-poligonal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">perfil poligonal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polygonal profile</skos:prefLabel>
    <skos:definition xml:lang="es">Perfil para el que la relación entre la longitud de la cuerda más larga y la cuerda más corta es superior a 1,4. Perfil y límite que se puede dividir en distintos lados rectos separados por esquinas de curvatura más alta</skos:definition>
    <skos:definition xml:lang="en">Profile for which the ratio of length of longest chord to shortest chord is greater than 1.4.profile and a boundary that can be divided into distinct straight sides separated by higher curvature corners</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-planar"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/polygonal_profile"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-cuadrado"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-isometrico-poligonal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">perfil isometrico poligonal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">equant polygonal profile</skos:prefLabel>
    <skos:definition xml:lang="es">Perfil equidimensional con límites que permiten dividirlo en distintos lados rectos separados por esquinas de curvatura más alta</skos:definition>
    <skos:definition xml:lang="en">Aquant profile with boundary that can be divided into distinct straight sides separated by higher curvature corners</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-isometrico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/equant_polygonal_profile"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-isometrico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">perfil isometrico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">equant profile</skos:prefLabel>
    <skos:definition xml:lang="es">Perfil para el que la relación entre la longitud del lado más largo y del más corto es menor que 1.4</skos:definition>
    <skos:definition xml:lang="en">Profile for which the ratio of length of longest chord to shortest chord is less than 1.4</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-planar"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-circular"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-isometrico-poligonal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/equant_profile"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/capsula">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cápsula</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pod</skos:prefLabel>
    <skos:definition xml:lang="es">Una pequeña intrusión de forma alargada o lenticular.</skos:definition>
    <skos:definition xml:lang="en">A small intrusion of elongate or lenticular form</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/pod"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/gota">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">gota</skos:prefLabel>
    <skos:prefLabel xml:lang="en">blob</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo con superficie lisa, aproximadamente equidimensional con protuberancias irregulares, sin ejes de simetría ni bordes que puedan delimitar lados</skos:definition>
    <skos:definition xml:lang="en">Body with smooth surface, broadly equant shape, irregular protuberances, no symmetry axes, and a boundary that can not be separated into sides</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/blob"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/domo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">domo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dome</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo discoidal con márgenes de gran pendiente, por ejemplo acumulaciones de lava de alta viscosidad sobre y en torno a un respiradero volcánico. Una estructura en la que la parte superior del cuerpo se hunde suavemente en todas las direcciones, p. Ej. domo de sal, domo de extrusión</skos:definition>
    <skos:definition xml:lang="en">Steep-sided disk-like body, for example and accumulation of high viscosity lava above and around a volcanic vent. A structure in which the top of the body dips gently away in all directions e.g. salt dome, extrusion dome</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/dome"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/sill">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">sill</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sill form</skos:prefLabel>
    <skos:definition xml:lang="es">Un cuerpo ígneo intrusivo tabular con la dimensión mayor paralela a la estratificación o  foliación de la roca encajante sedimentaria o metamórfica</skos:definition>
    <skos:definition xml:lang="en">A tabular intrusive igneous body with long dimensions parallel to bedding or foliation of sedimentary or metamorphic host rock</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/sill_form"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/segmento-de-cono">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">segmento de cono</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cone segment</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo que es la sección de un cono formado al partir el cono a lo largo de una superficie paralela su eje, que intersecta aproximadamente a lo largo del eje</skos:definition>
    <skos:definition xml:lang="en">Body that is section of a cone formed by splitting the cone along a surface parallel to the cone axis, that interesect approximately along the axis</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/cone_segment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-curvada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lámina curvada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">arcuate sheet</skos:prefLabel>
    <skos:definition xml:lang="es">Lámina en la que o la longitud o el ancho forma un arco curvo</skos:definition>
    <skos:definition xml:lang="en">Sheet in which one of L or W is a curved arc</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/arcuate_sheet"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide-muy-alargado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">elipsoide muy alargado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dart ellipsoid</skos:prefLabel>
    <skos:definition xml:lang="es">Elipsoide de longitud más de 50 veces su anchura o altura</skos:definition>
    <skos:definition xml:lang="en">Ellipsoid with L more than 50 times W or H</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/dart_ellipsoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/vena-planar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">vena planar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">planar vein</skos:prefLabel>
    <skos:definition xml:lang="es">Vena con una longitud y un ancho significativamente mayores que su espesor, que le dan una forma tabular</skos:definition>
    <skos:definition xml:lang="en">Vein with length and width significantly greater than its thickness, giving the vein a tabular form</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/vena"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/planar_vein"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide-achatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">elipsoide achatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pancake ellipsoid</skos:prefLabel>
    <skos:definition xml:lang="es">Elipsoide con H del orden de 0,01 de L o W</skos:definition>
    <skos:definition xml:lang="en">Ellipsoid with H on order of .01 of L or W</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/pancake_ellipsoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/canaliforme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">canaliforme</skos:prefLabel>
    <skos:prefLabel xml:lang="en">channel shape</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo lenticular muy alargado o en forma de cinta con una superficie inferior convexa hacia abajo, cerca de la superficie superior plana. La morfología es equivalente al arco invertido</skos:definition>
    <skos:definition xml:lang="en">Strongly elongate lens or ribbon with a convex downward lower surface, near planar upper surface. Morphology is equivalent to upside down arch</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/channel_shape"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cilindro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cylinder</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo definido por la traslación de una figura plana generadora con una sección transversal aproximadamente igual (círculo, elipsoide, polígono) a lo largo de una línea axial recta. H&gt; = W = L. El eje es la dirección perpendicular a la figura del plano de generación, que forma superficies límitantes superior e inferior paralelas</skos:definition>
    <skos:definition xml:lang="en">Body defined by translation of a generating plane figure with approximately equant cross section (circle, ellipsoid, polygon) along a straight axial line. H&gt;=W=L. Axis is direction normal to generating plane figure, which forms parallel top and bottom bounding surface</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/disco"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro-eliptico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro-poligonal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/rod"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/cylinder"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/prisma-tabular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">prisma tabular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tabular prism</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo definido por pares de superficies paralelas, aproximadamente planas, separadas por bordes definibles. Grada al elipsoide cuando las esquinas pierden definición, al bloque cuando las dimensiones axiales se acercan a 1 y al cilindro poligonal cuando L se acerca a W. L &gt;&gt; W&gt; H. H está en dirección vertical, L es horizontal</skos:definition>
    <skos:definition xml:lang="en">Body defined by pairs of parallel, approximately planar surfaces separated by definable edges. Grades to ellipsoid as edges lose definition, to block as axial ratios approach 1, to polygonal cylinder as L approaches W. L&gt;&gt;W&gt;H. H is in vertical direction, L is horizontal</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/prisma"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/tabular_prism"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lens</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo delimitado por superficies convergentes (al menos una de las cuales es curva), grueso en su parte central y que adelgaza hacia los bordes, asemejándose a a una lente convexa</skos:definition>
    <skos:definition xml:lang="en">A body bounded by converging surfaces (at least one of which is curved), thick in the middle and thinning out toward the edges, resembling a convex lens</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/lens"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-planar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lámina planar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">planar sheet</skos:prefLabel>
    <skos:definition xml:lang="es">Lámina en la que los ejes L y W son líneas rectas</skos:definition>
    <skos:definition xml:lang="en">Sheet in which L and W axes are straight lines</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/planar_sheet"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/dique-anular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">dique anular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ring dike</skos:prefLabel>
    <skos:definition xml:lang="es">Un dique de morfología arqueada o subcircular, generalmente asociado con un centro volcánico</skos:definition>
    <skos:definition xml:lang="en">An arcuate or subcircular dyke, generally associated with a volcanic centre</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/ring_dyke"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lente-alargada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lente alargada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">elongate discus</skos:prefLabel>
    <skos:definition xml:lang="es">Disco en el que el perfil definido por el borde delimitador es más largo en una dirección que en otra. L&gt; W &gt;&gt; H</skos:definition>
    <skos:definition xml:lang="en">Discus for which the profile defined by the bounding edge is longer in one direction than other. L&gt;W&gt;&gt;H</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lenticular"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/elongate_discus"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro-eliptico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cilindro elíptico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">elliptical cylinder</skos:prefLabel>
    <skos:definition xml:lang="es">Cilindro que tiene una sección transversal elíptica. No presenta bordes</skos:definition>
    <skos:definition xml:lang="en">Cylinder that has elliptical cross section, distinct side surfaces are not defined</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/clindro-circular"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/elliptical_cylinder"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/semiesfera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">semiesfera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hemispheroid</skos:prefLabel>
    <skos:definition xml:lang="es">Sección de un esferoide formada al eliminar todo el volumen del lado de una superficie que intersecta con el esferoide. Evoluciona a cono si la superficie generadora (la línea que rota sobre el eje para generar el volumen por encima del límite plano inferior) es recta</skos:definition>
    <skos:definition xml:lang="en">Section of a spheroid formed by removing everything on the smaller volume side of a surface that intersects the spheroid. Grades to cone as suface generator (line rotated about axis to generate volume above lower planar boundary) becomes straight</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/hemispheroid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Morfología de cuerpo geológico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Body morphology</skos:prefLabel>
    <dcterms:title xml:lang="es">Morfología de cuerpo geológico</dcterms:title>
    <dcterms:title xml:lang="en">Body morphology</dcterms:title>
    <skos:definition xml:lang="es">Términos que describe la geometría o forma de una unidad geológica. Ejemplos: dique, cono, abanico, lámina, etc.</skos:definition>
    <skos:definition xml:lang="en">The bodyMorphology property provides a term from a controlled vocabulary describing the geometry or form of a GeologicUnit. Examples include: dike (dyke), cone, fan, sheet, etc.</skos:definition>
    <dcterms:description xml:lang="es">Términos que describe la geometría o forma de una unidad geológica. Ejemplos: dique, cono, abanico, lámina, etc.</dcterms:description>
    <dcterms:description xml:lang="en">The bodyMorphology property provides a term from a controlled vocabulary describing the geometry or form of a GeologicUnit. Examples include: dike (dyke), cone, fan, sheet, etc.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos propios definidos por el IGME</dcterms:provenance>
    <dcterms:creator>https://www.igme.es</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Morfología de cuerpo geológico.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-planar"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-rocoso-de-geometria-no-especificada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cuerpo rocoso de geometría no especificada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rock body geometry not specified</skos:prefLabel>
    <skos:definition xml:lang="es">No se especifica la geometría del cuerpo rocoso. De uso en descripciones normativas donde se permite cualquier morfología</skos:definition>
    <skos:definition xml:lang="en">Rock body geometry is not specified. Use in normative descriptions where any morphology is allowed</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/rock_body_geometry_not_specified"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/vena">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">vena</skos:prefLabel>
    <skos:prefLabel xml:lang="en">vein-shape</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo mineral epigenético de forma tabular o de lámina que constituye un relleno de una falla o fractura</skos:definition>
    <skos:definition xml:lang="en">A tabular or sheetlike epigenetic mineral filling of a fault or fracture</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/vena-planar"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/vena-sigmoidal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/vein"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro-poligonal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cilindro poligonal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polygonal cylinder</skos:prefLabel>
    <skos:definition xml:lang="es">Cilindro en el que los bordes que delimitan las superficies laterales son paralelos o subparalelos al eje del cilindro. La sección transversal es un polígono. La longitud del eje puede denominarse altura o espesor, y normalmente se encuentra en la dirección vertical (distinguiendo el cilindro poligonal del prisma tabular y la cuña)</skos:definition>
    <skos:definition xml:lang="en">Cylinder in which the edges bounding side surfaces are parallel or subparallel to cylinder axis. Cross section is polygon. Length of axis may be called height or thickness, and is typically in the vertical direction (distinguishing polygonal cylinder from tabular prism and wedge)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/bloque"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-cuadrado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/tableta"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/polygonal_cylinder"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/bloque">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">bloque</skos:prefLabel>
    <skos:prefLabel xml:lang="en">block</skos:prefLabel>
    <skos:definition xml:lang="es">Cilindro poligonal equivalente, L = W = H, los bordes definibles separan las superficies limítrofes. Grada al prisma tabular cuando una dimensión horizontal se vuelve claramente más larga que la otra, y a la tableta o columna cuando el eje vertical se vuelve claramente más corto o más largo que los ejes horizontales</skos:definition>
    <skos:definition xml:lang="en">Equant polygonal cylinder, L=W=H, definable edges separate bounding surfaces. Grades to tabular prism as one horizontal dimension becomes distinctly longer than the other, and tablet or polygonal cylinder as one vertical axis becomes distinctly shorter or longer than the horizontal axes</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cilindro-poligonal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/block"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">elipsoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ellipsoid</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo que contiene tres ejes ortogonales que definen tres superficies con simetría y perfiles elípticos. No presenta bordes que puedan delimitar lados. Evoluciona a cilindro o disco cuando se puede distinguir una superficie limite paralela a uno de los ejes. L&gt; = W&gt; = H</skos:definition>
    <skos:definition xml:lang="en">Body that contains three orthogonal axes defining three surfaces of reflection symmetry, profiles along the surfaces are elliptical. Boundary can not be separated into sides (no edges). Becomes cylinder or disc when bounding surface can be considered parallel to one of the axis. L&gt;=W&gt;=H</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide-alargado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide-muy-alargado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide-amelonado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide-achatado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/almohadilla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-elipsoidal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/esferoide"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/ellipsoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/embudo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">embudo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ethmolith</skos:prefLabel>
    <skos:definition xml:lang="es">Intrusión discordante, en forma de embudo, que se estrecha hacia abajo</skos:definition>
    <skos:definition xml:lang="en">Discordant, funnel-shaped intrusion, tapers downward</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/ethmolith"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lenticular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lenticular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">discus</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo con dos lados que convergen para definir un borde de perfil circular, el borde separa una parte superior y otra inferior diferenciables. L = W&gt; H. Puede evolucionar a  elipsoide si el borde que separa los lados se hace difuso o a cono si un lado se vuelve claramente plano</skos:definition>
    <skos:definition xml:lang="en">Body with two sides that converge to define an edge that is circular in profile, edge separates definable top and bottom. L=W&gt;H. Grades to oblate ellipsoid as edge separating sides loses definition, cone as one side becomes distinctly planar</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cono"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lente-alargada"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/discus"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/esfenolito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">esfenolito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sphenolith</skos:prefLabel>
    <skos:definition xml:lang="es">Intrusión en forma de cuña, en parte concordante y en parte discordante</skos:definition>
    <skos:definition xml:lang="en">Wedge-like intrusion, partly concordant, partly discordant</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/sphenolith"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cuerpo geológico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">geologic body</skos:prefLabel>
    <skos:definition xml:lang="es">Un cuerpo tridimensional definido en base a una forma geométrica, con alguna connotación o denotación geológica</skos:definition>
    <skos:definition xml:lang="en">A 3 dimensional body defined based on geometric shape, with some geologic connotation or denotation</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/morfologia-arqueada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuenca"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/manto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/boudin"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/canaliforme"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/columnar"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cupula"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/diapiro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/dique"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/domo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/ductolith"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/embudo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/abanico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/graben"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lacolito"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/capa-de-forma-tabular"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lente"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lopolito"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/monticulo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/facolito"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/chimenea"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/capsula"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/dique-anular"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-rocoso-de-geometria-irregular"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-rocoso-de-geometria-no-especificada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/sill"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/esfenolito"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/surco"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/vena"/>
