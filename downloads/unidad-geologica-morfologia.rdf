>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/ribbon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">ribbon</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ribbon</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo que es muy delgado frente a su anchura y longitud (forma de costilla). El eje largo puede estar curvado. L&gt; (&gt;&gt;) W &gt;&gt;&gt; H. H suele estar en dirección vertical</skos:definition>
    <skos:definition xml:lang="en">Body that is very thin relative to width and and length. Long axis may be curved. L&gt;(&gt;&gt;)W&gt;&gt;&gt;H. H is typically in vertical direction</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/ribbon"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/abanico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">abanico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fan</skos:prefLabel>
    <skos:definition xml:lang="es">Un segmento de cono, generalmente aplicado a la morfología de la superficie de un depósito sedimentario con una pendiente superficial suave, que irradia a partir de una fuente de sedimento localizada</skos:definition>
    <skos:definition xml:lang="en">A cone segment, generally applied to surface morphology of sedimentary deposit with a gentle surface slope, radiating from a localized sediment source</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/fan"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide-amelonado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">elipsoide amelonado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">football ellipsoid</skos:prefLabel>
    <skos:definition xml:lang="es">Elipsoide con L 2 a 5 veces W o H</skos:definition>
    <skos:definition xml:lang="en">Ellipsoid with L 2 to 5 times W or H</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/football_ellipsoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/columnar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">columnar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">column shape</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo cilíndrico,  de sección transversal equidimensional, alargado en la dirección perpendicular a la a sección transversal. Morfología equivalente a tubería, sin que implique función de transporte</skos:definition>
    <skos:definition xml:lang="en">Cylindrical body, equant cross section, long in direction normal to equant cross section. Morphology equivalent to pipe, without denotation of transport function</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/column_shape"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cupula">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cúpula</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cupola</skos:prefLabel>
    <skos:definition xml:lang="es">Gran proyección hacia arriba del techo de una intrusión ígnea en la roca encajante. Un cuerpo posiblemente irregular en forma de bóveda o columnar inserto en un cuerpo mayor</skos:definition>
    <skos:definition xml:lang="en">Large upward projection of the roof of an igneous intrusion into the country rock above. A possibly irregular dome like or columnar body rooted in a larger body</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/cupola"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
