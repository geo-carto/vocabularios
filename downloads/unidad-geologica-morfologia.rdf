  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-sigmoidal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lámina sigmoidal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sigmoid sheet</skos:prefLabel>
    <skos:definition xml:lang="es">Lámina con  una curvatura en forma de S en dirección L o W</skos:definition>
    <skos:definition xml:lang="en">Sheet with 's' curvature of L or W direction</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/sigmoid_sheet"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-lenticular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">perfil lenticular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lenticular profile</skos:prefLabel>
    <skos:definition xml:lang="es">Perfil con una relación entre la longitud del eje largo y la longitud del eje corto superior a 5 con lados que se estrechan en un punto, con la forma del perfil de una lente óptica</skos:definition>
    <skos:definition xml:lang="en">Profile with ratio of long axis length to short axis length greater than 5 with sides that taper to a point, shaped like the profile of an optical lense</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-planar"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/lenticular_profile"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/ductolith">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">ductolith</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ductolith</skos:prefLabel>
    <skos:definition xml:lang="es">Intrusión concordante, en forma de lágrima en sección transversal</skos:definition>
    <skos:definition xml:lang="en">Concordant intrusion, teardrop-shaped in cross section</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/ductolith"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/surco">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">surco</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trough shape</skos:prefLabel>
    <skos:definition xml:lang="es">Forma de un cuerpo de roca sedimentaria depositado en una depresión alargada llena de sedimentos. Se distingue del canal por  su mayor tamaño</skos:definition>
    <skos:definition xml:lang="en">Shape of a body of sedimentary rock deposited in an elongate depression filled with sediment. large size distinguishes from channel</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/trough"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/anillo-discoidal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">anillo discoidal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">discoid anulus</skos:prefLabel>
    <skos:definition xml:lang="es">Sección de un cono al que le falta la parte central extraída aproximadamente a lo largo del eje del cono</skos:definition>
    <skos:definition xml:lang="en">Cone with central part removed along cylindrical volume approximately along the cone axis</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-tridimensional"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/discoid_anulus"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide-alargado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">elipsoide alargado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bread loaf ellipsoid</skos:prefLabel>
    <skos:definition xml:lang="es">Elipsoide con L 10 veces W o H</skos:definition>
    <skos:definition xml:lang="en">Ellipsoid with L 10 times W or H</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/elipsoide"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/bread_loaf_ellipsoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-rocoso-de-geometria-irregular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">cuerpo rocoso de geometría irregular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rock body geometry irregular</skos:prefLabel>
    <skos:definition xml:lang="es">La geometría del cuerpo rocoso es irregular y no se puede caracterizar</skos:definition>
    <skos:definition xml:lang="en">Rock body geometry is irregular and can not be characterized using terminology</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/rock_body_geometry_irregular"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/chimenea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">chimenea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pipe</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo de roca que tiene una relación de longitud a anchura mayor de 10 a 1, con dos dimensiones inferiores similares</skos:definition>
    <skos:definition xml:lang="en">Rock body that has a length to width ratio greater than 10 to 1, with two sub equal width dimensions</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/pipe"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-domica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lámina domica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dome sheet</skos:prefLabel>
    <skos:definition xml:lang="es">Lámina en la que las dimensiones horizontales son arcos curvos</skos:definition>
    <skos:definition xml:lang="en">Sheet in which L and W are curved arcs</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/dome_sheet"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/diapiro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">diapiro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diapir</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo con forma general de lágrima invertida. Cuerpo de material  magmático o sedimentario desplazado e intruido en las rocas suprayacentes</skos:definition>
    <skos:definition xml:lang="en">Broadly inverted tear drop morphology. Body of magmatic or mobile sedimentary material intruded into overlying rocks</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/diapir"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/monticulo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">montículo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mound</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo de roca en forma de lente, de extensión lateral inferior a 100 m, generalmente plano en la parte inferior, y cubierto por un onlap en sus flancos.</skos:definition>
    <skos:definition xml:lang="en">Lense like body of rock, lateral extent less than 100m, generally flat at bottom, with stratigraphic pinch out of beds (onlap) along upper sides</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/mound"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/manto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">manto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">blanket shape</skos:prefLabel>
    <skos:definition xml:lang="es">Un cuerpo delgado y extenso con una relación de ancho frente a espesor mayor de 1000 a 1 que cubre un sustrato subyacente. Una capa de conocida gran extensión lateral. Morfología equivalente a lecho o capa, pero que implica que el cuerpo forma la parte superior de alguna unidad, en lugar de ocurrir dentro de su masa</skos:definition>
    <skos:definition xml:lang="en">A thin, widespread body with width to thickness ratio greater than 1000 to 1 that covers an underlying substrate. A layer of known great lateral extent. Morphology equivalent to bed or layer, but implies that body forms the top of some unit, instead of occurring within a body</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/blanket_shape"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/facolito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">facolito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phacolith</skos:prefLabel>
    <skos:definition xml:lang="es">Intrusión lenticular concordante, emplazada a lo largo de la charnela de un pliegue y que se adelgaza paulatinamente en los flancos hasta desaparecer.</skos:definition>
    <skos:definition xml:lang="en">Concordant, lenticular intrusion, emplaced along a fold axis</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/phacolith"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/graben">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">graben</skos:prefLabel>
    <skos:prefLabel xml:lang="en">graben shape</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo alargado limitado a ambos lados por fallas normales que buzan en sentidos opuestos, una hacia otra</skos:definition>
    <skos:definition xml:lang="en">an elongate body bounded on both sides by normal faults that dip toward each other</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/cuerpo-geologico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/graben_shape"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-circular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">perfil circular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">circular profile</skos:prefLabel>
    <skos:definition xml:lang="es">perfil equidimensional con límite arqueado</skos:definition>
    <skos:definition xml:lang="en">equant profile with arcuate boundary</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/perfil-isometrico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/circular_profile"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina-conica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia"/>
    <skos:prefLabel xml:lang="es">lámina cónica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">conical sheet</skos:prefLabel>
    <skos:definition xml:lang="es">Lámina que se adapta a la superficie de un cono</skos:definition>
    <skos:definition xml:lang="en">Sheet that conforms to surface of a cone</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-morfologia/lamina"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunitmorphology/conical_sheet"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
</rdf:RDF>
