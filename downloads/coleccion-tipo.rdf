  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/coleccion-tipo/coleccion-de-sondeos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/coleccion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/coleccion-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/coleccion-tipo"/>
    <skos:prefLabel xml:lang="es">colección de sondeos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">borehole collection</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de sondeos</skos:definition>
    <skos:definition xml:lang="en">Collection of boreholes</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/CollectionTypeValue/boreholeCollection"/>
    <adms:status>Válido</adms:status>
