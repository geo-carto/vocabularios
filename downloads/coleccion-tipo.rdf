    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/coleccion-tipo/modelo-geologico"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/coleccion-tipo/estacion"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/coleccion-tipo/documentacion"/>
