    <skos:prefLabel xml:lang="en">geological model</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de objetos de un modelo de datos geológico 3D</skos:definition>
    <skos:definition xml:lang="en">Collection of objects for a 3D geological spatial model</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/CollectionTypeValue/geologicalModel"/>
