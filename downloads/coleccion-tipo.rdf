  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/coleccion-tipo/mapa-geologico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/coleccion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/coleccion-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/coleccion-tipo"/>
    <skos:prefLabel xml:lang="es">mapa geológico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">geological map</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de objetos de un mapa geológico que describen las unidades geológicas, las estructuras y los objetos geomorfológicos.</skos:definition>
    <skos:definition xml:lang="en">Collection of features for a geological map which described geological units, structures geomorphologic features, etc</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/CollectionTypeValue/geologicalMap"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/coleccion-tipo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Tipo de colección</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection type</skos:prefLabel>
    <dcterms:title xml:lang="es">Tipo de colección</dcterms:title>
    <dcterms:title xml:lang="en">Collection type</dcterms:title>
    <skos:definition xml:lang="es">Términos referidos a rango estratigráfico.</skos:definition>
    <skos:definition xml:lang="en">Terms referring to stratigraphic rank.</skos:definition>
    <dcterms:description xml:lang="es">Términos referidos a rango estratigráfico.</dcterms:description>
    <dcterms:description xml:lang="en">Terms referring to stratigraphic rank.</dcterms:description>
