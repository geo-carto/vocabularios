    <dcterms:creator>https://cgi-iugs.org/</dcterms:creator>
    <dcterms:contributor>https://www.igme.es</dcterms:contributor>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
