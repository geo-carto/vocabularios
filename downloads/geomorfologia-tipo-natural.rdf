    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/vertiente-montañosa"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ladera"/>
