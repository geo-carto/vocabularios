    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/apk"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/appx"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/arc"/>
