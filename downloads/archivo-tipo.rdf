    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/arj"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/arrow_file"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/arrow_stream"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/atom"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/bin"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/bmp"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/bits"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/bwf"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/bzip2"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/laz"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/css"/>
