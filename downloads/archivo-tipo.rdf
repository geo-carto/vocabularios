    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/aac"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/akn4eu"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/akn4eu_leg"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/akn4eu_zip"/>
