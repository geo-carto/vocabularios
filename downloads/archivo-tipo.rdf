<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:adms="http://www.w3.org/ns/adms#"
   xmlns:dcat="http://www.w3.org/ns/dcat#"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:sdo="https://schema.org/"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/hdf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">HDF</skos:prefLabel>
    <skos:prefLabel xml:lang="en">HDF</skos:prefLabel>
    <skos:altLabel xml:lang="es">Hierarchical Data Format</skos:altLabel>
    <skos:altLabel xml:lang="en">Hierarchical Data Format</skos:altLabel>
    <skos:notation>.h5; .hdf5; .h4; .hdf; .he2; .hdf4; .he5</skos:notation>
    <skos:notation>application/x-hdf</skos:notation>
    <skos:definition xml:lang="es">HDF es un conjunto de formatos de archivo (HDF4, HDF5) diseñados para almacenar y organizar grandes cantidades de datos numéricos.</skos:definition>
    <skos:definition xml:lang="en">HDF is a set of file formats (HDF4, HDF5) designed to store and organize large amounts of numerical data.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/application/x-hdf"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/HDF"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/wfs_srvc">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">WFS</skos:prefLabel>
    <skos:prefLabel xml:lang="en">WFS</skos:prefLabel>
    <skos:altLabel xml:lang="es">Web Feature Service</skos:altLabel>
    <skos:altLabel xml:lang="en">Web Feature Service</skos:altLabel>
    <skos:notation>application/gml+xml; text/xml</skos:notation>
    <skos:definition xml:lang="es">El estándar de interfaz Web Feature Service (WFS) del Open Geospatial Consortium proporciona una interfaz que permite solicitudes de características geoespaciales a través de la web utilizando mecanismos independientes de la plataforma y es independiente del almacén de datos subyacente.</skos:definition>
    <skos:definition xml:lang="en">The Open Geospatial Consortium Web Feature Service (WFS) Interface Standard provides an interface allowing requests for geospatial features across the web using platform-independent mechanisms and is independent of the underlying data store.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/application/gml+xml"/>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/text/xml"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/WFS_SRVC"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/pdfa1b">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">PDF/A-1b</skos:prefLabel>
    <skos:prefLabel xml:lang="en">PDF/A-1b</skos:prefLabel>
    <skos:altLabel xml:lang="es">PDF archiving format, Level B conformance</skos:altLabel>
    <skos:altLabel xml:lang="en">PDF archiving format, Level B conformance</skos:altLabel>
    <skos:notation>.pdf</skos:notation>
    <skos:notation>application/pdf</skos:notation>
    <skos:definition xml:lang="es">PDF/A-1 es la Parte 1 del estándar PDF y especifica dos niveles de conformidad para archivos PDF. La conformidad de Nivel B (básico) requiere únicamente que se sigan los estándares necesarios para la reproducción fiable de la apariencia visual de un documento.</skos:definition>
    <skos:definition xml:lang="en">PDF/A-1 is the Part 1 of the PDF standard and specifies two levels of conformance for PDF files. Level B (basic) conformance requires only that standards necessary for the reliable reproduction of a document's visual appearance be followed.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/application/pdf"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/PDFA1B"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/vcf">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">VCF</skos:prefLabel>
    <skos:prefLabel xml:lang="en">VCF</skos:prefLabel>
    <skos:altLabel xml:lang="es">Variant Call Format</skos:altLabel>
    <skos:altLabel xml:lang="en">Variant Call Format</skos:altLabel>
    <skos:notation>.vcf; .vcf.gz</skos:notation>
    <skos:notation>text/vnd.vcf</skos:notation>
    <skos:definition xml:lang="es">Formato estándar de archivo de texto utilizado en bioinformática para almacenar secuencias genéticas o variaciones de secuencias de ADN.</skos:definition>
    <skos:definition xml:lang="en">standard text file format used in bioinformatics for storing gene sequence or DNA sequence variations</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/text/vnd.vcf"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/VCF"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/las">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">LASer file</skos:prefLabel>
    <skos:prefLabel xml:lang="en">LASer file</skos:prefLabel>
    <skos:notation>.las</skos:notation>
    <skos:notation>application/x-las</skos:notation>
    <skos:definition xml:lang="es">LAS – LASer file format – es el tipo de medio que se utilizará para un formato de archivo público para el intercambio de datos de nubes de puntos tridimensionales entre usuarios de datos.</skos:definition>
    <skos:definition xml:lang="en">LAS – LASer file format – is the media type which shall be used for a public file format for the interchange of 3-dimensional point cloud data data between data users.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/application/x-las"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/LAS"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/owl">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">OWL</skos:prefLabel>
    <skos:prefLabel xml:lang="en">OWL</skos:prefLabel>
    <skos:altLabel xml:lang="es">Web Ontology Language</skos:altLabel>
    <skos:altLabel xml:lang="en">Web Ontology Language</skos:altLabel>
    <skos:notation>.rdf; .owl; .owx</skos:notation>
    <skos:notation>application/owl+xml</skos:notation>
    <skos:definition xml:lang="es">OWL – Web Ontology Language – es una familia de lenguajes de representación del conocimiento para la creación de ontologías.</skos:definition>
    <skos:definition xml:lang="en">OWL – Web Ontology Language – is a family of knowledge representation languages for authoring ontologies.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/application/owl+xml"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/OWL"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/shp">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">Esri Shape</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Esri Shape</skos:prefLabel>
    <skos:altLabel xml:lang="es">Environmental Systems Research Institute Shape</skos:altLabel>
    <skos:altLabel xml:lang="en">Environmental Systems Research Institute Shape</skos:altLabel>
    <skos:notation>.dbf; .shp; .shx</skos:notation>
    <skos:notation>application/x-shapefile</skos:notation>
    <skos:definition xml:lang="es">SHP – shapefile format – es un formato de datos vectoriales geoespaciales popular para software de sistemas de información geográfica (SIG). El shapefile de Esri es un archivo zip que contiene al menos los archivos shp, shx y dbf.</skos:definition>
    <skos:definition xml:lang="en">SHP – shapefile format – is a popular geospatial vector data format for geographic information system (GIS) software. Esri shapefile is a zip archive that contains at least the shp, shx and dbf files.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/application/x-shapefile"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/SHP"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/kml">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">KML</skos:prefLabel>
    <skos:prefLabel xml:lang="en">KML</skos:prefLabel>
    <skos:altLabel xml:lang="es">Keyhole Markup Language</skos:altLabel>
    <skos:altLabel xml:lang="en">Keyhole Markup Language</skos:altLabel>
    <skos:notation>.kml</skos:notation>
    <skos:notation>application/vnd.google-earth.kml+xml</skos:notation>
    <skos:definition xml:lang="es">KML – Keyhole Markup Language – es una notación XML para expresar anotaciones geográficas y visualización dentro de mapas bidimensionales y navegadores terrestres tridimensionales basados en Internet. KML fue desarrollado para su uso con Google Earth y se convirtió en un estándar internacional.</skos:definition>
    <skos:definition xml:lang="en">KML – Keyhole Markup Language – is an XML notation for expressing geographic annotation and visualization within Internet-based, two-dimensional maps and three-dimensional Earth browsers. KML was developed for use with Google Earth and became an international standard.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/application/vnd.google-earth.kml+xml"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/KML"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/pdfx1a">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">PDF/X-1a</skos:prefLabel>
    <skos:prefLabel xml:lang="en">PDF/X-1a</skos:prefLabel>
    <skos:notation>.pdf</skos:notation>
    <skos:notation>application/pdf</skos:notation>
    <skos:definition xml:lang="es">PDF/X-1a es una especificación PDF que completa el intercambio utilizando datos CMYK y datos de impresión de colores directos.</skos:definition>
    <skos:definition xml:lang="en">PDF/X-1a is a PDF specification which completes exchange using CMYK data and spots colour printing data.</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/application/pdf"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/PDFX1A"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo/akn4eu_leg">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo"/>
    <skos:prefLabel xml:lang="es">AKN4EU LEG</skos:prefLabel>
    <skos:prefLabel xml:lang="en">AKN4EU LEG</skos:prefLabel>
    <skos:altLabel xml:lang="es">Akoma Ntoso ZIP archive</skos:altLabel>
    <skos:altLabel xml:lang="en">Akoma Ntoso ZIP archive</skos:altLabel>
    <skos:notation>.leg</skos:notation>
    <skos:notation>application/zip</skos:notation>
    <skos:definition xml:lang="es">Archivo ZIP que contiene una manifestación AKN4EU de un documento en una variante lingüística emitida en el proceso de toma de decisiones legales; debe contener al menos un archivo AKN4EU que comience con el prefijo 'main-', que constituye el punto de entrada, y puede contener otros archivos y subcarpetas asociados.</skos:definition>
    <skos:definition xml:lang="en">ZIP archive containing an AKN4EU manifestation of a document in one linguistic variant issued in the legal decision-making process; it must contain at least an AKN4EU file starting with the prefix ‘main-’, which constitutes the entry point, and may contain other associated files and subfolders</skos:definition>
    <skos:exactMatch rdf:resource="https://www.iana.org/assignments/media-types/application/zip"/>
    <skos:exactMatch rdf:resource="http://publications.europa.eu/resource/authority/archivo-tipo/AKN4EU_LEG"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/archivo-tipo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Tipo de archivo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">File Type</skos:prefLabel>
    <dcterms:title xml:lang="es">Tipo de archivo</dcterms:title>
    <dcterms:title xml:lang="en">File Type</dcterms:title>
    <skos:definition xml:lang="es">Términos que definen distintos tipos de archivos digitales.</skos:definition>
    <skos:definition xml:lang="en">Terms listing different types of digital files.</skos:definition>
    <dcterms:description xml:lang="es">Términos que definen distintos tipos de archivos digitales.</dcterms:description>
    <dcterms:description xml:lang="en">Terms listing different types of digital files.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Interinstitutional Metadata and Formats Committee (IMFC)</dcterms:provenance>
    <dcterms:creator>Interinstitutional Metadata and Formats Committee (IMFC)</dcterms:creator>
    <dcterms:contributor>https://www.igme.es</dcterms:contributor>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>TE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Tipo de archivo.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/archivo-tipo/7z"/>
