    <skos:definition xml:lang="es">Depósitos de ladera con alternancia de capas de diferente granulometría de origen periglaciar.</skos:definition>
    <skos:definition xml:lang="en">Slope deposits with alternating layers of different grain size of periglacial origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
