    <skos:prefLabel xml:lang="en">abrupt slope break</skos:prefLabel>
    <skos:definition xml:lang="es">Cambio repentino del ángulo de la pendiente en una vertiente.</skos:definition>
    <skos:definition xml:lang="en">A sudden change in slope angle on a hillside.</skos:definition>
