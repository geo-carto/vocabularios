  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/delta-sumergido-de-flujo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">delta sumergido; de flujo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">submerged delta; flow delta</skos:prefLabel>
    <skos:definition xml:lang="es">Parte del delta situada bajo el nivel del agua.</skos:definition>
    <skos:definition xml:lang="en">Part of the delta located below water level.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/delta"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/linea-de-drenaje-difusa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">línea de drenaje difusa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diffuse drainage line</skos:prefLabel>
    <skos:definition xml:lang="es">Línea de escorrentía sin cauce definido.</skos:definition>
    <skos:definition xml:lang="en">A runoff line without a defined channel.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/lobulo-o-colada-de-solifluxion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">lóbulo o colada de solifluxión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">solifluction lobe</skos:prefLabel>
    <skos:definition xml:lang="es">Forma lobulada producida por solifluxión en una ladera.</skos:definition>
    <skos:definition xml:lang="en">A lobe-shaped form produced by solifluction on a slope.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-relacionados-con-las-laderas-y-con-la-gravedad"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/lago-de-montanya-ibon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">lago de montaña; ibón</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mountain lake; tarn</skos:prefLabel>
    <skos:definition xml:lang="es">Lago de montaña de origen glaciar situado generalmente en un circo.</skos:definition>
    <skos:definition xml:lang="en">A mountain lake of glacial origin generally located in a cirque.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/brazo-fluvial-con-flujo-de-marea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">brazo fluvial con flujo de marea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tidal distributary channel</skos:prefLabel>
    <skos:definition xml:lang="es">Canal de distribución deltaico afectado por mareas.</skos:definition>
    <skos:definition xml:lang="en">A deltaic distribution channel affected by tides.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/pendiente-de-cabecera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">pendiente de cabecera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">head slope</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento geomorfológico de una colina constituido por un área de la ladera lateralmente cóncava, especialmente en la cabecera de una vía de drenaje, que determina que las corrientes de agua sean convergentes.</skos:definition>
    <skos:definition xml:lang="en">A geomorphologic component of hills consisting of a laterally concave area of a hillside, especially at the head of a drainage way, resulting in converging overland water flow.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/headSlope"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cresta-dunar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">cresta dunar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dune crest</skos:prefLabel>
    <skos:definition xml:lang="es">Línea más alta de una duna.</skos:definition>
    <skos:definition xml:lang="en">The highest line of a dune.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-eolicos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cono-de-piroclastos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">cono de piroclastos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic cone</skos:prefLabel>
    <skos:definition xml:lang="es">Edificio volcánico formado por acumulación de piroclastos alrededor de un centro de emisión.</skos:definition>
    <skos:definition xml:lang="en">A volcanic edifice formed by accumulation of pyroclastic material around an emission centre.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/llanura-de-inundacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">llanura de inundación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">floodplain</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie plana adyacente a un río que se inunda periódicamente.</skos:definition>
    <skos:definition xml:lang="en">A flat surface adjacent to a river that is periodically flooded.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/volcan-de-barro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">volcán de barro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mud volcano</skos:prefLabel>
    <skos:definition xml:lang="es">Estructura formada por emisión de barro, agua y gases a la superficie.</skos:definition>
    <skos:definition xml:lang="en">A structure formed by the emission of mud, water and gases at the surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/volcan-de-barro-con-deposito-fangoso"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-originado-por-erosion-diferencial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">escarpe de línea de falla originado por erosión diferencial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">differential erosion fault-line scarp</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe resultante de la erosión diferencial a lo largo de una línea de falla.</skos:definition>
    <skos:definition xml:lang="en">A scarp resulting from differential erosion along a fault line.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-de-lava-tipo-pahoehoe-lava-cordada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">colada de lava tipo pahoehoe; lava cordada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pahoehoe lava flow; ropy lava</skos:prefLabel>
    <skos:definition xml:lang="es">Colada de lava de superficie lisa con morfología cordada.</skos:definition>
    <skos:definition xml:lang="en">A lava flow with a smooth surface and ropy morphology.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-de-lava"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cresta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">cresta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">crest</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento geomorfológico de una colina constituido por unas laderas convexas (perpendiculares al contorno) que convergen para formar la parte superior, estrecha y generalmente lineal, de la colina, cordillera o tierra alta, hasta el punto de que apenas subsiste una cumbre; está dominada por los procesos de erosión, lavado de laderas y movimiento de masas, y por los sedimentos</skos:definition>
    <skos:definition xml:lang="en">A geomorphologic component of hills consisting of the convex slopes (perpendicular to the contour) that form the narrow, roughly linear top area of a hill, ridge, or other upland where shoulders have converged to the extent that little or no summit remains; dominated by erosion, slope wash and mass movement processes and sediments</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/crest"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/simas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">simas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">crevasses</skos:prefLabel>
    <skos:definition xml:lang="es">Grietas profundas en la masa de hielo de un glaciar.</skos:definition>
    <skos:definition xml:lang="en">Deep cracks in the ice mass of a glacier.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/crater-de-domo-colada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">cráter de domo-colada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dome-flow crater</skos:prefLabel>
    <skos:definition xml:lang="es">Cráter asociado a un domo volcánico y sus coladas asociadas.</skos:definition>
    <skos:definition xml:lang="en">A crater associated with a volcanic dome and its associated flows.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/modelo-de-drenaje">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">modelo de drenaje</skos:prefLabel>
    <skos:prefLabel xml:lang="en">drainage pattern</skos:prefLabel>
    <skos:definition xml:lang="es">Configuración o disposición de los cursos de agua en una zona, incluidos los barrancos o cursos canalizados de primer orden, los afluentes de orden superior y los cursos de agua principales.</skos:definition>
    <skos:definition xml:lang="en">The configuration or arrangement of stream courses in an area, including gullies or first-order channelized flow areas, higher order tributaries, and main streams.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/drainagePattern"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/suelos-estriados">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">suelos estriados</skos:prefLabel>
    <skos:prefLabel xml:lang="en">striped ground</skos:prefLabel>
    <skos:definition xml:lang="es">Patrón de bandas alternas de material grueso y fino en una ladera por procesos de hielo-deshielo.</skos:definition>
    <skos:definition xml:lang="en">Pattern of alternating bands of coarse and fine material on a slope due to freeze-thaw processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-de-impacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">objetos de impacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impact features</skos:prefLabel>
    <skos:definition xml:lang="es">Paisajes geomorfológicos y formas del relieve relacionados con el impacto de objetos extraterrestres sobre la superficie terrestre.</skos:definition>
    <skos:definition xml:lang="en">Geomorphologic landscapes and landforms related to the impact of extraterrestrial material on the Earth's surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objeto-geomorfologico-natural"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/impact"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/vertiente-regularizada-y-disectada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">vertiente regularizada y disectada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">regularized and dissected slope</skos:prefLabel>
    <skos:definition xml:lang="es">Vertiente regularizada que ha sido posteriormente incidida por cauces.</skos:definition>
    <skos:definition xml:lang="en">A regularized slope that has been subsequently incised by channels.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-relacionados-con-las-laderas-y-con-la-gravedad"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-vertiente-glacis-coluvial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">glacis de vertiente; glacis coluvial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slope glacis; colluvial glacis</skos:prefLabel>
    <skos:definition xml:lang="es">Glacis formado por depósitos coluviales al pie de una vertiente.</skos:definition>
    <skos:definition xml:lang="en">A glacis formed by colluvial deposits at the foot of a slope.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/incision-lineal-en-cuna-vaguada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">incisión lineal en cuna; vaguada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wedge-shaped incision; thalweg</skos:prefLabel>
    <skos:definition xml:lang="es">Incisión fluvial de perfil transversal en cuña o fondo plano poco desarrollado.</skos:definition>
    <skos:definition xml:lang="en">Fluvial incision with a wedge-shaped or poorly developed flat-bottom cross section.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">escarpe de línea de falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fault-line scarp</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe topográfico coincidente con el trazado de una falla.</skos:definition>
    <skos:definition xml:lang="en">A topographic scarp coinciding with the trace of a fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-degradado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-inversa-o-cabalgamiento"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-originado-por-erosion-diferencial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-exhumado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-en-retroceso"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terracillas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">terracillas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">terracettes</skos:prefLabel>
    <skos:definition xml:lang="es">Pequeños escalones paralelos a las curvas de nivel en una ladera, producidos por reptación o pisoteo.</skos:definition>
    <skos:definition xml:lang="en">Small steps parallel to contour lines on a slope, produced by creep or trampling.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-relacionados-con-las-laderas-y-con-la-gravedad"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/pequenya-dolina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">pequeña dolina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">small doline</skos:prefLabel>
    <skos:definition xml:lang="es">Dolina de dimensiones reducidas.</skos:definition>
    <skos:definition xml:lang="en">A doline of small dimensions.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-pequenyas-dolinas"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fondo-de-valle-colgado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">fondo de valle colgado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hanging valley floor</skos:prefLabel>
    <skos:definition xml:lang="es">Fondo plano de un valle colgado respecto al valle principal.</skos:definition>
    <skos:definition xml:lang="en">Flat floor of a valley hanging above the main valley.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fault</skos:prefLabel>
    <skos:definition xml:lang="es">Fractura o zona de fractura a lo largo de la cual ha habido desplazamiento de los bloques contiguos.</skos:definition>
    <skos:definition xml:lang="en">A fracture or zone of fractures along which there has been displacement of the adjacent blocks.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/morrena-frontal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">morrena frontal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">terminal moraine</skos:prefLabel>
    <skos:definition xml:lang="es">Morrena depositada en el frente de un glaciar.</skos:definition>
    <skos:definition xml:lang="en">Moraine deposited at the front of a glacier.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/morrena"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/sima">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">sima</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pothole; shaft</skos:prefLabel>
    <skos:definition xml:lang="es">Cavidad vertical profunda en terreno kárstico.</skos:definition>
    <skos:definition xml:lang="en">A deep vertical cavity in karst terrain.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monte-isla-con-acanaladuras">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">monte isla con acanaladuras</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fluted inselberg</skos:prefLabel>
    <skos:definition xml:lang="es">Inselberg con surcos verticales en sus paredes.</skos:definition>
    <skos:definition xml:lang="en">An inselberg with vertical grooves on its walls.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monte-isla-relieve-aislado-inselberg"/>
    <adms:status>Válido</adms:status>
