    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">terraza travertínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">travertine terrace</skos:prefLabel>
    <skos:definition xml:lang="es">Terraza formada por precipitación de carbonato cálcico (travertino).</skos:definition>
    <skos:definition xml:lang="en">Terrace formed by calcium carbonate (travertine) precipitation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza"/>
