  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/charca-labajo-bodon-estacional">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">charca; labajo; bodón estacional</skos:prefLabel>
    <skos:prefLabel xml:lang="en">seasonal pond</skos:prefLabel>
    <skos:definition xml:lang="es">Pequeña masa de agua estancada de carácter estacional.</skos:definition>
    <skos:definition xml:lang="en">A small seasonal body of standing water.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-lacustres"/>
