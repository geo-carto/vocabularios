    <skos:prefLabel xml:lang="en">semi-covered karren</skos:prefLabel>
    <skos:definition xml:lang="es">Lapiaz parcialmente cubierto por suelo o vegetación.</skos:definition>
    <skos:definition xml:lang="en">Karren partially covered by soil or vegetation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/lapiaz"/>
