    <skos:prefLabel xml:lang="en">degraded glacial cirque</skos:prefLabel>
    <skos:definition xml:lang="es">Circo glaciar cuya morfología ha sido suavizada por procesos erosivos posteriores.</skos:definition>
    <skos:definition xml:lang="en">A glacial cirque whose morphology has been smoothed by subsequent erosional processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/circo-glaciar"/>
