    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/linea-de-capa-con-indicacion-de-buzamiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">línea de capa con indicación de buzamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bedding trace with dip indication</skos:prefLabel>
    <skos:definition xml:lang="es">Traza de una capa sedimentaria en superficie con indicación del ángulo de buzamiento.</skos:definition>
    <skos:definition xml:lang="en">Trace of a sedimentary bed at the surface with indication of the dip angle.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
