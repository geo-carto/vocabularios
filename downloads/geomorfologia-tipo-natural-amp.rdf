    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion-con-alterita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion-degradada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/techo-de-piedemonte-ranya"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion-poligenetica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-conico-poligenetico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/collado-poligenetico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/hombrera-poligenetica"/>
