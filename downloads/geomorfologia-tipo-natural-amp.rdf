    <skos:prefLabel xml:lang="es">canal de marea sumergido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">submerged tidal channel</skos:prefLabel>
    <skos:definition xml:lang="es">Canal de marea permanentemente bajo el agua.</skos:definition>
    <skos:definition xml:lang="en">A tidal channel permanently underwater.</skos:definition>
