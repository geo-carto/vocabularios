    <skos:prefLabel xml:lang="en">ice flow direction</skos:prefLabel>
    <skos:definition xml:lang="es">Indicación de la dirección de movimiento de un glaciar.</skos:definition>
    <skos:definition xml:lang="en">Indication of the direction of glacier movement.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
