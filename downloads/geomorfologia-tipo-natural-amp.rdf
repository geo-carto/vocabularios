  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/valle-ciego">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">valle ciego</skos:prefLabel>
    <skos:prefLabel xml:lang="en">blind valley</skos:prefLabel>
    <skos:definition xml:lang="es">Valle fluvial que termina bruscamente en un sumidero kárstico.</skos:definition>
    <skos:definition xml:lang="en">A fluvial valley that ends abruptly at a karst sinkhole.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica"/>
