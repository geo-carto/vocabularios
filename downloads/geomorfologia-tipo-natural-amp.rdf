    <skos:prefLabel xml:lang="es">cabecera de avalancha o alud difuso o degradado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diffuse or degraded avalanche starting zone</skos:prefLabel>
    <skos:definition xml:lang="es">Zona de arranque de avalancha con morfología suavizada.</skos:definition>
    <skos:definition xml:lang="en">Avalanche starting zone with smoothed morphology.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cabecera-de-avalancha-o-alud"/>
