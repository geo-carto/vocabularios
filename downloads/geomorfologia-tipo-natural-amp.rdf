  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/trazas-resaltes-de-capas-en-apilamientos-volcanicos-inclinados">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">trazas, resaltes de capas en apilamientos volcánicos inclinados</skos:prefLabel>
    <skos:prefLabel xml:lang="en">layer traces in inclined volcanic stacks</skos:prefLabel>
    <skos:definition xml:lang="es">Resaltes topográficos de capas en secuencias volcánicas inclinadas.</skos:definition>
    <skos:definition xml:lang="en">Topographic ledges of layers in inclined volcanic sequences.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
