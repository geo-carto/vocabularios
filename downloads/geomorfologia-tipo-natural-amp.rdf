    <skos:prefLabel xml:lang="en">dome</skos:prefLabel>
    <skos:definition xml:lang="es">Elevación redondeada formada por extrusión de lava viscosa.</skos:definition>
    <skos:definition xml:lang="en">A rounded elevation formed by extrusion of viscous lava.</skos:definition>
