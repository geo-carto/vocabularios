  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ponor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">ponor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ponor</skos:prefLabel>
    <skos:definition xml:lang="es">Abertura en la roca por donde el agua de un polje o depresión kárstica drena al subsuelo.</skos:definition>
    <skos:definition xml:lang="en">An opening in rock through which water from a polje or karst depression drains underground.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica"/>
