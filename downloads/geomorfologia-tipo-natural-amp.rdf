  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/brazo-fluvial-abandonado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">brazo fluvial abandonado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">abandoned distributary channel</skos:prefLabel>
    <skos:definition xml:lang="es">Canal de distribución deltaico ya no funcional.</skos:definition>
    <skos:definition xml:lang="en">A deltaic distribution channel no longer functional.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros"/>
