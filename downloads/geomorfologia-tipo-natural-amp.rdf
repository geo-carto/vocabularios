    <skos:prefLabel xml:lang="en">ground moraine</skos:prefLabel>
    <skos:definition xml:lang="es">Morrena depositada bajo el glaciar en forma de manto.</skos:definition>
    <skos:definition xml:lang="en">Moraine deposited beneath the glacier as a mantle.</skos:definition>
