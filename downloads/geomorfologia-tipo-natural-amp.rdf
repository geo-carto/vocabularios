  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/talud-o-cono-de-derrubios">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">talud o cono de derrubios</skos:prefLabel>
    <skos:prefLabel xml:lang="en">talus or debris cone</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación de derrubios al pie de una pared rocosa formando un cono o talud.</skos:definition>
    <skos:definition xml:lang="en">Debris accumulation at the foot of a rock wall forming a cone or talus.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
