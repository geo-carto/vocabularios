  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-cobertera-degradado-o-disectado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">glacis de cobertera degradado o disectado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">degraded or dissected covered glacis</skos:prefLabel>
    <skos:definition xml:lang="es">Glacis de cobertera incidido por cauces.</skos:definition>
    <skos:definition xml:lang="en">A covered glacis incised by channels.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-cobertera-pedimento-cubierto-glacis-mixto"/>
