  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-dunas-fosiles">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
