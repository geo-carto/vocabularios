  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/flexion-monoclinal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">flexión monoclinal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monoclinal flexure</skos:prefLabel>
    <skos:definition xml:lang="es">Inflexión o cambio de buzamiento en capas que forman un relieve monoclinal.</skos:definition>
    <skos:definition xml:lang="en">An inflection or change in dip in layers forming a monoclinal relief.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
