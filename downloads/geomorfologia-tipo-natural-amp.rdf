    <skos:prefLabel xml:lang="en">ephemeral stream bed</skos:prefLabel>
    <skos:definition xml:lang="es">Lecho de un curso de agua torrencial con flujo intermitente.</skos:definition>
    <skos:definition xml:lang="en">Bed of a torrential watercourse with intermittent flow.</skos:definition>
