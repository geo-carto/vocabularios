  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla-normal-con-indicacion-de-labio-hundido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">falla normal con indicación de labio hundido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">normal fault with downthrown side indication</skos:prefLabel>
    <skos:definition xml:lang="es">Falla en la que el bloque superior se ha desplazado hacia abajo respecto al bloque inferior, con indicación del labio hundido.</skos:definition>
    <skos:definition xml:lang="en">A fault in which the hanging wall has moved downward relative to the footwall, with indication of the downthrown side.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion-con-alterita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">superficie de erosión con alterita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">erosion surface with alterite</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie de erosión cubierta por productos de alteración residual.</skos:definition>
    <skos:definition xml:lang="en">An erosion surface covered by residual weathering products.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion-poligenetica"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/sumidero">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">sumidero</skos:prefLabel>
    <skos:prefLabel xml:lang="en">swallow hole; sinkhole</skos:prefLabel>
    <skos:definition xml:lang="es">Punto donde un curso de agua superficial desaparece en el subsuelo kárstico.</skos:definition>
    <skos:definition xml:lang="en">Point where a surface watercourse disappears into the karst underground.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina-con-fondo-plano">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">dolina con fondo plano</skos:prefLabel>
    <skos:prefLabel xml:lang="en">flat-bottomed doline</skos:prefLabel>
    <skos:definition xml:lang="es">Dolina con fondo horizontal ocupado generalmente por arcillas de descalcificación.</skos:definition>
    <skos:definition xml:lang="en">A doline with a horizontal bottom generally occupied by decalcification clays.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina"/>
    <adms:status>Válido</adms:status>
