  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-abrasion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">superficie de abrasión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">abrasion surface</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie rocosa pulida y estriada por abrasión glaciar.</skos:definition>
    <skos:definition xml:lang="en">Rock surface polished and striated by glacial abrasion.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
