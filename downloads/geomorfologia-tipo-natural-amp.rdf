    <skos:prefLabel xml:lang="en">blockstream; block field</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación alargada de bloques rocosos que desciende una ladera por procesos periglaciales.</skos:definition>
    <skos:definition xml:lang="en">Elongated accumulation of rock blocks descending a slope by periglacial processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
