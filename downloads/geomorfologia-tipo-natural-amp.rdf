    <skos:prefLabel xml:lang="en">closed or semi-closed depression of mixed origin</skos:prefLabel>
    <skos:definition xml:lang="es">Depresión topográfica cerrada originada por procesos múltiples.</skos:definition>
    <skos:definition xml:lang="en">Closed topographic depression originated by multiple processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion"/>
