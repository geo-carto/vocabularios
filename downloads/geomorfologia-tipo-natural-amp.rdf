  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/abanico-de-arena-washover-fan">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">abanico de arena; washover fan</skos:prefLabel>
    <skos:prefLabel xml:lang="en">washover fan</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito en abanico de arena transportada por olas de tormenta sobre un cordón litoral.</skos:definition>
    <skos:definition xml:lang="en">Fan-shaped sand deposit transported by storm waves over a beach ridge.</skos:definition>
