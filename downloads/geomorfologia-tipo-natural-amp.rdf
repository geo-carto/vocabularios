  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-masiva-con-superficie-lisa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">colada masiva con superficie lisa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">massive lava flow with smooth surface</skos:prefLabel>
    <skos:definition xml:lang="es">Colada de lava compacta con superficie lisa y homogénea.</skos:definition>
    <skos:definition xml:lang="en">A compact lava flow with a smooth and homogeneous surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-de-lava"/>
