    <skos:prefLabel xml:lang="es">escarpe estructural en capas monoclinales (superior a 100 metros); cuesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cuesta scarp (&gt;100 m)</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe de más de 100 m en capas monoclinales formando una cuesta.</skos:definition>
    <skos:definition xml:lang="en">A scarp over 100 m in monoclinal layers forming a cuesta.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural"/>
