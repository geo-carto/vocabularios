  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-cobertera-pedimento-cubierto-glacis-mixto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">glacis de cobertera; pedimento cubierto; glacis mixto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">covered glacis; covered pediment</skos:prefLabel>
    <skos:definition xml:lang="es">Glacis cubierto por un manto delgado de sedimentos.</skos:definition>
    <skos:definition xml:lang="en">A glacis covered by a thin mantle of sediments.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion"/>
