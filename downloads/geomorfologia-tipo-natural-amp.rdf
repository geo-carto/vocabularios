  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla-inversa-frente-de-cabalgamiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">falla inversa; frente de cabalgamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reverse fault; thrust front</skos:prefLabel>
    <skos:definition xml:lang="es">Falla en la que el bloque superior se ha desplazado hacia arriba respecto al bloque inferior; cuando el ángulo es bajo se denomina cabalgamiento.</skos:definition>
    <skos:definition xml:lang="en">A fault in which the hanging wall has moved upward relative to the footwall; when the angle is low it is called a thrust.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
