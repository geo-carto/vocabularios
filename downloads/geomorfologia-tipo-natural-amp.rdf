  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-lacustres">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">objetos lacustres</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lacustrine features</skos:prefLabel>
    <skos:definition xml:lang="es">Paisajes geomorfológicos y formas del relieve relacionados con masas de agua interiores permanentes (lagos).</skos:definition>
    <skos:definition xml:lang="en">Geomorphologic landscapes and landforms related to inland permanent water bodies (lakes).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objeto-geomorfologico-natural"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/area-endorreica-con-salinizacion-superficial-playa-salina"/>
