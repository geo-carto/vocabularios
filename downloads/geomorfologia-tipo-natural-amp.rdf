  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/banco-barra-con-cicatrices-de-acrecion-lateral">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">banco; barra con cicatrices de acreción lateral</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bar with lateral accretion scars</skos:prefLabel>
    <skos:definition xml:lang="es">Barra fluvial con marcas visibles de crecimiento lateral.</skos:definition>
    <skos:definition xml:lang="en">A fluvial bar with visible marks of lateral growth.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
