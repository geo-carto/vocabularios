    <skos:prefLabel xml:lang="en">shoulder; bench</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie subhorizontal que interrumpe una pendiente.</skos:definition>
    <skos:definition xml:lang="en">A subhorizontal surface interrupting a slope.</skos:definition>
