  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cono-proglaciar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">cono proglaciar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">proglacial cone</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito en forma de cono formado por aguas de fusión glaciar.</skos:definition>
    <skos:definition xml:lang="en">A cone-shaped deposit formed by glacial meltwater.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
