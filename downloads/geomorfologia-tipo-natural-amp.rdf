    <skos:prefLabel xml:lang="en">erosional terrace</skos:prefLabel>
    <skos:definition xml:lang="es">Terraza tallada en la roca sin depósito aluvial significativo.</skos:definition>
    <skos:definition xml:lang="en">A terrace carved into rock without significant alluvial deposit.</skos:definition>
