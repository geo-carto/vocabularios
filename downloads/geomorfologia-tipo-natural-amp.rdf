  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/facetas-triangulares-de-escarpe-de-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">facetas triangulares de escarpe de falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">triangular facets of fault scarp</skos:prefLabel>
    <skos:definition xml:lang="es">Superficies triangulares en la ladera de un escarpe de falla producidas por la intersección de valles transversales.</skos:definition>
    <skos:definition xml:lang="en">Triangular surfaces on the slope of a fault scarp produced by the intersection of transverse valleys.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
