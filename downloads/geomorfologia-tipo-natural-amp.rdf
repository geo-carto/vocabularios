  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/corredor-rocoso-campo-de-rocas-rio-de-bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
