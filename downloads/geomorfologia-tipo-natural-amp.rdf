    <skos:prefLabel xml:lang="es">escarpe estructural en capas monoclinales (inferior a 25 metros); cuesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cuesta scarp (&lt;25 m)</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe de menos de 25 m en capas monoclinales formando una cuesta.</skos:definition>
    <skos:definition xml:lang="en">A scarp less than 25 m in monoclinal layers forming a cuesta.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural"/>
