  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/plataforma-de-abrasion-rasa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">plataforma de abrasión; rasa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wave-cut platform; strandflat</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie rocosa plana tallada por la erosión marina.</skos:definition>
    <skos:definition xml:lang="en">A flat rock surface carved by marine erosion.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros"/>
