  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/valle-o-vaguada-con-fondo-plano">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">valle o vaguada con fondo plano</skos:prefLabel>
    <skos:prefLabel xml:lang="en">flat-bottomed valley</skos:prefLabel>
    <skos:definition xml:lang="es">Valle fluvial con fondo plano ocupado por depósitos aluviales.</skos:definition>
    <skos:definition xml:lang="en">A fluvial valley with a flat bottom occupied by alluvial deposits.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
