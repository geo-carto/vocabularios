    <skos:prefLabel xml:lang="en">mountain ridge</skos:prefLabel>
    <skos:definition xml:lang="es">Cresta montañosa que constituye una divisoria de aguas.</skos:definition>
    <skos:definition xml:lang="en">A mountain crest that constitutes a watershed divide.</skos:definition>
