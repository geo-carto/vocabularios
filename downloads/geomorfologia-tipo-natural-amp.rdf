    <skos:prefLabel xml:lang="en">block-covered slope</skos:prefLabel>
    <skos:definition xml:lang="es">Vertiente cubierta por bloques rocosos procedentes de la parte superior.</skos:definition>
    <skos:definition xml:lang="en">A slope covered by rock blocks from the upper part.</skos:definition>
