  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/roca-aborregada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">roca aborregada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">roche moutonnée</skos:prefLabel>
    <skos:definition xml:lang="es">Afloramiento rocoso esculpido por abrasión glaciar, pulido en la cara de avance y arrancado en la cara opuesta.</skos:definition>
    <skos:definition xml:lang="en">Rock outcrop sculpted by glacial abrasion, polished on the advancing face and plucked on the opposite face.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
