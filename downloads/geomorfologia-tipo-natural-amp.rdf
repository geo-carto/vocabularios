    <skos:prefLabel xml:lang="es">campo de cenizas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ash field</skos:prefLabel>
    <skos:definition xml:lang="es">Zona cubierta por cenizas volcánicas.</skos:definition>
    <skos:definition xml:lang="en">An area covered by volcanic ash.</skos:definition>
