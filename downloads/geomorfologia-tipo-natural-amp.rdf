    <skos:prefLabel xml:lang="es">depresión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">depression</skos:prefLabel>
    <skos:definition xml:lang="es">Parte relativamente hundida de la superficie terrestre; especialmente, área baja rodeada de tierras más altas.</skos:definition>
    <skos:definition xml:lang="en">Any relatively sunken part of the Earth's surface; especially a low-lying area surrounded by higher ground.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/depression"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla-en-direccion-desgarre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">falla en dirección; desgarre</skos:prefLabel>
    <skos:prefLabel xml:lang="en">strike-slip fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla en la que el desplazamiento es predominantemente horizontal y paralelo al rumbo de la falla.</skos:definition>
    <skos:definition xml:lang="en">A fault in which the displacement is predominantly horizontal and parallel to the strike of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/charca-labajo-bodon-permanente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">charca; labajo; bodón permanente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">permanent pond</skos:prefLabel>
    <skos:definition xml:lang="es">Pequeña masa de agua estancada de carácter permanente.</skos:definition>
    <skos:definition xml:lang="en">A small permanent body of standing water.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-lacustres"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/morrena">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">morrena</skos:prefLabel>
    <skos:prefLabel xml:lang="en">moraine</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación de materiales transportados y depositados por un glaciar.</skos:definition>
    <skos:definition xml:lang="en">Accumulation of materials transported and deposited by a glacier.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/morrena-de-fondo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/morrena-lateral-o-central"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/morrena-frontal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/zona-intensamente-fracturada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">zona intensamente fracturada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intensely fractured zone</skos:prefLabel>
    <skos:definition xml:lang="es">Zona con una densidad muy elevada de fracturas que condiciona la morfología del terreno.</skos:definition>
    <skos:definition xml:lang="en">A zone with a very high density of fractures that conditions the terrain morphology.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/circo-glaciar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">circo glaciar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glacial cirque</skos:prefLabel>
    <skos:definition xml:lang="es">Depresión semicircular en forma de anfiteatro excavada por un glaciar en la cabecera de un valle.</skos:definition>
    <skos:definition xml:lang="en">A semicircular amphitheatre-shaped depression excavated by a glacier at the head of a valley.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/circo-glaciar-degradado"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
