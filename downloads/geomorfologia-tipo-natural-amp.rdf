  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/nicho-o-circo-de-nivacion-difuso-o-degradado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">nicho o circo de nivación difuso o degradado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diffuse or degraded nivation hollow</skos:prefLabel>
    <skos:definition xml:lang="es">Nicho de nivación cuya forma ha sido suavizada por erosión posterior.</skos:definition>
    <skos:definition xml:lang="en">A nivation hollow whose shape has been smoothed by subsequent erosion.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/nicho-o-circo-de-nivacion"/>
