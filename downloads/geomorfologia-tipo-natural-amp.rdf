    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna-estacional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna-colmatada-o-desecada"/>
    <adms:status>Válido</adms:status>
