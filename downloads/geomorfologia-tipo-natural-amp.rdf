    <skos:prefLabel xml:lang="es">llanura de marea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tidal flat</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie plana inundada periódicamente por las mareas.</skos:definition>
    <skos:definition xml:lang="en">A flat surface periodically flooded by tides.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros"/>
