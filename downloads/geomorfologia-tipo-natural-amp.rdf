    <skos:prefLabel xml:lang="en">interfluve ridges</skos:prefLabel>
    <skos:definition xml:lang="es">Crestas agudas que separan cauces fluviales adyacentes.</skos:definition>
    <skos:definition xml:lang="en">Sharp ridges separating adjacent fluvial channels.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
