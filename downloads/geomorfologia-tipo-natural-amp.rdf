    <skos:prefLabel xml:lang="es">colada de lava</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lava flow</skos:prefLabel>
    <skos:definition xml:lang="es">Masa de lava que fluye o ha fluido sobre la superficie del terreno.</skos:definition>
    <skos:definition xml:lang="en">A mass of lava that flows or has flowed over the ground surface.</skos:definition>
