    <skos:prefLabel xml:lang="es">borde de caldera degradado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">degraded caldera rim</skos:prefLabel>
    <skos:definition xml:lang="es">Borde de caldera volcánica parcialmente destruido por erosión.</skos:definition>
    <skos:definition xml:lang="en">A volcanic caldera rim partially destroyed by erosion.</skos:definition>
