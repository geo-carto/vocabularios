  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/drumlin">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">drumlin</skos:prefLabel>
    <skos:prefLabel xml:lang="en">drumlin</skos:prefLabel>
    <skos:definition xml:lang="es">Colina alargada de materiales glaciares con forma de cuchara invertida, orientada en la dirección del flujo del hielo.</skos:definition>
    <skos:definition xml:lang="en">An elongated hill of glacial materials shaped like an inverted spoon, oriented in the ice flow direction.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna-estacional">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">laguna estacional</skos:prefLabel>
    <skos:prefLabel xml:lang="en">seasonal lagoon</skos:prefLabel>
    <skos:definition xml:lang="es">Laguna que se seca en determinadas épocas del año.</skos:definition>
    <skos:definition xml:lang="en">A lagoon that dries up during certain times of the year.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna"/>
    <adms:status>Válido</adms:status>
