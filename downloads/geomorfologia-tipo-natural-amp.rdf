    <skos:prefLabel xml:lang="es">escarpe de línea de falla en retroceso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">retreating fault-line scarp</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe de falla cuya posición se desplaza progresivamente por retroceso erosivo.</skos:definition>
    <skos:definition xml:lang="en">A fault-line scarp whose position progressively shifts due to erosional retreat.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla"/>
