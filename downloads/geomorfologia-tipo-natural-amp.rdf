    <skos:prefLabel xml:lang="es">escarpe estructural en capas horizontales (superior a 100 metros)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">structural scarp in horizontal layers (&gt;100 m)</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe de más de 100 m de altura en capas horizontales.</skos:definition>
    <skos:definition xml:lang="en">A scarp over 100 m high in horizontal layers.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural"/>
