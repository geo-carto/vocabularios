    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">frente montañoso lineal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">linear mountain front</skos:prefLabel>
    <skos:definition xml:lang="es">Frente montañoso de trazado rectilíneo controlado por una falla o estructura tectónica.</skos:definition>
    <skos:definition xml:lang="en">A mountain front with a rectilinear trace controlled by a fault or tectonic structure.</skos:definition>
