    <skos:prefLabel xml:lang="en">lateral or medial moraine</skos:prefLabel>
    <skos:definition xml:lang="es">Morrena depositada en los flancos o en el centro de un glaciar.</skos:definition>
    <skos:definition xml:lang="en">Moraine deposited on the flanks or centre of a glacier.</skos:definition>
