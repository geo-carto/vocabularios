  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/barra-de-arena">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">barra de arena</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sand bar</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación alargada de arena sumergida o parcialmente emergida.</skos:definition>
    <skos:definition xml:lang="en">An elongated sand accumulation submerged or partially emerged.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros"/>
