    <skos:prefLabel xml:lang="es">dirección del viento dominante</skos:prefLabel>
    <skos:prefLabel xml:lang="en">prevailing wind direction</skos:prefLabel>
    <skos:definition xml:lang="es">Dirección predominante del viento en la zona litoral.</skos:definition>
    <skos:definition xml:lang="en">Predominant wind direction in the coastal area.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros"/>
