    <skos:prefLabel xml:lang="en">U-shaped valley limit</skos:prefLabel>
    <skos:definition xml:lang="es">Límite topográfico de un valle glaciar con perfil transversal en U.</skos:definition>
    <skos:definition xml:lang="en">Topographic limit of a glacial valley with a U-shaped cross section.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
