    <skos:prefLabel xml:lang="es">Colección - Eólico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Aeolian</skos:prefLabel>
    <skos:definition xml:lang="es">Colección que agrupa formas generadas por la acción del viento, incluyendo procesos de erosión, transporte y deposición de sedimentos.</skos:definition>
    <skos:definition xml:lang="en">Collection of geomorphological features generated by wind action, including erosion, transport, and deposition of sediments.</skos:definition>
