  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/anillos-o-circulos-de-piedra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">anillos o círculos de piedra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stone circles</skos:prefLabel>
    <skos:definition xml:lang="es">Patrones circulares de piedras formados por procesos de hielo-deshielo.</skos:definition>
    <skos:definition xml:lang="en">Circular stone patterns formed by freeze-thaw processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
