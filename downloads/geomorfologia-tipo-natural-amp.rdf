    <skos:prefLabel xml:lang="en">poorly defined watershed</skos:prefLabel>
    <skos:definition xml:lang="es">Divisoria de aguas de trazado difuso y difícil de localizar con precisión.</skos:definition>
    <skos:definition xml:lang="en">A watershed divide with a diffuse trace, difficult to locate precisely.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
