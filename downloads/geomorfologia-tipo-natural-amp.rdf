  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/surcos-lineas-de-crecimiento-del-cordon-litoral">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">surcos; líneas de crecimiento del cordón litoral</skos:prefLabel>
    <skos:prefLabel xml:lang="en">beach ridge growth lines</skos:prefLabel>
    <skos:definition xml:lang="es">Marcas que indican las fases de crecimiento de un cordón litoral.</skos:definition>
    <skos:definition xml:lang="en">Marks indicating the growth phases of a beach ridge.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros"/>
