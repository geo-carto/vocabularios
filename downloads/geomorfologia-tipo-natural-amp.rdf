    <skos:prefLabel xml:lang="en">proglacial terrace</skos:prefLabel>
    <skos:definition xml:lang="es">Terraza formada por depósitos fluvioglaciares.</skos:definition>
    <skos:definition xml:lang="en">A terrace formed by fluvioglacial deposits.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
