    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/turbera-en-ambiente-lacustre"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpeescarpe-en-ambiente-lacustre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/lacustrine"/>
