  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/limite-de-valle-en-artesa-degradado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">límite de valle en artesa degradado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">degraded U-shaped valley limit</skos:prefLabel>
    <skos:definition xml:lang="es">Límite de un valle glaciar en artesa suavizado por erosión posterior.</skos:definition>
    <skos:definition xml:lang="en">Limit of a U-shaped glacial valley smoothed by subsequent erosion.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
