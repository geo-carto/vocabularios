  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/depresion-intralavica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">depresión intralávica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intralava depression</skos:prefLabel>
    <skos:definition xml:lang="es">Depresión formada dentro de una colada de lava por colapso o deflación.</skos:definition>
    <skos:definition xml:lang="en">A depression formed within a lava flow by collapse or deflation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
