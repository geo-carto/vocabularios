  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-entre-25-y-100-metros">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">acantilado entre 25 y 100 metros</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cliff 25-100 m</skos:prefLabel>
    <skos:definition xml:lang="es">Acantilado costero de entre 25 y 100 metros de altura.</skos:definition>
    <skos:definition xml:lang="en">A coastal cliff between 25 and 100 metres high.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado"/>
