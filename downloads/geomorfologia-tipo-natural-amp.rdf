  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-fosil">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">escarpe fosil</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fossil scarp</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe lacustre que ya no está en contacto con una masa de agua.</skos:definition>
    <skos:definition xml:lang="en">A lacustrine scarp no longer in contact with a water body.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-lacustres"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ruptura-de-pendiente-debido-a-reflejos-de-antiguos-bordes-de-crateres">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">ruptura de pendiente debido a reflejos de antiguos bordes de cráteres</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slope break due to ancient crater rim remnants</skos:prefLabel>
    <skos:definition xml:lang="es">Cambio de pendiente asociado a restos de antiguos bordes de cráteres volcánicos.</skos:definition>
    <skos:definition xml:lang="en">Slope change associated with remnants of ancient volcanic crater rims.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
