  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/deslizamiento-cartografiable">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">deslizamiento cartografiable</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mappable landslide</skos:prefLabel>
    <skos:definition xml:lang="es">Deslizamiento de dimensiones suficientes para ser representado en un mapa.</skos:definition>
    <skos:definition xml:lang="en">A landslide of sufficient dimensions to be represented on a map.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/deslizamiento"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/valle-de-fractura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">valle de fractura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fracture valley</skos:prefLabel>
    <skos:definition xml:lang="es">Valle excavado a favor de una zona de fractura o falla.</skos:definition>
    <skos:definition xml:lang="en">A valley carved along a fracture zone or fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
