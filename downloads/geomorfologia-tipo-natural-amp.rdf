  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/lajamiento-sheeting">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">lajamiento; sheeting</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sheeting</skos:prefLabel>
    <skos:definition xml:lang="es">Fracturación de la roca en láminas paralelas a la superficie topográfica.</skos:definition>
    <skos:definition xml:lang="en">Rock fracturing into sheets parallel to the topographic surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-relacionados-con-las-laderas-y-con-la-gravedad"/>
