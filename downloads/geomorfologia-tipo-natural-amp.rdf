    <skos:definition xml:lang="es">Zona de arranque de una avalancha de nieve.</skos:definition>
    <skos:definition xml:lang="en">Starting zone of a snow avalanche.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cabecera-de-avalancha-o-alud-difuso-o-degradado"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/pedimento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">pedimento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pediment</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie erosiva de baja pendiente desarrollada al pie de un relieve montañoso, generalmente con un perfil algo cóncavo hacia arriba, que corta los estratos de roca o de sedimentos que se extienden bajo las tierras altas adyacentes.</skos:definition>
    <skos:definition xml:lang="en">A gently sloping erosional surface developed at the foot of a receding hill or mountain slope, commonly with a slightly concave-upward profile, that cross-cuts rock or sediment strata that extend beneath adjacent uplands.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/pediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-inferior-a-25-metros">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">acantilado inferior a 25 metros</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cliff less than 25 m</skos:prefLabel>
    <skos:definition xml:lang="es">Acantilado costero de menos de 25 metros de altura.</skos:definition>
    <skos:definition xml:lang="en">A coastal cliff less than 25 metres high.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/limite-de-cuenca-endorreica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">límite de cuenca endorréica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">endorheic basin limit</skos:prefLabel>
    <skos:definition xml:lang="es">Divisoria que delimita una cuenca sin drenaje al mar.</skos:definition>
    <skos:definition xml:lang="en">Divide delimiting a basin without drainage to the sea.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-lacustres"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/vertiente-con-surcos-de-erosion-rills">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">vertiente con surcos de erosión (rills)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slope with rills</skos:prefLabel>
    <skos:definition xml:lang="es">Vertiente con pequeños surcos lineales formados por escorrentía superficial.</skos:definition>
    <skos:definition xml:lang="en">A slope with small linear grooves formed by surface runoff.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-relacionados-con-las-laderas-y-con-la-gravedad"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cuerda-o-divisoria-montanyosa-redondeada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">cuerda o divisoria montañosa redondeada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rounded mountain divide</skos:prefLabel>
    <skos:definition xml:lang="es">Divisoria de aguas con perfil redondeado y suave.</skos:definition>
    <skos:definition xml:lang="en">A watershed divide with a rounded and gentle profile.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/area-pantanosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">área pantanosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">marshy area</skos:prefLabel>
    <skos:definition xml:lang="es">Zona con suelo permanentemente saturado de agua.</skos:definition>
    <skos:definition xml:lang="en">An area with permanently waterlogged soil.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-lacustres"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/turbera-en-ambiente-glaciar-y-periglaciar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">turbera en ambiente lacustra glaciar y periglaciar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peat bog</skos:prefLabel>
    <skos:definition xml:lang="es">Zona pantanosa con acumulación de materia orgánica parcialmente descompuesta (turba).</skos:definition>
    <skos:definition xml:lang="en">Marshy area with accumulation of partially decomposed organic matter (peat).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/forma-erosiva">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">forma erosiva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">destructional feature</skos:prefLabel>
    <skos:definition xml:lang="es">Forma de relieve que debe su origen, su forma, su posición o su carácter general a procesos de eliminación de material por erosión o meteorización (degradación) resultantes del desgaste de la superficie terrestre.</skos:definition>
    <skos:definition xml:lang="en">Site of a landform that owes its origin, form, position, or general character to the removal of material by erosion and weathering (degradation) processes resulting from the wearing-down or away of the land surface.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/destructionalFeature"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/zona-o-superficie-de-pulido-y-abrasion-con-indicacion-de-flujo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">zona o superficie de pulido y abrasión con indicación de flujo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polished and abraded surface with flow indication</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie glacialmente pulida con estrías que indican la dirección del flujo del hielo.</skos:definition>
    <skos:definition xml:lang="en">Glacially polished surface with striations indicating ice flow direction.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">acantilado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cliff</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe vertical o subvertical costero tallado por erosión marina.</skos:definition>
    <skos:definition xml:lang="en">A vertical or subvertical coastal scarp carved by marine erosion.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-inferior-a-25-metros"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-entre-25-y-100-metros"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-superior-a-100-metros"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-fosil"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-dunas-cordon-de-dunas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">campo de dunas; cordón de dunas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dune field; dune ridge</skos:prefLabel>
    <skos:definition xml:lang="es">Zona con acumulaciones de arena formadas por el viento.</skos:definition>
    <skos:definition xml:lang="en">Area with sand accumulations formed by the wind.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-eolicos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-dunas-con-vegetacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-dunas-fosiles"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-inferior-a-25-metros">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">escarpe inferior a 25 metros</skos:prefLabel>
    <skos:prefLabel xml:lang="en">scarp less than 25 m</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe fluvial de menos de 25 metros de altura.</skos:definition>
    <skos:definition xml:lang="en">A fluvial scarp less than 25 metres high.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-fluvial"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-fosil">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">acantilado fósil</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fossil cliff</skos:prefLabel>
    <skos:definition xml:lang="es">Acantilado relicto separado de la línea de costa actual.</skos:definition>
    <skos:definition xml:lang="en">A relict cliff separated from the current coastline.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cima-de-montaña">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">cima de montaña</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mountaintop</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento geomorfológico de una montaña constituido por el nivel relativamente más elevado y caracterizado por pendientes relativamente cortas y sencillas compuestas por roca desnuda, residuos o sedimentos coluviales transportados desde corta distancia.</skos:definition>
    <skos:definition xml:lang="en">A geomorphologic component of mountains consisting of the uppermost, comparatively level or gently sloped area of mountains, characterized by relatively short, simple slopes composed of bare rock, residuum, or short-transport colluvial sediments.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/mountaintop"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-exhumado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">escarpe de línea de falla exhumado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">exhumed fault-line scarp</skos:prefLabel>
    <skos:definition xml:lang="es">Escarpe de falla que ha sido re-expuesto tras haber estado cubierto por materiales más recientes.</skos:definition>
    <skos:definition xml:lang="en">A fault-line scarp re-exposed after having been covered by younger materials.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-fluvial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">escarpe fluvial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fluvial scarp</skos:prefLabel>
    <skos:definition xml:lang="es">Talud vertical o subvertical tallado por la acción erosiva de un río.</skos:definition>
    <skos:definition xml:lang="en">Vertical or subvertical slope carved by river erosive action.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-inferior-a-25-metros"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-entre-25-100-metros"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-superior-a-100-metros"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/collado-de-difluencia-glaciar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">collado de difluencia glaciar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glacial diffluence col</skos:prefLabel>
    <skos:definition xml:lang="es">Paso entre dos valles por donde un glaciar desborda hacia un valle adyacente.</skos:definition>
    <skos:definition xml:lang="en">A pass between two valleys where a glacier overflows into an adjacent valley.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/incision-dominada-por-sufusion-piping">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">incisión dominada por sufusión; piping</skos:prefLabel>
    <skos:prefLabel xml:lang="en">piping-dominated incision</skos:prefLabel>
    <skos:definition xml:lang="es">Incisión del terreno dominada por procesos de erosión interna (piping).</skos:definition>
    <skos:definition xml:lang="en">Terrain incision dominated by internal erosion processes (piping).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/surgencia-por-sufusion-piping">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">surgencia por sufusión; piping</skos:prefLabel>
    <skos:prefLabel xml:lang="en">piping spring</skos:prefLabel>
    <skos:definition xml:lang="es">Surgencia de agua producida por erosión interna del terreno.</skos:definition>
    <skos:definition xml:lang="en">Water emergence produced by internal terrain erosion.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canal-de-marea-abandonado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">canal de marea abandonado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">abandoned tidal channel</skos:prefLabel>
    <skos:definition xml:lang="es">Canal de marea que ya no es funcional.</skos:definition>
    <skos:definition xml:lang="en">A tidal channel that is no longer functional.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canal-de-marea"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/gruta-jameo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">gruta; jameo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">grotto; jameo</skos:prefLabel>
    <skos:definition xml:lang="es">Cavidad de origen volcánico, frecuentemente asociada a un tubo de lava colapsado.</skos:definition>
    <skos:definition xml:lang="en">A cavity of volcanic origin, frequently associated with a collapsed lava tube.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/base-del-talud">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">base del talud</skos:prefLabel>
    <skos:prefLabel xml:lang="en">base slope</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento geomorfológico de una colina constituido por una pendiente cóncava lineal (perpendicular al contorno) que, independientemente de la pendiente lateral, forma un saliente o cuña al pie de una colina, dominado por procesos coluviales y de lavado de la pendiente y por la deposición de sedimentos</skos:definition>
    <skos:definition xml:lang="en">A geomorphologic component of hills consisting of the concave to linear slope (perpendicular to the contour) which, regardless of the lateral shape, is an area that forms an apron or wedge at the bottom of a hillside dominated by colluvial and slope wash processes and sediments</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/baseSlope"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/marisma-baja-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">marisma baja arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy low marsh</skos:prefLabel>
    <skos:definition xml:lang="es">Marisma baja con substrato arenoso.</skos:definition>
    <skos:definition xml:lang="en">Low marsh with a sandy substrate.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/marisma-baja-slikke"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/base-de-montaña">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">base de montaña</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mountainbase</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento geomorfológico de una montaña constituido por una falda o cuña coluvial, firme o aproximadamente cóncava, situada al pie de las pendientes.</skos:definition>
    <skos:definition xml:lang="en">A geomorphologic component of mountains consisting of the strongly to slightly concave colluvial apron or wedge at the bottom of mountain slopes.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/mountainbase"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/meteorizacion-en-general">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">meteorización en general</skos:prefLabel>
    <skos:prefLabel xml:lang="en">weathering (general)</skos:prefLabel>
    <skos:definition xml:lang="es">Procesos de alteración de la roca por agentes atmosféricos y químicos.</skos:definition>
    <skos:definition xml:lang="en">Rock alteration processes by atmospheric and chemical agents.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica"/>
