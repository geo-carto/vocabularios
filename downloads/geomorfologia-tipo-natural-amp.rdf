  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/garganta-canyon-fluvial-desfiladero">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">garganta; cañón fluvial; desfiladero</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gorge; fluvial canyon</skos:prefLabel>
    <skos:definition xml:lang="es">Valle muy estrecho y profundo con paredes verticales o subverticales.</skos:definition>
    <skos:definition xml:lang="en">A very narrow and deep valley with vertical or subvertical walls.</skos:definition>
