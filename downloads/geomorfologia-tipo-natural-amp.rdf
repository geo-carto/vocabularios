  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo-y-dorso-de-ballena">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">domo y dorso de ballena</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dome and whaleback</skos:prefLabel>
    <skos:definition xml:lang="es">Forma redondeada en roca desnuda producida por meteorización.</skos:definition>
    <skos:definition xml:lang="en">A rounded form in bare rock produced by weathering.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica"/>
