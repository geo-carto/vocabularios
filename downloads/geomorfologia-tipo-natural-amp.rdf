  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/pico-principal-aguja-horn">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">pico principal; aguja; horn</skos:prefLabel>
    <skos:prefLabel xml:lang="en">main peak; horn</skos:prefLabel>
    <skos:definition xml:lang="es">Cima aguda y prominente en un relieve poligénico.</skos:definition>
    <skos:definition xml:lang="en">Sharp and prominent summit in a polygenetic relief.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion"/>
