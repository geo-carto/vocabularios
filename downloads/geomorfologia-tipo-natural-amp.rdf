    <skos:prefLabel xml:lang="en">glacial transfluence col</skos:prefLabel>
    <skos:definition xml:lang="es">Paso por donde el hielo de un glaciar principal fluye hacia un valle adyacente.</skos:definition>
    <skos:definition xml:lang="en">A pass where ice from a main glacier flows into an adjacent valley.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
