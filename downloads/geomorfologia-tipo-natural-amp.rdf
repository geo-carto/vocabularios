    <skos:prefLabel xml:lang="es">playa de arena</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sand beach</skos:prefLabel>
    <skos:definition xml:lang="es">Playa constituida principalmente por arena.</skos:definition>
    <skos:definition xml:lang="en">A beach mainly composed of sand.</skos:definition>
