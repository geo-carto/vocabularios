  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/caidas-de-bloques-desprendimientos-derrumbes">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">caídas de bloques; desprendimientos; derrumbes</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rockfall; rock collapse</skos:prefLabel>
    <skos:definition xml:lang="es">Desprendimiento de bloques rocosos de un escarpe o pared.</skos:definition>
    <skos:definition xml:lang="en">Detachment of rock blocks from a scarp or wall.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-relacionados-con-las-laderas-y-con-la-gravedad"/>
