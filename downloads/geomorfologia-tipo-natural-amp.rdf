  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/zona-de-rompiente-zona-intermareal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">zona de rompiente; zona intermareal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">surf zone; intertidal zone</skos:prefLabel>
    <skos:definition xml:lang="es">Franja litoral entre los niveles de marea alta y baja.</skos:definition>
    <skos:definition xml:lang="en">Coastal strip between high and low tide levels.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros"/>
