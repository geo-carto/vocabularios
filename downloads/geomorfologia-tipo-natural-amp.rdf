    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">objeto geomorfológico natural</skos:prefLabel>
    <skos:prefLabel xml:lang="en">natural geomorphologic feature</skos:prefLabel>
    <skos:definition xml:lang="es">Objeto geomorfológico producido por la dinámica natural.</skos:definition>
    <skos:definition xml:lang="en">A geomorphologic feature produced by the natural dynamics.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
