  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp/collection/coleccion-gravitacional">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">Colección - Gravitacional</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Gravitational</skos:prefLabel>
    <skos:definition xml:lang="es">Colección que agrupa formas producidas por movimientos en masa debidos a la gravedad, como deslizamientos, caídas o flujos, que implican el desplazamiento de materiales ladera abajo.</skos:definition>
    <skos:definition xml:lang="en">Collection of geomorphological features produced by gravity-driven mass movements such as landslides, falls, or flows, involving downslope displacement of materials.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acarcavamiento-embrionario"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/caidas-de-bloques-desprendimientos-derrumbes"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cambio-brusco-de-pendiente"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canchal-pedriza"/>
