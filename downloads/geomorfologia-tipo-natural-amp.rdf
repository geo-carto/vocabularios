    <skos:prefLabel xml:lang="es">geiser</skos:prefLabel>
    <skos:prefLabel xml:lang="en">geyser</skos:prefLabel>
    <skos:definition xml:lang="es">Fuente termal que emite periódicamente chorros de agua caliente y vapor.</skos:definition>
    <skos:definition xml:lang="en">A thermal spring that periodically emits jets of hot water and steam.</skos:definition>
