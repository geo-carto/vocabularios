  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/area-con-cesped-almohadillado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">área con césped almohadillado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tussock area</skos:prefLabel>
    <skos:definition xml:lang="es">Zona con montículos de vegetación en cojín típicos de ambientes fríos.</skos:definition>
    <skos:definition xml:lang="en">Area with cushion vegetation mounds typical of cold environments.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
