  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/derrumbe-avalancha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">derrumbe; avalancha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rock avalanche</skos:prefLabel>
    <skos:definition xml:lang="es">Movimiento rápido y masivo de rocas y derrubios ladera abajo.</skos:definition>
    <skos:definition xml:lang="en">Rapid and massive downslope movement of rocks and debris.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-relacionados-con-las-laderas-y-con-la-gravedad"/>
