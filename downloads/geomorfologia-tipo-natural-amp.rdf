    <skos:prefLabel xml:lang="es">surgencia lávica bajo colada solidificada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lava upwelling beneath solidified flow</skos:prefLabel>
    <skos:definition xml:lang="es">Salida de lava fluida bajo la costra solidificada de una colada.</skos:definition>
    <skos:definition xml:lang="en">Fluid lava emerging beneath the solidified crust of a flow.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
