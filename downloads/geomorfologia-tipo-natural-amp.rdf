    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">relieve residual; monadnok</skos:prefLabel>
    <skos:prefLabel xml:lang="en">residual relief; monadnock</skos:prefLabel>
    <skos:definition xml:lang="es">Relieve aislado que sobresale de una superficie de erosión.</skos:definition>
    <skos:definition xml:lang="en">Isolated relief rising above an erosion surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/manto-proglaciar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">manto proglaciar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">proglacial outwash plain</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito extenso y plano formado por aguas de fusión glaciar.</skos:definition>
    <skos:definition xml:lang="en">An extensive flat deposit formed by glacial meltwater.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ladera-con-reptacion-creep">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">ladera con reptación; creep</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slope with creep</skos:prefLabel>
    <skos:definition xml:lang="es">Vertiente afectada por movimiento lento y continuo del suelo por ciclos de hielo-deshielo.</skos:definition>
    <skos:definition xml:lang="en">A slope affected by slow continuous soil movement due to freeze-thaw cycles.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canal-principal-cauce-activo-en-grandes-rios-limite-del-lecho">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">canal principal; cauce activo en grandes ríos; límite del lecho</skos:prefLabel>
    <skos:prefLabel xml:lang="en">main channel; active bed limit</skos:prefLabel>
    <skos:definition xml:lang="es">Cauce principal de un río o límite del lecho activo.</skos:definition>
    <skos:definition xml:lang="en">Main channel of a river or limit of the active bed.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-o-rellano-de-crioplanacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">superficie o rellano de crioplanación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cryoplanation surface</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie plana formada por procesos de crioplanación en ambiente periglaciar.</skos:definition>
    <skos:definition xml:lang="en">Flat surface formed by cryoplanation processes in a periglacial environment.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
