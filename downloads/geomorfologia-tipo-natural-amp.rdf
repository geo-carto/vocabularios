    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">objetos volcánicos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcanic features</skos:prefLabel>
    <skos:definition xml:lang="es">Paisajes geomorfológicos y formas del relieve relativos a procesos ígneos en virtud de los cuales magma y gases asociados atraviesan la corteza y son expulsados sobre la superficie terrestre y a la atmósfera.</skos:definition>
    <skos:definition xml:lang="en">Geomorphologic landscapes and landforms related to the deep seated (igneous) processes by which magma and associated gases rise through the crust and are extruded onto the earth's surface and into the atmosphere.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objeto-geomorfologico-natural"/>
