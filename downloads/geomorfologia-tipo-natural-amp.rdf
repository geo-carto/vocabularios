  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/umbral-neto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">umbral neto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">distinct threshold</skos:prefLabel>
    <skos:definition xml:lang="es">Resalte rocoso bien definido en el lecho de un valle glaciar.</skos:definition>
    <skos:definition xml:lang="en">A well-defined rocky step in the floor of a glacial valley.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
