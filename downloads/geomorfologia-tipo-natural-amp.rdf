    <skos:prefLabel xml:lang="en">carbonation</skos:prefLabel>
    <skos:definition xml:lang="es">Formación de costras o acumulaciones de carbonato por precipitación.</skos:definition>
    <skos:definition xml:lang="en">Formation of carbonate crusts or accumulations by precipitation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica"/>
