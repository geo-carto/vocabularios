    <skos:prefLabel xml:lang="es">monte isla lineal; cresta; barra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">linear inselberg; ridge</skos:prefLabel>
    <skos:definition xml:lang="es">Inselberg de forma alargada y estrecha.</skos:definition>
    <skos:definition xml:lang="en">An elongated and narrow inselberg.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monte-isla-relieve-aislado-inselberg"/>
