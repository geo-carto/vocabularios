    <skos:prefLabel xml:lang="en">abandoned channel; abandoned meander</skos:prefLabel>
    <skos:definition xml:lang="es">Antiguo cauce o meandro que ya no es funcional.</skos:definition>
    <skos:definition xml:lang="en">A former channel or meander that is no longer functional.</skos:definition>
