    <skos:prefLabel xml:lang="es">cicatriz de deslizamiento inducido por actividad volcánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcano-induced landslide scar</skos:prefLabel>
    <skos:definition xml:lang="es">Cicatriz de un deslizamiento provocado por actividad volcánica.</skos:definition>
    <skos:definition xml:lang="en">Scar of a landslide caused by volcanic activity.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
