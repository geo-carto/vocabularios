  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/resalte-de-diques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">resalte de diques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dyke ridge</skos:prefLabel>
    <skos:definition xml:lang="es">Resalte topográfico causado por erosión diferencial de un dique volcánico resistente.</skos:definition>
    <skos:definition xml:lang="en">A topographic ridge caused by differential erosion of a resistant volcanic dyke.</skos:definition>
