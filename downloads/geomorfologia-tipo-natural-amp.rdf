  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/roca-aislada-pinaculo-rocoso-tor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">roca aislada; pináculo rocoso; tor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tor; isolated rock pillar</skos:prefLabel>
    <skos:definition xml:lang="es">Relieve residual aislado formado por meteorización diferencial.</skos:definition>
    <skos:definition xml:lang="en">An isolated residual relief formed by differential weathering.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica"/>
