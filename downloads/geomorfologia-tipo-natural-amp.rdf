  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/confluencia-anomala-de-cauces">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">confluencia anómala de cauces</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anomalous channel confluence</skos:prefLabel>
    <skos:definition xml:lang="es">Unión de cauces fluviales con un ángulo o disposición inusual que sugiere control estructural.</skos:definition>
    <skos:definition xml:lang="en">Junction of fluvial channels with an unusual angle or arrangement suggesting structural control.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla-supuesta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">falla supuesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla cuya existencia se deduce de evidencias indirectas pero no se ha observado directamente.</skos:definition>
    <skos:definition xml:lang="en">A fault whose existence is inferred from indirect evidence but has not been directly observed.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales"/>
