    <skos:prefLabel xml:lang="en">gully head</skos:prefLabel>
    <skos:definition xml:lang="es">Parte superior de una cárcava donde se produce el retroceso erosivo.</skos:definition>
    <skos:definition xml:lang="en">Upper part of a gully where erosional retreat occurs.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/carcavas"/>
