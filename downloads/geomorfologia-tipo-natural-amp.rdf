  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cono-de-piroclastos-degradado-con-centro-de-emision">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">cono de piroclastos degradado con centro de emisión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">degraded pyroclastic cone with emission centre</skos:prefLabel>
    <skos:definition xml:lang="es">Cono de piroclastos cuya morfología ha sido degradada por erosión, conservando el centro de emisión.</skos:definition>
    <skos:definition xml:lang="en">A pyroclastic cone whose morphology has been degraded by erosion, preserving the emission centre.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-fluvioglaciares-y-de-permafrost">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">objetos glaciales, fluvioglaciares y de permafrost</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nival, periglacial and permafrost features</skos:prefLabel>
    <skos:definition xml:lang="es">Paisajes geomorfológicos y formas del relieve relativos a entornos de clima frío, con nieve, pero no glaciales; paisajes geomorfológicos y formas de relieve próximos a glaciares y placas de hielo; paisajes geomorfológicos y formas del relieve relativos a tierras, suelos o rocas que se mantienen a 0º C o menos durante dos años como mínimo.</skos:definition>
    <skos:definition xml:lang="en">Geomorphologic landscapes and landforms related to snow, non-glacial, cold climate environments; geomorphologic landscapes and landforms occurring in the vicinity of glaciers and ice sheets; geomorphologic landscapes and landforms related to ground, soil, or rock that remains at or below 0º C for at least two years.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objeto-geomorfologico-natural"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/nivalPeriglacialPermafrost"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna-colmatada-o-desecada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">laguna colmatada o desecada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">infilled or desiccated lagoon</skos:prefLabel>
    <skos:definition xml:lang="es">Laguna rellenada por sedimentos o desecada.</skos:definition>
    <skos:definition xml:lang="en">A lagoon filled with sediments or desiccated.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna"/>
