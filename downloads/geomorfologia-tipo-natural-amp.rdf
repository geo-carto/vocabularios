    <skos:prefLabel xml:lang="es">arista o divisoria montañosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mountain ridge; divide</skos:prefLabel>
    <skos:definition xml:lang="es">Cresta estrecha y aguda que separa cuencas hidrográficas en zonas montañosas.</skos:definition>
    <skos:definition xml:lang="en">A narrow and sharp crest separating drainage basins in mountainous areas.</skos:definition>
