  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/perdida-de-drenaje">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">pérdida de drenaje</skos:prefLabel>
    <skos:prefLabel xml:lang="en">drainage loss</skos:prefLabel>
    <skos:definition xml:lang="es">Punto donde un cauce fluvial pierde agua por infiltración.</skos:definition>
    <skos:definition xml:lang="en">Point where a river channel loses water by infiltration.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales"/>
