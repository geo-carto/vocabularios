  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/vertiente-de-bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">vertiente de bloques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">block slope</skos:prefLabel>
    <skos:definition xml:lang="es">Vertiente cubierta por bloques rocosos producidos por gelifracción.</skos:definition>
    <skos:definition xml:lang="en">A slope covered by rock blocks produced by frost shattering.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-glaciofluviales-glaciolacustres-y-glaciomarinos"/>
