    <skos:prefLabel xml:lang="en">weathering microforms</skos:prefLabel>
    <skos:definition xml:lang="es">Formas de pequeña escala producidas por meteorización en superficies rocosas.</skos:definition>
    <skos:definition xml:lang="en">Small-scale forms produced by weathering on rock surfaces.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica"/>
