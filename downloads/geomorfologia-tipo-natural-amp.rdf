  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/area-acarcavada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural-amp"/>
    <skos:prefLabel xml:lang="es">área acarcavada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gullied area</skos:prefLabel>
    <skos:definition xml:lang="es">Zona con una alta densidad de cárcavas.</skos:definition>
    <skos:definition xml:lang="en">An area with a high density of gullies.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/carcavas"/>
