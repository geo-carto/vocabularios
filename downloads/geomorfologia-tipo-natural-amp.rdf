    <skos:prefLabel xml:lang="en">captured doline</skos:prefLabel>
    <skos:definition xml:lang="es">Dolina conectada al drenaje superficial por captura.</skos:definition>
    <skos:definition xml:lang="en">A doline connected to surface drainage by capture.</skos:definition>
