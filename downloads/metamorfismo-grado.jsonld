      {
        "@language": "es",
        "@value": "Roca o sedimento no metamorfizado."
      },
      {
        "@language": "en",
        "@value": "Rock or sediment not metamorphosed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/metamorphicgrade/not_metamorphosed"
