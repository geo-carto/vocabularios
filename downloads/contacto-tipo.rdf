   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo"/>
    <skos:prefLabel xml:lang="es">contacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contact</skos:prefLabel>
    <skos:definition xml:lang="es">Una superficie que separa unidades geológicas. Concepto muy general que representa cualquier tipo de superficie que separa dos unidades geológicas, incluyendo límites primarios como contactos deposicionales, discordancias, contactos intrusivos y contactos gradacionales, así como todo tipo de fallas.</skos:definition>
    <skos:definition xml:lang="en">A surface that separates geologic units. Very general concept representing any kind of surface separating two geologic units, including primary boundaries such as depositional contacts, all kinds of unconformities, intrusive contacts, and gradational contacts, as well as faults that separate geologic units.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-de-zona-cronoestratigrafica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-por-falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-de-provincia-geologica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-geofisico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/linea-glaciar-estacionaria"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-litogenetico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-mecanico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-diagenetico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-antropico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/contacttype/contact"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-intrusivo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo"/>
    <skos:prefLabel xml:lang="es">contacto intrusivo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">igneous intrusive contact</skos:prefLabel>
    <skos:definition xml:lang="es">Contacto intrusivo entre una roca ígnea más joven y una unidad geológica preexistente más antigua en la que ésta se ha intruído.</skos:definition>
    <skos:definition xml:lang="en">An intrusive contact between a younger igneous rock and an older, pre-existing geological unit into which it has been intruded.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-litogenetico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/contacttype/igneous_intrusive_contact"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contacto-tipo/limite-de-estructura-de-impacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo"/>
    <skos:prefLabel xml:lang="es">límite de estructura de impacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impact structure boundary</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie que delimita un cuerpo de roca afectado por un evento de impacto extraterrestre.</skos:definition>
    <skos:definition xml:lang="en">surface that bounds a body of rock affected by an extraterrestrial impact event</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-litogenetico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/contacttype/impact_structure_boundary"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-por-intrusion-de-material-sedimentario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo"/>
    <skos:prefLabel xml:lang="es">contacto por intrusión de material sedimentario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sedimentary intrusive contact</skos:prefLabel>
    <skos:definition xml:lang="es">Contacto intrusivo entre una unidad de roca sedimentaria y un sedimento plástico (p. ej. arcilla, marga, sal, yeso, etc.), forzado hacia arriba desde los depósitos subyacentes.</skos:definition>
    <skos:definition xml:lang="en">An intrusive contact between a sedimentary rock unit and plastic sediment (e.g., clay, chalk, salt, gypsum, etc.), forced upward into it from underlying sediment</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-litogenetico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/contacttype/sedimentary_intrusive_contact"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
