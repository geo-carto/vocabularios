    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-por-choque-termico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/falla-transformante"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-corriente-de-turbidez"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-vulcaniana"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion-del-agua"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion-del-viento"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/precipitacion-quimica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">precipitación química</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chemical precipitation</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de materia mineral por precipitación desde una solución o como resulultado de reacciones químicas. puede ser sedimentaria o hidrotermal.</skos:definition>
    <skos:definition xml:lang="en">The deposition of mineral matter by precipitation from solution or as a result of chemical reactions. may be sedimentary or hydrothermal.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-metamorfico"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/chemicalPrecipitation"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/chemical_precipitation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/subduccion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">subducción</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subduction</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso por el cual una placa litosférica desciende debajo de otra.</skos:definition>
    <skos:definition xml:lang="en">The process of one lithospheric plate descending beneath another</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/subduction"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/subduction"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/cristalizacion-magmatica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">cristalización magmática</skos:prefLabel>
    <skos:prefLabel xml:lang="en">magmatic crystallisation</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso por el cual se forma materia cristalina a partir de materia en estado gaseoso, fluido o disperso.</skos:definition>
    <skos:definition xml:lang="en">The process by which matter becomes crystalline, from a gaseous, fluid, or dispersed state</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-magmatico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/magmaticCrystallisation"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/magmatic_crystallisation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/variacion-del-nivel-del-mar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">variación del nivel del mar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sea level change</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de cambio del nivel medio del mar en relación con algún datum.</skos:definition>
    <skos:definition xml:lang="en">Process of mean sea level changing relative to some datum.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/caida-del-nivel-del-mar"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/ascenso-del-nivel-del-mar"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/seaLevelChange"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/sea_level_change"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-el-agua">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito desde el agua</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deposition from water</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de sedimento desde el agua, en la cual el sedimento ha sido transportado tras haber entrado en el agua en movimiento o tras haber sido depositado desde otros fluidos en movimiento.</skos:definition>
    <skos:definition xml:lang="en">Deposition of sediment from water, in which the sediment has been transported after entrainment in the moving water or after deposition from other moving fluids.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/depositionFromWater"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erosion-del-viento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erosión del viento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wind erosion</skos:prefLabel>
    <skos:definition xml:lang="es">Erosión causada por el impacto o piqueteo de clastos por movimiento de aire (viento).</skos:definition>
    <skos:definition xml:lang="en">Erosion by clast impact or plucking by moving air (wind)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/windErosion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/wind_erosion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-diagenetico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">proceso diagenético</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diagenetic process</skos:prefLabel>
    <skos:definition xml:lang="es">Cualquier proceso químico, físico o biológico que afecta a un material terrestre sedimentario después de su depósito inicial y durante o después de la litificación, con exclusión de la meteorización y el metamorfismo.</skos:definition>
    <skos:definition xml:lang="en">Any chemical, physical, or biological process that affects a sedimentary earth material after initial deposition, and during or after lithification, exclusive of weathering and metamorphism.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/diageneticProcess"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/diagenetic_process"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deformacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">deformación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deformation</skos:prefLabel>
    <skos:definition xml:lang="es">Movimiento de masas de roca por desplazamiento en zonas de falla o de cizalla, o cambio en la forma de una masa de material terrestre.</skos:definition>
    <skos:definition xml:lang="en">Movement of rock bodies by displacement on fault or shear zones, or change in shape of a body of earth material.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/flujo-ductil"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/fallamiento"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/plegamiento"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/fracturacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/cizallamiento"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/deformation"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/deformation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-flujo-en-masa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito por flujo en masa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">debris flow deposition</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de depósito laminar de alta concentración y generalmente sin cohesión. los tipos de flujo incluyen flujo licuefactado, flujo fluidificado, flujo granular, manto de tracción o flujo granular modificado.</skos:definition>
    <skos:definition xml:lang="en">Laminar high-concentration, generally cohesionless deposition process. flow types included liquefied flow, fluidized flow, grain flow, traction carpet or modified grain flow.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-mecanico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/debrisFlowDeposition"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/debris_flow_deposition"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/plegamiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">plegamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">folding</skos:prefLabel>
    <skos:definition xml:lang="es">Deformación en la cual las superficies planares se transforman en superficies regularmente curviplanares con flancos (zonas de menor curvatura) y charnelas (zonas de mayor curvatura) definidos.</skos:definition>
    <skos:definition xml:lang="en">Deformation in which planar surfaces become regularly curviplanar surfaces with definable limbs (zones of lower curvature) and hinges (zones of higher curvature).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deformacion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/folding"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/folding"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-transporte-en-masa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito por transporte en masa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mass wasting deposition</skos:prefLabel>
    <skos:definition xml:lang="es">Término general para el desprendimiento y transporte ladera debajo de suelo y material rocoso bajo la aplicación directa de esfuerzos gravitacionales. en contraste a otros procesos de erosión, el material movilizado por deslizamiento en masa no es transportado dentro, sobre o bajo ningún otro medio. las propiedades físicas del material dependen de la interacción entre las partículas de suelo y roca y de su contenido relativo. el deslizamiento en masa incluye desplazamientos lentos, tales como el deslizamiento de laderas y la solifluxión, y desplazamientos rápidos como los desprendimientos de rocas, deslizamiento de bloques y flujos en masa cohesiva (jackson, 1997, p. 392). incluye tanto a los procesos subaéreos como a los subacuáticos.</skos:definition>
    <skos:definition xml:lang="en">A general term for the dislodgement and downslope transport of soil and rock material under the direct application of gravitational body stresses. in contrast to other erosion processes, the debris removed by mass wasting is not carried within, on, or under another medium. the mass properties of the material being transported depend on the interaction of the soil and rock particles and on the moisture content. mass wasting includes slow displacements, such as creep and solifluction, and rapid movements such as rockfalls, rockslides, and cohesive debris flows (jackson, 1997, p. 392). includes both subaerial mass-wasting processes and subaqueous mass-wasting processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-mecanico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/massWastingDeposition"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/mass_wasting_deposition"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/fallamiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">fallamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">faulting</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de fracturación, deslizamiento friccional y acumulación de desplazamiento que produce una falla.</skos:definition>
    <skos:definition xml:lang="en">The process of fracturing, frictional slip, and displacement accumulation that produces a fault</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deformacion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/faulting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/faulting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/impacto-meteoritico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">impacto meteorítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">meteorite impact</skos:prefLabel>
    <skos:definition xml:lang="es">Impacto de un meteorito sobre la superficie de la tierra.</skos:definition>
    <skos:definition xml:lang="en">The impact of a meteorite on the surface of the earth</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/impacto-de-bolido"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/meteoriteImpact"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/meteorite_impact"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-efusiva">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erupción efusiva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">effusive eruption</skos:prefLabel>
    <skos:definition xml:lang="es">Erupciones caracterizadas por un bajo contenido en volátiles del magma en relación con la presión ambiental.</skos:definition>
    <skos:definition xml:lang="en">Eruptions characterized by low volatile content of the erupting magma relative to ambient pressure</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/effusiveEruption"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/effusive_eruption"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/inversion-del-campo-magnetico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">inversión del campo magnético</skos:prefLabel>
    <skos:prefLabel xml:lang="en">magnetic field reversal</skos:prefLabel>
    <skos:definition xml:lang="es">Evento geomagnético.</skos:definition>
    <skos:definition xml:lang="en">Geomagnetic event</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geomagnetico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/magneticFieldReversal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/magnetic_field_reversal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-metamorfico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">proceso metamórfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metamorphic process</skos:prefLabel>
    <skos:definition xml:lang="es">Ajuste mineralógico, químico y estructural de rocas sólidas a condiciones físicas y químicas diferentes de aquellas en las que se originaron y que se da en general en zonas profundas bajo las zonas superficiales de meteorización y cementación.</skos:definition>
    <skos:definition xml:lang="en">Mineralogical, chemical, and structural adjustment of solid rocks to physical and chemical conditions that differ from the conditions under which the rocks in question originated, and are generally been imposed at depth, below the surface zones of weathering and cementation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/alteracion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/precipitacion-quimica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/metamorfismo-de-contacto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/metamorfismo-de-dislocacion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/metamorphicProcess"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/metamorphic_process"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/fusion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">fusión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">melting</skos:prefLabel>
    <skos:definition xml:lang="es">Cambio de estado sólido a líquido.</skos:definition>
    <skos:definition xml:lang="en">Change of state from a solid to a liquid</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-magmatico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/fusion-parcial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/melting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/melting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">meteorización</skos:prefLabel>
    <skos:prefLabel xml:lang="en">weathering</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso o grupo de procesos en virtud de los cuales los materiales terrestres expuestos a los agentes atmosféricos en la superficie de la tierra o cerca de ella cambian de color, textura, composición, dureza o forma, con transporte nulo o escaso de materiales sueltos o alterados. entre estos procesos se incluyen típicamente los de oxidación, hidratación y lixiviación de componentes solubles.</skos:definition>
    <skos:definition xml:lang="en">The process or group of processes by which earth materials exposed to atmospheric agents at or near the earth's surface are changed in color, texture, composition, firmness, or form, with little or no transport of the loosened or altered material. processes typically include oxidation, hydration, and leaching of soluble constituents.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-biologica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-quimica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-fisica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/weathering"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/weathering"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/disolucion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">disolución</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dissolution</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de disolver en una solución homogénea, como cuando una solución ácida disuelve la caliza. en karsts, se refiere al proceso de disolución de la roca para producir formas del relieve, en contraste con la solución, el producto químico de la disolución.</skos:definition>
    <skos:definition xml:lang="en">The process of dissolving into a homogenous solution, as when an acidic solution dissolves limestone. in karst, refers to the process of dissolving rock to produce landforms, in contrast to solution, the chemical product of dissolution.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-quimica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/dissolution"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/dissolution"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erupción</skos:prefLabel>
    <skos:prefLabel xml:lang="en">eruption</skos:prefLabel>
    <skos:definition xml:lang="es">Eyección de materiales volcánicos (lava, piroclastos, y gases volcánicos) sobre la superficie de la tierra, bien desde un slidero central o bien desde una fisura o grupo de fisuras.</skos:definition>
    <skos:definition xml:lang="en">The ejection of volcanic materials (lava, pyroclasts, and volcanic gases) onto the earth's surface, either from a central vent or from a fissure or group of fissures</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-magmatico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-efusiva"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-hawaiana"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-piroclastica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-estromboliana"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/eruption"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/eruption"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/arado-profundo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">arado profundo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deep ploughing</skos:prefLabel>
    <skos:definition xml:lang="es">Mezcla de material suelto por arado más profundo que lo frecuentemente hecho durante el cultivo anual del suelo.</skos:definition>
    <skos:definition xml:lang="en">Mixing of loose surface material by ploughing deeper than frequently done during annual soil cultivation</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/deepPloughing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/cizallamiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">cizallamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">shearing</skos:prefLabel>
    <skos:definition xml:lang="es">Deformación en la que partes contiguas de un cuerpo son desplazadas relativamente la una de la otra en una dirección paralela a una superficie. la superficie puede ser una falla discreta, o la deformación puede ser un esfuerzo penetrativo y la superficie de cizalla ser una abstracción geométrica.</skos:definition>
    <skos:definition xml:lang="en">A deformation in which contiguous parts of a body are displaced relatively to each other in a direction parallel to a surface. the surface may be a discrete fault, or the deformation may be a penetrative strain and the shear surface is a geometric abstraction.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deformacion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/shearing"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/shearing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/agotamiento-del-oxigeno-en-aguas-profundas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">agotamiento del oxígeno en aguas profundas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deep water oxygen depletion</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de reducción de oxígeno de la parte profunda de una masa de agua.</skos:definition>
    <skos:definition xml:lang="en">Process of removal of oxygen from from the deep part of a body of water.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/deepWaterOxygenDepletion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/deep_water_oxygen_depletion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-quimica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">meteorización química</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chemical weathering</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de meteorización por el cual las reacciones químicas (hidrólisis, hidratación, oxidación, carbonatación, intercambio iónico, y disolución) transforman las rocas y minerales en nuevas combinaciones químicas que son estables bajo las condiciones que prevalecen en o cerca de la superficie de la tierra; e. g. la alteración de ortoclasa a caolinita.</skos:definition>
    <skos:definition xml:lang="en">The process of weathering by which chemical reactions (hydrolysis, hydration, oxidation, carbonation, ion exchange, and solution) transform rocks and minerals into new chemical combinations that are stable under conditions prevailing at or near the earth's surface; e.g. the alteration of orthoclase to kaolinite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/disolucion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/hidratacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/hidrolisis"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/oxidacion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/chemicalWeathering"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/chemical_weathering"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erosion-glacial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erosión glacial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ice erosion</skos:prefLabel>
    <skos:definition xml:lang="es">Erosión por corrosión o abrasión por el hielo en movimiento.</skos:definition>
    <skos:definition xml:lang="en">Erosion by corrasion or plucking by moving ice.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/iceErosion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/ice_erosion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/hidrolisis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">hidrólisis</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hydrolysis</skos:prefLabel>
    <skos:definition xml:lang="es">Reacción de descomposición que involucra al agua. en geología, indica comúnmente una reacción entre minerales silicatados y bien agua pura o una solución acuosa.</skos:definition>
    <skos:definition xml:lang="en">A decomposition reaction involving water. in geology, it commonly indicates reaction between silicate minerals and either pure water or aqueous solution. in such reactions, h</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-quimica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/hydrolysis"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/hydrolysis"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/hidratacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">hidratación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hydration</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de absorción de agua en la estructura cristalina de un mineral, cambiando así su volumen y fracturando y empequeñeciendo los granos.</skos:definition>
    <skos:definition xml:lang="en">The process of absorption of water into the crystal structure of a mineral, thereby changing its volume and fracturing and loosening grains</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-quimica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/hydration"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/hydration"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-biologica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">meteorización biológica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biological weathering</skos:prefLabel>
    <skos:definition xml:lang="es">Destrucción de las rocas por agentes biológicos, e. g. la fuerza de penetración y expansión de las raíces, la presencia de musgos y líquenes causando que ácidos húmicos queden retenidos en contacto con la roca, y el trabajo de animales (lombrices, topos, conejos) modificando la superficie del suelo.</skos:definition>
    <skos:definition xml:lang="en">Breakdown of rocks by biological agents, e.g. the penetrating and expanding force of roots, the presence of moss and lichen causing humic acids to be retained in contact with rock, and the work of animals (worms, moles, rabbits) in modifying surface soil</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/biologicalWeathering"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/biological_weathering"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-orogenico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">proceso orogénico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">orogenic process</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de construcción de las montañas.</skos:definition>
    <skos:definition xml:lang="en">Mountain building process.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/orogenicProcess"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/orogenic_process"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-fisica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">meteorización física</skos:prefLabel>
    <skos:prefLabel xml:lang="en">physical weathering</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de meteorización por el cual la acción de las heladas, el crecimiento de cristales de sal, la absorción de agua y otros procesos físicos deshacen una roca en fragmentos, sin involucrar cambios químicos.</skos:definition>
    <skos:definition xml:lang="en">The process of weathering by which frost action, salt-crystal growth, absorption of water, and other physical processes break down a rock to fragments, involving no chemical change</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/gelifraccion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/haloclastia"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-por-descompresion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-por-choque-termico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/physicalWeathering"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/physical_weathering"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-vulcaniana">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erupción vulcaniana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">vulcanian eruption</skos:prefLabel>
    <skos:definition xml:lang="es">Erupción caracterizada por la eyección explosiva de fragmentos de nueva lava, comúnmente incandescentes cuando dejan el conducto pero sólidos o demasiado viscosos para asumir ningún grado apreciable de redondeamiento durante su vuelo a través del aire. con estos hay a menudo bombas o bloques en corteza de pan, y generalmente grandes proporciones de ceniza.</skos:definition>
    <skos:definition xml:lang="en">Eruption characterized by the explosive ejection of fragments of new lava, commonly incandescent when they leave the vent but either solid or too viscous to assume any appreciable degree of rounding during their flight through the air. with these there are often breadcrust bombs or blocks, and generally large proportions of ash</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-piroclastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/vulcanianEruption"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/vulcanian_eruption"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/haloclastia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">haloclastia</skos:prefLabel>
    <skos:prefLabel xml:lang="en">haloclasty</skos:prefLabel>
    <skos:definition xml:lang="es">Propagación de fracturas en la roca debido a la cristalización de sales minerales (típicamente cloruro sódico) desde el agua intersticial, o por la expansión volumétrica de las sales en capilares, o por la presión de hidratación de sales atrapadas en intersticios. generalmente resulta en la desintegración mecánica de la superficie de la roca.</skos:definition>
    <skos:definition xml:lang="en">Propagation of fractures in rock due to crytallization of mineral salts (typically sodium chloride) from interstitial water, or volumetrick expansion of salts in capillaries, or hydration pressure of interstitial, trapped salts. generally results in mechanical disintegration of the rock surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-fisica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/haloclasty"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/haloclasty"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/actividad-humana">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">actividad humana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">human activity</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de modificación de la superficie o subsuelo de la tierra por la actividad humana que origina objetos geológicos.</skos:definition>
    <skos:definition xml:lang="en">Processes of human modification of the earth to produce geologic features.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/excavacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/grada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/transporte-y-deposito-de-material"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/humanActivity"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/human_activity"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/intrusion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">intrusión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intrusion</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de emplazamiento de un magma en una roca pre-existente.</skos:definition>
    <skos:definition xml:lang="en">The process of emplacement of magma in pre-existing rock</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-magmatico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/intrusion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/intrusion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geomagnetico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">proceso geomagnético</skos:prefLabel>
    <skos:prefLabel xml:lang="en">geomagnetic process</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso que da lugar a un cambio en el campo magnético de la tierra.</skos:definition>
    <skos:definition xml:lang="en">Process that results in change in earth's magnetic field.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/inversion-del-campo-magnetico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deriva-polar"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/geomagneticProcess"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/geomagnetic_process"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erosion-del-agua">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erosión del agua</skos:prefLabel>
    <skos:prefLabel xml:lang="en">water erosion</skos:prefLabel>
    <skos:definition xml:lang="es">Erosión causada por el impacto o piqueteo de clastos por movimiento de agua líquida.</skos:definition>
    <skos:definition xml:lang="en">Erosion by clast impact or plucking by moving liquid water</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/waterErosion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/water_erosion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-magmatico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">proceso magmático</skos:prefLabel>
    <skos:prefLabel xml:lang="en">magmatic process</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso que implica la presencia de roca fundida (magma).</skos:definition>
    <skos:definition xml:lang="en">A process involving melted rock (magma).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/intrusion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/cristalizacion-magmatica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/fusion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/magmaticProcess"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/magmatic_process"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">proceso tectónico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tectonic process</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso relacionado con la deformación o la interacción entre las placas rígidas que forman la corteza de la tierra.</skos:definition>
    <skos:definition xml:lang="en">Processes related to the interaction between or deformation of rigid plates forming the crust of the earth.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/acreccion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/ruptura-continental"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/colision-continental"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/obduccion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-orogenico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/expansion-oceanica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/subduccion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/falla-transformante"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/tectonicProcess"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/tectonic_process"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/eluviacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">eluviación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deluviation</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de erosión selectiva no linear a escala granular.</skos:definition>
    <skos:definition xml:lang="en">Process of non-linear, grain-size selective erosion</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/deluviation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/grada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">grada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">grading</skos:prefLabel>
    <skos:definition xml:lang="es">Nivelamiento de la superficie del terreno por redistribución de material pre-existente.</skos:definition>
    <skos:definition xml:lang="en">Leveling of earth surface by rearrangement of prexisting material</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/actividad-humana"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/grading"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/grading"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/alteracion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">alteración</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alteration</skos:prefLabel>
    <skos:definition xml:lang="es">Término general para cualquier cambio en la composición mineralógica o química de una roca. típicamente relacionada con la interacción con fluidos hídricos.</skos:definition>
    <skos:definition xml:lang="en">General term for any change in the mineralogical or chemical composition of a rock. typically related to interaction with hydrous fluids.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-metamorfico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/alteration"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/alteration"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/apertura-cortical">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">apertura cortical</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rifting</skos:prefLabel>
    <skos:definition xml:lang="es">Extensión de la corteza para formar una o más fosas tectónicas alargadas y estrechas de alcance regional.</skos:definition>
    <skos:definition xml:lang="en">Extension of the crust to form one or more long, narrow graben of regional extent.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/ruptura-continental"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/rifting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/rifting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/arrastre-por-disolucion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">arrastre por disolución</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dissolution creep</skos:prefLabel>
    <skos:definition xml:lang="es">Deformación por disolución bajo los efectos de un esfuerzo diferencial y su transporte a una nueva localización por movimiento del fluido dentro del cuerpo de roca.</skos:definition>
    <skos:definition xml:lang="en">Deformation by dissolution under the effects of differential stress and its transport to a new location by movement of fluid in the rock body.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/flujo-ductil"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/dissolutionCreep"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/dissolution_creep"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/arrastre-por-difusion-intracristalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">arrastre por difusión intracristalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diffusion creep</skos:prefLabel>
    <skos:definition xml:lang="es">Deformación dúctil a escala de grano producida por el movimiento de átomos a través de los cristales, a lo largo de los bordes de grano, y a través de fluidos intersticiales.</skos:definition>
    <skos:definition xml:lang="en">Grain-scale, ductile deformation accomplished by the motion of atoms through crystals, along grain boundaries, and through pore fluids.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/flujo-ductil"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/diffusionCreep"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/diffusion_creep"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/oxidacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">oxidación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oxidation</skos:prefLabel>
    <skos:definition xml:lang="es">Reacción química que involucra el secuestro de electrones de los cationes. las reacciones típicas incluyen la transformación de sulfuros minerales en óxidos minerales, o en el incremento del estado de oxidación de los cationes en los óxidos minerales existentes. la más comúnmente observada es la oxidación del fe.</skos:definition>
    <skos:definition xml:lang="en">Chemical reaction that involve stripping of electrons from cations. typicall reactions include converting sulfide minerals to oxide minerals, or increasing the oxidation state of cations in existing oxide minerals. the most commonly observed is the oxidation of fe</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-quimica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/oxidation"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/oxidation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/microfracturacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">microfracturación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">microfracturing</skos:prefLabel>
    <skos:definition xml:lang="es">Desarrollo de fracturas dentro de un único grano o cortando varios granos.</skos:definition>
    <skos:definition xml:lang="en">Development of fractures within a single grain or cutting several grains.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/fracturacion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/microfracturing"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/microfracturing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-el-aire">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito desde el aire</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deposition from air</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de sedimento desde el aire, en el cual el sedimento ha sido transportado tras su entrada en el aire en movimiento.</skos:definition>
    <skos:definition xml:lang="en">Deposition of sediment from air, in which the sediment has been transported after entrainment in the moving air.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/depositionFromAir"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/vertido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">vertido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dumping</skos:prefLabel>
    <skos:definition xml:lang="es">Amontonamiento de material mayoritariamente sólido, como en un vertedero, escombrera de mina u operaciones de dragado.</skos:definition>
    <skos:definition xml:lang="en">Heaping of mostly solid material, as in a land fill, mine dump, dredging operations</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/dumping"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-por-descompresion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">meteorización por descompresión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pressure release weathering</skos:prefLabel>
    <skos:definition xml:lang="es">Propagación de fracturas cerca de la superficie de la roca dura debido a la expansión relacionada con el descenso de la presión confinante cuando una roca profundamente enterrada es exhumada. las fracturas típicamente se propagan a lo largo de superficies cercanas y subparalelas a la superficie del afloramiento.</skos:definition>
    <skos:definition xml:lang="en">Propagation of fractures near the surface of solid rock due to expansion related to release of confining pressure when deeply buried rock is unroofed. fractures typically propagate along surfaces close to and subparallel to the surface of the outcrop.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-fisica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/pressureReleaseWeathering"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/pressure_release_weathering"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/maclado-mecanico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">maclado mecánico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deformation twinning</skos:prefLabel>
    <skos:definition xml:lang="es">Deformación de un cristal por deslizamiento para producir maclado cristalográfico.</skos:definition>
    <skos:definition xml:lang="en">Deformation of a crystal by gliding to produce crystallographic twinning.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/flujo-ductil"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/deformationTwinning"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/deformation_twinning"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-piroclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erupción piroclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic eruption</skos:prefLabel>
    <skos:definition xml:lang="es">Erupción producida por la generación y rápida expansión de una fase gaseosa que disrupta el magma, expulsándolo junto con fragmentos de la roca encajante o de sedimento.</skos:definition>
    <skos:definition xml:lang="en">Eruption produced by the generation and rapid expansion of a gas phase that disrupts magma, surrounding wall rock or sediment</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-pliniana"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-vulcaniana"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/pyroclasticEruption"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/pyroclastic_eruption"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/acumulacion-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">acumulación orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organic accumulation</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación sedimentaria de materia orgánica biogénica, como en las turberas.</skos:definition>
    <skos:definition xml:lang="en">Sediment accumulation of biologically produced organicmaterial, as in bog, coal swamps.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/organicAccumulation"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/organic_accumulation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/crecimiento-organismico-in-situ">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">crecimiento organísmico in-situ</skos:prefLabel>
    <skos:prefLabel xml:lang="en">in-situ organismic growth</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación de materia orgánica muerta originada por las plantas, e. g. acumulación de turba en pantanos</skos:definition>
    <skos:definition xml:lang="en">Accumulation of dead organicmaterial originating from the plants, e.g. peat accumulation in bogs</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/in-situOrganismicGrowth"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deposition</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación de material; el proceso constructivo de acumulación de partículas sedimentarias, precipitación química de materia mineral a partir de una solución, o la acumulación de materia orgánica a la muerte de plantas y animales.</skos:definition>
    <skos:definition xml:lang="en">Accumulation of material; the constructive process of accumulation of sedimentary particles, chemical precipitation of mineral matter from solution, or the accumulation of organicmaterial on the death of plants and animals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-sedimentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/precipitacion-biologica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/precipitacion-quimica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-mecanico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/acumulacion-organica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/deposition"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/deposition"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/flujo-ductil">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">flujo dúctil</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ductile flow</skos:prefLabel>
    <skos:definition xml:lang="es">Deformación sin aparente pérdida de continuidad a la escala de observación.</skos:definition>
    <skos:definition xml:lang="en">Deformation without apparent loss of continuity at the scale of observation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deformacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/maclado-mecanico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/arrastre-por-difusion-intracristalina"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/arrastre-por-disolucion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/ductileFlow"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/ductile_flow"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/transporte-en-masa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">transporte en masa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mass wasting</skos:prefLabel>
    <skos:definition xml:lang="es">Desprendimiento y transporte ladera debajo de suelo y material rocoso bajo la aplicación directa de esfuerzos gravitacionales. en contraste a otros procesos de erosión, el material movilizado por deslizamiento en masa no es transportado dentro, sobre o bajo ningún otro medio. las propiedades físicas del material dependen de la interacción entre las partículas de suelo y roca y de su contenidoen humedad.</skos:definition>
    <skos:definition xml:lang="en">The dislodgement and downslope transport of soil and rock material under the direct application of gravitational body stresses. in contrast to other erosion processes, the debris removed by mass wasting is not carried within, on, or under another medium. the mass properties of the material being transported depend on the interaction of the soil and rock particles and on the moisture content.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/massWasting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/mass_wasting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-por-choque-termico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">meteorización por choque térmico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">thermal shock weathering</skos:prefLabel>
    <skos:definition xml:lang="es">Propagación de fracturas cerca de la la superficie de la roca dura debida a la expansión y contracción causadas por cambios de temperatura. las fracturas típicamente se propagan a lo largo de superficies cercanas y subparalelas a la superficie del afloramiento.</skos:definition>
    <skos:definition xml:lang="en">Propagation of fractures near the surface of solid rock due to expansion and contraction caused by temperature changes. fractures typically propagate along surfaces close to and subparallel to the surface of the outcrop.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-fisica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/thermalShockWeathering"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/thermal_shock_weathering"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-corriente-de-turbidez">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito por corriente de turbidez</skos:prefLabel>
    <skos:prefLabel xml:lang="en">turbidity current deposition</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito desde una mezcla turbulenta de baja concentración sedimento-agua.</skos:definition>
    <skos:definition xml:lang="en">Deposition from a turbulent, low concentration sediment-water mixture.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-mecanico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/turbidityCurrentDeposition"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/turbidity_current_deposition"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/colision-continental">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">colisión continental</skos:prefLabel>
    <skos:prefLabel xml:lang="en">continental collision</skos:prefLabel>
    <skos:definition xml:lang="es">Amalgamación de dos placas o bloques continentales a lo largo de un margen convergente.</skos:definition>
    <skos:definition xml:lang="en">The amalgamation of two continental plates or blocks along a convergent margin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/continentalCollision"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/continental_collision"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-estromboliana">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erupción estromboliana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">strombolian eruption</skos:prefLabel>
    <skos:definition xml:lang="es">Erupción caracterizada por la expulsión en chorro de grumos o fuentes de lava basáltica fluida de un cráter central.</skos:definition>
    <skos:definition xml:lang="en">Eruption characterized by jetting of clots or fountains of fluid, basaltic lava from a central crater</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/strombolianEruption"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/strombolian_eruption"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/retrabajamiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">retrabajamiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reworking</skos:prefLabel>
    <skos:definition xml:lang="es">Transporte corto por agua que cambia predominantemente la organización física interna de las partículas sedomentarias.</skos:definition>
    <skos:definition xml:lang="en">Near-range transport by water with predominantly changing the inner physical organisation of the sediment particles</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/reworking"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-un-fluido-en-movimiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito desde un fluido en movimiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deposition from moving fluid</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de sedimento desde agua o aire en movimiento, en el que el sedimento es transportado por arrastre del fluido que se está moviendo. es diferente del depósito por flujo en masa o por corriente de turbidez en que la que el movimiento de la mezcla fluido/sedimento se debe a la incorporación del sedimento en el fluido.</skos:definition>
    <skos:definition xml:lang="en">Deposition of sediment from moving water or air, in which the sediment is transported by entrainment in the moving fluid. constrast with debris flow or turbidity current deposition in which movement of fluid/sediment mixture is due to incorporation of sediment in fluid.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-mecanico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/depositionFromMovingFluid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/traction_saltation_or_suspension_deposition"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/expansion-oceanica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">expansión oceánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spreading</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso según el cual se forma nueva corteza oceánica por la surgencia de magma en el centro de dorsales meso-oceánicas y por alejamiento del nuevo material de el sitio de surgencia a velocidades de uno a diez centímetros por año.</skos:definition>
    <skos:definition xml:lang="en">A process whereby new oceanic crust is formed by upwelling of magma at the center of mid-ocean ridges and by a moving-away of the new material from the site of upwelling at rates of one to ten centimeters per year.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/spreading"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/spreading"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/excavacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">excavación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">excavation</skos:prefLabel>
    <skos:definition xml:lang="es">Extracción de material, como en una operación minera.</skos:definition>
    <skos:definition xml:lang="en">Removal of material, as in a mining operation</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/actividad-humana"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/excavation"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/excavation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/transporte-y-deposito-de-material">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">transporte y depósito de material</skos:prefLabel>
    <skos:prefLabel xml:lang="en">material transport and deposition</skos:prefLabel>
    <skos:definition xml:lang="es">Transporte y amontonamiento de material, como en un vertedero, escombrera de mina, operaciones de dragado.</skos:definition>
    <skos:definition xml:lang="en">Transport and heaping of material, as in a land fill, mine dump, dredging operations</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/actividad-humana"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/materialTransportAndDeposition"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/material_transport_and_deposition"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Proceso asociado a evento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Event Process</skos:prefLabel>
    <dcterms:title xml:lang="es">Proceso asociado a evento</dcterms:title>
    <dcterms:title xml:lang="en">Event Process</dcterms:title>
    <skos:definition xml:lang="es">Términos referidos a procesos asociados a eventos geológicos.</skos:definition>
    <skos:definition xml:lang="en">Terms referring to processes associated with geological events.</skos:definition>
    <dcterms:description xml:lang="es">Términos referidos a procesos asociados a eventos geológicos.</dcterms:description>
    <dcterms:description xml:lang="en">Terms referring to processes associated with geological events.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos originales de INSPIRE</dcterms:provenance>
    <dcterms:creator>https://commission.europa.eu/</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Proceso asociado a evento.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/moldeado"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/crioturbacion"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/arado-profundo"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/eluviacion"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-o-desde-hielos-en-movimiento"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-el-aire"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-un-fluido"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-el-agua"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/cavado"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/vertido"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/crecimiento-organismico-in-situ"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/mezcla"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/retrabajamiento"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/sellado"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/acreccion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">acrección</skos:prefLabel>
    <skos:prefLabel xml:lang="en">accretion</skos:prefLabel>
    <skos:definition xml:lang="es">La adición de material a un continente. típicamente involucra movimiento convergente o transformante.</skos:definition>
    <skos:definition xml:lang="en">The addition of material to a continent. typically involves convergent or transform motion.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/accretion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/accretion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-mecanico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito mecánico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mechanical deposition</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso por el cual un material que es transportado en forma de partículas por el aire, el agua,  el hielo u otro fluido en movimiento, llega al descanso y se acumula.</skos:definition>
    <skos:definition xml:lang="en">Process by which material that is being transported as particles by moving air, water, ice, or other fluid comes to rest and accumulates.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-flujo-en-masa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-un-fluido-en-movimiento"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-transporte-en-masa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-corriente-de-turbidez"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/mechanicalDeposition"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/mechanical_deposition"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-sedimentario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">proceso sedimentario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sedimentary process</skos:prefLabel>
    <skos:definition xml:lang="es">Fenómeno que da lugar a una modificación de la distribución o de las propiedades físicas del sedimento en la superficie de la tierra o cerca de ella.</skos:definition>
    <skos:definition xml:lang="en">A phenomenon that changes the distribution or physical properties of sediment at or near the earth's surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/sedimentaryProcess"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/sedimentary_process"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/falla-transformante">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">falla transformante</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transform faulting</skos:prefLabel>
    <skos:definition xml:lang="es">Falla de desplazamiento en dirección que une otras dos fallas o límites de placas (e.g. dos segmentos de una dorsal meso-oceánica). las fallas transformantes a menudo exhiben características  que las distinguen de las fallas transcurrentes: [1] para fallas transformantes formadas al mismo tiempo que las fallas que conectan, el deslizamiento tiene igual magnitud en todos los puntos a lo largo de la falla transformante; la magnitud del deslizamiento puede exceder la longitud de la falla transformante, y el deslizamiento no decrece a cero en la terminación de la falla. [2] para fallas transformantes que conectan dos estructuras similares, e.g. si dos segmentos de dorsal meso-oceánica unidos por una transformante tienen velocidades de expansión iguales, entonces la longitud de la transformante no cambia según se acumula el desplazamiento.</skos:definition>
    <skos:definition xml:lang="en">A strike-slip fault that links two other faults or two other plate boundaries (e.g. two segments of a mid-ocean ridge). transform faults often exhibit characteristics that distinguish them from transcurrent faults: (1) for transform faults formed at the same time as the faults they link, slip on the transform fault has equal magnitude at all points along the transform; slip magnitude on the transform fault can exceed the length of the transform fault, and slip does not decrease to zero at the fault termini. (2) for transform faults linking two similar features, e.g. if two mid-ocean ridge segments linked by a transform have equal spreading rates, then the length of the transform does not change as slip accrues on it.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/transformFaulting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/transform_faulting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/gelifraccion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">gelifracción</skos:prefLabel>
    <skos:prefLabel xml:lang="en">frost shattering</skos:prefLabel>
    <skos:definition xml:lang="es">Propagación de fracturas debida a la expansión del agua al congelarse en espacios intergranulares y fracturas en un cuerpo rocoso. produce la desintegración mecánica o rotura de la roca.</skos:definition>
    <skos:definition xml:lang="en">Propagation of fractures due to expansion of freezing water in intergranular spaces and fractures in a rock body. result is mechanical disintegration spliitting, or breakup of rock.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-fisica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/frostShattering"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/frost_shattering"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/extincion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">extinción</skos:prefLabel>
    <skos:prefLabel xml:lang="en">extinction</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de desaparición de una especie o de un taxón superior, que tiene como consecuencia su inexistencia en el registro fósil posterior.</skos:definition>
    <skos:definition xml:lang="en">Process of disappearance of a species or higher taxon, so that it no longer exists anywhere or in the subsequent fossil record.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/extinction"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/extinction"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/sellado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">sellado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sealing</skos:prefLabel>
    <skos:definition xml:lang="es">Cubrimiento de la superficie con un material no líquido, nada o poco permeable al agua tras el proceso.</skos:definition>
    <skos:definition xml:lang="en">Covering of the surface with a non-liquid material not or little permeable for water after processing</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/sealing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erosion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erosión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">erosion</skos:prefLabel>
    <skos:definition xml:lang="es">El proceso de desagregación de las rocas y el desplazamiento de las partículas resultantes (sedimento) usualmente por los agentes de corrientes tales como el viento, el agua o el hielo por movimiento a favor de ladera en respuesta a la gravedad o por organismos vivos (en el caso de la bioerosión).</skos:definition>
    <skos:definition xml:lang="en">The process of disaggregation of rock and displacement of the resultant particles (sediment) usually by the agents of currents such as, wind, water, or ice by downward or down-slope movement in response to gravity or by living organisms (in the case of bioerosion).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-sedimentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion-glacial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/transporte-en-masa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion-del-agua"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erosion-del-viento"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/erosion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/erosion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/cavado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">cavado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">digging</skos:prefLabel>
    <skos:definition xml:lang="es">Repetida pérdida de material superficial por cavar con una pala o herramienta similar.</skos:definition>
    <skos:definition xml:lang="en">Repeated mixing of loose surface material by digging with a spade or similar tool</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/digging"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-un-fluido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito desde un fluido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deposition from fluid</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de sedimento desde agua o aire, en el cual el sedimento es depositado tras entrar en el fluido.</skos:definition>
    <skos:definition xml:lang="en">Deposition of sediment from moving water or air, in which the sediment is transported by entrainment in the moving fluid. constrast with debris flow or turbidity current deposition in which movement of fluid/sediment mixture is due to incorporation of sediment in fluid.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/depositionFromFluid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/obduccion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">obducción</skos:prefLabel>
    <skos:prefLabel xml:lang="en">obduction</skos:prefLabel>
    <skos:definition xml:lang="es">El cabalgamiento de corteza continental por corteza oceánica o rocas del manto en un borde convergente de placa.</skos:definition>
    <skos:definition xml:lang="en">The overthrusting of continental crust by oceanic crust or mantle rocks at a convergent plate boundary.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/obduction"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/obduction"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/ascenso-del-nivel-del-mar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">ascenso del nivel del mar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sea level rise</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de ascenso del nivel medio del mar relativo a algún datum.</skos:definition>
    <skos:definition xml:lang="en">Process of mean sea level rising relative to some datum</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/variacion-del-nivel-del-mar"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/seaLevelRise"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/sea_level_rise"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/moldeado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">moldeado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">casting</skos:prefLabel>
    <skos:definition xml:lang="es">Cubrimiento de la superficie con un material líquido durante el proceso y que se solidifica después.</skos:definition>
    <skos:definition xml:lang="en">Covering of the surface with a material liquid during processing and solidifying afterwards</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/casting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-pliniana">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erupción pliniana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">plinian eruption</skos:prefLabel>
    <skos:definition xml:lang="es">Erupción explosiva en la que una continuada corriente turbulenta de magma fragmentado y gases es expulsada a alta velocidad de un respiradero. son característicos los grandes volúmenes de tefra y las altas columnas de erupción.</skos:definition>
    <skos:definition xml:lang="en">An explosive eruption in which a steady, turbulent stream of fragmented magma and magmatic gas is released at a high velocity from a vent. large volumes of tephra and tall eruption columns are characteristic</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-piroclastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/plinianEruption"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/plinian_eruption"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/metamorfismo-de-contacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">metamorfismo de contacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contact metamorphism</skos:prefLabel>
    <skos:definition xml:lang="es">Metamorfismo que tiene lugar en rocas en o cerca de su contacto con un cuerpo de roca ígnea al que está genéticamente relacionado.</skos:definition>
    <skos:definition xml:lang="en">Metamorphism taking place in rocks at or near their contact with a genetically related body of igneous rock</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-metamorfico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/contactMetamorphism"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/contact_metamorphism"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deriva-polar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">deriva polar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polar wander</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de migración del eje del  campo dipolar de la tierra en relación con su eje de rotación.</skos:definition>
    <skos:definition xml:lang="en">Process of migration of the axis of the earth's dipole field relative to the rotation axis of the earth.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geomagnetico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/polarWander"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/polar_wander"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/caida-del-nivel-del-mar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">caída del nivel del mar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sea level fall</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de caída del nivel medio del mar relativa a algún datum.</skos:definition>
    <skos:definition xml:lang="en">Process of mean sea level falling relative to some datum</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/variacion-del-nivel-del-mar"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/seaLevelFall"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/sea_level_fall"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/ruptura-continental">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">ruptura continental</skos:prefLabel>
    <skos:prefLabel xml:lang="en">continental breakup</skos:prefLabel>
    <skos:definition xml:lang="es">Fragmentación de una placa continental en dos o más placas menores; puede involucrar procesos de rifting (apertura cortical) o de fracturación con movimiento en dirección (transcurrencia).</skos:definition>
    <skos:definition xml:lang="en">Fragmentation of a continental plate into two or more smaller plates; may involve rifting or strike slip faulting.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/apertura-cortical"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/continentalBreakup"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/continental_breakup"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/mezcla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">mezcla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mixing</skos:prefLabel>
    <skos:definition xml:lang="es">Mezcla</skos:definition>
    <skos:definition xml:lang="en">Mixing</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/mixing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/especiacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">especiación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">speciation</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso que da lugar a la aparición de una nueva especie.</skos:definition>
    <skos:definition xml:lang="en">Process that results inappearance of new species.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/speciation"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/speciation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/crioturbacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">crioturbación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cryoturbation</skos:prefLabel>
    <skos:definition xml:lang="es">Término colectivo para describir la perturbación y alteración de material no consolidado como resultado de la acción de las heladas.</skos:definition>
    <skos:definition xml:lang="en">A collective term to describe the stirring and churning of unconsolidated material resulting from frost action</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/cryoturbation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-hawaiana">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">erupción hawaiana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hawaiian eruption</skos:prefLabel>
    <skos:definition xml:lang="es">Erupción en la que son expulsadas grandes cantidades de lava basáltica extremadamente fluida, principalmente en forma de fuentes de lava en fisuras de los flancos de un volcán. los fenómenos explosivos son raros, pero mucho fango y escoria es apilado en conos y montículos a lo largo de los salideros. es característico de los volcanes en escudo.</skos:definition>
    <skos:definition xml:lang="en">Eruption in which great quantities of extremely fluid basaltic lava are poured out, mainly issuing in lava fountains from fissures on the flanks of a volcano. explosive phenomena are rare, but much spatter and scoria are piled into cones and mounds along the vents. characteristic of shield volcanoes</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/erupcion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/hawaiianEruption"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/hawaiian_eruption"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/fusion-parcial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">fusión parcial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">partial melting</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de fusión que involucra a sólo algunas de las fases minerales de una roca, para producir una mezcla de fundido y partículas residuales.</skos:definition>
    <skos:definition xml:lang="en">Process of melting involving only some of the mineral phases in a rock, to produce a mixture of melt and residual particles.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/fusion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/partialMelting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/partial_melting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/fracturacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">fracturación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fracturing</skos:prefLabel>
    <skos:definition xml:lang="es">Formación de una superficie de falla como resultado de esfuerzos.</skos:definition>
    <skos:definition xml:lang="en">The formation of a surface of failure resulting from stress</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deformacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/microfracturacion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/fracturing"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/fracturing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
</rdf:RDF>
