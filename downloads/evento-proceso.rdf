  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/impacto-de-bolido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">impacto de bólido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bolide impact</skos:prefLabel>
    <skos:definition xml:lang="es">Impacto de un cuerpo extraterrestre sobre la superficie de la tierra.</skos:definition>
    <skos:definition xml:lang="en">The impact of an extraterrestrial body on the surface of the earth.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/impacto-cometario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/impacto-meteoritico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/bolideImpact"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/bolide_impact"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/precipitacion-biologica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">precipitación biológica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biological precipitation</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de minerales desde una solución por la acción de organismos.</skos:definition>
    <skos:definition xml:lang="en">The deposition of minerals from solution by the agency of organisms</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/deposito"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/biologicalPrecipitation"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/biological_precipitation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/impacto-cometario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">impacto cometario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cometary impact</skos:prefLabel>
    <skos:definition xml:lang="es">Impacto de un cometa sobre la superficie de la tierra.</skos:definition>
    <skos:definition xml:lang="en">The impact of a comet on the surface of the earth</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/impacto-de-bolido"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/cometaryImpact"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/cometary_impact"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-o-desde-hielos-en-movimiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">depósito por o desde hielos en movimiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deposition by or from moving ice</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de sedimentos a partir de hielo por fusión o empuje. el material ha sido transportado en el hielo tras su entrada en el hielo en movimiento o tras depósito sobre el hielo desde otros fluidos en movimiento.</skos:definition>
    <skos:definition xml:lang="en">Deposition of sediment from ice by melting or pushing. the material has been transported in the ice after entrainment in the moving ice or after deposition from other moving fluids on the ice.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/depositionByOrFromMovingIce"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/metamorfismo-de-dislocacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">metamorfismo de dislocación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dislocation metamorphism</skos:prefLabel>
    <skos:definition xml:lang="es">Metamorfismo concentrado a lo largo de estrechos corredores de cizallamiento o trituración sin un apreciable incremento en temperatura.</skos:definition>
    <skos:definition xml:lang="en">Metamorphism concentrated along narrow belts of shearing or crushing without an appreciable rise in temperature</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-metamorfico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventProcessValue/dislocationMetamorphism"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventprocess/dislocation_metamorphism"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
