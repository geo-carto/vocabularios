  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-proceso"/>
    <skos:prefLabel xml:lang="es">proceso geológico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">geologic process</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso que afecta al registro geológico.</skos:definition>
    <skos:definition xml:lang="en">Process that effects the geologic record</skos:definition>
