      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Los espesores de los estratos se distribuyen por lotes de estratos de espesores uniformes dentro de cada lote y diferentes entre lotes"
      },
      {
        "@language": "en",
        "@value": "The thicknesses of the strata are distributed by bundles of strata with uniform thicknesses within each bundle and different thicknesses between batches."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "en haces"
      },
      {
        "@language": "en",
        "@value": "in bundles"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron"
      }
    ],
