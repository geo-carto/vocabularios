        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Los espesores de los estratos sucesivos tienen todos ellos unos valores análogos, con un valor real muy cercano a la media estadística de todos los espesores"
      },
      {
        "@language": "en",
        "@value": "The thicknesses of the successive strata have  all analogous values, with a real value very close to the statistical average of all the thicknesses."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "regular"
      },
      {
        "@language": "en",
        "@value": "regular"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron/estratocreciente",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
