  {
    "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron/aleatoria",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Los espesores de los distintos estratos de la unidad son muy variables y no presentan ninguna ordenación definida"
      },
      {
        "@language": "en",
        "@value": "The thicknesses of the different strata of the unit are highly variable and do not present any defined order."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "aleatoria"
      },
      {
        "@language": "en",
        "@value": "random"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron"
      }
    ],
