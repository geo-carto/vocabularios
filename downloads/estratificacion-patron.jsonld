      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Los estratos son más gruesos hacia la parte superior (más joven) de la unidad"
      },
      {
        "@language": "en",
        "@value": "Individual strata thicknes increases towars the top (younger) part of the unit"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron"
