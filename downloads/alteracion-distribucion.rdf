   xmlns:sdo="https://schema.org/"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-distribucion/completa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion"/>
    <skos:prefLabel xml:lang="es">completa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">complete</skos:prefLabel>
    <skos:definition xml:lang="es">Distribución homogénea de color, textura y/o composición.</skos:definition>
    <skos:definition xml:lang="en">Homogeneous distribution of color, texture and/or composition.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-distribucion/collection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion"/>
    <skos:prefLabel xml:lang="es">Distribución de la alteración - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Alteration distribution - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion/bandeada"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion/moteada"/>
