    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion/veteada"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion/irregular"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion/completa"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-distribucion/diseminada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-distribucion"/>
    <skos:prefLabel xml:lang="es">diseminada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">disseminated</skos:prefLabel>
    <skos:definition xml:lang="es">Presencia irregular de concentraciones con color, textura y/o composición característicos.</skos:definition>
    <skos:definition xml:lang="en">Irregular presence of spots characterized by color, texture and/or composition.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
