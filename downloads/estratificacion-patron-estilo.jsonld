      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo/nodulosa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Los estratos están definidos por hileras de nódulos aislados o ligeramente conectados en una matriz de roca más blanda alargados en la dirección de la estratificación"
      },
      {
        "@language": "en",
        "@value": "Strata are defined by rows of isolated or loosely connected nodules in a matrix of softer rock elongated in the direction of stratification."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "nodulosa"
      },
      {
        "@language": "en",
        "@value": "nodulose"
      }
    ],
