  {
    "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo/tableada",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Los estratos tienen superficies planas y paralelas  y los bancos un de espesor uniforme de pocos decímetros"
      },
      {
        "@language": "en",
        "@value": "Bedding planes are parallel at outcrop scale and beyond. Laterally extensive parallel bedding can often be observed in good exposures. Strata are few decimeters thick"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "tableada"
      },
      {
        "@language": "en",
        "@value": "well-bedded"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo/boudinada",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
