  {
    "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo/monticular",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La unidad está formada por cuerpos redondeados, convexos hacia arriba"
      },
      {
        "@language": "en",
        "@value": "The unit is formed by rounded bodies, convex upwards"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "monticular"
      },
      {
        "@language": "en",
        "@value": "mounded"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
      }
    ],
