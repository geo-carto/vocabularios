        "@value": "2026-03-01"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "https://www.igme.es"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "es",
        "@value": "Término que especifican el estilo de la estratificación en una unidad geológica estratificada (por ejemplo, lenticular, irregular, planar, vago, masivo)."
      },
      {
        "@language": "en",
        "@value": "The property beddingStyle provides a term from a controlled vocabulary specifying the style of bedding in a stratified geologic unit (e.g. lenticular, irregular, planar, vague, and massive)."
      }
    ],
