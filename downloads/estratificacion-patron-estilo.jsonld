        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Los estratos tienen límites irregulares tanto en el muro como en el techo"
      },
      {
        "@language": "en",
        "@value": "Strata have irregular boundaries, both at top and bottom"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo"
