    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tonalita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/horizonte-organico-del-suelo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquitoide"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/travertino"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/brecha-tobacea,-aglomerado-o-brecha-piroclastica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-ultrabasica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-ultramafica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/grauvaca"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/litologia/desecho"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca traquítica de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar trachytic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Traquitoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 10 por ciento. sectores 6, 6* y 6' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Trachytoid that has a plagioclase to total feldspar ratio less than 0.1. qapf fields 6, 6', and 6*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquitoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquita-de-feldespato-alcalino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquita-de-feldespato-alcalino-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-traquita-de-feldespato-alcalino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparTrachyticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachytic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-ferruginoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario ferruginoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">iron rich sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario en un estado de consolidación sin especificar  compuesto, al menos en un 50 por ciento, por minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro) determinados mediante lupa o análisis petrográfico. generalmente contiene un 15 por ciento de hierro en peso.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material of unspecified consolidation state that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. corresponds to a rock typically containing 15 percent iron by weight.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-quimico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-ferruginoso"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimetaria-ferruginosa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/ironRichSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/gabro-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">gabro con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing gabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca gabroica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 10' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Gabbroic rock that contains 0-10 percent feldspathoid minerals and no quartz in the qapf fraction. qapf field 10'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-gabroica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingGabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/boninita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">boninita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">boninite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca andesítica que contiene más de un 8 por ciento de mgo. habitualmente está constituida por fenocristales de protoenstatita, ortopiroxeno, clinopiroxeno y olivino en una pasta vítrea con microcristales y presenta texturas características de crecimiento mineral rápido.</skos:definition>
    <skos:definition xml:lang="en">Andesitic rock that contains more than 8 percent mgo. typically consists of phenocrysts of protoenstatite, orthopyroxene, clinopyroxene, and olivine in a glassy base full of crystallites, and exhibits textures characterisitc of rapid crystal growth.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/andesita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/boninite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boninite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/riolita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">riolita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar rhyolite</skos:prefLabel>
    <skos:definition xml:lang="es">Riolitoide con una proporción de plagioclasa con respecto al total de feldespato  inferior al 10 por ciento. sector 2 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Rhyolitoid in which the ratio of plagioclase to total feldspar is less than 0.1. qapf field 2.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-riolitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparRhyolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_rhyolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/traquitoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">traquitoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trachytoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica porfídica que contiene menos de un 90 por ciento de minerales máficos, menos de un 10 por ciento de feldespatoide y de un 20 por ciento de cuarzo, entre los componentes qapf, y con una proporción entre la plagioclasa y el total de feldespato inferior al 65 por ciento. entre los minerales máficos incluye habitualmente anfíbol o mica. engloba a las rocas de los sectores 6, 7 y 8 (con sus subdivisiones) del diagrama qapf o que químicamente se sitúan en el sector t del diagrama tas, como traquita o traquidacita.</skos:definition>
    <skos:definition xml:lang="en">Fine grained igneous rock than contains less than 90 percent mafic minerals, less than 10 percent feldspathoid mineral and less than 20 percent quartz in the qapf fraction and has a plagioclase to total feldspar ratio less than 0.65. mafic minerals typically include amphibole or mica; typically porphyritic. includes rocks defined modally in qapf fields 6, 7 and 8 (with subdivisions) or chemically in tas field t as trachyte or latite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica-de-feldespato-alcalino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-latitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/trachytoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/trachytoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarcita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarcita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartzite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica compuesta, al menos, por un 75 por ciento de cuarzo; normalmente presenta textura granoblástica.</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock consisting of greater than or equal to 75 percent quartz; typically granoblastic texture.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartzite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca traquítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trachytic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Traquitoide con una proporción entre plagioclasa y el total de feldespato comprendida entre el 10 y el 35 por ciento. corresponde a los sectores 7, 7' y 7* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Trachytoid that has a plagioclase to total feldspar ratio between 0.1 and 0.35. qapf fields 7, 7', and 7*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquitoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquita-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-traquita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/trachyticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/trachytic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-biogenico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento biogénico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biogenic sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento compuesto  por material de origen biogénico, en más de un 50 por ciento. debido a que el material biogénico pueden ser restos de esqueletos que no son orgánicos, los sedimentos biogénicos no tienen que ser necesariamente  ricos en materia orgánica.</skos:definition>
    <skos:definition xml:lang="en">Sediment composed of greater than 50 percent material of biogenic origin. because the biogenic material may be skeletal remains that are not organic, all biogenic sediment is not necessarily organic-rich.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-rico-en-materia-organica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/biogenicSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/biogenic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/foidita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">foidita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidite</skos:prefLabel>
    <skos:definition xml:lang="es">Foiditoide con más del 90 por ciento de feldespatoide, entre los componentes qapf.</skos:definition>
    <skos:definition xml:lang="en">Foiditoid that contains greater than 90 percent feldspathoid minerals in the qapf fraction.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/foiditoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-fosfatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario fosfatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phosphate rich sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario, en un estado de consolidación sin especificar, en el que como mínimo el 50 por ciento de sus componentes, ya sean primarios o recristalizados, son fosfatos.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are phosphate minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-fosfatado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fosforita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phosphateRichSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phosphate_rich_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/anortosita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">anortosita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing anorthosite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca anortosítica con feldespatoide en proporción inferior al 10 por ciento, entre los componentes qapf. sector 10' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Anorthositic rock that contains between 0 and 10 percent feldspathoid mineral and no quartz in the qapf fraction. qapf field 10'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-anortositica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingAnorthosite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_anorthosite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-igneo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material ígneo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">igneous material</skos:prefLabel>
    <skos:definition xml:lang="es">Material terrestre formado como resultado de procesos ígneos, como la intrusión y enfriamiento del magma en la corteza o las erupciones volcánicas.</skos:definition>
    <skos:definition xml:lang="en">Earth material formed as a result of igneous processes, e.g. intrusion and cooling of magma in the crust, volcanic eruption.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-compuesto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo-fragmentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo-acido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo-basico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo-de-composicion-intermedia"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/igneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por acumulación y cementación de material detrítico sólido depositado por el aire, el agua o el hielo, o resultante de la acción de otros agentes naturales, como la precipitación de una solución, la acumulación de material orgánico o procesos biogénicos como la secreción por organismos.</skos:definition>
    <skos:definition xml:lang="en">Rock formed by accumulation and cementation of solid fragmental material deposited by air, water or ice, or as a result of other natural agents, such as precipitation from solution, the accumulation of organicmaterial, or from biogenic processes, including secretion by organisms.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/conglomerado-generico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita-generica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/arenisca-generica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-hibrida"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/sedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-doleritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca dolerítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">doleritic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca gabroica (basáltica) o diorítica (andesítica) oscura, de tamaño de grano intermedio entre el del basalto y el gabro, compuesta por plagioclasa, piroxeno y minerales opacos, frecuentemente con textura ofítica. típica de intrusiones hipoabisales. incluye a la dolerita, microdolerita, diabasa y el microgabro.</skos:definition>
    <skos:definition xml:lang="en">Dark colored gabbroic (basaltic) or dioritic (andesitic) rock intermediate in grain size between basalt and gabbro and composed of plagioclase, pyroxene and opaque minerals; often with ophitic texture. typically occurs as hypabyssal intrusions. includes dolerite, microdiorite, diabase and microgabbro.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/doleriticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada como resultado de procesos ígneos, como la intrusión y enfriamiento del magma en la corteza o las erupciones volcánicas.</skos:definition>
    <skos:definition xml:lang="en">Rock formed as a result of igneous processes, for example intrusion and cooling of magma in the crust, or volcanic eruption.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-doleritica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-de-composicion-exotica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-rica-en-vidrio"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-intermedia"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/porfido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-ultrabasica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-ultramafica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/igneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/granofelsita-/-granoblastita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">granofelsita / granoblastita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granofels</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de fábrica granoblástica y sin foliación o con muy poca (menos del 10 por ciento de los granos minerales conforman la fábrica linear o planar).</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock with granoblastic fabric and very little or no foliation (less than 10 percent of the mineral grains in the rock are elements in a planar or linear fabric). grainsize not specified.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/corneana"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/granofels"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granofels"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/carbonato-cristalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">carbonato cristalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">crystalline carbonate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada de mineralogía indeterminada en la cual los procesos diagenéticos han destruido la textura deposicional original.</skos:definition>
    <skos:definition xml:lang="en">Carbonate rock of indeterminate mineralogy in which diagenetic processes have obliterated any original depositional texture.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/crystallineCarbonate"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/crystalline_carbonate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento dolomítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomitic sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado con una relación entre dolomita y calcita (incluyendo el aragonito) mayor que 1.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico-impuro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico-puro"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/dolomiticSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/lodo-industrial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">lodo industrial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sludge</skos:prefLabel>
    <skos:definition xml:lang="es">Subproductos, más o menos líquidos (en el momento de su vertido), de procesos industriales.</skos:definition>
    <skos:definition xml:lang="en">More or less liquid (when disposed) by-products of industrial processes</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/sludge"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-clastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario clástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clastic sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario con un estado de consolidación no especificado en el que al menos el 50 por ciento de las partículas componentes derivan de la erosión, la meteorización o del movimiento en masa de materiales terrestres preexistentes y transportados al lugar de sedimentación por agentes mecánicos como el agua, el viento, el hielo o la gravedad.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material of unspecified consolidation state in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/clasticSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/dolomia-impura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">dolomía impura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure dolomite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada impura con una relación de dolomita con respecto a calcita (incluyendo el aragonito)  mayor que 1.</skos:definition>
    <skos:definition xml:lang="en">Impure carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-dolomitica-o-magnesica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/impureDolomite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/series-de-las-brechas-harinas-de-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">series de las brechas-harinas de falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">breccia-gouge series</skos:prefLabel>
    <skos:definition xml:lang="es">Material de falla con rasgos que indican pérdida de cohesión durante la deformación, tales como espacios vacíos (rellenos o no) o material con matriz no consolidada entre fragmentos. incluye las brechas y las harinas de falla.</skos:definition>
    <skos:definition xml:lang="en">Fault material with features such as void spaces (filled or unfilled), or unconsolidated matrix material between fragments, indicating loss of cohesion during deformation. includes fault-related breccia and gouge.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-relacionado-con-una-falla"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/breccia-gougeSeries"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia_gouge_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-poligenico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material poligénico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">composite genesis material</skos:prefLabel>
    <skos:definition xml:lang="es">Material con un estado de consolidación no especificado formado por modificación geológica de materiales preexistentes fuera del ámbito de los procesos ígneos y sedimentarios.</skos:definition>
    <skos:definition xml:lang="en">Material of unspecified consolidation state formed by geological modification of pre-existing materials outside the realm of igneous and sedimentary processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-compuesto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-poligenica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-relacionado-con-una-falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-generado-por-un-impacto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/alterita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/compositeGenesisMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-de-origen-natural-no-consolidado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material de origen natural no consolidado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">natural unconsolidated material</skos:prefLabel>
    <skos:definition xml:lang="es">Material no consolidado de origen natural, es decir, no antrópico.</skos:definition>
    <skos:definition xml:lang="en">Unconsolidated material known to have natural, i.e. not human-made, origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-no-consolidado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/naturalUnconsolidatedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/natural_unconsolidated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/basanita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">basanita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basanite</skos:prefLabel>
    <skos:definition xml:lang="es">Tefritoide con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento, con más de un 10 por ciento de olivino normativo (cipw).</skos:definition>
    <skos:definition xml:lang="en">Tephritoid that has a plagioclase to total feldspar ratio greater than 0.9, and contains more than 10 percent normative (cipw) olivine.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefritoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/basanite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basanite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/arcillita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">arcillita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">claystone</skos:prefLabel>
    <skos:definition xml:lang="es">Lutita cuyo contenido de limos es indetectable y se considera que está formada exclusivamente por partículas de tamaño arcilla.</skos:definition>
    <skos:definition xml:lang="en">Mudstone that contains no detectable silt, inferred to consist virtually entirely of clay-size particles.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/claystone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/claystone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-piroclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca piroclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea constituida por productos fragmentarios de los cuales más de un 75 por ciento se han producido como resultado de una erupción o extrusión de magma. incluye a las autobrechas asociadas con los flujos de lava y excluye a los depósitos retrabajados por procesos epiclásticos.</skos:definition>
    <skos:definition xml:lang="en">Fragmental igneous rock that consists of greater than 75 percent fragments produced as a direct result of eruption or extrusion of magma from within the earth onto its surface. includes autobreccia associated with lava flows and excludes deposits reworked by epiclastic processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-fragmentaria"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/toba-de-ceniza"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/brecha-tobacea"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/toba-de-ceniza,-lapillistone-y-toba-de-lapilli"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/brecha-tobacea,-aglomerado-o-brecha-piroclastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pyroclasticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzodiorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-monzodiorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz monzodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca monzodiorítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 9* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Monzodioritic rock that contains between 5 and 20 percent quartz.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzodioritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzMonzodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_monzodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sienítica de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar synitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Sienitoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 10 por ciento. sectores 6, 6* y 6' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Syenitoid with a plagioclase to total feldspar ratio of less than 0.1. qapf fields 6, 6*, and 6'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienitoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienita-de-feldespato-alcalino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienita-de-feldespato-alcalino-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita-de-feldespato-alcalino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparSyniticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/brecha-tobacea,-aglomerado-o-brecha-piroclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">brecha tobácea, aglomerado o brecha piroclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuff-breccia, agglomerate, or pyroclastic breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica en la que más del 25 por ciento de las partículas tienen más de 64 mm de longitud. incluye a los aglomerados y las brechas piroclásticas de gillespie y styles (1999).</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock in which greater than 25 percent of particles are greater than 64 mm in largest dimension. includes agglomerate, pyroclastic breccia of gillespie and styles (1999)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-piroclastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/tuff-breccia"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tuff_breccia_agglomerate_or_pyroclastic_breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-impuro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento carbonatado impuro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure carbonate sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado en el que entre el 50 y el 90 por ciento de los elementos integrantes están compuestos por uno (o más) carbonatos de origen intracuencal.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment in which between 50 and 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/impureCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimetaria-ferruginosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimetaria ferruginosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">iron rich sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta, al menos en un 50 por ciento, por minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro), determinados mediante lupa o análisis petrográfico. generalmente contiene un 15 por ciento de hierro en peso.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. corresponds to a rock typically containing 15 percent iron by weight.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-ferruginoso"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/ironRichSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/anfibolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">anfibolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">amphibolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica compuesta en un 75 por ciento o más por anfíbol (verde, marrón o negro) y plagioclasa (incluyendo a la albita). el anfíbol constituye, al menos, un 30 por ciento de la roca y un 50 por ciento de los minerales máficos. otros minerales que suelen estar presentes son cuarzo, clinopiroxeno, granate, minerales del grupo de la epidota, biotita, titanita y escapolita.</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock mainly consisting of green, brown or black amphibole and plagioclase (including albite), which combined form 75 percent or more of the rock, and both of which are present as major constituents. the amphibole constitutes 50 percent or more of the total mafic constituents and is present in an amount of 30 percent or more; other common minerals include quartz, clinopyroxene, garnet, epidote-group minerals, biotite, titanite and scapolite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/amphibolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/amphibolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-komatiitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca komatiítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">komatiitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica ultramáfica rica en magnesio, con típica textura spinifex constituida por intercrecimientos de cristales de olivino en forma de cuchillo y piroxeno, en una masa vítrea. incluye la komatiita y la meimechita.</skos:definition>
    <skos:definition xml:lang="en">Ultramafic, magnesium-rich volcanic rock, typically with spinifex texture of intergrown skeletal and bladed olivine and pyroxene crystals set in abundant glass. includes komatiite and meimechite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-volcanica-magnesica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/komatiiticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/komatiitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo-impuro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento calcáreo impuro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure calcareous carbonate sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado en el que entre el 50 y el 90 por ciento de los elementos integrantes están compuestos por uno (o más) carbonatos de origen intracuencal, con una relación entre calcita (incluyendo el aragonito) y dolomita mayor que 1.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment in which between 50 and 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin, and a calcite (plus aragonite) to dolomite ratio greater than 1 to 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/impureCalcareousCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_calcareous_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-latita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-latita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz latite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca latítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 8* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Latitic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 8*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-latitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzLatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_latite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/andesita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">andesita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">andesite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica con un contenido inferior al 20 por ciento de cuarzo y al 10 por ciento de feldespatoide, entre los componentes qapf; la relación entre la plagioclasa y el total de feldespato es superior al 65 por ciento. normalmente está formada por plagioclasa (frecuentemente zonada de labradorita a oligoclasa), piroxeno, hormblenda y/o biotita. es el equivalente de grano fino de las rocas dioríticas. incluye a las rocas cuya composición modal corresponde a los sectores 9 y 10 del diagrama qapf, o cuya composición química se sitúa en el campo o2 del diagrama tas. el basalto y la andesita comparten los mismos sectores en el diagrama qapf, diferenciándose químicamente por su contenido en sílice, siendo el del basalto inferior al 52 por ciento de su peso. si no se dispone de la composición química, se clasifican a partir del índice de color, en cuyo caso el basalto contiene más de un 35 por ciento de minerales máficos en volumen o más del 40 por ciento en peso.</skos:definition>
    <skos:definition xml:lang="en">Fine-grained igneous rock with less than 20 percent quartz and less than 10 percent feldspathoid minerals in the qapf fraction, in which the ratio of plagioclase to total feldspar is greater 0.65. includes rocks defined modally in qapf fields 9 and 10 or chemically in tas field o2 as andesite. basalt and andesite, which share the same qapf fields, are distinguished chemically based on silica content, with basalt defined to contain less than 52 weight percent silica. if chemical data are not available, the color index is used to distinguish the categories, with basalt defined to contain greater than 35 percent mafic minerals by volume or greater than 40 percent mafic minerals by weight. typically consists of plagioclase (frequently zoned from labradorite to oligoclase), pyroxene, hornblende and/or biotite. fine grained equivalent of dioritic rock.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/boninita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/andesite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/andesite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-hibrida">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria híbrida</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hybrid sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria que no encaja en ninguna otra de las categorías de roca sedimentaria según la composición o el origen. roca sedimentaria formada por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50 por ciento del material.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock that does not fit any of the other composition/genesis categories. sedimentary rock consisting of three or more components which form more than 5 percent but less than 50 precent of the material.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/hybridSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/diorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">diorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca diorítica que contiene cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. está compuesta por plagioclasa intermedia, comúnmente con horblenda y de manera frecuente con biotita o augita; contiene plagioclasa sódica (an0-an50). su índice de color m es inferior a 90. incluye a las rocas modalmente asignadas al campo 10 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline rock consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite; colour index m less than 90, sodic plagioclase (an0-an50), no feldspathoid, and between 0 and 5 percent quartz. includes rocks defined modally in qapf field 10 as diorite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-dioritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/diorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/diorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-intermedia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea intermedia</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intermediate composition igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con un porcentaje de sio2 comprendido entre el 52 y el 63 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with between 52 and 63 percent sio2.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/dioritoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/intermediateCompositionIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/intermediate_composition_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/toba-de-ceniza,-lapillistone-y-toba-de-lapilli">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">toba de ceniza, lapillistone y toba de lapilli</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ash tuff, lapillistone, and lapilli tuff</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica con un porcentaje inferior al 25 por ciento de su volumen constituido por piroclastos con más de 64 mm de longitud.</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock in which less than 25 percent of rock by volume are more than 64 mm in longest diameter. includes tuff, lapilli tuff, and lapillistone.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-piroclastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/ashTuff"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/rocas-kalsilititicas-y-melilititas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">rocas kalsilitíticas y melilititas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kalsilitic and melilitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Rocas ígneas que contienen más de un 10 por ciento de kalsilita o melilita. generalmente son rocas máficas o ultramáficas, subsaturadas, ultrapotásicas (rocas kalsilitíticas) o ricas en calcio (melilititas).</skos:definition>
    <skos:definition xml:lang="en">Igneous rock containing greater than 10 percent melilite or kalsilite. typically undersaturated, ultrapotassic (kalsilitic rocks) or calcium-rich (melilitic rocks) mafic or ultramafic rocks.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-de-composicion-exotica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/kalsiliticAndMeliliticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/lutita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">lutita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria clástica con menos de un 30 por ciento de clastos de tamaño arena (0,6 - 2,0 mm de diámetro) y una relación entre partículas de lutita y granos de arena mayor que 1.</skos:definition>
    <skos:definition xml:lang="en">Clastic sedimentary rock consisting of less than 30 percent sand-size (0.6 mm) particles and with a mud to sand ratio greater than 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/arcillita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/shale"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/limolita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/mudstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/pegmatita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">pegmatita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pegmatite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cristalina de grano excepcionalmente grueso, mayoritariamente de más de 1 cm de diámetro, con intercrecimiento de cristales; generalmente su composición es la del granito, pero se refiere a cualquier roca ígnea de grano grueso. habitualmente aparece como diques irregulares, lentejones o venas asociadas a plutones o batolitos.</skos:definition>
    <skos:definition xml:lang="en">Exceptionally coarse grained crystalline rock with interlocking crystals; most grains are 1cm or more diameter; composition is generally that of granite, but the term may refer to the coarse grained facies of any type of igneous rock;usually found as irregular dikes, lenses, or veins associated with plutons or batholiths.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pegmatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pegmatite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/lutita-siliciclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">lutita siliciclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silicate mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Lutita que contiene menos de un 10 por ciento de carbonatos.</skos:definition>
    <skos:definition xml:lang="en">Mudstone that contains less than 10 percent carbonate minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita-generica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/silicateMudstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/silicate_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-ultrabasica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea ultrabásica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultrabasic igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con menos de un 45 por ciento de sio2.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with less than 45 percent sio2.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/ultrabasicIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ultrabasic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/lignito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">lignito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lignite</skos:prefLabel>
    <skos:definition xml:lang="es">Carbón consolidado, sin brillo, de marrón suave a negro, en el que pueden distinguirse fragmentos de plantas en una matriz orgánica de grano fino. incluye a todos los carbones de bajo rango, incluido el carbón sub-bituminoso, cuyas vetas marrones permiten su distinción con respecto al carbón bituminoso, de vetas negras. tiende a fracturarse al secarse. tiene un poder calorífico inferior a 24mj/kg (determinado según la iso 1928) y la reflectancia de la vitrinita es inferior al 0,6 por ciento (determinada según la iso 7404-5). el valor calorífico bruto se recalcula libre de cenizas y humedad usando la humedad inherente (determinado según la iso 1015 o la iso 5068).</skos:definition>
    <skos:definition xml:lang="en">Coal that has a gross calorific value less than 24 mj/kg (determined in conformance with iso 1928), and vitrinite mean random reflectance less than 0.6 por ciento (determined in conformance with iso 7404-5). gross calorific value is recalculated to a moist, ash free basis using bed moisture (determined according to iso 1015 or iso 5068). includes all low-rank coals, including sub-bitiminous coal. a consolidated, dull, soft brown to black coal having many readily discernible plant fragments set in a finer grained organic matrix. tends to crack and fall apart on drying. operationally sub-bituminous and bitiminous coal are qualitatively distinguished based on brown streak for sub-bitiminous coal and black streak for bituminous coal.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/carbon"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/lignite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/lignite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/grava-gruesa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">grava gruesa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cobble gravel size sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento que contiene más de un 30 por ciento de clastos de tamaño canto (64-256 mm de diámetro).</skos:definition>
    <skos:definition xml:lang="en">Sediment containing greater than 30 percent cobble-size particles (64-256 mm in diameter)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/cobbleGravelSizeSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/cobble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzogabro-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzogabro con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing monzogabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca monzogabroica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 9' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Monzogabbroic rock that contains 0 to 10 percent feldspathoid mineral in the qapf fraction. qapf field 9'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingMonzogabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzogabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/basalto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">basalto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basalt</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica porfídica o de grano fino con menos de un 20 por ciento de cuarzo y menos de un 10 por ciento de feldespatoide, entre los componentes qapf; la proporción de la plagioclasa con respecto al total de feldespato es mayor del 65 por ciento. generalmente está constituida por fenocristales de plagioclasa cálcica, clinopiroxeno y olivino. incluye a las rocas de los sectores 9 y 10 del diagrama qapf y del sector b del diagrama tas. el basalto y la andesita se diferencian químicamente por su contenido en sílice, siendo el del basalto inferior al 52 por ciento de su peso. si no se dispone de la composición química, se clasifican a partir del índice de color, en cuyo caso el basalto se define por contener más de un 35 por ciento de minerales máficos en volumen o más del 40 por ciento en peso.</skos:definition>
    <skos:definition xml:lang="en">Fine-grained or porphyritic igneous rock with less than 20 percent quartz, and less than 10 percent feldspathoid minerals, in which the ratio of plagioclase to total feldspar is greater 0.65. typically composed of calcic plagioclase and clinopyroxene; phenocrysts typically include one or more of calcic plagioclase, clinopyroxene, orthopyroxene, and olivine. includes rocks defined modally in qapf fields 9 and 10 or chemically in tas field b as basalt. basalt and andesite are distinguished chemically based on silica content, with basalt defined to contain less than 52 weight percent silica. if chemical data are not available, the color index is used to distinguish the categories, with basalt defined to contain greater than 35 percent mafic minerals by volume or greater than 40 percent mafic minerals by weight.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-basica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/basalto-olivinico-alcalino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/basalto-toleitico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/basalt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/caliza-impura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">caliza impura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada impura con una relación de calcita (incluyendo el aragonito) con respecto a dolomita mayor que 1.</skos:definition>
    <skos:definition xml:lang="en">Impure carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-calcarea"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/impureLimestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/antracita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">antracita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anthracite coal</skos:prefLabel>
    <skos:definition xml:lang="es">Carbón que contiene vitrinita con un valor medio de reflectancia (ro) superior al 2 por ciento (determinado según la iso 7404-5). contiene (en seco y libre de cenizas) valores inferiores al 12-14 por ciento de volátiles y un porcentaje superior al 91 por ciento de carbono fijado. es el carbón de mayor rango. es muy duro, satinado, negro, con brillo semimetálico y fractura semi-concoidea.</skos:definition>
    <skos:definition xml:lang="en">Coal that has vitrinite mean random reflectance greater than 2.0 per cent (determined in conformance with iso 7404-5). less than 12-14 percent volatiles (dry, ash free), greater than 91 percent fixed carbon (dry, ash free basis). the highest rank coal; very hard, glossy, black, with semimetallic luster, semi conchoidal fracture.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/carbon"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/anthraciteCoal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthracite_coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-rica-en-vidrio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea rica en vidrio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glass rich igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con un porcentaje de vidrio superior al 50 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock that contains greater than 50 percent massive glass.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-vitrea"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/glassRichIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/glass_rich_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/bauxita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">bauxita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bauxite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria muy alumínica que contiene abundantes hidróxidos de aluminio (gibbsita y, de manera menos habitual, boehmita y diásporo) y óxidos e hidróxidos de hierro, generalmente con proporción muy baja o despreciable de minerales de caolín; puede contener más de un 20 por ciento de cuarzo. habitualmente presenta textura pisolítica o nodular y puede estar cementada.</skos:definition>
    <skos:definition xml:lang="en">Highly aluminous material containing abundant aluminium hydroxides (gibbsite, less commonly boehmite, diaspore) and aluminium-substituted iron oxides or hydroxides and generally minor or negligible kaolin minerals; may contain up to 20 percent quartz. commonly has a pisolitic or nodular texture, and may be cemented.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/alterita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/bauxite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/bauxite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/diorita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">diorita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing diorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca diorítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 10' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Dioritic rock that contains between 0 and 10 percent feldspathoid minerals in the qapf fraction. qapf field 10'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-dioritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingDiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_diorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/porfido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">pórfido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">porphyry</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea constituida por destacados fenocristales, en una matriz más fina, fanerítica o de grano fino.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock that contains conspicuous phenocrysts in a finer grained groundmass; groundmass itself may be phaneritic or fine-grained.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/porphyry"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/porphyry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/framestone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">framestone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">framestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca arrecifal carbonatada formada por una estructura rígida de colonias, conchas o esqueletos, con cavidades internas rellenas de sedimentos finos; normalmente su origen es debido a la actividad de organismos coloniales.</skos:definition>
    <skos:definition xml:lang="en">Carbonate reef rock consisting of a rigid framework of colonies, shells or skeletons, with internal cavities filled with fine sediment; usually created through the activities of colonial organisms.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/framestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/framestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/carbon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">carbón</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coal</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario orgánico consolidado que tiene menos de un 75 por ciento de humedad. incluye a los carbones de rangos bajo, medio y alto según la clasificación internacional de carbones en veta (naciones unidas, 1998), por lo tanto incluye al lignito. el carbón sapropélico no se diferencia de los carbones húmicos dentro de esta denominación. se forma a partir de la compactación o el endurecimiento de restos de plantas, de manera similar a los depósitos de turba.</skos:definition>
    <skos:definition xml:lang="en">A consolidated organic sedimentary material having less than 75 por ciento moisture. this category includes low, medium, and high rank coals according to international classification of in-seam coal (united nations, 1998), thus including lignite. sapropelic coal is not distinguished in this category from humic coals. formed from the compaction or induration of variously altered plant remains similar to those of peaty deposits.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-rica-en-materia-organica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/antracita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/hulla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lignito"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/coal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rock</skos:prefLabel>
    <skos:definition xml:lang="es">Agregado consolidado de uno o más materiales terrestres, o cuerpo de materia mineral indiferenciada o de materia orgánica sólida.</skos:definition>
    <skos:definition xml:lang="en">Consolidated aggregate of one or more earth materials, or a body of undifferentiated mineral matter, or of solid organicmaterial.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-compuesto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/afanita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tufita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/rock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria carbonatada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria en la que al menos el 50 por ciento de los componentes primarios y/o recristalizados están constituidos por uno (o más) de los minerales carbonatados calcita, aragonito, magnesita y dolomita.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite, magnesite or dolomite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/boundstone"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/marga"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/wackestone"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/carbonato-cristalino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-dolomitica-o-magnesica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/framestone"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/grainstone"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada-impura"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/packstone"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada-pura"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonateSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/eclogita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">eclogita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">eclogite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica constituida al menos en un 75 por ciento (en volumen) por onfacita y granate, siendo ambos los componentes mayoritarios, sin superar ninguno de ellos el 75 por ciento en volumen. la presencia de plagioclasa descarta la clasificación como eclogita.</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock composed of 75 percent or more (by volume) omphacite and garnet, both of which are present as major constituents, the amount of neither of them being higher than 75 percent (by volume); the presence of plagioclase precludes classification as an eclogite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/eclogite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/eclogite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-traquita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-traquita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz alkali feldspar trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca traquítica de feldespato alcalino que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 6* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Alkali feldspar trachytic rock that contains and between 5 and 20 percent quartz mineral in the qapf fraction. qapf field 6*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica-de-feldespato-alcalino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzAlkaliFeldsparTrachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_alkali_feldspar_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/gabro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">gabro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca gabroica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye a las rocas del sector 10 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Gabbroic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the qapf fraction. includes rocks defined modally in qapf field 10 as gabbro.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-gabroica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/gabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/carbonatita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">carbonatita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonatite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea que en su composición modal contiene más de un 50 por ciento de minerales carbonatados.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock composed of more than 50 percent modal carbonate minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-de-composicion-exotica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonatite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzodiorita-foiditica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzodiorita foidítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid monzodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Dioritoide foidítico con una proporción entre la plagioclasa y el total de feldespato inferior al 90 por ciento. incluye a las rocas del sector 13 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Foid dioritoid in which the plagioclase to total feldspar ratio is between 0.1 and 0.9. includes rocks defined modally in qapf field 13.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/dioritoide-foiditico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidMonzodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_monzodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/conglomerado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">conglomerado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">conglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria clástica formada por un mínimo del 30 por ciento de clastos redondeados a subangulosos de diámetro superior a 2 mm; normalmente contiene material de grano fino en los intersticios entre los clastos. si no puede ser determinado el origen clástico o diagenético de más del 15 por ciento de la matriz de grano fino y la fábrica es matriz-soportada, puede ser considerada una grauvaca. si la roca está mal seleccionada, también puede ser considerada una diamictita.</skos:definition>
    <skos:definition xml:lang="en">Clastic sedimentary rock composed of at least 30 percent rounded to subangular fragments larger than 2 mm in diameter; typically contains finer grained material in interstices between larger fragments. if more than 15 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wackestone. if rock has unsorted or poorly sorted texture with a wide range of particle sizes, may also be categorized as diamictite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/conglomerate"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sieno-granito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sieno-granito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">syenogranite</skos:prefLabel>
    <skos:definition xml:lang="es">Granito cuyo contenido en plagioclasa con respecto al total de feldespato es inferior al 35 por ciento. incluye a las rocas del sector 3a del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Granite that has a plagioclase to total feldspar ratio between 0.10 and 0.35. qapf field 3a.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granito"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/syenogranite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenogranite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/traquita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">traquita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca traquítica de feldespato alcalino con cuarzo, en una proporción inferior al 5 por ciento, entre los componentes qapf. sector 6 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Trachytoid that has a plagioclase to total feldspar ratio less than 0.1, between 0 and 5 percent quartz in the qapf fraction, and no feldspathoid minerals. qapf field 6.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica-de-feldespato-alcalino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparTrachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-calcareo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario calcáreo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous carbonate sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario carbonatado, en un estado de consolidación sin especificar, cuya proporción entre calcita (más aragonito) y dolomita es mayor que 1. incluye a los sedimentos calizos, las calizas y las calizas dolomíticas.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary material of unspecified consolidation state with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes lime-sediments, limestone and dolomitic limestone.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-calcarea"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/calcareousCarbonateSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/arenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">arenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">arenite</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca clástica que contiene menos del 10 por ciento de matriz. la matriz es de origen detrítico o diagenético y está formada por silicatos de tamaño lutita (arcilla, feldespatos, cuarzo, fragmentos de roca y productos de alteración).</skos:definition>
    <skos:definition xml:lang="en">Clastic sandstone that contains less than 10 percent matrix. matrix is mud-size silicate minerals (clay, feldspar, quartz, rock fragments, and alteration products) of detrital or diagenetic nature.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/arenisca"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/arenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/gabroide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">gabroide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gabbroid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica que contiene menos de un 90 por ciento de minerales máficos y hasta un 20 por ciento de cuarzo o un 10 por ciento de feldespatoide, entre los componentes qapf. la proporción de la plagioclasa con respecto al total de feldespato es mayor del 65 por ciento y el de anortita con respecto a la plagioclasa, mayor del 50 por ciento. incluye a las rocas de los sectores 9 y 10 (y sus subdivisiones) del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock that contains less than 90 percent mafic minerals, and up to 20 percent quartz or up to 10 percent feldspathoid in the qapf fraction. the ratio of plagioclase to total feldspar is greater than 0.65, and anorthite content of the plagioclase is greater than 50 percent. includes rocks defined modally in qapf fields 9 and 10 and their subdivisions.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/gabbroid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/encostramiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">encostramiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">duricrust</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formando una costra o capa dura en la superficie de la tierra o cerca de ella, p. e. en los horizontes superiores de un suelo; se caracteriza por presentar estructuras indicativas de su origen pedogénico.</skos:definition>
    <skos:definition xml:lang="en">Rock forming a hard crust or layer at or near the earth's surface at the time of formation, e.g. in the upper horizons of a soil, characterized by structures indicative of pedogenic origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-poligenica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/duricrust"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/duricrust"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/grava">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">grava</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gravel</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento clástico que contiene más de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro). más de la mitad de los clastos son de origen epiclástico.</skos:definition>
    <skos:definition xml:lang="en">Clastic sediment containing greater than 30 percent gravel-size particles (greater than 2.0 mm diameter). gravel in which more than half of the particles are of epiclastic origin</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/gravel"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento clástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clastic sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento en el que al menos el 50 por ciento de las partículas constituyentes provienen de la erosión, la meteorización o el movimiento en masa de materiales preexistentes, que han sido transportados hasta su lugar de depósito por agentes mecánicos, tales como el agua, el viento, el hielo y la gravedad.</skos:definition>
    <skos:definition xml:lang="en">Sediment in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-clastico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/diamicton"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/grava"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/pelita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/arena"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/clasticSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/tonalita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">tonalita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tonalite</skos:prefLabel>
    <skos:definition xml:lang="es">Granitoide constituido por cuarzo y plagioclasa intermedia, generalmente con biotita y anfíbol, con una proporción de plagioclasa con respecto al total de feldespato mayor del 90 por ciento. incluye a las rocas del sector 5 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Granitoid consisting of quartz and intermediate plagioclase, usually with biotite and amphibole. includes rocks defined modally in qapf field 5; ratio of plagioclase to total feldspar is greater than 0.9.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granitoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/tonalite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tonalite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fango-rico-en-carbonatos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fango rico en carbonatos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate rich mud</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento de tamaño lutita que contiene entre el 10 y el 50 por ciento de minerales carbonatados de cualquier tamaño. no tiene un origen específico.</skos:definition>
    <skos:definition xml:lang="en">Mud size sediment that contains between 10 and 50 percent carbonate minerals in any size fraction. carbonate origin is not specified.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-pelitico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonateRichMud"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/alterita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">Alterita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">material formed in surficial environment</skos:prefLabel>
    <skos:definition xml:lang="es">Material resultante de procesos de meteorización activos en rocas o depósitos preexistentes, análogo a las rocas hidrotermales o metasomáticas, pero formado a la temperatura y presión ambiente de la superficie de la tierra.</skos:definition>
    <skos:definition xml:lang="en">Material that is the product of weathering processes operating on pre-existing rocks or deposits, analogous to hydrothermal or metasomatic rocks, but formed at ambient earth surface temperature and pressure.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-poligenico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/bauxita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/regolito"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/materialFormedInSurficialEnvironment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/material_formed_in_surficial_environment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-arena">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento de tamaño arena</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sand size sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento con menos de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro) y una relación entre granos de arena y partículas de lutita mayor que 1. la composición o la génesis de los clastos no se especifican.</skos:definition>
    <skos:definition xml:lang="en">Sediment in which less than 30 percent of particles are gravel (greater than 2 mm in diameter) and the sand to mud ratio is at least 1. composition or genesis of clasts not specified.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/sandSizeSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-milonitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca milonítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mylonitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica que se caracteriza por una foliación debida a la disminución del tamaño de grano como consecuencia de esfuerzos tectónicos, y en la que más del 10 por ciento del volumen de la roca ha experimentado una reducción del tamaño de grano. incluye a las protomilonitas, milonitas, ultramilonitas y blastomilonitas.</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock characterised by a foliation resulting from tectonic grain size reduction, in which more than 10 percent of the rock volume has undergone grain size reduction. includes protomylonite, mylonite, ultramylonite, and blastomylonite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-relacionado-con-una-falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/filonita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/myloniticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzodiorita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzodiorita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing monzodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca monzodiorítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 9' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Monzodioritic rock that contains between 0 and 10 percent feldspathoid mineral.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzodioritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingMonzodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/shale">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">shale</skos:prefLabel>
    <skos:prefLabel xml:lang="en">shale</skos:prefLabel>
    <skos:definition xml:lang="es">Lutita laminada que puede ser partida o rota a favor de niveles delgados paralelos a la estratificación.</skos:definition>
    <skos:definition xml:lang="en">Laminated mudstone that will part or break along thin, closely spaced layers parallel to stratification.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/shale"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/shale"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-siliceo-no-clastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento silíceo no clástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">non-clastic siliceous sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento compuesto, como mínimo en un 50 por ciento, por material silíceo depositado por procesos biológicos o químicos sobre la superficie de sedimentación, o por partículas formadas por procesos químicos o biológicos en la cuenca sedimentaria.</skos:definition>
    <skos:definition xml:lang="en">Sediment that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-siliceo-no-clastico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/barro-de-radiolarios"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/non-clasticSiliceousSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/ceniza-y-lapilli">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">ceniza y lapilli</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ash and lapilli</skos:prefLabel>
    <skos:definition xml:lang="es">Piroclastos (o tefra) en los que menos de un 25 por ciento de los fragmentos tienen más de 64 mm de longitud.</skos:definition>
    <skos:definition xml:lang="en">Tephra in which less than 25 percent of fragments are greater than 64 mm in longest dimension</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/ashAndLapilli"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_and_lapilli"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-2">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fango carbonatado 2</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate ooze</skos:prefLabel>
    <skos:definition xml:lang="es">Fango formado, en más del 50 por ciento, por restos de esqueletos carbonatados.</skos:definition>
    <skos:definition xml:lang="en">Ooze that consists of more than 50 percent carbonate skeletal remains</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-2"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-2"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonateOoze"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/diamicton">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">diamictón</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diamicton</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento clástico sin selección o mal seleccionado, de granulometría muy variada, con matriz lutítica. no incluye a los materiales biogénicos que tienen la misma textura. se diferencia de los conglomerados, las areniscas y las lutitas por la polimodalidad y la ausencia de estructuras relacionadas con su transporte y depósito por acción del aire o del agua. su denominación puede complementarse con la granulometría predominante.</skos:definition>
    <skos:definition xml:lang="en">Unsorted or poorly sorted, clastic sediment with a wide range of particle sizes, including a muddy matrix. biogenic materials that have such texture are excluded. distinguished from conglomerate, sandstone, mudstone based on polymodality and lack of structures related to transport and deposition of sediment by moving air or water. assignment to an other size class can be used in conjunction to indicate the dominant grain size.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/diamicton"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/diamicton"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/tefrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">tefrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephrite</skos:prefLabel>
    <skos:definition xml:lang="es">Tefritoide cuyo contenido en plagioclasa con respecto al total de feldespato es mayor del 90 por ciento, con menos de un 10 por ciento de olivino normativo (cipw).</skos:definition>
    <skos:definition xml:lang="en">Tephritoid that has a plagioclase to total feldspar ratio greater than 0.9, and contains less than 10 percent normative (cipw) olivine.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefritoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/tephrite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephrite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-quimico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario químico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chemical sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario constituido al menos en el 50 por ciento por material producido por procesos químicos inorgánicos dentro de la cuenca de sedimentación. incluye sedimentos inorgánicos silíceos, carbonatados, evaporíticos, ferruginosos y fosfáticos.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material that consists of at least 50 percent material produced by inorganic chemical processes within the basin of deposition. includes inorganic síliceous, carbonate, evaporite, iron-rich, and phosphatic sediment classes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/evaporita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-ferruginoso"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/travertino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/chemicalSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/chemical_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/tefrita-fonolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">tefrita fonolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolitic tephrite</skos:prefLabel>
    <skos:definition xml:lang="es">Tefritoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento y que contiene olivino normativo (cipw) en una proporción inferior al 10 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Tephritoid that has a plagioclase to total feldspar ratio between 0.5 and 0.9, and contains less than 10 percent normative (cipw) olivine.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefritoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phonoliticTephrite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_tephrite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-pelitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento pelítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mud size sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento clástico con menos de un 30 por ciento de clastos de tamaño arena (0,6 - 2,0 mm de diámetro) y una relación entre partículas de lutita y granos de arena mayor que 1. los granos pueden ser de composición y origen diverso.</skos:definition>
    <skos:definition xml:lang="en">Sediment consisting of less than 30 percent sand-size (0.6 mm) particles and with a mud-size to sand-size particle ratio greater than 1. grains may be of any composition or origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango-rico-en-carbonatos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango-siliceo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/mudSizeSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada-pura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria carbonatada pura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure carbonate sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria en la cual más de un 90 por ciento de sus constituyentes primarios o recristalizados son carbonatos.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock in which greater than 90 percent of the primary and/or recrystallized constituents are carbonate minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pureCarbonateSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_carbonate_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzogranito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzogranito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzogranite</skos:prefLabel>
    <skos:definition xml:lang="es">Granito con una proporción de plagioclasa con respecto al total de feldespato superior 35 por ciento. incluye a las rocas del sector 3b del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Granite that has a plagiolcase to total feldspar ratio between 0.35 and 0.65. qapf field 3b.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granito"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/monzogranite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzogranite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sienítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">synitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Sienitoide en el que la proporción entre la plagioclasa y el total de feldespato está comprendida entre el 10 y el 35 por ciento. incluye las rocas de los sectores 7, 7' y 7* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Syenitoid with a plagioclase to total feldspar ratio between 0.1 and 0.35. includes rocks in qapf fields 7, 7*, and 7'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienitoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienita-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/syniticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/traquita-de-feldespato-alcalino-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">traquita de feldespato alcalino con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing alkali feldspar trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca traquítica de feldespato alcalino con feldespatoide en proporción inferior al 10 por ciento, entre los componentes qapf. sector 6' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Alkali feldspar trachytic rock that contains no quartz and between 0 and 10 percent feldspathoid mineral in the qapf fraction. qapf field 6'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica-de-feldespato-alcalino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingAlkaliFeldsparTrachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_alkali_feldspar_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico-impuro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento dolomítico impuro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure dolomitic sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado en el que entre el 50 y el 90 por ciento de los elementos integrantes están compuestos por uno (o más) carbonatos de origen intracuencal, con una relación entre dolomita y calcita (incluyendo el aragonito) superior a 1.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment in which between 50 and 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin, and the ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/impureDolomiticSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_dolomitic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-rica-en-materia-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca rica en materia orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organic rich sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria cuyo color, composición, textura y densidad aparente indican que contiene más del 50 por ciento en peso (en seco) de materia orgánica.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock with color, composition, texture and apparent density indicating greater than 50 percent organic content by weight on a moisture-free basis.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-rico-en-materia-organica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/carbon"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/organicRichSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-de-la-facies-de-la-clorita-actinolita-epidota">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca metamórfica de la facies de la clorita-actinolita-epidota</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chlorite actinolite epidote metamorphic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica caracterizada por la presencia, en una proporción igual o superior al 50 por ciento, de clorita, actinolita y epidota combinadas. corresponde a la categoría generalmente llamada esquistos verdes.</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock characterized by 50 percent or more of combined chlorite, actinolite and epidote. category for rocks generally named greenschist or greenstone.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/chloriteActinoliteEpidoteMetamorphicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/chlorite_actinolite_epidote_metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-poligenica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca poligénica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">composite genesis rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por modificación geológica de rocas preexistentes al margen de los procesos ígneos y sedimentarios.</skos:definition>
    <skos:definition xml:lang="en">Rock formed by geological modification of pre-existing rocks outside the realm of igneous and sedimentary processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-poligenico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/serie-de-las-cataclasitas"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/encostramiento"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metasomatica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/compositeGenesisRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Litología</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Lithology</skos:prefLabel>
    <dcterms:title xml:lang="es">Litología</dcterms:title>
    <dcterms:title xml:lang="en">Lithology</dcterms:title>
    <skos:definition xml:lang="es">Términos que definen el material que constituye parte o la totalidad de la unidad geológica.</skos:definition>
    <skos:definition xml:lang="en">The material that comprises part or all of the geologic unit. Description: This refers to a vocabulary of lithological terms.</skos:definition>
    <dcterms:description xml:lang="es">Términos que definen el material que constituye parte o la totalidad de la unidad geológica.</dcterms:description>
    <dcterms:description xml:lang="en">The material that comprises part or all of the geologic unit. Description: This refers to a vocabulary of lithological terms.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos originales de INSPIRE</dcterms:provenance>
    <dcterms:creator>https://commission.europa.eu/</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Litología.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-compuesto"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/bitumen"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/escombro"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/hormigon"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/escombera"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lodos-de-depuradora"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/escoria"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lodo-industrial"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fertilizante"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/horizonte-organico-del-suelo"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/litologia/desecho"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-latitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca latítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">latitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Traquitoide con una proporción entre la plagioclasa y el total de feldespato superior al 65 por ciento. sectores 8, 8' y 8* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Trachytoid that has a plagioclase to total feldspar ratio between 0.35 and 0.65. qapf fields 8, 8' and 8*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquitoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/latita-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/latita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-latita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/latiticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/arenisca-generica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">arenisca genérica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">generic sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria con menos de un 30 por ciento de componentes mayores de 2 mm de diámetro (grava) y cuya relación entre el contenido de granos de arena y de partículas de lutita es al menos 1.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock in which less than 30 percent of particles are greater than 2 mm in diameter (gravel) and the sand to mud ratio is at least 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/genericSandstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/generic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/dioritoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">dioritoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dioritoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica compuesta por plagioclasa intermedia, comúnmente con hornblenda y de manera frecuente con biotita o augita. la proporción de la plagioclasa con respecto al total de feldespato es mayor del 65 por ciento y la proporción de anortita con respecto al total de plagioclasa es inferior al 50 por ciento. contiene menos de un 10 por ciento de feldespatoide y de un 20 por ciento de cuarzo, entre los componentes qapf. posee un índice de color m inferior a 90. incluye a las rocas modalmente incluidas en los campos 9 y 10 (y sus subdivisiones) del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock with m less than 90, consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite. plagioclase to total feldspar ratio is greater that 0.65, and anorthite content of plagioclase is less than 50 percent. less than 10 percent feldspathoid mineral and less than 20 percent quartz in the qapf fraction. includes rocks defined modally in qapf fields 9 and 10 (and their subdivisions).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-intermedia"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-dioritica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzodioritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/dioritoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dioritoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca metamórfica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metamorphic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca generada por los cambios mineralógicos, texturales y/o estructurales, en estado sólido, producidos sobre una roca pre-existente, como respuesta a cambios importantes de temperatura, presión, esfuerzos de cizalla o condiciones químicas del ambiente.</skos:definition>
    <skos:definition xml:lang="en">Rock formed by solid-state mineralogical, chemical and/or structural changes to a pre-existing rock, in response to marked changes in temperature, pressure, shearing stress and chemical environment.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-poligenica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/anfibolita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-de-la-facies-de-la-clorita-actinolita-epidota"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/eclogita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/esquisto-azul"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granofelsita-/-granoblastita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granulita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/marmol"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/migmatita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarcita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/serpentinita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/metamorphicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-fosfatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento fosfatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phosphate rich sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento en el que como mínimo el 50 por ciento de sus componentes, ya sean primarios o recristalizados, son fosfatos.</skos:definition>
    <skos:definition xml:lang="en">Sediment in which at least 50 percent of the primary and/or recrystallized constituents are phosphate minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-fosfatado"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phosphateRichSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phosphate_rich_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzosienita-foiditica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzosienita foidítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid monzosyenite</skos:prefLabel>
    <skos:definition xml:lang="es">Sienitoide foidítico con una proporción entre la plagioclasa y el total de feldespato superior al 10 por ciento. incluye a las rocas del sector 12 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Foid syenitoid rock that has a plagioclase to total feldspar ratio of between 0.1 and 0.5. includes rocks defined modally in qapf field 12.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienitoide-foiditico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidMonzosyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_monzosyenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-sienita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz alkali feldspar syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sienítica de feldespato alcalino que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 6* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Alkali feldspar synitic rock that contains 5 to 20 percent quartz and no feldspathoid in the qapf fraction. qapf field 6*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzAlkaliFeldsparSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_alkali_feldspar_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-ultramafica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea ultramáfica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultramafic igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea formada por más de un 90 por ciento de minerales máficos.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock that consists of greater than 90 percent mafic minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/ultramaficIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ultramafic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-dolomitico-o-magnesico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario dolomítico o magnésico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomitic or magnesian sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario carbonatado, en un estado de consolidación sin especificar, con una relación entre carbonato de magnesio y carbonato cálcico (incluyendo el aragonito) superior a 1. incluye el material sedimentario dolomítico, la dolomía, la dolomía calcárea y la magnesita.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary material of unspecified consolidation degree with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. includes dolomite sediment, dolostone, lime dolostone and magnesite-stone.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/dolomiticOrMagnesianSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-alcalina-exotica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca alcalina exótica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">exotic alkaline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Kimberlita, lamproíta o lamprófido. generalmente son rocas potásicas máficas o ultramáficas. su contenido en olivino (frecuentemente serpentinizado en la kimberlita) y en flogopita es significativo.</skos:definition>
    <skos:definition xml:lang="en">Kimberlite, lamproite, or lamprophyre. generally are potassic, mafic or ultramafic rocks. olivine (commonly serpentinized in kimberlite), and phlogopite are significant constituents.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-de-composicion-exotica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/exoticAlkalineRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/limolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">limolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">siltstone</skos:prefLabel>
    <skos:definition xml:lang="es">Lutita que contiene más de un 50 por ciento de partículas de tamaño limo.</skos:definition>
    <skos:definition xml:lang="en">Mudstone that contains detectable silt. (see comments)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/siltstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/siltstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-dioritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca diorítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dioritic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Dioritoide con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. está compuesta por plagioclasa intermedia, comúnmente con hornblenda y de manera frecuente con biotita o augita. posee un índice cromático m inferior a 90. engloba a las rocas modalmente incluidas en los campos 10, 10' y 10* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline rock with m less than 90, consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite. a dioritoid with a plagioclase to total feldspar ratio (in the qapf fraction) greater than 0.9. includes rocks defined modally in qapf fields 10, 10' and 10*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/dioritoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/diorita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/diorita-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-diorita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/dioriticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dioritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material formado por acumulación de fragmentos sólidos depositado por el aire, el agua o el hielo, o acumulado por la acción de otros agentes naturales, como la precipitación química de una solución o la secreción por organismos.</skos:definition>
    <skos:definition xml:lang="en">Material formed by accumulation of solid fragmental material deposited by air, water or ice, or material that accumulated by other natural agents such as chemical precipitation from solution or secretion by organisms.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-compuesto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-quimico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-clastico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-siliceo-no-clastico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-rico-en-materia-organica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-fosfatado"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/sedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/creta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">creta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chalk</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza, generalmente porosa, blanda, blanca, de grano muy fino y extremadamente pura. se forma en ambientes marinos por la acumulación gradual de esqueletos de diminutas algas verdes planctónicas (cocolitos), con proporciones variables de fragmentos microscópicos de bivalvos, foraminíferos y ostrácodos. de forma habitual incorpora nódulos de sílex y chert.</skos:definition>
    <skos:definition xml:lang="en">A generally soft, white, very fine-grained, extremely pure, porous limestone. it forms under marine conditions from the gradual accumulation of skeletal elements from minute planktonic green algae (cocoliths), associated with varying proportions of larger microscopic fragments of bivalves, foraminifera and ostracods. it is common to find flint and chert nodules embedded in chalk.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/caliza"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/chalk"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/chalk"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sienita-foiditica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sienita foidítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Sienitoide foidítico con una proporción entre la plagioclasa y el total de feldespato inferior al 10 por ciento. incluye a las rocas del sector 11 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Foid syenitoid that has a plagioclase to total feldspar ratio of less than 0.1. includes rocks defined modally in qapf field 11.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienitoide-foiditico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/granulita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">granulita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granulite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de alto grado en la que los silicatos de fe-mg son predominantemente anhidros; contiene feldespato, menos de un 90 por ciento de minerales máficos, menos de un 75 por ciento de calcita y/o dolomita, menos de un 75 por ciento de cuarzo, menos de un 50 por ciento de minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro), menos de un 50 por ciento de minerales calcosilicatados y no presenta moscovita.</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock of high metamorphic grade in which fe-mg silicate minerals are dominantly hydroxl-free; feldspar must be present, and muscovite is absent; rock contains less than 90 percent mafic minerals, less than 75 percent calcite and/or dolomite, less than 75 percent quartz, less than 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), and less than 50 percent calc-silicate minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/granulite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-igneo-de-composicion-intermedia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material ígneo de composición intermedia</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intermediate composition igneous material</skos:prefLabel>
    <skos:definition xml:lang="es">Material ígneo con un contenido de sio2 entre el 52 y el 63 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Igneous material with between 52 and 63 percent sio2.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/intermediateCompositionIgneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/intermediate_composition_igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/dioritoide-foiditico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">dioritoide foidítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid dioritoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica en la que m es inferior a 90, la proporción entre la plagioclasa y el total de feldespato es mayor del 50 por ciento y el feldespatoide constituye entre un 10 y un 60 por ciento entre los componentes qapf; la plagioclasa contienen menos del 50 por ciento de anortita. comúnmente presenta un elevado contenido en minerales máficos. incluye las rocas de los sectores 13 y 14 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock in which m is less than 90, the plagioclase to total feldspar ratio is greater than 0.5, feldspathoid minerals form 10-60 percent of the qapf fraction, plagioclase has anorthite content less than 50 percent. these rocks typically contain large amounts of mafic minerals. includes rocks defined modally in qapf fields 13 and 14.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/diorita-foiditica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzodiorita-foiditica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidDioritoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_dioritoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/corneana">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">corneana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hornfels</skos:prefLabel>
    <skos:definition xml:lang="es">Roca granoblástica generada por metamorfismo de contacto, compuesta por un mosaico de granos equidimensionales en una típica matriz granoblástica o decusada; puede contener porfiroblastos o fenocristales relictos. normalmente es de grano fino.</skos:definition>
    <skos:definition xml:lang="en">Granofels formed by contact metamorphism, composed of a mosaic of equidimensional grains in a characteristically granoblastic or decussate matrix; porphyroblasts or relict phenocrysts may be present. typically fine grained.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granofelsita-/-granoblastita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/hornfels"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hornfels"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-igneo-acido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material ígneo ácido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">acidic igneous material</skos:prefLabel>
    <skos:definition xml:lang="es">Material ígneo con un contenido de sio2 superior al 63 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Igneous material with more than 63 percent sio2.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/acidicIgneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/acidic_igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-vitrea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea vítrea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glassy igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con un porcentaje de vidrio superior al 80 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock that consists of greater than 80 percent massive glass.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-rica-en-vidrio"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/glassyIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/glassy_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-rico-en-materia-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento rico en materia orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organic rich sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento cuyo color, composición, textura y densidad aparente indican que contiene más del 50 por ciento en peso (en seco) de materia orgánica.</skos:definition>
    <skos:definition xml:lang="en">Sediment with color, composition, texture and apparent density indicating greater than 50 percent organic content by weight on a moisture-free basis.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-biogenico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/turba"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sapropel"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/organicRichSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/gabroide-foiditico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">gabroide foidítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid gabbroid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica en la que m es inferior a 90, con una proporción entre la plagioclasa y el total de feldespato mayor del 50 por ciento y con feldespatoide en una proporción comprendida entre el 10 y el 60 por ciento entre los componentes qapf; la plagioclasa contiene más del 50 por ciento de anortita. comúnmente presenta un elevado contenido en minerales máficos. incluye a las rocas de los sectores 13 y 14 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock in which m is less than 90, the plagioclase to total feldspar ratio is greater than 0.5, feldspathoids form 10-60 percent of the qapf fraction, and plagioclase has anorthite content greater than 50 percent. these rocks typically contain large amounts of mafic minerals. includes rocks defined modally in qapf fields 13 and 14.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gabro-foiditico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzogabro-foiditico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidGabbroid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_gabbroid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/arcilla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">arcilla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clay</skos:prefLabel>
    <skos:definition xml:lang="es">Fango que contiene más de un 50 por ciento de partículas de granulometría inferior a 0,004 mm.</skos:definition>
    <skos:definition xml:lang="en">Mud that consists of greater than 50 percent particles with grain size less than 0.004 mm</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/pelita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/clay"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clay"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-antropico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material antrópico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anthropogenic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material de origen artificial (humano) conocido; la información es insuficiente para clasificarlo con mayor detalle.</skos:definition>
    <skos:definition xml:lang="en">Material known to have artificial (human-related) origin; insufficient information to classify in more detail.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-compuesto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-antropico-consolidado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-antropico-no-consolidado"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/anthropogenicMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-gabro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-gabro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz gabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca gabroica que contiene entre un 5 y un 20 por ciento de cuarzo entre los componentes qapf. incluye a las rocas del sector 10* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Gabbroic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 10*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-gabroica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzGabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/lodos-de-depuradora">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">lodos de depuradora</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sewage sludge</skos:prefLabel>
    <skos:definition xml:lang="es">Subproductos más o menos líquidos (en el momento de su vertido) procedentes del tratamiento de las aguas residuales.</skos:definition>
    <skos:definition xml:lang="en">More or less liquid (when disposed) by-products of wastewater treatment.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/sewageSludge"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/hormigon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">hormigón</skos:prefLabel>
    <skos:prefLabel xml:lang="en">concrete</skos:prefLabel>
    <skos:definition xml:lang="es">Material de construcción endurecido constituido principalmente de gravas gruesas, cemento y agua.</skos:definition>
    <skos:definition xml:lang="en">Hardening composite construction material composed primarily of coarse gravel, cement and water</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/concrete"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/dacita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">dacita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dacite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica porfídica o de grano fino compuesta generalmente por cuarzo y plagioclasa sódica, con cantidades menores de biotita y/o hornblenda y/o piroxeno; es el equivalente volcánico de la granodiorita y la tonalita. contiene menos de un 90 por ciento de minerales máficos, entre un 20 y un 60 por ciento de cuarzo, entre los componentes qapf, y una proporción entre la plagioclasa y el total de feldespato mayor del 65 por ciento. incluye a las rocas  asignadas modalmente a los sectores 4 y 5 del diagrama qapf o, químicamente, al sector o3 del diagrama tas.</skos:definition>
    <skos:definition xml:lang="en">Fine grained or porphyritic crystalline rock that contains less than 90 percent mafic minerals, between 20 and 60 percent quartz in the qapf fraction, and has a plagioclase to total feldspar ratio greater than 0.65. includes rocks defined modally in qapf fields 4 and 5 or chemically in tas field o3. typcially composed of quartz and sodic plagioclase with minor amounts of biotite and/or hornblende and/or pyroxene; fine-grained equivalent of granodiorite and tonalite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/dacite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dacite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-siliceo-no-clastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario silíceo no clástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">non-clastic siliceous sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario formado al menos en el 50 por ciento por material mineral de silicatos, depositado en la superficie de deposición directamente por procesos químicos o biológicos o en partículas formadas por procesos químicos o biológicos dentro de la cuenca de deposición.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-siliceo-no-clastico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-no-clastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/non-clasticSiliceousSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico-puro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento dolomítico puro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure dolomitic sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado con más del 90 por ciento de sus constituyentes compuestos por uno (o más) carbonatos de origen intracuencal y con una proporción entre dolomita y calcita (incluido el aragonito) mayor que 1.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment in which greater than 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin, and a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pureDolomiticSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_dolomitic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/traquita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">traquita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca traquítica que contiene cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. corresponde al sector 7 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Trachytoid that has a plagioclase to total feldspar ratio between 0.1 and 0.35, between 0 and 5 percent quartz in the qapf fraction, and no feldspathoid minerals. qapf field 7.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/trachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento carbonatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento en el cual como mínimo el 50 por ciento de los componentes primarios y/o recristalizados están constituidos por uno (o más) de los minerales carbonatados calcita, aragonito, magnesita y dolomita, de origen intracuencal.</skos:definition>
    <skos:definition xml:lang="en">Sediment in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-impuro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-puro"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-compuesto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material compuesto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">compound material</skos:prefLabel>
    <skos:definition xml:lang="es">Material terrestre compuesto por una agrupación de partículas de origen terrestre pudiendo incluir otros materiales compuestos.</skos:definition>
    <skos:definition xml:lang="en">An earth material composed of an aggregation of particles of earth material, possibly including other compound materials.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-antropico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/brecha"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-poligenico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-no-consolidado"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/compoundMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/compound_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fonolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fonolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolite</skos:prefLabel>
    <skos:definition xml:lang="es">Fonolitoide cuya proporción de plagioclasa con respecto al total de feldespato es inferior al 10 por ciento. está formada por feldespato alcalino, feldespatoide y minerales máficos.</skos:definition>
    <skos:definition xml:lang="en">Phonolitoid in which the plagioclase to total feldspar ratio is less than 0.1. rock consists of alkali feldspar, feldspathoid minerals, and mafic minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fonolitoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phonolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolilte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/paragneis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">paragneis</skos:prefLabel>
    <skos:prefLabel xml:lang="en">paragneiss</skos:prefLabel>
    <skos:definition xml:lang="es">Gneis cuya mineralogía y textura indican un protolito de rocas sedimentarias. normalmente está formado por abundante cuarzo y mica o calcosilicatos; suele contener  aluminosilicatos o granate. a escala decimétrica, su composición tiende a ser más variada que la del ortogneis.</skos:definition>
    <skos:definition xml:lang="en">A gneiss with mineralogy and texture indicating derivation from a sedimentary rock protolith. typically consists of abundant quartz, mica, or calcsilicate minerals; aluminosilicate minerals or garnet commonly present. composition of rock tends to be more variable on a decimetric scale that in orthogneiss.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gneis"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/paragneiss"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/paragneiss"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/riolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">riolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rhyolite</skos:prefLabel>
    <skos:definition xml:lang="es">Riolitoide con una proporción entre la plagioclasa y el total de feldespato superior al 10 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Rhyolitoid in which the ratio of plagioclase to total feldspar is between 0.1 and 0.65.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-riolitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/rhyolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rhyolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-no-consolidado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material no consolidado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">unconsolidated material</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto formado por agregación de partículas no tan estrechamente adheridas entre sí como para que el agregado pueda ser considerado un sólido por derecho propio.</skos:definition>
    <skos:definition xml:lang="en">Compoundmaterial composed of an aggregation of particles that do not adhere to each other strongly enough that the aggregate can be considered a solid in its own right.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-compuesto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-de-origen-natural-no-consolidado"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/unconsolidatedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/unconsolidated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/arenisca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">arenisca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria clástica con menos de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro) y una relación entre granos de arena y partículas de lutita mayor que 1.</skos:definition>
    <skos:definition xml:lang="en">Clastic sedimentary rock in which less than 30 percent of particles are greater than 2 mm in diameter (gravel) and the sand to mud ratio is at least 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/arenita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/grauvaca"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/sandstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/gneis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">gneis</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gneiss</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica foliada con bandas o lentejones ricos en minerales granulares que se alternan con bandas o lentejones ricos en minerales con hábito prismático o planar. la presencia de foliación milonítica muy bien desarrollada o una esquistosidad continua (más del 50 por ciento de la roca constituido por partículas que conforman una fábrica planar o lineal) descartan la clasificación bajo este término.</skos:definition>
    <skos:definition xml:lang="en">Foliated metamorphic rock with bands or lenticles rich in granular minerals alternating with bands or lenticles rich in minerals with a flaky or elongate prismatic habit. mylonitic foliation or well developed, continuous schistosity (greater than 50 percent of the rock consists of grains participate in a planar or linear fabric) precludes classification with this concept.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/ortogneis"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/paragneis"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/gneiss"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gneiss"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/skarn">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">skarn</skos:prefLabel>
    <skos:prefLabel xml:lang="en">skarn</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metasomática compuesta principalmente por silicatos de calcio, magnesio, hierro o manganeso anhidros o pobres en agua. normalmente se forman en el contacto entre una roca o un magma silicatado y una roca carbonatada.</skos:definition>
    <skos:definition xml:lang="en">Metasomatic rock consisting mainly of ca-, mg-, fe-, or mn-silicate minerals, which are free from or poor in water. typically formed at the contact between a silicate rock or magma and a carbonate rock.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metasomatica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/skarn"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/skarn"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-igneo-basico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material ígneo básico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basic igneous material</skos:prefLabel>
    <skos:definition xml:lang="es">Material ígneo con un contenido de sio2 entre el 45 y el 52 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Igneous material with between 45 and 52 percent sio2.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-basica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/basicIgneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basic_igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/granito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">granito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granite</skos:prefLabel>
    <skos:definition xml:lang="es">Granitoide compuesto por cuarzo, feldespato alcalino y plagioclasa (generalmente sódica) en proporciones variables, generalmente con biotita y/o hornblenda. incluye a las rocas del sector 3 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline rock consisting of quartz, alkali feldspar and plagioclase (typically sodic) in variable amounts, usually with biotite and/or hornblende. includes rocks defined modally in qapf field 3.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granitoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzogranito"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sieno-granito"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/granite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-antropico-no-consolidado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material antrópico no consolidado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anthropogenic unconsolidated material</skos:prefLabel>
    <skos:definition xml:lang="es">Material no consolidado de origen artificial (humano) conocido.</skos:definition>
    <skos:definition xml:lang="en">Unconsolidated material known to have artificial (human-related) origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-antropico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/anthropogenicUnconsolidatedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_unconsolidated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/evaporita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">evaporita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">evaporite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria no clástica compuesta como mínimo por un 50 por ciento de sales no carbonatadas, incluyendo cloruros, sulfatos o boratos. se forma por la precipitación de sales minerales de una solución salina (rocas de sales no carbonatadas).</skos:definition>
    <skos:definition xml:lang="en">Nonclastic sedimentary rock composed of at least 50 percent non-carbonate salts, including chloride, sulfate or borate minerals; formed through precipitation of mineral salts from a saline solution (non-carbonate salt rock).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-quimico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/evaporita-exotica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/yeso-o-anhidrita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/evaporite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/bitumen">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">bitumen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bitumen</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto formado principalmente por betún y agregados minerales, p. e. gravas.</skos:definition>
    <skos:definition xml:lang="en">A composite material composed primarily of bitumen and mineral aggregates, e.g. gravel</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/bitumen"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/diamictita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">diamictita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diamictite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria clástica sin selección o mal seleccionada, de granulometría muy variada, con matriz lutítica. no incluye a los materiales biogénicos que tienen la misma textura. se diferencia de los conglomerados, las areniscas y las lutitas por la polimodalidad y la ausencia de estructuras relacionadas con su transporte y sedimentación por acción del aire o del agua. si no puede ser determinado el origen clástico o diagenético de más del 10 por ciento de la matriz de grano fino, y la fábrica es matriz soportada, puede ser considerada también como una grauvaca.</skos:definition>
    <skos:definition xml:lang="en">Unsorted or poorly sorted, clastic sedimentary rock with a wide range of particle sizes including a muddy matrix. biogenic materials that have such texture are excluded. distinguished from conglomerate, sandstone, mudstone based on polymodality and lack of structures related to transport and deposition of sediment by moving air or water. if more than 10 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wacke.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/diamictite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/diamictite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-afanitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca afanítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fine grained igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea de matriz formada por cristales tan pequeños que no permiten su determinación mineralógica a simple vista; la pasta puede contener más de un 50 por ciento de vidrio. un porcentaje significativo de la roca pueden ser fenocristales. incluye a las rocas que generalmente se denominan volcánicas.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock in which the framework of the rock consists of crystals that are too small to determine mineralogy with the unaided eye; framework may include up to 50 percent glass. a significant percentage of the rock by volume may be phenocrysts. includes rocks that are generally called volcanic rocks.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/andesita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/foiditoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-volcanica-magnesica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fonolitoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefritoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/traquitoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/fineGrainedIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fine_grained_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fonolitoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fonolitoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolitoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica que contiene menos de un 90 por ciento de minerales máficos y entre un 10 y un 60 por ciento de feldespatoide entre los componentes qapf. su proporción de plagioclasa con respecto al total de feldespato es inferior al 50 por ciento. incluye a las rocas de los sectores 11 y 12 del diagrama qapf y a las del sector ph en el diagrama tas.</skos:definition>
    <skos:definition xml:lang="en">Fine grained igneous rock than contains less than 90 percent mafic minerals, between 10 and 60 percent feldspathoid mineral in the qapf fraction and has a plagioclase to total feldspar ratio less than 0.5. includes rocks defined modally in qapf fields 11 and 12, and tas field ph.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fonolita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fonolita-tefritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phonolitoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/afanita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">afanita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">aphanite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de granulometría demasiado fina para clasificarla con mayor detalle.</skos:definition>
    <skos:definition xml:lang="en">Rock that is too fine grained to categorize in more detail.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/aphanite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/aphanite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/latita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">latita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing latite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca latítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 8' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Latitic rock that contains no quartz and between 0 and 10 percent feldspathoid minerals in the qapf fraction. qapf field 8'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-latitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingLatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_latite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/tefra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">tefra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephra</skos:prefLabel>
    <skos:definition xml:lang="es">Material piroclástico no consolidado que contiene un porcentaje superior al 75 por ciento de productos fragmentarios que han sido depositados como resultado directo de los procesos volcánicos y que no han sido retrabajados por procesos epiclásticos. incluye a cenizas, tefra de lapilli, tefra de bombas, tefra de bloques y aglomerados no consolidados.</skos:definition>
    <skos:definition xml:lang="en">Unconsolidated pyroclastic material in which greater than 75 percent of the fragments are deposited as a direct result of volcanic processes and the deposit has not been reworked by epiclastic processes. includes ash, lapilli tephra, bomb tephra, block tephra and unconsolidated agglomerate.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-de-origen-natural-no-consolidado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/ceniza-y-lapilli"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/brecha-de-cenizas"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/brecha-de-cenizas,-tefra-de-bombas-o-bloques"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/tephra"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/pelita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">pelita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mud</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento clástico con menos de un 30 por ciento de clastos de tamaño arena (0,6 - 2,0 mm de diámetro) y una relación entre partículas de lutita y granos de arena mayor que 1. más de la mitad de las partículas son de origen epiclástico.</skos:definition>
    <skos:definition xml:lang="en">Clastic sediment consisting of less than 30 percent sand-size (0.6 mm) particles and with a mud-size to sand-size particle ratio greater than 1. more than half of the particles are of epiclastic origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/arcilla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/limo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/mud"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/horizonte-organico-del-suelo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">horizonte orgánico del suelo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">topsoil</skos:prefLabel>
    <skos:definition xml:lang="es">Horizonte superior del suelo, de color oscuro, cuyo espesor varía en los distintos tipos de suelos.</skos:definition>
    <skos:definition xml:lang="en">The dark-colored upper portion af a soil, varying in depth according to soil type.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/topsoil"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sienita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sienita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sienítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye las rocas del sector 7 del esquema qapf.</skos:definition>
    <skos:definition xml:lang="en">Synitic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the qapf fraction. defined modally in qapf field 7.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/syenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/escombro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">escombro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">building rubble</skos:prefLabel>
    <skos:definition xml:lang="es">Material de tamaños distintos originado por el derribo de edificios o antiguos revestimientos de carreteras.</skos:definition>
    <skos:definition xml:lang="en">Material of various size originating from broken down buildings or former road coatings.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/buildingRubble"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-antropico-consolidado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material antrópico consolidado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anthropogenic consolidated material</skos:prefLabel>
    <skos:definition xml:lang="es">Material consolidado de origen artificial (humano) conocido.</skos:definition>
    <skos:definition xml:lang="en">Consolidated material known to have artificial (human-related) origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-antropico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/anthropogenicConsolidatedMaterial"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/migmatita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">migmatita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">migmatite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica silicatada marcadamente heterogénea tanto a escala decimétrica como métrica. normalmente está formada por unas partes oscuras y otras más claras; las oscuras suelen mostrar características de rocas metamórficas, mientras que las más claras tienen apariencia de rocas ígneas.</skos:definition>
    <skos:definition xml:lang="en">Silicate metamorphic rock that is pervasively heterogeneous on a decimeter to meter scale that typically consists of darker and lighter parts; the darker parts usually exhibit features of metamorphic rocks whereas the lighter parts are of igneous-looking appearance.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/migmatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/migmatite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/espilita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">espilita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spilite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea alterada de grano fino y composición básica a  intermedia en la que el feldespato está compuesto parcial o totalmente por albita, habitualmente acompañada por clorita, calcita, cuarzo, epidota, prehnita y productos de cristalización hidratados de baja temperatura. habitualmente conserva las características volcánicas eruptivas.</skos:definition>
    <skos:definition xml:lang="en">Altered basic to intermediate composition fine-grained igneous rock in which the feldspar is partially or completely composed of of albite, typically accompanied by chlorite, calcite, quartz, epidote, prehnite, and low-tempaerature hydrous crystallization products. preservation of eruptive volcanic features is typical.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metasomatica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/spilite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/spilite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/esquisto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">esquisto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">schist</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica fanerítica y foliada que presenta una esquistosidad muy desarrollada y continua, lo que implica que más del 50 por ciento del volumen de la roca son granos minerales con hábito tabular, lamelar o prismático acicular, orientados en una fábrica continua planar o lineal.</skos:definition>
    <skos:definition xml:lang="en">Foliated phaneritic metamorphic rock with well developed, continuous schistosity, meaning that greater than 50 percent of the rock by volume is mineral grains with a thin tabular, lamellar, or acicular prismatic crystallographic habit that are oriented in a continuous planar or linear fabric.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/micaesquisto"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/schist"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/schist"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-calcarea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria calcárea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous carbonate sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada cuya proporción entre calcita (más aragonito) y dolomita es mayor que 1. incluye a las calizas y las calizas dolomíticas.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes limestone and dolomitic limestone.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-calcareo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/caliza-impura"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/caliza"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/calcareousCarbonateSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/travertino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">travertino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">travertine</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza formada por precipitación biótica o abiótica de manantiales, ya sean de agua caliente o de temperatura ambiente. puede ser blanco y esponjoso, con sombreados de color naranja, marrón o gris, y varía de denso a bandeado o laminado. macrofitas, briofitas, algas, cianobacterias y otros organismos suelen colonizar la superficie del travertino y pueden conservarse, generando las variedades porosas.</skos:definition>
    <skos:definition xml:lang="en">Biotically or abiotically precipitated calcium carbonate, from spring-fed, heated, or ambient-temperature water. may be white and spongy, various shades of orange, tan or gray, and ranges to dense, banded or laminated rock. macrophytes, bryophytes, algae, cyanobacteria and other organisms often colonize the surface of travertine and may be preserved, to produce the porous varieties.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-quimico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/travertine"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/travertine"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-de-composicion-exotica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea de composición exótica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">exotic composition igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca con características mineralógicas, texturales o de afloramiento exóticas. típicamente oscura y con abundantes fenocristales. los criterios de inclusión son: un contenido mayor del 10 por ciento de melilita o leucita, o presencia de kalsilita, o un porcentaje superior al 50 por ciento de minerales carbonatados. incluye las carbonatitas, melilititas, rocas kalsilíticas, kimberlitas, lamproítas, leucititas y los lamprófidos.</skos:definition>
    <skos:definition xml:lang="en">Rock with 'exotic' mineralogical, textural or field setting characteristics; typically dark colored, with abundant phenocrysts. criteria include: presence of greater than 10 percent melilite or leucite, or presence of kalsilite, or greater than 50 percent carbonate minerals. includes carbonatite, melilitic rock, kalsilitic rocks, kimberlite, lamproite, leucitic rock and lamprophyres.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/carbonatita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-alcalina-exotica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/rocas-kalsilititicas-y-melilititas"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/exoticCompositionIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_composition_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada-impura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria carbonatada impura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure carbonate sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria en la que entre el 50 y el 90 por ciento de los elementos primarios y/o recristalizados están compuestos por carbonatos.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock in which between 50 and 90 percent of the primary and/or recrystallized constituents are composed of carbonate minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/impureCarbonateSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_carbonate_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/marga">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">marga</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Lutita que, en la fracción lutítica, contiene un porcentaje superior al 50 por ciento de minerales carbonatados de cualquier origen.</skos:definition>
    <skos:definition xml:lang="en">Mudstone that consists of greater than 50 percent carbonate minerals of any origin in the mud size fraction.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/mudstone"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonateMudstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/serie-de-las-cataclasitas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">serie de las cataclasitas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cataclasite series</skos:prefLabel>
    <skos:definition xml:lang="es">Rocas de falla que han mantenido su cohesión primaria durante la deformación, cuya matriz constituye más del 10 por ciento del volumen de la roca. la matriz está formada por materiales de granulometría fina por reducción debida a fracturación, en oposición al proceso de cristalización plástica que caracteriza a las rocas miloníticas. incluye cataclasitas, protocataclasitas y ultracataclasitas.</skos:definition>
    <skos:definition xml:lang="en">Fault-related rock that maintained primary cohesion during deformation, with matrix comprising greater than 10 percent of rock mass; matrix is fine-grained material formed through grain size reduction by fracture as opposed to crystal plastic process that operate in mylonitic rock. includes cataclasite, protocataclasite and ultracataclasite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-poligenica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/cataclasiteSeries"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/arena">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">arena</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sand</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento clástico con menos de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro) y una relación entre granos de arena y partículas de lutita mayor que 1. más de la mitad de las partículas son de origen epiclástico.</skos:definition>
    <skos:definition xml:lang="en">Clastic sediment in which less than 30 percent of particles are gravel (greater than 2 mm in diameter) and the sand to mud ratio is at least 1. more than half of the particles are of epiclastic origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/sand"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/desecho">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">desecho</skos:prefLabel>
    <skos:prefLabel xml:lang="en">waste</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de subproductos sólidos de cualquier naturaleza, p. e. residuos domésticos o industriales.</skos:definition>
    <skos:definition xml:lang="en">Disposed, non-liquid by-products of any kind, e.g. domestic or industrial waste.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/waste"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/serpentinita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">serpentinita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">serpentinite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca compuesta en más de un 75 por ciento por minerales del grupo de la sepentina, p. e. antigorita, crisotilo o lizardita, pudiendo contener clorita, talco y magnetita como minerales accesorios; se forma por hidratación de silicatos ferromagnesianos como olivino y piroxeno.</skos:definition>
    <skos:definition xml:lang="en">Rock consisting of more than 75 percent serpentine-group minerals, eg. antigorite, chrysotile or lizardite; accessory chlorite, talc and magnetite may be present; derived from hydration of ferromagnesian silicate minerals such as olivine and pyroxene.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/serpentinite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/serpentinite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/yeso-o-anhidrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">yeso o anhidrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gypsum or anhydrite</skos:prefLabel>
    <skos:definition xml:lang="es">Evaporita formada por un mínimo del 50 por ciento de yeso o anhidrita.</skos:definition>
    <skos:definition xml:lang="en">Evaporite composed of at least 50 percent gypsum or anhydrite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/evaporita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/gypsumOrAnhydrite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rock_gypsum_or_anhydrite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento calcáreo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous carbonate sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado con una proporción entre calcita (más aragonito) y dolomita mayor que 1. incluye a los sedimentos calizos.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes lime-sediments.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-calcareo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo-impuro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo-puro"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/calcareousCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/tefritoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">tefritoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephritoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica que contiene menos de un 90 por ciento de minerales máficos, de un 10 a un 60 por ciento de feldespatoide entre los componentes qapf y cuya proporción de plagioclasa con respecto al total de feldespato es superior al 50 por ciento. incluye a las rocas clasificadas modalmente en los sectores 13 y 14 del diagrama qapf, o químicamente en el campo u1 del diagrama tas como basanita o tefrita.</skos:definition>
    <skos:definition xml:lang="en">Fine grained igneous rock than contains less than 90 percent mafic minerals, between 10 and 60 percent feldspathoid mineral in the qapf fraction and has a plagioclase to total feldspar ratio greater than 0.5. includes rocks classified in qapf field 13 and 14 or chemically in tas field u1 as basanite or tephrite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/basanita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/basanita-fonolitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefrita-fonolitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefrita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/tephritoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephritoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/basanita-foiditica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">basanita foidítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basanitic foidite</skos:prefLabel>
    <skos:definition xml:lang="es">Foiditoide que contiene menos del 90 por ciento de feldespatoide entre los componentes qapf, una proporción entre la plagioclasa y el total de feldespato mayor del 50 por ciento  y más de un 10 por ciento de olivino normativo (cipw).</skos:definition>
    <skos:definition xml:lang="en">Foiditoid that contains less than 90 percent feldspathoid minerals in the qapf fraction, and has a plagioclase to total feldspar ratio that is greater than 0.5, with greater than 10 percent normative olivine.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/foiditoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/basaniticFoidite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basanitic_foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fosforita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fosforita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phosphorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria en la que al menos el 50 por ciento de sus componentes, ya sean primarios o recristalizados, son fosfatos. habitualmente corresponde a una roca marina estratificada o retrabajada, compuesta por microcristales de fluorapatito cálcico en forma de láminas, pellets, oolitos y nódulos, y fragmentos de esqueletos, conchas y huesos.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock in which at least 50 percent of the primary or recrystallized constituents are phosphate minerals. most commonly occurs as a bedded primary or reworked secondary marine rock, composed of microcrystalline carbonate fluorapatite in the form of lamina, pellets, oolites and nodules, and skeletal, shell and bone fragments.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-fosfatado"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phosphorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phosphorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/hulla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">hulla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bituminous coal</skos:prefLabel>
    <skos:definition xml:lang="es">Carbón que contiene vitrinita con un valor medio de reflectancia (ro) superior a 0,6 por ciento/ro e inferior a 2,0 por ciento  (determinado según la iso 7404-5) y con un poder calorífico mayor de 24mj/kg (determinado según la iso 1928). se trata de una roca sedimentaria rica en materia orgánica, dura y negra; contiene menos de un 91 por ciento de carbono en seco y sin impurezas, y presenta valores superiores al 13-14 por ciento de volátiles, también en seco y sin contar las cenizas. se forma a partir de la compactación o el endurecimiento de restos de plantas, de manera similar a los depósitos de turba.</skos:definition>
    <skos:definition xml:lang="en">Coal that has vitrinite mean random reflectance greater than 0.6 por ciento and less than 2.0 por ciento (determined in conformance with iso 7404-5), or has a gross calorific value greater than 24 mj/kg (determined in conformance with iso 1928). hard, black, organic rich sedimentary rock; contains less than 91 percent fixed carbon on a dry, mineral-matter-free basis, and greater than 13-14 percent volatiles (dry, ash free). formed from the compaction or induration of variously altered plant remains similar to those of peaty deposits.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/carbon"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/bituminousCoal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/bituminous_coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/mudstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">mudstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure carbonate mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada de textura original reconocible, matriz-soportada, compuesta en más de un 90 por ciento por carbonatos de origen intracuencal y con menos de un 10 por ciento de aloquímicos. mudstone carbonatado de dunham (1962)</skos:definition>
    <skos:definition xml:lang="en">Mudstone that consists of greater than 90 percent carbonate minerals of intrabasinal origin in the mud fraction, and contains less than 10 percent allochems. the original depositional texture is preserved and fabric is matrix supported. carbonate mudstone of dunham (1962)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/marga"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pureCarbonateMudstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_carbonate_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/regolito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">regolito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">residual material</skos:prefLabel>
    <skos:definition xml:lang="es">Material de origen diverso resultante de procesos de meteorización en la superficie de la tierra, cuya génesis corresponde fundamentalmente a la sustitución por lixiviación de sus componentes químicos, aunque algunas aportaciones clásticas, químicas u orgánicas pueden contribuir a su formación en mucha menor medida. su grado de consolidación no está considerado en la definición, aunque normalmente no está consolidado o lo está débilmente.</skos:definition>
    <skos:definition xml:lang="en">Material of composite origin resulting from weathering processes at the earth’s surface, with genesis dominated by removal of chemical constituents by aqueous leaching. minor clastic, chemical, or organic input may also contribute. consolidation state is not inherent in definition, but typically material is unconsolidated or weakly consolidated.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/alterita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/residualMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/residual_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-diorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-diorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz diorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca diorítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 10* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Dioritic rock that contains between 5 to 20 percent quartz in the qapf fraction. qapf field 10*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-dioritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzDiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_diorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzogabro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzogabro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzogabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca monzogabroica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye a las rocas del sector 9 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Monzogabbroic rock that contains between 0 an 5 percent quartz and no feldspathoid mineral in the qapf fraction. includes rocks defined modally in qapf field 9 .</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/monzogabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzogabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/traquita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">traquita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca traquítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 7' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Trachytic rock that contains between 0 and 10 percent feldspathoid in the qapf fraction, and no quartz. qapf field 7'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingTrachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sapropel">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sapropel</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sapropel</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento gelatinoso rico en materia orgánica formado por restos de plantas, habitualmente algas. la relación entre liptinita e inertinita es mayor de 1 (comisión económica para europa, comité de la energía sostenible - naciones unidas (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.).</skos:definition>
    <skos:definition xml:lang="en">Jelly like organic rich sediment composed of plant remains, usually algal. liptinite to inertinite ratio is greater than one (economic commission for europe, committee on sustainable energy- united nations (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-rico-en-materia-organica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/sapropel"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sapropel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/micaesquisto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">micaesquisto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mica schist</skos:prefLabel>
    <skos:definition xml:lang="es">Esquisto formado por más de un 50 por ciento de micas, habitualmente moscovita o biotita. es una tipología específica para distinguir esta variedad común de esquistos.</skos:definition>
    <skos:definition xml:lang="en">A schist that consists of more than 50 percent mica minerals, typically muscovite or biotite. special type included to distinguish this common variety of schist.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/esquisto"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/micaSchist"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mica_schist"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/filonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">filonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phyllonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca milonítica compuesta principalmente por mica de grano fino que confiere brillo a las superficies de foliación; puede tener laminación tipo "flaser", pliegues isoclinales y venas deformadas, que indican un importante cizallamiento. macroscópicamente se parece a la filita, pero la filonita se ha formado por la degradación mecánica de una roca de grano inicialmente más grueso.</skos:definition>
    <skos:definition xml:lang="en">Mylonitic rock composed largely of fine-grained mica that imparts a sheen to foliation surfaces; may have flaser lamination, isoclinal folding, and deformed veins, which indicate significant shearing. macroscopically resembles phyllite, but formed by mechanical degradation of initially coarser rock.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-milonitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phyllonite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phyllonite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/lutita-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">lutita orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organic bearing mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Lutita con un contenido elevado de carbono orgánico, normalmente querógeno. suele presentar una fina laminación y su color es marrón o negro.</skos:definition>
    <skos:definition xml:lang="en">Mudstone that contains a significant amount of organic carbon, typically kerogen. commonly finely laminated, brown or black in color.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita-generica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/organicBearingMudstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_bearing_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-relacionado-con-una-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material relacionado con una falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fault-related material</skos:prefLabel>
    <skos:definition xml:lang="es">Material formado como resultado de una falla frágil, compuesto por una matriz mayor del 10 por ciento; la matriz es material de granulometría fina producido por reducción tectónica del tamaño de grano.</skos:definition>
    <skos:definition xml:lang="en">Material formed as a result of brittle faulting, composed of greater than 10 percent matrix; matrix is fine-grained material caused by tectonic grainsize reduction.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-poligenico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/series-de-las-brechas-harinas-de-falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-milonitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/fault-relatedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fault_related_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fango-siliceo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fango silíceo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silicate mud</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento de tamaño de grano arcilla formado por menos de un 50 por ciento de carbonatos.</skos:definition>
    <skos:definition xml:lang="en">Mud size sediment that consists of less than 50 percent carbonate minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-pelitico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/silicateMud"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/silicate_mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/grainstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">grainstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">grainstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada con matriz original reconocible, grano-soportada, constituida fundamentalmente por aloquímicos y sin matriz micrítica. se diferencia de las areniscas por el carácter intracuencal de sus clastos y por su fábrica grano-soportada, pero la definición de grainstone no contempla el criterio del tamaño de grano.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary rock with recognizable depositional fabric that is grain-supported, and constituent particles are of intrabasinal origin; contains little or no mud matrix. distinction from sandstone is based on interpretation of intrabasinal origin of clasts and grain-supported fabric, but grainstone definition does not include a grain size criteria.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/grainstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/grainstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/foidita-tefritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">foidita tefrítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephritic foidite</skos:prefLabel>
    <skos:definition xml:lang="es">Foiditoide que contiene menos de un 90 por ciento de feldespatoide entre los componentes qapf y cuya proporción de plagioclasa con respecto al total de feldespato es superior al 50 por ciento, con menos de un 10 por ciento de olivino normativo (cipw).</skos:definition>
    <skos:definition xml:lang="en">Foiditoid that contains less than 90 percent feldspathoid minerals in the qapf fraction, and has a plagioclase to total feldspar ratio that is greater than 0.5, with less than 10 percent normative olivine</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/foiditoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/tephriticFoidite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephritic_foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/boundstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">boundstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">boundstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada que ha preservado su textura biogénica. sus componentes originales se unieron e incrustaron durante la sedimentación por acción de plantas y animales y se han conservado de manera sustancial en posición de vida.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary carbonate rock with preserved biogenic texture, whose original components were bound and encrusted together during deposition by the action of plants and animals during deposition, and remained substantially in the position of growth.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/boundstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boundstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca metamórfica foliada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foliated metamorphic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica en la que el 10 por ciento o más de los componentes minerales tienen una fábrica planar o linear. la naturaleza cataclástica o vítrea excluyen la clasificación bajo este concepto.</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock in which 10 percent or more of the contained mineral grains are elements in a planar or linear fabric. cataclastic or glassy character precludes classification with this concept.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gneis"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/filita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/esquisto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/pizarra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foliatedMetamorphicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foliated_metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/gabro-foiditico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">gabro foidítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid gabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Gabroide foidítico con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. incluye las rocas del sector 14 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Foid gabbroid that has a plagioclase to total feldspar ratio greater than 0.9. includes rocks defined modally in qapf field 14.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gabroide-foiditico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidGabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sienita-de-feldespato-alcalino-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sienita de feldespato alcalino con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing alkali feldspar syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sienítica de feldespato alcalino con feldespatoide en proporción inferior al 10 por ciento, entre los componentes qapf. sector 6' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Alkali feldspar synitic rock that contains 0-10 percent feldspathoid mineral and no quartz in the qapf fraction. qapf field 6'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingAlkaliFeldsparSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_alkali_feldspar_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-riolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca riolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rhyolitoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica compuesta por cuarzo y feldespato alcalino, con presencia de plagioclasa y biotita en una  matriz microcristalina, criptocristalina o vítrea. es habitual la textura fluidal. contiene menos del 90 por ciento de minerales máficos y, en relación con sus componentes del diagrama qapf, entre un 20 y un 60 por ciento de cuarzo, así como un contenido de plagioclasa con respecto al total de feldespato inferior al 65 por ciento. engloba a las rocas incluidas modalmente en los sectores 2 y 3 del diagrama qapf, así como las incluidas químicamente en el sector r del diagrama tas.</skos:definition>
    <skos:definition xml:lang="en">Fine grained igneous rock consisting of quartz and alkali feldspar, with minor plagioclase and biotite, in a microcrystalline, cryptocrystalline or glassy groundmass. flow texture is common. includes rocks defined modally in qapf fields 2 and 3 or chemically in tas field r as rhyolite. qapf normative definition is based on modal mineralogy thus: less than 90 percent mafic minerals, between 20 and 60 percent quartz in the qapf fraction, and ratio of plagioclse to total feldspar is less than 0.65.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/riolita-de-feldespato-alcalino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/riolita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/rhyolitoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rhyolitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">bloques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">boulder gravel size sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento que contiene más de un 30 por ciento de partículas de tamaño bloque (diámetro mayor de 256 mm).</skos:definition>
    <skos:definition xml:lang="en">Sediment containing greater than 30 percent boulder-size particles (greater than 256 mm in diameter).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/boulderGravelSizeSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boulder_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/escombera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">escombera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mine dump material</skos:prefLabel>
    <skos:definition xml:lang="es">Desechos procedentes de las excavaciones mineras.</skos:definition>
    <skos:definition xml:lang="en">Spoil, overburden and other material excavated in mining.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/mineDumpMaterial"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sienitoide-foiditico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">Sienitoide foidítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid syenitoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica en la que el índice de color (m) es inferior a 90, la proporción entre la plagioclasa y el total de feldespato es inferior al 50 por ciento y el contenido de feldespatoide está comprendido entre el 10 y el 60 por ciento de los componentes qapf. incluye a las rocas de los sectores 11 y 12 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock with m less than 90, contains between 10 and 60 percent feldspathoid mineral in the qapf fraction, and has a plagioclase to total feldspar ratio less than 0.5. includes qapf fields 11 and 12.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzosienita-foiditica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienita-foiditica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidSyenitoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_syenitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca monzogabroica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzogabbroic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Gabroide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento. incluye a las rocas de los sectores 9, 9' y 9* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Gabbroid with a plagioclase to total feldspar ratio between 0.65 and 0.9. qapf field 9, 9 prime and 9 asterisk</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gabroide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzogabro-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzogabro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzonita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzogabro"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/monzogabbroicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzogabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea fanerítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phaneritic igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea constituida por cristales que pueden distinguirse a simple vista. el tamaño de los granos es del orden de 32 a 100 micras. las rocas ígneas de composición poco habitual (exóticas) quedan excluidas de este concepto.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock in which the framework of the rock consists of individual crystals that can be discerned with the unaided eye. bounding grain size is on the order of 32 to 100 microns. igneous rocks with 'exotic' composition are excluded from this concept.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-anortositica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/aplita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/dioritoide-foiditico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gabroide-foiditico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienitoide-foiditico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/foidolita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gabroide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/hornblendita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/pegmatita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/peridotita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/piroxenita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienitoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phaneriticIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-basica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea básica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basic igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con un contenido de sio2 comprendido entre el 45 y 52 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with between 45 and 52 percent sio2.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo-basico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/basalto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-gabroica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/basicIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/escoria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">escoria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slag</skos:prefLabel>
    <skos:definition xml:lang="es">Subproducto de la fundición y el procesado de metales.</skos:definition>
    <skos:definition xml:lang="en">By-product of smelting ore and processing metals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/slag"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento de tamaño grava</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gravel size sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento que contiene más de un 30 por ciento de partículas de tamaño grava (más de 2,0 mm de diámetro). la composición o la génesis de los clastos no se especifican.</skos:definition>
    <skos:definition xml:lang="en">Sediment containing greater than 30 percent gravel-size particles (greater than 2.0 mm diameter). composition or genesis of clasts not specified.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/bloques"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/grava-gruesa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/grava-fina-media"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/gravelSizeSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/anortosita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">anortosita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anorthosite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca anortosítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. sector 10 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Anorthositic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the qapf fraction. qapf field 10.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-anortositica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/anorthosite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anorthosite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/brecha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">brecha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Material de granulometría gruesa compuesto por fragmentos de roca angulares; los fragmentos suelen tener bordes afilados y esquinas sin desgastar.</skos:definition>
    <skos:definition xml:lang="en">Coarse-grained material composed of angular broken rock fragments; the fragments typically have sharp edges and unworn corners.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-compuesto"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/breccia"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-monzonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz monzonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca monzonítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 8* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Monzonitic rock that contains 5-20 percent quartz iin the qapf fraction. includes rocks defined modally in qapf field 8*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzonitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzMonzonite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_monzonite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-ferruginoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento ferruginoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">iron rich sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento compuesto, como mínimo en un 50 por ciento, por minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro) determinados mediante lupa o análisis petrográfico. generalmente contiene un 15 por ciento de hierro en peso.</skos:definition>
    <skos:definition xml:lang="en">Sediment that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. corresponds to a rock typically containing 15 percent iron by weight.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-ferruginoso"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/ironRichSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-fragmentaria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea fragmentaria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fragmental igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea en la que más del 75 por ciento son fragmentos producidos por procesos ígneos. incluye a las rocas piroclásticas, las autobrechas asociadas con flujos de lava y las brechas intrusivas. se excluyen los depósitos retrabajados por procesos epiclásticos. (ver tufita).</skos:definition>
    <skos:definition xml:lang="en">Igneous rock in which greater than 75 percent of the rock consists of fragments produced as a result of igneous rock-forming process. includes pyroclastic rocks, autobreccia associated with lava flows and intrusive breccias. excludes deposits reworked by epiclastic processes. (see tuffite).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo-fragmentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-piroclastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/fragmentalIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/latita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">latita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">latite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca latítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. sector 8 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Latitic rock that contains between 0 and 5 percent quartz and no feldspathoid in the qapf fraction. qapf field 8.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-latitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/latite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-metasomatica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca metasomática</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metasomatic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cuya fábrica y composición indican cambios mineralógicos y  químicos en un sistema abierto, como respuesta a la interacción con una fase fluida, normalmente rica en agua.</skos:definition>
    <skos:definition xml:lang="en">Rock that has fabric and composition indicating open-system mineralogical and chemical changes in response to interaction with a fluid phase, typically water rich.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-poligenica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/skarn"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/espilita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/metasomaticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-igneo-fragmentario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material ígneo fragmentario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fragmental igneous material</skos:prefLabel>
    <skos:definition xml:lang="es">Material ígneo con un estado de consolidación no especificado formado en más del 75 por ciento por fragmentos resultantes de un proceso ígneo.</skos:definition>
    <skos:definition xml:lang="en">Igneous material of unspecified consolidation state in which greater than 75 percent of the rock consists of fragments produced as a result of igneous rock-forming process.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-fragmentaria"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-piroclastico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/fragmentalIgneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/foidita-fonolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">foidita fonolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolitic foidite</skos:prefLabel>
    <skos:definition xml:lang="es">Foiditoide que contiene menos de un 90 por ciento de feldespatoide, entre los componentes qapf, y cuya proporción de plagioclasa con respecto al total de feldespato es inferior al 50 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Foiditoid that contains less than 90 percent feldspathoid minerals in the qapf fraction, and has a plagioclase to total feldspar ratio that is less than 0.5</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/foiditoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phonoliticFoidite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-generado-por-un-impacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material generado por un impacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impact generated material</skos:prefLabel>
    <skos:definition xml:lang="es">Material que presenta características indicativas de metamorfismo de choque, como una deformación microscópica planar en granos o conos de fractura, que se interpretan como resultado del impacto de un meteorito. incluye brechas y rocas fundidas.</skos:definition>
    <skos:definition xml:lang="en">Material that contains features indicative of shock metamorphism, such as microscopic planar deformation features within grains or shatter cones, interpreted to be the result of extraterrestrial bolide impact. includes breccias and melt rocks.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-poligenico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/impactGeneratedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impact_generated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria clástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clastic sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria en la que al menos el 50 por ciento de las partículas constituyentes provienen de la erosión, la meteorización o el movimiento en masa de materiales preexistentes, que han sido transportados hasta su lugar de depósito por agentes mecánicos, tales como el agua, el viento, el hielo y la gravedad.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-clastico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/conglomerado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/diamictita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/arenisca"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/clasticSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-volcanica-magnesica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca volcánica magnésica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">high magnesium fine grained igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica con una concentración inusualmente elevada de mgo. en rocas con un porcentaje superior al 52 de sílice, el contenido en mgo debe ser superior al 8 por ciento. en rocas con menos del 52 por ciento de sílice, el contenido de mgo debe ser superior al 12 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Fine-grained igneous rock that contains unusually high concentration of mgo. for rocks that contain greater than 52 percent silica, mgo must be greater than 8 percent. for rocks containing less than 52 percent silica, mgo must be greater than 12 percent.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-komatiitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/highMagnesiumFineGrainedIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/high_magnesium_fine_grained_igneous_rocks"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzodiorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzodiorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca monzodiorítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. contiene plagioclasa sódica (an0 a an50), feldespato alcalino, hornblenda y biotita, con ausencia o muy bajo contenido de piroxeno. incluye a las rocas del sector 9 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock consisting of sodic plagioclase (an0 to an50), alkali feldspar, hornblende and biotite, with or without pyroxene, and 0 to 5 percent quartz. includes rocks defined modally in qapf field 9.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzodioritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/monzodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/dolomia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">dolomía</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada pura, con una relación entre dolomita y calcita (incluyendo el aragonito) mayor que 1.</skos:definition>
    <skos:definition xml:lang="en">Pure carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-dolomitica-o-magnesica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/dolomite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/filita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">filita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phyllite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca que presenta foliación muy penetrativa, granulometría media, comprendida entre 0,1 y 0,5 mm, y brillo satinado en las superficies de foliación. a simple vista, los filosilicatos son difícilmente distinguibles de manera individualizada.</skos:definition>
    <skos:definition xml:lang="en">Rock with a well developed, continuous schistosity, an average grain size between 0.1 and 0.5 millimeters, and a silvery sheen on cleavage surfaces. individual phyllosilicate grains are barely visible with the unaided eye.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phyllite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phyllite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/pizarra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">pizarra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca compacta de grano fino, con una granulometría media inferior a 0,032 mm y que presenta una foliación muy bien desarrollada (clivaje pizarroso) y que por tanto puede ser separada en lajas o placas delgadas.</skos:definition>
    <skos:definition xml:lang="en">Compact, fine grained rock with an average grain size less than 0.032 millimeter and a well developed schistosity (slaty cleavage), and hence can be split into slabs or thin plates.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/slate"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/slate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/foiditoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">foiditoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foiditoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica con menos del 90 por ciento de minerales máficos y más del 60 por ciento de feldespatoide entre los componentes qapf. incluye a las rocas del sector 15 del diagrama qapf y a las que su composición química sitúa en el sector f del diagrama tas.</skos:definition>
    <skos:definition xml:lang="en">Fine grained crystalline rock containing less than 90 percent mafic minerals and more than 60 percent feldspathoid minerals in the qapf fraction. includes rocks defined modally in qapf field 15 or chemically in tas field f.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/basanita-foiditica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/foidita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/foidita-fonolitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/foidita-tefritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foiditoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foiditoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/barro-de-radiolarios">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">barro de radiolarios</skos:prefLabel>
    <skos:prefLabel xml:lang="en">siliceous ooze</skos:prefLabel>
    <skos:definition xml:lang="es">Fango constituido, en más de un 50 por ciento, por restos de esqueletos silíceos.</skos:definition>
    <skos:definition xml:lang="en">Ooze that consists of more than 50 percent siliceous skeletal remains</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-siliceo-no-clastico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/siliceousOoze"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/grauvaca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">grauvaca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wacke</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca clástica con más de un 10 por ciento de matriz de tamaño lutita (arcilla, feldespato, cuarzo, fragmentos de roca y productos de alteración) de origen indeterminado, detrítico o diagenético.</skos:definition>
    <skos:definition xml:lang="en">Clastic sandstone with more than 10 percent matrix of indeterminate detrital or diagenetic nature. matrix is mud size silicate minerals (clay, feldspar, quartz, rock fragments, and alteration products).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/arenisca"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/wacke"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/wacke"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/grava-fina-media">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">grava fina-media</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pebble gravel size sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento con más de un 30 por ciento de clastos de tamaño grava (2 - 64 mm de diámetro).</skos:definition>
    <skos:definition xml:lang="en">Sediment containing greater than 30 percent pebble-size particles (2.0 -64 mm in diameter)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pebbleGravelSizeSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/esquisto-azul">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">esquisto azul</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glaucophane lawsonite epidote metamorphic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica con una composición próxima a la del basalto. se define por la presencia de glaucofana con lawsonita o epidota. otros minerales que pueden estar presentes son jadeíta, albita, clorita, granate y moscovita (mica blanca fengítica). generalmente es oscura y de grano fino.</skos:definition>
    <skos:definition xml:lang="en">A metamorphic rock of roughly basaltic composition, defined by the presence of glaucophane with lawsonite or epidote. other minerals that may be present include jadeite, albite, chlorite, garnet, and muscovite (phengitic white mica). typically fine-grained, dark colored. category for rocks commonly referred to as blueschist.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/glaucophaneLawsoniteEpidoteMetamorphicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/glaucophane_lawsonite_epidote_metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/granitoide-rico-en-cuarzo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">granitoide rico en cuarzo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz rich igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica que contiene menos de un 90 por ciento de minerales máficos y más de un 60 por ciento de cuarzo entre los componentes qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock that contains less than 90 percent mafic minerals and contains greater than 60 percent quartz in the qapf fraction.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzRichIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_rich_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rock salt</skos:prefLabel>
    <skos:definition xml:lang="es">Evaporita compuesta, al menos en un 50 por ciento, por halita.</skos:definition>
    <skos:definition xml:lang="en">Evaporite composed of at least 50 percent halite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/evaporita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/rockSalt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rock_salt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario carbonatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario en el que al menos el 50 de sus componentes primarios y/o recristalizados están formados por uno (o más) de los minerales carbonatados calcita, aragonito y dolomita, en partículas originarias de la misma cuenca de deposición.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-calcareo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-dolomitico-o-magnesico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonateSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-gabroica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca gabroica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gabbroic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Gabroide con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. engloba los sectores 10*, 10 y 10' del diagrama qapf. esta clase incluye las categorías definidas en le maitre et al. (2002) basadas en los minerales máficos, pero no subdivididas en función del contenido en cuarzo/feldespatoide.</skos:definition>
    <skos:definition xml:lang="en">Gabbroid that has a plagioclase to total feldspar ratio greater than 0.9 in the qapf fraction. includes qapf fields 10*, 10, and 10'. this category includes the various categories defined in lemaitre et al. (2002) based on the mafic mineralogy, but apparently not subdivided based on the quartz/feldspathoid content.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-basica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gabro-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gabro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-gabro"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/gabbroicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/caliza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">caliza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada pura con una proporción entre calcita (incluyendo el aragonito) y dolomita mayor que 1. incluye a la caliza dolomítica.</skos:definition>
    <skos:definition xml:lang="en">Pure carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes limestone and dolomitic limestone.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-calcarea"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/creta"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/limestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/conglomerado-generico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">conglomerado genérico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">generic conglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta al menos por un 30 por ciento de clastos redondeados o subangulosos de diámetro superior a 2 mm; generalmente, los huecos entre los fragmentos están rellenos de material más fino. si no puede ser determinado el origen clástico o diagenético de más del 15 por ciento de la matriz de grano fino y la fábrica es matriz-soportada, puede ser considerada como una grauvaca. si la roca está mal seleccionada, con granulometría muy variada, también puede ser considerada una diamictita.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock composed of at least 30 percent rounded to subangular fragments larger than 2 mm in diameter; typically contains finer grained material in interstices between larger fragments. if more than 15 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wackestone. if rock has unsorted or poorly sorted texture with a wide range of particle sizes, may also be categorized as diamictite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/genericConglomerate"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/generic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/peridotita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">peridotita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peridotite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultramáfica compuesta en más del 40 por ciento (en volumen) por olivino con piroxeno y/o anfíbol y sin, o muy escaso, feldespato. habitualmente se encuentra alterada a serpentinita. incluye las rocas definidas modalmente como dunita, harzburgita, lherzolita, wehrlita, peridotita piroxénica, peridotita hornbléndica-piroxénica o peridotita hornbléndica en la clasificación de rocas ultramáficas.</skos:definition>
    <skos:definition xml:lang="en">Ultramafic rock consisting of more than 40 percent (by volume) olivine with pyroxene and/or amphibole and little or no feldspar. commonly altered to serpentinite. includes rocks defined modally in the ultramafic rock classification as dunite, harzburgite, lherzolite, wehrlite, olivinite, pyroxene peridotite, pyroxene hornblende peridotite or hornblende peridotite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/peridotite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peridotite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-no-clastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria silícea no clástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">non-clastic siliceous sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta, como mínimo en un 50 por ciento, por material silíceo depositado por procesos biológicos o químicos sobre la superficie de sedimentación, o por partículas formadas por procesos químicos o biológicos en la cuenca de sedimentación.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-siliceo-no-clastico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-biogenica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/non-clasticSiliceousSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/tufita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">tufita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuffite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca constituida en más del 50 por ciento por partículas de origen epiclástico o piroclástico indeterminado y en menos del 75 por ciento por partículas de origen claramente piroclástico.</skos:definition>
    <skos:definition xml:lang="en">Rock consists of more than 50 percent particles of indeterminate pyroclastic or epiclastic origin and less than 75 percent particles of clearly pyroclastic origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/tuffite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tuffite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/turba">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">turba</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peat</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento no consolidado rico en materia orgánica con un mínimo del 50 por ciento de restos de plantas semicarbonificados, normalmente distinguibles a simple vista; de coloración marrón amarillento a marrón muy oscuro, habitualmente con textura fibrosa, puede ser plástico o friable. en su estado natural puede cortarse fácilmente y tiene un elevado grado de humedad, generalmente de más del 90 por ciento. la relación entre el contenido de liptinita e inertinita es inferior a 1 (comisión económica para europa, comité de la energía sostenible - naciones unidas (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.).</skos:definition>
    <skos:definition xml:lang="en">Unconsolidated organic-rich sediment composed of at least 50 percent semi-carbonised plant remains; individual remains commonly seen with unaided eye; yellowish brown to brownish black; generally fibrous texture; can be plastic or friable. in its natural state it can be readily cut and has a very high moisture content, generally greater than 90 percent. liptinite to inertinite ratio is less than one (economic commission for europe, committee on sustainable energy- united nations (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-rico-en-materia-organica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/peat"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peat"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-puro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento carbonatado puro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure carbonate sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado con más del 90 por ciento de sus constituyentes compuestos por uno (o más) carbonatos de origen intracuencal.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment in which greater than 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pureCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/diorita-foiditica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">diorita foidítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid diorite</skos:prefLabel>
    <skos:definition xml:lang="es">Dioritoide foidítico con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. incluye a las rocas del sector 14 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Foid dioritoid in which the plagioclase to total feldspar ratio is greater than 0.9. includes rocks defined modally in qapf field 14.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/dioritoide-foiditico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidDiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_diorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/granito-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">granito de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar granite</skos:prefLabel>
    <skos:definition xml:lang="es">Granitoide con una proporción entre la plagioclasa y el total de feldespato inferior al 10 por ciento. sector 2 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Granitic rock that has a plagioclase to total feldspar ratio less than 0.1. qapf field 2.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granitoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparGranite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/ortogneis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">ortogneis</skos:prefLabel>
    <skos:prefLabel xml:lang="en">orthogneiss</skos:prefLabel>
    <skos:definition xml:lang="es">Gneis cuya mineralogía y textura indican un protolito de rocas ígneas faneríticas. normalmente está formado por abundante feldespato, con cuarzo y un contenido variable de hornblenda, biotita y moscovita; tiene un aspecto relativamente homogéneo.</skos:definition>
    <skos:definition xml:lang="en">A gneiss with mineralogy and texture indicating derivation from a phaneritic igneous rock protolith. typically consists of abundant feldspar, with quartz, and variable hornblende, biotite, and muscovite, with a relatively homogeneous character.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gneis"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/orthogneiss"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/orthogneiss"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/granodiorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">granodiorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Granotoide compuesto principalmente por cuarzo, plagioclasa sódica y cantidades inferiores de feldespato alcalino, con contenidos menores de hornblenda y biotita. incluye a las rocas del sector 4 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline rock consisting essentially of quartz, sodic plagioclase and lesser amounts of alkali feldspar with minor hornblende and biotite. includes rocks defined modally in qapf field 4.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granitoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/granodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-rico-en-materia-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material sedimentario rico en materia orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organic rich sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario en el que al menos el 50 por ciento del material sedimentario primario es carbono orgánico.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material in which 50 percent or more of the primary sedimentary material is organic carbon.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-rica-en-materia-organica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/organicRichSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-monzodioritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca monzodiorítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzodioritic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Dioritoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento. está compuesta por plagioclasa sódica (an0 a an50), feldespato alcalino, hornblenda y biotita, con ausencia o muy bajo contenido de piroxeno y hasta un 10 por ciento de feldespatoide o hasta un 20 por ciento de cuarzo entre los componentes qapf. incluye a las rocas de los sectores 9, 9' y 9* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock consisting of sodic plagioclase (an0 to an50), alkali feldspar, hornblende and biotite, with or without pyroxene, and 0 to 10 percent feldspathoid or 0 to 20 percent quartz in the qapf fraction. plagioclase to total feldspar ratio in the qapf fraction is between 0.65 and 0.9. includes rocks defined modally in qapf field 9, 9' and 9* as monzodiorite, foid-bearing monzodiorite, and quartz monzodiorite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/dioritoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzodiorita-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzodiorita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzodiorita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/monzodioriticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzodioritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/hornblendita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">hornblendita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hornblendite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultramáfica con un porcentaje superior al 40 por ciento de hornblenda más piroxeno, con una relación entre hornblenda y piroxeno mayor que 1. incluye a la hornblendita olivínica, la hornblendita olivino-piroxénica, la horblendita piroxénica y la hornblendita (s.s.).</skos:definition>
    <skos:definition xml:lang="en">Ultramafic rock that consists of greater than 40 percent hornblende plus pyroxene and has a hornblende to pyroxene ratio greater than 1. includes olivine hornblendite, olivine-pyroxene hornblendite, pyroxene hornblendite, and hornblendite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/hornblendite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hornblendite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/wackestone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">wackestone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate wackestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada con textura original reconocible, matriz-soportada, constituida por más de un 10 por ciento de aloquímicos, en el seno de una matriz micrítica. si las partículas no son aloquímicos, su clasificación como wackestone debe ser reconsiderada.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary rock with discernible mud supported depositional texture and containing greater than 10 percent allochems, and constituent particles are of intrabasinal origin. if particles are not intrabasinal, categorization as a mudstone or wackestone should be considered.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonateWackestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_wackestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-hibrido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento híbrido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hybrid sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento que no encaja en ninguna otra categoría de sedimento según la composición o el origen. sedimento formado por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50 por ciento del material.</skos:definition>
    <skos:definition xml:lang="en">Sediment that does not fit any of the other sediment composition/genesis categories. sediment consisting of three or more components which form more than 5 percent but less than 50 precent of the material.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/hybridSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/brecha-de-cenizas,-tefra-de-bombas-o-bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">brecha de cenizas, tefra de bombas o bloques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ash breccia, bomb, or block tephra</skos:prefLabel>
    <skos:definition xml:lang="es">Piroclastos (o tefra) con más del 25 por ciento de los fragmentos mayores de 64 mm de longitud. incluye las brechas de ceniza, las bombas y los bloques piroclásticos según la definición de gillespie y styles (1999)</skos:definition>
    <skos:definition xml:lang="en">Tephra in which more than 25 percent of particles are greater than 64 mm in largest dimension. includes ash breccia, bomb tephra and block tephra of gillespie and styles (1999)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/ashBreccia"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-monzonitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca monzonítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzonitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Sienitoide con una proporción de plagioclasa con respecto al total de feldespato superior al 35 por ciento. incluye a las rocas de los sectores 8, 8' y 8* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Syenitoid with a plagioclase to total feldspar ratio between 0.35 and 0.65. includes rocks in qapf fields 8, 8*, and 8'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sienitoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/monzonita-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzonita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/monzoniticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzonitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/granitoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">granitoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granitoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica compuesta por cuarzo, feldespato alcalino y/o plagioclasa. incluye a las rocas de los sectores 2, 3, 4 y 5 del diagrama qapf que corresponden al granito de feldespato alcalino, granito, granodiorita y tonalita.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock consisting of quartz, alkali feldspar and/or plagioclase. includes rocks defined modally in qapf fields 2, 3, 4 and 5 as alkali feldspar granite, granite, granodiorite or tonalite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granito-de-feldespato-alcalino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granito"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granodiorita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tonalita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/granitoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fango carbonatado 1</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate mud</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado con un contenido en clastos de hasta 2 mm de diámetro, inferior al 25 por ciento, y cuya proporción entre los componentes de tamaño arena y lutita es inferior a 1.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment composed of less than 25 percent clasts that have a maximum diameter more than 2 mm, and the ratio of sand size to mud size clasts is less than one.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-2"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonateMud"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/evaporita-exotica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">evaporita exótica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">exotic evaporite</skos:prefLabel>
    <skos:definition xml:lang="es">Evaporita que no contiene un porcentaje del 50 por ciento de halita, yeso o anhidrita.</skos:definition>
    <skos:definition xml:lang="en">Evaporite that is not 50 percent halite or 50 percent gypsum or anhydrite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/evaporita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/exoticEvaporite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzogabro-foiditico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzogabro foidítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid monzogabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Gabroide foidítico con una proporción entre la plagioclasa y el total de feldespato inferior al 90 por ciento. incluye a las rocas del sector 13 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Foid gabbroid that has a plagioclase to total feldspar ratio between 0.5 and 0.9. includes rocks defined modally in qapf field 13.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/gabroide-foiditico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidMonzogabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_monzogabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/basalto-toleitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">basalto toleítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tholeiitic basalt</skos:prefLabel>
    <skos:definition xml:lang="es">Basalto relativamente pobre en sodio, con fenocristales de piroxeno (augita y ortopiroxeno o pigeonita), plagioclasa rica en calcio y, con frecuencia, olivino que puede tener envueltas de reacción tipo "rims" de pigeonita, por reacción del olivino con el magma residual; se caracteriza por una matriz con dos fases de piroxeno, así como cuarzo, tridimita o cristobalita intersticiales y, a menudo, sílice intersticial de textura vítrea. esta categoría incluye a la mayoría de los basaltos de fondo oceánico y de las islas oceánicas, así como a las inundaciones basálticas continentales ("traps" basálticos), como la de la meseta del río columbia.</skos:definition>
    <skos:definition xml:lang="en">Tholeiitic basalt is defined here to contain 2 pyroxene phases and interstitial quartz or tridymite or cristobalite in the groundmass. pyroxene (augite and orthopyroxene or pigeonite) and calcium-rich plagioclase are common phenocryst minerals. olivine may also be a phenocryst, and when present, may have rims of pigeonite. only in tholeiitic basalt is olivine in reaction relationship with melt. interstitial siliceous residue may be present, and is often glassy. tholeiitic basalt is relatively poor in sodium. this category includes most basalts of the ocean floor, most large oceanic islands, and continental flood basalts such as the columbia river plateau.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/basalto"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/tholeiiticBasalt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tholeiitic_basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/basanita-fonolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">basanita fonolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolitic basanite</skos:prefLabel>
    <skos:definition xml:lang="es">Tefritoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento y que contiene olivino normativo (cipw) en una proporción superior al 10 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Tephritoid that has a plagioclase to total feldspar ratio between 0.5 and 0.9, and contains more than 10 percent normative (cipw) olivine.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/tefritoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/phonoliticBasanite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_basanite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-anortosita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-anortosita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz anorthosite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca anortosítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 10* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Anorthositic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 10*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-anortositica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzAnorthosite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_anorthosite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/material-piroclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">material piroclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material ígneo fragmentario con más de un 75 por ciento de partículas generadas como resultado directo de erupciones volcánicas.</skos:definition>
    <skos:definition xml:lang="en">Fragmental igneous material that consists of more than 75 percent of particles formed by disruption as a direct result of volcanic action.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo-fragmentario"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pyroclasticMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sienitoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sienitoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">syenitoid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica con un índice de color m inferior a 90, compuesta principalmente por feldespato alcalino y plagioclasa; la proporción entre la plagioclasa y el total de feldespato es inferior al 65 por ciento. puede contener hasta un 20 por ciento de cuarzo, entre los componentes qapf, o hasta un 10 por ciento de feldespatoide, junto con piroxeno, anfíbol o biotita. incluye las rocas de los sectores 6, 7, 8, y sus subdivisiones, del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline igneous rock with m less than 90, consisting mainly of alkali feldspar and plagioclase; minor quartz or nepheline may be present, along with pyroxene, amphibole or biotite. ratio of plagioclase to total feldspar is less than 0.65, quartz forms less than 20 percent of qapf fraction, and feldspathoid minerals form less than 10 percent of qapf fraction. includes rocks classified in qapf fields 6, 7 and 8 and their subdivisions.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzonitica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/syenitoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fango">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fango</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ooze</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento biogénico con una relación de arena a lutita inferior a 1 a 9, menos de un 50 por ciento de carbonatos y menos de un 1 por ciento de partículas de tamaño grava (2 mm de diámetro).</skos:definition>
    <skos:definition xml:lang="en">Biogenic sediment consisting of less than 1 percent gravel-size (greater than or equal to 2 mm) particles, with a sand to mud ratio less than 1 to 9, and less than 50 percent carbonate minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-biogenico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/ooze"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/limo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">limo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silt</skos:prefLabel>
    <skos:definition xml:lang="es">Fango que contiene más de un 50 por ciento de partículas de tamaño limo.</skos:definition>
    <skos:definition xml:lang="en">Mud that consists of greater than 50 percent silt-size grains.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/pelita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/silt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/silt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fonolita-tefritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fonolita tefrítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephritic phonolite</skos:prefLabel>
    <skos:definition xml:lang="es">Fonolitoide cuya proporción de plagioclasa con respecto al total de feldespato es superior al 10 por ciento. en sentido amplio corresponde a la tefrifonolita situada en el sector u3 del diagrama tas.</skos:definition>
    <skos:definition xml:lang="en">Phonolitoid that has a plagioclase to total feldspar ratio between 0.1 and 0.5. broadly corresponds to tas tephriphonolite of tas field u3.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/fonolitoide"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/tephriticPhonolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephritic_phonolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/marmol">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">mármol</skos:prefLabel>
    <skos:prefLabel xml:lang="en">marble</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica con más de un 75 por ciento de granos de calcita y/o dolomita recristalizadas; normalmente tiene textura granoblástica sacaroidea.</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock consisting of greater than 75 percent fine- to coarse-grained recrystallized calcite and/or dolomite; usually with a granoblastic, saccharoidal texture.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/marble"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/marble"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sienita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sienita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sienítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 7' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Synitic rock that contains between 0 and 10 percent feldspathoid mineral and no quartz in the qapf fraction. defined modally in qapf field 7'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo-puro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento calcáreo puro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure calcareous carbonate sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado con más del 90 por ciento de sus constituyentes compuestos por uno (o más) carbonatos de origen intracuencal y con una proporción entre calcita (incluido el aragonito) y dolomita mayor que 1.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment in which greater than 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin, and a calcite (plus aragonite) to dolomite ratio greater than 1 to 1.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pureCalcareousCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_calcareous_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzonita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzonita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid bearing monzonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca monzonítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 8' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Monzonitic rock that contains 0-10 percent feldspathoid mineral and no quartz in the qapf fraction. includes rocks defined modally in qapf field 8'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzonitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidBearingMonzonite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzonite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/foidolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">foidolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica que contiene más del 60 por ciento de feldespatoide, entre los componentes qapf. incluye a las rocas del sector 15 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Phaneritic crystalline rock containing more than 60 percent feldspathoid minerals in the qapf fraction. includes rocks defined modally in qapf field 15</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/foidolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/aplita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">aplita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">aplite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cristalina leucocrática caracterizada por su textura alotriomórfica-equigranular de grano fino (aplítica, sacaroidea o xenomórfica), normalmente de composición granítica con cuarzo, feldespato alcalino y plagioclasa sódica.</skos:definition>
    <skos:definition xml:lang="en">Light coloured crystalline rock, characterized by a fine grained allotriomorphic-granular (aplitic, saccharoidal or xenomorphic) texture; typically granitic composition, consisting of quartz, alkali feldspar and sodic plagioclase.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/aplite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/aplite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sienita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sienita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sienítica de feldespato alcalino que contiene cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. sector 6 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Alkali feldspar synitic rock that contains 0-5 percent quartz and no feldspathoid in the qapf fraction. qapf field 6.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-sienita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sienítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 7* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Synitic rock that contains between 5 and 20 percent quartz in the qapf fraction. defined modally in qapf field 7*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sienitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/fertilizante">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">fertilizante</skos:prefLabel>
    <skos:prefLabel xml:lang="en">soil improver</skos:prefLabel>
    <skos:definition xml:lang="es">Material que se añade al suelo para mejorar el crecimiento y la calidad de las plantas.</skos:definition>
    <skos:definition xml:lang="en">Material added to soil to improve plant growth and health</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/soilImprover"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-biogenica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria silícea biogénica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biogenic silica sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta, al menos en un 50 por ciento, por material mineral silíceo, sedimentado como resultado de procesos biológicos sobre la superficie de depósito o en partículas dentro de la cuenca sedimentaria.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock that consists of at least 50 percent silicate mineral material, deposited directly by biological processes at the depositional surface, or in particles formed by biological processes within the basin of deposition.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-no-clastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/biogenicSilicaSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/biogenic_silica_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/packstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">packstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">packstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada de textura original reconocible, grano-soportada, con granos correspondientes a aloquímicos y espacios intersticiales rellenos de matriz micrítica.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary rock with discernible grain supported depositional texture, containing greater than 10 percent grains, and constituent particles are of intrabasinal origin; intergranular spaces are filled by matrix.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/packstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/packstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-anortositica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca anortosítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anorthositic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica leucocrática constituida esencialmente por plagioclasa y habitualmente con un contenido de piroxeno muy bajo. por definición, su índice de color (m) es inferior a 10 y la proporción de la plagioclasa con respecto al total de feldespato es mayor del 90 por ciento. contiene menos del 20 por ciento de cuarzo y del 10 por ciento de feldespatoide, entre los componentes qapf. sectores 10, 10* y 10' del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Leucocratic phaneritic crystalline igneous rock consisting essentially of plagioclase, often with small amounts of pyroxene. by definition, colour index m is less than 10, and plagiclase to total feldspar ratio is greater than 0.9. less than 20 percent quartz and less than 10 percent feldspathoid in the qapf fraction. qapf field 10, 10*, and 10'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/anortosita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/anortosita-con-foides"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/cuarzo-anortosita"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/anorthositicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anorthositic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-traquita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-traquita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca traquítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 7* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Trachytic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 7*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-traquitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzTrachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/piroxenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">piroxenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica ultramáfica formada casi en su totalidad por uno o más piroxenos y, ocasionalmente, biotita, hornblenda y olivino. incluye a las rocas definidas modalmente en las clasificaciones de rocas ultramáficas como piroxenita olivínica, piroxenita hornbléndica-olivínica, piroxenita s.s., ortopiroxenita, clinopiroxenita y websterita.</skos:definition>
    <skos:definition xml:lang="en">Ultramafic phaneritic igneous rock composed almost entirely of one or more pyroxenes and occasionally biotite, hornblende and olivine. includes rocks defined modally in the ultramafic rock classification as olivine pyroxenite, olivine-hornblende pyroxenite, pyroxenite, orthopyroxenite, clinopyroxenite and websterite.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/pyroxenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
</rdf:RDF>
