  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/sedimento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">sedimento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Material no consolidado formado por agregación de partículas transportadas o depositadas por el aire, el agua o el hielo, o acumulado por otros agentes naturales, como la precipitación química, que forma estratos en la superficie terrestre.</skos:definition>
    <skos:definition xml:lang="en">Unconsolidated material consisting of an aggregation of particles transported or deposited by air, water or ice, or that accumulated by other natural agents, such as chemical precipitation, and that forms in layers on the earth's surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-de-origen-natural-no-consolidado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-biogenico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-hibrido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-pelitico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-arena"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/sediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/lutita-rica-en-carbonatos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">lutita rica en carbonatos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate rich mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Lutita que contiene entre el 10 y el 50 por ciento de minerales carbonatados. no tiene un origen específico.</skos:definition>
    <skos:definition xml:lang="en">Mudstone that contains between 10 and 50 percent carbonate minerals in the mud size fraction. carbonate origin is not specified.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita-generica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/carbonateRichMudstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/lutita-generica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">lutita genérica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">generic mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria con menos de un 30 por ciento de componentes mayores de 2 mm de diámetro (grava) y cuya relación entre las partículas de lutita y los granos de arena es mayor que 1. los clastos pueden ser de cualquier composición y origen.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock consisting of less than 30 percent gravel-size (2 mm) particles and with a mud to sand ratio greater than 1. clasts may be of any composition or origin.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita-rica-en-carbonatos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita-organica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/lutita-siliciclastica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/genericMudstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/generic_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/basalto-olivinico-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">basalto olivínico alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali olivine basalt</skos:prefLabel>
    <skos:definition xml:lang="es">Basalto olivínico subsaturado en sílice, caracterizado por la ausencia de ortopiroxeno y cuarzo y por la presencia de olivino, así como de feldespatoide, feldespato alcalino o flogopita en la matriz. los fenocristales de feldespato varían de labradorita a andesina. la augita es rica en titanio en comparación con la augita de los basaltos toleíticos. el basalto olivínico alcalino es relativamente rico en sodio.</skos:definition>
    <skos:definition xml:lang="en">Alkali olivine basalt is silica-undersaturated, characterized by the absence of orthopyroxene, absence of quartz, presence of olivine, and typically contains some feldspathoid mineral, alkali feldspar or phlogopite in the groundmass. feldspar phenocrysts typically are labradorite to andesine in composition. augite is rich in titanium compared to augite in tholeiitic basalt. alkali olivine basalt is relatively rich in sodium.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/basalto"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/alkaliOlivineBasalt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali-olivine_basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzogabro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">cuarzo-monzogabro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz monzogabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca monzogabroica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 9* del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Monzogabbroic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 9*.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/quartzMonzogabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_monzogabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/monzonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">monzonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca monzonítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye a las rocas del sector 8 del diagrama qapf.</skos:definition>
    <skos:definition xml:lang="en">Monzonitic rock that contains 0-5 percent quartz and no feldspathoid mineral in the qapf fraction. includes rocks defined modally in qapf field 8.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/monzonite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzonite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca ígnea ácida</skos:prefLabel>
    <skos:prefLabel xml:lang="en">acidic igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con un contenido de sio2 superior al 63 por ciento.</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with more than 63 percent sio2.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/material-igneo-acido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/dacita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granitoide"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/granitoide-rico-en-cuarzo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-riolitica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/acidicIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/acidic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-dolomitica-o-magnesica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/litologia"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria dolomítica o magnésica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomitic or magnesian sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada con una relación entre carbonato de magnesio y carbonato cálcico (incluyendo el aragonito) superior a 1. incluye la dolomía, la dolomía calcárea y la magnesita.</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. includes dolostone, lime dolostone and magnesite-stone.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/dolomia"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/litologia/dolomia-impura"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/Lithology/dolomiticOrMagnesianSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
