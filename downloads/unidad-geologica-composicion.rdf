  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonaceous chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">Contiene más del 5 por ciento de carbono reducido en compuestos que suelen ser productos diagenéticos de organismos muertos (por ejemplo, carbón, betún y petróleo). El valor del 5 por ciento se elige por coherencia con el uso del término carbonoso propuesto por el comité SLTT</skos:definition>
    <skos:definition xml:lang="en">Containing greater than 5 percent reduced carbon in compounds that are typically the diagenetic products of dead organisms (e.g. coal, bitumen and petroleum). 5 percent value is chosen for consistency with SLTTs usage of term carbonaceous</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-con-hierro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-magnesico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/carbonaceous_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cloritico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">clorítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chloritic</skos:prefLabel>
    <skos:definition xml:lang="es">Presenta una cantidad mayor de minerales del grupo de la clorita que como componente accesorio (5 por ciento en volumen)</skos:definition>
    <skos:definition xml:lang="en">Greater than accessory amount (greater than 5 percent by volume) of chlorite group minerals are present</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/chloritic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/metaluminoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">metaluminoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metaluminous</skos:prefLabel>
    <skos:definition xml:lang="es">Término de composición química utilizado para rocas ígneas, que indica que el contenido de óxido de aluminio es mayor que el óxido de sodio más el óxido de potasio, pero el óxido de aluminio es menor que la suma de óxido de Na, K y Ca</skos:definition>
    <skos:definition xml:lang="en">Chemical composition term used for igneous rocks, denoting that content of aluminum oxide is greater than sodium oxide plus potassium oxide, but aluminum oxide less than sum of Na, K and Ca oxide</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/metaluminous"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/roca-silicatada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">roca silicatada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silicate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">Compuesto por minerales cuya estructura cristalina contiene tetraedros de SiO4, ya sea aislados o unidos a través de uno o más átomos de oxígeno para formar grupos, cadenas, láminas o estructuras tridimensionales con cationes metálicos. La composición varía entre el 20 y el 100 por ciento de SiO2. Típicamente, algunos sustitutos de la sílice son Al. Una encuesta de análisis químicos en la base de datos de Georock (consulta PARA TODOS LOS ENTORNOS GEOLÓGICOS, MATERIAL: ROCA ENTERA (Y VIDRIO VOLCÁNICO), PUB. AÑOS: 2005-1970), 10/10/2005, http: //georoc.mpch-mainz .gwdg.de / georoc / Entry.html) descubrió que el contenido más bajo de sílice (Si02) para las rocas ígneas es de aproximadamente el 20 por ciento. Esto concuerda con que el contenido de sílice más bajo encontrado para un mineral de silicato es aproximadamente un 21 por ciento para una variedad de clorita que se encuentra al escanear los análisis de minerales en Deer, Howie y Zussman (1966)</skos:definition>
    <skos:definition xml:lang="en">Composed of minerals whose crystal structure contains SiO4 tetrahedra, either isolated or joined through one or more oxygen atoms to form groups, chains, sheets or three-dimensional structures with metallic cations. Composition ranges from 20-100 percent SiO2. Typically some Al substitutues for silica. A survey of chemical analyses in the Georock database (query FOR ALL GEOLOGICAL SETTINGS, MATERIAL: WHOLE ROCK (AND VOLCANIC GLASS), PUB. YEARS: 2005-1970), 10/10/2005, http://georoc.mpch-mainz.gwdg.de/georoc/Entry.html) discovered that the lowest silica (Si02) content for igneous rock is about 20 percent. This is consistent with the lowest silica content found for a silicate mineral is about 21 percent for a chlorite variety found by scanning the mineral analyses in Deer, Howie, and Zussman (1966)</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/acida"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/roca-intermedia"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/basica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ultrabasica"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/silicate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonato</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto por más del 50 por ciento de calcosilicatos o carbonatos en el que la proporción de carbonatos es mayor que la de los calcosilicatos.  Corresponde al término metacarbonato de la terminología NADMSC SLTT (2004), que se adopta aquí sin consideraciones genéticas</skos:definition>
    <skos:definition xml:lang="en">Material consists of greater than 50 percent calcsilicate or carbonate minerals and carbonate minerals greater than calcsilicate minerals in mineral mode. Metacarbonate of NADMSC SLTTm (2004) terminology, adopted here for non-genetic use</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-con-barita"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-monomineralico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/carbonate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-con-hierro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonato con hierro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">iron bearing carbonate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El CO3 es el anión predominante y el hierro es superior al 5 por ciento en moles de los cationes (incluye Fe, Mg, Mn, Ba, Sr, Ca ...)</skos:definition>
    <skos:definition xml:lang="en">CO3 is the predominant anion, and iron is greater than 5 mole percent of the cations (includes Fe, Mg, Mn, Ba, Sr, Ca...)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonatico"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonoso"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-ferruginoso"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/iron_bearing_carbonate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-magnesico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonato magnésico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">magnesium rich carbonate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El CO3 es el anión predominante y el Mg es el catión más abundante (porcentaje molar).</skos:definition>
    <skos:definition xml:lang="en">CO3 is the predominant anion, and Mg is the most abundant (mole percent) cation</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonatico"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonoso"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/magnesium_rich_carbonate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonaceo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonáceo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonaceous</skos:prefLabel>
    <skos:definition xml:lang="es">Material que contiene importantes fases minerales de carbono o hidrocarburos, incluidos grafito, carbón, petróleo, gas, lignito, turba</skos:definition>
    <skos:definition xml:lang="en">Material containing significant carbon or hydrocarbon mineral phases, including graphite, coal, oil, gas, lignite, peat</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/asfaltico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/carbonaceous"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-calcosilicatos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">con calcosilicatos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcsilicate bearing</skos:prefLabel>
    <skos:definition xml:lang="es">Incluye minerales de silicato de calcio de cualquier tipo, pero en una proporción inferior al 50 por ciento de la roca</skos:definition>
    <skos:definition xml:lang="en">Calcsilicate minerals of any sort are present, but less than 50 percent of rock</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/calcsilicate_bearing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litarenitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">litarenítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithic rich detrital mode</skos:prefLabel>
    <skos:definition xml:lang="es">Término de composición petrográfica para en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de fragmentos de otras rocas es mayor que el de feldespatos. Debido a que la mineralogía de los fragmentos líticos no está definida, no puede establecerse una composición mineralógica determinada</skos:definition>
    <skos:definition xml:lang="en">Sandstone petrographic composition term indicating that the ratio of lithic fragments to feldspar is greater than 1:1, and less than 75 percent quartz is present in the detrital mode. Because the mineralogy of the lithic fragments is not constrained, the mineralogical composition is largely independent of the detrital mode composition for this class</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/lithic_rich_detrital_mode"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/otra-composicion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">otra composición</skos:prefLabel>
    <skos:prefLabel xml:lang="en">other composition</skos:prefLabel>
    <skos:definition xml:lang="es">De composición  conocida pero que no encaja en ninguna otra categoría</skos:definition>
    <skos:definition xml:lang="en">Composition is known but doesn’t' fit in any other category</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/other_composition"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-impuro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonato impuro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure calcsilicate or carbonate</skos:prefLabel>
    <skos:definition xml:lang="es">Contiene más del 50 por ciento de calcosilicatos o carbonatos y se desconoce o no se especifica la proporción relativa de calcosilicatos y carbonatos</skos:definition>
    <skos:definition xml:lang="en">Material consists of greater than 50 percent calcsilicate or carbonate minerals and relative proportion of calcsilicate and carbonate minerals is unknown or not specified</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/calcosilicato"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/impure_calcsilicate_or_carbonate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
