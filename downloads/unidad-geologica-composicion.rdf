  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-con-barita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonato con barita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">barium bearing carbonate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El CO3 es el anión predominante y más del 5 por ciento son cationes de Ba (porcentaje en moles).</skos:definition>
    <skos:definition xml:lang="en">CO3 is the predominant anion, and greater than 5 mole percent of cations are Ba.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/barium_bearing_carbonate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarzarenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">cuarzarenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartzose detrital mode</skos:prefLabel>
    <skos:definition xml:lang="es">Arenita en la que más del 95% de los granos son de cuarzo. Este criterio petrográfico sigue la definición más restrictiva del campo de composición en el vértice de cuarzo del triángulo QFL de las areniscas (Folk, 1968). Este uso del término cuarzo es más restrictivo que el usado en el vocabulario de términos de composición mineralógica, lo que refleja el significado interpretativo de las areniscas de cuarzo puro en la petrología sedimentaria</skos:definition>
    <skos:definition xml:lang="en">Detrital mineral grains in a granular rock consist of greater than 95 percent quartz. This petrographic criteria follows the most restrictive definition of the composition field at the quartz vertex of the sandstone QFL triangle (Folk, 1968). This use of term quartzose is more restrictive that that used in the mineralogical composition term vocabulary, reflecting the interpretive significance of pure quartz sandstones in sedimentary petrology</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/quartzose_detrital_mode"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ultrabasica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">ultrabásica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">very low silica chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">Contiene entre aproximadamente un 20 y un 44 por ciento de SiO2. Una encuesta de análisis químicos en la base de datos de Georock (consulta PARA TODOS LOS ENTORNOS GEOLÓGICOS, MATERIAL: ROCA ENTERA (Y VIDRIO VOLCÁNICO), PUB. AÑOS: 2005-1970), 10/10/2005, http: //georoc.mpch-mainz .gwdg. Sinónimo: ultrabásico</skos:definition>
    <skos:definition xml:lang="en">Containing between about 20 and 44 percent SiO2. A survey of chemical analyses in the Georock database (query FOR ALL GEOLOGICAL SETTINGS, MATERIAL: WHOLE ROCK (AND VOLCANIC GLASS), PUB. YEARS: 2005-1970), 10/10/2005, http://georoc.mpch-mainz.gwdg. syn ultrabasic</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/roca-silicatada"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/very_low_silica_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/pelitico-cuarzofeldespatico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">pelítico cuarzofeldespático</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz feldspar pelitic</skos:prefLabel>
    <skos:definition xml:lang="es">Material para el cual la suma de cuarzo modal + feldespato + mica + mineral alumínico es mayor o igual al 70%</skos:definition>
    <skos:definition xml:lang="en">Material for which the sum of modal quartz+feldspar+ mica + aluminous mineral is greater than or equal to 70 percent</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/pelitico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarzofeldespatico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/semipelitico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/quartz_feldspar_pelitic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sublitarenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">sublitarenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sub lithic detrital mode</skos:prefLabel>
    <skos:definition xml:lang="es">Término de composición petrográfica de arenitas en la que la proporción de cuarzo está comprendida entre el 75 y el 95% con respecto al total de elementos terrígenos y en la que el contenido de fragmentos de otras rocas es mayor que el de feldespatos. Se corresponde con el campo de sublitarenita de Folk (1968).</skos:definition>
    <skos:definition xml:lang="en">Sandstone petrographic composition term indicating that detrital mode for clastic rock (Q-F-L) includes more than 50 percent lithic fragments, between 75 and 95 percent quartz (thus less than 25 percent feldspar). This corresponds to the sublitharenite field of Folk (1968), the 75 percent quartz boundary is consistent with quartzsose composition as defined in the mineralogic compostion terms vocabulary</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/sub_lithic_detrital_mode"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/basica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">básica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">low silica chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">Contiene del 44% al 52% de SiO2</skos:definition>
    <skos:definition xml:lang="en">Containing SiO2 in the range 44-52 percent. Syn basic</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/roca-silicatada"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/low_silica_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/peraluminoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">peraluminoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peraluminous</skos:prefLabel>
    <skos:definition xml:lang="es">El contenido de óxido de aluminio (Al2O3) es mayor que la suma de los óxidos de Na, K y Ca</skos:definition>
    <skos:definition xml:lang="en">Aluminum oxide (Al2O3) greater than sum of Na, K and Ca oxide</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/peraluminous"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">arcosico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">arkosic detrital mode</skos:prefLabel>
    <skos:definition xml:lang="es">Término de composición petrográfica de arenitas que tienen menos del 75 por ciento de cuarzo y la relación de feldespatos  a componentes líticos es mayor de 3 a 1. Esto corresponde al campo de las arcosas de Folk (1968). Para rocas clásticas con poca o ninguna matriz y cemento, las rocas en esta categoría de composición detrítica también tendrán una composición mineralógica cuarzo-feldespática.</skos:definition>
    <skos:definition xml:lang="en">Sandstone petrographic composition term indicating that detrital mode for clastic rock (Q-F-L) includes less than 75 percent quartz and the feldspar to lithic ratio is greater than 3 to 1. This corresponds to the arkose field of Folk (1968). For clastic rocks with little or no matrix and cement, rocks in this detrital mode composition category will also have quartz-feldspathic mineralogical composition.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosa-litica"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/arkosic_detrital_mode"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/dolomitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">dolomítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomitic</skos:prefLabel>
    <skos:definition xml:lang="es">Contiene dolomita  pero los minerales de carbonato forman menos del 50 por ciento de la roca</skos:definition>
    <skos:definition xml:lang="en">Dolomite is present, carbonate minerals form less than 50 percent of rock</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-carbonatos"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/dolomitic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-ferruginoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonato ferruginoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">iron rich carbonate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El CO3 es el anión predominante y el hierro es el catión más abundante (porcentaje molar)</skos:definition>
    <skos:definition xml:lang="en">CO3 is the predominant anion, and iron is the most abundant (mole percent) cation</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-con-hierro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/iron_rich_carbonate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosa-litica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">arcosa lítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">feldspathic lithic detrital mode</skos:prefLabel>
    <skos:definition xml:lang="es">Término de composición petrográfica para arenitas en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que la relación entre feldespatos y fragmentos de otras rocas no supera 3:1. Esto corresponde al campo de litarenita feldespática de Folk (1968). Es probable que las rocas de esta clase sean cuarzo-feldespáticas en términos de composición mineralógica en este vocabulario, pero debido a que la composición mineralógica de la fracción lítica no está restringida, esta correlación no es necesaria</skos:definition>
    <skos:definition xml:lang="en">Sandstone petrographic composition term indicating that detrital mode for clastic rock (Q-F-L) includes less than 75 percent quartz and the feldspar to lithic ratio is between 1 to 1 and 1 to 3. This corresponds to the feldspathic litharenite field of Folk (1968). Rocks in this class are likely to be quartzo-feldspathic in terms of mineralogical composition terms in this vocablary, but because the mineralogical composition of the lithic fraction is not constrainged, this correlation is not necessary</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/feldspathic_lithic_detrital_mode"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfuroso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">sulfuroso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sulfide chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El azufre es el anión más abundante, los cationes son metales o semimetales</skos:definition>
    <skos:definition xml:lang="en">Sulfur is the most abundant anion, cations are metals or semimetals</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfosales"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/sulfide_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-nitratos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">con nitratos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nitrate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El nitrato (NO3) es el anión más abundante (porcentaje en moles)</skos:definition>
    <skos:definition xml:lang="en">Nitrate (NO3) is most abundant (mole percent) anion</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/haluros"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/nitrate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/silicico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">silícico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silicic</skos:prefLabel>
    <skos:definition xml:lang="es">Hay una cantidad mayor que la accesoria (más del 5 por ciento en volumen) de sílice, amorfa, como cuarzo o cualquiera de los polimorfos de sílice</skos:definition>
    <skos:definition xml:lang="en">Greater than accessory amount (greater than 5 percent by volume) of silica, amorphous, as quartz, or any of the silica polymorphs are present</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/silicic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ultramafico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">ultramáfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultramafic</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto por más del 90 por ciento de silicatos ferromagnesianos</skos:definition>
    <skos:definition xml:lang="en">Material consists of greater than 90 percent ferromagnesian silicate minerals</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ferromagnesiano"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/ultramafic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/fluoruros">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">fluoruros</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fluoride chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El flúor es el anión más abundante (porcentaje en moles)</skos:definition>
    <skos:definition xml:lang="en">Fluorine is the most abundant (mole percent) anion</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/fluoride_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-monomineralico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonato monominerálico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monomineralic carbonate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca compuesta por mas de un 75%  de minerales de carbonato</skos:definition>
    <skos:definition xml:lang="en">Rock in which carbonate minerals form greater than 75 percent of rock</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/calcareo-monomineralico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/dolomita"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/monomineralic_carbonate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/dolomita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">dolomita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomite monomineralic carbonate</skos:prefLabel>
    <skos:definition xml:lang="es">Los minerales carbonatados forman más del 75 por ciento de la roca y la dolomita forma más del 75 por ciento de los minerales carbonatados</skos:definition>
    <skos:definition xml:lang="en">Carbonate minerals form greater than 75 percent of rock, and dolomite forms greater than 75 percent of carbonate minerals</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-monomineralico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/dolomite_monomineralic_carbonate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-oxidos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">con óxidos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metallic oxide bearing</skos:prefLabel>
    <skos:definition xml:lang="es">(Hay una cantidad mayor)Contiene cantidades de óxidos metálicos como magnetita (Fe3O4) o pirolusita (MnO2) que como componentes accesorios (5% en volumen)</skos:definition>
    <skos:definition xml:lang="en">Greater than accessory amounts (greater than 5 percent by volume) of base metal oxide minerals such as magnetite (Fe3O4) or pyrolusite (MnO2) are present</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/metallic_oxide_bearing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfosales">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">sulfosales</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sulfosalt chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">Sulfuro en el que está presente un semimetal (As, Sb, Bi) como catión</skos:definition>
    <skos:definition xml:lang="en">Sulfide in which a semimetal (As, Sb, Bi) is present in a cation role</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfuroso"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/sulfosalt_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/micaceo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">micáceo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micaceous</skos:prefLabel>
    <skos:definition xml:lang="es">Hay una cantidad mayor de  minerales del grupo de la mica que como componentes accesorios ( 5 por ciento en volumen)</skos:definition>
    <skos:definition xml:lang="en">Greater than accessory amount (greater than 5 percent by volume) of mica group mineral are present</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/micaceous"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/calcareo-monomineralico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">calcáreo monominerálico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous monomeralic carbonate</skos:prefLabel>
    <skos:definition xml:lang="es">Los minerales carbonatados forman más del 75 por ciento de la roca y el carbonato de calcio representa más del 75 por ciento de los minerales carbonatados</skos:definition>
    <skos:definition xml:lang="en">Carbonate minerals form greater than 75 percent of rock, and calcium carbonate minerals forms greater than 75 percent of carbonate minerals</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-monomineralico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/calcareous_monomeralic_carbonate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/calcareo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">calcáreo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous</skos:prefLabel>
    <skos:definition xml:lang="es">Presencia de carbonato de calcio, los minerales carbonatados constituyen menos del 50 por ciento de la roca y el material contiene suficiente CaCO3 para reaccionar formando burbujas cuando se aplica ácido clorhídrico</skos:definition>
    <skos:definition xml:lang="en">Calcium carbonate minerals are present, carbonate minerals form less than 50 percent of rock, material contains sufficient CaCO3 to react forming bubbles when hydrochloric acid is applied</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-carbonatos"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/calcareous"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-rico-en-calcio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonato rico en calcio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcium rich carbonate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El CO3 es el anión predominante y el Ca es el catión más abundante (porcentaje en moles)</skos:definition>
    <skos:definition xml:lang="en">CO3 is the predominante anion, and the Ca is the most abundant (mole percent) cation</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonatico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/calcium_rich_carbonate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/haluros">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">haluros</skos:prefLabel>
    <skos:prefLabel xml:lang="en">halide chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">Uno o más de los elementos del grupo de los haluros (F, Cl, Br, I) son el anión más abundante (porcentaje en moles)</skos:definition>
    <skos:definition xml:lang="en">One or more of halide group elements (F, Cl, Br, I) are most abundant (mole percent) anion</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-nitratos"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/halide_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">arcosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">feldspathic detrital mode</skos:prefLabel>
    <skos:definition xml:lang="es">Término de composición petrográfica para arenitas en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de feldespatos es mayor que el de fragmentos de otras rocas. Incluye clases de composición petrográfica de arenisca arcosica y arcosa lítica. El uso del modificador feldespático es consistente con las subdivisiones petrográficas de Dott (1964) y Williams, Turner y Gilbert (1982</skos:definition>
    <skos:definition xml:lang="en">General sandstone petrography term for a sandstone in which the ratio of feldspar to lithic fragments is greater than 1:1 and less than 75 percent quartz is present in the detrital mode. Subsumes lithic arkosic and arkosic sandstone petrographic composition classes. Usage of modifier feldspathic is consistent with petrographic subdivisions of Dott (1964) and Williams, Turner and Gilbert (1982)</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litarcosa"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/feldspathic_detrital_mode"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/subaluminoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">subaluminoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subaluminous</skos:prefLabel>
    <skos:definition xml:lang="es">Con una proporción de óxido de aluminio inferior al 10 por ciento de la suma de  los óxidos de Na y K</skos:definition>
    <skos:definition xml:lang="en">Aluminum oxide within 10 percent of sum of Na and K oxide</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/subaluminous"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/mafico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">máfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mafic</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto por silicatos ferromagnesianos con proporciones comprendidas entre el 40% y 90%</skos:definition>
    <skos:definition xml:lang="en">Material consists of greater than or equal to 40 percent and less than 90 percent ferromagnesian silicate minerals</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ferromagnesiano"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/mafic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/feldespatico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">feldespático</skos:prefLabel>
    <skos:prefLabel xml:lang="en">feldspathic</skos:prefLabel>
    <skos:definition xml:lang="es">El material sedimentario tiene un impotante contenido de feldespatos</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material contains significant feldspar mineral content</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/feldspathic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/monomictico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">monomíctico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monomictic</skos:prefLabel>
    <skos:definition xml:lang="es">Los granos o clastos están compuestos por un solo tipo de roca o mineral (Jackson, 1997)</skos:definition>
    <skos:definition xml:lang="en">Grains or clasts are composed of a single rock or mineral type (Jackson, 1997)</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/monomictic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-carbonatos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">con carbonatos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate bearing</skos:prefLabel>
    <skos:definition xml:lang="es">Presenta minerales de carbonato de cualquier tipo, pero en una proporción inferior al  50 por ciento de la roca</skos:definition>
    <skos:definition xml:lang="en">Carbonate minerals of any sort are present, but less than 50 percent of rock</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/calcareo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/dolomitico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/carbonate_bearing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litarenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">litarenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithic detrital mode</skos:prefLabel>
    <skos:definition xml:lang="es">Término de composición petrográfica para arenitas en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de fragmentos de otras rocas respecto al de feldespatos es mayor de 3 a 1. Esto corresponde al campo de litarenita de Folk (1968). Debido a que la mineralogía de los fragmentos líticos no está definida, no puede establecerse una composición mineralógica determinada</skos:definition>
    <skos:definition xml:lang="en">Sandstone petrographic composition term indicating that detrital mode for clastic rock (Q-F-L) includes less than 75 percent quartz and the lithic to feldspar ratio is greater than 3 to 1. This corresponds to the litharenite field of Folk (1968). Because the mineralogy of the lithic fragments is not constrained, the mineralogical composition is largely independent of the detrital mode composition for this class</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/lithic_detrital_mode"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/pelitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">pelítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelitic</skos:prefLabel>
    <skos:definition xml:lang="es">Material para el cual la suma de cuarzo modal + feldespato + mica + mineral aluminoso es mayor o igual al 70 por ciento, y el contenido de mineral aluminoso + mica es mayor o igual al 40 por ciento</skos:definition>
    <skos:definition xml:lang="en">Material for which the sum of modal quartz+feldspar+ mica + aluminous mineral is greater than or equal to 70 percent, and aluminous mineral + mica content is greater than or equal to 40 percent</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/pelitico-cuarzofeldespatico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/pelitic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litarcosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">litarcosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithic arkosic detrital mode</skos:prefLabel>
    <skos:definition xml:lang="es">Término de composición petrográfica para arenitas en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de fragmentos de otras rocas respecto al de feldespatos está comprendido entre 1: 1 y 1: 3. Esto corresponde al campo arcoso lítico de Folk (1968). Debido a la abundancia de fragmentos líticos para los cuales no se especifica la composición mineralógica, y la presencia de matriz y cemento no discernibles no incluidos como componentes detríticos, la correspondencia con los términos de composición mineralógica es muy aproximada</skos:definition>
    <skos:definition xml:lang="en">Sandstone petrographic composition term indicating that detrital mode for clastic rock (Q-F-L) includes less than 75 percent quartz and the ratio of lithic fragments to feldspar is between 1:1 and 1:3. This corresponds to the lithic arkose field of Folk (1968), the 75 percent quartz boundary is chosen to be consistent with quartzsose composition as defined in the mineralogic compostion terms vocabulary. Because of the abundance of lithic fragments for which the mineralogic composition is not specified, and the presence of undiscernible matrix and cement that are not incuded in the detrital mode, corresondence with the mineralogical composition terms is very approximate</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcosa"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/lithic_arkosic_detrital_mode"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/asfaltico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">asfáltico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">asphaltic</skos:prefLabel>
    <skos:definition xml:lang="es">El material contiene una cantidad significativa de asfalto, que es un "líquido viscoso de color marrón oscuro a negro o un betún sólido de bajo punto de fusión que consiste casi en su totalidad en carbono e hidrógeno ... [y] formado en rocas que contienen petróleo por la evaporación de volátiles. .. "(Jackson, 1997, pág. 39).</skos:definition>
    <skos:definition xml:lang="en">Material contains a significant amount of asphalt, which is a 'dark brown to black viscous liquid or low-melting solid bitumen that consists almost entirely of carbon and hydrogen...[and] formed in oil-bearing rocks by the evaporation of volatiles...' (Jackson, 1997, p. 39).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonaceo"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/asphaltic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/subarcosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">subarcosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sub feldspathic detrital mode</skos:prefLabel>
    <skos:definition xml:lang="es">Término de composición petrográfica de arenitas en la que la proporción de cuarzo está comprendida entre el 75 y el 95% con respecto al total de elementos terrígenos y en la que el contenido de feldespatos es mayor que el de fragmentos de otras rocas. Se corresponde con el campo de subarcosa de Folk (1968).</skos:definition>
    <skos:definition xml:lang="en">Sandstone petrographic composition term indicating that detrital mode for clastic rock (Q-F-L) includes less than 50 percent lithic fragments, between 75 and 95 percent quartz (thus less than 25 percent feldspar). This corresponds to the subarkose field of Folk (1968), the 75 percent quartz boundary is consistent with the quartzsose composition as defined in the mineralogic compostion terms vocabulary, but if more than a few percent 'matrix' or cement is present, this is not necessarily equivalent to the mineralogical composition term.</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/sub_feldspathic_detrital_mode"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/calcosilicato">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">calcosilicato</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcsilicate</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto por calcosilicatos o carbonatos en una proporción mayor o igual al 50 por ciento, y en la que  los minerales de carbonato son minoritarios o tienen la misma proporcion que los calcosilicatos</skos:definition>
    <skos:definition xml:lang="en">Material consists of greater than or equal to 50 percent calcsilicate or carbonate minerals and carbonate minerals less than or equal to calcsilicate minerals in mineral mode</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-impuro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/calcsilicate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonatico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">carbonático</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El anión carbonato (CO3) es el anión predominante (por porcentaje molar) en el análisis químico. Las subcategorías pueden definirse por el catión dominante. El material de esta clase química se superpone con la clase de carbonato monomineral y probablemente se superpone con la clase de carbonato en la clasificación de composición mineralógica</skos:definition>
    <skos:definition xml:lang="en">The carbonate (CO3) anion is the predominant anion (by mole percent) in chemical analysis. Sub-categories may be defined by dominant cation. Material in this chemical class overlaps with the monomineralic carbonate class, and probably overlaps with the Carbonate class in the mineralogical composition classification</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-rico-en-calcio"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-con-hierro"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/carbonato-magnesico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/carbonate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/clorado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">clorado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chloride chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El cloruro es el anión más abundante (porcentaje en moles)</skos:definition>
    <skos:definition xml:lang="en">Chloride is the most abundant (mole percent) anion</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/chloride_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/fosfato">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">fosfato</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phosphate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El fosfato (PO4) es el anión más abundante (en porcentaje molar)</skos:definition>
    <skos:definition xml:lang="en">Phosphate (PO4) is the most abundant (mole percent) anion</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/phosphate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/bioclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">bioclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bioclastic</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario carbonatado ccon una cantidad significativa de material esquelético fracturado</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary material contains significant broken skeletal material</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/bioclastic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/roca-intermedia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">roca intermedia</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intermediate silica chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea cuyo contenido en SIO2 está comprendido entre el 52 y el 65%</skos:definition>
    <skos:definition xml:lang="en">Containing SiO2 in the range 52-65 percent, sometimes described as \intermediate\ rocks</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/roca-silicatada"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/intermediate_silica_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/epiclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">epiclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcanic lithic</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario  que contiene importantes fragmentos de roca volcánica rotos o fragmentos vítreos, independientemente de su origen piroclástico o epiclástico</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material contains significant broken volcanic rock fragments or vitric fragments, irrespective of their pyroclastic or epiclastic origin</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/volcanic_lithic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ferromagnesiano">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">ferromagnesiano</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ferromagnesian</skos:prefLabel>
    <skos:definition xml:lang="es">Material que tiene más del 40 por ciento de silicatos ferromagnesianos oscuros. Término estándar definido por Bates y Jackson (1987) como "que contiene hierro y magnesio". Incluye máficos y ultramáficos</skos:definition>
    <skos:definition xml:lang="en">Material consists of greater than 40 percent dark ferromagnesian silicate minerals. Standard term defined by Bates and Jackson (1987) to mean 'containing iron and magnesium'. Subsumes mafic and ultramafic</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/mafico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ultramafico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/ferromagnesian"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/ferruginoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">ferruginoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ferruginous</skos:prefLabel>
    <skos:definition xml:lang="es">Presenta una cantidad mayor que como componente accesorio (más del 5 por ciento en volumen) de minerales de hierro no silicatados (hematita, magnetita, siderita ...). Las rocas que contienen abundantes silicatos ricos en hierro corresponderían a los términos 'ferromagnesianos'</skos:definition>
    <skos:definition xml:lang="en">Greater than accessory amount (greater than 5 percent by volume) of non-silicate iron minerals (hematite, magnetite, siderite...) are present. Rocks containing abundant iron-rich silicate minerals would use the 'Ferromagnesian' terms</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/ferruginous"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/fosfatico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">fosfático</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phosphatic</skos:prefLabel>
    <skos:definition xml:lang="es">Presenta una cantidad mayor que la accesoria (más del 5 por ciento en volumen) de minerales de fosfato</skos:definition>
    <skos:definition xml:lang="en">Greater than accessory amount (greater than 5 percent by volume) of phosphate minerals are present</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/phosphatic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarzofeldespatico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">cuarzofeldespático</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartzo feldspathic</skos:prefLabel>
    <skos:definition xml:lang="es">Material para el cual la suma de cuarzo modal + feldespato + mica + mineral alumínico es mayor o igual del 70%, y cuarzo + feldespato (sensu Robertson, 1999) mayor del 60%</skos:definition>
    <skos:definition xml:lang="en">Material for which the sum of modal quartz+feldspar+ mica + aluminous mineral is greater than or equal to 70 percent, and quartz + feldspar (sensu Robertson, 1999) greater than 60 percent</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/pelitico-cuarzofeldespatico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarcitico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/quartzo_feldspathic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarcitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">cuarcítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartzose</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto por un porcentaje igual o superior al 75% de cuarzo</skos:definition>
    <skos:definition xml:lang="en">Material consists of greater than or equal to 75 percent quartz</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/cuarzofeldespatico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/quartzose"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-sulfuros">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">con sulfuros</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sulfide bearing</skos:prefLabel>
    <skos:definition xml:lang="es">Contiene una proporción de sulfuros superior a la de componente accesorio (más del 5 por ciento en volumen)</skos:definition>
    <skos:definition xml:lang="en">Greater than accessory amount (greater than 5 percent by volume) of sulfide mineral are present</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfuro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/sulfide_bearing"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/semipelitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">semipelítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">semi pelitic</skos:prefLabel>
    <skos:definition xml:lang="es">Material para el cual la suma de cuarzo modal + feldespato + mica + mineral aluminoso es mayor o igual al 70 por ciento, y cuarzo + feldespato menor del 60 por ciento</skos:definition>
    <skos:definition xml:lang="en">Material for which the sum of modal quartz+feldspar+ mica + aluminous mineral is greater than or equal to 70 percent, and quartz+ feldspar less than 60 percent</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/pelitico-cuarzofeldespatico"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/semi_pelitic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/litico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">lítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithic</skos:prefLabel>
    <skos:definition xml:lang="es">El material sedimentario tiene un contenido significativo de fragmentos de roca derivados de la erosión de materiales rocosos preexistentes</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material contains significant detrital rock fragments derived by erosion from older, pre-existing rock materials</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/lithic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/intracastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">intracástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intraclastic</skos:prefLabel>
    <skos:definition xml:lang="es">Carbonatos sedimentarios con un contenido importante de intraclastos</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary material contains signficant intraclast content</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/intraclastic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfuro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">sulfuro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sulfide</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto predominantemente de sulfuros</skos:definition>
    <skos:definition xml:lang="en">Material predominantly composed of sulfide minerals</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/con-sulfuros"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/sulfide"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sin-especificar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">sin especificar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">composition not specified</skos:prefLabel>
    <skos:definition xml:lang="es">Composición no especificada. Usar en descripciones normativas donde se permite cualquier propiedad de composición</skos:definition>
    <skos:definition xml:lang="en">Composition not specified. Use in normative descriptions where any composition property is allowed</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/composition_not_specified"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/acida">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">ácida</skos:prefLabel>
    <skos:prefLabel xml:lang="en">high silica chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">Contiene mas de de un 65% de SiO2 en peso</skos:definition>
    <skos:definition xml:lang="en">Containing 65 percent or more SiO2 by weight. Syn acid</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/roca-silicatada"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/high_silica_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/polimictico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">polimíctico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polymictic</skos:prefLabel>
    <skos:definition xml:lang="es">Los granos o clastos son de muchos tipos de minerales o rocas</skos:definition>
    <skos:definition xml:lang="en">Grains or clasts are composed of many mineral or rock types</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/polymictic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/peralcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">peralcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peralkaline</skos:prefLabel>
    <skos:definition xml:lang="es">El contenido de óxido de aluminio (Al2O3) es menor que la suma de los óxidos de K y Na</skos:definition>
    <skos:definition xml:lang="en">Aluminum oxide (Al2O3) is less than sum of K and Na oxide</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/peralkaline"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfato">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">sulfato</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sulfate</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto predominantemente de sulfatos</skos:definition>
    <skos:definition xml:lang="en">Material predominantly composed of sulfate minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/sulfate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/petrolifero">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">petrolífero</skos:prefLabel>
    <skos:prefLabel xml:lang="en">petroliferous</skos:prefLabel>
    <skos:definition xml:lang="es">Presenta petróleo o gas natural, generalmente en cantidades mínimas, comúnmente detectado por el olor</skos:definition>
    <skos:definition xml:lang="en">Crude oil or natural gas is present, generally in trace amounts, commonly detected by smell</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/petroliferous"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/oxido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">óxido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oxide</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto predominantemente por óxidos metálicos</skos:definition>
    <skos:definition xml:lang="en">Material predominantly composed of oxide minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/oxide"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
