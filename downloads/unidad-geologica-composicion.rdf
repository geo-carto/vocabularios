  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/arcilloso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">arcilloso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">argillic</skos:prefLabel>
    <skos:definition xml:lang="es">Hay una cantidad de arcilla mayor que como componente accesorio (más del 5 por ciento en volumen)</skos:definition>
    <skos:definition xml:lang="en">Greater than accessory amount (greater than 5 percent by volume) of clay is present</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/argillic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/sulfatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">sulfatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sulfate chemistry</skos:prefLabel>
    <skos:definition xml:lang="es">El sulfato es el anión más abundante</skos:definition>
    <skos:definition xml:lang="en">Sulfate is the most abundant anion</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/sulfate_chemistry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion/monomineralico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion"/>
    <skos:prefLabel xml:lang="es">monominerálico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mono mineralic</skos:prefLabel>
    <skos:definition xml:lang="es">Más del 75 por ciento del material consiste en una sola especie mineral</skos:definition>
    <skos:definition xml:lang="en">Greater than 75 percent of the material consists of a single mineral species</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/compositioncategory/mono_mineralic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-composicion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Tipo de categoría de composición</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Composition category</skos:prefLabel>
    <dcterms:title xml:lang="es">Tipo de categoría de composición</dcterms:title>
    <dcterms:title xml:lang="en">Composition category</dcterms:title>
    <skos:definition xml:lang="es">Términos basados en una clasificación composicional que resume el carácter general de la unidad. No es aplicable al nivel de material de roca o de muestra. Ejemplos: alcalina, subaluminosa, peraluminosa, tipo I, carbonatada, fosfatada.</skos:definition>
    <skos:definition xml:lang="en">Terms from a composition-based classification that requires summarising the overall character of the unit. It is not applicable at the rock material or specimen level. Examples are: alkalic, subaluminous, peraluminous, I-Type, carbonate, phosphate.</skos:definition>
    <dcterms:description xml:lang="es">Términos basados en una clasificación composicional que resume el carácter general de la unidad. No es aplicable al nivel de material de roca o de muestra. Ejemplos: alcalina, subaluminosa, peraluminosa, tipo I, carbonatada, fosfatada.</dcterms:description>
    <dcterms:description xml:lang="en">Terms from a composition-based classification that requires summarising the overall character of the unit. It is not applicable at the rock material or specimen level. Examples are: alkalic, subaluminous, peraluminous, I-Type, carbonate, phosphate.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos propios definidos por el IGME</dcterms:provenance>
    <dcterms:creator>https://www.igme.es</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Tipo de categoría de composición.</skos:editorialNote>
