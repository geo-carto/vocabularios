    <skos:prefLabel xml:lang="es">métrica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metric</skos:prefLabel>
    <skos:definition xml:lang="es">Espesor medio de los estratos comprendido entre 1 y 10 m</skos:definition>
    <skos:definition xml:lang="en">Mean strata thickness comprised between 1 and 10 m</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estratificacion-grosor/decimetrica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor"/>
