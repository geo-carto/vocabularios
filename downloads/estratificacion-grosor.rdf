  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estratificacion-grosor/irregular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor"/>
    <skos:prefLabel xml:lang="es">irregular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">irregular</skos:prefLabel>
    <skos:definition xml:lang="es">Espesor de los estratos muy variable, sin que pueda establecerse un valor medio</skos:definition>
    <skos:definition xml:lang="en">Strata thickness very variable, a mean value cannot be estabished</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
