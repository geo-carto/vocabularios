  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estratificacion-grosor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Grosor de estratificación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Bedding thickness</skos:prefLabel>
    <dcterms:title xml:lang="es">Grosor de estratificación</dcterms:title>
    <dcterms:title xml:lang="en">Bedding thickness</dcterms:title>
    <skos:definition xml:lang="es">Término de un vocabulario controlado que caracteriza el espesor de la estratificación en la unidad.</skos:definition>
    <skos:definition xml:lang="en">Terms from a controlled vocabulary characterizing the thickness of bedding in the unit.</skos:definition>
    <dcterms:description xml:lang="es">Término de un vocabulario controlado que caracteriza el espesor de la estratificación en la unidad.</dcterms:description>
    <dcterms:description xml:lang="en">Terms from a controlled vocabulary characterizing the thickness of bedding in the unit.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos propios definidos por el IGME</dcterms:provenance>
    <dcterms:creator>https://www.igme.es</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Grosor de estratificación.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor/milimetrica"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor/centimetrica"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor/decimetrica"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor/metrica"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor/decametrica"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor/hectometrica"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor/irregular"/>
