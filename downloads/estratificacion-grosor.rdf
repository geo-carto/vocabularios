    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor"/>
    <skos:prefLabel xml:lang="es">milimétrica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">milimetric</skos:prefLabel>
    <skos:definition xml:lang="es">Espesor medio  de las capas inferior a 1 cm</skos:definition>
    <skos:definition xml:lang="en">Mean strata thickness inferior to 1 cm</skos:definition>
    <adms:status>Válido</adms:status>
