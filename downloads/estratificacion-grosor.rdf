  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estratificacion-grosor/milimetrica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-grosor"/>
