    <skos:prefLabel xml:lang="es">decimétrica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">decimetric</skos:prefLabel>
    <skos:definition xml:lang="es">Espesor medio de los estratos comprendido entre 10 cm y 1 m</skos:definition>
    <skos:definition xml:lang="en">Mean strata thickness comprised between 10 cm and 1m</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
