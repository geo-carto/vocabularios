    <skos:prefLabel xml:lang="es">decamétrica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">decametric</skos:prefLabel>
    <skos:definition xml:lang="es">Espesor medio de los estratos comprendido entre 10 y 100 m</skos:definition>
    <skos:definition xml:lang="en">Mean strata thickness comprised between 10 and 100 m</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estratificacion-grosor/metrica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
