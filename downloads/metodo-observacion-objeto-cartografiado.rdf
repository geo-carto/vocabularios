  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-recortes-de-sondeo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">inferido a partir de recortes de sondeo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred drill cuttings</skos:prefLabel>
    <skos:definition xml:lang="es">El elemento geológico en el sondeo se infiere a partir de la interpretación de recortes de sondeo.</skos:definition>
    <skos:definition xml:lang="en">Geologic feature in bore hole inferred based on interpretation of drill cuttings.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_drill_cuttings"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/compilacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">compilación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">compilation</skos:prefLabel>
    <skos:definition xml:lang="es">La geometría del elemento cartografiado se deriva de una o más fuentes de datos publicadas o no publicadas, e implica cierta interpretación o generalización por parte del compilador; no es una reproducción digital exacta de las fuentes.</skos:definition>
    <skos:definition xml:lang="en">Mapped feature geometry derived from one or more published or unpublished data sources, involving some interpretation or generalization by the compiler, not an exact digital reproduction of the sources.</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/compilation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
