  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observacion-directa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">observación directa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">direct observation</skos:prefLabel>
    <skos:definition xml:lang="es">Indica que el elemento cartografiado fue delimitado y caracterizado mediante observación visual directa.</skos:definition>
    <skos:definition xml:lang="en">Indicates that mapped feature was delineated and a specifier assigned by direct visual observation.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-imagenes-aereas"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-material-de-sondeo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/direct_observation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-datos-gravimetricos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">inferido a partir de datos gravimétricos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred gravity data</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se infieren a partir de variaciones medidas en la aceleración de la gravedad, relacionadas con la masa del material terrestre subyacente.</skos:definition>
    <skos:definition xml:lang="en">Location and specification inferred based on measured variations in the acceleration of gravity related to mass of underlying Earth material.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_gravity_data"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">inferido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred</skos:prefLabel>
    <skos:definition xml:lang="es">Indica que el elemento cartografiado no es directamente observable; su ubicación y especificación se basan en inferencias a partir de la evidencia disponible.</skos:definition>
    <skos:definition xml:lang="en">Indicates that mapped feature is not directly observable, location and specification based on inference from available evidence.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-recortes-de-sondeo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-entre-ubicaciones-observadas"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-bajo-material-superficial-no-cartografiado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">proyección inferida bajo material superficial no cartografiado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred projection beneath unmapped surficial material</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se determinan por continuidad inferida entre ubicaciones observadas, asumiendo continuidad del elemento. No es observable debido a un manto superficial de suelo, detritos o coluvión, que no ha sido cartografiado como unidad geológica separada.</skos:definition>
    <skos:definition xml:lang="en">Location and specification determined based on inferred continuity with observed locations, and assumption of continuity of the feature. Not observable because of covering mantle of soil, talus or colluvium, not mapped as separate geologic units.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-entre-ubicaciones-observadas"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection_unmapped_surficial_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-oculta-por-vegetacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">proyección inferida oculta por vegetación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred projection obscured by vegetation</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se determinan por continuidad inferida entre ubicaciones observadas, asumiendo continuidad del elemento. No es observable por estar oculto por vegetación, pero se infiere que aflora en la superficie.</skos:definition>
    <skos:definition xml:lang="en">Location and specification determined based on inferred continuity with observed locations, and assumption of continuity of the feature. Not observable because of obscuring vegetation, but inferred to crop out at surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-entre-ubicaciones-observadas"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection_vegetation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento-lejano">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">observado en afloramiento lejano</skos:prefLabel>
    <skos:prefLabel xml:lang="en">observed distant outcrop</skos:prefLabel>
    <skos:definition xml:lang="es">Fenómeno observado y ubicado desde la distancia.</skos:definition>
    <skos:definition xml:lang="en">Phenomenon observed and located from a distance.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_distant_outcrop"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">inferido mediante método indirecto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred using indirect method</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se infieren a partir de propiedades relacionadas con la litología, como firmas geofísicas o geoquímicas, vegetación, textura superficial o reflectancia.</skos:definition>
    <skos:definition xml:lang="en">Location and specification inferred based on properties related to lithology, e.g. geophysical or geochemical signature, vegetation, surface texture, reflectance.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-aeromagnetico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-registro-geofisico-de-sondeo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-datos-gravimetricos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-magnetico-terrestre"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-radiometrico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-imagenes-de-teledeteccion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_indirect_method"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-magnetico-terrestre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">inferido a partir de levantamiento magnético terrestre</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred ground magnetic survey</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se infieren a partir de datos del campo magnético adquiridos por sensores en la superficie terrestre, ya sea en estaciones ocupadas manualmente o mediante sensores móviles en vehículos.</skos:definition>
    <skos:definition xml:lang="en">Location and specification inferred based on magnetic field data acquired by sensor on the earth surface, either at manually occupied stations, or by a vehicle-based continuously collected sensor data.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_ground_magnetic_survey"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/cartografiado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">cartografiado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">surveyed</skos:prefLabel>
    <skos:definition xml:lang="es">El elemento cartografiado se ubica mediante métodos de levantamiento topográfico.</skos:definition>
    <skos:definition xml:lang="en">mapped feature is located by survey methods</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/levantamiento-inercial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/surveyed"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/mapa-publicado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">mapa publicado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">published map</skos:prefLabel>
    <skos:definition xml:lang="es">La geometría del elemento cartografiado fue digitalizada a partir de un mapa publicado; su especificación se basa en la leyenda o explicación de unidades del mapa.</skos:definition>
    <skos:definition xml:lang="en">Mapped feature geometry was digitized from a published map, specification of feature based on map unit explanation</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/published_map"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Método de observación de un objeto cartográfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Mapped feature observation method</skos:prefLabel>
    <dcterms:title xml:lang="es">Método de observación de un objeto cartográfico</dcterms:title>
    <dcterms:title xml:lang="en">Mapped feature observation method</dcterms:title>
    <skos:definition xml:lang="es">Términos que especifican el método por el cual se ha determinado la extensión espacial de un determinado objeto cartográfico.</skos:definition>
    <skos:definition xml:lang="en">Terms specifying how a MappedFeature instance was mapped.</skos:definition>
    <dcterms:description xml:lang="es">Términos que especifican el método por el cual se ha determinado la extensión espacial de un determinado objeto cartográfico.</dcterms:description>
    <dcterms:description xml:lang="en">Terms specifying how a MappedFeature instance was mapped.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos originales del estándar GeoSciML traducidos al español por el IGME</dcterms:provenance>
    <dcterms:creator>https://cgi-iugs.org/</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Método de observación de un objeto cartográfico.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/compilacion"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observacion-directa"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-a-partir-de-datos-de-elevacion"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/mapa-publicado"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/cartografiado"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/levantamiento-inercial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">levantamiento inercial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inertial survey</skos:prefLabel>
    <skos:definition xml:lang="es">El elemento cartografiado se ubica mediante métodos de levantamiento inercial.</skos:definition>
    <skos:definition xml:lang="en">mapped feature is located by inertial survey methods</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/cartografiado"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inertial_survey"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-imagenes-aereas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">observado en imágenes aéreas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">observed in aerial imagery</skos:prefLabel>
    <skos:definition xml:lang="es">Fenómeno observado y ubicado mediante imágenes aéreas (luz visible estándar).</skos:definition>
    <skos:definition xml:lang="en">Phenomenon observed and located using aerial imagery (standard visible light)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observacion-directa"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_aerial_imagery"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/ubicacion-de-afloramiento-observada-en-mapa-topografico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">ubicación de afloramiento observada en mapa topográfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">observed outcrop topographic map location</skos:prefLabel>
    <skos:definition xml:lang="es">Fenómeno observado directamente en afloramiento y ubicado mediante posicionamiento sobre un mapa topográfico, en relación con elementos fisiográficos o culturales.</skos:definition>
    <skos:definition xml:lang="en">Phenomenon observed directly in outcrop, and located by positioning on a topographic base map relative to physiographic or cultural features</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_outcrop__topographic_map_location"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-registro-geofisico-de-sondeo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">inferido a partir de registro geofísico de sondeo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred borehole geophysical log</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se infieren a partir de mediciones realizadas por dispositivos electrónicos de registro geofísico en sondeos.</skos:definition>
    <skos:definition xml:lang="en">Location and specification inferred based on measurements made by electronic bore hole logging device(s) that measure geophysical properties.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_borehole_geophysical_log"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-recortes-de-sondeo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">observado en recortes de sondeo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">observed in borehole cuttings</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento geológico observado en recortes de sondeo obtenidos de un pozo.</skos:definition>
    <skos:definition xml:lang="en">Geologic feature observed in cuttings obtained from a borehole.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-material-de-sondeo"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_borehole_cuttings"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-aeromagnetico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">inferido a partir de levantamiento aeromagnético</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred aeromagnetic survey</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se infieren a partir de datos del campo magnético adquiridos por sensores aerotransportados.</skos:definition>
    <skos:definition xml:lang="en">Location and specification inferred based on magnetic field data acquired by airborne sensor.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_aeromagnetic_survey"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-a-partir-de-datos-de-elevacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">observado a partir de datos de elevación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">observed based on elevation data</skos:prefLabel>
    <skos:definition xml:lang="es">Los elementos geomorfológicos se ubican y especifican en función de la morfología superficial determinada por datos de elevación (o batimetría), por ejemplo, DEM o LIDAR.</skos:definition>
    <skos:definition xml:lang="en">Geomorphic features located and specified based on surface morphology determined by elevation (or bathemetry) data, e.g. DEM, LIDAR</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_elevation_data"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/ubicacion-de-afloramiento-observada-con-GPS">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">ubicación de afloramiento observada con GPS</skos:prefLabel>
    <skos:prefLabel xml:lang="en">observed outcrop gps location</skos:prefLabel>
    <skos:definition xml:lang="es">Fenómeno observado directamente en afloramiento y ubicado mediante GPS.</skos:definition>
    <skos:definition xml:lang="en">Phenomenon observed directly in outcrop, and located using GPS</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_outcrop_gps_location"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-testigo-de-sondeo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">observado en testigo de sondeo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">observed in borehole core</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento geológico observado en testigo de sondeo obtenido de un pozo.</skos:definition>
    <skos:definition xml:lang="en">Geologic feature observed in core obtained from a borehole.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-material-de-sondeo"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_borehole_core"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-levantamiento-radiometrico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">inferido a partir de levantamiento radiométrico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred radiometric survey</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se infieren a partir del flujo o intensidad de radiación relacionada con la desintegración de elementos radiactivos en el material terrestre observado. Se aplica tanto a sensores aerotransportados como de superficie.</skos:definition>
    <skos:definition xml:lang="en">Location and specification inferred based on flux or intensity of radiation related to the decay of radioactive elements in observed Earth material. Use for both airborne and ground-surface based sensor.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_radiometric_survey"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-a-partir-de-imagenes-de-teledeteccion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">inferido a partir de imágenes de teledetección</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred remote sensing imagery</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se infieren a partir de características espectrales de la luz medida por sensores aerotransportados o satelitales. Los fenómenos visibles en fotografías aéreas estándar (luz visible) se consideran "observables".</skos:definition>
    <skos:definition xml:lang="en">Location and specification inferred based on spectral characteristics of light measured by airborne or satellite based sensor. Phenomenon visible on standard (visible light) air photographs are considered 'observable'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido-mediante-metodo-indirecto"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_remote_sensing_imagery"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-entre-ubicaciones-observadas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">proyección inferida entre ubicaciones observadas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred projection between observed locations</skos:prefLabel>
    <skos:definition xml:lang="es">La ubicación y especificación se determinan por continuidad inferida entre ubicaciones observadas, asumiendo continuidad del elemento.</skos:definition>
    <skos:definition xml:lang="en">Location and specification determined based on inferred continuity with observed locations, and assumption of continuity of the feature.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/inferido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-bajo-unidad-cartografiada-suprayacente"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-bajo-material-superficial-no-cartografiado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-oculta-por-vegetacion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection__observed_locations"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-material-de-sondeo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">observado en material de sondeo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">observed in borehole material</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento geológico observado en material obtenido de un sondeo.</skos:definition>
    <skos:definition xml:lang="en">Geologic feature observed in material obtained from a borehole.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observacion-directa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-testigo-de-sondeo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-recortes-de-sondeo"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_borehole_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">observado en afloramiento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">observed in outcrop</skos:prefLabel>
    <skos:definition xml:lang="es">Fenómeno observado y ubicado directamente en afloramiento; el geólogo estuvo presente en la ubicación del fenómeno y lo trazó explícitamente en su extensión cartografiada.</skos:definition>
    <skos:definition xml:lang="en">Phenomenon observed and located directly in outcrop, geologist occupied location of phenomenon, and traced it explicitly over mapped extent.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observacion-directa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/observado-en-afloramiento-lejano"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/ubicacion-de-afloramiento-observada-en-mapa-topografico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/ubicacion-de-afloramiento-observada-con-GPS"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_outcrop"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-bajo-unidad-cartografiada-suprayacente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado"/>
    <skos:prefLabel xml:lang="es">proyección inferida bajo unidad cartografiada suprayacente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inferred projection beneath covering mapped unit</skos:prefLabel>
    <skos:definition xml:lang="es">Se infiere la existencia del fenómeno por continuidad entre ubicaciones observadas, asumiendo continuidad del elemento. El elemento cartografiable está cubierto por una unidad geológica más joven. Elemento oculto.</skos:definition>
    <skos:definition xml:lang="en">Phenomenon inferred to exist based on continuity with observed locations, and assumption of continuity of the feature. Mappable feature is covered by mapped younger geologic unit. Concealed feature.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-entre-ubicaciones-observadas"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection_covering_mapped_unit"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
</rdf:RDF>
