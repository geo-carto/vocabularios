      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Facies metamórfica caracterizada en rocas de composición basáltica por la asociación mineral clinopiroxeno-ortopiroxeno-plagioclasa (olivino no estable con plagioclasa o con granate), o variedades o polimorfos de minerales de especialmente alta temperatura."
      },
      {
        "@language": "en",
        "@value": "Metamorphic facies characterized in rocks of basaltic composition by the mineral assemblage clinopyroxene-orthopyroxene-plagioclase (olivine not stable with plagioclase or with garnet), or especially high-temperature varieties or polymorphs of minerals"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/metamorphicfacies/granulite_facies"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metamorfismo-facies"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "facies metamórfica de las granulitas"
      },
      {
        "@language": "en",
        "@value": "granulite facies"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
