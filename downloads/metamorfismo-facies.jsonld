      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Facies metamórfica caracterizada por la asociación de hornblenda-albita-epidota (-clorita) en rocas de composición basáltica"
      },
      {
        "@language": "en",
        "@value": "Hornblende-albite-epidote(-chlorite), assemblage for rocks of basaltic composition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
