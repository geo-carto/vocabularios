      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Facies metamórfica caracterizada en rocas de composición basáltica por glaucofana-epidota (-granate), glaucofana-lawsonita, o glaucofana-lawsonita-jadeita"
      },
      {
        "@language": "en",
        "@value": "Metamorphic facies characterized in rocks of basaltic composition by glaucophane-epidote (-garnet), glaucophane-lawsonite, or glaucophane-lawsonite-jadeite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/metamorphicfacies/glaucophane_schist_facies"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/metamorfismo-facies"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "facies metamórfica de los esquistos con glaucofana"
      },
      {
        "@language": "en",
        "@value": "glaucophane schist facies"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
