      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Facies metamórfica caracterizada por la asociación de onfacita-granate-cuarzo (sin plagioclasa ni olivino estables con granate) en rocas de composición basáltica"
      },
      {
        "@language": "en",
        "@value": "Omphacite-garnet-quartz (no plagioclase, olivine stable with garnet), assemblage for rocks of basaltic composition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/metamorphicfacies/eclogite_metamorphic_facies"
      }
