      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "facies metamórfica de las anfibolitas"
      },
      {
        "@language": "en",
        "@value": "amphibolite metamorphic facies"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
