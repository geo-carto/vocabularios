    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Persona o entidad responsable de implementar y mantener sistemas, herramientas y procesos para la gestión, tratamiento y publicación de información geoespacial. Puede desempeñar de forma integrada varias de las funciones representadas por los roles específicos que engloba."
      },
      {
        "@language": "en",
        "@value": "Person or entity responsible for implementing and maintaining systems, tools and processes for managing, processing and publishing geospatial information. This role may involve the integrated execution of several functions represented by the more specific roles it encompasses."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
