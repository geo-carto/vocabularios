    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Persona o entidad responsable de la coordinación de los aspectos técnicos del proyecto, incluyendo metodologías, herramientas y flujos de trabajo."
      },
      {
        "@language": "en",
        "@value": "Person or entity responsible for coordinating the technical aspects of the project, including methodologies, tools and workflows."
      }
