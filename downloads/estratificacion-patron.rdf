    <skos:prefLabel xml:lang="es">Patrón de estratificación - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Bedding pattern - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron/estratodecreciente"/>
