   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estratificacion-patron/aleatoria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron"/>
    <skos:prefLabel xml:lang="es">aleatoria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">random</skos:prefLabel>
    <skos:definition xml:lang="es">Los espesores de los distintos estratos de la unidad son muy variables y no presentan ninguna ordenación definida</skos:definition>
    <skos:definition xml:lang="en">The thicknesses of the different strata of the unit are highly variable and do not present any defined order.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estratificacion-patron/estratodecreciente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron"/>
    <skos:prefLabel xml:lang="es">estratodecreciente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">thinning upward</skos:prefLabel>
    <skos:definition xml:lang="es">Los estratos son más delgados hacia la parte superior (más joven) de la unidad</skos:definition>
    <skos:definition xml:lang="en">Individual strata thicknes decreases towars the top (younger) part of the unit</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estratificacion-patron/ciclica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron"/>
    <skos:prefLabel xml:lang="es">cíclica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cyclic</skos:prefLabel>
    <skos:definition xml:lang="es">Sucesión de estratos en los que alternan tres clases de  litologías</skos:definition>
    <skos:definition xml:lang="en">Succession of strata in which three types of lithologies alternate</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
