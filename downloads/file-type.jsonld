    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Moving Picture Experts Group 4"
      },
      {
        "@language": "en",
        "@value": "Moving Picture Experts Group 4"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "MPEG-4 – Moving Picture Experts Group – es un método de definición de compresión de datos digitales de audio y vídeo (AV). Fue designado como estándar para un grupo de formatos de codificación de audio y vídeo y tecnología relacionada."
      },
      {
        "@language": "en",
        "@value": "MPEG-4 – Moving Picture Experts Group – is a method of defining compression of audio and visual (AV) digital data. It was designated a standard for a group of audio and video coding formats and related technology."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/audio/mp4"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/video/mp4"
