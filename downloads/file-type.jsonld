  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/hdf5",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Hierarchical Data Format versión 5"
      },
      {
        "@language": "en",
        "@value": "Hierarchical Data Format version 5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "HDF5 (Hierarchical Data Format versión 5) es un formato de archivo y un conjunto de herramientas diseñados para gestionar colecciones de datos complejas. Permite almacenar y organizar grandes cantidades de datos numéricos heterogéneos en una estructura jerárquica de grupos y conjuntos de datos dentro de un único archivo. Es ampliamente utilizado en investigación científica, ingeniería y observación de la Tierra."
      },
      {
        "@language": "en",
        "@value": "HDF5 (Hierarchical Data Format version 5) is a file format and set of tools designed for managing complex data collections. It allows storing and organizing large amounts of heterogeneous numerical data in a hierarchical structure of groups and datasets within a single file. It is widely used in scientific research, engineering, and Earth observation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-hdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".h5; .hdf5"
      },
      {
        "@value": "application/x-hdf5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "HDF5"
      },
      {
        "@language": "en",
        "@value": "HDF5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/aab",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Android App Bundle"
      },
      {
        "@language": "en",
        "@value": "Android App Bundle"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un Android App Bundle (AAB) es un formato de archivo de paquete utilizado por el sistema operativo Android. Incluye el código compilado y los recursos de una aplicación, y delega la generación y firma del APK a Google Play."
      },
      {
        "@language": "en",
        "@value": "An Android App Bundle (AAB) is a package file format used by the Android operating system. It includes an app’s compiled code and resources, and defers APK generation and signing to Google Play."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-authorware-bin"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/AAB"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".aab"
      },
      {
        "@value": "application/x-authorware-bin"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "AAB"
      },
      {
        "@language": "en",
        "@value": "AAB"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
