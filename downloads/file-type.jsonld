  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/netcdf",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Network Common Data Form"
      },
      {
        "@language": "en",
        "@value": "Network Common Data Form"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "NetCDF es un conjunto de bibliotecas de software y formatos de datos autodescriptivos e independientes de la máquina que soportan la creación, acceso y compartición de datos científicos orientados a matrices."
      },
      {
        "@language": "en",
        "@value": "NetCDF is a set of software libraries and self-describing, machine-independent data formats that support the creation, access and sharing of array-oriented scientific data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-netcdf"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/NETCDF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".nc; .cdf"
      },
      {
        "@value": "application/x-netcdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "NetCDF"
      },
      {
        "@language": "en",
        "@value": "NetCDF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
