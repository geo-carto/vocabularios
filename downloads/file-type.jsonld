      },
      {
        "@value": "application/xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "JATS XML"
      },
      {
        "@language": "en",
        "@value": "JATS XML"
      }
    ],
