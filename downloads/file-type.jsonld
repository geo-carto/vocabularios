    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "PDF/A-2 es la Parte 2 del estándar PDF y especifica tres niveles de conformidad para archivos PDF. PDF/A-2a corresponde al nivel de conformidad a en PDF/A-1 (accesible)."
      },
      {
        "@language": "en",
        "@value": "PDF/A-2 is the Part 2 of the PDF standard and specifies three levels of conformance for PDF files. PDF/A-2a corresponds to conformance level a in PDF/A-1 (accessible)."
