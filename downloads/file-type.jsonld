    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "HDF es un conjunto de formatos de archivo (HDF4, HDF5) diseñados para almacenar y organizar grandes cantidades de datos numéricos."
      },
      {
        "@language": "en",
        "@value": "HDF is a set of file formats (HDF4, HDF5) designed to store and organize large amounts of numerical data."
      }
    ],
