        "@language": "es",
        "@value": "Microsoft Word"
      },
      {
        "@language": "en",
        "@value": "Microsoft Word"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "DOC es un formato de documento Word binario propietario utilizado por el procesador de textos Microsoft Word."
      },
      {
        "@language": "en",
        "@value": "DOC is a proprietary binary Word document format used by Microsoft Word word processor."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/msword"
