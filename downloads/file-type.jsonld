  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/rdf_thrift",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "RDF Binary Thrift"
      },
      {
        "@language": "en",
        "@value": "RDF Binary Thrift"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "RDF Binary usando Apache Thrift ('RDF Thrift') es un formato binario para RDF y datos relacionados con RDF. Los formatos binarios son más rápidos de procesar, ya que no incurren en los costes de análisis de los formatos basados en texto. RDF Thrift define codificación básica para términos RDF, y luego construye formatos de datos para grafos RDF, conjuntos de datos RDF y conjuntos de resultados SPARQL."
      },
      {
        "@language": "en",
        "@value": "RDF Binary using Apache Thrift (‘RDF Thrift’) is a binary format for RDF and RDF-related data. Binary formats are faster to process – they do not incur the parsing costs of text-base formats. RDF Thrift defines basic encoding for RDF terms, then builds data formats for RDF graphs, RDF datasets and for SPARQL result sets. This gives a basis for high-performance linked data systems."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/rdf+thrift"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/RDF_THRIFT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".rt; .trdf"
      },
      {
        "@value": "application/rdf+thrift"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "RDF Thrift"
      },
      {
        "@language": "en",
        "@value": "RDF Thrift"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
