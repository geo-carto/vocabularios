        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Archivo de estilo QGIS"
      },
      {
        "@language": "en",
        "@value": "QGIS Style File"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo QML (QGIS Layer Style) es un archivo XML que almacena la información de estilo de una capa en QGIS, incluyendo la simbología, el etiquetado, las acciones de formulario y otras propiedades de visualización. Se utiliza para guardar y compartir estilos de capas entre proyectos QGIS."
      },
      {
        "@language": "en",
        "@value": "A QML (QGIS Layer Style) file is an XML file that stores the styling information for a layer in QGIS, including symbology, labeling, form actions, and other display properties. It is used to save and share layer styles between QGIS projects."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".qml"
      },
      {
        "@value": "application/xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "QML"
      },
      {
        "@language": "en",
        "@value": "QML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
