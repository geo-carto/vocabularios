  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/ipynb",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Jupyter Notebook"
      },
      {
        "@language": "en",
        "@value": "Jupyter Notebook"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo IPYNB (IPython Notebook) es un documento Jupyter Notebook almacenado en formato JSON. Contiene una lista ordenada de celdas de entrada/salida que pueden incluir código ejecutable, texto enriquecido (Markdown), matemáticas (LaTeX), gráficos e imágenes. Es ampliamente utilizado en ciencia de datos, investigación científica y educación."
      },
      {
        "@language": "en",
        "@value": "An IPYNB (IPython Notebook) file is a Jupyter Notebook document stored in JSON format. It contains an ordered list of input/output cells that can include executable code, rich text (Markdown), mathematics (LaTeX), plots, and images. It is widely used in data science, scientific research, and education."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".ipynb"
      },
      {
        "@value": "application/x-ipynb+json"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "IPYNB"
      },
      {
        "@language": "en",
        "@value": "IPYNB"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
