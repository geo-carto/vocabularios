  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/xliff",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "XML Localisation Interchange File Format"
      },
      {
        "@language": "en",
        "@value": "XML Localisation Interchange File Format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "XLIFF es el formato de archivo de intercambio de localización XML diseñado por un grupo de editores de contenido multilingüe, proveedores de software, proveedores de servicios de localización, proveedores de herramientas de localización e investigadores. Está destinado a proporcionar a cualquier propietario de contenido multilingüe un formato de archivo de intercambio único que pueda ser entendido por cualquier proveedor de localización utilizando cualquier herramienta conforme."
      },
      {
        "@language": "en",
        "@value": "XLIFF is the XML Localisation Interchange File Format designed by a group of multilingual content publishers, software providers, localization service providers, localization tools providers and researchers. It is intended to give any multilingual content owner a single interchange file format that can be understood by any localization provider, using any conformant localization tool. While the primary focus is on being a lossless interchange format, usage of XLIFF as a processing format is neither encouraged nor discouraged or prohibited."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xliff+xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/XLIFF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".xlf"
      },
      {
        "@value": "application/xliff+xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "XLIFF"
      },
      {
        "@language": "en",
        "@value": "XLIFF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/psd",
