    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "PS – PostScript – es un lenguaje de descripción de páginas en el negocio de la publicación electrónica y la autoedición. Es un lenguaje de programación de tipo dinámico y concatenativo."
      },
      {
        "@language": "en",
        "@value": "PS – PostScript – is a page description language in the electronic publishing and desktop publishing business. It is a dynamically typed, concatenative programming language."
      }
