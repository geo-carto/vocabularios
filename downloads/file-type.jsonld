      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Esri Representational State Transfer"
      },
      {
        "@language": "en",
        "@value": "Esri Representational State Transfer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Esri REST es una forma estándar para que los clientes web se comuniquen con servidores de sistemas de información geográfica (SIG) a través de la tecnología REST (Representational State Transfer)."
      },
      {
        "@language": "en",
        "@value": "Esri REST is a standard way for web clients to communicate with geographic information system (GIS) servers through Representational State Transfer (REST) technology."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/arcgis_rest"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/REST"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "arcgis_rest"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Esri REST"
      },
      {
        "@language": "en",
        "@value": "Esri REST"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
