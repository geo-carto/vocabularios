  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/pdfx2a",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "PDF/X-2a es una especificación PDF en la que se soportan datos de color gestionados CMYK y datos de colores directos en cualquier combinación."
      },
      {
        "@language": "en",
        "@value": "PDF/X-2a is a PDF specification in which colour-managed, CMYK and spot colour data are supported in any combination."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/pdf"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/PDFX2A"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".pdf"
      },
      {
        "@value": "application/pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "PDF/X-2a"
      },
      {
        "@language": "en",
        "@value": "PDF/X-2a"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
