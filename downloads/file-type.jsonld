  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/arcgis_vt_srvc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Servicio de teselas vectoriales ArcGIS"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Vector Tile Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un servicio de teselas vectoriales (Vector Tile Service) de ArcGIS proporciona acceso a datos vectoriales precacheados en formato PBF (Protocol Buffer Format) a través de la API REST de ArcGIS. Las teselas vectoriales permiten la representación de alto rendimiento en el cliente aprovechando la GPU del navegador. El estilo se aplica dinámicamente en el lado del cliente utilizando la especificación Mapbox Style."
      },
      {
        "@language": "en",
        "@value": "An ArcGIS Vector Tile Service provides access to pre-cached vector data in PBF (Protocol Buffer Format) through the ArcGIS REST API. Vector tiles enable high-performance client-side rendering by leveraging the browser GPU. Styling is applied dynamically on the client side using the Mapbox Style specification."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "arcgis_vector_tile_service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ArcGIS Vector Tile Service"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Vector Tile Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
