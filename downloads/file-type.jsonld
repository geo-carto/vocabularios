  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/wms_srvc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Web Map Service"
      },
      {
        "@language": "en",
        "@value": "Web Map Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un Web Map Service (WMS) es un protocolo estándar desarrollado por el Open Geospatial Consortium (OGC) para servir imágenes de mapas georreferenciados a través de Internet. Estas imágenes son típicamente producidas por un servidor de mapas a partir de datos proporcionados por una base de datos de sistema de información geográfica (SIG)."
      },
      {
        "@language": "en",
        "@value": "A Web Map Service (WMS) is a standard protocol developed by the Open Geospatial Consortium (OGC) for serving georeferenced map images over the Internet. These images are typically produced by a map server from data provided by a geographic information system (GIS) database."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/text/xml"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.ogc.wms_xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "text/xml; application/vnd.ogc.wms_xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "WMS"
      },
      {
        "@language": "en",
        "@value": "WMS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/eforms_xml",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "eForms XML file"
      },
      {
        "@language": "en",
        "@value": "eForms XML file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Estándar legislativo XML de la UE para datos de contratación pública utilizado por los compradores públicos para publicar anuncios en Tenders Electronic Daily (TED), el sitio web europeo de publicidad de contratación pública. Los formularios estándar (eForms) fueron establecidos por el Reglamento de Ejecución (UE) 2019/1780 de la Comisión, de 23 de septiembre de 2019, y deben implementarse en los sistemas nacionales de contratación electrónica adaptándolos a las necesidades nacionales."
      },
      {
        "@language": "en",
        "@value": "EU legislative XML standard for procurement data used by public buyers to publish notices on Tenders Electronic Daily (TED), the European public procurement advertising website. The standard forms (eForms) have been established by the Commission Implementing Regulation (EU) 2019/1780 of 23 September 2019, and need to be implemented in national eProcurement systems by being tailored to national needs."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/EFORMS_XML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".xml"
      },
      {
        "@value": "application/xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "eForms XML"
      },
      {
        "@language": "en",
        "@value": "eForms XML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/schema_xml",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "XML Schema"
      },
      {
        "@language": "en",
        "@value": "XML Schema"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un esquema XML es una descripción de un tipo de documento XML, típicamente expresada en términos de restricciones sobre la estructura y el contenido de los documentos de ese tipo, más allá de las restricciones sintácticas básicas impuestas por el propio XML."
      },
      {
        "@language": "en",
        "@value": "An XML schema is a description of a type of XML document, typically expressed in terms of constraints on the structure and content of documents of that type, above and beyond the basic syntactical constraints imposed by XML itself."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/SCHEMA_XML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
