      },
      {
        "@language": "en",
        "@value": "Internet Archive ARC file format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "ARC es el formato de archivo de Internet Archive. Los archivos ARC son grandes archivos agregados."
