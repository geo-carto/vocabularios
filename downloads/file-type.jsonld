      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Geographical JavaScript Object Notation"
      },
      {
        "@language": "en",
        "@value": "Geographical JavaScript Object Notation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "GeoJSON es un formato de estándar abierto diseñado para representar características geográficas simples, junto con sus atributos no espaciales, basado en JSON."
      },
      {
        "@language": "en",
        "@value": "GeoJSON is an open standard format designed for representing simple geographical features, along with their non-spatial attributes, based on JSON."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/geo+json"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/GEOJSON"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".json; .geojson"
      },
      {
        "@value": "application/geo+json"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "GeoJSON"
      },
      {
        "@language": "en",
        "@value": "GeoJSON"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
