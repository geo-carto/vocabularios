        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Octet es el tipo de medio de Internet para un flujo de bytes arbitrario. Un flujo de bytes u octetos es una serie de bytes."
      },
      {
        "@language": "en",
        "@value": "Octet is the Internet media type for an arbitrary byte stream. A byte streamor octet stream is a series of bytes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/octet-stream"
