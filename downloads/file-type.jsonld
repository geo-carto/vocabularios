      },
      {
        "@language": "en",
        "@value": "Schematron file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Lenguaje de validación basado en reglas para hacer aserciones sobre la estructura y el contenido de documentos XML; se expresa en XML usando un pequeño número de elementos y XPath; ha sido estandarizado como parte de ISO/IEC 19757."
      },
      {
        "@language": "en",
        "@value": "rule-based validation language for making assertions about the structure and content of XML documents; it is expressed in XML using a small number of elements and XPath; it has been standardised as part of ISO/IEC 19757"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      },
      {
