  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/parquet",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Apache Parquet file"
      },
      {
        "@language": "en",
        "@value": "Apache Parquet file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Formato de almacenamiento columnar de Apache disponible para cualquier proyecto del ecosistema Hadoop, independientemente del marco de procesamiento de datos, modelo de datos o lenguaje de programación elegido; diseñado explícitamente para separar los metadatos de los datos."
      },
      {
        "@language": "en",
        "@value": "Apache columnar storage format available to any project in the Hadoop ecosystem, regardless of the choice of data processing framework, data model or programming language; explicitly designed to separate the metadata from the data"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.apache.parquet"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/PARQUET"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".parquet"
      },
      {
        "@value": "application/vnd.apache.parquet"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Parquet"
      },
      {
        "@language": "en",
        "@value": "Parquet"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/geoparquet",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Apache GeoParquet"
      },
      {
        "@language": "en",
        "@value": "Apache GeoParquet"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "GeoParquet es una especificación para almacenar datos vectoriales geoespaciales (puntos, líneas, polígonos) en formato Apache Parquet. Define cómo deben almacenarse los datos geoespaciales en Parquet, incluyendo la representación de geometrías y los metadatos adicionales necesarios. Es un formato columnar de código abierto estandarizado, optimizado para flujos de trabajo analíticos de lectura intensiva."
      },
      {
        "@language": "en",
        "@value": "GeoParquet is a specification for storing geospatial vector data (points, lines, polygons) in Apache Parquet format. It defines how geospatial data should be stored in Parquet, including the representation of geometries and the required additional metadata. It is an open-source standardized columnar storage format optimized for read-heavy analytic workflows."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.apache.parquet"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".parquet"
      },
      {
        "@value": "application/vnd.apache.parquet"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "GeoParquet"
      },
      {
        "@language": "en",
        "@value": "GeoParquet"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/webp",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "WebP image"
      },
      {
        "@language": "en",
        "@value": "WebP image"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "WebP es un formato de archivo de imagen desarrollado por Google como reemplazo de los formatos JPEG, PNG y GIF. Soporta tanto compresión con pérdida como sin pérdida, así como animación y transparencia alfa."
      },
      {
        "@language": "en",
        "@value": "WebP is an image file format developed by Google intended as a replacement for JPEG, PNG, and GIF file formats. It supports both lossy and lossless compression, as well as animation and alpha transparency."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/image/webp"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/WEBP"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".webp"
      },
      {
        "@value": "image/webp"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "WebP"
      },
      {
        "@language": "en",
        "@value": "WebP"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/dgn",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "DGN file"
      },
      {
        "@language": "en",
        "@value": "DGN file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo DGN es un dibujo 2D/3D creado por diversos programas CAD de construcción, como MicroStation e Intergraph Interactive Graphics Design System. Puede guardarse en uno de dos formatos: el Intergraph Standard File Format (ISFF) o el más reciente estándar V8 DGN. Los archivos DGN se utilizan típicamente para guardar diseños de proyectos de construcción de autopistas, puentes y edificios."
      },
      {
        "@language": "en",
        "@value": "A DGN file is a 2D/3D drawing created by various construction CAD software, such as MicroStation and Intergraph Interactive Graphics Design System. It may be saved in one of two formats, either the Intergraph Standard File Format (ISFF) or the newer V8 DGN standard. DGN files are typically used to save designs for construction projects for highways, bridges, and buildings."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/octet-stream"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/DGN"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".dgn"
      },
      {
        "@value": "application/octet-stream"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "DGN"
      },
      {
        "@language": "en",
        "@value": "DGN"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/json_ld",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "JavaScript Object Notation for Linked Data"
      },
      {
        "@language": "en",
        "@value": "JavaScript Object Notation for Linked Data"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "JSON-LD es un formato basado en JSON para serializar datos enlazados (Linked Data). Está destinado principalmente a ser una forma de utilizar datos enlazados en entornos de programación basados en web, para construir servicios web interoperables y para almacenar datos enlazados en motores de almacenamiento basados en JSON."
      },
      {
        "@language": "en",
        "@value": "JSON-LD is a JSON-based format to serialize Linked Data. It is primarily intended to be a way to use Linked Data in Web-based programming environments, to build interoperable Web services, and to store Linked Data in JSON-based storage engines."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/ld+json"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/JSON_LD"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".jsonld"
      },
      {
        "@value": "application/ld+json"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "JSON-LD"
      },
      {
        "@language": "en",
        "@value": "JSON-LD"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/grid_ascii",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Environmental Systems Research Institute ASCII grid"
      },
      {
        "@language": "en",
        "@value": "Environmental Systems Research Institute ASCII grid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Esri ASCII grid es el tipo de medio que se utilizará para archivos ASCII GRID. ASCII GRID es uno de los dos formatos de Esri grid, un formato de archivo SIG rasterizado, un formato ASCII no propietario, también conocido como ArcInfo ASCII GRID."
      },
      {
        "@language": "en",
        "@value": "Esri ASCII grid is the media type which shall be used for ASCII GRID files. ASCII GRID is one of the two formats of Esri grid, a raster GIS file format, a non-proprietary ASCII format, also known as an ArcInfo ASCII GRID."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-ascii-grid"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/GRID_ASCII"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".asc"
      },
      {
        "@value": "application/x-ascii-grid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Esri ASCII grid"
      },
      {
        "@language": "en",
        "@value": "Esri ASCII grid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/txt",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Text file"
      },
      {
        "@language": "en",
        "@value": "Text file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El texto plano son datos (p. ej. contenido de archivos) que representan únicamente caracteres de material legible pero no su representación gráfica ni otros objetos. También puede incluir un número limitado de caracteres que controlan la disposición simple del texto, como saltos de línea o caracteres de tabulación. El texto plano es diferente del texto formateado y de los archivos binarios."
      },
      {
        "@language": "en",
        "@value": "Plain text is the data (e.g. file contents) that represent only characters of readable material but not its graphical representation nor other objects. It may also include a limited number of characters that control simple arrangement of text, such as line breaks or tabulation characters. Plain text is different from formatted text, where style information is included, and from ‘binary files’ in which some portions must be interpreted as binary objects (encoded integers, real numbers, images, etc.)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/text/plain"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/TXT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".txt"
      },
      {
        "@value": "text/plain"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Plain text"
      },
      {
        "@language": "en",
        "@value": "Plain text"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/rpm",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "RPM Package"
      },
      {
        "@language": "en",
        "@value": "RPM Package"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Formato de archivo para RPM Package Manager (originalmente Red Hat Package Manager), sistema de gestión de paquetes libre y de código abierto."
      },
      {
        "@language": "en",
        "@value": "File format for RPM Package Manager (originally Red Hat Package Manager), free and open-source package management system."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-rpm"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/RPM"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
