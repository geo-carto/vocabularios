    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Advanced Audio Coding"
      },
      {
        "@language": "en",
        "@value": "Advanced Audio Coding"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Advanced Audio Coding (AAC) es un estándar de codificación de audio para compresión de audio digital con pérdida. Diseñado como sucesor del formato MP3, AAC generalmente logra mayor calidad de sonido que MP3 a la misma tasa de bits."
      },
      {
        "@language": "en",
        "@value": "Advanced Audio Coding (AAC) is an audio coding standard for lossy digital audio compression. Designed to be the successor of the MP3 format, AAC generally achieves higher sound quality than MP3 at the same bit rate."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/audio/aac"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/AAC"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".adts; .ass; .aac; .loas"
      },
      {
        "@value": "audio/aac"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
