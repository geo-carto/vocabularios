    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Servicio OGC API Maps"
      },
      {
        "@language": "en",
        "@value": "OGC API Maps service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "OGC API – Maps es un estándar del Open Geospatial Consortium que define una API RESTful para acceder a representaciones renderizadas de mapas geoespaciales. Proporciona imágenes de mapas georreferenciados generados dinámicamente. Reemplaza al estándar Web Map Service (WMS) anterior, utilizando principios modernos de la web."
      },
      {
        "@language": "en",
        "@value": "OGC API – Maps is an Open Geospatial Consortium standard that defines a RESTful API for accessing rendered representations of geospatial maps. It provides dynamically generated georeferenced map images. It replaces the older Web Map Service (WMS) standard, using modern web principles."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "image/png; image/jpeg"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "OGC API Maps"
      },
      {
        "@language": "en",
        "@value": "OGC API Maps"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/dtd_xml",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "XML Document Type Definition (DTD)"
      },
      {
        "@language": "en",
        "@value": "XML Document Type Definition (DTD)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "XML – Extensible Markup Language – es un lenguaje de marcado que define un conjunto de reglas para codificar documentos en un formato legible tanto por humanos como por máquinas. DTD – document type definition – es un conjunto de declaraciones de marcado que definen un tipo de documento para un lenguaje de marcado de la familia SGML. Define los bloques de construcción legales de un documento XML. XML utiliza un subconjunto de SGML DTD."
      },
      {
        "@language": "en",
        "@value": "XML – Extensible Markup Language – is a markup language that defines a set of rules for encoding documents in a format that is both human-readable and machine-readable. DTD – document type definition – is a set of markup declarations that define a document type for an SGML-family markup language (SGML, XML, HTML). It defines the legal building blocks of an XML document, the document structure with a list of legal elements and attributes. XML uses a subset of SGML DTD."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml-dtd"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/DTD_XML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
