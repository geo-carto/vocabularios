    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Tape Archive"
      },
      {
        "@language": "en",
        "@value": "Tape Archive"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "TAR – tape archive – es una utilidad de software informático para recopilar muchos archivos en un único archivo de almacenamiento para distribución o copia de seguridad."
      },
      {
        "@language": "en",
        "@value": "TAR – tape archive – is a computer software utility for collecting many files into one archive file for distribution or backup purposes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-tar"
      },
