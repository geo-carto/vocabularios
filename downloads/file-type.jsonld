        "@language": "es",
        "@value": "Office Open XML Document"
      },
      {
        "@language": "en",
        "@value": "Office Open XML Document"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "DOCX es un estándar internacional de Office Open XML para documentos de oficina. Es utilizado por Microsoft Word y por un número creciente de aplicaciones de otros proveedores en programas de procesamiento de textos."
      },
      {
        "@language": "en",
        "@value": "DOCX is an Office Open XML international standard for Office documents. It is used by Microsoft Word and by a growing number of applications from other vendors in word processing programs."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/DOCX"
      }
    ],
