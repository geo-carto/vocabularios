      },
      {
        "@language": "en",
        "@value": "lzo compressed file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Archivo comprimido producido utilizando LZO (Lempel-Ziv-Oberhumer), un algoritmo de compresión de datos sin pérdida enfocado en la velocidad de descompresión."
      },
      {
        "@language": "en",
        "@value": "Compressed file produced using LZO (Lempel-Ziv-Oberhumer), a lossless data compression algorithm that is focused on decompression speed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
