    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Extensible Hypertext Markup Language"
      },
      {
        "@language": "en",
        "@value": "Extensible Hypertext Markup Language"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "XHTML es una familia de tipos de documentos actuales y futuros y módulos que reproducen, subconjuntan y extienden HTML 4. Los tipos de documento de la familia XHTML están basados en XML."
      },
      {
        "@language": "en",
        "@value": "XHTML is a family of current and future document types and modules that reproduce, subset and extend HTML 4. XHTML family document types are XML based."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xhtml+xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/XHTML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".html; .htm; .xhtml; .xht"
      },
      {
        "@value": "application/xhtml+xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "XHTML"
      },
      {
        "@language": "en",
        "@value": "XHTML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
