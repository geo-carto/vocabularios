    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "ARC es el formato de archivo de Internet Archive. Los archivos ARC son grandes archivos agregados. ARC GZ es ARC comprimido con GZIP."
      },
      {
        "@language": "en",
        "@value": "ARC is the archive file format of Internet Archive. ARC files are large aggregate files. ARC GZ is ARC compressed by GZIP."
      }
