        "@value": "Apache Arrow file"
      },
      {
        "@language": "en",
        "@value": "Apache Arrow file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Formato columnar de Apache que incluye una especificación de estructura de datos en memoria independiente del lenguaje, serialización de metadatos y un protocolo para serialización y transporte genérico de datos; el formato de archivo (acceso aleatorio) se utiliza para serializar un número fijo de lotes de registros."
      },
      {
        "@language": "en",
        "@value": "Apache columnar format that includes a language-agnostic in-memory data structure specification, metadata serialisation, and a protocol for serialisation and generic data transport; file (random access) format is used for serialising a fixed number of record batches"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.apache.arrow.file"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/ARROW_FILE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
