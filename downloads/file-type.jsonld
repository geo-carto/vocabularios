    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "OWL – Web Ontology Language – es una familia de lenguajes de representación del conocimiento para la creación de ontologías."
      },
      {
        "@language": "en",
        "@value": "OWL – Web Ontology Language – is a family of knowledge representation languages for authoring ontologies."
      }
    ],
