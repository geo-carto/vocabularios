      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Waveform Audio File"
      },
      {
        "@language": "en",
        "@value": "Waveform Audio File"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El formato de archivo de audio Waveform (WAV) se utiliza para almacenar archivos de audio digital sin comprimir. Es el formato de audio predeterminado para Windows, pero es soportado por la mayoría de los sistemas operativos."
      },
      {
        "@language": "en",
        "@value": "Waveform Audio File (WAV) is a format is used for storing uncompressed digital audio files. It is the default audio format for Windows but it is supported by most operating systems."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/audio/vnd.wave"
      },
