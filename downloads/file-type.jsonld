  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/xlsm",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Excel Macro-enabled Workbook"
      },
      {
        "@language": "en",
        "@value": "Excel Macro-enabled Workbook"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un libro de Excel habilitado para macros contiene hojas de cálculo de celdas organizadas por filas y columnas, así como macros incrustadas programadas en el lenguaje Visual Basic for Applications (VBA). Los archivos XLSM se guardan en el formato Open XML introducido en Microsoft Office 2007. Los archivos XLSM son archivos XLSX con macros habilitadas."
      },
      {
        "@language": "en",
        "@value": "An Excel Macro-enabled Workbook contains worksheets of cells arranged by rows and columns as well as embedded macros programmed in the Visual Basic for Applications (VBA) language. XLSM files are saved in the Open XML format introduced in Microsoft Office 2007. XLSM files are XLSX files, but with macros enabled."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.ms-excel.sheet.macroEnabled.12"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/XLSM"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".xlsm"
      },
      {
        "@value": "application/vnd.ms-excel.sheet.macroEnabled.12"
      }
    ],
