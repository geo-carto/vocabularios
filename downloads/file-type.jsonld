    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Akoma Ntoso file"
      },
      {
        "@language": "en",
        "@value": "Akoma Ntoso file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo AKN4EU es un archivo XML Akoma Ntoso que cumple con las especificaciones AKN4EU (Akoma Ntoso for European Union). Uno o más archivos AKN4EU pueden formar parte de un archivo ZIP AKN4EU. Un archivo AKN4EU especial llamado 'main.xml' es el punto de entrada de un archivo ZIP AKN4EU."
      },
      {
        "@language": "en",
        "@value": "AKN4EU file is an Akoma Ntoso XML file conforming to the AKN4EU (Akoma Ntoso for European Union) specifications. One or more AKN4EU files can be part of an AKN4EU ZIP file. A special AKN4EU file called ‘main.xml’ is the entry point of an AKN4EU ZIP file."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      },
