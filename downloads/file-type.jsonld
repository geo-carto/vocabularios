  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/wcs_srvc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Web Coverage Service"
      },
      {
        "@language": "en",
        "@value": "Web Coverage Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El estándar de interfaz Web Coverage Service (WCS) del Open Geospatial Consortium define la recuperación basada en web de coberturas, es decir, información geoespacial digital que representa fenómenos que varían en espacio y tiempo."
      },
      {
        "@language": "en",
        "@value": "The Open Geospatial Consortium Web Coverage Service Interface Standard (WCS) defines Web-based retrieval of coverages – that is, digital geospatial information representing space/time-varying phenomena."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/text/xml"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/multipart/related"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/WCS_SRVC"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "text/xml; multipart/related"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "WCS"
      },
      {
        "@language": "en",
        "@value": "WCS"
      }
    ],
