      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Enhanced Compressed Wavelet"
      },
      {
        "@language": "en",
        "@value": "Enhanced Compressed Wavelet"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "ECW – Enhanced Compressed Wavelet – es el tipo de medio que se utilizará para un formato propietario de compresión de imágenes por wavelets optimizado para imágenes aéreas y de satélite."
      },
      {
        "@language": "en",
        "@value": "ECW – Enhanced Compressed Wavelet – is the media type which shall be used for a proprietary wavelet compression image format optimized for aerial and satellite imagery."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-ecw"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/ECW"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
