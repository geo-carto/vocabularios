        "@language": "es",
        "@value": "ESRI Arc/Info interchange file"
      },
      {
        "@language": "en",
        "@value": "ESRI Arc/Info interchange file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "E00 es un formato de archivo de intercambio de ArcInfo. ArcInfo es un sistema de información geográfica completo producido por Esri."
      },
      {
        "@language": "en",
        "@value": "E00 is an ArcInfo interchange file format. ArcInfo is a full-featured geographic information system produced by Esri."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-e00"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/E00"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
