  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/mhtml",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "MIME HTML"
      },
      {
        "@language": "en",
        "@value": "MIME HTML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "MHTML – MIME Encapsulation of Aggregate HTML Documents – es un formato de archivo de página web utilizado para combinar en un único documento el código HTML y sus recursos complementarios que de otro modo estarían representados por enlaces externos (como imágenes, animaciones Flash, applets Java y archivos de audio). El contenido de un archivo MHTML se codifica como si fuera un mensaje de correo electrónico HTML."
      },
      {
        "@language": "en",
        "@value": "MHTML – MIME Encapsulation of Aggregate HTML Documents – is a web page archive format used to combine in a single document the HTML code and its companion resources that are otherwise represented by external links (such as images, Flash animations, Java applets and audio files). The content of an MHTML file is encoded as if it were an HTML e-mail message."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/multipart/related"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/MHTML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".mhtml; .mht"
      },
      {
        "@value": "multipart/related"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "MHTML"
      },
      {
        "@language": "en",
        "@value": "MHTML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/atom",
