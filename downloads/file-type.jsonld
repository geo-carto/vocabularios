      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/arcinfo_cov",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "ESRI ArcInfo Coverage"
      },
      {
        "@language": "en",
        "@value": "ESRI ArcInfo Coverage"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Una cobertura ESRI ArcInfo es un modelo de datos georrelacional que almacena datos vectoriales – contiene tanto los datos espaciales (ubicación) como los datos de atributos (descriptivos) para las características geográficas. Las coberturas utilizan un conjunto de clases de características para representar características geográficas. Una cobertura se almacena como un directorio dentro del cual cada clase de característica se almacena como un conjunto de archivos."
      },
      {
        "@language": "en",
        "@value": "An ESRI ArcInfo coverage is a georelational data model that stores vector data – it contains both the spatial (location) and attribute (descriptive) data for geographic features. Coverages use a set of feature classes to represent geographic features. Each feature class stores a set of points, lines (arcs), polygons, or annotation (text). Coverages can have topology, which determines the relationships between features. A coverage is stored as a directory within which each feature class is stored as a set of files."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/multipart/mixed"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/ARCINFO_COV"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "multipart/mixed"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ArcInfo coverage"
      },
      {
        "@language": "en",
        "@value": "ArcInfo coverage"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/mpeg4_avc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Moving Picture Experts Group 4 Advanced Video Coding"
      },
      {
        "@language": "en",
        "@value": "Moving Picture Experts Group 4 Advanced Video Coding"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "MPEG-4 – Moving Picture Experts Group – Parte 10, Advanced Video Coding, es un estándar de compresión de vídeo basado en compensación de movimiento orientado a bloques. Es uno de los formatos más utilizados para la grabación, compresión y distribución de contenido de vídeo."
      },
      {
        "@language": "en",
        "@value": "MPEG-4 – Moving Picture Experts Group – Part 10, Advanced Video Coding is a block-oriented motion-compensation-based video compression standard. It is one of the most commonly used formats for the recording, compression and distribution of video content."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/audio/mp4"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/video/mp4"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/application/mp4"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/MPEG4_AVC"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".mpeg; mpg; mp4"
      },
      {
        "@value": "audio/mp4; video/mp4; application/mp4"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "MPEG-4 AVC"
      },
      {
        "@language": "en",
        "@value": "MPEG-4 AVC"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/stylx",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Archivo de estilo ArcGIS Pro"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Pro Style File"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo STYLX es un archivo de estilo utilizado por ArcGIS Pro y ArcGIS Online de Esri. Contiene elementos de estilo como símbolos de mapa (puntos, líneas, polígonos), etiquetas, configuraciones de color, información de fuentes y patrones de relleno, utilizados para unificar y gestionar la presentación visual de los mapas. Está basado en el formato de base de datos SQLite y almacena símbolos y elementos de estilo en la base de datos."
      },
      {
        "@language": "en",
        "@value": "A STYLX file is a style file used by Esri's ArcGIS Pro and ArcGIS Online. It contains style elements such as map symbols (points, lines, polygons), labels, color settings, font information, and fill patterns, used to unify and manage the visual presentation of maps. It is based on the SQLite database format and stores symbols and style elements in the database."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
