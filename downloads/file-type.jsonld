    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Graphics Interchange Format"
      },
      {
        "@language": "en",
        "@value": "Graphics Interchange Format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "GIF – Graphics Interchange Format – es un formato de imagen de mapa de bits desarrollado por un equipo del proveedor de servicios de tablón de anuncios (BBS) CompuServe."
      },
      {
        "@language": "en",
        "@value": "GIF – Graphics Interchange Format – is a bitmap image format that was developed by a team at the bulletin board service (BBS) provider CompuServe."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/image/gif"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/GIF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".gif"
      },
      {
        "@value": "image/gif"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
