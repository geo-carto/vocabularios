  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/hdt",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Header Dictionary Triples"
      },
      {
        "@language": "en",
        "@value": "Header Dictionary Triples"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "HDT (Header, Dictionary, Triples) es una estructura de datos compacta y un formato de serialización binaria para RDF que mantiene grandes conjuntos de datos comprimidos para ahorrar espacio mientras mantiene operaciones de búsqueda y exploración sin descompresión previa."
      },
      {
        "@language": "en",
        "@value": "HDT (Header, Dictionary, Triples) is a compact data structure and binary serialization format for Resource Description Framework (RDF) that keeps big datasets compressed to save space while maintaining search and browse operations without prior decompression."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.hdt"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/HDT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".hdt"
      },
      {
        "@value": "application/vnd.hdt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "HDT"
      },
      {
        "@language": "en",
