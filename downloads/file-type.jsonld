    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "XLS es un formato de archivo binario propietario utilizado para hojas de cálculo de Microsoft Excel con funciones de cálculo, herramientas de gráficos, tablas dinámicas y un lenguaje de programación de macros."
      },
      {
        "@language": "en",
        "@value": "XLS is a proprietary binary file format used for Microsoft Excel spreadsheet which features calculation, graphing tools, pivot tables and a macro programming language."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
