        "@language": "es",
        "@value": "Resource Description Framework XML syntax"
      },
      {
        "@language": "en",
        "@value": "Resource Description Framework XML syntax"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "RDF XML es una sintaxis, definida por el W3C, para expresar (es decir, serializar) un grafo RDF como un documento XML."
      },
      {
        "@language": "en",
        "@value": "RDF XML is a syntax, defined by the W3C, to express (i.e. serialize) an RDF graph as an XML document."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/rdf+xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/RDF_XML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
