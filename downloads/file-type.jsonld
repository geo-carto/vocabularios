      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/csv",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Comma-Separated Values"
      },
      {
        "@language": "en",
        "@value": "Comma-Separated Values"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "CSV – comma-separated values (valores separados por comas) – almacenan datos tabulares (números y texto) en texto plano. Cada línea del archivo es un registro de datos. Cada registro consta de uno o más campos, separados por comas."
      },
      {
        "@language": "en",
        "@value": "CSV – comma-separated values – files store tabular data (numbers and text) in plain text. Each line of the file is a data record. Each record consists of one or more fields, separated by commas."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/text/csv"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/CSV"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".csv"
      },
      {
        "@value": "text/csv"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "CSV"
      },
      {
        "@language": "en",
