  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/xlsb",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Excel Binary Workbook"
      },
      {
        "@language": "en",
        "@value": "Excel Binary Workbook"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo con la extensión XLSB es un archivo de libro de Excel binario. Almacenan información en formato binario en lugar de XML como la mayoría de los otros archivos de Excel (como XLSX). Dado que los archivos XLSB son binarios, se pueden leer y escribir mucho más rápido, lo que los hace extremadamente útiles para hojas de cálculo muy grandes."
      },
      {
        "@language": "en",
        "@value": "A file with the XLSB file extension is an Excel Binary Workbook file. They store information in binary format instead of XML like with most other Excel files (like XLSX). Since XLSB files are binary, they can be read from and written to much faster, making them extremely useful for very large spreadsheets."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.ms-excel.sheet.binary.macroEnabled.12"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/XLSB"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".xlsb"
      },
      {
        "@value": "application/vnd.ms-excel.sheet.binary.macroEnabled.12"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "XLSB"
      },
      {
        "@language": "en",
        "@value": "XLSB"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
