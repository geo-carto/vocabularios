  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/ovf",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Open Virtualization Format"
      },
      {
        "@language": "en",
        "@value": "Open Virtualization Format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "OVF – Open Virtualization Format – es un estándar abierto para empaquetar y distribuir appliances virtuales o, de forma más general, software para ejecutar en máquinas virtuales."
      },
      {
        "@language": "en",
        "@value": "OVF – Open Virtualization Format – is an open standard for packaging and distributing virtual appliances or more generally software to be run in virtual machines."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
