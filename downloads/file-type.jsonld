    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El archivo rasterizado MapInfo TAB es el tipo de medio que se utilizará para el formato MapInfo Raster TAB. Este tipo de medio está incompleto ya que carece de una referencia a la especificación del formato."
      },
      {
        "@language": "en",
        "@value": "MapInfo TAB raster file is the media type which shall be used for the MapInfo Raster TAB format. This media type is incomplete as it lacks a reference to the specification of the format."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
