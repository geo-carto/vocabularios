        "@language": "es",
        "@value": "OpenDocument Presentation"
      },
      {
        "@language": "en",
        "@value": "OpenDocument Presentation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "ODP es un formato de archivo OpenDocument para presentaciones. OpenDocument fue desarrollado con el objetivo de proporcionar una especificación de formato de archivo abierto basado en XML para aplicaciones de oficina."
      },
      {
        "@language": "en",
        "@value": "ODP is an OpenDocument file format for presentations. OpenDocument was developed with the aim of providing an open, XML-based file format specification for office applications."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.presentation"
