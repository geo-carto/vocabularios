        "@language": "es",
        "@value": "Open Document Text"
      },
      {
        "@language": "en",
        "@value": "Open Document Text"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "ODT es el formato de archivo de procesamiento de textos de OpenDocument, un estándar abierto para documentos electrónicos."
      },
      {
        "@language": "en",
        "@value": "ODT is the word processing file format of OpenDocument, an open standard for electronic documents."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.text"
