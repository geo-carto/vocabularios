      {
        "@language": "en",
        "@value": "Mbox"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "MBOX es un término genérico para una familia de formatos de archivo relacionados utilizados para almacenar colecciones de mensajes de correo electrónico. Todos los mensajes en un buzón mbox se concatenan y almacenan como texto plano en un único archivo."
      },
      {
        "@language": "en",
        "@value": "MBOX is a generic term for a family of related file formats used for holding collections of email messages. All messages in an mbox mailbox are concatenated and stored as plain text in a single file."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
