        "@value": "Resource Description Framework in Attributes"
      },
      {
        "@language": "en",
        "@value": "Resource Description Framework in Attributes"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "RDFa es una técnica que proporciona un conjunto de atributos de marcado para aumentar la información visual en la Web con indicaciones legibles por máquinas."
      },
      {
        "@language": "en",
        "@value": "RDFa is a technique that provides a set of markup attributes to augment the visual information on the Web with machine-readable hints."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/rdfa"
      },
      {
