  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/tmx",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Translation Memory eXchange"
      },
      {
        "@language": "en",
        "@value": "Translation Memory eXchange"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "TMX – Translation Memory eXchange – es una especificación XML para el intercambio de datos de memoria de traducción entre herramientas de traducción asistida por ordenador y de localización con poca o ninguna pérdida de datos críticos."
      },
      {
        "@language": "en",
        "@value": "TMX – Translation Memory eXchange – is an XML specification for the exchange of translation memory data between computer-aided translation and localization tools with little or no loss of critical data."
      }
    ],
