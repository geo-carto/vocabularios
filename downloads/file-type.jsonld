  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/sgml",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Standard Generalized Mark-up Language"
      },
      {
        "@language": "en",
        "@value": "Standard Generalized Mark-up Language"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "SGML – Standard Generalized Markup Language – es un estándar para definir lenguajes de marcado generalizados para documentos. El marcado generalizado se basa en dos postulados: el marcado debe ser declarativo y riguroso."
      },
      {
        "@language": "en",
        "@value": "SGML – Standard Generalized Markup Language – is a standard for defining generalized markup languages for documents. Generalized markup is based on two postulates: markup should be declarative and rigorous."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/text/sgml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/SGML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".sgm; .sgml"
      },
      {
        "@value": "text/sgml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "SGML"
      },
      {
        "@language": "en",
        "@value": "SGML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/dwg",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "DWG file"
      },
      {
        "@language": "en",
        "@value": "DWG file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo DWG es un dibujo 2D o 3D creado con Autodesk AutoCAD, un programa CAD profesional. Contiene datos de imagen vectorial y metadatos que AutoCAD y otras aplicaciones CAD utilizan para cargar un dibujo. Los archivos DWG están relacionados con los archivos .DXF, que son versiones ASCII de los archivos DWG."
      },
      {
        "@language": "en",
        "@value": "A DWG file is a 2D or 3D drawing created with Autodesk AutoCAD, a professional CAD program. It contains vector image data and metadata that AutoCAD and other CAD applications use to load a drawing. DWG files are related to .DXF files, which are ASCII versions of DWG files."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/image/vnd.dwg"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/application/dwg"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/DWG"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".dwg"
      },
      {
        "@value": "image/vnd.dwg; application/dwg"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "DWG"
      },
      {
        "@language": "en",
        "@value": "DWG"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/gpkg",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "OGC GeoPackage"
      },
      {
        "@language": "en",
        "@value": "OGC GeoPackage"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un OGC GeoPackage es un formato abierto, basado en estándares, independiente de la plataforma, portátil, autodescriptivo y compacto para la transferencia de información geoespacial. Se implementa como un contenedor de base de datos SQLite."
      },
      {
        "@language": "en",
        "@value": "An OGC GeoPackage is an open, standards-based, platform-independent, portable, self-describing, compact format for transferring geospatial information. It is implemented as a SQLite database container."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/geopackage+sqlite3"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/GPKG"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
