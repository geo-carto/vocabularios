      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/rdf",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Resource Description Framework (RDF)"
      },
      {
        "@language": "en",
        "@value": "Resource Description Framework (RDF)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "RDF – Resource Description Framework – es un modelo estándar para el intercambio de datos en la Web. RDF tiene características que facilitan la fusión de datos. RDF extiende la estructura de enlaces de la Web para usar URIs para nombrar la relación entre cosas así como los dos extremos del enlace (esto se conoce generalmente como un 'triple'). Usando este modelo simple, permite mezclar, exponer y compartir datos estructurados y semiestructurados entre diferentes aplicaciones."
      },
      {
        "@language": "en",
        "@value": "RDF – Resource Description Framework – is a standard model for data interchange on the Web. RDF has features that facilitate data merging. RDF extends the linking structure of the Web to use URIs to name the relationship between things as well as the two ends of the link (this is usually referred to as a ‘triple’). Using this simple model, it allows structured and semi-structured data to be mixed, exposed and shared across different applications. This linking structure forms a directed, labeled graph, where the edges represent the named link between two resources, represented by the graph nodes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/rdf+xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/RDF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".rdf"
      },
      {
        "@value": "application/rdf+xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "RDF"
      },
      {
        "@language": "en",
        "@value": "RDF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/py",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Script Python"
      },
      {
        "@language": "en",
        "@value": "Python Script"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo PY es un archivo de código fuente escrito en el lenguaje de programación Python. Python es un lenguaje de programación interpretado, de alto nivel y de propósito general. Los archivos Python contienen código fuente que puede ejecutarse directamente por el intérprete de Python."
      },
      {
        "@language": "en",
        "@value": "A PY file is a source code file written in the Python programming language. Python is an interpreted, high-level, general-purpose programming language. Python files contain source code that can be executed directly by the Python interpreter."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".py; .pyw"
      },
      {
        "@value": "text/x-python"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "PY"
      },
      {
        "@language": "en",
        "@value": "PY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/lyrx",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Archivo de capa ArcGIS Pro"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Pro Layer File"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo LYRX es un archivo de capa de ArcGIS Pro que almacena la ruta a los datos de origen así como propiedades de visualización de la capa, incluyendo simbología, etiquetado, definiciones de consulta y otros ajustes de representación. Es un archivo en formato JSON utilizado exclusivamente por ArcGIS Pro, reemplazando al formato binario .lyr de ArcMap."
      },
      {
        "@language": "en",
        "@value": "A LYRX file is an ArcGIS Pro layer file that stores the path to the source data as well as display properties of the layer, including symbology, labeling, query definitions, and other rendering settings. It is a JSON format file used exclusively by ArcGIS Pro, replacing the binary .lyr format from ArcMap."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/json"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".lyrx"
      },
      {
        "@value": "application/json"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "LYRX"
      },
      {
        "@language": "en",
        "@value": "LYRX"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/pdfua",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "PDF/Universal Accessibility"
      },
      {
        "@language": "en",
        "@value": "PDF/Universal Accessibility"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "PDF/UA (PDF/Universal Accessibility), formalmente ISO 14289, es un estándar de la Organización Internacional de Normalización (ISO) para tecnología PDF accesible. Es una especificación técnica destinada a desarrolladores que implementan software de escritura y procesamiento de PDF; PDF/UA proporciona términos y requisitos definitivos para la accesibilidad en documentos y aplicaciones PDF. Para aquellos equipados con software apropiado, la conformidad con PDF/UA garantiza la accesibilidad para personas con discapacidades que utilizan tecnología de asistencia."
      },
      {
        "@language": "en",
        "@value": "PDF/UA (PDF/Universal Accessibility), formally ISO 14289, is an International Organization for Standardization (ISO) standard for accessible PDF technology. A technical specification intended for developers implementing PDF writing and processing software, PDF/UA provides definitive terms and requirements for accessibility in PDF documents and applications. For those equipped with appropriate software, conformance with PDF/UA ensures accessibility for people with disabilities who use assistive technology such as screen readers, screen magnifiers, joysticks and other technologies to navigate and read electronic content."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/pdf"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/PDFUA"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".pdf"
      },
      {
        "@value": "application/pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "PDF/UA"
      },
      {
        "@language": "en",
        "@value": "PDF/UA"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/gdb",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Environmental Systems Research Institute File Geodatabase"
      },
      {
        "@language": "en",
        "@value": "Environmental Systems Research Institute File Geodatabase"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "GDB es un formato de geodatabase basado en archivos de Esri, almacenado como carpetas en un sistema de archivos. Se utilizará para geodatabases de archivo de Esri. El archivo es un archivo zip que contiene el directorio gdb."
      },
      {
        "@language": "en",
        "@value": "GDB is an Esri's file-based geodatabase format, stored as folders in a file system. It shall be used for Esri file geodatabases. The file is a zip archive that contains the gdb directory."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-filegdb"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/GDB"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".gdb"
      },
      {
        "@value": "application/x-filegdb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Esri File Geodatabase"
      },
      {
        "@language": "en",
        "@value": "Esri File Geodatabase"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/xyz_tiles",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Teselas XYZ"
      },
      {
        "@language": "en",
        "@value": "Slippy Map Tiles"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "XYZ Tiles (también conocido como Slippy Map Tiles) es un esquema de teselado de mapas web donde las teselas rasterizadas se organizan según su coordenada de zoom (z), columna (x) y fila (y). Es el esquema de teselado más ampliamente utilizado en cartografía web, popularizado por OpenStreetMap y Google Maps."
      },
      {
        "@language": "en",
        "@value": "XYZ Tiles (also known as Slippy Map Tiles) is a web map tiling scheme where raster tiles are organized by their zoom coordinate (z), column (x), and row (y). It is the most widely used tiling scheme in web mapping, popularized by OpenStreetMap and Google Maps."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "image/png; image/jpeg"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "XYZ Tiles"
      },
      {
        "@language": "en",
        "@value": "XYZ Tiles"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/mdb",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Microsoft Access Database"
      },
      {
        "@language": "en",
        "@value": "Microsoft Access Database"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "MDB – Microsoft Database – es un formato de archivo propietario utilizado por las versiones 2003 y anteriores de Microsoft Access. Microsoft Access es un sistema de gestión de bases de datos."
      },
      {
        "@language": "en",
        "@value": "MDB – Microsoft Database – is a proprietary file format used by 2003 and earlier versions of Microsoft Access. Microsoft Access is a database management system."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.ms-access"
      },
