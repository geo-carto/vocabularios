  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/rdf_n_quads",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Resource Description Framework N-Quads"
      },
      {
        "@language": "en",
        "@value": "Resource Description Framework N-Quads"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "N-Quads es un formato basado en líneas, de texto plano, para codificar un conjunto de datos RDF. Las declaraciones N-Quads son una secuencia de términos RDF que representan el sujeto, predicado, objeto y etiqueta de grafo de una Triple RDF y el grafo del que forma parte en un conjunto de datos."
      },
      {
        "@language": "en",
        "@value": "N-Quads is a line-based, plain text format for encoding an RDF dataset. N-quads statements are a sequence of RDF terms representing the subject, predicate, object and graph label of an RDF Triple and the graph it is part of in a dataset."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/n-quads"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/RDF_N_QUADS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".nq"
      },
      {
        "@value": "application/n-quads"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "RDF N-Quads"
      },
      {
        "@language": "en",
        "@value": "RDF N-Quads"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
