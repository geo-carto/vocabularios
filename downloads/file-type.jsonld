  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/mvt",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Tesela Vectorial de Mapbox"
      },
      {
        "@language": "en",
        "@value": "Mapbox Vector Tile"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Mapbox Vector Tile (MVT) es una especificación de código abierto para codificar datos geoespaciales vectoriales teselados. Utiliza Protocol Buffers de Google como formato de codificación binaria. Las teselas vectoriales permiten la representación eficiente de datos geoespaciales en clientes web con estilizado del lado del cliente."
      },
      {
        "@language": "en",
        "@value": "Mapbox Vector Tile (MVT) is an open-source specification for encoding tiled geospatial vector data. It uses Google Protocol Buffers as the binary encoding format. Vector tiles enable efficient representation of geospatial data in web clients with client-side styling."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.mapbox-vector-tile"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".mvt; .pbf"
      },
      {
        "@value": "application/vnd.mapbox-vector-tile"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "MVT"
      },
      {
        "@language": "en",
        "@value": "MVT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
