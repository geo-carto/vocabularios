      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "eBook standard of the International Digital Publishing Forum (IDPF)"
      },
      {
        "@language": "en",
        "@value": "eBook standard of the International Digital Publishing Forum (IDPF)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "EPUB – electronic publication – es un formato de archivo de libro electrónico que puede descargarse y leerse en dispositivos como teléfonos inteligentes, tabletas, ordenadores o lectores electrónicos. Es un estándar técnico publicado por el International Digital Publishing Forum (IDPF)."
      },
      {
        "@language": "en",
        "@value": "EPUB – electronic publication – is an e-book file format that can be downloaded and read on devices like smartphones, tablets, computers or e-readers. It is a technical standard published by the International Digital Publishing Forum (IDPF)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/epub+zip"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/EPUB"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".epub"
      },
      {
        "@value": "application/epub+zip"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
