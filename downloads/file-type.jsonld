  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/fgb",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Formato FlatGeobuf"
      },
      {
        "@language": "en",
        "@value": "FlatGeobuf format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "FlatGeobuf es un formato de archivo binario para datos vectoriales geográficos (puntos, líneas, polígonos) basado en FlatBuffers. Está diseñado para ser adecuado para grandes volúmenes de datos estáticos, significativamente más rápido que los formatos heredados, sin limitaciones de tamaño y apto para streaming y acceso aleatorio. Soporta opcionalmente un índice espacial R-Tree de Hilbert empaquetado."
      },
      {
        "@language": "en",
        "@value": "FlatGeobuf is a binary file format for geographic vector data (points, lines, polygons) based on FlatBuffers. It is designed to be suitable for large volumes of static data, significantly faster than legacy formats, without size limitations, and suitable for streaming and random access. It optionally supports a packed Hilbert R-Tree spatial index."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".fgb"
      },
      {
        "@value": "application/flatgeobuf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "FlatGeobuf"
      },
      {
        "@language": "en",
        "@value": "FlatGeobuf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
