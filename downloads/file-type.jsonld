      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "OpenDocument Format"
      },
      {
        "@language": "en",
        "@value": "OpenDocument Format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "ODF – Open Document Format for Office Applications, también conocido como OpenDocument – es un formato de archivo basado en XML para hojas de cálculo, gráficos, presentaciones y documentos de procesamiento de textos. Fue desarrollado con el objetivo de proporcionar una especificación de formato de archivo abierto basado en XML para aplicaciones de oficina."
      },
      {
        "@language": "en",
        "@value": "ODF – Open Document Format for Office Applications, also known as OpenDocument – is an XML-based file format for spreadsheets, charts, presentations and word processing documents. It was developed with the aim of providing an open, XML-based file format specification for office applications."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/octet-stream"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.formula"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/ODF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
