  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/copc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Nube de Puntos Optimizada para la Nube"
      },
      {
        "@language": "en",
        "@value": "Cloud Optimized Point Cloud"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Cloud Optimized Point Cloud (COPC) es un formato de archivo que almacena datos de nubes de puntos organizados en un octree agrupado dentro de un archivo LAZ 1.4. Permite el acceso eficiente por streaming a subconjuntos espaciales y de resolución de grandes conjuntos de datos de nubes de puntos a través de solicitudes HTTP range, de forma análoga a Cloud Optimized GeoTIFF (COG) para datos rasterizados. Es retrocompatible con cualquier lector LAZ 1.4."
      },
      {
        "@language": "en",
        "@value": "Cloud Optimized Point Cloud (COPC) is a file format that stores point cloud data organized in a clustered octree within a LAZ 1.4 file. It enables efficient streaming access to spatial and resolution subsets of large point cloud datasets through HTTP range requests, analogous to Cloud Optimized GeoTIFF (COG) for raster data. It is backward compatible with any LAZ 1.4 reader."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-laz"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".copc.laz"
      },
      {
        "@value": "application/x-laz"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "COPC"
      },
      {
        "@language": "en",
        "@value": "COPC"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
