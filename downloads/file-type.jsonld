    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Proyecto QGIS comprimido"
      },
      {
        "@language": "en",
        "@value": "Compressed QGIS project"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo QGZ es un proyecto de QGIS comprimido. Es un archivo ZIP que contiene el archivo de proyecto QGS y cualquier recurso auxiliar (como datos de fuentes, estilos). QGZ es el formato de proyecto predeterminado a partir de QGIS 3.2, reemplazando al archivo QGS sin comprimir."
      },
      {
        "@language": "en",
        "@value": "A QGZ file is a compressed QGIS project. It is a ZIP archive containing the QGS project file and any auxiliary resources (such as data sources, styles). QGZ is the default project format starting from QGIS 3.2, replacing the uncompressed QGS file."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/zip"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".qgz"
      },
      {
        "@value": "application/zip"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "QGZ"
      },
      {
        "@language": "en",
        "@value": "QGZ"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
