  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/sparqlq",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "SPARQL Query"
      },
      {
        "@language": "en",
        "@value": "SPARQL Query"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "SPARQL – acrónimo recursivo de SPARQL Protocol and RDF Query Language – es un lenguaje de consulta RDF, es decir, un lenguaje de consulta semántico para bases de datos, capaz de recuperar y manipular datos almacenados en formato RDF. Es reconocido como una de las tecnologías clave de la web semántica."
      },
      {
        "@language": "en",
        "@value": "SPARQL – a recursive acronym for SPARQL Protocol and RDF Query Language – is an RDF query language, that is, a semantic query language for databases, able to retrieve and manipulate data stored in Resource Description Framework (RDF) format. It is recognised as one of the key technologies of the semantic web."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/sparql-query"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/SPARQLQ"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".sparqlq; .rq"
      },
      {
        "@value": "application/sparql-query"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "SPARQL"
      },
      {
        "@language": "en",
        "@value": "SPARQL"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/rdf_trix",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Triples in XML"
      },
      {
        "@language": "en",
        "@value": "Triples in XML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "TriX (Triples in XML) es un formato de serialización para grafos RDF (Resource Description Framework). Es un formato XML para serializar grafos con nombre (Named Graphs) y conjuntos de datos RDF que ofrece una alternativa compacta y legible a la sintaxis RDF/XML basada en XML."
      },
      {
        "@language": "en",
        "@value": "TriX (Triples in XML) is a serialization format for RDF (Resource Description Framework) graphs. It is an XML format for serializing Named Graphs and RDF Datasets which offers a compact and readable alternative to the XML-based RDF/XML syntax."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/RDF_TRIX"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".xml; .trix"
      },
      {
        "@value": "application/xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "RDF TriX"
      },
      {
        "@language": "en",
        "@value": "RDF TriX"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/cog",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "GeoTIFF Optimizado para la Nube"
      },
      {
        "@language": "en",
        "@value": "Cloud Optimized GeoTIFF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Cloud Optimized GeoTIFF (COG) es una variante del formato de imagen GeoTIFF que especifica una organización interna particular de los datos para permitir el acceso optimizado (subconjuntos o agregados) a través de una red. Se basa en dos características del formato TIFF v6 (teselas y subarchivos de resolución reducida), claves GeoTIFF para georreferenciación y solicitudes HTTP range para la descarga eficiente de partes de datos de imágenes y coberturas de cuadrícula en la web."
      },
      {
        "@language": "en",
        "@value": "Cloud Optimized GeoTIFF (COG) is a variant of the GeoTIFF image format that specifies a particular layout of internal data to allow for optimized (subsetted or aggregated) access over a network. It relies on two characteristics of the TIFF v6 format (tiles and reduced resolution subfiles), GeoTIFF keys for georeference, and HTTP range requests for efficient downloading of parts of imagery and grid coverage data on the web."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/image/tiff"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".tiff; .tif"
      },
      {
        "@value": "image/tiff"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "COG"
      },
      {
        "@language": "en",
        "@value": "COG"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
