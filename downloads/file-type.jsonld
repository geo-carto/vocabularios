    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Apache Arrow stream"
      },
      {
        "@language": "en",
        "@value": "Apache Arrow stream"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Formato columnar de Apache que incluye una especificación de estructura de datos en memoria independiente del lenguaje, serialización de metadatos y un protocolo para serialización y transporte genérico de datos; el formato de flujo se utiliza para enviar una secuencia de longitud arbitraria de lotes de registros."
      },
      {
        "@language": "en",
        "@value": "Apache columnar format that includes a language-agnostic in-memory data structure specification, metadata serialisation, and a protocol for serialisation and generic data transport; streaming format is used for sending an arbitrary length sequence of record batches"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.apache.arrow.stream"
      },
      {
