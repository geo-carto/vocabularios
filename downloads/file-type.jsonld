  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/tiff",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Tagged Image Format File"
      },
      {
        "@language": "en",
        "@value": "Tagged Image Format File"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "TIFF – Tagged Image File Format – es un formato de archivo informático para almacenar imágenes de gráficos rasterizados, popular entre artistas gráficos, la industria editorial y los fotógrafos. TIFF es ampliamente soportado por aplicaciones de escaneo, fax, procesamiento de textos, reconocimiento óptico de caracteres, manipulación de imágenes, autoedición y maquetación. El formato fue creado por Aldus Corporation para su uso en autoedición."
      },
      {
        "@language": "en",
        "@value": "TIFF – Tagged Image File Format – is a computer file format for storing raster graphics images, popular among graphic artists, the publishing industry and photographers. TIFF is widely supported by scanning, faxing, word processing, optical character recognition, image manipulation, desktop publishing and page-layout applications. The format was created by Aldus Corporation for use in desktop publishing."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/image/tiff"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/TIFF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".tif; .tiff"
      },
      {
        "@value": "image/tiff"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "TIFF"
      },
      {
        "@language": "en",
        "@value": "TIFF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
