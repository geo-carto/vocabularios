    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Journal Article Tag Suite"
      },
      {
        "@language": "en",
        "@value": "Journal Article Tag Suite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "JATS – Journal Article Tag Suite – es un formato XML utilizado para describir literatura científica publicada en línea. Es un estándar técnico desarrollado por la National Information Standards Organization (NISO)."
      },
      {
        "@language": "en",
        "@value": "JATS – Journal Article Tag Suite – is an XML format used to describe scientific literature published online. It is a technical standard developed by the National Information Standards Organization (NISO)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/JATS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
