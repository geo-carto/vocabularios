  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/mpeg2",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Moving Picture Experts Group 2"
      },
      {
        "@language": "en",
        "@value": "Moving Picture Experts Group 2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "MPEG-2 – Moving Picture Experts Group – es un estándar para la codificación genérica de imágenes en movimiento e información de audio asociada. Describe una combinación de métodos de compresión de vídeo y audio con pérdida que permiten el almacenamiento y la transmisión de películas utilizando los medios de almacenamiento y el ancho de banda de transmisión disponibles actualmente."
      },
      {
        "@language": "en",
        "@value": "MPEG-2 – Moving Picture Experts Group – is a standard for the generic coding of moving pictures and associated audio information. It describes a combination of lossy video compression and lossy audio data compression methods, which permit storage and transmission of movies using currently available storage media and transmission bandwidth."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/audio/mpeg"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/video/mpeg"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/MPEG2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".mpeg; mpg; mp3; mp2; m2v"
      },
      {
        "@value": "audio/mpeg; video/mpeg"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "MPEG-2"
      },
      {
        "@language": "en",
        "@value": "MPEG-2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/apk",
