  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/aprx",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Proyecto ArcGIS Pro"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Pro Project"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo APRX es un proyecto de ArcGIS Pro. Almacena la información del proyecto, incluyendo mapas, diseños de mapa, conexiones a datos, herramientas de geoprocesamiento y otros recursos utilizados en el proyecto. Es el formato de archivo de proyecto principal de la aplicación de escritorio ArcGIS Pro de Esri."
      },
      {
        "@language": "en",
        "@value": "An APRX file is an ArcGIS Pro project. It stores the project information, including maps, map layouts, data connections, geoprocessing tools, and other resources used in the project. It is the main project file format of Esri's ArcGIS Pro desktop application."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/octet-stream"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".aprx"
      },
      {
        "@value": "application/octet-stream"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "APRX"
      },
      {
        "@language": "en",
        "@value": "APRX"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/deb",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Debian package"
      },
      {
        "@language": "en",
        "@value": "Debian package"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El paquete Debian es un archivo estándar Unix ar que incluye dos archivos tar. Un archivo contiene la información de control y otro contiene los datos instalables."
      },
      {
        "@language": "en",
        "@value": "Debian package is a standard Unix ar archive that includes two tar archives. One archive holds the control information and another contains the installable data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.debian.binary-package"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/DEB"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".deb"
      },
      {
        "@value": "application/vnd.debian.binary-package"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "deb"
      },
      {
        "@language": "en",
        "@value": "deb"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/bzip2",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "bzip2 compressed file"
      },
      {
        "@language": "en",
        "@value": "bzip2 compressed file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un formato de compresión de código abierto, libre de patentes y regalías. El algoritmo de compresión es una transformada de Burrows-Wheeler seguida de una transformada de movimiento al frente y finalmente una codificación Huffman."
      },
      {
        "@language": "en",
        "@value": "An open source, patent- and royalty-free compression format. The compression algorithm is a Burrows-Wheeler transform followed by a move-to-front transform and finally Huffman coding."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-bzip2"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/BZIP2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".bz2"
      },
      {
        "@value": "application/x-bzip2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "bzip2"
      },
      {
        "@language": "en",
        "@value": "bzip2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
