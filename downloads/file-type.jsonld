        "@language": "es",
        "@value": "Web Map Tile Service"
      },
      {
        "@language": "en",
        "@value": "Web Map Tile Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Estándar del Open Geospatial Consortium para servir mapas digitales utilizando teselas de imagen predefinidas."
      },
      {
        "@language": "en",
