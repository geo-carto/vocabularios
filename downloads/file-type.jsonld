        "@value": "MPEG-1/MPEG-2 Audio Layer III"
      },
      {
        "@language": "en",
        "@value": "MPEG-1/MPEG-2 Audio Layer III"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "MP3 es un formato de audio digital. Utiliza compresión con pérdida para reducir los datos sin perder calidad de audio."
      },
      {
        "@language": "en",
        "@value": "An MP3 is a format for digital audio. It uses the lossy compression to reduce the data without losing audio quality."
      }
