      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Broadcast Wave File"
      },
      {
        "@language": "en",
        "@value": "Broadcast Wave File"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "BWF – Broadcast Wave Format – es una extensión del formato de audio Microsoft WAV y es el formato de grabación de la mayoría de grabadoras digitales no lineales basadas en archivos utilizadas para la producción cinematográfica, radiofónica y televisiva. El propósito de este formato es la adición de metadatos para facilitar el intercambio fluido de datos de sonido entre diferentes plataformas y aplicaciones."
      },
      {
        "@language": "en",
        "@value": "BWF – Broadcast Wave Format – is an extension of the Microsoft WAV audio format and is the recording format of most file-based non-linear digital recorders used for motion picture, radio and television production. The purpose of this file format is the addition of metadata to facilitate the seamless exchange of sound data between different computer platforms and applications."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/audio/vnd.wave"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/BWF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".wav; .bwf"
      },
      {
        "@value": "audio/vnd.wave"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "BWF"
      },
      {
        "@language": "en",
        "@value": "BWF"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/xhtml",
