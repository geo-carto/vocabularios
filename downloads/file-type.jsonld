        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "MapInfo TAB es el tipo de medio que se utilizará para el formato MapInfo TAB. El archivo es un archivo zip que contiene al menos los archivos tab, dat, map e id."
      },
      {
        "@language": "en",
        "@value": "MapInfo TAB is the media type which shall be used for the MapInfo TAB format. The file is a zip archive that contains at least the tab, dat, map and id files."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-tab"
      },
      {
