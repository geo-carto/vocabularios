      {
        "@value": ".xml; .atom"
      },
      {
        "@value": "application/atom+xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Atom Feed"
      },
      {
        "@language": "en",
