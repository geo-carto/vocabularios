  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/gtfs",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "General Transit Feed Specification"
      },
      {
        "@language": "en",
        "@value": "General Transit Feed Specification"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La General Transit Feed Specification (GTFS) es una especificación de datos que permite a las agencias de transporte público publicar sus datos de tránsito en un formato que puede ser consumido por una amplia variedad de aplicaciones de software. GTFS se divide en un componente de horarios que contiene información de horarios, tarifas y geografía del tránsito, y un componente en tiempo real que contiene predicciones de llegada, posiciones de vehículos y avisos de servicio."
      },
      {
        "@language": "en",
        "@value": "The General Transit Feed Specification (GTFS) is a data specification that allows public transit agencies to publish their transit data in a format that can be consumed by a wide variety of software applications. GTFS is split into a schedule component that contains schedule, fare, and geographic transit information and a real-time component that contains arrival predictions, vehicle positions and service advisories."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/zip"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/GTFS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".zip"
      },
      {
        "@value": "application/zip"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "GTFS"
      },
      {
        "@language": "en",
        "@value": "GTFS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/ogcapi_coverages",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Servicio OGC API Coverages"
      },
      {
        "@language": "en",
        "@value": "OGC API Coverages service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "OGC API – Coverages es un estándar del Open Geospatial Consortium que define una API RESTful para acceder a coberturas, es decir, información geoespacial digital que representa fenómenos que varían en el espacio y el tiempo (datos rasterizados). Reemplaza al estándar Web Coverage Service (WCS) anterior."
      },
      {
        "@language": "en",
        "@value": "OGC API – Coverages is an Open Geospatial Consortium standard that defines a RESTful API for accessing coverages, i.e. digital geospatial information representing space/time-varying phenomena (raster data). It replaces the older Web Coverage Service (WCS) standard."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "image/tiff; application/json"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "OGC API Coverages"
      },
      {
        "@language": "en",
        "@value": "OGC API Coverages"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/jpeg2000",
