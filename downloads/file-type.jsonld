  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/arcgis_img_srvc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Servicio de imágenes ArcGIS"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Image Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un servicio de imágenes (Image Service) de ArcGIS proporciona acceso a grandes colecciones de datos rasterizados e imágenes a través de la API REST de ArcGIS. Soporta el acceso a datos como teselas estáticas pregeneradas e imágenes generadas dinámicamente. Es adecuado para compartir imágenes de satélite, fotografía aérea, modelos digitales de elevación y otros datos rasterizados."
      },
      {
        "@language": "en",
        "@value": "An ArcGIS Image Service provides access to large collections of raster data and imagery through the ArcGIS REST API. It supports accessing data as pre-generated static tiles and dynamically generated images. It is suitable for sharing satellite imagery, aerial photography, digital elevation models, and other raster data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "arcgis_image_service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ArcGIS Image Service"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Image Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
