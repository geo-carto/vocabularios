      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "MXD – Map Exchange Document – es un formato de archivo en el que se pueden almacenar los mapas creados con el software ArcGIS."
      },
      {
        "@language": "en",
        "@value": "MXD – Map Exchange Document – is a file format in which the maps created from ArcGIS software can be stored."
