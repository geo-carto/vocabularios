  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/warc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Web Archive format"
      },
      {
        "@language": "en",
        "@value": "Web Archive format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "WARC es un formato de archivo web que especifica un método para combinar múltiples recursos digitales en un archivo agregado junto con información relacionada."
      },
      {
        "@language": "en",
        "@value": "WARC is a web archive format which specifies a method for combining multiple digital resources into an aggregate archive file together with related information."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/warc"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/WARC"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".warc"
      },
      {
        "@value": "application/warc"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "WARC"
      },
      {
        "@language": "en",
