      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Structured Query Language"
      },
      {
        "@language": "en",
        "@value": "Structured Query Language"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "SQL – Structured Query Language – es un lenguaje de dominio específico utilizado en programación y diseñado para gestionar datos almacenados en un sistema de gestión de bases de datos relacionales (RDBMS) o para el procesamiento de flujos en un sistema de gestión de flujos de datos relacionales (RDSMS)."
      },
      {
        "@language": "en",
        "@value": "SQL – Structured Query Language – is a domain-specific language used in programming and designed for managing data held in a relational database management system (RDBMS) or for stream processing in a relational data stream management system (RDSMS)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/sql"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/SQL"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".sql"
      },
      {
        "@value": "application/sql"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
