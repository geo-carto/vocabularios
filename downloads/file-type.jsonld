  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/ogcapi_features",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Servicio OGC API Features"
      },
      {
        "@language": "en",
        "@value": "OGC API Features service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "OGC API – Features es un estándar del Open Geospatial Consortium que define una API RESTful para consultar, crear, modificar y acceder a características geoespaciales en la web. Reemplaza al estándar Web Feature Service (WFS) anterior, utilizando principios modernos de la web como JSON, HTML y OpenAPI."
      },
      {
        "@language": "en",
        "@value": "OGC API – Features is an Open Geospatial Consortium standard that defines a RESTful API for querying, creating, modifying, and accessing geospatial features on the web. It replaces the older Web Feature Service (WFS) standard, using modern web principles such as JSON, HTML, and OpenAPI."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/geo+json"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "application/geo+json; text/html; application/xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "OGC API Features"
      },
      {
        "@language": "en",
        "@value": "OGC API Features"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/rdf_turtle",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Terse RDF Triple Language"
      },
      {
        "@language": "en",
        "@value": "Terse RDF Triple Language"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Turtle – Terse RDF Triple Language – es un formato para expresar datos en el modelo de datos RDF (Resource Description Framework) con una sintaxis similar a SPARQL. RDF, a su vez, representa información usando 'triples', cada uno de los cuales consta de un sujeto, un predicado y un objeto. Cada uno de esos elementos se expresa como una URI Web."
      },
      {
        "@language": "en",
        "@value": "Turtle – Terse RDF Triple Language – is a format for expressing data in the Resource Description Framework (RDF) data model with a syntax similar to SPARQL. RDF, in turn, represents information using ‘triples’, each of which consists of a subject, a predicate and an object. Each of those items is expressed as a Web URI."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/text/turtle"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".ttl"
      },
      {
        "@value": "text/turtle"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "RDF Turtle"
      },
      {
        "@language": "en",
        "@value": "RDF Turtle"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/rdf_xml",
    "@type": [
