        "@language": "es",
        "@value": "Joint Photographic Experts Group 2000"
      },
      {
        "@language": "en",
        "@value": "Joint Photographic Experts Group 2000"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "JPEG 2000 – Joint Photographic Experts Group 2000 – es un sistema de codificación de imágenes que utiliza técnicas de compresión de última generación basadas en tecnología wavelet."
      },
      {
        "@language": "en",
        "@value": "JPEG 2000 – Joint Photographic Experts Group 2000 – is an image coding system that uses state-of-the-art compression techniques based on wavelet technology."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
