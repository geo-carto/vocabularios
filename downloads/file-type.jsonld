        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Formalized Exchange of Electronic Publications (Formex), version 4"
      },
      {
        "@language": "en",
        "@value": "Formalized Exchange of Electronic Publications (Formex), version 4"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Formex describe el formato para el intercambio de datos entre la Oficina de Publicaciones y sus contratistas. En particular, define el marcado lógico para documentos publicados en las diferentes series del Diario Oficial de la Unión Europea. Formex V4 se basa en el estándar internacional XML."
      },
      {
        "@language": "en",
        "@value": "Formex describes the format for the exchange of data between the Publication Office and its contractors. In particular, it defines the logical markup for documents which are published in the different series of the Offical Journal of the European Union. Formex V4 is based on the international standard XML."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/FMX4"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
