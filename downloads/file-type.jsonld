      },
      {
        "@language": "en",
        "@value": "lzip compressed file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Archivo comprimido producido por lzip, una herramienta gratuita de línea de comandos para la compresión de datos que emplea el algoritmo LZMA (Lempel-Ziv-Markov chain algorithm)."
      },
      {
        "@language": "en",
        "@value": "Compressed file produced by lzip, free, command-line tool for the compression of data that employs the Lempel-Ziv-Markov chain algorithm (LZMA)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
