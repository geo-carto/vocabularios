      {
        "@value": ".ppsx"
      },
      {
        "@value": "application/vnd.openxmlformats-officedocument.presentationml.slideshow"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "PowerPoint PPSX"
      },
      {
        "@language": "en",
        "@value": "PowerPoint PPSX"
      }
    ],
