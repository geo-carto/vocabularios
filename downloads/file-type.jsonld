      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "PDF/X-1a es una especificación PDF que completa el intercambio utilizando datos CMYK y datos de impresión de colores directos."
      },
      {
        "@language": "en",
        "@value": "PDF/X-1a is a PDF specification which completes exchange using CMYK data and spots colour printing data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/pdf"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/PDFX1A"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
