        "@language": "es",
        "@value": "PDF printing format, Blind eXchange"
      },
      {
        "@language": "en",
        "@value": "PDF printing format, Blind eXchange"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "PDF/X es un subconjunto del estándar PDF. El propósito de PDF/X es facilitar el intercambio de gráficos, y por lo tanto tiene una serie de requisitos relacionados con la impresión que no se aplican a los archivos PDF estándar."
      },
      {
        "@language": "en",
        "@value": "PDF/X is a subset of the PDF standard. The purpose of PDF/X is to facilitate graphics exchange, and it therefore has a series of printing related requirements which do not apply to standard PDF files."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/pdf"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/PDFX"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
