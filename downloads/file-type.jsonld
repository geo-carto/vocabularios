      {
        "@language": "es",
        "@value": "BITS – Book Interchange Tag Suite – es la 'versión de libro' de Journal Article Tag Suite (JATS); un formato XML utilizado para describir libros publicados en línea. BITS proporciona un formato XML común en el que editores y archivistas pueden describir elementos de contenido textual y gráfico. Para facilitar la reutilización, BITS proporciona un conjunto de etiquetas adecuado para soportar intercambio, archivado, conversión de formato y publicación."
      },
      {
        "@language": "en",
        "@value": "BITS – Book Interchange Tag Suite – is the ‘book version’ of Journal Article Tag Suite (JATS); an XML format used to describe books published online. BITS provides a common XML format in which publishers and archivists can describe textual and graphical content elements. In order to facilitate the reusability, BITS makes a tag set adequate for supporting interchange, archiving, format-conversion and publishing."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/BITS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".xml"
      },
      {
        "@value": "application/xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "BITS XML"
      },
      {
        "@language": "en",
        "@value": "BITS XML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
