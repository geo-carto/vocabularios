        "@id": "https://www.iana.org/assignments/media-types/application/x-grid"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/GRID"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "application/x-esri-grid; application/x-grid"
      }
    ],
