  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/fmx3",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Formalized Exchange of Electronic Publications (Formex), version 3"
      },
      {
        "@language": "en",
        "@value": "Formalized Exchange of Electronic Publications (Formex), version 3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Formex describe el formato para el intercambio de datos entre la Oficina de Publicaciones y sus contratistas. En particular, define el marcado lógico para documentos publicados en las diferentes series del Diario Oficial de la Unión Europea. Formex 3 fue una versión anterior de Formex utilizada efectivamente."
      },
      {
        "@language": "en",
        "@value": "Formex describes the format for the exchange of data between the Publication Office and its contractors. In particular, it defines the logical markup for documents which are published in the different series of the Offical Journal of the European Union. Formex 3 was a previous version of Formex actually used."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/text/sgml"
      },
      {
