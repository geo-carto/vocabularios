  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/stl",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "StereoLithography"
      },
      {
        "@language": "en",
        "@value": "StereoLithography"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo StL ('StereoLithography') es una representación triangular de una geometría de superficie tridimensional. La superficie se divide lógicamente en una serie de pequeños triángulos (facetas). Cada faceta se describe mediante una dirección perpendicular y tres puntos que representan los vértices del triángulo. Estos datos son utilizados por un algoritmo de corte para determinar las secciones transversales de la forma tridimensional. El estándar StL incluye dos formatos de datos: ASCII y binario."
      },
      {
        "@language": "en",
        "@value": "An StL (‘StereoLithography’) file is a triangular representation of a 3-dimensional surface geometry. The surface is tessellated or broken down logically into a series of small triangles (facets). Each facet is described by a perpendicular direction and three points representing the vertices (corners) of the triangle. These data are used by a slicing algorithm to determine the cross sections of the 3-dimensional shape to be built by the fabber. The StL standard includes two data formats, ASCII and binary."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/model/x.stl-ascii"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/model/x.stl-binary"
      },
      {
        "@id": "https://www.iana.org/assignments/media-types/model/stl"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/STL"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".stl"
      },
      {
        "@value": "model/x.stl-ascii; model/x.stl-binary; model/stl"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "StL"
      },
      {
        "@language": "en",
        "@value": "StL"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
