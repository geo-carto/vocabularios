      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Akoma Ntoso ZIP archive"
      },
      {
        "@language": "en",
        "@value": "Akoma Ntoso ZIP archive"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Archivo ZIP que contiene una manifestación AKN4EU de un documento en una variante lingüística emitida en el proceso de toma de decisiones legales; debe contener al menos un archivo AKN4EU que comience con el prefijo 'main-', que constituye el punto de entrada, y puede contener otros archivos y subcarpetas asociados."
      },
      {
        "@language": "en",
        "@value": "ZIP archive containing an AKN4EU manifestation of a document in one linguistic variant issued in the legal decision-making process; it must contain at least an AKN4EU file starting with the prefix ‘main-’, which constitutes the entry point, and may contain other associated files and subfolders"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/zip"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/AKN4EU_LEG"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
