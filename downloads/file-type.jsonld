        "@language": "es",
        "@value": "Environmental Systems Research Institute binary grid"
      },
      {
        "@language": "en",
        "@value": "Environmental Systems Research Institute binary grid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Esri binary grid es una variación binaria propietaria de Esri grid, un formato de archivo SIG rasterizado desarrollado por Esri. También se conoce como ARC/INFO GRID o ARC GRID. Difiere de la otra variación de Esri grid, un formato ASCII no propietario."
      },
      {
        "@language": "en",
        "@value": "Esri binary grid is a proprietary binary variation of an Esri grid, a raster GIS file format developed by Esri. It is also known as an ARC/INFO GRID or ARC GRID. It differs from the other Esri grid variation, a non-proprietary ASCII format."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-esri-grid"
      },
