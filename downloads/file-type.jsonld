    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "RAR es un formato de archivo propietario que soporta compresión de datos, recuperación de errores y expansión de archivos."
      },
      {
        "@language": "en",
        "@value": "RAR is a proprietary archive file format that supports data compression, error recovery and file spanning."
      }
    ],
