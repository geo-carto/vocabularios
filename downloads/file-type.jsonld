      {
        "@value": ".tar.gz; .zip"
      },
      {
        "@value": "application/gzip; application/zip"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "DwC-A"
      },
      {
        "@language": "en",
        "@value": "DwC-A"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
