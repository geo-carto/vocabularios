  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/rss",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Really Simple Syndication"
      },
      {
        "@language": "en",
        "@value": "Really Simple Syndication"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "RSS – Rich Site Summary; originalmente RDF Site Summary; frecuentemente llamado Really Simple Syndication – es un tipo de fuente web que permite a los usuarios acceder a actualizaciones de contenido en línea en un formato estandarizado y legible por computadora. Los sitios web generalmente usan fuentes RSS para publicar información actualizada frecuentemente, como entradas de blog, titulares de noticias, audio y vídeo."
      },
      {
        "@language": "en",
        "@value": "RSS – Rich Site Summary; originally RDF Site Summary; often called Really Simple Syndication – is a type of web feed which allows users to access updates to online content in a standardized, computer-readable format. These feeds can, for example, allow a user to keep track of many different websites in a single news aggregator. Websites usually use RSS feeds to publish frequently updated information, such as blog entries, news headlines, audio, video. An RSS document (called ‘feed’, ‘web feed’ or ‘channel’) includes full or summarized text and metadata."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/rss+xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/RSS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".xml; .rss"
      },
      {
        "@value": "application/rss+xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "RSS feed"
      },
      {
        "@language": "en",
        "@value": "RSS feed"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/rdf_trig",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
