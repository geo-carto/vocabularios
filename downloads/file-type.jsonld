    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Metadata Encoding and Transmission Standard – Logical METS container"
      },
      {
        "@language": "en",
        "@value": "Metadata Encoding and Transmission Standard – Logical METS container"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "METS – Metadata Encoding and Transmission Standard – es un estándar de metadatos para codificar metadatos descriptivos, administrativos y estructurales relativos a objetos dentro de una biblioteca digital, expresados mediante el lenguaje de esquemas XML."
      },
      {
        "@language": "en",
        "@value": "METS – Metadata Encoding and Transmission Standard – is a metadata standard for encoding descriptive, administrative and structural metadata regarding objects within a digital library, expressed using the XML schema language."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/METS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
