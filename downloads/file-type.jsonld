  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/arcgis_map_srvc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Servicio de mapas ArcGIS"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Map Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un servicio de mapas (Map Service) de ArcGIS hace disponible los contenidos de un documento de mapa a través de la API REST de ArcGIS. Puede funcionar de forma dinámica, generando imágenes de mapa bajo demanda, o como servicio cacheado con teselas pregeneradas para un rendimiento más rápido. Soporta múltiples capacidades opcionales como acceso a entidades (Feature Access), WMS, WFS y KML."
      },
      {
        "@language": "en",
        "@value": "An ArcGIS Map Service makes the contents of a map document available through the ArcGIS REST API. It can operate dynamically, generating map images on demand, or as a cached service with pre-generated tiles for faster performance. It supports multiple optional capabilities such as Feature Access, WMS, WFS, and KML."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "arcgis_map_service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ArcGIS Map Service"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Map Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/iso",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "ISO Disc Image file"
      },
      {
        "@language": "en",
        "@value": "ISO Disc Image file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Archivo de imagen que contiene el contenido de (o destinado a) un disco óptico. Originalmente se limitaba a datos formateados conforme al estándar ISO 9660 (1988), de ahí el nombre del formato y la extensión iso. El formato de imagen de disco ISO se utiliza típicamente para empaquetar software, bases de datos, programas de vídeo DVD y similares. Los archivos de imagen ISO, a diferencia de los archivos normales, no se abren sino que se montan. Contienen los datos de cada sector escrito de un disco óptico, incluyendo el sistema de archivos del disco óptico si existe."
      },
      {
        "@language": "en",
        "@value": "Archive file containing the content from (or destined for) an optical disk. Originally it was limited to data formatted to comply with the ISO 9660 standard (1988), hence the format name and the iso file extension. The ISO Disk Image File Format is typically used to package or bundle software, databases, authored DVD video programs, and the like. ISO image files, unlike normal files, are not opened but rather are mounted. ISO image files contain the data contents of every written sector of an optical disc, including the optical disc file system if one is present."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-iso9660-image"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/ISO"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".iso; .img"
      },
      {
        "@value": "application/x-iso9660-image"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ISO image"
      },
      {
        "@language": "en",
        "@value": "ISO image"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/dapk",
    "@type": [
