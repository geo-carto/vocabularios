  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/legalhtml",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "LegalHTML file"
      },
      {
        "@language": "en",
        "@value": "LegalHTML file"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Extensión del lenguaje HTML diseñada para representar actos jurídicos; proporciona un lenguaje de dominio explícito que aborda todos los aspectos estructurales de un acto, como artículos, párrafos, elementos y referencias; también soporta la descripción del historial editorial y jurisdiccional de un acto y la anotación semántica de entidades de dominio; además, LegalHTML aborda la consolidación de un acto y sus modificaciones posteriores en un único documento; finalmente, una API JavaScript mejora la representación como documento activo, permitiendo la visualización de un acto consolidado en diferentes momentos temporales."
      },
      {
        "@language": "en",
        "@value": "extension of the HTML language designed for representing legal acts; it provides an explicit domain language addressing all structural aspects of an act such as articles, paragraphs, items and references; it also supports the description of the editorial and jurisdictional history of an act and the semantic annotation of domain entities; furthermore, LegalHTML addresses the consolidation of an act and its subsequent modifications into a single document using a tree-like representation of the original content and of its modified versions; finally, a JavaScript API enhances the representation as an active document, enabling the visualization of a consolidated act as it applies at different points in time"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xhtml+xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/LEGALHTML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".html"
      },
      {
        "@value": "application/xhtml+xml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "LegalHTML"
      },
      {
        "@language": "en",
        "@value": "LegalHTML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/html",
