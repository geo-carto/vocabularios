    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Quantum GIS project"
      },
      {
        "@language": "en",
        "@value": "Quantum GIS project"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un archivo QGS es un proyecto de Quantum GIS. Quantum GIS (QGIS) es una aplicación de escritorio de sistemas de información geográfica (SIG) multiplataforma, libre y de código abierto, que proporciona capacidades de visualización, edición y análisis de datos."
      },
      {
        "@language": "en",
        "@value": "QGS file is a Quantum GIS project. Quantum GIS (QGIS) is a cross-platform free and open source desktop geographic information systems (GIS) application that provides data viewing, editing, and analysis capabilities."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/octet-stream"
      },
