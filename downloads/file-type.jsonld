        "@language": "es",
        "@value": "Environmental Systems Research Institute Shape"
      },
      {
        "@language": "en",
        "@value": "Environmental Systems Research Institute Shape"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "SHP – shapefile format – es un formato de datos vectoriales geoespaciales popular para software de sistemas de información geográfica (SIG). El shapefile de Esri es un archivo zip que contiene al menos los archivos shp, shx y dbf."
      },
      {
        "@language": "en",
        "@value": "SHP – shapefile format – is a popular geospatial vector data format for geographic information system (GIS) software. Esri shapefile is a zip archive that contains at least the shp, shx and dbf files."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-shapefile"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/SHP"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
