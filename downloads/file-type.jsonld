      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Extensible Stylesheet Language Transformations"
      },
      {
        "@language": "en",
        "@value": "Extensible Stylesheet Language Transformations"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "XSLT – Extensible Stylesheet Language Transformations – es un lenguaje para transformar documentos XML en otros documentos XML u otros formatos como HTML para páginas web, texto plano o XSL Formatting Objects, que pueden convertirse posteriormente en otros formatos como PDF, PostScript y PNG."
      },
      {
        "@language": "en",
        "@value": "XSLT – Extensible Stylesheet Language Transformations – is a language for transforming XML documents into other XML documents or other formats such as HTML for web pages, plain text or XSL Formatting Objects, which may subsequently be converted to other formats, such as PDF, PostScript and PNG."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/xslt+xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/XSLT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".xsl; .xslt"
      },
      {
        "@value": "application/xslt+xml"
      }
    ],
