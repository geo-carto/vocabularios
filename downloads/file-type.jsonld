      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/feature_srvc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Servicio de entidades ArcGIS"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Feature Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un servicio de entidades (Feature Service) de ArcGIS proporciona acceso a características geoespaciales vectoriales a través de la API REST de ArcGIS. Permite consultar, editar, actualizar, exportar y visualizar registros de datos geográficos (puntos, líneas, polígonos) con sus atributos. Las entidades pueden devolvorse en formatos JSON, GeoJSON y PBF."
      },
      {
        "@language": "en",
        "@value": "An ArcGIS Feature Service provides access to vector geospatial features through the ArcGIS REST API. It allows querying, editing, updating, exporting, and displaying records of geographic data (points, lines, polygons) with their attributes. Features can be output in JSON, GeoJSON, and PBF formats."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "arcgis_feature_service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ArcGIS Feature Service"
      },
      {
        "@language": "en",
        "@value": "ArcGIS Feature Service"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/xyz",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El formato de archivo XYZ es un formato de archivo químico. No existe un estándar formal y existen varias variaciones, pero un formato XYZ típico especifica la geometría molecular dando el número de átomos con coordenadas cartesianas en la primera línea, un comentario en la segunda, y las líneas de coordenadas atómicas en las líneas siguientes."
      },
      {
        "@language": "en",
        "@value": "The XYZ file format is a chemical file format. There is no formal standard and several variations exist, but a typical XYZ format specifies the molecule geometry by giving the number of atoms with Cartesian coordinates that will be read on the first line, a comment on the second, and the lines of atomic coordinates in the following lines."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/chemical/x-xyz"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/XYZ"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".xyz"
      },
      {
        "@value": "chemical/x-xyz"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "XYZ Chemical File"
      },
      {
        "@language": "en",
        "@value": "XYZ Chemical File"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/mif_mid",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "MapInfo interchange format"
      },
      {
        "@language": "en",
        "@value": "MapInfo interchange format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El formato de intercambio MapInfo es un formato de archivo de exportación de mapas y bases de datos del producto de software MapInfo. El nombre de archivo MIF generalmente termina con el sufijo .mif. Algunos archivos MIF también tienen un archivo MID relacionado. El nombre de archivo MID generalmente termina con el sufijo .mid."
      },
      {
        "@language": "en",
        "@value": "MapInfo interchange format is a map and database exporting file format of MapInfo software product. The MIF-file filename usually ends with .mif-suffix. Some MIF-files also have a related MID-file. The filename of a MID-file usually ends with .mid-suffix."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/text/plain"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/MIF_MID"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".mid; .mif"
      },
      {
        "@value": "text/plain"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "MIF/MID"
      },
      {
        "@language": "en",
        "@value": "MIF/MID"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
