        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Atom Syndication Format"
      },
      {
        "@language": "en",
        "@value": "Atom Syndication Format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El formato Atom Feed o Atom Syndication Format es un lenguaje XML utilizado para fuentes web. Las fuentes web permiten a los programas de software verificar actualizaciones publicadas en un sitio web."
      },
      {
        "@language": "en",
        "@value": "The Atom Feed or Atom Syndication Format is an XML language used for web feeds. Web feeds allow software programs to check for updates published on a website."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/atom+xml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/ATOM"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
