      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "QuickTime Movie"
      },
      {
        "@language": "en",
        "@value": "QuickTime Movie"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Formato de archivo informático utilizado nativamente por el framework QuickTime; el formato especifica un contenedor multimedia que contiene una o más pistas, cada una de las cuales almacena un tipo particular de datos: audio, vídeo o texto (p. ej. para subtítulos)."
      },
      {
        "@language": "en",
        "@value": "computer file format used natively by the QuickTime framework; the format specifies a multimedia container file that contains one or more tracks, each of which stores a particular type of data: audio, video, or text (e.g. for subtitles)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
