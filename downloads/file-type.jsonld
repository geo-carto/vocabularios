    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "DMP es el tipo de medio que se utilizará para volcados de Oracle. Este tipo de medio está incompleto ya que carece de una referencia a la especificación del formato."
      },
      {
        "@language": "en",
        "@value": "DMP is the media type which shall be used for Oracle dumps. This media type is incomplete as it lacks a reference to the specification of the format."
