  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/pdfa1a",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "PDF archiving format, Level A conformance"
      },
      {
        "@language": "en",
        "@value": "PDF archiving format, Level A conformance"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "PDF/A-1 es la Parte 1 del estándar PDF y especifica dos niveles de conformidad para archivos PDF. PDF/A-1a – Conformidad de Nivel A (accesible) estaba destinada a aumentar la accesibilidad de los archivos conformes para usuarios con discapacidades físicas, permitiendo que el software de asistencia, como los lectores de pantalla, extraiga e interprete con mayor precisión el contenido de un archivo."
      },
      {
        "@language": "en",
        "@value": "PDF/A-1 is the Part 1 of the PDF standard and specifies two levels of conformance for PDF files. PDF/A-1a – Level A (accessible) conformance was intended to increase the accessibility of conforming files for physically impaired users by allowing assistive software, such as screen readers, to more precisely extract and interpret a file's contents."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/pdf"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/PDFA1A"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".pdf"
      },
      {
        "@value": "application/pdf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "PDF/A-1a"
      },
      {
        "@language": "en",
        "@value": "PDF/A-1a"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
