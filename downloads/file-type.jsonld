    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Mobipocket eBook es un formato de archivo de libro electrónico propietario de la empresa Mobipocket SA que puede ser utilizado por teléfonos móviles, asistentes digitales personales (PDA) y sistemas operativos de escritorio."
      },
      {
        "@language": "en",
        "@value": "Mobipocket eBook is a proprietary e-book file format of Mobipocket SA company that can be used by mobile phones, personal digital assistants (PDA) and desktop operating systems."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
