      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Android Package"
      },
      {
        "@language": "en",
        "@value": "Android Package"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Android Package (APK) es el formato de archivo de paquete utilizado por el sistema operativo Android para la distribución e instalación de aplicaciones móviles, juegos móviles y middleware."
      },
      {
        "@language": "en",
        "@value": "Android Package (APK) is the package file format used by the Android operating system for distribution and installation of mobile apps, mobile games and middleware."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.android.package-archive"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/APK"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".apk; .xapk"
      },
      {
        "@value": "application/vnd.android.package-archive"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "APK"
      },
      {
