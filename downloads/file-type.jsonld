      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "PDF/X-4 es una especificación PDF en la que se soportan datos de color gestionados CMYK, gris, RGB o colores directos, así como transparencia PDF y contenido opcional."
      },
      {
        "@language": "en",
        "@value": "PDF/X-4 is a PDF specification in which colour-managed, CMYK, gray, RGB or spot colour data are supported, as are PDF transparency and optional content."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/pdf"
