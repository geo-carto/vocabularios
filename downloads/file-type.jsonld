  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/odc",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "OpenDocument es un formato estandarizado de documento abierto para aplicaciones de oficina. Los gráficos definen cómo crear representaciones gráficas a partir de datos numéricos."
      },
      {
        "@language": "en",
        "@value": "OpenDocument is a standardized Open Document Format for Office Applications. Charts define how to create graphical displays from numerical data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/vnd.oasis.opendocument.chart"
