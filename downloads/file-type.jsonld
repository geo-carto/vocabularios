        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Adobe Photoshop Document"
      },
      {
        "@language": "en",
        "@value": "Adobe Photoshop Document"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "PSD – Photoshop Document – almacena una imagen con soporte para la mayoría de las opciones de imagen disponibles en Adobe Photoshop. Photoshop es un editor de gráficos rasterizados."
      },
      {
        "@language": "en",
        "@value": "PSD – Photoshop Document – stores an image with support for most imaging options available in Adobe Photoshop. Photoshop is a raster graphics editor."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/x-photoshop"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/PSD"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".psd"
      },
      {
        "@value": "application/x-photoshop"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "PSD"
      },
      {
        "@language": "en",
        "@value": "PSD"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
