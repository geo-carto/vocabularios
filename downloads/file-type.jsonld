  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/zarr",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "Formato Zarr"
      },
      {
        "@language": "en",
        "@value": "Zarr format"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Zarr es un formato de almacenamiento de datos diseñado para matrices multidimensionales N-dimensionales chunked, comprimidas. Soporta almacenamiento en múltiples backends (sistema de archivos, almacenamiento en la nube, bases de datos) y es adecuado para datos científicos y de observación de la Tierra. Permite el acceso paralelo y concurrente a fragmentos de datos."
      },
      {
        "@language": "en",
        "@value": "Zarr is a data storage format designed for chunked, compressed, N-dimensional arrays. It supports storage across multiple backends (file system, cloud storage, databases) and is suitable for scientific and Earth observation data. It enables parallel and concurrent access to data chunks."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".zarr"
      },
      {
        "@value": "application/x-zarr"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Zarr"
      },
      {
        "@language": "en",
        "@value": "Zarr"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ]
  },
