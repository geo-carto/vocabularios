  {
    "@id": "https://geo-carto.github.io/vocabularios/file-type/yaml",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "YAML Ain't Markup Language"
      },
      {
        "@language": "en",
        "@value": "YAML Ain't Markup Language"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "YAML es un lenguaje de serialización de datos amigable para humanos, multilenguaje, basado en Unicode, diseñado en torno a los tipos de datos nativos comunes de los lenguajes de programación dinámicos. Es ampliamente útil para necesidades de programación que van desde archivos de configuración hasta mensajería por Internet, persistencia de objetos, auditoría y visualización de datos."
      },
      {
        "@language": "en",
        "@value": "YAML is a human-friendly, cross language, Unicode based data serialization language designed around the common native data types of dynamic programming languages. It is broadly useful for programming needs ranging from configuration files to internet messaging to object persistence to data auditing and visualization."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://www.iana.org/assignments/media-types/application/yaml"
      },
      {
        "@id": "http://publications.europa.eu/resource/authority/file-type/YAML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/file-type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": ".yml; .yaml"
      },
      {
        "@value": "application/yaml"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "YAML"
      },
      {
        "@language": "en",
        "@value": "YAML"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
