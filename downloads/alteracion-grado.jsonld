    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La meteorización química afecta a todo el material."
      },
      {
        "@language": "en",
        "@value": "Weathering affects all the material, beeing modified by chemical weathering"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-grado"
