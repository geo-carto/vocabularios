    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material (roca o formación superficial) sin textura original reconocible y con su volumen original reducido significativamente."
      },
      {
        "@language": "en",
        "@value": "Material (rock or superficial formation) with no recognizable original texture and significantly reduced original volume"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-grado"
