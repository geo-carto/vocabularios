      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La meteorización se limita a las superficies de discontinuidad del material (fracturación y estratificación)."
      },
      {
        "@language": "en",
        "@value": "Weathering is limited to discontinuities surfaces of the material (joints and bedding)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-grado"
      }
