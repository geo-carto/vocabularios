    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/reactivado"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/estabilizado"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/inactivo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/collection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:prefLabel xml:lang="es">Actividad geomorfológica - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Geomorphologic activity - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/activo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/latente"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/reactivado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/estabilizado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/inactivo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/activo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:prefLabel xml:lang="es">activo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">active</skos:prefLabel>
    <skos:definition xml:lang="es">Un proceso geomorfológico que actualmente está en acción, o que ha sido reactivado desde hace un período de tiempo convencionalmente corto.</skos:definition>
    <skos:definition xml:lang="en">A geomorphologic process that is currently in a state of action, or that has been reactivated since a conventionally short period of time.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeomorphologicActivityValue/active"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/latente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:prefLabel xml:lang="es">latente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dormant</skos:prefLabel>
    <skos:definition xml:lang="es">Un proceso geomorfológico que no ha mostrado signos de actividad desde hace un período de tiempo convencionalmente corto, y que podría ser reactivado por sus causas originales o desencadenado por causas inducidas como actividades antropogénicas.</skos:definition>
    <skos:definition xml:lang="en">A geomorphologic process that has not shown signs of activity since a conventionally short period of time, and that could be reactivated by its original causes, or triggered by induced causes such as anthropogenic activities.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeomorphologicActivityValue/dormant"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/inactivo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:prefLabel xml:lang="es">inactivo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inactive</skos:prefLabel>
    <skos:definition xml:lang="es">Un proceso geomorfológico relicto o fósil.</skos:definition>
    <skos:definition xml:lang="en">A relict or fossil geomorphologic process.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeomorphologicActivityValue/inactive"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/estabilizado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:prefLabel xml:lang="es">estabilizado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stabilised</skos:prefLabel>
    <skos:definition xml:lang="es">Un proceso geomorfológico estabilizado es un proceso inactivo que ha sido protegido de sus causas originales mediante medidas correctivas.</skos:definition>
    <skos:definition xml:lang="en">A stabilized geomorphologic process is an inactive process which has been protected from its original causes by remedial measures.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeomorphologicActivityValue/stabilised"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-actividad/reactivado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-actividad"/>
    <skos:prefLabel xml:lang="es">reactivado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reactivated</skos:prefLabel>
    <skos:definition xml:lang="es">Un proceso geomorfológico reactivado es un proceso geomorfológico activo que ha estado inactivo.</skos:definition>
    <skos:definition xml:lang="en">A reactivated geomorphologic process is an active geomorphologic process which has been dormant.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeomorphologicActivityValue/reactivated"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
</rdf:RDF>
