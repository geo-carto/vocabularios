  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-actividad">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Actividad geomorfológica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Geomorphologic activity</skos:prefLabel>
    <dcterms:title xml:lang="es">Actividad geomorfológica</dcterms:title>
    <dcterms:title xml:lang="en">Geomorphologic activity</dcterms:title>
    <skos:definition xml:lang="es">Términos referidos a la actividad geomorfológica.</skos:definition>
    <skos:definition xml:lang="en">Terms referring to geomorphological activity.</skos:definition>
    <dcterms:description xml:lang="es">Términos referidos a la actividad geomorfológica.</dcterms:description>
    <dcterms:description xml:lang="en">Terms referring to geomorphological activity.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos originales de INSPIRE</dcterms:provenance>
    <dcterms:creator>https://commission.europa.eu/</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Actividad geomorfológica.</skos:editorialNote>
