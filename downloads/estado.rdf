  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estado/valido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:prefLabel xml:lang="es">Válido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Valid</skos:prefLabel>
    <skos:definition xml:lang="es">El elemento ha sido aceptado, se recomienda su uso y no ha sido sustituido ni retirado.</skos:definition>
    <skos:definition xml:lang="en">The item has been accepted, is recommended for use, and has not been superseded or retired.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estado/retirado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:prefLabel xml:lang="es">Retirado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Retired</skos:prefLabel>
    <skos:definition xml:lang="es">Se ha decidido que el elemento ya no se recomienda para su uso. No ha sido sustituido por otro elemento.</skos:definition>
    <skos:definition xml:lang="en">A decision has been made that the item is no longer recommended for use. It has not been superseded by another item.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/registry/status/retired"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estado/sustituido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:prefLabel xml:lang="es">Sustituido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Superseded</skos:prefLabel>
    <skos:definition xml:lang="es">El elemento ha sido sustituido por otro y ya no se recomienda su uso.</skos:definition>
    <skos:definition xml:lang="en">The item has been superseded by another item and is no longer recommended for use.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/registry/status/superseded"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estado/propuesto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:prefLabel xml:lang="es">Propuesto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Submitted</skos:prefLabel>
    <skos:definition xml:lang="es">El elemento ha sido incorporado al registro, pero está pendiente de aprobación definitiva por el órgano de control.</skos:definition>
    <skos:definition xml:lang="en">The item has been entered into the register, but definitive approval of the control body is pending.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/registry/status/submitted"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
