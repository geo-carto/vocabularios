  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/estado/invalido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/estado"/>
    <skos:prefLabel xml:lang="es">Inválido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Invalid</skos:prefLabel>
    <skos:definition xml:lang="es">Se ha determinado que un elemento previamente válido contiene un error sustancial y es inválido; normalmente habrá sido reemplazado por un elemento corregido.</skos:definition>
    <skos:definition xml:lang="en">A decision has been made that a previously valid register item contains a substantial error and is invalid, and will normally have been replaced by a corrected item.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/registry/status/invalid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
