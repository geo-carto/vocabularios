    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Depresión relativamente extensa resultante de la excavación de material y la redistribución del sobrante asociadas a las operaciones de minería en superficie"
      },
      {
        "@language": "en",
        "@value": "A relatively large depression resulting from the excavation of material and redistribution of overburden associated with surficial mining operations."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/AnthropogenicGeomorphologicFeatureTypeValue/openpitMine"
      }
    ],
