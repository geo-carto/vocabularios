  {
    "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/canal-dragado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Zona de aguas profundas y más o menos lineal trazada mediante una operación de excavación y extracción de material para fines de navegación"
      },
      {
        "@language": "en",
        "@value": "A roughly linear, deep water area formed by a dredging operation for navigation purposes"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/AnthropogenicGeomorphologicFeatureTypeValue/dredgedChannel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "canal dragado"
      },
      {
        "@language": "en",
        "@value": "dredged channel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
