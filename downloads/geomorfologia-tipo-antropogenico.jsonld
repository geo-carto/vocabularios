  {
    "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/deposito-de-relleno",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Depósito artificial de materiales naturales y/o residuos creado para llenar una depresión, ensanchar la orilla de una masa de agua o construir un dique."
      },
      {
        "@language": "en",
        "@value": "Human-constructed deposits of natural earth materials and/or waste materials used to fill a depression, to extend shore land into a body of water, or in building dams."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/AnthropogenicGeomorphologicFeatureTypeValue/fill"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "depósito de relleno"
      },
      {
        "@language": "en",
        "@value": "fill"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
