      {
        "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "mina a cielo abierto"
      },
      {
        "@language": "en",
        "@value": "openpit mine"
      }
    ],
