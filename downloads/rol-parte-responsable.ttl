    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:definition "Party that accepts accountability and responsibility for the resource and ensures appropriate care and maintenance of the resource."@en,
        "Parte que acepta la responsabilidad de los datos y asegura el cuidado y mantenimiento apropiados del recurso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:prefLabel "custodian"@en,
        "custodio"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    adms:status "Válido" .

