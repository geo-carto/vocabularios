<https://geo-carto.github.io/vocabularios/rol-parte-responsable/autor> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:definition "Party who authored the resource."@en,
        "Parte que es el autor del recurso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:prefLabel "author"@en,
        "autor"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/rol-parte-responsable/co-autor> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:definition "Party who jointly authors the resource."@en,
        "Parte que coautoriza el recurso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:prefLabel "coAuthor"@en,
        "co-autor"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
