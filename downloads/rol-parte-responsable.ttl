    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:definition "Party who assists with the generation of the resource other than the principal investigator."@en,
        "Parte que ayuda en la generación del recurso distinta del investigador principal."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:prefLabel "collaborator"@en,
