<https://geo-carto.github.io/vocabularios/rol-parte-responsable/mediador> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:definition "A class of entity that mediates access to the resource and for whom the resource is intended or useful."@en,
        "Clase de entidad que media el acceso al recurso y para la cual el recurso está destinado o resulta útil."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:prefLabel "mediator"@en,
        "mediador"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/rol-parte-responsable/procesador> a skos:Concept ;
