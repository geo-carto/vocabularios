    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:definition "Party who has an interest in the resource. or the use of the resource."@en,
        "Parte que tiene interés en el recurso o en su uso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:prefLabel "stakeholder"@en,
        "interesado"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/rol-parte-responsable/investigador-principal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:definition "Key party responsible for gathering information and conducting research"@en,
