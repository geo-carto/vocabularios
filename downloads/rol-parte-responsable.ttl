    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:definition "Party who has processed the data in a manner such that the resource has been modified."@en,
        "Parte que ha procesado los datos de una manera tal que ha modificado el recurso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    skos:prefLabel "processor"@en,
        "procesador"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/rol-parte-responsable> ;
    adms:status "Válido" .

