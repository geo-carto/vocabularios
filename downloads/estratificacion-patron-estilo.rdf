    <skos:prefLabel xml:lang="es">Estilo del patrón de estratificación - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Bedding pattern style - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo/planar"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo/masiva"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/estratificacion-patron-estilo/ondulada"/>
