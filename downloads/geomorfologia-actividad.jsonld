        "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-actividad"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un proceso geomorfológico relicto o fósil."
      },
      {
        "@language": "en",
        "@value": "A relict or fossil geomorphologic process."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/GeomorphologicActivityValue/inactive"
