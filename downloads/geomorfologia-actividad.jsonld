        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/geomorfologia-actividad"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Un proceso geomorfológico reactivado es un proceso geomorfológico activo que ha estado inactivo."
      },
      {
        "@language": "en",
        "@value": "A reactivated geomorphologic process is an active geomorphologic process which has been dormant."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/GeomorphologicActivityValue/reactivated"
      }
    ],
