  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/explanada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"/>
    <skos:prefLabel xml:lang="es">explanada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">levelled land</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie de terreno, normalmente un campo, que ha sido aplanada o alisada por medios mecánicos para facilitar tareas de gestión, como el riego por inundación.</skos:definition>
    <skos:definition xml:lang="en">A land area, usually a field, that has been mechanically flattened or smoothed to facilitate management practices such as flood irrigation.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/AnthropogenicGeomorphologicFeatureTypeValue/levelledLand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/mina-a-cielo-abierto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico"/>
    <skos:prefLabel xml:lang="es">mina a cielo abierto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">openpit mine</skos:prefLabel>
    <skos:definition xml:lang="es">Depresión relativamente extensa resultante de la excavación de material y la redistribución del sobrante asociadas a las operaciones de minería en superficie</skos:definition>
    <skos:definition xml:lang="en">A relatively large depression resulting from the excavation of material and redistribution of overburden associated with surficial mining operations.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/AnthropogenicGeomorphologicFeatureTypeValue/openpitMine"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
