  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-de-deformacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <skos:prefLabel xml:lang="es">unidad de deformación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deformation unit</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad litotectónica definida por el estilo de deformación o la estructura geológica característica observables en afloramiento.</skos:definition>
    <skos:definition xml:lang="en">Lithotectonic unit defined by deformation style or characteristic geologic structure observable in outcrop.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-litotectonica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeologicUnitTypeValue/deformationUnit"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunittype/deformation_unit"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-de-alteracion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <skos:prefLabel xml:lang="es">unidad de alteración</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alteration unit</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad geológica definida por un proceso de alteración.</skos:definition>
    <skos:definition xml:lang="en">Geologic unit defined by alteration process.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-geologica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeologicUnitTypeValue/alterationUnit"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunittype/alteration_unit"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-geofisica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <skos:prefLabel xml:lang="es">unidad geofísica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">geophysical unit</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad geológica definida por sus características geofísicas.</skos:definition>
    <skos:definition xml:lang="en">Geologic unit defined by its geophysical characteristics.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-geologica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-magnetoestratigrafica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeologicUnitTypeValue/geophysicalUnit"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunittype/geophysical_unit"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-de-excavacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <skos:prefLabel xml:lang="es">unidad de excavación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">excavation unit</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad geológica definida por su origen humano vinculado a operaciones de excavación.</skos:definition>
    <skos:definition xml:lang="en">Geologic unit defined by human-made genesis involving excavation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-litogenetica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeologicUnitTypeValue/excavationUnit"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunittype/excavation_unit"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-cronoestratigrafica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <skos:prefLabel xml:lang="es">unidad cronoestratigráfica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chronostratigraphic unit</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad geológica que incluye todas las rocas formadas durante un intervalo de tiempo geológico específico</skos:definition>
    <skos:definition xml:lang="en">Geologic unit that includes all rocks formed during a specific interval of geologic time</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-geologica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeologicUnitTypeValue/chronostratigraphicUnit"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunittype/chronostratigraphic_unit"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-magnetoestratigrafica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <skos:prefLabel xml:lang="es">unidad magnetoestratigráfica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">magnetostratigraphic unit</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad geológica delimitada por sus características magnéticas.</skos:definition>
    <skos:definition xml:lang="en">Geologic unit defined by magnetic characteristics.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-geofisica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeologicUnitTypeValue/magnetostratigraphicUnit"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunittype/magnetostratigraphic_unit"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-bioestratigrafica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <skos:prefLabel xml:lang="es">unidad bioestratigráfica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biostratigraphic unit</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad geológica definida sobre la base de su contenido fósil.</skos:definition>
    <skos:definition xml:lang="en">Geologic unit defined based on fossil content.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-geologica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeologicUnitTypeValue/biostratigraphicUnit"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunittype/biostratigraphic_unit"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-litologica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <skos:prefLabel xml:lang="es">unidad litológica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithologic unit</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad geológica definida por la litología, independiente de su relación con otras unidades.</skos:definition>
    <skos:definition xml:lang="en">Geologic unit defined by lithology independent of relationships to other units.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-geologica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeologicUnitTypeValue/lithologicUnit"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/geologicunittype/lithologic_unit"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
