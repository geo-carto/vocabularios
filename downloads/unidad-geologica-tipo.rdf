    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"/>
    <skos:prefLabel xml:lang="es">Tipo de unidad geológica - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Geologic unit type - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-geologica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-aloestratigrafica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-de-alteracion"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-bioestratigrafica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-cronoestratigrafica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-geofisica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-magnetoestratigrafica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-litogenetica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/suelo-artificial"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-de-excavacion"/>
