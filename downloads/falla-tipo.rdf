  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla normal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">normal fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla cuyo bloque elevado es el inferior y su superficie buza hacia el bloque hundido y en la que la componente del desplazamiento paralelo al buzamiento es más de 10 veces superior a la componente del desplazamiento paralelo al rumbo en más de la mitad de la extensión en la que ha sido reconocida.</skos:definition>
    <skos:definition xml:lang="en">Fault with dip-parallel displacement component of slip vector more than 10 times the strike-parallel component of the slip vector over more than half recognized extent of the fault, and for which the fault dips consistently in the same direction, and for which the hanging wall has been displaced down relative to the footwall.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/normalFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/normal_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-dextra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla inversa dextra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right reverse fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla inversa de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la derecha del bloque desde donde se hace la observación.</skos:definition>
    <skos:definition xml:lang="en">High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with a right-lateral strike-parallel component and reverse dip-parallel component of slip over at least half the mapped trace of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/rightReverseFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/right_reverse_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-mixta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla contraccional mixta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mixed extraction fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla contracional con algo de desplazamiento en la dirección del plano de falla.</skos:definition>
    <skos:definition xml:lang="en">An extraction fault with some displacement within the fault plane.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/mixedExtractionFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/mixed_extraction_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla de desgarre</skos:prefLabel>
    <skos:prefLabel xml:lang="en">strike slip fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla en la que el componente de desplazamiento paralelo a la dirección de la superficie de falla es más de 10 veces superior al desplazamiento paralelo al buzamiento al menos en una zona del trazado cartografiado.</skos:definition>
    <skos:definition xml:lang="en">Fault with strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the mapped trace of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-de-alto-angulo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-dextra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-sinestral"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/strikeSlipFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/strike_slip_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-sinistra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla inversa sinistra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">left reverse fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla inversa de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la izquierda del bloque desde donde se hace la observación.</skos:definition>
    <skos:definition xml:lang="en">High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with left-lateral strike-parallel component and reverse dip-parallel component over at least half the mapped trace of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/leftReverseFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/left_reverse_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-dextra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla normal dextra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">right normal fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla normal de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en un tramo a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la derecha del bloque desde donde se hace la observación.</skos:definition>
    <skos:definition xml:lang="en">High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with right-lateral strike-parallel component and normal dip-parallel component of slip over at least half the mapped trace of the fault</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/rightNormalFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/right_normal_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla de desplazamiento oblicuo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oblique slip fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla en la que ambas componentes del desplazamiento: en la  dirección de la capa y en la dirección de buzamiento tienen un valor apreciable.</skos:definition>
    <skos:definition xml:lang="en">Fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-sinistra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-sinistra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-dextra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-dextra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/obliqueSlipFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/oblique_slip_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fault</skos:prefLabel>
    <skos:definition xml:lang="es">Superficie discreta, o zona de superficies discretas, con un cierto espesor, que separa dos cuerpos rocosos y a lo largo de la cual uno de los cuerpos se ha deslizado con respecto al otro.</skos:definition>
    <skos:definition xml:lang="en">A discrete surface, or zone of discrete surfaces, with some thickness, separating two rock masses across which one mass has slid past the other and characterized by brittle deformation.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-en-tijera"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/fault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla de bajo ángulo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">low angle fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla cuyo plano buza menos de 45 grados sobre más de la mitad de su extensión reconocida.</skos:definition>
    <skos:definition xml:lang="en">Fault that dips less than 45 degrees over more than half of the recognized extent of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-horizontal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/cabalgamiento"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/lowAngleFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/low_angle_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-de-alto-angulo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla de desgarre de alto ángulo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wrench fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla de desgarre cuyo plano de falla buza como mínimo 45 grados en más de la mitad de la extensión en la que se ha reconocido.
.</skos:definition>
    <skos:definition xml:lang="en">A strike slip fault in which the fault plane dips at least 45 degrees over more than half of the recognized extent of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/wrenchFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/wrench_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-dextra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla de desgarre dextra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dextral strike slip fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla de desgarre en la que un bloque se desplaza hacia la derecha del bloque desde donde se hace la observación.</skos:definition>
    <skos:definition xml:lang="en">Fault with right-lateral strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the fault, and right-lateral displacement over more than half the mapped trace of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/dextralStrikeSlipFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/dextral_strike_slip_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla de alto ángulo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">high angle fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla cuyo plano buza más de 45 grados sobre más de la mitad de su extensión reconocida, y para la cual el deslizamiento o separación no se especifica explícitamente.</skos:definition>
    <skos:definition xml:lang="en">Fault that dips at least 45 degrees over more than half of its recognized extent, for which slip or separation is not explicitly specified.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-de-alto-angulo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-de-alto-angulo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/highAngleFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/high_angle_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-horizontal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla horizontal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">horizontal fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla que buza menos de 10 grados sobre más de la mitad de la extensión reconocida de la falla.</skos:definition>
    <skos:definition xml:lang="en">Fault that dips less than 10 degrees over more than half the recognized extent of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/horizontalFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/horizontal_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla contraccional</skos:prefLabel>
    <skos:prefLabel xml:lang="en">extraction fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla cuyos dos lados se han aproximado notablemente entre sí en la dirección perpendicular a la falla.</skos:definition>
    <skos:definition xml:lang="en">A fault whose two sides have approached each other substantially in the direction perpendicular to the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-mixta"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-pura"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/extractionFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/extraction_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-en-tijera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla en tijera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">scissor fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla en la que, a partir de un punto inicial sin ninguna separación, se da una separación creciente a lo largo de la dirección de la falla y una separación decreciente en la dirección opuesta.</skos:definition>
    <skos:definition xml:lang="en">A fault on which there is increasing offset or separation along the strike from an initial point of no offset, with the opposite sense of offset in the opposite direction.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/scissorFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/scissor_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-sinistra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla normal sinistra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">left normal fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla normal de alto ángulo en la que la relación del desplazamiento paralelo al rumbo respecto al desplazamiento perpendicular al mismo tiene un valor comprendido entre 10 a 1 y 1 a 10 en, como mínimo, una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la izquierda del bloque desde donde se hace la observación.</skos:definition>
    <skos:definition xml:lang="en">High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with left-lateral strike-parallel component and normal dip-parallel component over at least half the mapped trace of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/leftNormalFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/left_normal_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-sinestral">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla de desgarre sinestral</skos:prefLabel>
    <skos:prefLabel xml:lang="en">siniestral strike slip fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla de desgarre en la que un bloque se desplaza hacia la izquierda del bloque desde donde se hace la observación.</skos:definition>
    <skos:definition xml:lang="en">Fault with left-lateral strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the fault, and left-lateral displacement over more than half the mapped trace of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/sinistralStrikeSlipFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/sinistral_strike_slip_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla inversa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reverse fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla en la que el componente de desplazamiento paralelo al buzamiento es más de 10 veces superior al componente de desplazamiento paralelo al rumbo al menos en un lugar del trazado cartografiado y la falla buza sistemáticamente en la misma dirección, estando el labio levantado desplazado hacia arriba en relación con el labio hundido al menos la mitad del trazado cartografiado.</skos:definition>
    <skos:definition xml:lang="en">Fault with dip-parallel displacement component of slip vector more than 10 times the strike-parallel component of the slip vector at at least one location along the mapped trace of the fault, and the fault dips consistently in the same direction with the hanging wall displaced up relative to the footwall over at least half the mapped trace of the fault.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-de-alto-angulo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/cabalgamiento"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/reverseFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/reverse_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-de-alto-angulo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla inversa de alto ángulo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">high angle reverse</skos:prefLabel>
    <skos:definition xml:lang="es">Falla inversa cuyo plano buza más de 45 grados sobre más de la mitad de su extensión reconocida.</skos:definition>
    <skos:definition xml:lang="en">Reverse fault that dips at least 45 degrees over more than half of its recognized extent, for which slip or separation is not explicitly specified</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/highAngleReverse"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/high_angle_reverse"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla normal de alto ángulo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">high angle normal fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla normal cuyo plano buza más de 45 grados sobre más de la mitad de su extensión reconocida.</skos:definition>
    <skos:definition xml:lang="en">Fault that dips at least 45 degrees over more than half of the recognized extent of the fault with the hanging wall displaced from a structurally higher position relative to footwall rocks.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/highAngleNormalFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/high_angle_normal_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-pura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo"/>
    <skos:prefLabel xml:lang="es">falla contraccional pura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure extraction fault</skos:prefLabel>
    <skos:definition xml:lang="es">Falla contracional sin  desplazamiento apreciable a lo largo del plano de falla.</skos:definition>
    <skos:definition xml:lang="en">An extraction fault with no discernible displacement within the fault plane.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/FaultTypeValue/pureExtractionFault"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/faulttype/pure_extraction_fault"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
