>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/falla-tipo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Tipo de falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Fault type</skos:prefLabel>
    <dcterms:title xml:lang="es">Tipo de falla</dcterms:title>
    <dcterms:title xml:lang="en">Fault type</dcterms:title>
    <skos:definition xml:lang="es">Términos que clasifican el tipo de falla</skos:definition>
    <skos:definition xml:lang="en">Terms that classify the type of fault.</skos:definition>
    <dcterms:description xml:lang="es">Términos que clasifican el tipo de falla</dcterms:description>
    <dcterms:description xml:lang="en">Terms that classify the type of fault.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
