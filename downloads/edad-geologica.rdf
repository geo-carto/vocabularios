  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/edad-geologica-igme/gelasiense">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/edad-geologica"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/edad-geologica"/>
    <skos:prefLabel xml:lang="es">Gelasiense</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Gelasian</skos:prefLabel>
    <skos:notation>a1.1.1.1.2.4</skos:notation>
    <skos:notation>213030111000</skos:notation>
    <sdo:color>#FFEDB3</sdo:color>
    <skos:definition xml:lang="en">Older bound 2.58 Ma, younger bound 1.8 Ma</skos:definition>
    <skos:definition xml:lang="es">Límite inferior 2.58 Ma, límite superior 1.8 Ma</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/edad-geologica-igme/pleistoceno-inferior"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/GeochronologicEraValue/gelasian"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/ics/ischart/Gelasian"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
