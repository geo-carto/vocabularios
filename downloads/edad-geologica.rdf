  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/edad-geologica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Edad Geológica IGME</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Geochronologic Era</skos:prefLabel>
    <dcterms:title xml:lang="es">Edad Geológica IGME</dcterms:title>
    <dcterms:title xml:lang="en">Geochronologic Era</dcterms:title>
    <skos:definition xml:lang="es">Vocabulario que recoge términos de edades geológicas utlizados en la cartografía geológica del IGME. Inlcuye términos de la ICS, así como términos regionales.</skos:definition>
    <skos:definition xml:lang="en">Vocabulary containing geological age terms used in IGME geological cartography. It includes ICS terms as well as regional ages.</skos:definition>
    <dcterms:description xml:lang="es">Vocabulario que recoge términos de edades geológicas utlizados en la cartografía geológica del IGME. Inlcuye términos de la ICS, así como términos regionales.</dcterms:description>
    <dcterms:description xml:lang="en">Vocabulary containing geological age terms used in IGME geological cartography. It includes ICS terms as well as regional ages.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos IUGS ampliados por el IGME</dcterms:provenance>
    <dcterms:creator>https://cgi-iugs.org/</dcterms:creator>
    <dcterms:contributor>https://www.igme.es</dcterms:contributor>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Edad Geológica IGME.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/edad-geologica-igme/pleistoceno-medio"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/edad-geologica-igme/megalayense/edad-cronoestratigrafica"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/edad-geologica-igme/regional"/>
  </rdf:Description>
