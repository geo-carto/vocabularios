  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-ultra-alta-presion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de ultra-alta presión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultra high pressure crustal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente caracterizado por presiones características del manto superior, pero indicada por la asociación mineral en rocas de composición cortical.</skos:definition>
    <skos:definition xml:lang="en">Setting characterized by pressures characteristic of upper mantle, but indicated by mineral assemblage in crustal composition rocks.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/ultraHighPressureCrustalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/ultra_high_pressure_crustal_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-inactivo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de centro de expansión inactivo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inactive spreading center setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente en la corteza oceánica formado en un centro de expansión que ha sido abandonado.</skos:definition>
    <skos:definition xml:lang="en">Setting on oceanic crust formed at a spreading center that has been abandoned.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-intraplaca"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-placa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/inactiveSpreadingCenterSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/inactive_spreading_center"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-meandro-estrangulado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente meandro estrangulado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cutoff meander setting</skos:prefLabel>
    <skos:definition xml:lang="es">El canal, en forma de collera o herradura de un antiguo meandro, abandonado cuando la corriente forma un corte a través de un estrecho cuello meandro. Téngase en cuenta que en general suelen formar lagos, y por tanto también son lacustres.</skos:definition>
    <skos:definition xml:lang="en">The abandoned, bow- or horseshoe-shaped channel of a former meander, left when the stream formed a cutoff across a narrow meander neck. Note that these are typically lakes, thus also lacustrine.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/cutoffMeanderSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/cutoff_meander"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
