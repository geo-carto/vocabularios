  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-medioambiente-humano">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de medioambiente humano</skos:prefLabel>
    <skos:prefLabel xml:lang="en">human environment setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente de medioambiente humano</skos:definition>
    <skos:definition xml:lang="en">Human environment setting.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/humanEnvironmentSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/human_environment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente subacuático</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subaqueous setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente situado en o por debajo del agua retenida permanente. Se utiliza para la ambientes marinos y lacustres, pero no para ambientes fluviales.</skos:definition>
    <skos:definition xml:lang="en">Setting situated in or under permanent, standing water. Used for marine and lacustrine settings, but not for fluvial settings.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-la-bahia-interdistributaria"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intermareal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-prodelta"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-mareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/subaqueousSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/subaqueous_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-alta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura deltaica alta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">upper delta plain setting</skos:prefLabel>
    <skos:definition xml:lang="es">La parte de una llanura deltaica afectadas fundamentalmente por los procesos de cuenca. No difieren sustancialmente de los ambientes aluviales, excepto que las zonas con pantanos, marismas y lagos suelen ser más frecuentes y que los canales pueden bifurcarse aguas abajo.</skos:definition>
    <skos:definition xml:lang="en">The part of a delta plain essentially unaffected by basinal processes. They do not differ substantially from alluvial environments except that areas of swamp, marsh and lakes are usually more widespread and channels may bifurcate downstream.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperDeltaPlainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_delta_plain"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subglacial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente subglacial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subglacial setting</skos:prefLabel>
    <skos:definition xml:lang="es">Formado o acumulada en o por el fondo de un glaciar o manto de hielo; dicho de las corrientes de agua de deshielo, el till, morrenas, etc.</skos:definition>
    <skos:definition xml:lang="en">Formed or accumulated in or by the bottom parts of a glacier or ice sheet; said of meltwater streams, till, moraine, etc.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/subglacialSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/subglacial_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-superior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de corteza continental superior</skos:prefLabel>
    <skos:prefLabel xml:lang="en">upper continental crustal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente de corteza continental dominado por rocas no metamorfizadas a metamórficas de la facies de los esquistos verdes, y deformación frágil.</skos:definition>
    <skos:definition xml:lang="en">Continental crustal setting dominated by non metamorphosed to low greenschist facies metamorphic rocks, and brittle deformation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperContinentalCrustalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_continental_crustal_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-elevaciones-oceanicas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de elevaciones océanicas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ocean highland setting</skos:prefLabel>
    <skos:definition xml:lang="es">Categoría amplia de ambientes marinos subacuáticos caracterizados por un relieve prominente que se eleva por encima del fondo marino adyacente.</skos:definition>
    <skos:definition xml:lang="en">Broad category for subaqueous marine settings characterized by significant relief above adjacent sea floor.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-dorsal-central-oceanica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-meseta-oceanica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-monte-submarino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/oceanHighlandSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/ocean_highland_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-humedo-y-templado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de clima húmedo y templado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">humid temperate climatic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente con clima estacional que tiene estaciones de calurosas a frías o húmedas a áridas.</skos:definition>
    <skos:definition xml:lang="en">Setting with seasonal climate having hot to cold or humid to arid seasons.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/humidTemperateClimaticSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/humid_temperate_climatic_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-hipoabisal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente hipoabisal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hypabyssal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente ígneo cercano a la superficie terráquea, caracterizado por un enfriamiento más rápido que en el ambiente plutónico para producir rocas ígneas intrusivas generalmente de grano fino que están comúnmente asociadas con rocas volcánicas co-magmáticas.</skos:definition>
    <skos:definition xml:lang="en">Igneous environment close to the Earth's surface, characterized by more rapid cooling than plutonic setting to produce generally fine-grained intrusive igneous rock that is commonly associated with co-magmatic volcanic rocks.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hypabyssalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/hypabyssal_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente litoral</skos:prefLabel>
    <skos:prefLabel xml:lang="en">shoreline setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente geológico caracterizado por su ubicación junto al mar o un lago. Una zona de anchura indefinida (puede tener muchos kilómetros), en borde de una masa de agua que se extiende tierra adentro desde la orilla hasta el primer cambio importante en los rasgos geomorfológicos. Comprende ambientes que pueden ser subaéreos, intermitentemente subacuático, o subacuáticos someros, pero que están intrínsecamente asociados a la interfaz entre la zona terrestre y la masa de agua.</skos:definition>
    <skos:definition xml:lang="en">Geologic settings characterized by location adjacent to the ocean or a lake. A zone of indefinite width (may be many kilometers), bordering a body of water that extends from the water line inland to the first major change in landform features. Includes settings that may be subaerial, intermittently subaqueous, or shallow subaqueous, but are intrinsically associated with the interface between land areas and water bodies.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-isla-barrera"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-dominado-por-carbonatos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-estuarino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-litoral-rocoso"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cordon-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supramareal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/shorelineSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/shoreline_settings"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terraqueo-interno-de-alta-presion-y-baja-temperatura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente terráqueo interno de alta presión y baja temperatura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">high pressure low temperature Earth interior setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente de alta presión caracterizado por un gradiente geotérmico significantemente menor que la geoterma continental estándar; ambiente en el que se forman las rocas metamórficas de la facies de los esquistos azules. Típicamente asociado a la zonas de subducción.</skos:definition>
    <skos:definition xml:lang="en">High pressure environment characterized by geothermal gradient significantly lower than standard continental geotherm; environment in which blueschist facies metamorphic rocks form. Typically associated with subduction zones.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/highPressureLowTemperatureEarthInteriorSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/high_pressure_low_temperature_earth_interior_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Ambiente asociado a evento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Event Environment</skos:prefLabel>
    <dcterms:title xml:lang="es">Ambiente asociado a evento</dcterms:title>
    <dcterms:title xml:lang="en">Event Environment</dcterms:title>
    <skos:definition xml:lang="es">Términos que describen el ambiente geológico en el que ocurre un evento geológico. El entorno puede referirse, por ejemplo, a condiciones deposicionales, tectónicas, metamórficas o magmáticas en las que tuvo lugar el evento.</skos:definition>
    <skos:definition xml:lang="en">Terms describing the geological environment in which a geological event occurs. The environment may refer, for example, to depositional, tectonic, metamorphic, or magmatic conditions under which the event took place.</skos:definition>
    <dcterms:description xml:lang="es">Términos que describen el ambiente geológico en el que ocurre un evento geológico. El entorno puede referirse, por ejemplo, a condiciones deposicionales, tectónicas, metamórficas o magmáticas en las que tuvo lugar el evento.</dcterms:description>
    <dcterms:description xml:lang="en">Terms describing the geological environment in which a geological event occurs. The environment may refer, for example, to depositional, tectonic, metamorphic, or magmatic conditions under which the event took place.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos originales de INSPIRE</dcterms:provenance>
    <dcterms:creator>https://commission.europa.eu/</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Ambiente asociado a evento.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-extraterrestre"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-terrenos-agricolas-y-forestales"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-plataforma-carbonatada"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-talud-deltaico"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-acumulacion-de-polvo"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-area-de-morada"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-deltaico"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/antecosta"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciofluvial"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciolacuste"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciomarino"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/graben"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/semi-graben"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-medioambiente-humano"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intracratonico"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-tierras-recuperadas"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-area-minera"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/salina"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-talud"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manantial"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-zona-de-deposicion-de-residuos-y-materiales"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-humedo-a-subhumedo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-borde-transformante-de-placa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de borde transformante de placa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transform plate boundary setting</skos:prefLabel>
    <skos:definition xml:lang="es">Borde de placa en el que las placas adyacentes se mueven lateralmente la una relativa a la otra.</skos:definition>
    <skos:definition xml:lang="en">Plate boundary at which the adjacent plates are moving laterally relative to each other.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/transformPlateBoundarySetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/transform_plate_boundary_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-plataforma-carbonatada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de plataforma carbonatada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate shelf setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un tipo de plataforma de carbonatos adjunta a una masa de tierra continental y a una zona de sedimentación que es análoga a los ambientes de plataforma para la deposición clástica terrígena. Una plataforma carbonatada puede recibir algún aporte de material de la masa de tierra adyacente.</skos:definition>
    <skos:definition xml:lang="en">A type of carbonate platform that is attached to a continental landmass and a region of sedimentation that is analogous to shelf environments for terrigenous clastic deposition. A carbonate shelf may receive some supply of material from the adjacent landmass.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/carbonateShelfSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-traspais">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente tectónico de traspaís</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hinterland tectonic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente tectónico en la parte interna de un cinturón orogénico, caracterizado por la deformación plástica de las rocas acompañada de un metamorfismo significativo, típicamente involucrando a rocas del basamento cristalino. Típicamente denota la parte más engrosada estructuralmente de un cinturón orogénico, entre un arco magmático o zona de colisión y un ambiente más "externo" de antepaís.</skos:definition>
    <skos:definition xml:lang="en">Tectonic setting in the internal part of an orogenic belt, characterized by plastic deformation of rocks accompanied by significant metamorphism, typically involving crystalline basement rocks. Typically denotes the most structurally thickened part of an orogenic belt, between a magmatic arc or collision zone and a more 'external' foreland setting.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hinterlandTectonicSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/hinterland_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-desembocadura-de-distributario-de-delta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de desembocadura de distributario de delta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">delta distributary mouth setting</skos:prefLabel>
    <skos:definition xml:lang="es">La desembocadura de un canal distributario de delta donde descarga fluvial pasa de un movimiento confinado a unas condiciones de flujo no confinado.</skos:definition>
    <skos:definition xml:lang="en">The mouth of a delta distributary channel where fluvial discharge moves from confined to unconfined flow conditions.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaDistributaryMouthSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/distributary_mouth"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-intraplaca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente tectónico de intraplaca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intraplate tectonic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente tectónicamente estable alejado de cualquier margen activo de placa.</skos:definition>
    <skos:definition xml:lang="en">Tectonically stable setting far from any active plate margins.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-inactivo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-monte-submarino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/intraplateTectonicSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/intraplate_tectonic_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-extraterrestre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente extraterrestre</skos:prefLabel>
    <skos:prefLabel xml:lang="en">extra-terrestrial setting</skos:prefLabel>
    <skos:definition xml:lang="es">Material originado fuera de la Tierra o de su atmósfera.</skos:definition>
    <skos:definition xml:lang="en">Material originated outside of the Earth or its atmosphere.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/extra-terrestrialSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/extra_terrestrial_origin"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-borde-continental">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de borde continental</skos:prefLabel>
    <skos:prefLabel xml:lang="en">continental borderland setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un área del margen continental situado entre entre la costa y el talud continental que es topográficamente más compleja que la plataforma continental. Se caracteriza por presentar crestas y cuencas, algunas de las cuales están por debajo de la profundidad de la plataforma continental. Un ejemplo es el borde continental del sur de California (Jackson, 1997, p. 138).</skos:definition>
    <skos:definition xml:lang="en">An area of the continental margin between the shoreline and the continental slope that is topographically more complex than the continental shelf. It is characterized by ridges and basins, some of which are below the depth of the continental shelf. An example is the southern California continental borderland (Jackson, 1997, p. 138).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/continentalBorderlandSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/continental_borderland_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-fangosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura fangosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mud flat setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un área relativamente nivelada de material de grano fino (por ejemplo, limo) a lo largo de la costa (como en un estuario protegido o la llanura asociada a un chenier) o alrededor de una isla, alternativamente cubierto y descubierto por la marea o cubierto por agua someras, y yermo de vegetación. Incluye la mayoría de las llanuras de marea, pero le falta la denotación de la influencia mareal.</skos:definition>
    <skos:definition xml:lang="en">A relatively level area of fine grained material (e.g. silt) along a shore (as in a sheltered estuary or chenier-plain) or around an island, alternately covered and uncovered by the tide or covered by shallow water, and barren of vegetation. Includes most tidal flats, but lacks denotation of tidal influence.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/mudFlatSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/mud_flat_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-superior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente batial superior</skos:prefLabel>
    <skos:prefLabel xml:lang="en">upper bathyal setting</skos:prefLabel>
    <skos:definition xml:lang="es">El ambiente oceánico en aguas con profundidades comprendidas entre 200 y 600 metros.</skos:definition>
    <skos:definition xml:lang="en">The ocean environment at water depths between 200 and 600 metres.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperBathyalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_bathyal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas-litoral">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de campo de dunas litoral</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coastal dune field setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un campo de dunas en tierras bajas recientemente abandonado o construido por el mar; las dunas puede trepar por un acantilado y desplazarse tierra adentro.</skos:definition>
    <skos:definition xml:lang="en">A dune field on low-lying land recently abandoned or built up by the sea; the dunes may ascend a cliff and travel inland.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/coastalDuneFieldSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/coastal_dune_field"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-de-barrera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de laguna litoral de barrera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">barrier lagoon setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una laguna o albufera que es más o menos paralela a la costa y está separada del mar abierto por una franja de tierra o por una barrera de arrefices. La influencia de las mareas típicamente está restringida y la laguna costera comúnmente es hipersalina.</skos:definition>
    <skos:definition xml:lang="en">A lagoon that is roughly parallel to the coast and is separated from the open ocean by a strip of land or by a barrier reef. Tidal influence is typically restricted and the lagoon is commonly hypersaline.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-isla-barrera"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/barrierLagoonSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/barrier_lagoon"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-inferior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente batial inferior</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lower bathyal setting</skos:prefLabel>
    <skos:definition xml:lang="es">El ambiente oceánico en las profundidades entre los 1.000 y 3.500 metros.</skos:definition>
    <skos:definition xml:lang="en">The ocean environment at depths between 1000 and 3500 metres.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerBathyalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_bathyal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-area-minera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de área minera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mining area setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente con influencia humana en el que los recursos minerales se extraen de la tierra</skos:definition>
    <skos:definition xml:lang="en">Human influence setting in which mineral resources are extracted from the ground.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/miningAreaSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-dominado-por-carbonatos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente litoral dominado por carbonatos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate dominated shoreline setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un ambiente litoral en la que de entrada de terrígeno es comparativamente menor que la producción local de sedimentos de carbonato. La actividad biogénica constructiva es un factor importante en su desarrollo geomorfológico.</skos:definition>
    <skos:definition xml:lang="en">A shoreline setting in which terrigenous input is minor compared to local carbonate sediment production. Constructional biogenic activity is an important element in geomorphic development.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/carbonateDominatedShorelineSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/carbonate_dominated_shoreline_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente en la superficie de la Tierra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">earth surface setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente geológico en la superficie del planeta Tierra.</skos:definition>
    <skos:definition xml:lang="en">Geologic environments on the surface of the solid Earth.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-anoxico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cueva"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laderas"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-humedo-y-templado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-humedo-y-tropical"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-polar"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-humedales"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/earthSurfaceSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/earth_surface_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente en el interior de la Tierra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">earth interior setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente geológico dentro del planeta Tierra .</skos:definition>
    <skos:definition xml:lang="en">Geologic environments within the solid Earth.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-metamorfismo-de-contacto"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terraqueo-interno-de-alta-presion-y-baja-temperatura"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-hipoabisal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-baja-presion-y-alta-temperatura"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mantelico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-metamorfismo-regional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-ultra-alta-presion"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/earthInteriorSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/earth_interior_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-colisional">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente colisional</skos:prefLabel>
    <skos:prefLabel xml:lang="en">collisional setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente tectónico en el que dos placas de corteza continental impactan y son suturadas juntas después de que la corteza oceánica interviniente haya sido enteramente consumida en una zona de subducción que separe las placas. Tal colisión típicamente involucra eventos mayores de formación de montañas, ejemplificados por las cadenas de montañas modernas Alpina y del Himalaya.</skos:definition>
    <skos:definition xml:lang="en">tectonic setting in which two continental crustal plates impact and are sutured together after intervening oceanic crust is entirely consumed at a subduction zone separating the plates. Such collision typically involves major mountain forming events, exemplified by the modern Alpine and Himalayan mountain chains.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/collisionalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/collisional_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-proglacial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente proglacial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">proglacial setting</skos:prefLabel>
    <skos:definition xml:lang="es">Inmediatamente por delante o poco más allá de los límites exteriores de un glaciar o manto de hielo, generalmente en o cerca de su extremo inferior; dicho de lagos, arroyos, depósitos y otras características producidas por o derivados del hielo glaciar.</skos:definition>
    <skos:definition xml:lang="en">Immediately in front of or just beyond the outer limits of a glacier or ice sheet, generally at or near its lower end; said of lakes, streams, deposits, and other features produced by or derived from the glacier ice.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terminal-del-glaciar"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/proglacialSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/proglacial_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-por-encima-de-la-profundidad-de-compensacion-del-carbonato">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente por encima de la profundidad de compensación del carbonato</skos:prefLabel>
    <skos:prefLabel xml:lang="en">above carbonate compensation depth setting</skos:prefLabel>
    <skos:definition xml:lang="es">Medio marino en el que los sedimentos de carbonato no se disuelve antes de llegar al fondo del mar y se puede acumular.</skos:definition>
    <skos:definition xml:lang="en">Marine environment in which carbonate sediment does not dissolve before reaching the sea floor and can accumulate.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/aboveCarbonateCompensationDepthSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/above_carbonate_compensation_depth_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-baja-presion-y-alta-temperatura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de baja presión y alta temperatura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">low pressure high temperature setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente caracterizado por temperaturas significativamente más altas que aquellas asociadas a un gradiente geotérmico continental normal.</skos:definition>
    <skos:definition xml:lang="en">Setting characterized by temperatures significantly higher that those associated with normal continental geothermal gradient.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowPressureHighTemperatureSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/low_pressure_high_temperature_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-fluvial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de canal fluvial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">river channel setting</skos:prefLabel>
    <skos:definition xml:lang="es">El lecho en el que un masa natural de agua superficial fluye o puede fluir; un conducto natural o una depresión de medidas perceptibles conteniendo de forma continua o periódica agua que fluye, o formando la conexión entre dos masas de agua; una corriente de agua.</skos:definition>
    <skos:definition xml:lang="en">The bed where a natural body of surface water flows or may flow; a natural passageway or depression of perceptible extent containing continuously or periodically flowing water, or forming a connecting link between two bodies of water; a watercourse.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-rio-de-canal-trenzado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-de-rio-meandriforme"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/riverChannelSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/river_channel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-metamorfismo-regional">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de metamorfismo regional</skos:prefLabel>
    <skos:prefLabel xml:lang="en">regional metamorphic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Metamorfismo no obviamente localizado a lo largo de contactos de cuerpos ígneos; incluye al metamorfismo de enterramiento y al metamorfismo de fondo oceánico.</skos:definition>
    <skos:definition xml:lang="en">Metamorphism not obviously localized along contacts of igneous bodies; includes burial metamorphism and ocean ridge metamorphism.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/regionalMetamorphicSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/regional_metamorphic_origin"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente relacionado con glaciares</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glacier related setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente situado en la superficie terrestre definido geográficamente por su relación espacial con los glaciares (por ejemplo, encima de un glaciar, yuxtaglaciar o al lado de un glaciar, en frente de un glaciar ...). Los procesos relacionados con el hielo en movimiento dominan el transporte y deposición de sedimentos y el desarrollo de las formas de relieve.</skos:definition>
    <skos:definition xml:lang="en">Earth surface setting with geography defined by spatial relationship to glaciers (e.g. on top of a glacier, next to a glacier, in front of a glacier...). Processes related to moving ice dominate sediment transport and deposition and landform development.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-polar"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-englacial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial-glacial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-yuxtaglaciar"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-proglacial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subglacial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supraglacial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glacierRelatedSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/glacier_related_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-interno">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente nerítico interno</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inner neritic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente oceánico situado a profundidades comprendidas entre el nivel de marea baja y 30 metros.</skos:definition>
    <skos:definition xml:lang="en">The ocean environment at depths between low tide level and 30 metres.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/innerNeriticSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/inner_neritic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de corteza oceánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oceanic-crustal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Aquel tipo de corteza terrestre que subyace a las cuencas oceánicas. La corteza oceánica tiene un espesor de 5-10 km; tiene una densidad de 2.9 g/cm3, y velocidades de las ondas sísmicas compresionales al viajar a través de ella de 4-7.2 km/s. ambiente de la corteza producido por el vulcanismo submarino en una dorsal meso-oceánica.</skos:definition>
    <skos:definition xml:lang="en">That type of the Earth's crust which underlies the ocean basins. The oceanic crust is 5-10 km thick; it has a density of 2.9 g/cm3, and compressional seismic-wave velocities travelling through it at 4-7.2 km/sec. Setting in crust produced by submarine volcanism at a mid ocean ridge.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica-inferior"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica-superior"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/oceanic-crustalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/oceanic_crust"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intracratonico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente intracratónico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intracratonic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una cuenca formada dentro de la región interior de un continente, lejos de los bordes de placa.</skos:definition>
    <skos:definition xml:lang="en">A basin formed within the interior region  of a continent, away from plate boundaries.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/intracratonicSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-rio-de-canal-trenzado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de rio de canal trenzado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">braided river channel setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una corriente que se divide en o presenta una red entrelazada o enmarañada de varios canales pequeños y poco profundos que se ramifican y reúnen y están separados uno del otro por islas o barras de canal efímeras, que se asemejan en planta a las hebras de una compleja trenza. Se cree que este tipo de corriente generalmente indica incapacidad para transportar a la totalidad de la carga sólida, tal como una corriente sobrecargada y en agradación que fluye en un canal ancho sobre la llanura de inundación.</skos:definition>
    <skos:definition xml:lang="en">A stream that divides into or follows an interlacing or tangled network of several small branching and reuniting shallow channels separated from each other by ephemeral branch islands or channel bars, resembling in plan the strands of a complex braid. Such a stream is generally believed to indicate an inability to carry all of its load, such as an overloaded and aggrading stream flowing in a wide channel on a floodplain.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-fluvial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/braidedRiverChannelSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/braided_channel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-isla-barrera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente litoral de isla barrera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">barrier island coastline setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente que trata de incluir los diversos elementos geográficos típicamente asociados con una costa de isla barrera, incluyendo las islas barrera y los elementos geográficos/geomorfológicos que están vinculados con los procesos asociados con la presencia de la isla (por ejemplo, abanicos de derrame, canal de entrada o grao, laguna costera o albufera).</skos:definition>
    <skos:definition xml:lang="en">Setting meant to include all the various geographic elements typically associated with a barrier island coastline, including the barrier islands, and geomorphic/geographic elements that are linked by processes associated with the presence of the island (e.g. wash over fans, inlet channel, back barrier lagoon).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-de-barrera"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-de-barrera"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/barrierIslandCoastlineSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/barrier_island_coastline_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-marisma-mareal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de marisma mareal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tidal marsh setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un marisma que bordea una costa (como en una laguna litoral somera o una bahía protegida), formado por fango y un resistente tapiz de raíces de plantas que toleran la sal, e inundado con regularidad durante la pleamar; un llanura mareal marismeña.</skos:definition>
    <skos:definition xml:lang="en">A marsh bordering a coast (as in a shallow lagoon or sheltered bay), formed of mud and of the resistant mat of roots of salt-tolerant plants, and regularly inundated during high tides; a marshy tidal flat.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pantano-o-marisma"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-mareal"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-marisma-mareal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-marisma-mareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/tidalMarshSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/tidal_marsh"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-medio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente nerítico medio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">middle neritic setting</skos:prefLabel>
    <skos:definition xml:lang="es">El ambiente océanico en aguas de profundidades comprendidas entre 30 y 100 metros.</skos:definition>
    <skos:definition xml:lang="en">The ocean environment at depths between 30 and 100 metres.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/middleNeriticSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/middle_neritic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial-glacial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura aluvial glacial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glacial outwash plain setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una llanura amplia y de pendiente suave formada por aluviones depositados por corrientes de deshielo que fluyen frente o por delante de un glaciar, y que se forma mediante la coalescencia de abanicos aluviales; la superficie de un amplio depósito de aluviones procedentes de un glaciar.</skos:definition>
    <skos:definition xml:lang="en">A broad, gently sloping sheet of outwash deposited by meltwater streams flowing in front of or beyond a glacier, and formed by coalescing outwahs fans; the surface of a broad body of outwash.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glacialOutwashPlainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/glacial_outwash_plain_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-de-barrera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de playa de barrera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">barrier beach setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un cordón estrecho y alargado de arena o grava que se eleva ligeramente por encima del nivel de la marea alta y se extiende paralelo a la costa, pero separada de ella por una laguna costera o albufera (Shepard, 1954, p.1904), estuario o marisma; que se prolonga mediante el transporte litoral y rara vez se extiende a lo largo de más de varios kilómetros.</skos:definition>
    <skos:definition xml:lang="en">A narrow, elongate sand or gravel ridge rising slightly above the high-tide level and extending generally parallel with the shore, but separated from it by a lagoon (Shepard, 1954, p.1904), estuary, or marsh; it is extended by longshore transport and is rarely more than several kilometers long.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-isla-barrera"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/barrierBeachSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/barrier_beach"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente árido o semiárido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">arid or semi arid environment setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente caracterizado por una precipitación media anual de 25 cm (10 pulgadas) o inferior. (Jackson, 1997, p. 172). Equivalente en sentido amplio al ambiente desertico, pero se usa 'árido' para enfatizar la naturaleza climática de la definición del ambiente.</skos:definition>
    <skos:definition xml:lang="en">Setting characterized by mean annual precipitation of 10 inches (25 cm) or less. (Jackson, 1997, p. 172). Equivalent to SLTT 'Desert setting', but use 'Arid' to emphasize climatic nature of setting definition.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-pedregosa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-sabkha-marina-marginal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-endorreica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arenosa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/aridOrSemiAridEnvironmentSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/arid_or_semi_arid_environment_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-litoral-rocoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de litoral rocoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rocky coast setting</skos:prefLabel>
    <skos:definition xml:lang="es">Litoral con un relieve importante y abundantes afloramientos rocosos.</skos:definition>
    <skos:definition xml:lang="en">Shoreline with significant relief and abundant rock outcrop.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/rockyCoastSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/rocky_coast_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-velocidad-media">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de centro de expansión de velocidad media</skos:prefLabel>
    <skos:prefLabel xml:lang="en">medium-rate spreading center setting</skos:prefLabel>
    <skos:definition xml:lang="es">Centro de expansión en el que la velocidad de apertura es entre 50 y 100 mm por año.</skos:definition>
    <skos:definition xml:lang="en">Spreading center at which the opening rate is between 50 and 100 mm per year.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/medium-rateSpreadingCenterSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/medium_spreading_center_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente nerítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">neritic setting</skos:prefLabel>
    <skos:definition xml:lang="es">El ambiente oceánico a profundidades comprendidas entre el nivel de marea baja y 200 metros, o entre el nivel de marea baja y aproximadamente el borde de la plataforma continental.</skos:definition>
    <skos:definition xml:lang="en">The ocean environment at depths between low-tide level and 200 metres, or between low-tide level and approximately the edge of the continental shelf.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-interno"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-medio"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-externo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/neriticSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/neritic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-dorsal-central-oceanica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de dorsal central oceánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mid ocean ridge setting</skos:prefLabel>
    <skos:definition xml:lang="es">Elevación oceánica asociada con una margen continental divergente (centro de expansión). El ambiente se caracteriza por vulcanismo activo, localmente relieve muy inclinado, actividad hidrotermal, y sedimentación pelágica.</skos:definition>
    <skos:definition xml:lang="en">Ocean highland associated with a divergent continental margin (spreading center). Setting is characterized by active volcanism, locally steep relief, hydrothermal activity, and pelagic sedimentation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-elevaciones-oceanicas"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/midOceanRidgeSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/mid_ocean_ridge_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cordon-litoral">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de cordon litoral</skos:prefLabel>
    <skos:prefLabel xml:lang="en">strandplain setting</skos:prefLabel>
    <skos:definition xml:lang="es">Litoral progradante construido mar adentro por el oleaje y las corrientes, y que continua durante alguna distancia a lo largo de la costa. Se caracteriza por los cordones y surcos de playa subparalelos, en lugares con dunas asociadas.</skos:definition>
    <skos:definition xml:lang="en">A prograded shore built seaward by waves and currents, and continuous for some distance along the coast. It is characterized by subparallel beach ridges and swales, in places with associated dunes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/strandplainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/strandplain_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-rift-continental">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de rift continental</skos:prefLabel>
    <skos:prefLabel xml:lang="en">continental rift setting</skos:prefLabel>
    <skos:definition xml:lang="es">Terrreno extendido en una zona de ruptura continental, puede incluir corteza oceánica incipiente. Los ejemplos incluyen el Mar Rojo, el Rift de África Oriental, el Salton Trough.</skos:definition>
    <skos:definition xml:lang="en">Extended terrane in a zone of continental breakup, may include incipient oceanic crust. Examples include Red Sea, East Africa Rift, Salton Trough.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-terreno-extendido"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/continentalRiftSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/continental_rift_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de sistema vertiente de piedemonte</skos:prefLabel>
    <skos:prefLabel xml:lang="en">piedmont slope system setting</skos:prefLabel>
    <skos:definition xml:lang="es">Se localiza en las suaves pendientes a los pies de una montaña; utilizado habitualmente para áreas situadas en cuencas intermontanas. Sus componentes principales incluyen: (a) Una superficie de erosión sobre lecho rocoso adyacente al frente montañoso en retroceso (pedimento, pedimento rocoso); (b) Una superficie constructiva que comprende abanicos aluviales individuales y valles inter abanico, también próxima al frente montañoso; y (c) Un complejo distal de abanicos coalescentes (bajada), y vertientes aluviales sin forma de abanico. Las vertientes del piedemonte pasan gradualmente a llanuras aluviales y lagos temporales de las depresiones del fondo de la cuenca o a superficies asociadas con el drenaje externo.</skos:definition>
    <skos:definition xml:lang="en">Location on gentle slope at the foot of a mountain; generally used in terms of intermontane-basin terrain. Main components include: (a) An erosional surface on bedrock adjacent to the receding mountain front (pediment, rock pediment); (b) A constructional surface comprising individual alluvial fans and interfan valleys, also near the mountain front; and (c) A distal complex of coalescent fans (bajada), and alluvial slopes without fan form. Piedmont slopes grade to basin-floor depressions with alluvial and temporary lake plains or to surfaces associated with through drainage.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-aluvial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pedimento"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/piedmontSlopeSystemSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/piedmont_slope_system_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente litoral de baja energía</skos:prefLabel>
    <skos:prefLabel xml:lang="en">low energy shoreline setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambientes caracterizados por una superficie de pendiente muy baja y proximidad a la costa. Generalmente dentro del ambiente perimareal, pero caracterizada por superficies de gradientes bajos y en general por los procesos sedimentarios de baja energía.</skos:definition>
    <skos:definition xml:lang="en">Settings characterized by very low surface slope and proximity to shoreline. Generally within peritidal setting, but characterized by low surface gradients and generally low-energy sedimentary processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanuras-algares"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-sabkha-marina-marginal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-fangosa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowEnergyShorelineSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/low_energy_shoreline_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-plataforma-continental">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de plataforma continental</skos:prefLabel>
    <skos:prefLabel xml:lang="en">continental shelf setting</skos:prefLabel>
    <skos:definition xml:lang="es">La parte del fondo oceánico que se encuentra entre la costa y el talud continental (o, cuando no hay un talud continental apreciable, una profundidad de 200 m). Se caracteriza por su suave pendiente de 0.1 grados (Jackson, 1997, Pág. 138). Las plataformas continentales tienen un perfil clásico de costa-plataforma-talud denominado 'clinoforma'.</skos:definition>
    <skos:definition xml:lang="en">That part of the ocean floor that is between the shoreline and the continental slope (or, when there is no noticeable continental slope, a depth of 200 m). It is characterized by its gentle slope of 0.1 degree (Jackson, 1997, p. 138). Continental shelves have a classic shoreline-shelf-slope profile termed 'clinoform'.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/continentalShelfSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/continental_shelf_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-rapido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de centro de expansión rápido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fast spreading center setting</skos:prefLabel>
    <skos:definition xml:lang="es">Centro de expansión en el que el ritmo de apertura es mayor que 100 mm por año.</skos:definition>
    <skos:definition xml:lang="en">Spreading center at which the opening rate is greater than 100 mm per year.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/fastSpreadingCenterSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/fast_spreading_center_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciolacuste">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente glaciolacuste</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glaciolacustrine setting</skos:prefLabel>
    <skos:definition xml:lang="es">Lagos en las áreas marginales del hielo y otros lagos relacionados con glaciares. En el lugar donde los arroyos de deshielo entran al lago, las arenas y gravas se depositan formando deltas. En el fondo del lago, se depositan ritmitas típicas (varvas).</skos:definition>
    <skos:definition xml:lang="en">Ice margin lakes and other lakes related to glaciers. Where meltwater streams enter the lake, sands and gravels are deposited in deltas. At the lake floor, typivally rhythmites (varves) are deposited.Ice margin lakes and other lakes related to glaciers.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glaciolacustrineSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-zona-de-subducion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de zona de subdución</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subduction zone setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente tectónico en el que una placa tectónica, por lo general oceánica, se desplaza hacia el interior del manto por debajo de otra placa superior.</skos:definition>
    <skos:definition xml:lang="en">Tectonic setting at which a tectonic plate, usually oceanic, is moving down into the mantle beneath another overriding plate.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/subductionZoneSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/subduction_zone_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cuenca-pantanosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de cuenca pantanosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basin bog setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una turbera o pantano ombrotróphica u ombrogénica cuyo aporte en nutrientes procede exclusivamente del agua de lluvia (incluyendo nieve y precipitación atmosférica) lo que la hace extremadamente oligotrófica en nutrientes.</skos:definition>
    <skos:definition xml:lang="en">An ombrotrophic or ombrogene peat/bog whose nutrient supply is exclusively from rain water (including snow and atmospheric fallout) therefore making nutrients extremely oligotrophic.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/basinBogSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/basin_bog"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-la-bahia-interdistributaria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de la bahía interdistributaria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">interdistributary bay setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una indentación pronunciada del frente del delta entre corrientes distributarias avanzadas, ocupada por aguas poco profundas, y ya sea abierta al mar o parcialmente delimitada por distributarios menores.</skos:definition>
    <skos:definition xml:lang="en">A pronounced indentation of the delta front between advancing stream distributaries, occupied by shallow water, and either open to the sea or partly enclosed by minor distributaries.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/interdistributaryBaySetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/interdistributary_bay"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-mareal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de canal mareal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tidal channel setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un canal principal recorrido por las corrientes de marea, que se extiende desde el mar abierto hacia el interior de una marisma mareal o una llanura mareal.</skos:definition>
    <skos:definition xml:lang="en">A major channel followed by the tidal currents, extending from offshore into a tidal marsh or a tidal flat.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/tidalChannelSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/tidal_channel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de centro de expansión activo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">active spreading center setting</skos:prefLabel>
    <skos:definition xml:lang="es">Margen divergente de placas en el que se está formando nueva corteza oceánica</skos:definition>
    <skos:definition xml:lang="en">Divergent plate margin at which new oceanic crust is being formed.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-placa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-rapido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-velocidad-media"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/centro-de-expansion-lenta"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/activeSpreadingCenterSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/active_spreading_center"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/centro-de-expansion-lenta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">centro de expansión lenta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slow spreading center setting</skos:prefLabel>
    <skos:definition xml:lang="es">Centro de expansión en el que la velocidad de apertura es menor que 50 mm por año.</skos:definition>
    <skos:definition xml:lang="en">Spreading center at which the opening rate is less than 50 mm per year.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/slowSpreadingCenterSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/slow_spreading_center_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente terrestre</skos:prefLabel>
    <skos:prefLabel xml:lang="en">terrestrial setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente caracterizado por la ausencia de influencia marina directa. La mayor parte de los ambientes subaéreos también son terrestres, pero los ambientes lacustres, aunque son terrestres, no son subaéreos, por lo que los ambientes subaéreos no están incluidos como una subcategoría.</skos:definition>
    <skos:definition xml:lang="en">Setting characterized by absence of direct marine influence. Most of the subaerial settings are also terrestrial, but lacustrine settings, while terrestrial, are not subaerial, so the subaerial settings are not included as subcategories.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-pedregosa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial-glacial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-lacustre"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-endorreica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arenosa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-alta"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/terrestrialSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/terrestrial_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-postarrecifal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente postarrecifal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">backreef setting</skos:prefLabel>
    <skos:definition xml:lang="es">El paraje situado hacía tierra de un arrecife. El término se utiliza a menudo como adjetivo para referirse a los depósitos de la laguna costera restringida o albufera situada detrás de una barra arrecifal, como los "facies postarrecifales" de depósitos lagunares. En algunos casos, como en las plataformas arrecifales, " postarrecifales " se refiere a la parte del arrecife alejado del mar abierto, a pesar de que la tierra puede no estar próxima.</skos:definition>
    <skos:definition xml:lang="en">The landward side of a reef. The term is often used adjectivally to refer to deposits within the restricted lagoon behind a barrier reef, such as the "back-reef facies" of lagoonal deposits. In some places, as on a platform-edge reef tract, "back reef" refers to the side of the reef away from the open sea, even though no land may be nearby.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arrecife-biologico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/backreefSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/backreef"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de playa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">beach setting</skos:prefLabel>
    <skos:definition xml:lang="es">El material no consolidado en la línea de costa que cubre una zona de poca profundidad, por lo general con un perfil cóncavo, que se extiende hacia tierra desde la línea de bajamar al lugar donde hay un cambio definitivo de material o forma fisiográfica (como por ejemplo un acantilado), o la línea de vegetación permanente (por lo general el límite efectivo de las olas más altas de tormenta); en la orilla de un cuerpo de agua, formado y bañada por las olas o mareas, por lo general cubiertos por arena o grava, y que carecen de una superficie rocosa desnuda.</skos:definition>
    <skos:definition xml:lang="en">The unconsolidated material at the shoreline that covers a gently sloping zone, typically with a concave profile, extending landward from the low-water line to the place where there is a definite change in material or physiographic form (such as a cliff), or to the line of permanent vegetation (usually the effective limit of the highest storm waves); at the shore of a body of water, formed and washed by waves or tides, usually covered by sand or gravel, and lacking a bare rocky surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-de-barrera"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/beachSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/beach"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mantelico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente mantélico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mantle setting</skos:prefLabel>
    <skos:definition xml:lang="es">La zona de La Tierra por debajo de la corteza y por encima del núcleo, que se divide en el manto superior y el manto inferior, con una zona de transición separándolos.</skos:definition>
    <skos:definition xml:lang="en">The zone of the Earth below the crust and above the core, which is divided into the upper mantle and the lower mantle, with a transition zone separating them.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-inferior"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-superior"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/mantleSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/mantle"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-talud">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de talud</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slope-rise setting</skos:prefLabel>
    <skos:definition xml:lang="es">La parte de una cuenca subacuática que se localiza entre la orla del ambiente de plataforma, que separa la cuenca de la masa terrestre adyacente, y el ambiente de relieve muy bajo de la llanura de cuenca.</skos:definition>
    <skos:definition xml:lang="en">The part of a subaqueous basin that is between a bordering shelf setting, which separate the basin from an adjacent landmass, and a very low-relief basin plain setting.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/slope-riseSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/slope_rise_settings"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-acumulacion-de-polvo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de acumulación de polvo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dust accumulation setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente en el que se acumulan partículas de grano fino, por ejemplo, deposición de loess.</skos:definition>
    <skos:definition xml:lang="en">Setting in which finegrained particles accumulate, e.g. loess deposition.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/dustAccumulationSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-abisal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente abisal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">abyssal setting</skos:prefLabel>
    <skos:definition xml:lang="es">El medio o ambiente marino de aguas con profundidades entre 3.500 y 6.000 metros. La zona abisal es parte del fondo marino profundo que exhibe una fauna uniformes y se caracteriza generalmente por su falta de nutrientes, alto contenido de oxígeno, y la casi total falta de luz solar. La zona se caracteriza por las aguas frías de continuamente. La zona abisal es parte del fondo marino profundo que exhibe una fauna uniformes y se caracteriza generalmente por su falta de nutrientes, alto contenido de oxígeno, y la casi total falta de luz solar. La zona se caracteriza por las aguas frías de continuamente</skos:definition>
    <skos:definition xml:lang="en">The ocean environment at water depths between 3,500 and 6,000 metres. The Abyssal zone is a part of the deep sea floor that exhibits a uniform fauna and is generally noted for its lack of nutrients, high oxygen content, and almost total lack of sunlight. The zone is characterized by continuously cold waters of approximately. The Abyssal zone is a part of the deep sea floor that exhibits a uniform fauna and is generally noted for its lack of nutrients, high oxygen content, and almost total lack of sunlight. The zone is characterized by continuously cold waters of approximately</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/abyssalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/abyssal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-inundacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura de inundación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">floodplain setting</skos:prefLabel>
    <skos:definition xml:lang="es">La superficie o franja de tierra relativamente lisa junto a un canal fluvial, construida por el río en su régimen actual y que queda cubierta por el agua cuando el río se desborda. Está construido por los aluviones transportados por el río durante las crecidas y depositado en aguas estancadas alejadas de la influencia de las corrientes más rápidas. Un río tiene una llanura de inundación y puede tener una o varias terrazas que representan llanuras de inundación abandonadas.</skos:definition>
    <skos:definition xml:lang="en">The surface or strip of relatively smooth land adjacent to a river channel, constructed by the present river in its existing regimen and covered with water when the river overflows its banks. It is built of alluvium carried by the river during floods and deposited in the sluggish water beyond the influence of the swiftest current. A river has one floodplain and may have one or more terraces representing abandoned floodplains.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/floodplainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/floodplain"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-por-debajo-de-la-profundidad-de-compensacion-del-carbonato">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente por debajo de la profundidad de compensación del carbonato</skos:prefLabel>
    <skos:prefLabel xml:lang="en">below carbonate compensation depth setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente marino en el que el agua es lo suficientemente profunda como para que los sedimentos de carbonato se disuelvan antes de que lleguen a acumularse en el fondo del mar.</skos:definition>
    <skos:definition xml:lang="en">Marine environment in which water is deep enough that carbonate sediment goes into solution before it can accumulate on the sea floor.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/belowCarbonateCompensationDepthSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/below_carbonate_compensation_depth_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de campo de dunas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dunefield setting</skos:prefLabel>
    <skos:definition xml:lang="es">Depósitos extensos sobre arena en una zona donde el suministro es abundante. Característicamente, las dunas individuales se asemejan algo a los barjanes pero son de forma muy irregulares y están apiladas; por ejemplo las áreas de erg del Sahara.</skos:definition>
    <skos:definition xml:lang="en">Extensive deposits on sand in an area where the supply is abundant. As a characteristic, individual dunes somewhat resemble barchans but are highly irregular in shape and crowded; erg areas of the Sahara are an example.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas-litoral"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/dunefieldSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/dunefield"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente subaéreo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subaerial setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente en la interfaz entre la tierra sólida y la atmosfera, incluye algunos ambientes subacuáticos someros en cauces fluviales y playas endorreicas. Caracterizado por condiciones ambientales y procesos, como la erosión, presentes o funcionales al aire libre o inmediatamente adyacentes a la superficie terrestre.</skos:definition>
    <skos:definition xml:lang="en">Setting at the interface between the solid earth and the atmosphere, includes some shallow subaqueous settings in river channels and playas. Characterized by conditions and processes, such as erosion, that exist or operate in the open air on or immediately adjacent to the land surface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-pedregosa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-endorreica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cordon-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supramareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/subaerialSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/subaerial_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-placa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de centro de expansión de placa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">plate spreading center setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente tectónico donde se está formando o ha sido formada nueva corteza oceánica en un límite divergente de placas. Incluye centros de expansión activos e inactivos.</skos:definition>
    <skos:definition xml:lang="en">Tectonic setting where new oceanic crust is being or has been formed at a divergent plate boundary. Includes active and inactive spreading centers.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-inactivo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/plateSpreadingCenterSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/plate_spreading_center"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente tectónicamente definido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tectonically defined setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente definido por su relación con placas tectónicas de la Tierra.</skos:definition>
    <skos:definition xml:lang="en">Setting defined by relationships to tectonic plates on or in the Earth.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-trasera-de-arco"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-colisional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-terreno-extendido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-antepais"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-traspais"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-punto-caliente"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-intraplaca"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mantelico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-continental-pasivo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-de-placa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/tectonicallyDefinedSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/tectonic_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-monte-submarino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de monte submarino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">seamount setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente que consiste de una montaña cónica sobre el fondo oceánico (guyot). Típicamente caracterizado por vulcanismo activo y sedimentación pelágica. Si la montaña es suficientemente alta como para alcanzar la zona fótica, la producción de carbonatos puede resultar en la construcción de arrecifes para producir un ambiente de plataforma carbonatada o de atolón.</skos:definition>
    <skos:definition xml:lang="en">Setting that consists of a conical mountain on the ocean floor (guyot). Typically characterized by active volcanism, pelagic sedimentation. If the mountain is high enough to reach the photic zone, carbonate production may result in reef building to produce a carbonate platform or atoll setting.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-intraplaca"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-elevaciones-oceanicas"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/seamountSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/seamount_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cueva">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de cueva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cave setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un espacio natural abierto y subterránea; generalmente tiene una conexión con la superficie, es suficiente grande para que una persona penetre, y se prolonga en la oscuridad. El tipo más común de cueva se forma en las calizas por disolución.</skos:definition>
    <skos:definition xml:lang="en">A natural underground open space; it generally has a connection to the surface, is large enough for a person to enter, and extends into darkness. The most common type of cave is formed in limestone by dissolution.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/caveSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/cave"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-metamorfismo-de-contacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de metamorfismo de contacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contact metamorphic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Metamorfismo de las rocas encajantes en el contacto con un cuerpo ígneo.</skos:definition>
    <skos:definition xml:lang="en">Metamorphism of country rock at the contact of an igneous body.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/contactMetamorphicSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/contact_metamorphic_origin"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-fosa-de-aguas-profundas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de fosa de aguas profundas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deep sea trench setting</skos:prefLabel>
    <skos:definition xml:lang="es">Cuenca oceánica profunda con pendientes empinadas (promedio de 10 grados) hacia la tierra, y pendientes más suave (promedio de 5 grados) hacia el mar, y abundante actividad sísmica en el lado de la fosa hacia tierra. No se designa por la profundidad del agua, pero puede llegar a ser muy profunda.</skos:definition>
    <skos:definition xml:lang="en">Deep ocean basin with steep (average 10 degrees) slope toward land, more gentle slope (average 5 degrees) towards the sea, and abundant seismic activity on landward side of trench. Does not denote water depth, but may be very deep.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deepSeaTrenchSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/deep_sea_trench"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-frente-de-delta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de frente de delta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">delta front setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una zona estrecha, en la que la deposición de los deltas es más activa, que consiste en una lámina continua de arena, y ocurre dentro de la zona de profundidad de erosión efectiva de las olas (10 m o menos). Es la zona que separa el prodelta de la llanura deltaica, y puede o no puede ser escarpada</skos:definition>
    <skos:definition xml:lang="en">A narrow zone where deposition in deltas is most active, consisting of a continuous sheet of sand, and occurring within the effective depth of wave erosion (10 m or less). It is the zone separating the prodelta from the delta plain, and it may or may not be steep"</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaFrontSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/delta_front"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-antepais">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de antepaís</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foreland setting</skos:prefLabel>
    <skos:definition xml:lang="es">El área exterior de un cinturón orogénico donde la deformación ocurre sin un metamorfismo significativo. Generalmente el antepaís está más proximo al interior del continente de lo que lo están otras partes del cinturón orogénico.</skos:definition>
    <skos:definition xml:lang="en">The exterior area of an orogenic belt where deformation occurs without significant metamorphism. Generally the foreland is closer to the continental interior than other portions of the orogenic belt are.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/forelandSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/foreland_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de margen de placa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">plate margin setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente tectónico en el límite entre dos placas tectónicas</skos:definition>
    <skos:definition xml:lang="en">Tectonic setting at the boundary between two tectonic plates.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-continental-activo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-centro-de-expansion-activo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-antearco"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-zona-de-subducion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-borde-transformante-de-placa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arco-volcanico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/plateMarginSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/plate_margin_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente pantanoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bog setting</skos:prefLabel>
    <skos:definition xml:lang="es">Suelo esponjoso y empapado en agua, principalmente consistente en musgos, que contiene vegetación ácida en descomposición que puede convertirse en turba.</skos:definition>
    <skos:definition xml:lang="en">Waterlogged, spongy ground, consisting primarily of mosses, containing acidic, decaying vegetation that may develop into peat.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-humedales"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cuenca-pantanosa"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-pantanoso"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/bogSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/bog"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-humedales">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de humedales</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wetland setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente que se caracteriza por una superficie de pendiente suave, y al menos por la presencia intermitente de agua estanca, que puede ser dulce, salobre o salina. Los Humedales pueden ser de ambiente terrestre o de ambiente litoral.</skos:definition>
    <skos:definition xml:lang="en">Setting characterized by gentle surface slope, and at least intermittent presence of standing water, which may be fresh, brackish, or saline. Wetland may be terrestrial setting or shoreline setting.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pantano-o-marisma"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/wetlandSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/wetland_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-baja">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura deltaica baja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lower delta plain setting</skos:prefLabel>
    <skos:definition xml:lang="es">La parte de una llanura deltaica en la que penetra el agua salina y está sometida a los procesos de marea.</skos:definition>
    <skos:definition xml:lang="en">The part of a delta plain which is penetrated by saline water and is subject to tidal processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerDeltaPlainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_delta_plain"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de procesos eólicos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">aeolian process setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente sedimentario en el que el viento es el proceso dominante que produce, transporta y deposita los sedimentos. Normalmente presenta un relieve bajo, llano o con fisiografía de piedemonte.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary setting in which wind is the dominant process producing, transporting, and depositing sediment. Typically has low-relief plain or piedmont slope physiography.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-campo-de-dunas"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arenosa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/aeolianProcessSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/aeolian_process_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-anoxico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente anóxico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anoxic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente pobre en oxígeno, normalmente subacuático.</skos:definition>
    <skos:definition xml:lang="en">Setting depleted in oxygen, typically subaqueous.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/anoxicSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/anoxic_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-polar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de clima polar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polar climatic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente con clima sujeto a temperaturas por debajo de la temperatura la congelación del agua. Incluye desiertos polares debido a que la precipitación es generalmente escasa a latitudes altas. Climáticamente controlado por las masas de aire ártico, ambiente frío y seco con verano corto.</skos:definition>
    <skos:definition xml:lang="en">Setting with climate dominated by temperatures below the freezing temperature of water. Includes polar deserts because precipitation is generally scant at high latitude. Climatically controlled by arctic air masses, cold dry environment with short summer.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/polarClimaticSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/polar_climatic_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de corteza continental</skos:prefLabel>
    <skos:prefLabel xml:lang="en">continental-crustal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Aquel tipo de corteza terrestre que subyace a los continentes y a las plataformas continentales; es equivalente al sial y al sima continental y varía en espesor desde cerca de 25 km a más de 70 km bajo las cordilleras de montañas, con un promedio de ~40 km. La densidad promedio de la corteza continental es de ~2.8 g/cm3 y es de ~2.7 g.cm3 en la capa superior. Las velocidades promedio de las ondas sísmicas compresionales que la atraviesan son de ~6.5 km/s y son menores de  ~7.0 km/s.</skos:definition>
    <skos:definition xml:lang="en">That type of the Earth's crust which underlies the continents and the continental shelves; it is equivalent to the sial and continental sima and ranges in thickness from about 25 km to more than 70 km under mountain ranges, averaging ~40 km. The density of the continental crust averages ~2.8 g/cm3 and is ~2.7 g.cm3 in the upper layer. The velocities of compressional seismic waves through it average ~6.5 km/s and are less than ~7.0 km/sec.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-colisional"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-antepais"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonico-de-traspais"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-inferior"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-media"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-superior"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/continental-crustalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/continental_crust"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-aluvial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de abanico aluvial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alluvial fan setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una masa de materiales rocosos sueltos, baja y extendida, relativamente plana a ligeramente inclinada, en forma de un abanico abierto o de segmento de cono, depositado por una corriente (especialmente en regiones semiáridas) en el lugar donde desemboca desde un estrecho valle de montaña hacia un valle llano o amplio, o donde una corriente afluente está próxima a su unión con la corriente principal, o donde la constricción de un valle cesa bruscamente o el gradiente de la corriente disminuye repentinamente; es más empinado cerca de la desembocadura del valle donde su vértice o paice apunta aguas arriba, y su se inclina suavemente y de forma convexa hacia el exterior mediante la disminución gradual de la pendiente.</skos:definition>
    <skos:definition xml:lang="en">A low, outspread, relatively flat to gently sloping mass of loose rock material, shaped like an open fan or a segment of a cone, deposited by a stream (esp. in a semiarid region) at the place where it issues from a narrow mountain valley upon a plain or broad valley, or where a tributary stream is near or at its junction with the main stream, or wherever a constriction in a valley abruptly ceases or the gradient of the stream suddenly decreases; it is steepest near the mouth of the valley where its apex points upstream, and it slopes gently and convexly outward with gradually decreasing gradient.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/alluvialFanSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/alluvial_fan"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-estuarino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de delta estuarino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">estuarine delta setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un delta que ha llenado, o se encuentra en el proceso de llenar, un estuario.</skos:definition>
    <skos:definition xml:lang="en">A delta that has filled, or is in the process of filling, an estuary.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-estuarino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/estuarineDeltaSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/estuarine_delta"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/salina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">salina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">salt pan</skos:prefLabel>
    <skos:definition xml:lang="es">Una depresión pequeña sin drenaje, somera en la cual el agua se acumula y se evapora, dejando un depósito de sal</skos:definition>
    <skos:definition xml:lang="en">A small, undrained, shallow depression in which water accumulates and evaporates, leaving a salt deposit.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/saltPan"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-zona-de-deposicion-de-residuos-y-materiales">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de zona de deposición de residuos y materiales</skos:prefLabel>
    <skos:prefLabel xml:lang="en">waste and material deposition area setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente de influencia humana en el que se depositan materiales no naturales o materiales naturales procedentes de otros lugares.</skos:definition>
    <skos:definition xml:lang="en">Human influence setting in which non-natural or natural materials from elsewhere are deposited.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/wasteAndMaterialDepositionAreaSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica-superior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de corteza oceánica superior</skos:prefLabel>
    <skos:prefLabel xml:lang="en">upper oceanic crustal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente de corteza oceánica dominado por rocas extrusivas, sedimentos oceánicos abisales, con crecientes rocas máficas intrusivas en su parte inferior.</skos:definition>
    <skos:definition xml:lang="en">Oceanic crustal setting dominated by extrusive rocks, abyssal oceanic sediment, with increasing mafic intrusive rock in lower part.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperOceanicCrustalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_oceanic_crustal_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de sistema de llanura fluvial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">river plain system setting</skos:prefLabel>
    <skos:definition xml:lang="es">El ambiente geológico dominado por un sistema fluvial; las llanuras fluviales pueden aparecer en cualquier contexto climático. Comprende los canales activos, canales abandonados, albardones o diques naturales, lagos de meandro abandonado o galachos, llanura de inundación. Puede ser parte de una llanura aluvial que incluye terrazas formadas por los depósitos de llanuras fluviales abandonadas.</skos:definition>
    <skos:definition xml:lang="en">Geologic setting dominated by a river system; river plains may occur in any climatic setting. Includes active channels, abandoned channels, levees, oxbow lakes, flood plain. May be part of an alluvial plain that includes terraces composed of abandoned river plain deposits.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cauce-fluvial-abandonado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-meandro-estrangulado"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-inundacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-fluvial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/riverPlainSystemSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/river_plain_system_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-estuarino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente estuarino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">estuary setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambientes situados en el extremo marítimo o la desembocadura mareal en forma de embudo ensanchado de un valle fluvial donde el agua dulce entra en contacto con agua de mar y donde los efectos de marea son evidentes (adaptado de Glosario de Geología, Jackson, 1997, p. 217).</skos:definition>
    <skos:definition xml:lang="en">Environments at the seaward end or the widened funnel-shaped tidal mouth of a river valley where fresh water comes into contact with seawater and where tidal effects are evident (adapted from Glossary of Geology, Jackson, 1997, p. 217).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-estuarino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-estuarina"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/estuarySetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/estuary_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intermareal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente intermareal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intertidal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Perteneciente al ambiente marino bentónico o zona de profundidad entre la pleamar y la bajamar; también, relativo a los organismos de ese ambiente.</skos:definition>
    <skos:definition xml:lang="en">Pertaining to the benthic ocean environment or depth zone between high water and low water; also, pertaining to the organisms of that environment.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/intertidalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/intertidal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-terreno-extendido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de terreno extendido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">extended terrane setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente tectónico caracterizado por la extensión de la corteza superior, manifestada por la formación de fisiografía en valles de rift o en basin and range.</skos:definition>
    <skos:definition xml:lang="en">Tectonic setting characterized by extension of the upper crust, manifested by formation of rift valleys or basin and range physiography, with arrays of low to high angle normal faults. Modern examples include the North Sea, East Africa, and the Basin and Range of the North American Cordillera. Typically applied in continental crustal settings.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-rift-continental"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/extendedTerraneSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/extended_terrane"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-continental-pasivo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de margen continental pasivo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">passive continental margin setting</skos:prefLabel>
    <skos:definition xml:lang="es">Límite de la corteza continental con la corteza oceánica de una cuenca oceánica que no es una zona de subducción o un sistema de fallas transformantes. Generalmente se formó por rifting del margen continental cuando se inició la formación de la cuenca oceánica.</skos:definition>
    <skos:definition xml:lang="en">Boundary of continental crust into oceanic crust of an oceanic basin that is not a subduction zone or transform fault system. Generally is rifted margin formed when ocean basin was initially formed.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/passiveContinentalMarginSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/passive_continental_margin_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente cortical</skos:prefLabel>
    <skos:prefLabel xml:lang="en">crustal setting</skos:prefLabel>
    <skos:definition xml:lang="es">La capa o envoltura más externa de La Tierra, definida de acuerdo con varios criterios, incluyendo velocidad sísmica, densidad y composición; aquella parte de La Tierra por encima de la discontinuidad de Mohorovicic, constituida por el sial y el sima.</skos:definition>
    <skos:definition xml:lang="en">The outermost layer or shell of the Earth, defined according to various criteria, including seismic velocity, density and composition; that part of the Earth above the Mohorovicic discontinuity, made up of the sial and the sima.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-el-interior-de-la-tierra"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-transicional"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/crustalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/crust"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supraglacial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente supraglacial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">supraglacial setting</skos:prefLabel>
    <skos:definition xml:lang="es">"Transportado sobre, depositado a partir de, o en relación con la superficie superior de un manto de hielo o un glaciar; dicho de corrientes de agua de deshielo, el till, derrubios, etc." (Jackson, 1997, p 639.). Dreimanis (1988, p. 39) recomienda que "supraglacial" reemplace "superglacial".</skos:definition>
    <skos:definition xml:lang="en">"Carried upon, deposited from, or pertaining to the top surface of a glacier or ice sheet; said of meltwater streams, till, drift, etc. " (Jackson, 1997, p. 639). Dreimanis (1988, p. 39) recommendation that "supraglacial" supersede "superglacial" is followed.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/supraglacialSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/supraglacial_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciomarino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente glaciomarino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glaciomarine setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un medio marino con fluencia de los glaciares. Los dropstones, el diamicton y los fangos con dropstones son los depósitos típicos en este ambiente.</skos:definition>
    <skos:definition xml:lang="en">A marine environment influenced by glaciers. Dropstone diamictons and dropstone muds are typical deposits in this environment.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glaciomarineSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-supramareal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente supramareal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">supratidal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Perteneciente a la zona costera marginal a la zona litoral, justo por encima del nivel pleamar.</skos:definition>
    <skos:definition xml:lang="en">Pertaining to the shore area marginal to the littoral zone, just above high-tide level.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/supratidalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/supratidal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-continental-activo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de margen continental activo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">active continental margin setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente de margen de placa sobre corteza continental</skos:definition>
    <skos:definition xml:lang="en">Plate margin setting on continental crust.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/activeContinentalMarginSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/active_continental_margin_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-aluvial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura aluvial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alluvial plain setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una conjunto de formas del terreno producidas por procesos aluviales y fluviales (ríos trenzados, terrazas, etc.,) que forman áreas de baja pendiente, rampas en las regiones situadas a lo largo de los flancos de las montañas y se extienden grandes distancias de sus fuentes (por ejemplo, altas planicies de América del Norte). (NRCS GLOSARIO DE geomorfología y términos geológicos). Un territorio de pendiente suave o una superficie ligeramente ondulada producida por extensa deposición de aluviones. Synonimos - lavar llanura fluvial; llanura de agradación fluvial. (Jackson, 1997, p. 17). Puede incluir uno o más sistemas de llanuras aluviales</skos:definition>
    <skos:definition xml:lang="en">An assemblage landforms produced by alluvial and fluvial processes (braided streams, terraces, etc.,) that form low gradient, regional ramps along the flanks of mountains and extend great distances from their sources (e.g., High Plains of North America). (NRCS GLOSSARY OF LANDFORM AND GEOLOGIC TERMS). A level or gently sloping tract or a slightly undulating land surface produced by extensive deposition of alluvium... Synonym-- wash plain;...river plain; aggraded valley plain;... (Jackson, 1997, p. 17). May include one or more River plain systems.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/alluvialPlainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/alluvial_plain"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pedimento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de pedimento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pediment setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una superficie erosiva suavemente inclinada desarrollada al pie de la ladera en retroceso de una colina o una montaña. La superficie puede estar básicamente desnuda, exponiendo los materiales que se extienden debajo de las elevaciones adyacentes; o puede estar cubierta por un fino manto de aluviones y coluviones, finalmente está situada en el tránsito entre el frente de las elevaciones y la zona deprimida de una cuenca o un valle. En las áreas situadas al pie de laderas de colinas ese manto se suele denominar pedisedimento, pedimento cubierto o glacis de cobertera. El término se ha utilizado en varios contextos geomorfológicos: los pedimentos pueden clasificarse con respecto a (a) su posición en el paisaje, por ejemplo, en el piedemonte de una cuenca intermontana o al pie de la ladera del borde de un valle (respectivamente denominados, pedimento de falda montañosa y pedimento en terraza o glacis terraza (Cooke y Warren, 1973) ); (b) por el tipo de material erosionado, rocoso o regolítico; o (c) combinaciones de los anteriores. Comparar – ladera de piedemonte.</skos:definition>
    <skos:definition xml:lang="en">A gently sloping erosional surface developed at the foot of a receding hill or mountain slope. The surface may be essentially bare, exposing earth material that extends beneath adjacent uplands; or it may be thinly mantled with alluvium and colluvium, ultimately in transit from upland front to basin or valley lowland. In hill-foot slope terrain the mantle is designated "pedisediment." The term has been used in several geomorphic contexts: Pediments may be classed with respect to (a) landscape positions, for example, intermontane-basin piedmont or valley-border footslope surfaces (respectively, apron and terrace pediments (Cooke and Warren, 1973)); (b) type of material eroded, bedrock or regolith; or (c) combinations of the above. compare - Piedmont slope.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-vertiente-de-piedemonte"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/pedimentSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/pediment_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-humedo-a-subhumedo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente húmedo a subhúmedo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wet to sub-humid setting</skos:prefLabel>
    <skos:definition xml:lang="es">Según el sistema de clasificación climática de Thornthwaite un clima húmedo a subhúmedo está asociados a la pluviselva (húmedos), los bosques (húmedos) y los pastizales (sub-húmedo).</skos:definition>
    <skos:definition xml:lang="en">A Wet to sub-humid climate is according Thornthwaite's climate classification system associated with rain forests (wet), forests (humid) and grassland (sub-humid).</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/wetToSub-humidSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente marino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">marine setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente caracterizado por su ubicación bajo de la superficie del mar.</skos:definition>
    <skos:definition xml:lang="en">Setting characterized by location under the surface of the sea.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-por-encima-de-la-profundidad-de-compensacion-del-carbonato"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-abisal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-cuenca"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-por-debajo-de-la-profundidad-de-compensacion-del-carbonato"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arrecife-biologico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-borde-continental"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-plataforma-continental"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-fosa-de-aguas-profundas"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino-epicontinental"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-hadal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-plataforma-carbonatada-marina"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-elevaciones-oceanicas"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-submarino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/marineSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/marine_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-terrenos-agricolas-y-forestales">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de terrenos agrícolas y forestales</skos:prefLabel>
    <skos:prefLabel xml:lang="en">agricultural and forestry land setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente con influencia humana debido a la agricultura intensiva o uso forestal del suelo, incluyendo las plantaciones forestales.</skos:definition>
    <skos:definition xml:lang="en">Human influence setting with intensive agricultural activity or forestry land use,  including forest plantations.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/agriculturalAndForestryLandSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-litoral">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura litoral</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coastal plain setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una llanura de relieve bajo al borde de una masa de agua que se extiende tierra adentro en las elevaciones más cercanas, con una pendiente muy suave hacia la masa de agua. Se distingue de llanura aluvial por la presencia de depósitos o morfologías relictas relacionadas con el litoral.</skos:definition>
    <skos:definition xml:lang="en">A low relief plain bordering a water body extending inland to the nearest elevated land, sloping very gently towards the water body. Distinguished from alluvial plain by presence of relict shoreline-related deposits or morphology.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/coastalPlainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/coastal_plain_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura deltaica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">delta plain setting</skos:prefLabel>
    <skos:definition xml:lang="es">La superficie llana o casi llana que compone la parte terrestre de un delta grande o complejo; en sentido estricto, una llanura aluvial caracteriza por la bifurcación y divergencia repetida de canales, numerosos canales distributarios, y cuencas de inundación interdistributarias.</skos:definition>
    <skos:definition xml:lang="en">The level or nearly level surface composing the landward part of a large or compound delta; strictly, an alluvial plain characterized by repeated channel bifurcation and divergence, multiple distributary channels, and interdistributary flood basins.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-baja"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-alta"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaPlainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/delta_plain"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/antecosta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">antecosta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foreshore</skos:prefLabel>
    <skos:definition xml:lang="es">La antecosta es la región situada entre la pleamar media y la media de las marcas de la bajamar de las mareas. Dependiendo de la amplitud de la marea puede ser una distancia vertical cualquiera, desde unas pocas decenas de centímetros a varios metros.</skos:definition>
    <skos:definition xml:lang="en">A foreshore is the region between mean high water and mean low water marks of the tides. Depending on the tidal range this may be a vertical distance of anything from a few tens of centimetres to many meters.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/foreshore"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-externo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente nerítico externo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">outer neritic setting</skos:prefLabel>
    <skos:definition xml:lang="es">El ambiente oceánico a profundidades comprendidas entre 100 metros y aproximadamente el borde de la plataforma continental o entre 100 y 200 metros.</skos:definition>
    <skos:definition xml:lang="en">The ocean environment at depths between 100 meters and approximately the edge of the continental shelf or between 100 and 200 meters.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/outerNeriticSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/outer_neritic"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manantial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de manantial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spring setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente que se caracteriza por ser el lugar donde el agua subterránea fluye de manera natural de la roca o el suelo a la superficie del terreno o a una masa de agua.</skos:definition>
    <skos:definition xml:lang="en">Setting characterized by a place where groundwater flows naturally from a rock or the soil onto the land surface or into a water body.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/springSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-deltaico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de abanico deltaico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fan delta setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un abanico aluvial dominado por coladas de derrubios o laminares construido sobre un lago o el mar.</skos:definition>
    <skos:definition xml:lang="en">A debris-flow or sheetflood-dominated alluvial fan build out into a lake or the sea.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/fanDeltaSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-estuarina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de laguna litoral estuarina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">estuarine lagoon setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una laguna costera producida por el cierre temporal del estuario de un río por una barrera de tormenta. Estas lagunas son generalmente temporales y duran hasta que el río rompe la barrera; ocurren en regiones de precipitación escasa y de caracter súbito.</skos:definition>
    <skos:definition xml:lang="en">A lagoon produced by the temporary sealing of a river estuary by a storm barrier. Such lagoons are usually seasonal and exist until the river breaches the barrier; they occur in regions of low or spasmodic rainfall.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-estuarino"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/estuarineLagoonSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/estuarine_lagoon"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laderas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de laderas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hillslope setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente situado en la superficie terrestre que se caracteriza por una superficie cuyo de la ángulo de pendiente es lo suficientemente alta para que la gravedad por sí sola se convierta en un factor significativo en la evolución geomorfológica, así como las áreas en la base de la pendiente influenciadas por los procesos de ladera. Las actividades de ladera incluyen la reptación, corrimientos, deslizamientos, caídas, y otros movimientos descendentes causadas por la rotura de la ladera provocada por la acción gravitatoria sobre los materiales terrestres. Puede ser subaéreo o subacuático.</skos:definition>
    <skos:definition xml:lang="en">Earth surface setting characterized by surface slope angles high enough that gravity alone becomes a significant factor in geomorphic development, as well as base-of-slope areas influenced by hillslope processes. Hillslope activities include creep, sliding, slumping, falling, and other downslope movements caused by slope collapse induced by gravitational influence on earth materials. May be subaerial or subaqueous.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hillslopeSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/hillslope_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-englacial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente englacial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">englacial setting</skos:prefLabel>
    <skos:definition xml:lang="es">Contenido en, incorporado o transportando en el interior del cuerpo de un glaciar o un manto de hielo; dicho de las corrientes de agua de deshielo, till, derrubios, morrena.</skos:definition>
    <skos:definition xml:lang="en">Contained, embedded, or carried within the body of a glacier or ice sheet; said of meltwater streams, till, drift, moraine.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/englacialSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/englacial_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente mareal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tidal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambientes sujetos a los procesos mareales.</skos:definition>
    <skos:definition xml:lang="en">Setting subject to tidal processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-intermareal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica-baja"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-mareal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-mareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/tidalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/tidal_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/semi-graben">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">semi-graben</skos:prefLabel>
    <skos:prefLabel xml:lang="en">half-graben</skos:prefLabel>
    <skos:definition xml:lang="es">Un surco o cuenca asimétrica alargada, limitada en un lado por una falla normal.</skos:definition>
    <skos:definition xml:lang="en">A elongate , asymmetric trough or basin bounded on one side by a normal fault.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/half-graben"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arrecife-biologico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de arrecife biológico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biological reef setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una estructura similar a una cresta o montículo, estratificada o masiva, construida por organismos sedentarios calcáreos, esp. corales, y que consiste en su mayor parte de sus restos; es resistente al oleaje y topográficamente se sitúa por encima de los sedimentos circundantes depositados simultáneamente.</skos:definition>
    <skos:definition xml:lang="en">A ridgelike or moundlike structure, layered or massive, built by sedentary calcareous organisms, esp. corals, and consisting mostly of their remains; it is wave-resistant and stands topographically above the surrounding contemporaneously deposited sediment.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-postarrecifal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-frente-arrecifal"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arrecifal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/biologicalReefSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/biological_reef_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-frente-arrecifal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de frente arrecifal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">forereef setting</skos:prefLabel>
    <skos:definition xml:lang="es">El flanco marítimo de un arrecife; la pendiente cubierta de depósitos gruesos del talud arrecifal.</skos:definition>
    <skos:definition xml:lang="en">The seaward side of a reef; the slope covered with deposits of coarse reef talus.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arrecife-biologico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/forereefSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/forereef"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-plataforma-carbonatada-marina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente plataforma carbonatada marina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">marine carbonate platform setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una meseta sumergida somera separada de las masas de tierra continentales, en la que las altas tasas de producción de carbonato biológico generan suficientes sedimentos para mantener la superficie de la plataforma próxima al nivel del mar. Pasan gradualmente a un atolón cuando su área se hace más pequeña y el anillo  de arrecifes de coral se convierten en la parte más prominente del ambiente.</skos:definition>
    <skos:definition xml:lang="en">A shallow submerged plateau separated from continental landmasses, on which high biological carbonate production rates produce enough sediment to maintain the platform surface near sea level. Grades into atoll as area becomes smaller and ringing coral reefs become more prominent part of the setting.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/marineCarbonatePlatformSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/marine_carbonate_platform_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sand plain setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una llanura cubierta de arena dominada por procesos eólicos.</skos:definition>
    <skos:definition xml:lang="en">A sand-covered plain dominated by aeolian processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-procesos-eolicos"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/sandPlainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/sand_plain"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-superior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de manto superior</skos:prefLabel>
    <skos:prefLabel xml:lang="en">upper mantle setting</skos:prefLabel>
    <skos:definition xml:lang="es">Aquella parte del manto que yace por encima de una profundidad de cerca de 660 km y tiene una densidad de 3.4 g/cm3 a 4.0 g/cm3 creciente con la profundidad. Similarmente, la velocidad de la ondas P crece desde cerca de 8 a 11 km/s con la profundidad y la velocidad de las ondas S crece de cerca de 4.5 a 6 km/s con la profundidad. Se presume que su composición es peridotítica. Incluye la litosfera infracortical, la astenosfera y la zona de transición.</skos:definition>
    <skos:definition xml:lang="en">That part of the mantle which lies above a depth of about 660 km and has a density of 3.4 g/cm3 to 4.0 g/cm3 with increasing depth. Similarly, P-wave velocity increases from about 8 to 11 km/sec with depth and S wave velocity increases from about 4.5 to 6 km/sec with depth. It is presumed to be peridotitic in composition. It includes the subcrustal lithosphere the asthenosphere and the transition zone.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mantelico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/upperMantleSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/upper_mantle"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-yuxtaglaciar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente yuxtaglaciar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glacier lateral setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente adyacente a los bordes de los glaciares confinados.</skos:definition>
    <skos:definition xml:lang="en">Settings adjacent to edges of confined glacier.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-relacionado-con-glaciares"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glacierLateralSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/glacier_lateral_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-lacustre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente lacustre</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lacustrine setting</skos:prefLabel>
    <skos:definition xml:lang="es">Marco asociado a un lago. Siempre solapa con terrestres pueden solaparse con subaéreos, subacuático, o costa.</skos:definition>
    <skos:definition xml:lang="en">Setting associated with a lake. Always overlaps with terrestrial, may overlap with subaerial, subaqueous, or shoreline.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-lacustre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lacustrineSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/lacustrine_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-de-rio-meandriforme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de canal de río meandriforme</skos:prefLabel>
    <skos:prefLabel xml:lang="en">meandering river channel setting</skos:prefLabel>
    <skos:definition xml:lang="es">Producido por una corriente madura que oscila de un lado al otro a medida que fluye a través de su llanura de inundación o que cambia su curso lateralmente hacia el lado convexo de una curva previa.</skos:definition>
    <skos:definition xml:lang="en">Produced by a mature stream swinging from side to side as it flows across its floodplain or shifts its course laterally toward the convex side of an original curve.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-fluvial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/meanderingRiverChannelSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/meandering_channel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/graben">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">graben</skos:prefLabel>
    <skos:prefLabel xml:lang="en">graben</skos:prefLabel>
    <skos:definition xml:lang="es">Un surco o cuenca alargada, limitada en ambos lados por fallas normales de alto ángulo que buzan la una hacia la otra. Es una forma estructural que puede estar expresada geomorfológicamente como un valle de rift o no estarlo.</skos:definition>
    <skos:definition xml:lang="en">An elongate trough or basin, bounded on both sides by high-angle normal faults that dip toward one another. It is a structual form that may or may not be geomorphologically expressed as a rift valley.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/graben"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-sabkha-marina-marginal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente sabkha marina marginal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">marginal marine sabkha setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente caracterizado por condiciones áridas a semiáridas en llanuras costeras restringidas mayoritariamente sobre el nivel normal de la marea alta, con minerales evaporitico-salinos, inundación mareal, y depósitos eólicos. Sus límites con los ambientes intermareales y los ambientes terrestres no mareales son graduales. (Jackson, 1997, p. 561).</skos:definition>
    <skos:definition xml:lang="en">Setting characterized by arid to semi-arid conditions on restricted coastal plains mostly above normal high tide level, with evaporite-saline mineral, tidal-flood, and eolian deposits. Boundaries with intertidal setting and non-tidal terrestrial setting are gradational. (Jackson, 1997, p. 561).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/marginalMarineSabkhaSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/marginal_marine_sabkha_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de sistema deltaico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deltaic system setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambientes en la desembocadura de un río o arroyo que entra en un cuerpo permanente de agua (océano o lago). El delta constituye una llanura triangular o en forma de abanico de área considerable. La parte subaérea del delta está atravesada por numerosos cursos distributarios del río principal</skos:definition>
    <skos:definition xml:lang="en">Environments at the mouth of a river or stream that enters a standing body of water (ocean or lake). The delta forms a triangular or fan-shaped plain of considerable area. Subaerial parts of the delta are crossed by many distributaries of the main river,</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-distributario-de-delta"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-desembocadura-de-distributario-de-delta"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-frente-de-delta"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-deltaica"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-estuarino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-la-bahia-interdistributaria"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-lacustre"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-prodelta"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaicSystemSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/deltaic_system_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-punto-caliente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de punto caliente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hot spot setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente en una zona de alto flujo de calor del manto. Típicamente identificado en ambientes de intraplaca, pero el punto caliente puede también interactuar con márgenes activos de placa (Islandia…). Incluye manifestaciones superficiales como los centros volcánicos, pero también incluye igualmente manifestaciones corticales y mantélicas.</skos:definition>
    <skos:definition xml:lang="en">Setting in a zone of high heat flow from the mantle. Typically identified in intraplate settings, but hot spot may also interact with active plate margins (Iceland...). Includes surface manifestations like volcanic center, but also includes crust and mantle manifestations as well.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hotSpotSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/hot_spot_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino-epicontinental">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente marino epicontinental</skos:prefLabel>
    <skos:prefLabel xml:lang="en">epicontinental marine setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente marino situado en el interior de un continente, en lugar de en el borde del continente.</skos:definition>
    <skos:definition xml:lang="en">Marine setting situated within the interior of the continent, rather than at the edge of a continent.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/epicontinentalMarineSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/epicontinental_marine_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-prodelta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de prodelta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">prodelta setting</skos:prefLabel>
    <skos:definition xml:lang="es">La parte de un delta que está por debajo de la profundidad de erosión efectiva de las olas, yace más allá del frente del delta, y se inclina suavemente hacia el fondo de la cuenca en la que el delta está avanzando y donde los sedimentos clásticos del río dejan de ser una parte importante de la depósitos del fondo de cuenca; está completamente por debajo del nivel de agua.</skos:definition>
    <skos:definition xml:lang="en">The part of a delta that is below the effective depth of wave erosion, lying beyond the delta front, and sloping gently down to the floor of the basin into which the delta is advancing and where clastic river sediment ceases to be a significant part of the basin-floor deposits; it is entirely below the water level.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subacuatico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/prodeltaSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/prodelta"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-pantano-o-marisma">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de pantano o marisma</skos:prefLabel>
    <skos:prefLabel xml:lang="en">swamp or marsh setting</skos:prefLabel>
    <skos:definition xml:lang="es">Área saturada en agua, periódicamente húmeda o constantemente inundada con su superficie sumergida poco profundamente, sin que básicamente se forme turba. Las marismas se caracterizan por las ciperáceas, espadañas, juncáceas, u otra vegetación acuática y de praderas. Los pantanos se caracterizan por vegetación arbórea y de matorral.</skos:definition>
    <skos:definition xml:lang="en">A water-saturated, periodically wet or continually flooded area with the surface not deeply submerged, essentially without the formation of peat. Marshes are characterized by sedges, cattails, rushes, or other aquatic and grasslike vegetation. Swamps are characterized by tree and brush vegetation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-humedales"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-marisma-mareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/swampOrMarshSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/swamp_or_marsh_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-medio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente batial medio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">middle bathyal setting</skos:prefLabel>
    <skos:definition xml:lang="es">El ambiente océanico en aguas de profundidades comprendidas entre 600 y 1.000 metros.</skos:definition>
    <skos:definition xml:lang="en">The ocean environment at water depths between 600 and 1000 metres.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/middleBathyalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/middle_bathyal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente batial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bathyal setting</skos:prefLabel>
    <skos:definition xml:lang="es">El ambiente marino de aguas con profundidades entre 200 y 3.500 metros.</skos:definition>
    <skos:definition xml:lang="en">The ocean environment at water depths between 200 and 3500 metres.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-inferior"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-medio"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-batial-superior"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/bathyalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/bathyal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-mareal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura de mareal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tidal flat setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un terreno extenso, casi horizontal, y yermo cubierto y descubierto alternativamente por las mareas, y que consiste en sedimentos no consolidados (en su mayoría fango y arena). Puede formarse en la superficie superior de un depósito deltaico.</skos:definition>
    <skos:definition xml:lang="en">An extensive, nearly horizontal, barren tract of land that is alternately covered and uncovered by the tide, and consisting of unconsolidated sediment (mostly mud and sand). It may form the top surface of a deltaic deposit.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mareal"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/tidalFlatSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/tidal_flat_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-marisma-mareal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-abanico-submarino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de abanico submarino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">submarine fan setting</skos:prefLabel>
    <skos:definition xml:lang="es">Los grandes conos de sedimentos en forma de abanico en el fondo océanico, generalmente asociados con los cañones submarinos que proporcionan el suministro de sedimentos para construir el abanico.</skos:definition>
    <skos:definition xml:lang="en">Large fan-shaped cones of sediment on the ocean floor, generally associated with submarine canyons that provide sediment supply to build the fan.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/submarineFanSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/submarine_fan_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-pedregosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura pedregosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gibber plain setting</skos:prefLabel>
    <skos:definition xml:lang="es">Llanura desértica cubierta de cantos desgastado por el viento (gibbers); un desierto pedregoso.</skos:definition>
    <skos:definition xml:lang="en">A desert plain strewn with wind-abraded pebbles, or gibbers; a gravelly desert.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/gibberPlainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/gibber_plain"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-de-cuenca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura de cuenca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basin plain setting</skos:prefLabel>
    <skos:definition xml:lang="es">La zona plana del fondo del océano, de pendiente inferior a 1: 1000; generalmente solo recibe turbiditas distal y sedimentos pelágicos.</skos:definition>
    <skos:definition xml:lang="en">Near flat areas of ocean floor, slope less than 1:1000; generally receive only distal turbidite and pelagic sediments.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/basinPlainSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/basin_plain_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-hadal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente hadal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hadal setting</skos:prefLabel>
    <skos:definition xml:lang="es">El ambiente oceánico más profundo, es decir, a más de 6.000 m de profundidad. Siempre se asocia a las fosas de aguas profundas.</skos:definition>
    <skos:definition xml:lang="en">The deepest oceanic environment, i.e., over 6,000 m in depth. Always in deep sea trench.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/hadalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/hadal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica-inferior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de corteza oceánica inferior</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lower oceanic-crustal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente caracterizado por rocas dominantemente intrusivas máficas, con complejos de diques inyectados en su parte superior y rocas intrusivas gabroicas a ultramáficas o metamórficas en su parte inferior.</skos:definition>
    <skos:definition xml:lang="en">Setting characterized by dominantly intrusive mafic rocks, with sheeted dike complexes in upper part and gabbroic to ultramafic intrusive or metamorphic rocks in lower part.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-oceanica"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerOceanic-crustalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_oceanic_crustal_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-clima-humedo-y-tropical">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de clima húmedo y tropical</skos:prefLabel>
    <skos:prefLabel xml:lang="en">humid tropical climatic setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente con clima cálido y húmedo influenciado por las masas de aire ecuatoriales, sin estación invernal.</skos:definition>
    <skos:definition xml:lang="en">Setting with hot, humid climate influenced by equatorial air masses, no winter season.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/humidTropicalClimaticSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/humid_tropical_climatic_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-glaciofluvial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente glaciofluvial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glaciofluvial setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un ambiente influenciado por las corrientes de agua de deshielo glacial. Este ambiente puede ser englaciar, sub-, supra- y proglacial.</skos:definition>
    <skos:definition xml:lang="en">A setting influenced by glacial meltwater streams. This setting can be sub- en-, supra- and proglacial.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glaciofluvialSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-transicional">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de corteza transicional</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transitional-crustal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Corteza formada en la zona de transición entre las cortezas continental y oceánica, durante la historia de rifting continental que culmina con la formación de un nuevo océano.</skos:definition>
    <skos:definition xml:lang="en">Crust formed in the transition zone between continental and oceanic crust, during the history of continental rifting that culminates in the formation of a new ocean.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-cortical"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/transitional-crustalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/transitional_crust"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanuras-algares">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanuras algares</skos:prefLabel>
    <skos:prefLabel xml:lang="en">algal flat setting</skos:prefLabel>
    <skos:definition xml:lang="es">Las llanuras de algas actuales se encuentran en zonas rocosas o fangosas inundadas solamente por las mareas más altas y que están a menudo sujetas a altas tasas de evaporación. Las llanuras algares sobreviven sólo cuando una zona es lo suficientemente salada para eliminar a los caracoles y otros herbívoros que se alimentan de algas, pero es no tan salada que las algas no puedan sobrevivir. Las especies más comunes de algas que se encuentran en las llanuras de algares son algas azul-verdosas de los géneros Scytonema y Schizothrix. Estas algas pueden tolerar las variaciones diarias extremas de temperatura y oxígeno que caracterizan las condiciones de estas llanuras. Otras plantas que a veces se encuentran las llanuras algares incluyen las algas verdes unicelulares, flagelados, diatomeas, bacterias y manglares arbustivos solitarios rojos y negros, así como parches de salicornias. La fauna incluye el Cerith falso, caracoles Cerion, cangrejos violinistas, y grandes cangrejos de tierra. Las llanuras con alfombras algares bien desarrolladas se limitan en su mayor parte a los Cayos, siendo Sugarloaf y Crane Keys excelentes ejemplos del hábitat de llanuras de algas. (Audubon, 1991)</skos:definition>
    <skos:definition xml:lang="en">Modern "algal flats are found on rock or mud in areas flooded only by the highest tides and are often subject to high evaporation rates. Algal flats survive only when an area is salty enough to eliminate snails and other herbivorous animals that eat algae, yet is not so salty that the algae cannot survive. The most common species of algae found on algal flats are blue-green algae of the genera Scytonema and Schizothrix. These algae can tolerate the daily extremes in temperature and oxygen that typify conditions on the flats. Other plants sometimes found on algal flats include one-celled green algae, flagellates, diatoms, bacteria, and isolated scrubby red and black mangroves, as well as patches of saltwort. Animals include false cerith, cerion snails, fiddler crabs, and great land crabs. Flats with well developed algal mats are restricted for the most part to the Keys, with Sugarloaf and Crane Keys offering prime examples of algal flat habitat." (Audubon, 1991)</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral-de-baja-energia"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/algalFlatSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/algal_flat_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arco-volcanico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de arco volcánico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcanic arc setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un cinturón generalmente curvilíneo de volcanes por encima de una zona de subducción.</skos:definition>
    <skos:definition xml:lang="en">A generally curvillinear belt of volcanoes above a subduction zone.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/volcanicArcSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/volcanic_arc_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-trasera-de-arco">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de trasera de arco</skos:prefLabel>
    <skos:prefLabel xml:lang="en">back arc setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente tectónico adyacente a un arco volcánico formado por encima de una zona de subducción. El ambiente de trasera de arco está en el lado opuesto del arco volcánico a la fosa en la que la corteza oceánica se consume en una zona de subducción. El ambiente de trasera de arco incluye terreno que es afectado por procesos de márgenes de placa y procesos relacionados con los arcos.</skos:definition>
    <skos:definition xml:lang="en">Tectonic setting adjacent to a volcanic arc formed above a subduction zone. The back arc setting is on the opposite side of the volcanic arc from the trench at which oceanic crust is consumed in a subduction zone. Back arc setting includes terrane that is affected by plate margin and arc-related processes.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/backArcSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/back_arc_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-meseta-oceanica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de meseta oceánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oceanic plateau setting</skos:prefLabel>
    <skos:definition xml:lang="es">Región de corteza oceánica elevada que comúnmente sube a 2-3 km de la superficie por encima de un fondo marino abisal que está varios kilómetros más profundo. El clima y la profundidad del agua es tal que no se desarrolla una plataforma carbonatada marina.</skos:definition>
    <skos:definition xml:lang="en">Region of elevated ocean crust that commonly rises to within 2-3 km of the surface above an abyssal sea floor that lies several km deeper. Climate and water depths are such that a marine carbonate platform does not develop.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-elevaciones-oceanicas"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/oceanicPlateauSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/oceanic_plateau_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terminal-del-glaciar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente terminal del glaciar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glacier terminus setting</skos:prefLabel>
    <skos:definition xml:lang="es">Región en la zona de terminación del glaciar de deposición de sedimentos debidos al derretimiento del hielo glaciar, la fusión, la ablación y los flujos en masa de till.</skos:definition>
    <skos:definition xml:lang="en">Region of sediment deposition at the glacier terminus due to melting of glacier ice, melt-out, ablation and flow till setting.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-proglacial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/glacierTerminusSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/glacier_terminus_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-antearco">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de antearco</skos:prefLabel>
    <skos:prefLabel xml:lang="en">forearc setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente tectónico situado entre una trinchera relacionada con una zona de subducción y un arco volcánico.</skos:definition>
    <skos:definition xml:lang="en">Tectonic setting between a subduction-related trench and a volcanic arc.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-margen-de-placa"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/forearcSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/forearc_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-area-de-morada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de area de morada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dwelling area setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente de area de morada</skos:definition>
    <skos:definition xml:lang="en">Dwelling area setting.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/dwellingAreaSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-talud-deltaico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de talud deltaico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">delta slope setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente de talud en un sistema deltaico.</skos:definition>
    <skos:definition xml:lang="en">Slope setting within the deltaic  system.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaSlopeSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-tierras-recuperadas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de tierras recuperadas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">land reclamation setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente con influencia humana para hacer que el territorio sea capaz de un uso más intensivo modificando sus características generales, como el drenado de terrenos excesivamente húmedos, el riego de tierras áridas o semiáridas; o la recuperación de tierra sumergida de mares, lagos y ríos, la restauración de zonas degradadas por la acción humana mediante la eliminación de sustancias tóxicas.</skos:definition>
    <skos:definition xml:lang="en">Human influence setting making land capable of more intensive use by changing its general character, as by drainage of excessively wet land, irrigation of arid or semiarid land; or recovery of submerged land from seas, lakes and rivers, restoration after human-induced degradation by removing toxic substances.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/landReclamationSetting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-delta-lacustre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de delta lacustre</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lacustrine delta setting</skos:prefLabel>
    <skos:definition xml:lang="es">Porción de tierra aluvial baja, casi plana, en o cerca de la desembocadura de un río, comúnmente formando una llanura triangular o en forma de abanico de superficie considerable, atravesada por numerosos distributarios del río principal, que puede extenderse más allá de la línea de costa general del lago, que resulta de la acumulación de sedimentos suministrada por el río en cantidades tales que no se removilizan por las olas o las corrientes. La mayoría de los deltas son parcialmente subaéreos y en parte se ubican por debajo del agua.</skos:definition>
    <skos:definition xml:lang="en">The low, nearly flat, alluvial tract of land at or near the mouth of a river, commonly forming a triangular or fan-shaped plain of considerable area, crossed by many distributaries of the main river, perhaps extending beyond the general trend of the lake shore, resulting from the accumulation of sediment supplied by the river in such quantities that it is not removed by waves or currents. Most deltas are partly subaerial and partly below water.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-lacustre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lacustrineDeltaSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/lacustrine_delta"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-canal-distributario-de-delta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de canal distributario de delta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">delta distributary channel setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una corriente que fluye divergiendo y alejadose de la corriente principal y no regresar a ella, como ocurre en un delta o en una llanura aluvial.</skos:definition>
    <skos:definition xml:lang="en">A divergent stream flowing away from the main stream and not returning to it, as in a delta or on an alluvial plain.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-deltaico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/deltaDistributaryChannelSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/distributary_channel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-pantanoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de manto pantanoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">blanket bog</skos:prefLabel>
    <skos:definition xml:lang="es">Pantano o turbera topogénica cuyo contenido de humedad depende en gran medida de las aguas superficiales. Es relativamente rica en nutrientes vegetales, nitrógeno, y materia mineral, es ligeramente ácida a casi neutra, y contiene poco o nada de celulosa; depresiones topográficas esencialmente con suministro de agua minerotrófica estancadas o quietas</skos:definition>
    <skos:definition xml:lang="en">Topogeneous bog/peat whose moisture content is largely dependent on surface water. It is relatively rich in plant nutrients, nitrogen, and mineral matter, is mildly acidic to nearly neutral, and contains little or no cellulose; forms in topographic depressions with essential stagnat or non-moving minerotrophic water supply</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/blanketBog"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/blanket_bog"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-inferior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de manto inferior</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lower mantle setting</skos:prefLabel>
    <skos:definition xml:lang="es">Aquella parte del manto que yace bajo una profundidad de cerca de 660 km. Con el incremento en profundidad, la densidad crece de  ~4.4 g/cm3 a ~5.6 g/cm3, y la velocidad de las ondas sísmicas compresionales crece de ~10.7 km/s a ~13.7 km/s (Dziewonski and Anderson, 1981).</skos:definition>
    <skos:definition xml:lang="en">That part of the mantle that lies below a depth of about 660 km. With increasing depth, density increases from ~4.4 g/cm3 to ~5.6 g/cm3, and velocity of compressional seismic waves increases from ~10.7 km/s to ~13.7 km/s (Dziewonski and Anderson, 1981).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-mantelico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerMantleSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_mantle"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-inferior">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de corteza continental inferior</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lower continental-crustal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente cortical continental caracterizado por metamorfismo de las facies de anfibolitas superiores a las granulitas, fusión in situ, rocas metamórficas anhidras residuales, y flujo dúctil de los cuerpos de roca.</skos:definition>
    <skos:definition xml:lang="en">Continental crustal setting characterized by upper amphibolite to granulite facies metamorphism, in situ melting, residual anhydrous metamorphic rocks, and ductile flow of rock bodies.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lowerContinental-crustalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/lower_continental_crust"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de laguna litoral</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lagoonal setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una extensión de somera de agua salada o salobre, en parte o completamente separado del mar o un lago por un arrecife de mar abierto, una isla barrera, arena o un cordón litoral (Jackson, 1997). El agua es poco profunda, las mareas y oleaje producen efectos en los sedimentos; la luminosidad en el sedimento es fuerte.</skos:definition>
    <skos:definition xml:lang="en">A shallow stretch of salt or brackish water, partly or completely separated from a sea or lake by an offshore reef, barrier island, sand or spit (Jackson, 1997). Water is shallow, tidal and wave-produced effects on sediments; strong light reaches sediment.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-litoral"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-de-barrera"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-estuarina"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/lagoonalSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/lagoonal_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-endorreica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de playa endorreica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">playa setting</skos:prefLabel>
    <skos:definition xml:lang="es">La llanura normalmente seca y casi plana que ocupa las partes bajas de las depresiones cerradas, como las que se producen en los fondos de las cuencas intermontanas. Las inundaciones temporales se producen principalmente como respuesta a eventos de precipitación-escorrentía.</skos:definition>
    <skos:definition xml:lang="en">The usually dry and nearly level plain that occupies the lowest parts of closed depressions, such as those occurring on intermontane basin floors. Temporary flooding occurs primarily in response to precipitation-runoff events.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-arido-o-semiarido"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-subaereo"/>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-terrestre"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/playaSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/playa_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-llanura-arrecifal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de llanura arrecifal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reef flat setting</skos:prefLabel>
    <skos:definition xml:lang="es">Una plataforma pedregosa de roca arrecifal, tierra adentro de la cresta del arrecife en o por encima del nivel de la bajamar, en ocasiones con parches de coral vivo y sus organismos asociados, y comúnmente salpicada de fragmentos de coral y arena coralina.</skos:definition>
    <skos:definition xml:lang="en">A stony platform of reef rock, landward of the reef crest at or above the low tide level, occasionally with patches of living coral and associated organisms, and commonly strewn with coral fragments and coral sand.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-arrecife-biologico"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/reefFlatSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/reef_flat"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cauce-fluvial-abandonado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de cauce fluvial abandonado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">abandoned river channel setting</skos:prefLabel>
    <skos:definition xml:lang="es">Un canal de drenaje a lo largo del cual ya no hay escorrentía ya no se produce, como por ejemplo en un abanico aluvial.</skos:definition>
    <skos:definition xml:lang="en">A drainage channel along which runoff no longer occurs, as on an alluvial fan.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-sistema-de-llanura-fluvial"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/abandonedRiverChannelSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/abandoned_channel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental-media">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente"/>
    <skos:prefLabel xml:lang="es">ambiente de corteza continental media</skos:prefLabel>
    <skos:prefLabel xml:lang="en">middle continental crust setting</skos:prefLabel>
    <skos:definition xml:lang="es">Ambiente cortical continental caracterizado por metamorfismo en facies de los esquistos verdes a las anfibolitas superiores, rocas ígneas plutónicas y deformación dúctil.</skos:definition>
    <skos:definition xml:lang="en">Continental crustal setting characterized by greenschist to upper amphibolite facies metamorphism, plutonic igneous rocks, and ductile deformation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-corteza-continental"/>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/middleContinentalCrustSetting"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/eventenvironment/middle_continental_crust_setting"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
</rdf:RDF>
