   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:sdo="https://schema.org/"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/polaridad">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Polaridad</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Polarity</skos:prefLabel>
    <dcterms:title xml:lang="es">Polaridad</dcterms:title>
    <dcterms:title xml:lang="en">Polarity</dcterms:title>
    <skos:definition xml:lang="es">Polaridad de la secuencia estratigráfica asociada a una medida estructural.</skos:definition>
    <skos:definition xml:lang="en">Polarity of the stratigraphic sequence associated with a structural measurement.</skos:definition>
    <dcterms:description xml:lang="es">Polaridad de la secuencia estratigráfica asociada a una medida estructural.</dcterms:description>
    <dcterms:description xml:lang="en">Polarity of the stratigraphic sequence associated with a structural measurement.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos propios definidos por el IGME</dcterms:provenance>
    <dcterms:creator>https://www.igme.es</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Polaridad.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/polaridad/normal"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/polaridad/invertida"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/polaridad/vertical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/polaridad/collection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <skos:prefLabel xml:lang="es">Polaridad - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Polarity - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/polaridad/normal"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/polaridad/invertida"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/polaridad/vertical"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/polaridad/normal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <skos:prefLabel xml:lang="es">normal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">upright</skos:prefLabel>
    <skos:definition xml:lang="es">El elemento no ha sido rotado alrededor de un eje horizontal o subhorizontal más de 90 grados respecto a su orientación original.</skos:definition>
    <skos:definition xml:lang="en">The feature has not been rotated around a horizontal or subhorizontal axis beyond 90 degrees from its original orientation.</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/planarpolaritycode/upright"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/polaridad/invertida">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <skos:prefLabel xml:lang="es">invertida</skos:prefLabel>
    <skos:prefLabel xml:lang="en">overturned</skos:prefLabel>
    <skos:definition xml:lang="es">El elemento ha sido invertido (es decir, rotado alrededor de un eje horizontal o subhorizontal más de 90 grados respecto a su orientación original).</skos:definition>
    <skos:definition xml:lang="en">The feature has been overturned (ie; rotated around a horizontal or subhorizontal axis more than 90 degrees from its original orientation).</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/planarpolaritycode/overturned"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/polaridad/vertical">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/polaridad"/>
    <skos:prefLabel xml:lang="es">vertical</skos:prefLabel>
    <skos:prefLabel xml:lang="en">vertical</skos:prefLabel>
    <skos:definition xml:lang="es">La orientación planar del elemento es aproximadamente vertical.</skos:definition>
    <skos:definition xml:lang="en">The planar orientation of a feature is approximately vertical.</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/planarpolaritycode/vertical"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
</rdf:RDF>
