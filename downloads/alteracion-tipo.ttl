@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/collection> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:definition "All concepts in this vocabulary."@en,
        "Todos los conceptos en este vocabulario."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:member <https://geo-carto.github.io/vocabularios/alteracion-tipo/alteracion-no-especificada>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/arenizacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/argilizacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/caolinizacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/carbonatacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/ferruginizacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/no-alterada>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/silicificacion> ;
    skos:prefLabel "Alteration type - All concepts"@en,
        "Tipo de alteración - Todos los conceptos"@es .

<https://linked.data.gov.au/org/cgi-gtwg> a sdo:Organization ;
    sdo:affiliation <https://linked.data.gov.au/org/cgi> ;
    sdo:name "CGI Geoscience Terminology Working Group" ;
    sdo:url <http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html> .

<https://linked.data.gov.au/org/cgi> a sdo:Organization ;
    sdo:name "Commission for the Management and Application of Geoscience Information" ;
    sdo:url <http://www.cgi-iugs.org> .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/arenizacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion> ;
    skos:definition "Weathering process that disaggregates coarsed-grained rocks (> 0,1 mm) into minerals and rock fragments with no cohesion. The products, may or may not be silica-enriched, are usually known as grus, grus saprolites, sandy saprolites, grus mantles, arenaceous mantles or lem when the weathering is mainly physical (Migón, 2004), growan, jabre or xabre when it is chemical (Vidal Romaní and Twidale, 1998), or arenes when they are derived from plutonic rocks, mainly granites and diorites (Campy and Macaire, 1989)."@en,
        "Proceso de meteorización que disgrega rocas de grano grueso (> 0,1 mm) en minerales y fragmentos de rocas sin cohesión. Los residuos, enriquecidos o no en sílice, se suelen denominar grus, grus saprolites, sandy saprolites, grus mantles, arenaceous mantles o lem cuando la meteorización es fundamentalmente física (Migon, 2004), growan, jabre o xabre cuando es química (Vidal Romaní y Twidale, 1998), o arenes cuando derivan de rocas plutónicas, fundamentalmente granitos y dioritas (Campy y Macaire, 1989)"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:prefLabel "arenization"@en,
        "arenización"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/argilizacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion> ;
    skos:definition "Transformation of minerals, especially feldespars and other silicates, into clay minerals."@en,
        "Transformación de minerales, especialmente feldespatos y otros silicatos, en minerales arcillosos"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/alterationtype/argillic_alteration> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:prefLabel "argillation"@en,
        "argilización"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/caolinizacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion> ;
    skos:definition "Transformation of minerals, especially feldespars and other silicates into kaolinite-group clay minerals."@en,
        "Transformación de minerales, especialmente feldespatos y otros silicatos, en minerales arcillosos del grupo de la caolinita."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/alterationtype/kaolinitic_alteration> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:prefLabel "kaolinitation"@en,
        "caolinización"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/carbonatacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion> ;
    skos:definition "Transformation of calcium, magnesium, sodium, potassium or iron minerals into carbonates or bicarbonates, by carbon dioxide contained in water."@en,
        "Transformación de minerales de calcio, magnesio, sodio, potasio o hierro en carbonatos o bicarbonatos, debido a la acción del dióxido de carbono contenido en el agua"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/alterationtype/carbonate_alteration?> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:prefLabel "carbonation"@en,
        "carbonatación"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/ferruginizacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion> ;
    skos:definition "Enrichment of a rock, sediment or soil in iron."@en,
        "Enriquecimiento de una roca, sedimento o suelo en hierro"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:prefLabel "ferrugination"@en,
        "ferruginización"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/no-alterada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:definition "Rock es not altered"@en,
        "La roca no está alterada"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/alterationtype/not_altered> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:prefLabel "not altered"@en,
        "no alterada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/silicificacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion> ;
    skos:definition "Enrichment of a rock, sediment or soil in silica."@en,
        "Enriquecimiento de una roca, sedimento o suelo en sílice"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/alterationtype/silicification> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:prefLabel "silification"@en,
        "silicificación"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/alteracion-no-especificada> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:definition "Rock is altered, but type not specified. Any alteration type allowed"@en,
        "La roca está alterada, pero el tipo de alteración no está especificada"@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/alterationtype/alteration_not_specified> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion> ;
    skos:prefLabel "alteration type not specified"@en,
        "alteración no especificada"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/alteracion-tipo/alteracion-no-especificada> ;
    skos:definition "Group of physical, chemical and biological processes by which a rock, sediment or soil, near the Earth's surface, are changed in color, texture, composition, firmness or form, with little or no transport of the altered material."@en,
        "Conjunto de procesos físicos, químicos y biológicos por los que una roca, sedimento o suelo, próximo a la superficie terrestre, cambia su color, textura, composición, resistencia o forma, sin o escaso transporte de los materiales alterados"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/alteracion-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/alteracion-tipo/arenizacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/argilizacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/caolinizacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/carbonatacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/ferruginizacion>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/silicificacion> ;
    skos:prefLabel "weathering"@en,
        "meteorización"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/alteracion-tipo> a skos:ConceptScheme ;
    dcterms:created "2026-03-01"^^xsd:date ;
    dcterms:creator "https://www.igme.es" ;
    dcterms:description "The property alterationType:AlterationTypeTerm contains a term from a controlled vocabulary of alteration types (e.g., potassic, argillic, advanced argillic)."@en,
        "Término de un vocabulario controlado de tipos de alteración (por ejemplo, potásica, argílica, argílica avanzada)."@es ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-03-01"^^xsd:date ;
    dcterms:provenance "Términos propios definidos por el IGME" ;
    dcterms:publisher <https://www.igme.es/> ;
    dcterms:title "Alteration type"@en,
        "Tipo de alteración"@es ;
    owl:versionInfo "1.0.0" ;
    skos:definition "The property alterationType:AlterationTypeTerm contains a term from a controlled vocabulary of alteration types (e.g., potassic, argillic, advanced argillic)."@en,
        "Término de un vocabulario controlado de tipos de alteración (por ejemplo, potásica, argílica, argílica avanzada)."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Tipo de alteración."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/alteracion-tipo/alteracion-no-especificada>,
        <https://geo-carto.github.io/vocabularios/alteracion-tipo/no-alterada> ;
    skos:prefLabel "Alteration type"@en,
        "Tipo de alteración"@es ;
    dcat:theme "GE" .

