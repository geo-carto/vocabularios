    "http://purl.org/dc/terms/description": [
      {
        "@language": "es",
        "@value": "Términos que describen la distribución espacial o la geometría de las zonas de alteración (por ejemplo: irregular, moteada, bandeada, con vetas, brecha de vetas, generalizada, diseminada, etc.)."
      },
      {
        "@language": "en",
        "@value": "Terms describing the spatial distribution or geometry of alteration zones (e.g., patchy, spotted, banded, veins, vein breccia, pervasive, disseminated)."
      }
