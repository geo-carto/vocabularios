>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/rango-estratigrafico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Rango estratigráfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Stratigraphic rank</skos:prefLabel>
    <dcterms:title xml:lang="es">Rango estratigráfico</dcterms:title>
    <dcterms:title xml:lang="en">Stratigraphic rank</dcterms:title>
    <skos:definition xml:lang="es">Términos que clasifican la unidad geológica en una jerarquía de generalización, desde la más local/de menor volumen hasta la más regional/de mayor volumen.</skos:definition>
    <skos:definition xml:lang="en">The property rank:RankTerm contains a term that classifies the geologic unit in a generalization hierarchy from most local/smallest volume to most regional/largest.</skos:definition>
    <dcterms:description xml:lang="es">Términos que clasifican la unidad geológica en una jerarquía de generalización, desde la más local/de menor volumen hasta la más regional/de mayor volumen.</dcterms:description>
    <dcterms:description xml:lang="en">The property rank:RankTerm contains a term that classifies the geologic unit in a generalization hierarchy from most local/smallest volume to most regional/largest.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos originales del estándar GeoSciML traducidos al español por el IGME</dcterms:provenance>
    <dcterms:creator>https://cgi-iugs.org/</dcterms:creator>
    <dcterms:contributor>https://www.igme.es</dcterms:contributor>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Rango estratigráfico.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/complejo"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/megasecuencia"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/supergrupo"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/superzona"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/no-especificado"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/rango-estratigrafico/supergrupo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <skos:prefLabel xml:lang="es">supergrupo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">supergroup</skos:prefLabel>
    <skos:definition xml:lang="es">Relación formal de grupos relacionados o superpuestos, o de grupos y formaciones.</skos:definition>
    <skos:definition xml:lang="en">A supergroup is a formal assemblage of related or superposed groups or of groups and formations.</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/grupo"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/stratigraphicrank/supergroup"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/rango-estratigrafico/superzona">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <skos:prefLabel xml:lang="es">superzona</skos:prefLabel>
    <skos:prefLabel xml:lang="en">supersuite</skos:prefLabel>
    <skos:definition xml:lang="es">Una unidad litodémica formal que sigue en rango superior a la zona. Comprende dos o más zonas que tienen un grado de relación natural entre sí.</skos:definition>
    <skos:definition xml:lang="en">A formal lithodemic unit next higher in rank to suite. It comprises two or more suites having a degree of natural relationship to one another</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/zona"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/stratigraphicrank/supersuite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/rango-estratigrafico/formacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <skos:prefLabel xml:lang="es">formación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">formation</skos:prefLabel>
    <skos:definition xml:lang="es">Cuerpo de roca identificado por características líticas y posición estratigráfica; por lo general, pero no necesariamente, es tabular y se puede mapear en la superficie de la Tierra o rastrear en el subsuelo.</skos:definition>
    <skos:definition xml:lang="en">A body of rock identified by lithic characteristics and stratigraphic position; it is usually but not necessarily tabular and is mappable at the Earth's surface or traceable in the subsurface.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/subgrupo"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/miembro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/stratigraphicrank/formation"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/rango-estratigrafico/miembro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico"/>
    <skos:prefLabel xml:lang="es">miembro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">member</skos:prefLabel>
    <skos:definition xml:lang="es">Unidad litoestratigráfica formal siguiente en rango debajo de una formación; y siempre parte de una formación. Es una entidad con nombre dentro de una formación porque posee características que la distinguen de las partes adyacentes de la formación.</skos:definition>
    <skos:definition xml:lang="en">A formal lithostratigraphic unit next in rank below a formation; and always part of a formation. It is a named entity within a formation because it possesses characteristics distinguishing it from adjacent parts of the formation.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/formacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/rango-estratigrafico/capa"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/stratigraphicrank/member"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
