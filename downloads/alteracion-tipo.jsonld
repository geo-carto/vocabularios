      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Transformación de minerales, especialmente feldespatos y otros silicatos, en minerales arcillosos del grupo de la caolinita."
      },
      {
        "@language": "en",
        "@value": "Transformation of minerals, especially feldespars and other silicates into kaolinite-group clay minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/alterationtype/kaolinitic_alteration"
      }
    ],
