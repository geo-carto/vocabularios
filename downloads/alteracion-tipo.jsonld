  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/arenizacion",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Proceso de meteorización que disgrega rocas de grano grueso (> 0,1 mm) en minerales y fragmentos de rocas sin cohesión. Los residuos, enriquecidos o no en sílice, se suelen denominar grus, grus saprolites, sandy saprolites, grus mantles, arenaceous mantles o lem cuando la meteorización es fundamentalmente física (Migon, 2004), growan, jabre o xabre cuando es química (Vidal Romaní y Twidale, 1998), o arenes cuando derivan de rocas plutónicas, fundamentalmente granitos y dioritas (Campy y Macaire, 1989)"
      },
      {
        "@language": "en",
        "@value": "Weathering process that disaggregates coarsed-grained rocks (> 0,1 mm) into minerals and rock fragments with no cohesion. The products, may or may not be silica-enriched, are usually known as grus, grus saprolites, sandy saprolites, grus mantles, arenaceous mantles or lem when the weathering is mainly physical (Migón, 2004), growan, jabre or xabre when it is chemical (Vidal Romaní and Twidale, 1998), or arenes when they are derived from plutonic rocks, mainly granites and diorites (Campy and Macaire, 1989)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arenización"
      },
      {
        "@language": "en",
        "@value": "arenization"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
