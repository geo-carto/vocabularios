      },
      {
        "@language": "en",
        "@value": "not altered"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/alteracion-no-especificada"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Conjunto de procesos físicos, químicos y biológicos por los que una roca, sedimento o suelo, próximo a la superficie terrestre, cambia su color, textura, composición, resistencia o forma, sin o escaso transporte de los materiales alterados"
      },
      {
        "@language": "en",
        "@value": "Group of physical, chemical and biological processes by which a rock, sediment or soil, near the Earth's surface, are changed in color, texture, composition, firmness or form, with little or no transport of the altered material."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/arenizacion"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/argilizacion"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/caolinizacion"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/carbonatacion"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/silicificacion"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/ferruginizacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "meteorización"
      },
      {
        "@language": "en",
        "@value": "weathering"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/carbonatacion",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Transformación de minerales de calcio, magnesio, sodio, potasio o hierro en carbonatos o bicarbonatos, debido a la acción del dióxido de carbono contenido en el agua"
      },
      {
        "@language": "en",
        "@value": "Transformation of calcium, magnesium, sodium, potassium or iron minerals into carbonates or bicarbonates, by carbon dioxide contained in water."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/alterationtype/carbonate_alteration?"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-tipo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "carbonatación"
      },
      {
        "@language": "en",
        "@value": "carbonation"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
