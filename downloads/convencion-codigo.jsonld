  {
    "@id": "https://geo-carto.github.io/vocabularios/convencion-codigo/regla-de-la-mano-derecha",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/convencion-codigo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "El rumbo y buzamiento de datos planares se indica según la regla de la mano derecha: mirando en la dirección del rumbo, la superficie buza hacia la derecha. El buzamiento es el ángulo que la superficie estructural forma con la horizontal medido perpendicularmente al rumbo y en el plano vertical."
      },
      {
        "@language": "en",
        "@value": "The strike and dip of planar data is listed according to the right-hand rule or, as one looks along the strike direction, the surface dips to the right. Dip is the angle that the structural surface (eg bedding, fault plane) makes with the horizontal measured perpindicular to the strike of the structure and in the vertical plane"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/conventioncode/strike_dip_rhr"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/convencion-codigo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "regla de la mano derecha"
      },
      {
        "@language": "en",
        "@value": "strike dip right hand rule"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
