    <skos:prefLabel xml:lang="es">proveedor de recursos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">resourceProvider</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que suministra el recurso.</skos:definition>
    <skos:definition xml:lang="en">Party that supplies the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
