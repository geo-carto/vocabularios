  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/titular-de-los-derechos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">titular de los derechos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rightsHolder</skos:prefLabel>
    <skos:definition xml:lang="es">Parte propietaria o gestora de los derechos sobre el recurso.</skos:definition>
    <skos:definition xml:lang="en">Party owning or managing rights over the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/autor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">autor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">author</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que es el autor del recurso.</skos:definition>
    <skos:definition xml:lang="en">Party who authored the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/contribuyente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">contribuyente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que contribuye al recurso.</skos:definition>
    <skos:definition xml:lang="en">Party contributing to the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/procesador">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">procesador</skos:prefLabel>
    <skos:prefLabel xml:lang="en">processor</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que ha procesado los datos de una manera tal que ha modificado el recurso.</skos:definition>
    <skos:definition xml:lang="en">Party who has processed the data in a manner such that the resource has been modified.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/distribuidor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">distribuidor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">distributor</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que distribuye el recurso.</skos:definition>
    <skos:definition xml:lang="en">Party who distributes the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/esponsor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">espónsor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sponsor</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que habla en nombre del recurso.</skos:definition>
    <skos:definition xml:lang="en">Party who speaks for the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/financiador">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">financiador</skos:prefLabel>
    <skos:prefLabel xml:lang="en">funder</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que proporciona apoyo financiero para el recurso.</skos:definition>
    <skos:definition xml:lang="en">Party providing monetary support for the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Rol de parte responsable</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Responsible Party Role</skos:prefLabel>
    <dcterms:title xml:lang="es">Rol de parte responsable</dcterms:title>
    <dcterms:title xml:lang="en">Responsible Party Role</dcterms:title>
    <skos:definition xml:lang="es">Función desempeñada por la parte responsable según ISO 19115 CI_RoleCode.</skos:definition>
    <skos:definition xml:lang="en">Function performed by the responsible party according to ISO 19115 CI_RoleCode.</skos:definition>
    <dcterms:description xml:lang="es">Función desempeñada por la parte responsable según ISO 19115 CI_RoleCode.</dcterms:description>
    <dcterms:description xml:lang="en">Function performed by the responsible party according to ISO 19115 CI_RoleCode.</dcterms:description>
