    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">propietario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">owner</skos:prefLabel>
    <skos:definition xml:lang="es">Parte propietaria del recurso.</skos:definition>
    <skos:definition xml:lang="en">Party that owns the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/interesado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">interesado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stakeholder</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que tiene interés en el recurso o en su uso.</skos:definition>
    <skos:definition xml:lang="en">Party who has an interest in the resource. or the use of the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/proveedor-de-recursos">
