  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/editor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">editor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">editor</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que revisó o modificó el recurso para mejorar el contenido.</skos:definition>
    <skos:definition xml:lang="en">Party who reviewed or modified the resource to improve the content.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/creador">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">creador</skos:prefLabel>
    <skos:prefLabel xml:lang="en">originator</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que creó el recurso.</skos:definition>
    <skos:definition xml:lang="en">Party who created the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/custodio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">custodio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">custodian</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que acepta la responsabilidad de los datos y asegura el cuidado y mantenimiento apropiados del recurso.</skos:definition>
    <skos:definition xml:lang="en">Party that accepts accountability and responsibility for the resource and ensures appropriate care and maintenance of the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/usuario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">usuario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">user</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que usa el recurso.</skos:definition>
    <skos:definition xml:lang="en">Party who uses the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/colaborador">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">colaborador</skos:prefLabel>
    <skos:prefLabel xml:lang="en">collaborator</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que ayuda en la generación del recurso distinta del investigador principal.</skos:definition>
    <skos:definition xml:lang="en">Party who assists with the generation of the resource other than the principal investigator.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/publicador">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">publicador</skos:prefLabel>
    <skos:prefLabel xml:lang="en">publisher</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que publica el recurso.</skos:definition>
    <skos:definition xml:lang="en">Party who published the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/mediador">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">mediador</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mediator</skos:prefLabel>
    <skos:definition xml:lang="es">Clase de entidad que media el acceso al recurso y para la cual el recurso está destinado o resulta útil.</skos:definition>
    <skos:definition xml:lang="en">A class of entity that mediates access to the resource and for whom the resource is intended or useful.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/co-autor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">co-autor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coAuthor</skos:prefLabel>
    <skos:definition xml:lang="es">Parte que coautoriza el recurso.</skos:definition>
    <skos:definition xml:lang="en">Party who jointly authors the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/investigador-principal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">investigador principal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">principalInvestigator</skos:prefLabel>
    <skos:definition xml:lang="es">Parte principal responsable de la recopilación de información y la dirección de la investigación.</skos:definition>
    <skos:definition xml:lang="en">Key party responsible for gathering information and conducting research</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
</rdf:RDF>
