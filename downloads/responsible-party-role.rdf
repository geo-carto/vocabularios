  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/punto-de-contacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
    <skos:prefLabel xml:lang="es">punto de contacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pointOfContact</skos:prefLabel>
    <skos:definition xml:lang="es">Parte con la que se puede contactar para adquirir conocimiento o acceder al recurso.</skos:definition>
    <skos:definition xml:lang="en">Party who can be contacted for acquiring knowledge about or acquisition of the resource.</skos:definition>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/responsible-party-role/propietario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/responsible-party-role"/>
