  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metamorfismo-grado/collection">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado"/>
    <skos:prefLabel xml:lang="es">Grado de metamorfismo - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Metamorphic grade - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-no-especificado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfizado-no-especificado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-alto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-bajo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-medio"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-muy-alto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-muy-bajo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/no-metamorfizado"/>
