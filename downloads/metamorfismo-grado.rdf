  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/metamorfismo-grado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Grado de metamorfismo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Metamorphic grade</skos:prefLabel>
    <dcterms:title xml:lang="es">Grado de metamorfismo</dcterms:title>
    <dcterms:title xml:lang="en">Metamorphic grade</dcterms:title>
    <skos:definition xml:lang="es">Términos que indica la intensidad o grado del metamorfismo aplicado a un EarthMaterial (por ejemplo, alto grado metamórfico, bajo grado metamórfico).</skos:definition>
    <skos:definition xml:lang="en">Terms indicating the intensity or rank of metamorphism applied to an EarthMaterial (e.g., high metamorphic grade, low metamorphic grade).</skos:definition>
    <dcterms:description xml:lang="es">Términos que indica la intensidad o grado del metamorfismo aplicado a un EarthMaterial (por ejemplo, alto grado metamórfico, bajo grado metamórfico).</dcterms:description>
    <dcterms:description xml:lang="en">Terms indicating the intensity or rank of metamorphism applied to an EarthMaterial (e.g., high metamorphic grade, low metamorphic grade).</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos originales del estándar GeoSciML traducidos al español por el IGME</dcterms:provenance>
    <dcterms:creator>https://cgi-iugs.org/</dcterms:creator>
    <dcterms:contributor>https://www.igme.es</dcterms:contributor>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Grado de metamorfismo.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-no-especificado"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-desconocido"/>
  </rdf:Description>
