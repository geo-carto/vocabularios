      {
        "@id": "https://geo-carto.github.io/vocabularios/afloramiento-caracter/con-afloramiento"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Afloramiento con muy mala calidad de exposición (como mucho se puede señalar la composición general de la unidad)"
      },
      {
        "@language": "en",
        "@value": "Bad exposed outrops, only suitable for determining the overall unit composition"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
