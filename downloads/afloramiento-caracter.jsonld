      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Carácter del afloramiento"
      },
      {
        "@language": "en",
        "@value": "Outcrop character"
      }
    ],
    "http://www.w3.org/ns/dcat#theme": [
      {
        "@value": "GE"
      }
    ]
