      {
        "@language": "es",
        "@value": "afloramiento alterado"
      },
      {
        "@language": "en",
        "@value": "weathered outcrop"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/afloramiento-caracter",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-06-01"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "https://www.igme.es"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "es",
        "@value": "Términos que describen la naturaleza de los afloramientos formados por una unidad geológica. Ejemplos: con bloques, formadora de acantilado, formadora de repisa, formadora de ladera, pobremente expuesta."
      },
      {
        "@language": "en",
        "@value": "Terms that describes the nature of outcrops formed by a geologic unit. Examples are: bouldery, cliff-forming, ledge-forming, slope-forming, poorly exposed."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-06-01"
      }
    ],
    "http://purl.org/dc/terms/provenance": [
      {
        "@value": "Términos propios definidos por el IGME"
      }
    ],
    "http://purl.org/dc/terms/publisher": [
      {
        "@id": "https://www.igme.es/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "es",
        "@value": "Carácter del afloramiento"
      },
      {
        "@language": "en",
        "@value": "Outcrop character"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0.0"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Términos que describen la naturaleza de los afloramientos formados por una unidad geológica. Ejemplos: con bloques, formadora de acantilado, formadora de repisa, formadora de ladera, pobremente expuesta."
      },
      {
        "@language": "en",
        "@value": "Terms that describes the nature of outcrops formed by a geologic unit. Examples are: bouldery, cliff-forming, ledge-forming, slope-forming, poorly exposed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "es",
        "@value": "Este archivo contiene el vocabulario Carácter del afloramiento."
      }
    ],
