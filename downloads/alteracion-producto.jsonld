        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/duricreta"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/travertino"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "regolito"
      },
      {
        "@language": "en",
        "@value": "regolith"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/caolin",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca constituida principalmente por minerales del grupo de la caolinita, y frecuentemente conteniendo una proporción variable de cuarzo, feldespato y mica, independientemente de su origen."
      },
      {
        "@language": "en",
        "@value": "Rock with kaolinite-group minerals predominating over accompanying minerals such as quartz, feldespar and mica, irrespective of their origin."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "caolín"
      },
      {
        "@language": "en",
        "@value": "kaolin"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/duricreta",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "costra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/regolito"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Las duricretas (corazas o costras) son cretas endurecidas, generalmente por cementación. Las cretas son acumulaciones de composición predominantemente uniforme, bien diferenciadas, más o menos endurecidas, que aparecen en alteritas, depósitos superficiales o suelos."
      },
      {
        "@language": "en",
        "@value": "Duricrusts are hard cretes (crusts), mainly by cementation. Cretes (crusts) are accumulations of mainly uniform composition, well differentiated, indurated or not, in alterites, superficial deposits or soils."
      }
    ],
