[
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/travertino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "caliza travertínica, toba calcárea"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/regolito"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza de color blanco o crema, con textura a menudo porosa o tubular, y formada por precipitación de carbonato cálcico en medios acuosos superficiales o subterráneos."
      },
      {
        "@language": "en",
        "@value": "Limestone of white or cream color, commonly having a porous or tubular texture, and formed by precipitation of calcium carbonate in a subaerial or subterranean aqueous environment."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "travertino"
      },
      {
        "@language": "en",
        "@value": "travertine"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/alterita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "a) Partícula de diámetro igual o inferior a 1/256 mm. b) Mineral del grupo de los aluminosilicatos hidratados que cristalizan en partículas de tamaño arcilla y se caracaterizan por presentar un comportamiento plástico cuando contienen agua. Incluyen los grupos de la caolinita, illita, esmectita y vermiculita. c) Sedimento con un contenido en minerales arcillosos superior al 67%."
      },
      {
        "@language": "en",
        "@value": "a) Particle having a diameter equal to or less than 1/256 mm. b) Minerals, especially hydrous aluminosilicates, cristallized in the clay-sized fraction and characterized by a plastic behaviour in relation to water content. Included are the kaolinite, illite, smectite or vermiculite groups. c) Sediment with more than 67 per cent clay-sized minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/caolin"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arcilla"
      },
      {
        "@language": "en",
        "@value": "clay"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/calcreta",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "caliche, costra calcárea"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/duricreta"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Acumulación predominantemente de carbonato cálcico, bien diferenciada, más o menos endurecida que aparece en alteritas, depósitos superficiales o suelos. Las calcretas endurecidas se denominan caliches o costras calcáreas."
      },
      {
        "@language": "en",
        "@value": "Accumulation of mainly calcium carbonate composition, well differentiated, indurated or not, in alterites, superficial deposits or soils. Caliches and calcareous crusts are indurated calcretes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "calcreta"
      },
      {
        "@language": "en",
        "@value": "calcrete"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/laterita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/alterita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Alterita originada por procesos de meteorización química en climas tropicales o subtropicales, y enriquecida en óxidos e hidróxidos de hierro y/o aluminio, frecuentemente con cuarzo y caolinita."
      },
      {
        "@language": "en",
        "@value": "Alterite caused by intense weathering in tropical to subtropical climate and enriched in oxides and hydroxides of iron, aluminum, or both, commonly with quartz and kaolinite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/laterita-aluminica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/laterita-ferrica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "laterita"
      },
      {
        "@language": "en",
        "@value": "laterite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/gore",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/alterita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Alterita originada por procesos químicos de hidrólisis de rocas metamórficas, especialmente gneises y micaesquistos caracterizados por feldespatos y biotitas, transformadas en minerales arcillosos."
      },
      {
        "@language": "en",
        "@value": "Alterite caused by chemical processes of hydrolysis of metamorphic rocks, especially gneisses and micaschists characterized by feldespars and biotites, transformed into clay minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "gore"
      },
      {
        "@language": "en",
        "@value": "gore"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla-de-descalcificacion",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/alterita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Alterita residual formada por disolución química de rocas carbonatadas, caracterizada por la acumulación de los componentes insolubles (minerales de arcillas, óxidos e hidróxidos de hierro y, ocasionalmente, sílice), que puede presentar diferentes grados de rubefacción y evolución edáfica según las condiciones climáticas y geomorfológicas."
      },
      {
        "@language": "en",
        "@value": "Alterita residual formada por disolución química de rocas carbonatadas, caracterizada por la acumulación de los componentes insolubles (minerales de arcillas, óxidos e hidróxidos de hierro y, ocasionalmente, sílice), que puede presentar diferentes grados de rubefacción y evolución edáfica según las condiciones climáticas y geomorfológicas."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla-de-descalcificacion-terra-rossa"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla-de-descalcificacion-terra-fusca"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arcilla de descalcificación"
      },
      {
        "@language": "en",
        "@value": "decarbonated clay"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/alterita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "depósito residual"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/saprolito"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Formación superficial originada por procesos de meteorización que transforman, en diversos grados, las características físicas y/o químicas de rocas o sedimentos. Se incluyen tanto las alteritas autóctonas o no transportadas como las alóctonas o transportadas. Las alteritas residuales presentan un grado de meteorización muy elevado, en las que gran parte del material original ha sido transportado."
      },
      {
        "@language": "en",
        "@value": "Superficial formation caused by the weathering of rocks or sediments and transformation, in several degrees, of their physical and chemical characteristics. Included are not transported or autochthonous alterites and transported or allochthonous alterites. Residual alterites presents an extremely high weathering degree, with a significantly reduced original volume."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/grus"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/gore"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/laterita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla-de-descalcificacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "alterita"
      },
      {
        "@language": "en",
        "@value": "alterite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla-de-descalcificacion-terra-fusca",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "terra fusca"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla-de-descalcificacion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Alterita para-autóctona originada por procesos químicos de disolución de rocas carbonatadas, en climas templado-húmedos, generando residuos no rubefactados, compuestos por minerales de arcillas, óxidos de hierro y, a veces, sílice."
      },
      {
        "@language": "en",
        "@value": "Alterite caused by chemical processes of dissolution of carbonate rocks in a warm-wet climate and characterized by not rubefacted products, containing clay minerals, iron oxides and, sometimes, silica."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arcilla de descalcificación - terra fusca"
      },
      {
        "@language": "en",
        "@value": "decarbonated clay - terra fusca"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/saprolito",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/regolito"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca meteorizada en la cual se conserva la fábrica de la roca original."
      },
      {
        "@language": "en",
        "@value": "Weathered bedrock characterized by preservation of fabrics that were present in the original bedrock."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/alterita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "saprolito"
      },
      {
        "@language": "en",
        "@value": "saprolite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/silcreta",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/duricreta"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Acumulación predominantemente silícea, bien diferenciada, más o menos endurecida, que aparece en alteritas, depósitos superficiales o suelos."
      },
      {
        "@language": "en",
        "@value": "Accumulation of mainly siliceous composition, well differentiated, indurated or not, in alterites, superficial deposits or soils."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "silcreta"
      },
      {
        "@language": "en",
        "@value": "silcrete"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "https://www.igme.es"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "es",
        "@value": "Términos que describen el material resultante de los procesos de alteración, por ejemplo: minerales de alteración, saprolita, ferricreta, arcilla, calcreta, skarn, etc. Los materiales observados en un perfil de suelo pueden identificarse con esta propiedad."
      },
      {
        "@language": "en",
        "@value": "The property alterationProduct is an association between the AlterationDescription and EarthMaterial describing the material resulting from alteration processes (e.g., alteration minerals, saprolite, ferricrete, clay, calcrete, skarn). Materials observed in a soil profile could be identified using this property."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://purl.org/dc/terms/provenance": [
      {
        "@value": "Términos propios definidos por el IGME"
      }
    ],
    "http://purl.org/dc/terms/publisher": [
      {
        "@id": "https://www.igme.es/"
      }
    ],
