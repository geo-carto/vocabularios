  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/grus",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "es",
        "@value": "arena"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/alterita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Alterita originada por procesos físicos de desintegración granular de rocas de grano grueso, transformadas en minerales y fragmentos de roca sin cohesión, caracterizados por su tamaño de grano, en el que las arenas (0,1-2,0 mm) y gravas (>2,0 mm) son la fracción predominante (Migon, 2004). Algunos autores restringen el término arene al grus derivado de la alteración de rocas plutónicas, fundamentalmente granitos y dioritas (Campy y Macaire, 1989)."
      },
      {
        "@language": "en",
        "@value": "Alterite caused by physical processes of granular disintegration of coarsed-grained rocks, transformed into minerals and rock fragments with no cohesion, characterized by its grain-size distribution, where the sand (0,1-2,0 mm) and gravel (>2,0 mm) fraction predominate (Migon, 2004). Some authors restrict the term arene to the grus derived from the weathering of plutonic rocks, mainly granites and diorites (Campy and Macaire, 1989)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "grus"
      },
      {
        "@language": "en",
        "@value": "grus"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/ferricreta",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/duricreta"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Acumulación predominantemente ferruginosa, bien diferenciada, más o menos endurecida que aparece en alteritas, depósitos superficiales o suelos."
      },
      {
        "@language": "en",
        "@value": "Accumulation of mainly ferruginous composition, well differentiated, indurated or not, in alterites, superficial deposits or soils."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ferricreta"
      },
      {
        "@language": "en",
        "@value": "ferricrete"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/regolito",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material que recubre la roca fresca. Incluye alteritas, depósitos superficiales y suelos."
      },
      {
        "@language": "en",
        "@value": "Material that covers the unweathered bedrock. It includes alterites, superficial deposits and soils."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/alteracion-producto/saprolito"
      },
