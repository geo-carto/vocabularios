      {
        "@language": "es",
        "@value": "Términos que identifican la superficie o marco espacial de referencia sobre el que se proyecta, observa o representa una entidad geológica cartografiada."
      },
      {
        "@language": "en",
        "@value": "Terms that identify the surface or spatial reference frame onto which a mapped geological entity is projected, observed, or represented."
      }
    ],
