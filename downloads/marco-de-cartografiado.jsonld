  {
    "@id": "https://geo-carto.github.io/vocabularios/marco-de-cartografiado/geologia-superficial",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/marco-de-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca y depósitos superficiales que se hacen visibles si se retira el suelo suprayacente o que están expuestos en la superficie topográfica"
      },
      {
        "@language": "en",
        "@value": "Bedrock and predominantly unconsolidated sedimentary material of Quaternary age (superficial deposits) that would be visible if the overlying soil was removed or are exposed at the topographic surface"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/MappingFrameValue/surfaceGeology"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/mappingframe/surface_geology"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/marco-de-cartografiado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "geología superficial"
      },
      {
        "@language": "en",
        "@value": "surface geology"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/marco-de-cartografiado"
      }
    ],
