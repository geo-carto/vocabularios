    skos:prefLabel "Contributor role - All concepts"@en,
        "Rol de contribuyente - Todos los conceptos"@es .

<https://linked.data.gov.au/org/cgi-gtwg> a sdo:Organization ;
    sdo:affiliation <https://linked.data.gov.au/org/cgi> ;
    sdo:name "CGI Geoscience Terminology Working Group" ;
    sdo:url <http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html> .

<https://linked.data.gov.au/org/cgi> a sdo:Organization ;
    sdo:name "Commission for the Management and Application of Geoscience Information" ;
    sdo:url <http://www.cgi-iugs.org> .

<https://geo-carto.github.io/vocabularios/contribucion-rol/administrador-base-de-datos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:broader <https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales> ;
    skos:definition "Person or entity responsible for managing, maintaining and administering the database containing the resource information."@en,
        "Persona o entidad responsable de la gestión, mantenimiento y administración de la base de datos que contiene la información del recurso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "database administrator"@en,
        "administrador de base de datos"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/autor> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity responsible for the intellectual creation of the resource content."@en,
        "Persona o entidad responsable de la creación intelectual del contenido del recurso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "author"@en,
        "autor"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/cartografo-de-campo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity responsible for producing geological cartography based on field observations and mapping."@en,
        "Persona o entidad responsable de la elaboración de la cartografía geológica mediante observaciones y levantamientos realizados en campo."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "field cartographer"@en,
        "cartógrafo de campo"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/co-autor> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity who significantly contributes to the intellectual creation of the resource content together with the main author."@en,
        "Persona o entidad que contribuye significativamente a la creación intelectual del contenido del recurso junto con el autor principal."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "co-author"@en,
        "co-autor"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-cientifico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity responsible for coordinating the scientific aspects of the project and ensuring the scientific consistency and quality of the results."@en,
        "Persona o entidad responsable de la coordinación de los aspectos científicos del proyecto y de garantizar la coherencia y calidad científica de los resultados."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "scientific coordinator"@en,
        "coordinador científico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-proyecto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity responsible for the organisational coordination and operational monitoring of the project, including meetings, deadlines and communication among participants."@en,
        "Persona o entidad responsable de la coordinación organizativa y del seguimiento operativo del proyecto, incluyendo reuniones, plazos y comunicación entre participantes."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "project coordinator"@en,
        "coordinador de proyecto"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-tecnico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity responsible for coordinating the technical aspects of the project, including methodologies, tools and workflows."@en,
        "Persona o entidad responsable de la coordinación de los aspectos técnicos del proyecto, incluyendo metodologías, herramientas y flujos de trabajo."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "technical coordinator"@en,
        "coordinador técnico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/creador-de-servicios-web> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:broader <https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales> ;
    skos:definition "Person or entity responsible for creating and configuring web services for publishing and accessing the resource."@en,
        "Persona o entidad responsable de la creación y configuración de servicios web para la publicación y acceso al recurso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "web service creator"@en,
        "creador de servicios web"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/creador-metadatos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:broader <https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales> ;
    skos:definition "Person or entity responsible for creating and documenting the metadata describing the resource and its characteristics."@en,
        "Persona o entidad responsable de crear y documentar los metadatos que describen el recurso y sus características."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "metadata creator"@en,
        "creador de metadatos"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/creador-modelos-de-datos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:broader <https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales> ;
    skos:definition "Person or entity responsible for designing and documenting the structure, entities, attributes, relationships and constraints of a data model."@en,
        "Persona o entidad responsable de diseñar y documentar la estructura, las entidades, los atributos, las relaciones y las restricciones de un modelo de datos."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "data model creator"@en,
        "creador de modelos de datos"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/desarrollador-geoespacial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:broader <https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales> ;
    skos:definition "Person or entity responsible for developing applications, tools, scripts and software components for managing, processing or visualising geospatial information."@en,
        "Persona o entidad responsable de desarrollar aplicaciones, herramientas, scripts y componentes de software para la gestión, procesamiento o visualización de información geoespacial."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "geospatial developer"@en,
        "desarrollador geoespacial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/digitalizador> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:broader <https://geo-carto.github.io/vocabularios/contribucion-rol/tecnico-sig> ;
    skos:definition "Person or entity responsible for the digitisation of data."@en,
        "Persona o entidad responsable de la digitalización de datos."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "digitiser"@en,
        "digitalizador"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/director-proyecto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person responsible for the overall direction of the project and the supervision of its implementation."@en,
        "Persona responsable de la dirección general del proyecto y de la supervisión de su ejecución."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "project director"@en,
        "director de proyecto"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/editor-cartografico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity responsible for reviewing and preparing the cartographic resource for publication."@en,
        "Persona o entidad responsable de la revisión y preparación cartográfica del recurso para su publicación."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "cartographic editor"@en,
        "editor cartográfico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/investigador-principal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:altLabel "PI"@en,
        "IP"@es ;
    skos:definition "Person responsible for the scientific leadership of the research project and the achievement of its scientific and technical objectives."@en,
        "Persona responsable de la dirección científica del proyecto de investigación y del cumplimiento de sus objetivos científico-técnicos."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "principal investigator"@en,
        "investigador principal"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/revisor-científico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity responsible for reviewing the scientific quality and accuracy of the resource."@en,
        "Persona o entidad encargada de revisar la calidad y exactitud científica del recurso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "scientific reviewer"@en,
        "revisor científico"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/revisor-informacion-digital> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity responsible for reviewing the quality, coherence and consistency of the digital information associated with the resource."@en,
        "Persona o entidad responsable de revisar la calidad, coherencia y consistencia de la información digital asociada al recurso."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:prefLabel "digital data reviewer"@en,
        "revisor información digital"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/tecnico-sig> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:broader <https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales> ;
    skos:definition "Person or entity responsible for managing, editing, transforming, integrating, validating, analysing and representing geospatial information using GIS tools and processes."@en,
        "Persona o entidad responsable de gestionar, editar, transformar, integrar, validar, analizar y representar información geoespacial mediante herramientas y procesos SIG."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/contribucion-rol/digitalizador> ;
    skos:prefLabel "GIS technician"@en,
        "técnico SIG"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol/implementador-soluciones-geoespaciales> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:definition "Person or entity responsible for implementing and maintaining systems, tools and processes for managing, processing and publishing geospatial information. This role may involve the integrated execution of several functions represented by the more specific roles it encompasses."@en,
        "Persona o entidad responsable de implementar y mantener sistemas, herramientas y procesos para la gestión, tratamiento y publicación de información geoespacial. Puede desempeñar de forma integrada varias de las funciones representadas por los roles específicos que engloba."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/contribucion-rol/administrador-base-de-datos>,
        <https://geo-carto.github.io/vocabularios/contribucion-rol/creador-de-servicios-web>,
        <https://geo-carto.github.io/vocabularios/contribucion-rol/creador-metadatos>,
        <https://geo-carto.github.io/vocabularios/contribucion-rol/creador-modelos-de-datos>,
        <https://geo-carto.github.io/vocabularios/contribucion-rol/desarrollador-geoespacial>,
        <https://geo-carto.github.io/vocabularios/contribucion-rol/tecnico-sig> ;
    skos:prefLabel "geospatial systems implementer"@en,
        "implementador de soluciones geoespaciales"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/contribucion-rol> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/contribucion-rol> a skos:ConceptScheme ;
    dcterms:created "2026-06-01"^^xsd:date ;
    dcterms:creator "https://www.igme.es" ;
    dcterms:description "Terms defining the role played by a contributor in relation to a dataset or part of it."@en,
