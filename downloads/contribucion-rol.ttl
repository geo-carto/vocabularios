    dcterms:provenance "Términos propios definidos por el IGME" ;
    dcterms:publisher <https://www.igme.es/> ;
    dcterms:title "Contributor role"@en,
        "Rol de contribuyente"@es ;
    owl:versionInfo "1.0.2" ;
    skos:definition "Terms defining the role played by a contributor in relation to a dataset or part of it."@en,
        "Términos que definen el rol desempañado por un contribuyente en relación a un conjunto de datos o parte de él."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Rol de contribuyente."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/contribucion-rol/autor>,
