      {
        "@language": "es",
        "@value": "Roca sienítica de feldespato alcalino con feldespatoide en proporción inferior al 10 por ciento, entre los componentes qapf. sector 6' del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Alkali feldspar synitic rock that contains 0-10 percent feldspathoid mineral and no quartz in the qapf fraction. qapf field 6'."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
