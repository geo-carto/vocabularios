        "@language": "es",
        "@value": "Desechos procedentes de las excavaciones mineras."
      },
      {
        "@language": "en",
        "@value": "Spoil, overburden and other material excavated in mining."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/mineDumpMaterial"
