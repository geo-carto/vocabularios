      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sienítica de feldespato alcalino que contiene cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. sector 6 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Alkali feldspar synitic rock that contains 0-5 percent quartz and no feldspathoid in the qapf fraction. qapf field 6."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparSyenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sienita de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar syenite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-siliceo-no-clastico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material sedimentario formado al menos en el 50 por ciento por material mineral de silicatos, depositado en la superficie de deposición directamente por procesos químicos o biológicos o en partículas formadas por procesos químicos o biológicos dentro de la cuenca de deposición."
      },
      {
        "@language": "en",
        "@value": "Sedimentary material that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/non-clasticSiliceousSedimentaryMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-siliceo-no-clastico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-no-clastica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material sedimentario silíceo no clástico"
      },
      {
        "@language": "en",
        "@value": "non-clastic siliceous sedimentary material"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
