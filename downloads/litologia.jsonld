      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca cristalina leucocrática caracterizada por su textura alotriomórfica-equigranular de grano fino (aplítica, sacaroidea o xenomórfica), normalmente de composición granítica con cuarzo, feldespato alcalino y plagioclasa sódica."
      },
      {
        "@language": "en",
        "@value": "Light coloured crystalline rock, characterized by a fine grained allotriomorphic-granular (aplitic, saccharoidal or xenomorphic) texture; typically granitic composition, consisting of quartz, alkali feldspar and sodic plagioclase."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/aplite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/aplite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "aplita"
      },
      {
        "@language": "en",
        "@value": "aplite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
