        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-rica-en-vidrio"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea con un porcentaje de vidrio superior al 80 por ciento."
      },
      {
        "@language": "en",
        "@value": "Igneous rock that consists of greater than 80 percent massive glass."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/glassyIgneousRock"
