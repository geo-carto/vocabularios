      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-rico-en-materia-organica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-fosfatado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material sedimentario"
      },
      {
        "@language": "en",
        "@value": "sedimentary material"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
