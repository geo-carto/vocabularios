      {
        "@language": "en",
        "@value": "acidic igneous rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/brecha-de-cenizas,-tefra-de-bombas-o-bloques",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/tefra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Piroclastos (o tefra) con más del 25 por ciento de los fragmentos mayores de 64 mm de longitud. incluye las brechas de ceniza, las bombas y los bloques piroclásticos según la definición de gillespie y styles (1999)"
      },
      {
        "@language": "en",
        "@value": "Tephra in which more than 25 percent of particles are greater than 64 mm in largest dimension. includes ash breccia, bomb tephra and block tephra of gillespie and styles (1999)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/ashBreccia"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "brecha de cenizas, tefra de bombas o bloques"
      },
      {
        "@language": "en",
        "@value": "ash breccia, bomb, or block tephra"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/grava",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento clástico que contiene más de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro). más de la mitad de los clastos son de origen epiclástico."
      },
      {
        "@language": "en",
        "@value": "Clastic sediment containing greater than 30 percent gravel-size particles (greater than 2.0 mm diameter). gravel in which more than half of the particles are of epiclastic origin"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/gravel"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/gravel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "grava"
      },
      {
        "@language": "en",
        "@value": "gravel"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/marga",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Lutita que, en la fracción lutítica, contiene un porcentaje superior al 50 por ciento de minerales carbonatados de cualquier origen."
      },
      {
        "@language": "en",
        "@value": "Mudstone that consists of greater than 50 percent carbonate minerals of any origin in the mud size fraction."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/carbonateMudstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mudstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/mudstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "marga"
      },
      {
        "@language": "en",
        "@value": "carbonate mudstone"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/riolita-de-feldespato-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-riolitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Riolitoide con una proporción de plagioclasa con respecto al total de feldespato  inferior al 10 por ciento. sector 2 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Rhyolitoid in which the ratio of plagioclase to total feldspar is less than 0.1. qapf field 2."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparRhyolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_rhyolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "riolita de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar rhyolite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/espilita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metasomatica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea alterada de grano fino y composición básica a  intermedia en la que el feldespato está compuesto parcial o totalmente por albita, habitualmente acompañada por clorita, calcita, cuarzo, epidota, prehnita y productos de cristalización hidratados de baja temperatura. habitualmente conserva las características volcánicas eruptivas."
      },
      {
        "@language": "en",
        "@value": "Altered basic to intermediate composition fine-grained igneous rock in which the feldspar is partially or completely composed of of albite, typically accompanied by chlorite, calcite, quartz, epidote, prehnite, and low-tempaerature hydrous crystallization products. preservation of eruptive volcanic features is typical."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/spilite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/spilite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "espilita"
      },
      {
        "@language": "en",
        "@value": "spilite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-biogenica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-silicea-no-clastica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria compuesta, al menos en un 50 por ciento, por material mineral silíceo, sedimentado como resultado de procesos biológicos sobre la superficie de depósito o en partículas dentro de la cuenca sedimentaria."
      },
      {
        "@language": "en",
        "@value": "Sedimentary rock that consists of at least 50 percent silicate mineral material, deposited directly by biological processes at the depositional surface, or in particles formed by biological processes within the basin of deposition."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/biogenicSilicaSedimentaryRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/biogenic_silica_sedimentary_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca sedimentaria silícea biogénica"
      },
      {
        "@language": "en",
        "@value": "biogenic silica sedimentary rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/monzodiorita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-monzodioritica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca monzodiorítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. contiene plagioclasa sódica (an0 a an50), feldespato alcalino, hornblenda y biotita, con ausencia o muy bajo contenido de piroxeno. incluye a las rocas del sector 9 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Phaneritic crystalline igneous rock consisting of sodic plagioclase (an0 to an50), alkali feldspar, hornblende and biotite, with or without pyroxene, and 0 to 5 percent quartz. includes rocks defined modally in qapf field 9."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/monzodiorite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzodiorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "monzodiorita"
      },
      {
        "@language": "en",
        "@value": "monzodiorite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/dacita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica porfídica o de grano fino compuesta generalmente por cuarzo y plagioclasa sódica, con cantidades menores de biotita y/o hornblenda y/o piroxeno; es el equivalente volcánico de la granodiorita y la tonalita. contiene menos de un 90 por ciento de minerales máficos, entre un 20 y un 60 por ciento de cuarzo, entre los componentes qapf, y una proporción entre la plagioclasa y el total de feldespato mayor del 65 por ciento. incluye a las rocas  asignadas modalmente a los sectores 4 y 5 del diagrama qapf o, químicamente, al sector o3 del diagrama tas."
      },
      {
        "@language": "en",
        "@value": "Fine grained or porphyritic crystalline rock that contains less than 90 percent mafic minerals, between 20 and 60 percent quartz in the qapf fraction, and has a plagioclase to total feldspar ratio greater than 0.65. includes rocks defined modally in qapf fields 4 and 5 or chemically in tas field o3. typcially composed of quartz and sodic plagioclase with minor amounts of biotite and/or hornblende and/or pyroxene; fine-grained equivalent of granodiorite and tonalite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/dacite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/dacite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "dacita"
      },
      {
        "@language": "en",
        "@value": "dacite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sienita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sienitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sienítica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye las rocas del sector 7 del esquema qapf."
      },
      {
        "@language": "en",
        "@value": "Synitic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the qapf fraction. defined modally in qapf field 7."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/syenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sienita"
      },
      {
        "@language": "en",
        "@value": "syenite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/horizonte-organico-del-suelo",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Horizonte superior del suelo, de color oscuro, cuyo espesor varía en los distintos tipos de suelos."
      },
      {
        "@language": "en",
        "@value": "The dark-colored upper portion af a soil, varying in depth according to soil type."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/topsoil"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "horizonte orgánico del suelo"
      },
      {
        "@language": "en",
        "@value": "topsoil"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
