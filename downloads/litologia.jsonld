      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca traquítica de feldespato alcalino con feldespatoide en proporción inferior al 10 por ciento, entre los componentes qapf. sector 6' del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Alkali feldspar trachytic rock that contains no quartz and between 0 and 10 percent feldspathoid mineral in the qapf fraction. qapf field 6'."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
