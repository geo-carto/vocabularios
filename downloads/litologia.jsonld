        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/granito"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Granito con una proporción de plagioclasa con respecto al total de feldespato superior 35 por ciento. incluye a las rocas del sector 3b del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Granite that has a plagiolcase to total feldspar ratio between 0.35 and 0.65. qapf field 3b."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/monzogranite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzogranite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
