  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/granito-de-feldespato-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/granitoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Granitoide con una proporción entre la plagioclasa y el total de feldespato inferior al 10 por ciento. sector 2 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Granitic rock that has a plagioclase to total feldspar ratio less than 0.1. qapf field 2."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparGranite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_granite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "granito de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar granite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/granitoide",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica compuesta por cuarzo, feldespato alcalino y/o plagioclasa. incluye a las rocas de los sectores 2, 3, 4 y 5 del diagrama qapf que corresponden al granito de feldespato alcalino, granito, granodiorita y tonalita."
      },
      {
        "@language": "en",
        "@value": "Phaneritic crystalline igneous rock consisting of quartz, alkali feldspar and/or plagioclase. includes rocks defined modally in qapf fields 2, 3, 4 and 5 as alkali feldspar granite, granite, granodiorite or tonalite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/granitoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/granitoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/granito-de-feldespato-alcalino"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/granito"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/granodiorita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/tonalita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "granitoide"
      },
      {
        "@language": "en",
        "@value": "granitoid"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/antracita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/carbon"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Carbón que contiene vitrinita con un valor medio de reflectancia (ro) superior al 2 por ciento (determinado según la iso 7404-5). contiene (en seco y libre de cenizas) valores inferiores al 12-14 por ciento de volátiles y un porcentaje superior al 91 por ciento de carbono fijado. es el carbón de mayor rango. es muy duro, satinado, negro, con brillo semimetálico y fractura semi-concoidea."
      },
      {
        "@language": "en",
        "@value": "Coal that has vitrinite mean random reflectance greater than 2.0 per cent (determined in conformance with iso 7404-5). less than 12-14 percent volatiles (dry, ash free), greater than 91 percent fixed carbon (dry, ash free basis). the highest rank coal; very hard, glossy, black, with semimetallic luster, semi conchoidal fracture."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/anthraciteCoal"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/anthracite_coal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "antracita"
      },
      {
        "@language": "en",
        "@value": "anthracite coal"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/gabroide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Gabroide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento. incluye a las rocas de los sectores 9, 9' y 9* del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Gabbroid with a plagioclase to total feldspar ratio between 0.65 and 0.9. qapf field 9, 9 prime and 9 asterisk"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/monzogabbroicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzogabbroic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/monzogabro-con-foides"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/monzogabro"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/monzonita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzogabro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca monzogabroica"
      },
      {
        "@language": "en",
        "@value": "monzogabbroic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/fonolita-tefritica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fonolitoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Fonolitoide cuya proporción de plagioclasa con respecto al total de feldespato es superior al 10 por ciento. en sentido amplio corresponde a la tefrifonolita situada en el sector u3 del diagrama tas."
      },
      {
        "@language": "en",
        "@value": "Phonolitoid that has a plagioclase to total feldspar ratio between 0.1 and 0.5. broadly corresponds to tas tephriphonolite of tas field u3."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/tephriticPhonolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/tephritic_phonolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "fonolita tefrítica"
      },
      {
        "@language": "en",
        "@value": "tephritic phonolite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sienita-de-feldespato-alcalino",
    "@type": [
