        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/quartzTrachyte"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/quartz_trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cuarzo-traquita"
      },
      {
        "@language": "en",
        "@value": "quartz trachyte"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
