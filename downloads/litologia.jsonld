        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-pelitico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento de tamaño lutita que contiene entre el 10 y el 50 por ciento de minerales carbonatados de cualquier tamaño. no tiene un origen específico."
      },
      {
        "@language": "en",
        "@value": "Mud size sediment that contains between 10 and 50 percent carbonate minerals in any size fraction. carbonate origin is not specified."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/carbonateRichMud"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mud"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "fango rico en carbonatos"
      },
      {
        "@language": "en",
        "@value": "carbonate rich mud"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/monzodiorita-foiditica",
