        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/pizarra",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca compacta de grano fino, con una granulometría media inferior a 0,032 mm y que presenta una foliación muy bien desarrollada (clivaje pizarroso) y que por tanto puede ser separada en lajas o placas delgadas."
      },
      {
        "@language": "en",
        "@value": "Compact, fine grained rock with an average grain size less than 0.032 millimeter and a well developed schistosity (slaty cleavage), and hence can be split into slabs or thin plates."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/slate"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/slate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "pizarra"
      },
      {
        "@language": "en",
        "@value": "slate"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/grava-fina-media",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento con más de un 30 por ciento de clastos de tamaño grava (2 - 64 mm de diámetro)."
      },
      {
        "@language": "en",
        "@value": "Sediment containing greater than 30 percent pebble-size particles (2.0 -64 mm in diameter)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/pebbleGravelSizeSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "grava fina-media"
      },
      {
        "@language": "en",
        "@value": "pebble gravel size sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/traquitoide",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica porfídica que contiene menos de un 90 por ciento de minerales máficos, menos de un 10 por ciento de feldespatoide y de un 20 por ciento de cuarzo, entre los componentes qapf, y con una proporción entre la plagioclasa y el total de feldespato inferior al 65 por ciento. entre los minerales máficos incluye habitualmente anfíbol o mica. engloba a las rocas de los sectores 6, 7 y 8 (con sus subdivisiones) del diagrama qapf o que químicamente se sitúan en el sector t del diagrama tas, como traquita o traquidacita."
      },
      {
        "@language": "en",
        "@value": "Fine grained igneous rock than contains less than 90 percent mafic minerals, less than 10 percent feldspathoid mineral and less than 20 percent quartz in the qapf fraction and has a plagioclase to total feldspar ratio less than 0.65. mafic minerals typically include amphibole or mica; typically porphyritic. includes rocks defined modally in qapf fields 6, 7 and 8 (with subdivisions) or chemically in tas field t as trachyte or latite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/trachytoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/trachytoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-traquitica-de-feldespato-alcalino"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-latitica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-traquitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "traquitoide"
      },
      {
        "@language": "en",
        "@value": "trachytoid"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-clastico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material sedimentario con un estado de consolidación no especificado en el que al menos el 50 por ciento de las partículas componentes derivan de la erosión, la meteorización o del movimiento en masa de materiales terrestres preexistentes y transportados al lugar de sedimentación por agentes mecánicos como el agua, el viento, el hielo o la gravedad."
      },
      {
        "@language": "en",
        "@value": "Sedimentary material of unspecified consolidation state in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/clasticSedimentaryMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material sedimentario clástico"
      },
      {
        "@language": "en",
        "@value": "clastic sedimentary material"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/material-antropico-no-consolidado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
