        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/dioritoide-foiditico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Dioritoide foidítico con una proporción entre la plagioclasa y el total de feldespato inferior al 90 por ciento. incluye a las rocas del sector 13 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Foid dioritoid in which the plagioclase to total feldspar ratio is between 0.1 and 0.9. includes rocks defined modally in qapf field 13."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/foidMonzodiorite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_monzodiorite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "monzodiorita foidítica"
      },
      {
        "@language": "en",
        "@value": "foid monzodiorite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
