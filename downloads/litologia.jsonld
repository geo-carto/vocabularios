        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-compuesto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material formado por acumulación de fragmentos sólidos depositado por el aire, el agua o el hielo, o acumulado por la acción de otros agentes naturales, como la precipitación química de una solución o la secreción por organismos."
      },
      {
        "@language": "en",
        "@value": "Material formed by accumulation of solid fragmental material deposited by air, water or ice, or material that accumulated by other natural agents such as chemical precipitation from solution or secretion by organisms."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
