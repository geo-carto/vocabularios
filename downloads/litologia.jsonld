  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-piroclastica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-fragmentaria"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea constituida por productos fragmentarios de los cuales más de un 75 por ciento se han producido como resultado de una erupción o extrusión de magma. incluye a las autobrechas asociadas con los flujos de lava y excluye a los depósitos retrabajados por procesos epiclásticos."
      },
      {
        "@language": "en",
        "@value": "Fragmental igneous rock that consists of greater than 75 percent fragments produced as a direct result of eruption or extrusion of magma from within the earth onto its surface. includes autobreccia associated with lava flows and excludes deposits reworked by epiclastic processes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/pyroclasticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/toba-de-ceniza"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/brecha-tobacea"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/toba-de-ceniza,-lapillistone-y-toba-de-lapilli"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/brecha-tobacea,-aglomerado-o-brecha-piroclastica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca piroclástica"
      },
      {
        "@language": "en",
        "@value": "pyroclastic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-impuro",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento carbonatado en el que entre el 50 y el 90 por ciento de los elementos integrantes están compuestos por uno (o más) carbonatos de origen intracuencal."
      },
      {
        "@language": "en",
        "@value": "Carbonate sediment in which between 50 and 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/impureCarbonateSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/impure_carbonate_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento carbonatado impuro"
      },
      {
        "@language": "en",
        "@value": "impure carbonate sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-de-origen-natural-no-consolidado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material no consolidado formado por agregación de partículas transportadas o depositadas por el aire, el agua o el hielo, o acumulado por otros agentes naturales, como la precipitación química, que forma estratos en la superficie terrestre."
      },
      {
        "@language": "en",
        "@value": "Unconsolidated material consisting of an aggregation of particles transported or deposited by air, water or ice, or that accumulated by other natural agents, such as chemical precipitation, and that forms in layers on the earth's surface."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/sediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-biogenico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-hibrido"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-pelitico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-arena"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento"
      },
      {
        "@language": "en",
        "@value": "sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-traquita-de-feldespato-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-traquitica-de-feldespato-alcalino"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca traquítica de feldespato alcalino que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 6* del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Alkali feldspar trachytic rock that contains and between 5 and 20 percent quartz mineral in the qapf fraction. qapf field 6*."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/quartzAlkaliFeldsparTrachyte"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/quartz_alkali_feldspar_trachyte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cuarzo-traquita de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "quartz alkali feldspar trachyte"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/dioritoide-foiditico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica en la que m es inferior a 90, la proporción entre la plagioclasa y el total de feldespato es mayor del 50 por ciento y el feldespatoide constituye entre un 10 y un 60 por ciento entre los componentes qapf; la plagioclasa contienen menos del 50 por ciento de anortita. comúnmente presenta un elevado contenido en minerales máficos. incluye las rocas de los sectores 13 y 14 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Phaneritic crystalline igneous rock in which m is less than 90, the plagioclase to total feldspar ratio is greater than 0.5, feldspathoid minerals form 10-60 percent of the qapf fraction, plagioclase has anorthite content less than 50 percent. these rocks typically contain large amounts of mafic minerals. includes rocks defined modally in qapf fields 13 and 14."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/foidDioritoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_dioritoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/diorita-foiditica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/monzodiorita-foiditica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "dioritoide foidítico"
      },
      {
        "@language": "en",
        "@value": "foid dioritoid"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/grava-gruesa",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-grava"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento que contiene más de un 30 por ciento de clastos de tamaño canto (64-256 mm de diámetro)."
      },
      {
        "@language": "en",
        "@value": "Sediment containing greater than 30 percent cobble-size particles (64-256 mm in diameter)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/cobbleGravelSizeSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/cobble_gravel_size_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "grava gruesa"
      },
      {
        "@language": "en",
        "@value": "cobble gravel size sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/fonolita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fonolitoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Fonolitoide cuya proporción de plagioclasa con respecto al total de feldespato es inferior al 10 por ciento. está formada por feldespato alcalino, feldespatoide y minerales máficos."
      },
      {
        "@language": "en",
        "@value": "Phonolitoid in which the plagioclase to total feldspar ratio is less than 0.1. rock consists of alkali feldspar, feldspathoid minerals, and mafic minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/phonolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phonolilte"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "fonolita"
      },
      {
        "@language": "en",
        "@value": "phonolite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-milonitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-relacionado-con-una-falla"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica que se caracteriza por una foliación debida a la disminución del tamaño de grano como consecuencia de esfuerzos tectónicos, y en la que más del 10 por ciento del volumen de la roca ha experimentado una reducción del tamaño de grano. incluye a las protomilonitas, milonitas, ultramilonitas y blastomilonitas."
      },
      {
        "@language": "en",
        "@value": "Metamorphic rock characterised by a foliation resulting from tectonic grain size reduction, in which more than 10 percent of the rock volume has undergone grain size reduction. includes protomylonite, mylonite, ultramylonite, and blastomylonite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/myloniticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/filonita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca milonítica"
      },
      {
        "@language": "en",
        "@value": "mylonitic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-fosfatado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-fosfatado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento en el que como mínimo el 50 por ciento de sus componentes, ya sean primarios o recristalizados, son fosfatos."
      },
      {
        "@language": "en",
        "@value": "Sediment in which at least 50 percent of the primary and/or recrystallized constituents are phosphate minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/phosphateRichSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phosphate_rich_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento fosfatado"
      },
      {
        "@language": "en",
        "@value": "phosphate rich sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/escombera",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
