        "@language": "es",
        "@value": "traquita de feldespato alcalino con foides"
      },
      {
        "@language": "en",
        "@value": "foid bearing alkali feldspar trachyte"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/monzogabro-foiditico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/gabroide-foiditico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Gabroide foidítico con una proporción entre la plagioclasa y el total de feldespato inferior al 90 por ciento. incluye a las rocas del sector 13 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Foid gabbroid that has a plagioclase to total feldspar ratio between 0.5 and 0.9. includes rocks defined modally in qapf field 13."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/foidMonzogabbro"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_monzogabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "monzogabro foidítico"
      },
      {
        "@language": "en",
        "@value": "foid monzogabbro"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/lutita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria clástica con menos de un 30 por ciento de clastos de tamaño arena (0,6 - 2,0 mm de diámetro) y una relación entre partículas de lutita y granos de arena mayor que 1."
      },
      {
        "@language": "en",
        "@value": "Clastic sedimentary rock consisting of less than 30 percent sand-size (0.6 mm) particles and with a mud to sand ratio greater than 1."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/mudstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/arcillita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/shale"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/limolita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "lutita"
      },
      {
        "@language": "en",
        "@value": "mudstone"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/framestone",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca arrecifal carbonatada formada por una estructura rígida de colonias, conchas o esqueletos, con cavidades internas rellenas de sedimentos finos; normalmente su origen es debido a la actividad de organismos coloniales."
      },
      {
        "@language": "en",
        "@value": "Carbonate reef rock consisting of a rigid framework of colonies, shells or skeletons, with internal cavities filled with fine sediment; usually created through the activities of colonial organisms."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/framestone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/framestone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "framestone"
      },
      {
        "@language": "en",
        "@value": "framestone"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/basalto-toleitico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/basalto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Basalto relativamente pobre en sodio, con fenocristales de piroxeno (augita y ortopiroxeno o pigeonita), plagioclasa rica en calcio y, con frecuencia, olivino que puede tener envueltas de reacción tipo \"rims\" de pigeonita, por reacción del olivino con el magma residual; se caracteriza por una matriz con dos fases de piroxeno, así como cuarzo, tridimita o cristobalita intersticiales y, a menudo, sílice intersticial de textura vítrea. esta categoría incluye a la mayoría de los basaltos de fondo oceánico y de las islas oceánicas, así como a las inundaciones basálticas continentales (\"traps\" basálticos), como la de la meseta del río columbia."
      },
      {
        "@language": "en",
        "@value": "Tholeiitic basalt is defined here to contain 2 pyroxene phases and interstitial quartz or tridymite or cristobalite in the groundmass. pyroxene (augite and orthopyroxene or pigeonite) and calcium-rich plagioclase are common phenocryst minerals. olivine may also be a phenocryst, and when present, may have rims of pigeonite. only in tholeiitic basalt is olivine in reaction relationship with melt. interstitial siliceous residue may be present, and is often glassy. tholeiitic basalt is relatively poor in sodium. this category includes most basalts of the ocean floor, most large oceanic islands, and continental flood basalts such as the columbia river plateau."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/tholeiiticBasalt"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/tholeiitic_basalt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "basalto toleítico"
      },
      {
        "@language": "en",
        "@value": "tholeiitic basalt"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-ferruginoso",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-ferruginoso"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento compuesto, como mínimo en un 50 por ciento, por minerales con hierro (hematites, magnetita, grupo de la limonita, siderita, sulfuros de hierro) determinados mediante lupa o análisis petrográfico. generalmente contiene un 15 por ciento de hierro en peso."
      },
      {
        "@language": "en",
        "@value": "Sediment that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. corresponds to a rock typically containing 15 percent iron by weight."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/ironRichSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento ferruginoso"
      },
      {
        "@language": "en",
        "@value": "iron rich sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/material-igneo",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-compuesto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material terrestre formado como resultado de procesos ígneos, como la intrusión y enfriamiento del magma en la corteza o las erupciones volcánicas."
      },
      {
        "@language": "en",
        "@value": "Earth material formed as a result of igneous processes, e.g. intrusion and cooling of magma in the crust, volcanic eruption."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/igneousMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/igneous_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-igneo-fragmentario"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-igneo-acido"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-igneo-basico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-igneo-de-composicion-intermedia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material ígneo"
      },
      {
        "@language": "en",
        "@value": "igneous material"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/lutita-generica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria con menos de un 30 por ciento de componentes mayores de 2 mm de diámetro (grava) y cuya relación entre las partículas de lutita y los granos de arena es mayor que 1. los clastos pueden ser de cualquier composición y origen."
      },
      {
        "@language": "en",
        "@value": "Sedimentary rock consisting of less than 30 percent gravel-size (2 mm) particles and with a mud to sand ratio greater than 1. clasts may be of any composition or origin."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/genericMudstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/generic_mudstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/lutita-rica-en-carbonatos"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/lutita-organica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/lutita-siliciclastica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "lutita genérica"
      },
      {
        "@language": "en",
        "@value": "generic mudstone"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/tonalita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/granitoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Granitoide constituido por cuarzo y plagioclasa intermedia, generalmente con biotita y anfíbol, con una proporción de plagioclasa con respecto al total de feldespato mayor del 90 por ciento. incluye a las rocas del sector 5 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Granitoid consisting of quartz and intermediate plagioclase, usually with biotite and amphibole. includes rocks defined modally in qapf field 5; ratio of plagioclase to total feldspar is greater than 0.9."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/tonalite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/tonalite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "tonalita"
      },
      {
        "@language": "en",
        "@value": "tonalite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  }
]