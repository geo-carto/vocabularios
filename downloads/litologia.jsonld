      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/gabroide-foiditico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Gabroide foidítico con una proporción entre la plagioclasa y el total de feldespato mayor del 90 por ciento. incluye las rocas del sector 14 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Foid gabbroid that has a plagioclase to total feldspar ratio greater than 0.9. includes rocks defined modally in qapf field 14."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/foidGabbro"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_gabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
