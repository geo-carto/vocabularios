      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-ultramafica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea formada por más de un 90 por ciento de minerales máficos."
      },
      {
        "@language": "en",
        "@value": "Igneous rock that consists of greater than 90 percent mafic minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/ultramaficIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ultramafic_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca ígnea ultramáfica"
      },
      {
        "@language": "en",
        "@value": "ultramafic igneous rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/dioritoide",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-intermedia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica compuesta por plagioclasa intermedia, comúnmente con hornblenda y de manera frecuente con biotita o augita. la proporción de la plagioclasa con respecto al total de feldespato es mayor del 65 por ciento y la proporción de anortita con respecto al total de plagioclasa es inferior al 50 por ciento. contiene menos de un 10 por ciento de feldespatoide y de un 20 por ciento de cuarzo, entre los componentes qapf. posee un índice de color m inferior a 90. incluye a las rocas modalmente incluidas en los campos 9 y 10 (y sus subdivisiones) del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Phaneritic crystalline igneous rock with m less than 90, consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite. plagioclase to total feldspar ratio is greater that 0.65, and anorthite content of plagioclase is less than 50 percent. less than 10 percent feldspathoid mineral and less than 20 percent quartz in the qapf fraction. includes rocks defined modally in qapf fields 9 and 10 (and their subdivisions)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/dioritoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/dioritoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-dioritica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-monzodioritica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "dioritoide"
      },
      {
        "@language": "en",
        "@value": "dioritoid"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/foiditoide",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica con menos del 90 por ciento de minerales máficos y más del 60 por ciento de feldespatoide entre los componentes qapf. incluye a las rocas del sector 15 del diagrama qapf y a las que su composición química sitúa en el sector f del diagrama tas."
      },
      {
        "@language": "en",
        "@value": "Fine grained crystalline rock containing less than 90 percent mafic minerals and more than 60 percent feldspathoid minerals in the qapf fraction. includes rocks defined modally in qapf field 15 or chemically in tas field f."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/foiditoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foiditoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/basanita-foiditica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/foidita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/foidita-fonolitica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/foidita-tefritica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "foiditoide"
      },
      {
        "@language": "en",
        "@value": "foiditoid"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material sedimentario en el que al menos el 50 de sus componentes primarios y/o recristalizados están formados por uno (o más) de los minerales carbonatados calcita, aragonito y dolomita, en partículas originarias de la misma cuenca de deposición."
      },
      {
        "@language": "en",
        "@value": "Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/carbonateSedimentaryMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sedimentary_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-calcareo"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-dolomitico-o-magnesico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material sedimentario carbonatado"
      },
      {
        "@language": "en",
        "@value": "carbonate sedimentary material"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/boninita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/andesita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca andesítica que contiene más de un 8 por ciento de mgo. habitualmente está constituida por fenocristales de protoenstatita, ortopiroxeno, clinopiroxeno y olivino en una pasta vítrea con microcristales y presenta texturas características de crecimiento mineral rápido."
      },
      {
        "@language": "en",
        "@value": "Andesitic rock that contains more than 8 percent mgo. typically consists of phenocrysts of protoenstatite, orthopyroxene, clinopyroxene, and olivine in a glassy base full of crystallites, and exhibits textures characterisitc of rapid crystal growth."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/boninite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/boninite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "boninita"
      },
      {
        "@language": "en",
        "@value": "boninite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/yeso-o-anhidrita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/evaporita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Evaporita formada por un mínimo del 50 por ciento de yeso o anhidrita."
      },
      {
        "@language": "en",
        "@value": "Evaporite composed of at least 50 percent gypsum or anhydrite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/gypsumOrAnhydrite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/rock_gypsum_or_anhydrite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "yeso o anhidrita"
      },
      {
        "@language": "en",
        "@value": "gypsum or anhydrite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/turba",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-rico-en-materia-organica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento no consolidado rico en materia orgánica con un mínimo del 50 por ciento de restos de plantas semicarbonificados, normalmente distinguibles a simple vista; de coloración marrón amarillento a marrón muy oscuro, habitualmente con textura fibrosa, puede ser plástico o friable. en su estado natural puede cortarse fácilmente y tiene un elevado grado de humedad, generalmente de más del 90 por ciento. la relación entre el contenido de liptinita e inertinita es inferior a 1 (comisión económica para europa, comité de la energía sostenible - naciones unidas (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.)."
      },
      {
        "@language": "en",
        "@value": "Unconsolidated organic-rich sediment composed of at least 50 percent semi-carbonised plant remains; individual remains commonly seen with unaided eye; yellowish brown to brownish black; generally fibrous texture; can be plastic or friable. in its natural state it can be readily cut and has a very high moisture content, generally greater than 90 percent. liptinite to inertinite ratio is less than one (economic commission for europe, committee on sustainable energy- united nations (ece-un), 1998, international classification of in-seam coals: energy 19, 41 pp.)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/peat"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/peat"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "turba"
      },
      {
        "@language": "en",
        "@value": "peat"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-dolomitica-o-magnesica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria carbonatada con una relación entre carbonato de magnesio y carbonato cálcico (incluyendo el aragonito) superior a 1. incluye la dolomía, la dolomía calcárea y la magnesita."
      },
      {
        "@language": "en",
        "@value": "Carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. includes dolostone, lime dolostone and magnesite-stone."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/dolomiticOrMagnesianSedimentaryRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/dolomia"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/dolomia-impura"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca sedimentaria dolomítica o magnésica"
      },
      {
        "@language": "en",
        "@value": "dolomitic or magnesian sedimentary rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/lodo-industrial",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Subproductos, más o menos líquidos (en el momento de su vertido), de procesos industriales."
      },
      {
        "@language": "en",
        "@value": "More or less liquid (when disposed) by-products of industrial processes"
      }
    ],
