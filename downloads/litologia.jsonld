    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-monzonitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca monzonítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 8' del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Monzonitic rock that contains 0-10 percent feldspathoid mineral and no quartz in the qapf fraction. includes rocks defined modally in qapf field 8'."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/foidBearingMonzonite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzonite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "monzonita con foides"
      },
      {
        "@language": "en",
        "@value": "foid bearing monzonite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita-de-feldespato-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sienítica de feldespato alcalino que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 6* del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Alkali feldspar synitic rock that contains 5 to 20 percent quartz and no feldspathoid in the qapf fraction. qapf field 6*."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/quartzAlkaliFeldsparSyenite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/quartz_alkali_feldspar_syenite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cuarzo-sienita de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "quartz alkali feldspar syenite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/conglomerado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria clástica formada por un mínimo del 30 por ciento de clastos redondeados a subangulosos de diámetro superior a 2 mm; normalmente contiene material de grano fino en los intersticios entre los clastos. si no puede ser determinado el origen clástico o diagenético de más del 15 por ciento de la matriz de grano fino y la fábrica es matriz-soportada, puede ser considerada una grauvaca. si la roca está mal seleccionada, también puede ser considerada una diamictita."
      },
      {
        "@language": "en",
        "@value": "Clastic sedimentary rock composed of at least 30 percent rounded to subangular fragments larger than 2 mm in diameter; typically contains finer grained material in interstices between larger fragments. if more than 15 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wackestone. if rock has unsorted or poorly sorted texture with a wide range of particle sizes, may also be categorized as diamictite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/conglomerate"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "conglomerado"
      },
      {
        "@language": "en",
        "@value": "conglomerate"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/lutita-rica-en-carbonatos",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/lutita-generica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Lutita que contiene entre el 10 y el 50 por ciento de minerales carbonatados. no tiene un origen específico."
      },
      {
        "@language": "en",
        "@value": "Mudstone that contains between 10 and 50 percent carbonate minerals in the mud size fraction. carbonate origin is not specified."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/carbonateRichMudstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mudstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "lutita rica en carbonatos"
      },
      {
        "@language": "en",
        "@value": "carbonate rich mudstone"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/hulla",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/carbon"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Carbón que contiene vitrinita con un valor medio de reflectancia (ro) superior a 0,6 por ciento/ro e inferior a 2,0 por ciento  (determinado según la iso 7404-5) y con un poder calorífico mayor de 24mj/kg (determinado según la iso 1928). se trata de una roca sedimentaria rica en materia orgánica, dura y negra; contiene menos de un 91 por ciento de carbono en seco y sin impurezas, y presenta valores superiores al 13-14 por ciento de volátiles, también en seco y sin contar las cenizas. se forma a partir de la compactación o el endurecimiento de restos de plantas, de manera similar a los depósitos de turba."
      },
      {
        "@language": "en",
        "@value": "Coal that has vitrinite mean random reflectance greater than 0.6 por ciento and less than 2.0 por ciento (determined in conformance with iso 7404-5), or has a gross calorific value greater than 24 mj/kg (determined in conformance with iso 1928). hard, black, organic rich sedimentary rock; contains less than 91 percent fixed carbon on a dry, mineral-matter-free basis, and greater than 13-14 percent volatiles (dry, ash free). formed from the compaction or induration of variously altered plant remains similar to those of peaty deposits."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/bituminousCoal"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/bituminous_coal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "hulla"
      },
      {
        "@language": "en",
        "@value": "bituminous coal"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/granitoide-rico-en-cuarzo",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-acida"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica que contiene menos de un 90 por ciento de minerales máficos y más de un 60 por ciento de cuarzo entre los componentes qapf."
      },
      {
        "@language": "en",
        "@value": "Phaneritic crystalline igneous rock that contains less than 90 percent mafic minerals and contains greater than 60 percent quartz in the qapf fraction."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/quartzRichIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/quartz_rich_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "granitoide rico en cuarzo"
      },
      {
        "@language": "en",
        "@value": "quartz rich igneous rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento carbonatado con un contenido en clastos de hasta 2 mm de diámetro, inferior al 25 por ciento, y cuya proporción entre los componentes de tamaño arena y lutita es inferior a 1."
      },
      {
        "@language": "en",
        "@value": "Carbonate sediment composed of less than 25 percent clasts that have a maximum diameter more than 2 mm, and the ratio of sand size to mud size clasts is less than one."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/carbonateMud"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mud"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "fango carbonatado 1"
      },
      {
        "@language": "en",
        "@value": "carbonate mud"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/encostramiento",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-poligenica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca formando una costra o capa dura en la superficie de la tierra o cerca de ella, p. e. en los horizontes superiores de un suelo; se caracteriza por presentar estructuras indicativas de su origen pedogénico."
      },
      {
        "@language": "en",
        "@value": "Rock forming a hard crust or layer at or near the earth's surface at the time of formation, e.g. in the upper horizons of a soil, characterized by structures indicative of pedogenic origin."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/duricrust"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/duricrust"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "encostramiento"
      },
      {
        "@language": "en",
        "@value": "duricrust"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-siliceo-no-clastico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-siliceo-no-clastico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento compuesto, como mínimo en un 50 por ciento, por material silíceo depositado por procesos biológicos o químicos sobre la superficie de sedimentación, o por partículas formadas por procesos químicos o biológicos en la cuenca sedimentaria."
      },
      {
        "@language": "en",
        "@value": "Sediment that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/non-clasticSiliceousSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/barro-de-radiolarios"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento silíceo no clástico"
      },
      {
        "@language": "en",
        "@value": "non-clastic siliceous sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/riolita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-riolitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Riolitoide con una proporción entre la plagioclasa y el total de feldespato superior al 10 por ciento."
      },
      {
        "@language": "en",
        "@value": "Rhyolitoid in which the ratio of plagioclase to total feldspar is between 0.1 and 0.65."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/rhyolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/rhyolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "riolita"
      },
      {
        "@language": "en",
        "@value": "rhyolite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/serpentinita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca compuesta en más de un 75 por ciento por minerales del grupo de la sepentina, p. e. antigorita, crisotilo o lizardita, pudiendo contener clorita, talco y magnetita como minerales accesorios; se forma por hidratación de silicatos ferromagnesianos como olivino y piroxeno."
      },
      {
        "@language": "en",
        "@value": "Rock consisting of more than 75 percent serpentine-group minerals, eg. antigorite, chrysotile or lizardite; accessory chlorite, talc and magnetite may be present; derived from hydration of ferromagnesian silicate minerals such as olivine and pyroxene."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/serpentinite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/serpentinite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "serpentinita"
      },
      {
        "@language": "en",
        "@value": "serpentinite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/monzogabro",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca monzogabroica con cuarzo en una proporción inferior al 5 por ciento, entre los componentes qapf. incluye a las rocas del sector 9 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Monzogabbroic rock that contains between 0 an 5 percent quartz and no feldspathoid mineral in the qapf fraction. includes rocks defined modally in qapf field 9 ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/monzogabbro"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/monzogabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "monzogabro"
      },
      {
        "@language": "en",
        "@value": "monzogabbro"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-traquitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/traquitoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Traquitoide con una proporción entre plagioclasa y el total de feldespato comprendida entre el 10 y el 35 por ciento. corresponde a los sectores 7, 7' y 7* del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Trachytoid that has a plagioclase to total feldspar ratio between 0.1 and 0.35. qapf fields 7, 7', and 7*."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/trachyticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/trachytic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/traquita-con-foides"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-traquita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/traquita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca traquítica"
      },
      {
        "@language": "en",
        "@value": "trachytic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento en el cual como mínimo el 50 por ciento de los componentes primarios y/o recristalizados están constituidos por uno (o más) de los minerales carbonatados calcita, aragonito, magnesita y dolomita, de origen intracuencal."
      },
      {
        "@language": "en",
        "@value": "Sediment in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/carbonateSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-dolomitico"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-impuro"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-puro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento carbonatado"
      },
      {
        "@language": "en",
        "@value": "carbonate sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-anortosita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-anortositica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca anortosítica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 10* del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Anorthositic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 10*."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/quartzAnorthosite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/quartz_anorthosite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cuarzo-anortosita"
      },
      {
        "@language": "en",
        "@value": "quartz anorthosite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-clastico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-clastico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento en el que al menos el 50 por ciento de las partículas constituyentes provienen de la erosión, la meteorización o el movimiento en masa de materiales preexistentes, que han sido transportados hasta su lugar de depósito por agentes mecánicos, tales como el agua, el viento, el hielo y la gravedad."
      },
      {
        "@language": "en",
        "@value": "Sediment in which at least 50 percent of the constituent particles were derived from erosion, weathering, or mass-wasting of pre-existing earth materials, and transported to the place of deposition by mechanical agents such as water, wind, ice and gravity."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/clasticSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/diamicton"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/grava"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/pelita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/arena"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento clástico"
      },
      {
        "@language": "en",
        "@value": "clastic sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/material-antropico-consolidado",
    "@type": [
