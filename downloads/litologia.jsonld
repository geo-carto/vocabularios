      {
        "@language": "es",
        "@value": "gabro foidítico"
      },
      {
        "@language": "en",
        "@value": "foid gabbro"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sienitoide-foiditico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica en la que el índice de color (m) es inferior a 90, la proporción entre la plagioclasa y el total de feldespato es inferior al 50 por ciento y el contenido de feldespatoide está comprendido entre el 10 y el 60 por ciento de los componentes qapf. incluye a las rocas de los sectores 11 y 12 del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Phaneritic crystalline igneous rock with m less than 90, contains between 10 and 60 percent feldspathoid mineral in the qapf fraction, and has a plagioclase to total feldspar ratio less than 0.5. includes qapf fields 11 and 12."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/foidSyenitoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_syenitoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/monzosienita-foiditica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sienita-foiditica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "Sienitoide foidítico"
      },
      {
        "@language": "en",
        "@value": "foid syenitoid"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/aplita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
