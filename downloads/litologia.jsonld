        "@language": "es",
        "@value": "Roca gabroica que contiene entre un 5 y un 20 por ciento de cuarzo entre los componentes qapf. incluye a las rocas del sector 10* del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Gabbroic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 10*."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/quartzGabbro"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/quartz_gabbro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "cuarzo-gabro"
      },
      {
        "@language": "en",
        "@value": "quartz gabbro"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
