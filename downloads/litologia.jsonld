      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Fango formado, en más del 50 por ciento, por restos de esqueletos carbonatados."
      },
      {
        "@language": "en",
        "@value": "Ooze that consists of more than 50 percent carbonate skeletal remains"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/carbonateOoze"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonate_ooze"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-1"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fango-carbonatado-2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "fango carbonatado 2"
      },
      {
        "@language": "en",
        "@value": "carbonate ooze"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/basanita-fonolitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/tefritoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Tefritoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 90 por ciento y que contiene olivino normativo (cipw) en una proporción superior al 10 por ciento."
      },
      {
        "@language": "en",
        "@value": "Tephritoid that has a plagioclase to total feldspar ratio between 0.5 and 0.9, and contains more than 10 percent normative (cipw) olivine."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/phonoliticBasanite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_basanite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "basanita fonolítica"
      },
      {
        "@language": "en",
        "@value": "phonolitic basanite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/paragneis",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/gneis"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Gneis cuya mineralogía y textura indican un protolito de rocas sedimentarias. normalmente está formado por abundante cuarzo y mica o calcosilicatos; suele contener  aluminosilicatos o granate. a escala decimétrica, su composición tiende a ser más variada que la del ortogneis."
      },
      {
        "@language": "en",
        "@value": "A gneiss with mineralogy and texture indicating derivation from a sedimentary rock protolith. typically consists of abundant quartz, mica, or calcsilicate minerals; aluminosilicate minerals or garnet commonly present. composition of rock tends to be more variable on a decimetric scale that in orthogneiss."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/paragneiss"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/paragneiss"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "paragneis"
      },
      {
        "@language": "en",
        "@value": "paragneiss"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-de-tamaño-arena",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento con menos de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro) y una relación entre granos de arena y partículas de lutita mayor que 1. la composición o la génesis de los clastos no se especifican."
      },
      {
        "@language": "en",
        "@value": "Sediment in which less than 30 percent of particles are gravel (greater than 2 mm in diameter) and the sand to mud ratio is at least 1. composition or genesis of clasts not specified."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/sandSizeSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/sand_size_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento de tamaño arena"
      },
      {
        "@language": "en",
        "@value": "sand size sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/micaesquisto",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/esquisto"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Esquisto formado por más de un 50 por ciento de micas, habitualmente moscovita o biotita. es una tipología específica para distinguir esta variedad común de esquistos."
      },
      {
        "@language": "en",
        "@value": "A schist that consists of more than 50 percent mica minerals, typically muscovite or biotite. special type included to distinguish this common variety of schist."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/micaSchist"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/mica_schist"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "micaesquisto"
      },
      {
        "@language": "en",
        "@value": "mica schist"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sienitoide",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-faneritica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca plutónica con un índice de color m inferior a 90, compuesta principalmente por feldespato alcalino y plagioclasa; la proporción entre la plagioclasa y el total de feldespato es inferior al 65 por ciento. puede contener hasta un 20 por ciento de cuarzo, entre los componentes qapf, o hasta un 10 por ciento de feldespatoide, junto con piroxeno, anfíbol o biotita. incluye las rocas de los sectores 6, 7, 8, y sus subdivisiones, del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Phaneritic crystalline igneous rock with m less than 90, consisting mainly of alkali feldspar and plagioclase; minor quartz or nepheline may be present, along with pyroxene, amphibole or biotite. ratio of plagioclase to total feldspar is less than 0.65, quartz forms less than 20 percent of qapf fraction, and feldspathoid minerals form less than 10 percent of qapf fraction. includes rocks classified in qapf fields 6, 7 and 8 and their subdivisions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/syenitoid"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/syenitoid"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-monzonitica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sienitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sienitoide"
      },
      {
        "@language": "en",
        "@value": "syenitoid"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-volcanica-magnesica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-afanitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica con una concentración inusualmente elevada de mgo. en rocas con un porcentaje superior al 52 de sílice, el contenido en mgo debe ser superior al 8 por ciento. en rocas con menos del 52 por ciento de sílice, el contenido de mgo debe ser superior al 12 por ciento."
      },
      {
        "@language": "en",
        "@value": "Fine-grained igneous rock that contains unusually high concentration of mgo. for rocks that contain greater than 52 percent silica, mgo must be greater than 8 percent. for rocks containing less than 52 percent silica, mgo must be greater than 12 percent."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/highMagnesiumFineGrainedIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/high_magnesium_fine_grained_igneous_rocks"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-komatiitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca volcánica magnésica"
      },
      {
        "@language": "en",
        "@value": "high magnesium fine grained igneous rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sienitica-de-feldespato-alcalino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sienitoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sienitoide con una proporción de plagioclasa con respecto al total de feldespato inferior al 10 por ciento. sectores 6, 6* y 6' del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Syenitoid with a plagioclase to total feldspar ratio of less than 0.1. qapf fields 6, 6*, and 6'."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/alkaliFeldsparSyniticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sienita-de-feldespato-alcalino"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sienita-de-feldespato-alcalino-con-foides"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita-de-feldespato-alcalino"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca sienítica de feldespato alcalino"
      },
      {
        "@language": "en",
        "@value": "alkali feldspar synitic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-dolomitico-o-magnesico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Material sedimentario carbonatado, en un estado de consolidación sin especificar, con una relación entre carbonato de magnesio y carbonato cálcico (incluyendo el aragonito) superior a 1. incluye el material sedimentario dolomítico, la dolomía, la dolomía calcárea y la magnesita."
      },
      {
        "@language": "en",
        "@value": "Carbonate sedimentary material of unspecified consolidation degree with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. includes dolomite sediment, dolostone, lime dolostone and magnesite-stone."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/dolomiticOrMagnesianSedimentaryMaterial"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_material"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "material sedimentario dolomítico o magnésico"
      },
      {
        "@language": "en",
        "@value": "dolomitic or magnesian sedimentary material"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sienitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sienitoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sienitoide en el que la proporción entre la plagioclasa y el total de feldespato está comprendida entre el 10 y el 35 por ciento. incluye las rocas de los sectores 7, 7' y 7* del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Syenitoid with a plagioclase to total feldspar ratio between 0.1 and 0.35. includes rocks in qapf fields 7, 7*, and 7'."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/syniticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/syenitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sienita-con-foides"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-sienita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sienita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca sienítica"
      },
      {
        "@language": "en",
        "@value": "synitic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/fango-rico-en-carbonatos",
