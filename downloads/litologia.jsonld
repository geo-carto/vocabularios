      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca latítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 8' del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Latitic rock that contains no quartz and between 0 and 10 percent feldspathoid minerals in the qapf fraction. qapf field 8'."
      }
    ],
