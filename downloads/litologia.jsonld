      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-siliceo-no-clastico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Fango constituido, en más de un 50 por ciento, por restos de esqueletos silíceos."
      },
      {
        "@language": "en",
        "@value": "Ooze that consists of more than 50 percent siliceous skeletal remains"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/siliceousOoze"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "barro de radiolarios"
      },
      {
        "@language": "en",
        "@value": "siliceous ooze"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-poligenica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca generada por los cambios mineralógicos, texturales y/o estructurales, en estado sólido, producidos sobre una roca pre-existente, como respuesta a cambios importantes de temperatura, presión, esfuerzos de cizalla o condiciones químicas del ambiente."
      },
      {
        "@language": "en",
        "@value": "Rock formed by solid-state mineralogical, chemical and/or structural changes to a pre-existing rock, in response to marked changes in temperature, pressure, shearing stress and chemical environment."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/metamorphicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/anfibolita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-de-la-facies-de-la-clorita-actinolita-epidota"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/eclogita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica-foliada"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/esquisto-azul"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/granofelsita-/-granoblastita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/granulita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/marmol"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/migmatita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/cuarcita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/serpentinita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca metamórfica"
      },
      {
        "@language": "en",
        "@value": "metamorphic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/travertino",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-quimico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Caliza formada por precipitación biótica o abiótica de manantiales, ya sean de agua caliente o de temperatura ambiente. puede ser blanco y esponjoso, con sombreados de color naranja, marrón o gris, y varía de denso a bandeado o laminado. macrofitas, briofitas, algas, cianobacterias y otros organismos suelen colonizar la superficie del travertino y pueden conservarse, generando las variedades porosas."
      },
      {
        "@language": "en",
        "@value": "Biotically or abiotically precipitated calcium carbonate, from spring-fed, heated, or ambient-temperature water. may be white and spongy, various shades of orange, tan or gray, and ranges to dense, banded or laminated rock. macrophytes, bryophytes, algae, cyanobacteria and other organisms often colonize the surface of travertine and may be preserved, to produce the porous varieties."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/travertine"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/travertine"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "travertino"
      },
      {
        "@language": "en",
        "@value": "travertine"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado-puro",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-carbonatado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento carbonatado con más del 90 por ciento de sus constituyentes compuestos por uno (o más) carbonatos de origen intracuencal."
      },
      {
        "@language": "en",
        "@value": "Carbonate sediment in which greater than 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/pureCarbonateSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/pure_carbonate_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento carbonatado puro"
      },
      {
        "@language": "en",
        "@value": "pure carbonate sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metasomatica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-poligenica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca cuya fábrica y composición indican cambios mineralógicos y  químicos en un sistema abierto, como respuesta a la interacción con una fase fluida, normalmente rica en agua."
      },
      {
        "@language": "en",
        "@value": "Rock that has fabric and composition indicating open-system mineralogical and chemical changes in response to interaction with a fluid phase, typically water rich."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/metasomaticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/skarn"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/espilita"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca metasomática"
      },
      {
        "@language": "en",
        "@value": "metasomatic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/fango",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-biogenico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento biogénico con una relación de arena a lutita inferior a 1 a 9, menos de un 50 por ciento de carbonatos y menos de un 1 por ciento de partículas de tamaño grava (2 mm de diámetro)."
      },
      {
        "@language": "en",
        "@value": "Biogenic sediment consisting of less than 1 percent gravel-size (greater than or equal to 2 mm) particles, with a sand to mud ratio less than 1 to 9, and less than 50 percent carbonate minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/ooze"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ooze"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "fango"
      },
      {
        "@language": "en",
        "@value": "ooze"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/carbonatita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-de-composicion-exotica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea que en su composición modal contiene más de un 50 por ciento de minerales carbonatados."
      },
      {
        "@language": "en",
        "@value": "Igneous rock composed of more than 50 percent modal carbonate minerals."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/carbonatite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonatite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "carbonatita"
      },
      {
        "@language": "en",
        "@value": "carbonatite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/anfibolita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica compuesta en un 75 por ciento o más por anfíbol (verde, marrón o negro) y plagioclasa (incluyendo a la albita). el anfíbol constituye, al menos, un 30 por ciento de la roca y un 50 por ciento de los minerales máficos. otros minerales que suelen estar presentes son cuarzo, clinopiroxeno, granate, minerales del grupo de la epidota, biotita, titanita y escapolita."
      },
      {
        "@language": "en",
        "@value": "Metamorphic rock mainly consisting of green, brown or black amphibole and plagioclase (including albite), which combined form 75 percent or more of the rock, and both of which are present as major constituents. the amphibole constitutes 50 percent or more of the total mafic constituents and is present in an amount of 30 percent or more; other common minerals include quartz, clinopyroxene, garnet, epidote-group minerals, biotite, titanite and scapolite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/amphibolite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/amphibolite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "anfibolita"
      },
      {
        "@language": "en",
        "@value": "amphibolite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/migmatita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica silicatada marcadamente heterogénea tanto a escala decimétrica como métrica. normalmente está formada por unas partes oscuras y otras más claras; las oscuras suelen mostrar características de rocas metamórficas, mientras que las más claras tienen apariencia de rocas ígneas."
      },
      {
        "@language": "en",
        "@value": "Silicate metamorphic rock that is pervasively heterogeneous on a decimeter to meter scale that typically consists of darker and lighter parts; the darker parts usually exhibit features of metamorphic rocks whereas the lighter parts are of igneous-looking appearance."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/migmatite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/migmatite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "migmatita"
      },
      {
        "@language": "en",
        "@value": "migmatite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/cuarzo-monzogabro",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-monzogabroica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca monzogabroica que contiene entre un 5 y un 20 por ciento de cuarzo, entre los componentes qapf. incluye a las rocas del sector 9* del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Monzogabbroic rock that contains between 5 and 20 percent quartz in the qapf fraction. qapf field 9*."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
