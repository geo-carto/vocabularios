        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-anortositica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca anortosítica con feldespatoide en proporción inferior al 10 por ciento, entre los componentes qapf. sector 10' del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Anorthositic rock that contains between 0 and 10 percent feldspathoid mineral and no quartz in the qapf fraction. qapf field 10'."
      }
    ],
