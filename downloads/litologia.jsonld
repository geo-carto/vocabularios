    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea con menos de un 45 por ciento de sio2."
      },
      {
        "@language": "en",
        "@value": "Igneous rock with less than 45 percent sio2."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/ultrabasicIgneousRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/ultrabasic_igneous_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca ígnea ultrabásica"
      },
      {
        "@language": "en",
        "@value": "ultrabasic igneous rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/basanita-foiditica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/foiditoide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Foiditoide que contiene menos del 90 por ciento de feldespatoide entre los componentes qapf, una proporción entre la plagioclasa y el total de feldespato mayor del 50 por ciento  y más de un 10 por ciento de olivino normativo (cipw)."
      },
      {
        "@language": "en",
        "@value": "Foiditoid that contains less than 90 percent feldspathoid minerals in the qapf fraction, and has a plagioclase to total feldspar ratio that is greater than 0.5, with greater than 10 percent normative olivine."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/basaniticFoidite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/basanitic_foidite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "basanita foidítica"
      },
      {
        "@language": "en",
        "@value": "basanitic foidite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-komatiitica",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-volcanica-magnesica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca volcánica ultramáfica rica en magnesio, con típica textura spinifex constituida por intercrecimientos de cristales de olivino en forma de cuchillo y piroxeno, en una masa vítrea. incluye la komatiita y la meimechita."
      },
      {
        "@language": "en",
        "@value": "Ultramafic, magnesium-rich volcanic rock, typically with spinifex texture of intergrown skeletal and bladed olivine and pyroxene crystals set in abundant glass. includes komatiite and meimechite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/komatiiticRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/komatiitic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca komatiítica"
      },
      {
        "@language": "en",
        "@value": "komatiitic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-carbonatado"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria en la que al menos el 50 por ciento de los componentes primarios y/o recristalizados están constituidos por uno (o más) de los minerales carbonatados calcita, aragonito, magnesita y dolomita."
      },
      {
        "@language": "en",
        "@value": "Sedimentary rock in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite, magnesite or dolomite."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/carbonateSedimentaryRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sedimentary_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/boundstone"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/marga"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/wackestone"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/carbonato-cristalino"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-dolomitica-o-magnesica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/framestone"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/grainstone"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada-impura"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/packstone"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-carbonatada-pura"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca sedimentaria carbonatada"
      },
      {
        "@language": "en",
        "@value": "carbonate sedimentary rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/evaporita",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/material-sedimentario-quimico"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria no clástica compuesta como mínimo por un 50 por ciento de sales no carbonatadas, incluyendo cloruros, sulfatos o boratos. se forma por la precipitación de sales minerales de una solución salina (rocas de sales no carbonatadas)."
      },
      {
        "@language": "en",
        "@value": "Nonclastic sedimentary rock composed of at least 50 percent non-carbonate salts, including chloride, sulfate or borate minerals; formed through precipitation of mineral salts from a saline solution (non-carbonate salt rock)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/evaporite"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/evaporite"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/evaporita-exotica"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/yeso-o-anhidrita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "evaporita"
      },
      {
        "@language": "en",
        "@value": "evaporite"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/esquisto-azul",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-metamorfica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca metamórfica con una composición próxima a la del basalto. se define por la presencia de glaucofana con lawsonita o epidota. otros minerales que pueden estar presentes son jadeíta, albita, clorita, granate y moscovita (mica blanca fengítica). generalmente es oscura y de grano fino."
      },
      {
        "@language": "en",
        "@value": "A metamorphic rock of roughly basaltic composition, defined by the presence of glaucophane with lawsonite or epidote. other minerals that may be present include jadeite, albite, chlorite, garnet, and muscovite (phengitic white mica). typically fine-grained, dark colored. category for rocks commonly referred to as blueschist."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/glaucophaneLawsoniteEpidoteMetamorphicRock"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/glaucophane_lawsonite_epidote_metamorphic_rock"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "esquisto azul"
      },
      {
        "@language": "en",
        "@value": "glaucophane lawsonite epidote metamorphic rock"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/ortogneis",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/gneis"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Gneis cuya mineralogía y textura indican un protolito de rocas ígneas faneríticas. normalmente está formado por abundante feldespato, con cuarzo y un contenido variable de hornblenda, biotita y moscovita; tiene un aspecto relativamente homogéneo."
      },
      {
        "@language": "en",
        "@value": "A gneiss with mineralogy and texture indicating derivation from a phaneritic igneous rock protolith. typically consists of abundant feldspar, with quartz, and variable hornblende, biotite, and muscovite, with a relatively homogeneous character."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/orthogneiss"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/orthogneiss"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "ortogneis"
      },
      {
        "@language": "en",
        "@value": "orthogneiss"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
