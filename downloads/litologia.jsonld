        "@language": "es",
        "@value": "Material que se añade al suelo para mejorar el crecimiento y la calidad de las plantas."
      },
      {
        "@language": "en",
        "@value": "Material added to soil to improve plant growth and health"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/soilImprover"
