      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento carbonatado con una proporción entre calcita (más aragonito) y dolomita mayor que 1. incluye a los sedimentos calizos."
      },
      {
        "@language": "en",
        "@value": "Carbonate sediment with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. includes lime-sediments."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/calcareousCarbonateSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo-impuro"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-calcareo-puro"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento calcáreo"
      },
      {
        "@language": "en",
        "@value": "calcareous carbonate sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-biogenico",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Sedimento compuesto  por material de origen biogénico, en más de un 50 por ciento. debido a que el material biogénico pueden ser restos de esqueletos que no son orgánicos, los sedimentos biogénicos no tienen que ser necesariamente  ricos en materia orgánica."
      },
      {
        "@language": "en",
        "@value": "Sediment composed of greater than 50 percent material of biogenic origin. because the biogenic material may be skeletal remains that are not organic, all biogenic sediment is not necessarily organic-rich."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/biogenicSediment"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/biogenic_sediment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/fango"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/sedimento-rico-en-materia-organica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "sedimento biogénico"
      },
      {
        "@language": "en",
        "@value": "biogenic sediment"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
