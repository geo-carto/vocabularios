      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-ignea-vitrea"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "roca ígnea rica en vidrio"
      },
      {
        "@language": "en",
        "@value": "glass rich igneous rock"
      }
    ],
