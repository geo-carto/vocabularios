      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca ígnea con un porcentaje de vidrio superior al 50 por ciento."
      },
      {
        "@language": "en",
        "@value": "Igneous rock that contains greater than 50 percent massive glass."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
