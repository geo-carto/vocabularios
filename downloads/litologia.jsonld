        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-traquitica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca traquítica con feldespatoide en una proporción inferior al 10 por ciento, entre los componentes qapf. sector 7' del diagrama qapf."
      },
      {
        "@language": "en",
        "@value": "Trachytic rock that contains between 0 and 10 percent feldspathoid in the qapf fraction, and no quartz. qapf field 7'."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
