  {
    "@id": "https://geo-carto.github.io/vocabularios/litologia/arenisca",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-03-01"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/roca-sedimentaria-clastica"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca sedimentaria clástica con menos de un 30 por ciento de clastos de tamaño grava (más de 2,0 mm de diámetro) y una relación entre granos de arena y partículas de lutita mayor que 1."
      },
      {
        "@language": "en",
        "@value": "Clastic sedimentary rock in which less than 30 percent of particles are greater than 2 mm in diameter (gravel) and the sand to mud ratio is at least 1."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/sandstone"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/arenita"
      },
      {
        "@id": "https://geo-carto.github.io/vocabularios/litologia/grauvaca"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "arenisca"
      },
      {
        "@language": "en",
        "@value": "sandstone"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
