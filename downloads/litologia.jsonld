      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Roca carbonatada de mineralogía indeterminada en la cual los procesos diagenéticos han destruido la textura deposicional original."
      },
      {
        "@language": "en",
        "@value": "Carbonate rock of indeterminate mineralogy in which diagenetic processes have obliterated any original depositional texture."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/Lithology/crystallineCarbonate"
