  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:prefLabel xml:lang="es">meteorización</skos:prefLabel>
    <skos:prefLabel xml:lang="en">weathering</skos:prefLabel>
    <skos:definition xml:lang="es">Conjunto de procesos físicos, químicos y biológicos por los que una roca, sedimento o suelo, próximo a la superficie terrestre, cambia su color, textura, composición, resistencia o forma, sin o escaso transporte de los materiales alterados</skos:definition>
    <skos:definition xml:lang="en">Group of physical, chemical and biological processes by which a rock, sediment or soil, near the Earth's surface, are changed in color, texture, composition, firmness or form, with little or no transport of the altered material.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/alteracion-no-especificada"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/arenizacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/argilizacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/caolinizacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/carbonatacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/silicificacion"/>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/ferruginizacion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo/ferruginizacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:prefLabel xml:lang="es">ferruginización</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ferrugination</skos:prefLabel>
    <skos:definition xml:lang="es">Enriquecimiento de una roca, sedimento o suelo en hierro</skos:definition>
    <skos:definition xml:lang="en">Enrichment of a rock, sediment or soil in iron.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo/silicificacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:prefLabel xml:lang="es">silicificación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silification</skos:prefLabel>
    <skos:definition xml:lang="es">Enriquecimiento de una roca, sedimento o suelo en sílice</skos:definition>
    <skos:definition xml:lang="en">Enrichment of a rock, sediment or soil in silica.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/alterationtype/silicification"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo/alteracion-no-especificada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:prefLabel xml:lang="es">alteración no especificada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alteration type not specified</skos:prefLabel>
    <skos:definition xml:lang="es">La roca está alterada, pero el tipo de alteración no está especificada</skos:definition>
    <skos:definition xml:lang="en">Rock is altered, but type not specified. Any alteration type allowed</skos:definition>
    <skos:narrower rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/alterationtype/alteration_not_specified"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo/no-alterada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:prefLabel xml:lang="es">no alterada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">not altered</skos:prefLabel>
    <skos:definition xml:lang="es">La roca no está alterada</skos:definition>
    <skos:definition xml:lang="en">Rock es not altered</skos:definition>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/alterationtype/not_altered"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo/caolinizacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:prefLabel xml:lang="es">caolinización</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kaolinitation</skos:prefLabel>
    <skos:definition xml:lang="es">Transformación de minerales, especialmente feldespatos y otros silicatos, en minerales arcillosos del grupo de la caolinita.</skos:definition>
    <skos:definition xml:lang="en">Transformation of minerals, especially feldespars and other silicates into kaolinite-group clay minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/alterationtype/kaolinitic_alteration"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo/arenizacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:prefLabel xml:lang="es">arenización</skos:prefLabel>
    <skos:prefLabel xml:lang="en">arenization</skos:prefLabel>
    <skos:definition xml:lang="es">Proceso de meteorización que disgrega rocas de grano grueso (&gt; 0,1 mm) en minerales y fragmentos de rocas sin cohesión. Los residuos, enriquecidos o no en sílice, se suelen denominar grus, grus saprolites, sandy saprolites, grus mantles, arenaceous mantles o lem cuando la meteorización es fundamentalmente física (Migon, 2004), growan, jabre o xabre cuando es química (Vidal Romaní y Twidale, 1998), o arenes cuando derivan de rocas plutónicas, fundamentalmente granitos y dioritas (Campy y Macaire, 1989)</skos:definition>
    <skos:definition xml:lang="en">Weathering process that disaggregates coarsed-grained rocks (&gt; 0,1 mm) into minerals and rock fragments with no cohesion. The products, may or may not be silica-enriched, are usually known as grus, grus saprolites, sandy saprolites, grus mantles, arenaceous mantles or lem when the weathering is mainly physical (Migón, 2004), growan, jabre or xabre when it is chemical (Vidal Romaní and Twidale, 1998), or arenes when they are derived from plutonic rocks, mainly granites and diorites (Campy and Macaire, 1989).</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo/carbonatacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:prefLabel xml:lang="es">carbonatación</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonation</skos:prefLabel>
    <skos:definition xml:lang="es">Transformación de minerales de calcio, magnesio, sodio, potasio o hierro en carbonatos o bicarbonatos, debido a la acción del dióxido de carbono contenido en el agua</skos:definition>
    <skos:definition xml:lang="en">Transformation of calcium, magnesium, sodium, potassium or iron minerals into carbonates or bicarbonates, by carbon dioxide contained in water.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/alterationtype/carbonate_alteration?"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo/argilizacion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo"/>
    <skos:prefLabel xml:lang="es">argilización</skos:prefLabel>
    <skos:prefLabel xml:lang="en">argillation</skos:prefLabel>
    <skos:definition xml:lang="es">Transformación de minerales, especialmente feldespatos y otros silicatos, en minerales arcillosos</skos:definition>
    <skos:definition xml:lang="en">Transformation of minerals, especially feldespars and other silicates, into clay minerals.</skos:definition>
    <skos:broader rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/alterationtype/argillic_alteration"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
</rdf:RDF>
