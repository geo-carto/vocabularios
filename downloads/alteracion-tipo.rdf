>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/alteracion-tipo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Tipo de alteración</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Alteration type</skos:prefLabel>
    <dcterms:title xml:lang="es">Tipo de alteración</dcterms:title>
    <dcterms:title xml:lang="en">Alteration type</dcterms:title>
    <skos:definition xml:lang="es">Término de un vocabulario controlado de tipos de alteración (por ejemplo, potásica, argílica, argílica avanzada).</skos:definition>
    <skos:definition xml:lang="en">Terms from a controlled vocabulary of alteration types (e.g., potassic, argillic, advanced argillic).</skos:definition>
    <dcterms:description xml:lang="es">Término de un vocabulario controlado de tipos de alteración (por ejemplo, potásica, argílica, argílica avanzada).</dcterms:description>
    <dcterms:description xml:lang="en">Terms from a controlled vocabulary of alteration types (e.g., potassic, argillic, advanced argillic).</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-01</dcterms:modified>
    <dcterms:publisher rdf:resource="https://www.igme.es/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:provenance>Términos propios definidos por el IGME</dcterms:provenance>
    <dcterms:creator>https://www.igme.es</dcterms:creator>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcat:theme>GE</dcat:theme>
    <skos:editorialNote xml:lang="es">Este archivo contiene el vocabulario Tipo de alteración.</skos:editorialNote>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/alteracion-no-especificada"/>
    <skos:hasTopConcept rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/no-alterada"/>
  </rdf:Description>
