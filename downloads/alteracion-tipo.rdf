    <skos:prefLabel xml:lang="es">Tipo de alteración - Todos los conceptos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Alteration type - All concepts</skos:prefLabel>
    <skos:definition xml:lang="es">Todos los conceptos en este vocabulario.</skos:definition>
    <skos:definition xml:lang="en">All concepts in this vocabulary.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion"/>
