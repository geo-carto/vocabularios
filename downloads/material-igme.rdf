    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-granitica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-monzodioritica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-monzogabroica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-monzonitica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica-de-feldespato-alcalino"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica-foidica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/shonkinita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sienita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sienita-con-foides"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sienita-de-feldespato-alcalino"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sienita-de-feldespato-alcalino-con-foides"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sienita-foidica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sienita-nefelinica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sienitoide"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sienogranito"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/teschenita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/tonalita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/troctolita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/urtita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/vaugnerita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/websterita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/websterita-olivinica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/werlita-wehrlita"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-de-explosion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha de explosión</skos:prefLabel>
    <skos:prefLabel xml:lang="en">explosion breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito piroclástico constituido por piroclastos líticos transportados balísticamente, característico de erupciones freáticas y freatomagmáticas</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic deposit consisting of lithic pyroclasts transported ballistically, characteristic of phreatic and phreatomagmatic eruptions</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/filita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">filita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phyllite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de grano fino a medio, caracterizada por una apariencia lustrosa y una esquistosidad bien definida que resulta de la orientación preferente de filosilicatos. generalmente, las filitas son rocas de grado metamórfico bajo</skos:definition>
    <skos:definition xml:lang="en">Fine- to medium-grained metamorphic rock characterized by a lustrous appearance and a well-developed schistosity resulting from the preferred orientation of phyllosilicates. Generally, phyllites are low-grade metamorphic rocks</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phyllite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phyllite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/leucitita-fonolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">leucitita fonolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolitic leucitite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente a la familia de las rocas foídicas, en la que el feldespato alcalino predomina sobre la plagioclasa y que tiene como minerales esenciales leucita y piroxeno</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the foidite family, in which alkali feldspar predominates over plagioclase and which has leucite and pyroxene as essential minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phonolitoid"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/kinzigita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Kinzigita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kinzigite</skos:prefLabel>
    <skos:definition xml:lang="es">Granulita cuya paragénesis característica incluye piroxeno y granate, esencialmente</skos:definition>
    <skos:definition xml:lang="en">Granulite whose characteristic paragenesis includes essentially pyroxene and garnet</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/piroxenita-olivino-hornblendica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">piroxenita olivino-hornbléndica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine-hornblende pyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Piroxenita con olivino y hornblenda en cantidades superiores al 5%</skos:definition>
    <skos:definition xml:lang="en">Pyroxenite with olivine and hornblende in amounts exceeding 5%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-de-silicatos-calcicos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca de silicatos cálcicos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calc-silicate rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de rocas carbonatadas impuras o margas, constituida fundamentalmente por silicatos con calcio, como epidota, zoisita, vesubianita, diópsido, actinolita, hornblenda, granate cálcico, wollastonita, anortita o escapolita</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from impure carbonate rocks or marls, consisting fundamentally of calcium silicates such as epidote, zoisite, vesuvianite, diopside, actinolite, hornblende, calcic garnet, wollastonite, anorthite or scapolite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-rico-en-materia-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material rico en materia orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organic matter-rich material</skos:prefLabel>
    <skos:definition xml:lang="es">Material cuyo contenido en materia orgánica es suficientemente alto como para tener efectos notables en la litología</skos:definition>
    <skos:definition xml:lang="en">Material whose organic matter content is sufficiently high to have notable effects on the lithology</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/espeleotema">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">espeleotema</skos:prefLabel>
    <skos:prefLabel xml:lang="en">speleothem</skos:prefLabel>
    <skos:definition xml:lang="es">Precipitado químico, generalmente de carbonato o sulfato cálcicos, formado por la acción del agua en una cueva. los más conocidos son las estalactitas y las estalagmitas</skos:definition>
    <skos:definition xml:lang="en">Chemical precipitate, generally of calcium carbonate or sulfate, formed by the action of water in a cave. The most well-known are stalactites and stalagmites</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-carbonatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material sedimentario carbonatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario compuesto en más de un 50% por minerales carbonatados</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material composed of more than 50% carbonate minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sienita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sienita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica cuyo componente principal son los feldespatos, de entre los que el feldespato alcalino constituye entre el 65 y el 90%, con cuarzo en proporción inferior al 5% de los minerales félsicos y cantidades subordinadas de plagioclasa sódica, biotita, piroxeno, anfíbol y, ocasionalmente, fayalita. es el equivalente intrusivo de la traquita</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock whose main component is feldspars, of which alkali feldspar constitutes between 65 and 90%, with quartz in proportions below 5% of the felsic minerals and subordinate amounts of sodic plagioclase, biotite, pyroxene, amphibole and, occasionally, fayalite. It is the intrusive equivalent of trachyte</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/syenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/limolita-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">limolita arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy siltstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica en la que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 10 y el 50% y la relación de elementos de tamaño limo a tamaño arcilla es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital rock in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 10 and 50% and the ratio of silt-size to clay-size elements exceeds 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/siltstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/siltstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzogabro-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzogabro con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid-bearing monzogabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas monzogabroicas, que contiene feldespatoides</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of monzogabbroic rocks, containing feldspathoids</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingMonzogabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzogabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/picrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">picrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">picrite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultrabásica negra de textura dolerítica o microlítica, con un contenido en sio2 del 30-52%, mgo mayor del 12% y na2o+k2o menor del 3%. es rica en minerales ferromagnesianos, con olivino dominante, augita y, accesoriamente, anfíbol, biotita y plagioclasa</skos:definition>
    <skos:definition xml:lang="en">Black ultrabasic rock of doleritic or microlithic texture, with a SiO2 content of 30-52%, MgO greater than 12% and Na2O+K2O less than 3%. It is rich in ferromagnesian minerals, with dominant olivine, augite and, accessorily, amphibole, biotite and plagioclase</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ultrabasicIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ultrabasic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-dolomitico-magnesico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material sedimentario dolomítico-magnésico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomitic-magnesian sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario carbonatado cuya proporción entre calcita más aragonito y dolomita es menor que 1</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary material whose ratio of calcite plus aragonite to dolomite is less than 1</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomiticOrMagnesianSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-aloquimica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza aloquímica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">allochemical limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza con un contenido en aloquímicos superior al 10% del total de la roca</skos:definition>
    <skos:definition xml:lang="en">Limestone with an allochem content exceeding 10% of the total rock</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ultramilonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ultramilonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultramylonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca milonítica constituida en más del 90% por matriz</skos:definition>
    <skos:definition xml:lang="en">Mylonitic rock consisting of more than 90% matrix</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava-tobacea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava tobácea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuffaceous gravel</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito mixto piroclástico-epiclástico formado en más de un 75% de su volumen por fragmentos de diámetro mayor de 2 mm</skos:definition>
    <skos:definition xml:lang="en">Mixed pyroclastic-epiclastic deposit formed by more than 75% by volume of fragments with a diameter greater than 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel_size_sediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/micrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">micrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micrite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza microcristalina constituida esencialmente por matriz micrítica</skos:definition>
    <skos:definition xml:lang="en">Microcrystalline limestone consisting essentially of micritic matrix</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/appinita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">appinita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">appinite</skos:prefLabel>
    <skos:definition xml:lang="es">Gabro o monzogabro con alto contenido en mgo y k2o, rico en anfíbol y flogopita y con frecuentes texturas acumuladas. forma una serie con rocas más máficas, casi ultramáficas, como las cortlandtitas</skos:definition>
    <skos:definition xml:lang="en">Gabbro or monzogabbro with high MgO and K2O content, rich in amphibole and phlogopite, with frequent cumulate textures. It forms a series with more mafic, almost ultramafic rocks, such as cortlandtites</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzogabbroicRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzogabbroic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arcillita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arcillita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">claystone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida, al menos en un 50%, por elementos de tamaño arcilla menos de 0.004 mm</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of at least 50% clay-size elements (less than 0.004 mm)</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/claystone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/claystone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metacarbonato">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metacarbonato</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metacarbonate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una roca carbonatada</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a carbonate rock</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dunita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dunita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dunite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultramáfica del grupo de las peridotitas constituida en más del 90% por olivino, con otros minerales ferromagnesianos como accesorios piroxeno, cromita, magnetita y/o granate</skos:definition>
    <skos:definition xml:lang="en">Ultramafic rock of the peridotite group consisting of more than 90% olivine, with other ferromagnesian minerals as accessories (pyroxene, chromite, magnetite and/or garnet)</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peridotite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/comendita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">comendita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">comendite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad de riolita peralcalina, más rica en óxido de aluminio frente a óxido ferroso que la pantellerita</skos:definition>
    <skos:definition xml:lang="en">Variety of peralkaline rhyolite, richer in aluminium oxide relative to ferrous oxide than pantellerite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rhyolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metavolcanita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metavolcanita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metavolcanite</skos:prefLabel>
    <skos:altLabel xml:lang="es">metavulcanita</skos:altLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito volcánico</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a volcanic protolith</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cataclasita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cataclasita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cataclasitee</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cataclástica cuya matriz constituye entre el 50 y el 90% del volumen de la roca</skos:definition>
    <skos:definition xml:lang="en">Cataclastic rock whose matrix constitutes between 50 and 90% of the rock volume</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-clastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca clástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clastic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca detrítica</skos:altLabel>
    <skos:definition xml:lang="es">Roca compuesta en más de un 50% por fragmentos de otras rocas y minerales preexistentes</skos:definition>
    <skos:definition xml:lang="en">Rock composed of more than 50% fragments from pre-existing rocks and minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/shale">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">shale</skos:prefLabel>
    <skos:prefLabel xml:lang="en">shale</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de grano muy fino, generalmente arcillosa, de estructura hojosa</skos:definition>
    <skos:definition xml:lang="en">Very fine-grained, generally clayey rock with a lamellar structure</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/shale"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/shale"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-de-grano-medio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca de grano medio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">medium-grained sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca en la que predominan los granos de diámetro comprendido entre 0.25 y 0.5 mm</skos:definition>
    <skos:definition xml:lang="en">Sandstone in which grains with a diameter between 0.25 and 0.5 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-carbonatados">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Sedimentarias y Sedimentos Carbonatados</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Carbonate Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Sedimentarias y Sedimentos Carbonatados, que se caracteriza por incluir rocas sedimentarias compuestas en más de un 50% por minerales carbonatados.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Carbonate Sedimentary Rocks and Sediments, characterized by including sedimentary rocks composed of more than 50% carbonate minerals.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/bafflestone"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/bindstone"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/bioesparita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/bioesparrudita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/biolitita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/biomicrita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/biomicrudita"/>
