  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/shoshonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">shoshonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">shoshonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica o intermedia, alcalina, variedad potásica de la traquiandesita basáltica. el término “shoshonítico” es utilizado para denominar series de rocas potásicas alcalinas</skos:definition>
    <skos:definition xml:lang="en">Basic or intermediate, alkaline volcanic rock, potassic variety of basaltic trachyandesite. The term 'shoshonitic' is used to designate series of alkaline potassic rocks</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-siliceos-no-clasticos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Sedimentarias y Sedimentos Silíceos No Clásticos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Non-Clastic Siliceous Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Sedimentarias y Sedimentos Silíceos No Clásticos, que se caracteriza por incluir rocas sedimentarias compuestas en más de un 50% por sílice de origen biogénico o químico, excluyendo las rocas detríticas.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Non-Clastic Siliceous Sedimentary Rocks and Sediments, characterized by including sedimentary rocks composed of more than 50% silica of biogenic or chemical origin, excluding detrital rocks.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/agata"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/calcedonia"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/chert"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/diatomita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/espiculita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/fango-de-diatomeas"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/fango-de-espiculas-de-esponjas"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/fango-de-radiolarios"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/ftanita"/>
