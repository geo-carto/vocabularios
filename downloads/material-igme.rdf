    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/radiolarita"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-y-depositos-volcanoclasticos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas y Depósitos Volcanoclásticos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Volcaniclastic Rocks And Deposits</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas y Depósitos Volcanoclásticos, que se caracteriza por incluir rocas compuestas, al menos en un 10% de su volumen, por fragmentos de naturaleza volcánica, independientemente del mecanismo de fragmentación y de acumulación.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Volcaniclastic Rocks and Deposits, characterized by including rocks composed of at least 10% by volume of fragments of volcanic nature, regardless of the fragmentation and accumulation mechanism.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/aglomerado-volcanico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/aglutinado"/>
