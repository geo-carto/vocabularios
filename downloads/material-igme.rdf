  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sienogranito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sienogranito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">syenogranite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad más leucocrática del granito, en la que el feldespato alcalino constituye entre el 65 y el 90% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">More leucocratic variety of granite, in which alkali feldspar constitutes between 65 and 90% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/syenogranite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenogranite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/creta">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">creta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chalk</skos:prefLabel>
    <skos:definition xml:lang="es">Roca calcárea de color blanco a gris y grano fino, microporosa e impermeable, formada por restos de foraminíferos, cocolitos, esponjas y equinodermos</skos:definition>
    <skos:definition xml:lang="en">White to grey, fine-grained, microporous and impermeable calcareous rock, formed by remains of foraminifera, coccoliths, sponges and echinoderms</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/chalk"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/chalk"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava-fina-media">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava fina-media</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fine-medium gravel</skos:prefLabel>
    <skos:definition xml:lang="es">Grava constituida por cantos de tamaño comprendido entre 2 y 64 mm</skos:definition>
    <skos:definition xml:lang="en">Gravel consisting of clasts with a size between 2 and 64 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pelmicrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pelmicrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelmicrite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica micrítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides inferior a 1:3</skos:definition>
    <skos:definition xml:lang="en">Micritic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio below 1:3</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/canto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">canto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cobble</skos:prefLabel>
    <skos:altLabel xml:lang="es">guijarro</skos:altLabel>
    <skos:definition xml:lang="es">Clasto correspondiente al tamaño de la fracción rudítica sefítica comprendido entre 2 y 256 mm</skos:definition>
    <skos:definition xml:lang="en">Clast of the rudite (psephite) size fraction with a diameter between 2 and 256 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/skarn">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">skarn</skos:prefLabel>
    <skos:prefLabel xml:lang="en">skarn</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por metasomatismo inducido por intrusiones magmáticas sobre calizas o dolomías y que está constituida por carbonatos, cuarzo y una gran variedad de silicatos cálcicos como wollastonita, diópsido, grosularia, epidota, etc</skos:definition>
    <skos:definition xml:lang="en">Rock formed by metasomatism induced by magmatic intrusions on limestones or dolomites, consisting of carbonates, quartz and a great variety of calcic silicates such as wollastonite, diopside, grossular, epidote, etc.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/skarn"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/skarn"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ooesparrudita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ooesparrudita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oosparrudite</skos:prefLabel>
    <skos:definition xml:lang="es">Ooesparita en la que más del 25% de los aloquímicos tienen un diámetro superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Oosparite in which more than 25% of the allochems have a diameter exceeding 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-felsica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca félsica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">felsic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cuyo contenido en cuarzo y minerales de color claro feldespato y plagioclasa es superior al 50% en volumen</skos:definition>
    <skos:definition xml:lang="en">Rock whose content of quartz and light-coloured minerals feldspar and plagioclase exceeds 50% by volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava-gruesa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava gruesa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coarse gravel</skos:prefLabel>
    <skos:definition xml:lang="es">Grava constituida por cantos de tamaño comprendido entre 64 y 256 mm</skos:definition>
    <skos:definition xml:lang="en">Gravel consisting of clasts with a size between 64 and 256 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/cobbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/cobble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/beforsita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">beforsita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bef orsite</skos:prefLabel>
    <skos:definition xml:lang="es">Carbonatita dolomítica de grano medio a fino, que se manifiesta generalmente en forma de diques</skos:definition>
    <skos:definition xml:lang="en">Dolomitic carbonatite of medium to fine grain, generally occurring as dykes</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonatite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonatite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fango-de-radiolarios">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fango de radiolarios</skos:prefLabel>
    <skos:prefLabel xml:lang="en">radiolarian ooze</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento de tamaño pelita compuesto por esqueletos de radiolarios</skos:definition>
    <skos:definition xml:lang="en">Pelite-size sediment composed of radiolarian skeletons</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/siliceousOoze"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/riodacita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">riodacita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rhyodacite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de composición intermedia entre riolita y dacita, con cuarzo, feldespato potásico y plagioclasa como constituyentes principales</skos:definition>
    <skos:definition xml:lang="en">Rock of intermediate composition between rhyolite and dacite, with quartz, potassic feldspar and plagioclase as principal constituents</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dacite"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dacite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rhyolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/laterita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">laterita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">laterite</skos:prefLabel>
    <skos:altLabel xml:lang="en">residual material</skos:altLabel>
    <skos:definition xml:lang="es">Tierra roja originada por meteorización en clima tropical, principalmente como residuo de lixiviación, que tiene como resultado la concentración de óxidos de hierro y alúmina</skos:definition>
    <skos:definition xml:lang="en">Red soil formed by weathering in a tropical climate, mainly as a residue of leaching, resulting in a concentration of iron oxides and alumina</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/residualMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/residual_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-plutonicas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Plutónicas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Plutonic Rocks</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Plutónicas, que se caracteriza por incluir rocas ígneas solidificadas en el interior de la corteza terrestre, a partir de un magma silicatado, generalmente de grano medio-grueso, aunque pueden tener facies de grano fino relacionadas.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Plutonic Rocks, characterized by including igneous rocks solidified in the interior of the Earth's crust from a silicate magma, generally medium- to coarse-grained, although they may have related fine-grained facies.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/agpaita"/>
