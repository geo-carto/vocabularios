  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ceniza-fina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ceniza fina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fine ash</skos:prefLabel>
    <skos:definition xml:lang="es">1. piroclasto de tamaño de grano inferior a 1/16 mm. 2. depósito piroclástico formado en más de un 75% de su volumen por fragmentos de diámetro inferior a 1/16 mm</skos:definition>
    <skos:definition xml:lang="en">1. Pyroclast with a grain size below 1/16 mm. 2. Pyroclastic deposit formed by more than 75% by volume of fragments with a diameter below 1/16 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/calcilutita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">calcilutita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcilutite</skos:prefLabel>
    <skos:definition xml:lang="es">1. Caliza compuesta fundamentalmente por granos carbonáticos de tamaño pelita. 2. Lutita constituida mayoritariamente por clastos de carbonatos</skos:definition>
    <skos:definition xml:lang="en">1. Limestone composed fundamentally of pelite-size carbonate grains. 2. Mudstone consisting predominantly of carbonate clasts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-volcanicas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Volcánicas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Volcanic Rocks</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Volcánicas, que se caracteriza por incluir rocas ígneas producidas por actividad volcánica, normalmente de grano muy fino o vítreas, que con frecuencia pueden contener fragmentos de otras rocas, así como fenocristales.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Volcanic Rocks, characterized by including igneous rocks produced by volcanic activity, normally very fine-grained or glassy, which may frequently contain fragments of other rocks as well as phenocrysts.</skos:definition>
