  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Grandes Grupos de Materiales</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Major Material Groups</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Grandes Grupos de Materiales, que se caracteriza por representar el nivel más alto de la clasificación litológica, englobando las divisiones principales: materiales ígneos, sedimentarios, metamórficos, antrópicos y de impacto.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Major Material Groups, characterized by representing the highest level of lithological classification, encompassing the main divisions: igneous, sedimentary, metamorphic, anthropic, and impact materials.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-compuesto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-natural-no-consolidado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-no-consolidado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-poligenico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-madre"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-poligenica"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-otras-rocas-igneas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Otras Rocas ígneas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Other Igneous Rocks</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Otras Rocas Ígneas, que se caracteriza por incluir rocas resultantes del enfriamiento y la solidificación de un magma que no se clasifican estrictamente como volcánicas, plutónicas o subvolcánicas, abarcando tipos transicionales o con características mixtas.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Other Igneous Rocks, characterized by including rocks resulting from the cooling and solidification of a magma that are not strictly classified as volcanic, plutonic, or subvolcanic, encompassing transitional types or those with mixed characteristics.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/adakita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/albitita"/>
