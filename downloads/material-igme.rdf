  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-komatiitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca komatiítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">komatiitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica ultramáfica formada a partir de magmas de muy alta temperatura, con un contenido en sio2 del 30-52%, mayor del 18% en mgo y menor del 2% en na2o+k2o. presenta texturas spinifex formadas por cristales alargados y dendríticos de olivino, resultado de un enfriamiento muy rápido</skos:definition>
    <skos:definition xml:lang="en">Ultramafic volcanic rock formed from very high-temperature magmas, with a SiO2 content of 30-52%, more than 18% MgO and less than 2% Na2O+K2O. It exhibits spinifex textures formed by elongated dendritic crystals of olivine, resulting from very rapid cooling</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/komatiiticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/komatiitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gabro-olivinico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gabro olivínico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine gabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca gabroica con un contenido de olivino superior al 5%</skos:definition>
    <skos:definition xml:lang="en">Gabbroic rock with an olivine content exceeding 5%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pelita-carbonatada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pelita carbonatada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate pelite</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico con un contenido conjunto de elementos de tamaño pelita y de carbonatos igual o superior al 90% del total y en el que la relación de elementos de tamaño pelita con respecto al carbonato está comprendida entre el 50 y el 90%</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment with a combined content of pelite-size elements and carbonates equal to or exceeding 90% of the total, and in which the ratio of pelite-size elements to carbonate is between 50 and 90%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateRichMud"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/clinopiroxenita-olivinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">clinopiroxenita olivínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine clinopyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Piroxenita olivínica constituida esencialmente por olivino y clinopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Olivine pyroxenite consisting essentially of olivine and clinopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-de-fundido-de-impacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca de fundido de impacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impact melt rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca constituida, al menos en un 50% de su volumen, por material resultante de la solidificación de un fundido producido por un impacto</skos:definition>
    <skos:definition xml:lang="en">Rock consisting, in at least 50% of its volume, of material resulting from the solidification of a melt produced by an impact</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impactGeneratedMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impact_generated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-charnoquitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca charnoquítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">charnockitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea o ígnea-derivada anhidra, generalmente de composición ácida-intermedia, con ortopiroxeno como mineral máfico principal, sin o con escasos minerales hidratados como micas o anfíboles</skos:definition>
    <skos:definition xml:lang="en">Anhydrous igneous or igneous-derived rock, generally of acid-intermediate composition, with orthopyroxene as the principal mafic mineral, with absent or scarce hydrated minerals such as micas or amphiboles</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/clasto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">clasto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clast</skos:prefLabel>
    <skos:altLabel xml:lang="es">detrito</skos:altLabel>
    <skos:definition xml:lang="es">Fragmento de un mineral, una roca o un fósil, que está incluido en un sedimento o una roca, formando parte constitutiva de ellos</skos:definition>
    <skos:definition xml:lang="en">Fragment of a mineral, rock or fossil, included in a sediment or a rock, forming a constituent part of them</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bomba-volcanica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bomba volcánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcanic bomb</skos:prefLabel>
    <skos:definition xml:lang="es">Piroclasto juvenil de diámetro superior a 64 mm, de contorno redondeado o fusiforme por haber completado su consolidación girando en el aire</skos:definition>
    <skos:definition xml:lang="en">Juvenile pyroclast with a diameter exceeding 64 mm, rounded or spindle-shaped in outline due to having completed its solidification while rotating in the air</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashBrecciaBombOrBlockTephra"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/paraanfibolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">paraanfibolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">para-amphibolite</skos:prefLabel>
    <skos:definition xml:lang="es">Anfibolita cuyo protolito es una roca sedimentaria, generalmente una marga</skos:definition>
    <skos:definition xml:lang="en">Amphibolite whose protolith is a sedimentary rock, generally a marl</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/amphibolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/amphibolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquita-alcalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquita alcalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkaline trachyte</skos:prefLabel>
    <skos:altLabel xml:lang="es">traquita de feldespato alcalino</skos:altLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente al grupo de las rocas traquíticas de feldespato alcalino, que puede contener cuarzo, en proporción inferior al 5% de los minerales félsicos. su equivalente plutónico es la sienita de feldespato alcalino</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the group of alkali feldspar trachytic rocks, which may contain quartz in proportions below 5% of the felsic minerals. Its plutonic equivalent is alkali feldspar syenite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparTrachyte"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-monzodioritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca monzodiorítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzodioritic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Dioritoide mesocrato en el que la plagioclasa, predominantemente sódica, constituye entre el 65 y el 90% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Mesocratic dioritoid in which plagioclase, predominantly sodic, constitutes between 65 and 90% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzodioriticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzodioritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/colada-de-ceniza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">colada de ceniza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ash flow</skos:prefLabel>
    <skos:definition xml:lang="es">Colada piroclástica formada mayoritariamente por cenizas</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic flow formed predominantly by ash</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/asfaltita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">asfaltita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">asphaltite</skos:prefLabel>
    <skos:definition xml:lang="es">Sustancia bituminosa sólida de origen natural, compuesta de hidrocarburos, más dura que el asfalto y con punto de fusión entre 121 y 316ºc</skos:definition>
    <skos:definition xml:lang="en">Solid, naturally occurring bituminous substance composed of hydrocarbons, harder than asphalt, with a melting point between 121 and 316°C</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/bitumen"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/foidita-tefritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">foidita tefrítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephritic foidite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente a la familia de las rocas foídicas en la que los feldespatoides representan menos del 90% del total de los minerales félsicos, la plagioclasa es más abundante que el feldespato alcalino y el olivino no llega al 10% normativo</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the foidite family in which feldspathoids represent less than 90% of the total felsic minerals, plagioclase is more abundant than alkali feldspar, and olivine does not reach 10% normative</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephriticFoidite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephritic_foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/basalto-toleitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">basalto toleítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tholeiitic basalt</skos:prefLabel>
    <skos:altLabel xml:lang="es">toleíta</skos:altLabel>
    <skos:definition xml:lang="es">Basalto pobre en álcalis, con enstatita normativa, plagioclasa y augita, con o sin olivino y, en ocasiones, con pigeonita</skos:definition>
    <skos:definition xml:lang="en">Low-alkali basalt with normative enstatite, plagioclase and augite, with or without olivine and, occasionally, with pigeonite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tholeiiticBasalt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tholeiitic_basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gneis-bandeado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gneis bandeado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">banded gneiss</skos:prefLabel>
    <skos:definition xml:lang="es">Gneis equigranular, con franjas claras y oscuras regulares y bien marcadas</skos:definition>
    <skos:definition xml:lang="en">Equigranular gneiss with regular and well-marked light and dark bands</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gneiss"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gneiss"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-mesocratica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca mesocrática</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mesocratic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con un contenido en minerales oscuros comprendido entre el 35% y el 65% en volumen</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with a dark mineral content between 35% and 65% by volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/novaculita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">novaculita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">novaculite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria silícea criptocristalina, blanquecina, similar al sílex, pero con predominio del cuarzo criptocristalino sobre la calcedonia</skos:definition>
    <skos:definition xml:lang="en">Cryptocrystalline, whitish siliceous sedimentary rock, similar to chert, but with a predominance of cryptocrystalline quartz over chalcedony</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-metaignea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca metaígnea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">meta-igneous rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca ortoderivada</skos:altLabel>
    <skos:definition xml:lang="es">Roca metamórfica cuyo protolito es una roca ígnea</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock whose protolith is an igneous rock</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-volcanoclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca volcanoclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcaniclastic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca compuesta, al menos en un 10% de su volumen, por fragmentos de naturaleza volcánica, independientemente del mecanismo de fragmentación y de acumulación</skos:definition>
    <skos:definition xml:lang="en">Rock composed of at least 10% by volume of fragments of volcanic nature, regardless of the fragmentation and accumulation mechanism</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/radiolarita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">radiolarita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">radiolarite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca silícea, generalmente con una porosidad del 50-90%, formada principalmente por esqueletos de radiolarios. frecuentemente se encuentra coloreada de rojo o rojo-violáceo por óxidos de hierro</skos:definition>
    <skos:definition xml:lang="en">Siliceous rock, generally with 50-90% porosity, formed mainly by radiolarian skeletons. It is frequently coloured red or red-violet by iron oxides</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pudinga">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pudinga</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pudding stone</skos:prefLabel>
    <skos:definition xml:lang="es">Conglomerado constituido por cantos rodados</skos:definition>
    <skos:definition xml:lang="en">Conglomerate consisting of rounded pebbles</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/piedra-pomez">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">piedra pómez</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pumice stone</skos:prefLabel>
    <skos:altLabel xml:lang="es">pómez, pumita</skos:altLabel>
    <skos:definition xml:lang="es">Roca volcánica vítrea de color claro, muy porosa y de baja densidad, que flota en el agua, formada a partir de fragmentos de lava viscosa proyectados al aire por un volcán y que sufren un gran descenso de presión que provoca una desgasificación y la formación de burbujas, separadas por delgadas paredes de vidrio volcánico</skos:definition>
    <skos:definition xml:lang="en">Light-coloured, very porous and low-density glassy volcanic rock that floats on water, formed from fragments of viscous lava projected into the air by a volcano and undergoing a large pressure drop causing degassing and the formation of bubbles separated by thin walls of volcanic glass</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Materiales Sedimentarios, que se caracteriza por incluir materiales formados en el exterior de la corteza terrestre mediante un proceso de sedimentación, que presentan estructuras características, como, principalmente, la estratificación.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Sedimentary Materials, characterized by including materials formed outside the Earth's crust by a sedimentary process, exhibiting characteristic structures, primarily stratification.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/arena-s.l."/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/arenisca-s.l."/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/bauxita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/conglomerado-s.l."/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-rico-en-materia-organica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/grava-s.l."/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lutita-s.l."/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/pelita-s.l."/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/guano">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">guano</skos:prefLabel>
    <skos:prefLabel xml:lang="en">guano</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito rico en fosfatos, formado por excrementos de aves o murciélagos</skos:definition>
    <skos:definition xml:lang="en">Phosphate-rich deposit formed by the excrement of birds or bats</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phosphateRichSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phosphate_rich_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/diorita-nefelinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">diorita nefelínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nepheline diorite</skos:prefLabel>
    <skos:definition xml:lang="es">Diorita foídica en la que la nefelina constituye el feldespatoide dominante</skos:definition>
    <skos:definition xml:lang="en">Foid diorite in which nepheline constitutes the dominant feldspathoid</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingDiorite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_diorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-ultramafica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca ultramáfica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultramafic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con un contenido en minerales oscuros superior al 90% en volumen</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with a dark mineral content exceeding 90% by volume</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ultramaficIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ultramafic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-evaporitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca evaporítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">evaporitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada a partir de la precipitación química de sales no carbonatadas, principalmente por sulfatos, cloratos y boratos</skos:definition>
    <skos:definition xml:lang="en">Rock formed by chemical precipitation of non-carbonate salts, mainly sulfates, chlorates and borates</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquitoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquitoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trachytoid</skos:prefLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de rocas volcánicas ácidas o intermedias, alcalinas, similares a la traquita, generalmente leucocráticas, compuestas principalmente por feldespatos, de los que el feldespato alcalino constituye al menos el 35%, en una matriz microcristalina o, más raramente, vítrea, también pueden incluir cantidades menores de biotita, anfíbol y piroxeno, además de cuarzo o feldespatoides en proporción inferior al 20 y al 10%, respectivamente, de los minerales félsicos. su equivalente plutónico es el sienitoide</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of acid or intermediate, alkaline volcanic rocks similar to trachyte, generally leucocratic, composed mainly of feldspars, of which alkali feldspar constitutes at least 35%, in a microcrystalline or, more rarely, glassy groundmass; may also include lesser amounts of biotite, amphibole and pyroxene, as well as quartz or feldspathoids in proportions below 20 and 10%, respectively, of the felsic minerals. Its plutonic equivalent is syenitoid</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/trachytoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/trachytoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-detriticos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Sedimentarias y Sedimentos Detríticos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Detrital Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Sedimentarias y Sedimentos Detríticos, que se caracteriza por incluir rocas compuestas en más de un 50% por fragmentos de otras rocas y minerales preexistentes.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Detrital Sedimentary Rocks and Sediments, characterized by including rocks composed of more than 50% fragments from pre-existing rocks and minerals.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/arcilla"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/arcilla-arenosa"/>
