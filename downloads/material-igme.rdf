  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pelita-calcarea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pelita calcárea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous pelite</skos:prefLabel>
    <skos:altLabel xml:lang="es">pelita margosa</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento detrítico con un contenido conjunto de elementos de tamaño pelita y de carbonato cálcico igual o superior al 90% del total y en el que la relación de elementos de tamaño lutita con respecto al carbonato está comprendida entre el 65 y el 90%</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment with a combined content of pelite-size elements and calcium carbonate equal to or exceeding 90% of the total, and in which the ratio of mudstone-size elements to carbonate is between 65 and 90%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mud"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/calcarenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">calcarenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcarenite</skos:prefLabel>
    <skos:definition xml:lang="es">1. Caliza compuesta fundamentalmente por granos carbonáticos de tamaño arena. 2. Arenisca constituida mayoritariamente por clastos de carbonatos o de bioclastos</skos:definition>
    <skos:definition xml:lang="en">1. Limestone composed fundamentally of sand-size carbonate grains. 2. Sandstone consisting predominantly of carbonate or bioclast clasts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/vitrofido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">vitrófido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">vitrophyre</skos:prefLabel>
    <skos:definition xml:lang="es">Pórfido cuya matriz es vítrea</skos:definition>
    <skos:definition xml:lang="en">Porphyry whose groundmass is glassy</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/porphyry"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/porphyry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
