  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Material IGME</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Material IGME</skos:prefLabel>
    <dcterms:title xml:lang="es">Material IGME</dcterms:title>
    <dcterms:title xml:lang="en">Material IGME</dcterms:title>
    <skos:definition xml:lang="es">Términos que definen el material que constituye parte o la totalidad de la unidad geológica determinados por el CSIC-IGME.</skos:definition>
    <skos:definition xml:lang="en">Terms defining the material that composes part or all of the geologic unit as defined by CSIC-IGME.</skos:definition>
    <dcterms:description xml:lang="es">Términos que definen el material que constituye parte o la totalidad de la unidad geológica determinados por el CSIC-IGME.</dcterms:description>
    <dcterms:description xml:lang="en">Terms defining the material that composes part or all of the geologic unit as defined by CSIC-IGME.</dcterms:description>
