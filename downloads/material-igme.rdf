    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-vitrea"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-volcanica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-volcanoclastica"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-hemipelagico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito hemipelágico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hemipelagic deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">hemipelagita</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento constituido por lodos lutíticos, margosos o calcáreos, depositados en el medio sedimentario que comprende el talud y el glacis continental</skos:definition>
    <skos:definition xml:lang="en">Sediment consisting of muddy, marly or calcareous muds, deposited in the sedimentary environment comprising the continental slope and glacis</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mud"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/barro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">barro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mud</skos:prefLabel>
    <skos:altLabel xml:lang="es">lodo</skos:altLabel>
    <skos:definition xml:lang="es">sedimento pelítico impregnado de agua, que puede incluir materiales de otros tamaños, en muy baja proporción</skos:definition>
    <skos:definition xml:lang="en">Water-saturated pelitic sediment, which may include materials of other sizes in very low proportions</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mud"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzogabro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzogabro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzogabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas monzogabroicas, que contiene cuarzo en una cantidad que no supera el 5% de los minerales félsicos y que además de plagioclasa cálcica contiene feldespato alcalino en cantidades comprendidas entre el 10 y el 35% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of monzogabbroic rocks, containing quartz in an amount not exceeding 5% of the felsic minerals, and which in addition to calcic plagioclase contains alkali feldspar in amounts between 10 and 35% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzogabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzogabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sienítica de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar syenitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Sienitoide leucocrático en el que el feldespato alcalino constituye más del 90% de los feldespatos, con cantidades subordinadas de plagioclasa, clinopiroxeno, biotita, hornblenda y cuarzo o nefelina. es el equivalente intrusivo de la roca traquítica de feldespato alcalino</skos:definition>
    <skos:definition xml:lang="en">Leucocratic syenitoid in which alkali feldspar constitutes more than 90% of the feldspars, with subordinate amounts of plagioclase, clinopyroxene, biotite, hornblende and quartz or nepheline. It is the intrusive equivalent of alkali feldspar trachytic rock</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparSyeniticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/rudacea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">rudácea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rudaceous</skos:prefLabel>
    <skos:altLabel xml:lang="es">psefita, sefita</skos:altLabel>
    <skos:definition xml:lang="es">Clase, grupo o textura de los sedimentos o rocas sedimentarias detríticas cuyo tamaño medio de los granos es superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Class, group or texture of detrital sediments or sedimentary rocks whose mean grain size exceeds 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gravel"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gabro-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gabro con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid-bearing gabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas gabroicas, que contiene feldespatoides</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of gabbroic rocks, containing feldspathoids</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingGabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/litarenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">litarenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">litharenite</skos:prefLabel>
    <skos:definition xml:lang="es">Arenita en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de fragmentos de otras rocas es mayor que el de feldespatos</skos:definition>
    <skos:definition xml:lang="en">Arenite in which the proportion of quartz is below 75% of the total terrigenous elements and in which the rock fragment content is greater than that of feldspars</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/calcedonia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">calcedonia</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chalcedony</skos:prefLabel>
    <skos:definition xml:lang="es">Roca constituida por el mineral del mismo nombre, consistente en una variedad microcristalina del cuarzo. posee color variable entre gris, blanco, verde, amarillo y azulado, frecuentemente con zonas de distintos colores, varía de transparente a translúcido</skos:definition>
    <skos:definition xml:lang="en">Rock consisting of the mineral of the same name, a microcrystalline variety of quartz. It has variable colour between grey, white, green, yellow and bluish, frequently with zones of different colours, and varies from transparent to translucent</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefra-con-lapilli-o-ceniza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefra con lapilli o ceniza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lapilli or ash tephra</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito piroclástico en el que los fragmentos de tamaño superior a 64 mm constituyen menos del 25% en volumen de los piroclastos</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic deposit in which fragments larger than 64 mm constitute less than 25% by volume of the pyroclasts</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashAndLapilli"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_and_lapilli"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava-media">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava media</skos:prefLabel>
    <skos:prefLabel xml:lang="en">medium gravel</skos:prefLabel>
    <skos:definition xml:lang="es">Grava constituida por cantos de tamaño comprendido entre 4 y 64 mm</skos:definition>
    <skos:definition xml:lang="en">Gravel consisting of clasts with a size between 4 and 64 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gravel"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-carbonatado-pelitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento carbonatado pelítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelitic carbonate sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado con un contenido lutítico comprendido entre el 10 y el 50% del total</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment with a mudstone content between 10 and 50% of the total</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateMud"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-conglomeratica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca conglomerática</skos:prefLabel>
    <skos:prefLabel xml:lang="en">conglomeratic sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica con un contenido de elementos de tamaño arena superior al de elementos de tamaño pelita y con un contenido de tamaño grava comprendido entre el 5 y el 30% del total</skos:definition>
    <skos:definition xml:lang="en">Detrital rock with a sand-size element content greater than that of pelite-size elements and a gravel-size content between 5 and 30% of the total</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzosienita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzosienita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar quartz syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica leucocrática perteneciente al grupo de las rocas sieníticas de feldespato alcalino, que contiene cuarzo en una cantidad comprendida entre el 5 y el 20% de los minerales félsicos. es el equivalente intrusivo de la cuarzotraquita de feldespato alcalino</skos:definition>
    <skos:definition xml:lang="en">Leucocratic plutonic rock belonging to the group of alkali feldspar syenitic rocks, containing quartz in an amount between 5 and 20% of the felsic minerals. It is the intrusive equivalent of alkali feldspar quartz trachyte</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzAlkaliFeldsparSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_alkali_feldspar_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/hornblendita-piroxenica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">hornblendita piroxénica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroxene hornblendite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultramáfica constituida esencialmente por hornblenda y, en menor proporción, piroxeno</skos:definition>
    <skos:definition xml:lang="en">Ultramafic rock consisting essentially of hornblende and, in lesser proportion, pyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hornblendite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hornblendite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ortobrecha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ortobrecha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">orthobreccia</skos:prefLabel>
    <skos:definition xml:lang="es">Brecha constituida por cantos y bloques angulosos dispuestos en contacto entre sí, entre los que la matriz arenosa o pelítica se presenta en proporción inferior al 15%</skos:definition>
    <skos:definition xml:lang="en">Breccia consisting of angular clasts and blocks in mutual contact, with a sandy or pelitic matrix in proportions below 15%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-alcalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca alcalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkaline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con una elevada concentración de álcalis na2o, k2o que no puede ser acomodada exclusivamente en los feldespatos. este exceso hace que se formen feldespatoides, piroxenos y/o anfíboles sódicos, así como otras fases ricas en estos elementos. esta definición es algo estricta y es frecuente el uso del término “alcalino/a” para rocas que simplemente tienen elevados contenidos de na2o y k2o para determinados contenidos de sio2</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with a high concentration of alkalis Na2O, K2O that cannot be accommodated exclusively in the feldspars. This excess causes the formation of feldspathoids, pyroxenes and/or sodic amphiboles, as well as other phases rich in these elements. This definition is somewhat strict and it is common to use the term 'alkaline' for rocks that simply have high Na2O and K2O contents for given SiO2 contents</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fanglomerado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fanglomerado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fanglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria formada por materiales angulosos de tamaños diversos, depositados en un abanico aluvial, generalmente asociados a corrientes de barro</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock formed by angular materials of diverse sizes deposited in an alluvial fan, generally associated with mudflows</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lapilli">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lapilli</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lapilli</skos:prefLabel>
    <skos:definition xml:lang="es">Piroclasto de diámetro comprendido entre 2 y 64 mm</skos:definition>
    <skos:definition xml:lang="en">Pyroclast with a diameter between 2 and 64 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashAndLapilli"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_and_lapilli"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-y-depositos-volcanoclasticos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Rocas y Depósitos Volcanoclásticos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Volcaniclastic Rocks And Deposits</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas y Depósitos Volcanoclásticos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas compuestas, al menos en un 10% de su volumen, por fragmentos de naturaleza volcánica, independientemente del mecanismo de fragmentación y de acumulación.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Volcaniclastic Rocks and Deposits, characterized by grouping, within sedimentary materials, those rocks composed of at least 10% by volume of fragments of volcanic nature, regardless of the fragmentation and accumulation mechanism.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-volcano-sedimentario"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-volcano-sedimentaria"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzomangerita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzomangerita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz mangerite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca perteneciente a la familia de las rocas charnoquíticas, equivalente a una cuarzomonzonita con ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Rock belonging to the charnockitic rock family, equivalent to a quartz monzonite with orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/canto-rodado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">canto rodado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rounded pebble</skos:prefLabel>
    <skos:definition xml:lang="es">Canto de forma redondeada, causada por haber sufrido durante mucho tiempo el arrastre por un transporte fluvial o marino</skos:definition>
    <skos:definition xml:lang="en">Rounded clast, shaped by prolonged transport by fluvial or marine action</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/varva-glaciolacustre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">varva glaciolacustre</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glaciolacustrine varve</skos:prefLabel>
    <skos:definition xml:lang="es">Varva propia de lagos localizados en la cabecera de un glaciar, en los que las láminas claras de limos y arenas se depositan en verano, cuando el lago está desprovisto de hielo, mientras que las láminas oscuras de arcilla se depositan en invierno, cuando el lago está helado</skos:definition>
    <skos:definition xml:lang="en">Varve characteristic of lakes located at the head of a glacier, in which the light silt and sand laminae are deposited in summer when the lake is free of ice, while the dark clay laminae are deposited in winter when the lake is frozen</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-evaporitas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Evaporitas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Evaporites</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Evaporitas, que se caracteriza por incluir sedimentos o rocas sedimentarias formados por precipitación química de sales no carbonatadas, principalmente por sulfatos, cloruros y boratos.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Evaporites, characterized by including sediments or sedimentary rocks formed by chemical precipitation of non-carbonate salts, mainly sulfates, chlorides, and borates.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/alabastro"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/anhidrita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/barita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/borax"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/carnalita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/colemanita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/evaporita-exotica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/halita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/kainita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/kernita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/kieserita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/polihalita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/silvina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/silvinita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/ulexita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/yeso"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/yeso-anhidrita"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/miaskita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">miaskita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">miaskite</skos:prefLabel>
    <skos:definition xml:lang="es">Monzosienita foídica con oligoclasa</skos:definition>
    <skos:definition xml:lang="en">Foid monzosyenite with oligoclase</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidSyenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-calcareo-puro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento calcáreo puro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure calcareous sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento compuesto en más de un 90% por minerales carbonatados y con un contenido de calcita más aragonito superior al de dolomita</skos:definition>
    <skos:definition xml:lang="en">Sediment composed of more than 90% carbonate minerals and with a calcite plus aragonite content greater than that of dolomite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pureCalcareousCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_calcareous_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-limosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca limosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silty sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica en la que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 50 y el 90% y la relación de elementos de tamaño limo a tamaño arcilla es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital rock in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 50 and 90% and the ratio of silt-size to clay-size elements exceeds 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cipolino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cipolino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cipolino</skos:prefLabel>
    <skos:definition xml:lang="es">Mármol impuro rico en clorita y otros filosilicatos, generalmente concentrados en bandas</skos:definition>
    <skos:definition xml:lang="en">Impure marble rich in chlorite and other phyllosilicates, generally concentrated in bands</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/marble"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/marble"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gabro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gabro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica melanocrática constituida fundamentalmente por plagioclasa cálcica labradorita-anortita y piroxeno. es el equivalente plutónico del basalto</skos:definition>
    <skos:definition xml:lang="en">Melanocratic plutonic rock consisting fundamentally of calcic plagioclase (labradorite-anorthite) and pyroxene. It is the plutonic equivalent of basalt</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-grauvaquica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena grauváquica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">graywacke sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que más del 15% del sedimento está constituido por elementos de tamaño pelita</skos:definition>
    <skos:definition xml:lang="en">Sand in which more than 15% of the sediment consists of pelite-size elements</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/piroxenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">piroxenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica ultramáfica compuesta esencialmente por piroxenos, con olivino en cantidad inferior al 40%, además de espinela y hornblenda, puede contener cantidades menores de plagioclasa, granate y flogopita. en un sentido más estricto, roca plutónica ultramáfica compuesta en más de un 90% por piroxenos</skos:definition>
    <skos:definition xml:lang="en">Ultramafic plutonic rock composed essentially of pyroxenes, with olivine in an amount below 40%, in addition to spinel and hornblende; may contain lesser amounts of plagioclase, garnet and phlogopite. In a stricter sense, an ultramafic plutonic rock composed of more than 90% pyroxenes</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-subarcosica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena subarcósica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subarkosic sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que entre el 75 y el 95% de los granos son de cuarzo y el contenido de feldespatos es mayor que el de fragmentos de otras rocas</skos:definition>
    <skos:definition xml:lang="en">Sand in which between 75 and 95% of the grains are quartz and the feldspar content is greater than that of rock fragments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cancalita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cancalita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cancalite</skos:prefLabel>
    <skos:altLabel xml:lang="es">lamproíta con enstatita-sanidina-flogopita</skos:altLabel>
    <skos:definition xml:lang="es">Roca volcánica de la familia de las lamproítas, con olivino normativo, pero sin leucita normativa</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock of the lamproite family, with normative olivine but without normative leucite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/framestone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">framestone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">framestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada construida por organismos que desarrollan armazones rígidos, como los corales</skos:definition>
    <skos:definition xml:lang="en">Carbonate rock built by organisms that develop rigid frameworks, such as corals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/framestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/framestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-piroclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito piroclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">tefra</skos:altLabel>
    <skos:definition xml:lang="es">Depósito formado, al menos en un 75% de su volumen, por piroclastos</skos:definition>
    <skos:definition xml:lang="en">Deposit formed, by at least 75% of its volume, by pyroclasts</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephra"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-muy-fina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena muy fina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">very fine sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que predominan los granos de diámetro comprendido entre 0.062 y 0.125 mm</skos:definition>
    <skos:definition xml:lang="en">Sand in which grains with a diameter between 0.062 and 0.125 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-calcarea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca calcárea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria detrítica con un contenido conjunto de elementos de tamaño arena y de carbonato cálcico igual o superior al 90% del total y en la que la relación de elementos de tamaño arena con respecto al carbonato está comprendida entre el 50 y el 90%</skos:definition>
    <skos:definition xml:lang="en">Detrital sedimentary rock with a combined content of sand-size elements and calcium carbonate equal to or exceeding 90% of the total, and in which the ratio of sand-size elements to carbonate is between 50 and 90%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/basalto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">basalto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basalt</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica, subalcalina o alcalina, generalmente de color negro, con textura microcristalina o porfídica, que contiene plagioclasa cálcica y piroxeno, normalmente augita, con o sin olivino, frecuentemente presenta magnetita o ilmenita accesorias y, más raramente, cuarzo o feldespatoides. se distingue de la andesita por la composición de la plagioclasa labradorita o más cálcica, la ausencia de anfíbol y su carácter melanocrático</skos:definition>
    <skos:definition xml:lang="en">Basic, subalkaline or alkaline volcanic rock, generally black, with microcrystalline or porphyritic texture, containing calcic plagioclase and pyroxene, normally augite, with or without olivine, frequently with accessory magnetite or ilmenite and, more rarely, quartz or feldspathoids. It is distinguished from andesite by the plagioclase composition (labradorite or more calcic), the absence of amphibole and its melanocratic character</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-carbonatados">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Carbonatados</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Carbonate Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Carbonatados, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos compuestos en más de un 50% por minerales carbonatados.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Carbonate Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments composed of more than 50% carbonate minerals.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-carbonatado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-carbonatado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-carbonatada"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutita-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutita arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica en la que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 10 y el 50% y la relación de elementos de tamaño arcilla a tamaño limo está comprendida entre 1:2 y 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital rock in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 10 and 50% and the ratio of clay-size to silt-size elements is between 1:2 and 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/riolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">riolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rhyolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica leucocrática, perteneciente a la familia de las rocas riolíticas, de textura fluidal, compuesta principalmente por cristales de cuarzo y feldespato alcalino, que constituye entre el 35 y el 90% de los feldespatos, con cantidades menores de biotita y plagioclasa, en una matriz vítrea o microcristalina, puede contener anfíbol y, en las variedades hiperalcalinas, piroxeno alcalino. su equivalente plutónico es el granito</skos:definition>
    <skos:definition xml:lang="en">Leucocratic volcanic rock belonging to the rhyolitic rock family, of fluidal texture, composed mainly of quartz and alkali feldspar crystals constituting between 35 and 90% of the feldspars, with lesser amounts of biotite and plagioclase, in a glassy or microcrystalline groundmass; may contain amphibole and, in hyperalkaline varieties, alkalic pyroxene. Its plutonic equivalent is granite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rhyolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-calcareo-pelitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento calcáreo pelítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelitic calcareous sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento calcáreo con un contenido pelítico comprendido entre el 10 y el 35% del total</skos:definition>
    <skos:definition xml:lang="en">Calcareous sediment with a pelitic content between 10 and 35% of the total</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSediment"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mud"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzoanortosita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzoanortosita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz anorthosite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas anortosíticas que contiene cuarzo en una cantidad superior al 5% de los minerales félsicos</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of anorthositic rocks, containing quartz in an amount exceeding 5% of the felsic minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzAnorthosite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_anorthosite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-ferruginoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito ferruginoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ferruginous deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">sedimento ferruginoso</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento compuesto en más de un 50% por minerales ferruginosos</skos:definition>
    <skos:definition xml:lang="en">Sediment composed of more than 50% ferruginous minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ironRichSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-leucocratica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca leucocrática</skos:prefLabel>
    <skos:prefLabel xml:lang="en">leucocratic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con un contenido en minerales oscuros inferior al 35% en volumen</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with a content of dark minerals below 35% by volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-bioconstruida">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza bioconstruida</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bioconstructed limestone</skos:prefLabel>
    <skos:altLabel xml:lang="es">boundstone</skos:altLabel>
    <skos:definition xml:lang="es">Caliza formada por la actividad vital de los organismos coloniales y atrapadores de partículas sedimentarias, según la clasificación de dunham 1962</skos:definition>
    <skos:definition xml:lang="en">Limestone formed by the vital activity of colonial and sediment-trapping organisms, according to the Dunham (1962) classification</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boundstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sienita-de-feldespato-alcalino-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sienita de feldespato alcalino con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar foid-bearing syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas sieníticas de feldespato alcalino, que contiene feldespatoides. es el equivalente intrusivo de la traquita de feldespato alcalino con foides</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of alkali feldspar syenitic rocks, containing feldspathoids. It is the intrusive equivalent of alkali feldspar foid-bearing trachyte</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAlkaliFeldsparSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_alkali_feldspar_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granito-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granito de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar granite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica leucocrática de la familia de los granitoides, en la que el feldespato alcalino constituye más del 90% del total de los feldespatos. es el equivalente plutónico de la riolita de feldespato alcalino</skos:definition>
    <skos:definition xml:lang="en">Leucocratic plutonic rock of the granitoid family, in which alkali feldspar constitutes more than 90% of the total feldspars. It is the plutonic equivalent of alkali feldspar rhyolite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparGranite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granulo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gránulo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granule</skos:prefLabel>
    <skos:definition xml:lang="es">Mineral detrítico o fragmento de roca de tamaño limo 0.004-0.062 mm</skos:definition>
    <skos:definition xml:lang="en">Detrital mineral or rock fragment of silt size (0.004-0.062 mm)</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-exotica-alcalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca exótica alcalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">exotic alkaline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea potásica máfica o ultramáfica, cuyo contenido en olivino frecuentemente serpentinizado en la kimberlita y flogopita es significativo. incluye la kimberlita, la lamproíta y el lamprófido</skos:definition>
    <skos:definition xml:lang="en">Mafic or ultramafic potassic igneous rock, whose olivine (frequently serpentinized in kimberlite) and phlogopite content is significant. Includes kimberlite, lamproite and lamprophyre</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-volcanica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca volcánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcanic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca efusiva, roca extrusiva</skos:altLabel>
    <skos:definition xml:lang="es">Roca ígnea producida por actividad volcánica, normalmente de grano muy fino o vítrea. con frecuencia puede contener fragmentos de otras rocas, así como fenocristales</skos:definition>
    <skos:definition xml:lang="en">Igneous rock produced by volcanic activity, normally very fine-grained or glassy. It may frequently contain fragments of other rocks as well as phenocrysts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fineGrainedIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fine_grained_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/basanita-fonolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">basanita fonolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolitic basanite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica perteneciente a la familia de las rocas tefríticas, en la que la plagioclasa constituye menos del 90% de los feldespatos, con olivino en proporción superior al 10% normativo. su equivalente plutónico es el monzogabro foídico</skos:definition>
    <skos:definition xml:lang="en">Basic volcanic rock belonging to the tephrite family, in which plagioclase constitutes less than 90% of the feldspars, with olivine in proportions exceeding 10% normative. Its plutonic equivalent is foid monzogabbro</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phonoliticBasanite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_basanite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/desecho">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">desecho</skos:prefLabel>
    <skos:prefLabel xml:lang="en">waste</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de subproductos sólidos de cualquier naturaleza, como residuos domésticos o industriales</skos:definition>
    <skos:definition xml:lang="en">Deposit of solid by-products of any nature, such as domestic or industrial waste</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/waste"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/foidolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">foidolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidolite</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca foidolítica</skos:altLabel>
    <skos:definition xml:lang="es">Roca plutónica cuyo contenido en feldespatoides es mayor del 60% del total de los minerales félsicos, con cantidades menores de feldespato alcalino, plagioclasa, anfíbol, clinopiroxeno y, ocasionalmente, olivino</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock whose feldspathoid content exceeds 60% of the total felsic minerals, with lesser amounts of alkali feldspar, plagioclase, amphibole, clinopyroxene and, occasionally, olivine</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/oleada-piroclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">oleada piroclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic surge</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito originado en una oleada piroclástica</skos:definition>
    <skos:definition xml:lang="en">Deposit originating from a pyroclastic surge</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-monzogabroica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca monzogabroica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzogabbroic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Gabroide mesocrato en el que la plagioclasa, predominantemente cálcica, constituye entre el 65 y el 90% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Mesocratic gabbroid in which plagioclase, predominantly calcic, constitutes between 65 and 90% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzogabbroicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzogabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-silicea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria silícea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">siliceous sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta en más de un 50% por sílice de origen biogénico o químico. se excluyen las rocas detríticas</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock composed of more than 50% silica of biogenic or chemical origin. Detrital rocks are excluded</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ulexita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ulexita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ulexite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula nacab5o9.8h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema triclínico bajo forma globular, con aspecto externo de bolas de algodón y estructura interna fibrosa. es incoloro o blanco, tiene brillo sedoso y varía de transparente a translúcido</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula NaCaB5O9·8H2O, belonging to the class of borates, crystallizing in the triclinic system in globular form with a cotton-ball external appearance and fibrous internal structure. It is colourless or white, with silky lustre and varying from transparent to translucent</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/latita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">latita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">latite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica intermedia, alcalina, perteneciente al grupo de las rocas latíticas, con fenocristales de feldespato alcalino y plagioclasa en proporciones similares, en una matriz microcristalina o vítrea, puede contener cuarzo, en proporción inferior al 5% de los minerales félsicos. es la variedad potásica de la traquiandesita. su equivalente plutónico es la monzonita</skos:definition>
    <skos:definition xml:lang="en">Intermediate, alkaline volcanic rock belonging to the latitic rock group, with alkali feldspar and plagioclase phenocrysts in similar proportions in a microcrystalline or glassy groundmass; may contain quartz in proportions below 5% of felsic minerals. It is the potassic variety of trachyandesite. Its plutonic equivalent is monzonite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-hibrido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito híbrido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hybrid deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">sedimento híbrido</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento integrado por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% del mismo, y que no puede incluirse en ninguna otra categoría de sedimento por su composición u origen</skos:definition>
    <skos:definition xml:lang="en">Sediment composed of three or more components, each of which constitutes between 5 and 50% of the total, and which cannot be included in any other sediment category by its composition or origin</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/greisen">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">greisen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">greisen</skos:prefLabel>
    <skos:definition xml:lang="es">Roca granítica alterada por fluidos pneumatolíticos, compuesta esencialmente por cuarzo y moscovita, a veces con topacio y turmalina. puede estar mineralizada, generalmente por casiterita</skos:definition>
    <skos:definition xml:lang="en">Granitic rock altered by pneumatolytic fluids, composed essentially of quartz and muscovite, sometimes with topaz and tourmaline. It may be mineralized, generally by cassiterite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ceniza-gruesa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ceniza gruesa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coarse ash</skos:prefLabel>
    <skos:definition xml:lang="es">1. piroclasto de tamaño de grano comprendido entre 1/16 mm y 2 mm. 2. depósito piroclástico formado en más de un 75% de su volumen por fragmentos de diámetro comprendido entre 1/16 y 2 mm</skos:definition>
    <skos:definition xml:lang="en">1. Pyroclast with a grain size between 1/16 mm and 2 mm. 2. Pyroclastic deposit formed by more than 75% by volume of fragments with a diameter between 1/16 and 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metagrauvaca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metagrauvaca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metagraywacke</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una grauvaca</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a greywacke</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/packstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">packstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">packstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada grano-soportada, con matriz micrítica entre los granos, según la clasificación de dunham 1962</skos:definition>
    <skos:definition xml:lang="en">Grain-supported carbonate rock, with micritic matrix between the grains, according to the Dunham (1962) classification</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/packstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/packstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-de-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales de Falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Fault Materials</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Materiales de Falla, que se caracteriza por incluir materiales formados como resultado de la deformación en una zona de falla.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Fault Materials, characterized by including materials formed as a result of deformation in a fault zone.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/blastomilonita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/brecha-de-falla"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/cataclasita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/filonita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/harina-de-falla"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-de-falla-no-cohesivo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/milonita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/protocataclasita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/protomilonita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/pseudotaquilita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-cataclastica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-milonitica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/ultracataclasita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/ultramilonita"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-oncolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza oncolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oncolitic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza formada mayoritariamente por oncolitos cementados, parcial o totalmente, por carbonato cálcico</skos:definition>
    <skos:definition xml:lang="en">Limestone formed predominantly by oncoids cemented, partially or totally, by calcium carbonate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fergusita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fergusita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fergussite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica de la familia de las foidolitas, compuesta por cantidades similares de leucita y clinopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock of the foidolite family, composed of similar amounts of leucite and clinopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pelesparita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pelesparita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelsparite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica esparítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides inferior a 1:3</skos:definition>
    <skos:definition xml:lang="en">Sparitic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio below 1:3</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/evaporita-exotica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">evaporita exótica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">exotic evaporite</skos:prefLabel>
    <skos:definition xml:lang="es">Evaporita que no contiene un porcentaje superior al 50% de halita, ni de yeso o anhidrita</skos:definition>
    <skos:definition xml:lang="en">bsarokita</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticEvaporite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzolatita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzolatita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz latite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente al grupo de las rocas latíticas, que contiene cuarzo en una cantidad superior al 5% de los minerales félsicos. su equivalente plutónico es la cuarzomonzonita</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the group of latitic rocks, containing quartz in an amount exceeding 5% of the felsic minerals. Its plutonic equivalent is quartz monzonite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzLatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_latite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-calcareo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material sedimentario calcáreo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario carbonatado con una proporción entre calcita más aragonito y dolomita mayor que 1</skos:definition>
    <skos:definition xml:lang="en">Carbonate sedimentary material with a ratio of calcite plus aragonite to dolomite greater than 1</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-sublitarenitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena sublitarenítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sublithoarenitic sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que entre el 75 y el 95% de los granos son de cuarzo y el contenido de fragmentos de otras rocas es mayor que el de feldespatos</skos:definition>
    <skos:definition xml:lang="en">Sand in which between 75 and 95% of the grains are quartz and the rock fragment content is greater than that of feldspars</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/espesartita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">espesartita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spessartite</skos:prefLabel>
    <skos:definition xml:lang="es">Lamprófido calcoalcalino rico en anfíbol y plagioclasa</skos:definition>
    <skos:definition xml:lang="en">Calc-alkaline lamprophyre rich in amphibole and plagioclase</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sienita-foidica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sienita foídica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica leucocrática perteneciente al grupo de los sienitoides foídicos, en la que el feldespato alcalino constituye más del 90% de los feldespatos y cuyo contenido en feldespatoides está comprendido entre el 10 y el 60% de los minerales félsicos. es el equivalente intrusivo de la fonolita</skos:definition>
    <skos:definition xml:lang="en">Leucocratic plutonic rock belonging to the group of foid syenitoids, in which alkali feldspar constitutes more than 90% of the feldspars and whose feldspathoid content is between 10 and 60% of the felsic minerals. It is the intrusive equivalent of phonolite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/jaspe">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">jaspe</skos:prefLabel>
    <skos:prefLabel xml:lang="en">jasper</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria silícea constituida por una variedad de calcedonia granuda. conforma agregados masivos generalmente opacos, muy raramente translúcidos, de color amarillo, rojo, verde o pardo por inclusiones de clorita, hematites y óxidos de hierro</skos:definition>
    <skos:definition xml:lang="en">Siliceous sedimentary rock consisting of a granular variety of chalcedony. It forms generally opaque, very rarely translucent, massive aggregates of yellow, red, green or brown colour due to inclusions of chlorite, haematite and iron oxides</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/evaporita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">evaporita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">evaporite</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento o roca sedimentaria formado por precipitación química de sales no carbonatadas, principalmente por sulfatos, cloruros y boratos</skos:definition>
    <skos:definition xml:lang="en">Sediment or sedimentary rock formed by chemical precipitation of non-carbonate salts, mainly sulfates, chlorides and borates</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grano">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grano</skos:prefLabel>
    <skos:prefLabel xml:lang="en">grain</skos:prefLabel>
    <skos:definition xml:lang="es">Mineral detrítico o fragmento de roca de tamaño arena 0.062-2 mm</skos:definition>
    <skos:definition xml:lang="en">Detrital mineral or rock fragment of sand size (0.062-2 mm)</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metasedimento">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metasedimento</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metasediment</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca paraderivada</skos:altLabel>
    <skos:definition xml:lang="es">Roca metamórfica cuyo protolito es una roca sedimentaria</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock whose protolith is a sedimentary rock</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-biogenica-silicea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca biogénica silícea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biogenic siliceous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta, al menos en un 50%, por material mineral silíceo sedimentado como resultado de procesos biológicos</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock composed of at least 50% siliceous mineral material deposited as a result of biological processes</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSilicaSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/biogenic_silica_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bentonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bentonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bentonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca arcillosa plástica, de color claro, compuesta principalmente por montmorillonita silicato alumínico hidratado y minerales del grupo de las esmectitas, generada normalmente por alteración de cenizas volcánicas</skos:definition>
    <skos:definition xml:lang="en">Plastic claystone, light-coloured, composed mainly of montmorillonite (hydrated aluminium silicate) and minerals of the smectite group, normally generated by alteration of volcanic ashes</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/claystone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/claystone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-traquitica-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca traquítica de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar trachytic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica leucocrática, intermedia o ácida, alcalina, perteneciente al grupo de los traquitoides, cuyo componente principal es el feldespato alcalino, que constituye más del 90% de los feldespatos, en una matriz microcristalina, frecuentemente con textura traquítica. su equivalente plutónico es la roca sienítica de feldespato alcalino</skos:definition>
    <skos:definition xml:lang="en">Leucocratic, intermediate or acid, alkaline volcanic rock belonging to the group of trachytoids, whose principal component is alkali feldspar, constituting more than 90% of the feldspars, in a microcrystalline groundmass, frequently with trachytic texture. Its plutonic equivalent is alkali feldspar syenitic rock</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparTrachyticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachytic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/norita-olivinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">norita olivínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine norite</skos:prefLabel>
    <skos:definition xml:lang="es">Norita con un contenido de olivino superior al 5%</skos:definition>
    <skos:definition xml:lang="en">Norite with an olivine content exceeding 5%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/urtita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">urtita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">urtite</skos:prefLabel>
    <skos:definition xml:lang="es">Foidolita leucocrática compuesta esencialmente por nefelina</skos:definition>
    <skos:definition xml:lang="en">Leucocratic foidolite composed essentially of nepheline</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzodiorita-foidica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzodiorita foídica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic monzodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas dioríticas foídicas, en la que la plagioclasa constituye menos del 90% de los feldespatos. es el equivalente intrusivo de la tefrita fonolítica</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of foidic dioritic rocks, in which plagioclase constitutes less than 90% of the feldspars. It is the intrusive equivalent of phonolitic tephrite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidMonzodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_monzodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzodiorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzodiorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz diorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas dioríticas, que contiene cuarzo en una cantidad comprendida entre el 5 y el 20% de los minerales félsicos</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of dioritic rocks, containing quartz in an amount between 5 and 20% of the felsic minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzDiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_diorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">sedimento</skos:altLabel>
    <skos:definition xml:lang="es">Producto natural, en forma de roca no consolidada, que resulta de la precipitación química o de la acumulación, bien sea mediante arrastre o gravitatoria, de partículas procedentes de la descomposición de otras rocas</skos:definition>
    <skos:definition xml:lang="en">Natural product, in the form of unconsolidated rock, resulting from chemical precipitation or from the accumulation, either by transport or gravitational settling, of particles derived from the decomposition of other rocks</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzarenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzarenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz arenite</skos:prefLabel>
    <skos:altLabel xml:lang="es">ortocuarcita</skos:altLabel>
    <skos:definition xml:lang="es">Arenita en la que más del 95% de los granos son de cuarzo</skos:definition>
    <skos:definition xml:lang="en">Arenite in which more than 95% of the grains are quartz</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-intrusiva">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca intrusiva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intrusive rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca plutónica</skos:altLabel>
    <skos:definition xml:lang="es">Roca ígnea solidificada en el interior de la corteza terrestre, a partir de un magma silicatado. las rocas plutónicas son generalmente de grano medio-grueso, aunque pueden tener facies de grano fino relacionadas</skos:definition>
    <skos:definition xml:lang="en">Igneous rock solidified in the interior of the Earth's crust from a silicate magma. Plutonic rocks are generally medium- to coarse-grained, although they may have related fine-grained facies</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phaneriticIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-melilitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca melilítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">melilitic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">melilitoide</skos:altLabel>
    <skos:definition xml:lang="es">Roca ígnea ultrabásica y ultraalcalina que tiene como minerales esenciales melilita en proporción superior al 10%, piroxeno y, con frecuencia, olivino y nefelina. en facies plutónicas recibe el nombre de melilitolita y en facies volcánicas, el de melilitita si la melilita es más abundante que los feldespatoides, en caso contrario, se denomina foidita con melilita</skos:definition>
    <skos:definition xml:lang="en">Ultrabasic, ultraalkaline igneous rock having melilite in proportions exceeding 10%, pyroxene and, frequently, olivine and nepheline as essential minerals. In plutonic facies it is called melilitolite and in volcanic facies, melilitite if melilite is more abundant than the feldspathoids; otherwise it is called melilite-bearing foidite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/rodingita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">rodingita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rodingite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de silicatos cálcicos asociada con serpentinitas, de grano fino y color blanco, verde o rosa, producida por metasomatismo de rocas plutónicas máficas asociadas a complejos ultramáficos. su asociación mineralógica característica está integrada por grosularia, diópsido, epidota, escapolita, vesubianita y óxidos de hierro</skos:definition>
    <skos:definition xml:lang="en">Calc-silicate rock associated with serpentinites, fine-grained and white, green or pink in colour, produced by metasomatism of mafic plutonic rocks associated with ultramafic complexes. Its characteristic mineral assemblage includes grossular, diopside, epidote, scapolite, vesuvianite and iron oxides</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-hibridos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Sedimentarias y Sedimentos Híbridos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Hybrid Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Sedimentarias y Sedimentos Híbridos, que se caracteriza por incluir rocas integradas por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% de la misma, y que no pueden incluirse en ninguna otra categoría de roca por su composición u origen.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Hybrid Sedimentary Rocks and Sediments, characterized by including rocks composed of three or more components, each of which constitutes between 5 and 50% of the rock, and which cannot be included in any other rock category by their composition or origin.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/diamictita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/diamicton"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/tilloide"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granito-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granito alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkaline granite</skos:prefLabel>
    <skos:definition xml:lang="es">Granito metaluminoso o ligeramente peraluminoso, con valores de al2o3/na2o+k2o en proporciones molares próximos a 1 y algo empobrecidos en ca. contiene abundante feldespato alcalino feldespato potásico. como minerales varietales, además de biotita, puede presentar egirina piroxeno sódico y/o riebeckita anfíbol sódico</skos:definition>
    <skos:definition xml:lang="en">Metaluminous or slightly peraluminous granite, with Al2O3/Na2O+K2O values in molar proportions close to 1 and slightly depleted in Ca. It contains abundant alkali feldspar (potassic feldspar). As varietal minerals, in addition to biotite, it may present aegirine (sodic pyroxene) and/or riebeckite (sodic amphibole)</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/missourita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">missourita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">missourite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica de la familia de las foidolitas, más melanocrática que la fergusita, compuesta por un 70-90% de augita egirínica o egirina y el resto, leucita</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock of the foidolite family, more melanocratic than fergussite, composed of 70-90% aegirine-augite or aegirine and the rest leucite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arcosa-litica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arcosa lítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithic arkose</skos:prefLabel>
    <skos:definition xml:lang="es">Arcosa cuya relación entre feldespatos y fragmentos de otras rocas no supera 3:1</skos:definition>
    <skos:definition xml:lang="en">Arkose in which the ratio of feldspars to rock fragments does not exceed 3:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metacinerita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metacinerita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metacinerite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una cinerita</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a cinerite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-poligenico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material poligénico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polygenetic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material, con un estado de consolidación no especificado, generado por modificación geológica de materiales preexistentes fuera del ámbito de los procesos ígneos y sedimentarios. incluye los materiales metamórficos y los productos de alteración desarrollados en la superficie terrestre</skos:definition>
    <skos:definition xml:lang="en">Material, with an unspecified state of consolidation, generated by geological modification of pre-existing materials outside the scope of igneous and sedimentary processes. Includes metamorphic materials and alteration products developed at the Earth's surface</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/diamicton">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">diamictón</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diamicton</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico no consolidado y mal clasificado que contiene clastos de un amplio rango de tamaños, desde partículas hasta bloques</skos:definition>
    <skos:definition xml:lang="en">Unconsolidated, poorly sorted detrital sediment containing clasts of a wide size range, from particles to boulders</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/diamicton"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/diamicton"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-ferruginosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria ferruginosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ferruginous sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta en más de un 50% por minerales ferruginosos</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock composed of more than 50% ferruginous minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ironRichSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica-foidica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sienítica foídica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic syenitic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">sienitoide foídico</skos:altLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de las rocas de tipo sienita y monzosienita foídicas</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of foidic syenite and monzosyenite type rocks</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidSyenitoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_syenitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida por elementos muy finos, de menos de 0.062 mm. contiene menos de un 10% de carbonatos</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of very fine elements, less than 0.062 mm. Contains less than 10% carbonates</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/silicateMudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/silicate_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bitumen">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bitumen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bitumen</skos:prefLabel>
    <skos:definition xml:lang="es">Hidrocarburo natural sólido o semisólido, de color negro o pardo oscuro, inflamable. incluye a los asfaltos, las ceras resinosas y los productos afines</skos:definition>
    <skos:definition xml:lang="en">Solid or semi-solid, black or dark brown, flammable natural hydrocarbon. Includes asphalts, resinous waxes and related products</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/bitumen"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida, en más de un 50%, por elementos detríticos de diámetro comprendido entre 0.062 y 2 mm y trabados por un cemento o una matriz detrítica fina</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of more than 50% detrital elements with a diameter between 0.062 and 2 mm, bound by a cement or fine detrital matrix</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-dacitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca dacítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dacitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica ácida, subalcalina o alcalina, cuyos componentes principales son el cuarzo, que constituye entre el 20 y el 60% de los minerales félsicos, y la plagioclasa, que constituye más del 65% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Acid, subalkaline or alkaline volcanic rock whose principal components are quartz, constituting between 20 and 60% of the felsic minerals, and plagioclase, constituting more than 65% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dacite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dacite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ignimbrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ignimbrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ignimbrite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca originada por flujo piroclástico de fragmentos de pumita de tamaño bomba o lapilli, y fragmentos líticos subordinados, inmersos en una matriz de fragmentos de vidrio, líticos y cristales de tamaño ceniza. durante la compactación los fragmentos juveniles de pumita se aplastan y adquieren formas lenticulares denominadas fiames fiamme</skos:definition>
    <skos:definition xml:lang="en">Rock originating from a pyroclastic flow of bomb- or lapilli-sized pumice fragments, and subordinate lithic fragments, immersed in a groundmass of glass fragments, lithics and ash-sized crystals. During compaction, juvenile pumice fragments are flattened and acquire lenticular shapes called fiamme</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dioritoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dioritoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dioritoid</skos:prefLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de rocas plutónicas de tipo diorita o monzodiorita</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of plutonic rocks of diorite or monzodiorite type</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dioritoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dioritoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefrita-fonolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefrita fonolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolitic tephrite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica, perteneciente a la familia de las rocas tefríticas, en la que la plagioclasa constituye menos del 90% de los feldespatos, puede contener olivino en proporción inferior al 10% normativo. su equivalente plutónico es la monzodiorita foídica</skos:definition>
    <skos:definition xml:lang="en">Basic volcanic rock belonging to the tephrite family, in which plagioclase constitutes less than 90% of the feldspars; may contain olivine in proportions below 10% normative. Its plutonic equivalent is foid monzodiorite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phonoliticTephrite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_tephrite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/oomicrudita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">oomicrudita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oomicrudite</skos:prefLabel>
    <skos:definition xml:lang="es">Oomicrita en la que más del 25% de los aloquímicos tienen un diámetro superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Oomicrite in which more than 25% of the allochems have a diameter exceeding 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/espiculita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">espiculita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spiculite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca silícea, generalmente con una porosidad del 50-90%, formada principalmente por espículas de esponjas</skos:definition>
    <skos:definition xml:lang="en">Siliceous rock, generally with 50-90% porosity, formed mainly by sponge spicules</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/siliceousOoze"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-piroclastico-epiclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material piroclástico-epiclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic-epiclastic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material de carácter mixto constituido tanto por fragmentos de origen piroclástico como de origen epiclástico, ambos en un porcentaje comprendido entre el 25 y el 75% del volumen del depósito</skos:definition>
    <skos:definition xml:lang="en">Material of mixed character consisting of both pyroclastic and epiclastic fragments, each in a percentage between 25 and 75% of the deposit volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzomonzogabro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzomonzogabro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz monzogabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas monzogabroicas, que contiene cuarzo en una cantidad comprendida entre el 5 y el 20% de los minerales félsicos</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of monzogabbroic rocks, containing quartz in an amount between 5 and 20% of the felsic minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzMonzogabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_monzogabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefra-de-bombas-y-bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefra de bombas y bloques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bomb and block tephra</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito piroclástico cuyo contenido en fragmentos de diámetro superior a 64 mm está comprendido entre el 25 y el 75% del volumen de los piroclastos</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic deposit whose content of fragments with a diameter exceeding 64 mm is between 25 and 75% of the pyroclast volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashBrecciaBombOrBlockTephra"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/intraesparrudita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">intraesparrudita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intrasparrudite</skos:prefLabel>
    <skos:definition xml:lang="es">Intraesparita en la que más del 25% de los aloquímicos tienen un diámetro superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Intrasparite in which more than 25% of the allochems have a diameter exceeding 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gneis-glandular">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gneis glandular</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glandular gneiss</skos:prefLabel>
    <skos:altLabel xml:lang="es">augen gneiss</skos:altLabel>
    <skos:definition xml:lang="es">Gneis con grandes porfidoblastos elípticos o lenticulares de feldespato potásico</skos:definition>
    <skos:definition xml:lang="en">Gneiss with large elliptical or lenticular porphyroblasts of potassic feldspar</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gneiss"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gneiss"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-riolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca riolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rhyolitic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">riolitoide</skos:altLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de rocas volcánicas ácidas similares a la riolita, subalcalinas o alcalinas, cuyos componentes principales son el cuarzo, que constituye entre el 20 y el 60% de los minerales félsicos, y los feldespatos, de entre los que el feldespato alcalino supone al menos el 35%</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of acid volcanic rocks similar to rhyolite, subalkaline or alkaline, whose principal components are quartz, constituting between 20 and 60% of the felsic minerals, and feldspars, of which alkali feldspar accounts for at least 35%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolitoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rhyolitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefritoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefritoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephritoid</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca tefrítica</skos:altLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de rocas volcánicas ultrabásicas o básicas, fuertemente alcalinas, compuestas esencialmente por feldespatos, de los que la plagioclasa constituye más del 50%, y feldespatoides, que constituyen entre el 10% y el 60% de los minerales félsicos, contienen cantidades menores de minerales ferromagnesianos, como piroxeno, anfíbol y, en ocasiones, olivino</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of ultrabasic or basic, strongly alkaline volcanic rocks, composed essentially of feldspars, of which plagioclase constitutes more than 50%, and feldspathoids, constituting between 10% and 60% of the felsic minerals, containing lesser amounts of ferromagnesian minerals, such as pyroxene, amphibole and, occasionally, olivine</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephritoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephritoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzogranito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzogranito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzogranite</skos:prefLabel>
    <skos:altLabel xml:lang="es">adamellita</skos:altLabel>
    <skos:definition xml:lang="es">Variedad del granito en la que el feldespato alcalino constituye entre el 35 y el 65% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Variety of granite in which alkali feldspar constitutes between 35 and 65% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzogranite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzogranite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-salica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sálica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">salic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea que tiene más sílice y silicatos alumínicos que silicatos ferromagnesianos y cálcicos</skos:definition>
    <skos:definition xml:lang="en">Igneous rock that has more silica and aluminosilicates than ferromagnesian and calcic silicates</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-cataclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca cataclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cataclastic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de falla cohesiva, sin foliación tectónica o con un desarrollo pobre de ella y constituida por porfiroclastos, habitualmente angulosos, y fragmentos de roca embebidos en una matriz de composición similar, producida por deformación frágil con reducción del tamaño de grano cristalino y ligeramente recristalizada. algunos autores proponen que el contenido en matriz debe ser superior al 30%</skos:definition>
    <skos:definition xml:lang="en">Cohesive fault rock, without tectonic foliation or with poorly developed foliation, consisting of porphyroclasts, usually angular, and rock fragments embedded in a matrix of similar composition, produced by brittle deformation with crystal grain size reduction and slightly recrystallized. Some authors propose that the matrix content should exceed 30%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-metamorficas-en-funcion-del-protolito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Metamórficas en Función del Protolito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Metamorphic Rocks According To Protolith</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Metamórficas en Función del Protolito, que se caracteriza por incluir rocas derivadas de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales en estado sólido, clasificadas según la naturaleza de la roca original (protolito) a partir de la cual se formaron.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Metamorphic Rocks by Protolith, characterized by including rocks derived from a pre-existing rock, through mineralogical, chemical or structural changes in solid state, classified according to the nature of the original rock (protolith) from which they were formed.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metabasalto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metabasita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metabrecha"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metacaliza"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metacarbonato"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metachert"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metacinerita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metaconglomerado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metadacita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metadiabasa"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metadiorita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metadolerita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metafonolita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metagabro"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metagranito"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metagrauvaca"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metahornblendita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metandesita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metapelita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metaperidotita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metapiroxenita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metarcosa"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metarenisca"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metarenita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metarriolita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metasedimento"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metasienita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metatoba"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metatraquita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metaultrabasita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metavolcanita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/ortoanfibolita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/ortogneis"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/paraanfibolita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/paragneis"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-metaignea"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ambar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ámbar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">amber</skos:prefLabel>
    <skos:definition xml:lang="es">Roca o mineral amorfo de origen orgánico, translúcido, de color amarillo o pardo y brillo resinoso, resultante de la polimerización espontánea de la resina de coníferas fósiles. puede contener fósiles, principalmente insectos, bien conservados</skos:definition>
    <skos:definition xml:lang="en">Amorphous mineral of organic origin, translucent, yellow or brown in colour and with resinous lustre, resulting from the spontaneous polymerization of the resin of fossil conifers. It may contain fossils, mainly insects, well preserved</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bafflestone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bafflestone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bafflestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada originada por organismos asociados durante la sedimentación, en grupos separados, que dan lugar a una pantalla que atrapa material fino</skos:definition>
    <skos:definition xml:lang="en">Carbonate rock produced by organisms associated during sedimentation in separate groups, creating a baffle that traps fine material</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boundstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutita-bituminosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutita bituminosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bituminous shale</skos:prefLabel>
    <skos:altLabel xml:lang="es">pizarra bituminosa</skos:altLabel>
    <skos:definition xml:lang="es">Roca sedimentaria de grano fino con impregnaciones oleosas o bituminosas de las que, por destilación o mediante disolventes, pueden obtenerse hidrocarburos líquidos o gaseosos</skos:definition>
    <skos:definition xml:lang="en">Fine-grained sedimentary rock with oily or bituminous impregnations from which liquid or gaseous hydrocarbons can be obtained by distillation or using solvents</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/polihalita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">polihalita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polyhalite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula k2mgca2so44.2h2o, perteneciente a la clase de los sulfatos, que cristaliza en el sistema triclínico y se presenta en masas lamelares compactas. posee color rosa o rojo</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula K2MgCa2(SO4)4·2H2O, belonging to the class of sulfates, crystallizing in the triclinic system and occurring as compact lamellar masses. It has a pink or red colour</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-granitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca granítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granitic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">granitoide</skos:altLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de rocas plutónicas que tienen como minerales esenciales cuarzo, feldespato alcalino y/o plagioclasa, tentativamente identificadas como granito, granodiorita y tonalita</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of plutonic rocks whose essential minerals are quartz, alkali feldspar and/or plagioclase, tentatively identified as granite, granodiorite and tonalite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granitoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-detriticos-rocas-sedimentarias-y-sedimentos-carbonatados">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Sedimentarias y Sedimentos Detríticos / Rocas Sedimentarias y Sedimentos Carbonatados</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Detrital Sedimentary Rocks And Sediments / Carbonate Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría mixta de Rocas Sedimentarias Detríticas y Carbonatadas, que se caracteriza por incluir rocas y sedimentos con componentes tanto detríticos (compuestos en más de un 50% por fragmentos de rocas preexistentes) como carbonatados (compuestos en más de un 50% por minerales carbonatados), representando mezclas o transiciones entre ambos tipos.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the mixed category of Detrital and Carbonate Sedimentary Rocks, characterized by including rocks and sediments with both detrital components (composed of more than 50% fragments from pre-existing rocks) and carbonate components (composed of more than 50% carbonate minerals), representing mixtures or transitions between both types.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/calcarenita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/calcilimolita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/calcilutita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/calcirrudita"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/canto-pequeño">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">canto pequeño</skos:prefLabel>
    <skos:prefLabel xml:lang="en">small cobble</skos:prefLabel>
    <skos:definition xml:lang="es">Canto de tamaño comprendido entre 2 y 4 mm</skos:definition>
    <skos:definition xml:lang="en">Clast with a size between 2 and 4 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/charnoquita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">charnoquita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar charnockite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca perteneciente a la familia de las rocas charnoquíticas, equivalente a un granito de feldespato alcalino con ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Rock belonging to the charnockitic rock family, equivalent to an alkali feldspar granite with orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-pelitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca pelítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelitic sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica en la que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 50 y el 90% y la relación de elementos de tamaño arcilla a tamaño limo está comprendida entre 2:1 y 1:2</skos:definition>
    <skos:definition xml:lang="en">Detrital rock in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 50 and 90% and the clay-to-silt ratio is between 2:1 and 1:2</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grainstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grainstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">grainstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada constituida fundamentalmente por granos, sin matriz micrítica, según la clasificación de dunham 1962</skos:definition>
    <skos:definition xml:lang="en">Carbonate rock consisting fundamentally of grains, without micritic matrix, according to the Dunham (1962) classification</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/grainstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/grainstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/absarokita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">absarokita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">absarokite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca basáltica compuesta por fenocristales de olivino y clinopiroxeno en una matriz de plagioclasa cálcica labradorita, feldespato alcalino sanidina, olivino y, ocasionalmente, leucita. es similar a la shoshonita, pero sin fenocristales de plagioclasa</skos:definition>
    <skos:definition xml:lang="en">Basaltic rock composed of olivine and clinopyroxene phenocrysts in a matrix of calcic plagioclase (labradorite), alkali feldspar (sanidine), olivine and, occasionally, leucite. It is similar to shoshonite but lacks plagioclase phenocrysts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/akerita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">akerita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">akerite</skos:prefLabel>
    <skos:definition xml:lang="es">Microsienita o micromonzonita rica en ortosa y oligoclasa, que puede contener cantidades notables de biotita y clinopiroxeno, generalmente augita egirínica, así como cuarzo en cantidades accesorias</skos:definition>
    <skos:definition xml:lang="en">Microsyenite or micromonzonite rich in orthoclase and oligoclase, which may contain notable amounts of biotite and clinopyroxene, generally aegirine-augite, as well as accessory quartz</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/syenite"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzonite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzonite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/limburgita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">limburgita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">limburgite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca basáltica en la que no aparece ningún mineral fundamental leucocrático, en cuyo lugar hay vidrio. químicamente, equivale a basalto, basanita o nefelinita olivínica</skos:definition>
    <skos:definition xml:lang="en">Basaltic rock in which no fundamental leucocratic mineral appears, replaced by glass. Chemically, it is equivalent to basalt, basanite or olivine nephelinite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-poligenica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca poligénica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polygenetic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por modificación geológica de rocas preexistentes al margen de los procesos ígneos y sedimentarios. incluye las rocas metamórficas y las generadas en procesos de alteración desarrollados en la superficie terrestre</skos:definition>
    <skos:definition xml:lang="en">Rock formed by geological modification of pre-existing rocks outside of igneous and sedimentary processes. Includes metamorphic rocks and those generated in alteration processes developed at the Earth's surface</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/paragneis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">paragneis</skos:prefLabel>
    <skos:prefLabel xml:lang="en">paragneiss</skos:prefLabel>
    <skos:definition xml:lang="es">Gneis cuyo protolito es una roca sedimentaria</skos:definition>
    <skos:definition xml:lang="en">Gneiss whose protolith is a sedimentary rock</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/paragneiss"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/paragneiss"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dismicrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dismicrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dismicrite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza micrítica en la que la micrita ha sido parcialmente transformada a esparita</skos:definition>
    <skos:definition xml:lang="en">Micritic limestone in which the micrite has been partially transformed to sparite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granito-peralcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granito peralcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peralkaline granite</skos:prefLabel>
    <skos:definition xml:lang="es">Granito metaluminoso y con relaciones al2o3/na2o+k2o en proporciones molares inferiores a 1. como minerales varietales contiene biotita y piroxenos o anfíboles sódicos egirina, arfvedsonita y riebeckita</skos:definition>
    <skos:definition xml:lang="en">Metaluminous granite with Al2O3/Na2O+K2O ratios in molar proportions less than 1. As varietal minerals it contains biotite and sodic pyroxenes or amphiboles (aegirine, arfvedsonite and riebeckite)</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-epiclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito epiclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">epiclastic deposit</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito volcanoclástico que contiene fragmentos de origen volcánico con evidencias de haber sido transportados por algún medio sedimentario</skos:definition>
    <skos:definition xml:lang="en">Volcaniclastic deposit containing volcanic fragments showing evidence of having been transported by some sedimentary medium</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephra"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/minette">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">minette</skos:prefLabel>
    <skos:prefLabel xml:lang="en">minette</skos:prefLabel>
    <skos:definition xml:lang="es">Lamprófido calcoalcalino con biotita y feldespato potásico como minerales dominantes</skos:definition>
    <skos:definition xml:lang="en">Calc-alkaline lamprophyre with biotite and potassic feldspar as dominant minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/protocataclasita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">protocataclasita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">protocataclasitee</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cataclástica cuya matriz constituye menos del 50% del volumen de la roca</skos:definition>
    <skos:definition xml:lang="en">Cataclastic rock whose matrix constitutes less than 50% of the rock volume</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/hornblendita-olivino-piroxenica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">hornblendita olivino-piroxénica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine-pyroxene hornblendite</skos:prefLabel>
    <skos:definition xml:lang="es">Hornblendita con olivino y piroxeno en cantidades superiores al 5%.</skos:definition>
    <skos:definition xml:lang="en">Hornblendite with olivine and pyroxene in amounts exceeding 5%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hornblendite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hornblendite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/oceanita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">oceanita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oceanite</skos:prefLabel>
    <skos:definition xml:lang="es">Basalto picrítico en el que son muy abundantes los fenocristales de olivino</skos:definition>
    <skos:definition xml:lang="en">Picritic basalt in which olivine phenocrysts are very abundant</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/anhidrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">anhidrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anhydrite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula caso4, perteneciente a la clase de los sulfatos, que cristaliza en el sistema rómbico, formando, generalmente, agregados masivos o fibrosos. es incoloro o de color blanco, gris o a veces azulado, tiene brillo de vítreo a nacarado y varía de transparente a opaco</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula CaSO4, belonging to the class of sulfates, crystallizing in the orthorhombic system, generally forming massive or fibrous aggregates. It is colourless or white, grey or sometimes bluish, with vitreous to pearly lustre and varying from transparent to opaque</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gypsumOrAnhydrite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rock_gypsum_or_anhydrite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-intrusiva">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha intrusiva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intrusive breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Brecha formada por fragmentos angulosos de una roca ígnea, englobados por otra roca ígnea de diferente composición. se produce por fracturación hidráulica o magmática durante el proceso de intrusión</skos:definition>
    <skos:definition xml:lang="en">Breccia formed by angular fragments of an igneous rock enclosed within another igneous rock of different composition. It is produced by hydraulic or magmatic fracturing during the intrusion process</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/desdolomita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">desdolomita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">desdolomite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza formada a partir de una dolomía, por efecto de la desdolomitización</skos:definition>
    <skos:definition xml:lang="en">Limestone formed from a dolomite by the effect of dedolomitization</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pirigarnita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pirigarnita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyrigarnet</skos:prefLabel>
    <skos:definition xml:lang="es">Granulita cuya paragénesis característica incluye granate y cordierita</skos:definition>
    <skos:definition xml:lang="en">Granulite whose characteristic paragenesis includes garnet and cordierite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/intramicrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">intramicrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intramicrite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica micrítica en la que más del 25% de los aloquímicos corresponden a intraclastos</skos:definition>
    <skos:definition xml:lang="en">Micritic allochemical limestone in which more than 25% of the allochems correspond to intraclasts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-impura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza impura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca calcárea en la que el contenido conjunto de calcita y dolomita no sobrepasa el 90% del total y el de dolomita es inferior al 10%</skos:definition>
    <skos:definition xml:lang="en">Calcareous rock in which the combined content of calcite and dolomite does not exceed 90% of the total and the dolomite content is below 10%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureLimestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sienitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sienítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">syenitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Sienitoide de color blanquecino a rosado o rojo, en el que el feldespato alcalino constituye entre el 65 y el 90% de los feldespatos, con cantidades subordinadas de plagioclasa, clinopiroxeno, biotita, hornblenda y cuarzo o nefelina. es el equivalente intrusivo de la roca traquítica</skos:definition>
    <skos:definition xml:lang="en">Whitish to pink or red syenitoid, in which alkali feldspar constitutes between 65 and 90% of the feldspars, with subordinate amounts of plagioclase, clinopyroxene, biotite, hornblende and quartz or nepheline. It is the intrusive equivalent of trachytic rock</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/syeniticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/hornblendita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">hornblendita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hornblendite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica ultramáfica compuesta esencialmente por hornblenda con piroxenos, espinela y olivino, éste en cantidad inferior al 40% de los minerales máficos, puede contener cantidades menores de plagioclasa, granate y flogopita. en un sentido más estricto, roca plutónica ultramáfica, compuesta en más de un 90% por hornblenda</skos:definition>
    <skos:definition xml:lang="en">Ultramafic plutonic rock composed essentially of hornblende with pyroxenes, spinel and olivine, the latter in an amount below 40% of the mafic minerals; may contain lesser amounts of plagioclase, garnet and phlogopite. In a stricter sense, an ultramafic plutonic rock composed of more than 90% hornblende</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hornblendite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hornblendite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/marmol">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">mármol</skos:prefLabel>
    <skos:prefLabel xml:lang="en">marble</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica formada en más del 50 % por carbonatos calcita, aragonito, dolomita, generalmente de textura granoblástica y estructura masiva, derivada de calizas y dolomías. el mármol puro contiene más del 95% de carbonatos. cuando es impuro 50-95% de carbonatos contiene otros minerales, que pueden ser muy variados anfíbol y clinopiroxeno cálcicos, epidota, grosularia, olivino, talco, clorita, micas, etc..</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock formed by more than 50% carbonates (calcite, aragonite, dolomite), generally of granoblastic texture and massive structure, derived from limestones and dolomites. Pure marble contains more than 95% carbonates. When impure (50-95% carbonates) it contains other minerals, which may be very varied (calcic amphibole and clinopyroxene, epidote, grossular, olivine, talc, chlorite, micas, etc.)</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/marble"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/marble"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-siliceo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito silíceo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">siliceous deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">sedimento silíceo</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento compuesto en más de un 50% por sílice de origen biogénico o químico. se excluyen los sedimentos detríticos</skos:definition>
    <skos:definition xml:lang="en">Sediment composed of more than 50% silica of biogenic or chemical origin. Detrital sediments are excluded</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/enderbita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">enderbita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">enderbite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca perteneciente a la familia de las rocas charnoquíticas, equivalente a una tonalita con ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Rock belonging to the charnockitic rock family, equivalent to a tonalite with orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-basico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material básico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material ígneo cuyo contenido en sílice está comprendido entre el 45 y el 52%</skos:definition>
    <skos:definition xml:lang="en">Igneous material whose silica content is between 45 and 52%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basicIgneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basic_igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/camptonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">camptonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">camptonite</skos:prefLabel>
    <skos:definition xml:lang="es">Lamprófido alcalino rico en olivino, anfíbol, augita titanada, biotita y plagioclasa</skos:definition>
    <skos:definition xml:lang="en">Alkaline lamprophyre rich in olivine, titanium augite, amphibole, biotite and plagioclase</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/toba-de-lapilli-y-ceniza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">toba de lapilli y ceniza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lapilli and ash tuff</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica en la que los fragmentos de tamaño inferior a 64 mm constituyen más del 75% en volumen de los piroclastos, pero ni los fragmentos de lapilli ni los de ceniza superan el 75% del volumen</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock in which fragments smaller than 64 mm constitute more than 75% by volume of the pyroclasts, but neither the lapilli nor the ash fragments exceed 75% of the volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente al grupo de las rocas traquíticas, blanquecina o gris, formada esencialmente por feldespato alcalino y frecuentemente con textura traquítica, puede contener cuarzo, en proporción inferior al 5% de los minerales félsicos. su equivalente plutónico es la sienita</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the group of trachytic rocks, whitish or grey, formed essentially by alkali feldspar and frequently with trachytic texture; may contain quartz in proportions below 5% of the felsic minerals. Its plutonic equivalent is syenite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/trachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tempestita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tempestita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tempestite</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento o roca sedimentaria que presentan rasgos de haber sido bruscamente alterados por la acción erosiva, seguida del redepósito, de olas de tormentas</skos:definition>
    <skos:definition xml:lang="en">Sediment or sedimentary rock showing evidence of having been abruptly altered by the erosive action, followed by redeposition, of storm waves</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sapropel">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sapropel</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sapropel</skos:prefLabel>
    <skos:definition xml:lang="es">Fango orgánico subacuático, lacustre o marino, depositado en fondos de aguas anóxicas y estratificadas, formado por lutita negra con restos abundantes de materia orgánica macerada, asociados a bacterias anaerobias productoras de ácido sulfhídrico, en un medio reductor. suele presentar una laminación paralela</skos:definition>
    <skos:definition xml:lang="en">Subaqueous, lacustrine or marine organic mud deposited in anoxic, stratified waters, formed by black mudstone with abundant macerated organic matter associated with anaerobic bacteria producing hydrogen sulfide, in a reducing medium. It usually presents parallel lamination</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sapropel"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sapropel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-lamproitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca lamproítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lamproitic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">lamproíta</skos:altLabel>
    <skos:definition xml:lang="es">Roca basáltica a basanítica de composición ultrapotásica. su mineralogía varía considerablemente, siendo frecuente la presencia de flogopita, olivino, diópsido, richterita, sanidina y leucita, los dos últimos sólo en la matriz, también puede contener minerales potásicos muy poco frecuentes como ti-k-richterita, priderita, wadeíta y gepita</skos:definition>
    <skos:definition xml:lang="en">Basaltic to basanitic rock of ultrapotassic composition. Its mineralogy varies considerably; phlogopite, olivine, diopside, richterite, sanidine and leucite (the latter two only in the groundmass) are frequent; it may also contain very uncommon potassic minerals such as Ti-K-richterite, priderite, wadeite and gepite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carbon-de-la-serie-humica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carbón de la serie húmica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">humic series coal</skos:prefLabel>
    <skos:definition xml:lang="es">Carbón, consolidado o no, formado a partir de materia orgánica vegetal. presenta un bandeado correspondiente a distintas acumulaciones de restos de plantas superpuestas en el tiempo</skos:definition>
    <skos:definition xml:lang="en">Consolidated or unconsolidated coal, formed from plant organic matter. It exhibits banding corresponding to different accumulations of plant remains superimposed in time</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/coal"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/peridotita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">peridotita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peridotite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca holocristalina ultramáfica, compuesta en más de un 40% por olivino, además de clinopiroxeno, ortopiroxeno y espinela, en proporciones variables, puede contener cantidades menores de plagioclasa, granate, anfíbol y flogopita</skos:definition>
    <skos:definition xml:lang="en">Holocrystalline ultramafic rock composed of more than 40% olivine, in addition to clinopyroxene, orthopyroxene and spinel in variable proportions; may contain lesser amounts of plagioclase, garnet, amphibole and phlogopite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peridotite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/basanita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">basanita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basanite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica o ultrabásica perteneciente a la familia de las rocas tefríticas, de color negro y textura generalmente porfídica con fenocristales de plagioclasa que constituyen más del 90% de los feldespatos, clinopiroxeno, feldespatoides y olivino en proporción superior al 10% normativo, generalmente en una matriz microcristalina. su equivalente plutónico es el gabro foídico</skos:definition>
    <skos:definition xml:lang="en">Basic or ultrabasic volcanic rock belonging to the tephrite family, black and generally porphyritic with plagioclase phenocrysts constituting more than 90% of the feldspars, clinopyroxene, feldspathoids and olivine in proportions exceeding 10% normative, generally in a microcrystalline groundmass. Its plutonic equivalent is foid gabbro</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basanite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basanite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzodiorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzodiorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de los dioritoides, que contiene cuarzo en una cantidad que no supera el 5% de los minerales félsicos y que además de plagioclasa contiene feldespato alcalino en cantidades comprendidas entre el 10 y el 35% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of dioritoids, containing quartz in an amount not exceeding 5% of the felsic minerals, and which in addition to plagioclase contains alkali feldspar in amounts between 10 and 35% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-pelitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena pelítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelitic sand</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico en el que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y de ellos, el contenido de granos de arena está comprendido entre el 50 y el 90% y la relación de arcilla a limo está comprendida entre 2:1 y 1:2</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 50 and 90% and the clay-to-silt ratio is between 2:1 and 1:2</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monchiquita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monchiquita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monchiquite</skos:prefLabel>
    <skos:definition xml:lang="es">Lamprófido alcalino similar a la camptonita, pero sin plagioclasa y con vidrio o feldespatoides</skos:definition>
    <skos:definition xml:lang="en">Alkaline lamprophyre similar to camptonite, but lacking plagioclase and with glass or feldspathoids</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-igneo-fragmentario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material ígneo fragmentario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fragmental igneous material</skos:prefLabel>
    <skos:definition xml:lang="es">Material formado en más del 75% por fragmentos resultantes de un proceso ígneo, independientemente de su grado de consolidación. incluye los materiales piroclásticos y las brechas intrusivas y volcánicas</skos:definition>
    <skos:definition xml:lang="en">Material formed more than 75% by fragments resulting from an igneous process, regardless of its degree of consolidation. Includes pyroclastic materials and intrusive and volcanic breccias</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dropstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dropstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dropstone</skos:prefLabel>
    <skos:definition xml:lang="es">Clasto de tamaño variable transportado por una plataforma de hielo o un iceberg y depositado en un medio acuso, marino o lacustre, al derretirse el hielo</skos:definition>
    <skos:definition xml:lang="en">Variable-size clast transported by an ice sheet or iceberg and deposited in an aqueous, marine or lacustrine environment when the ice melts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boulderGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boulder_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-aloquimica-micritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza aloquímica micrítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micritic allochemical limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica con un contenido de micrita mayor que el de esparita</skos:definition>
    <skos:definition xml:lang="en">Allochemical limestone with a micrite content greater than that of sparite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-microcristalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca microcristalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">microcrystalline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea que tiene cristales identificables al microscopio</skos:definition>
    <skos:definition xml:lang="en">Igneous rock that has crystals identifiable under the microscope</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fineGrainedIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fine_grained_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomia-calcarea-impura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomía calcárea impura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure calcareous dolomite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca dolomítica con un contenido superior al 10% tanto de calcita como de impurezas</skos:definition>
    <skos:definition xml:lang="en">Dolomitic rock with a content exceeding 10% of both calcite and impurities</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureDolomite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/intramicrudita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">intramicrudita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intramicrudite</skos:prefLabel>
    <skos:definition xml:lang="es">Intramicrita en la que más del 25% de los aloquímicos tienen un diámetro superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Intramicrite in which more than 25% of the allochems have a diameter exceeding 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefra-de-lapilli-y-ceniza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefra de lapilli y ceniza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lapilli and ash tephra</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito piroclástico en el que los fragmentos de tamaño inferior a 64 mm constituyen más del 75% en volumen de los piroclastos, pero ni los fragmentos de lapilli ni los de ceniza superan el 75% del volumen</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic deposit in which fragments smaller than 64 mm constitute more than 75% by volume of the pyroclasts, but neither the lapilli nor the ash fragments exceed 75% of the volume</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashAndLapilli"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_and_lapilli"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">arenite</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca en la que el contenido de matriz detrítica fina es inferior al 15% del total de la roca</skos:definition>
    <skos:definition xml:lang="en">Arenite in which the content of fine detrital matrix is below 15% of the total rock</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomicrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomicrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomicrite</skos:prefLabel>
    <skos:definition xml:lang="es">Dolomía microcristalina primaria, con menos del 10% de aloquímicos</skos:definition>
    <skos:definition xml:lang="en">Primary microcrystalline dolomite, with less than 10% allochems</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cumulado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cumulado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cumulate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca derivada de la cristalización, separación por gravedad y acumulación de cristales, a partir de un magma silicatado generalmente de composición máfica o intermedia</skos:definition>
    <skos:definition xml:lang="en">Rock derived from the crystallization, gravitational separation and accumulation of crystals from a silicate magma generally of mafic or intermediate composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phaneriticIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-subalcalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca subalcalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subalkaline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Término utilizado para las rocas ígneas que no son de naturaleza alcalina. las series magmáticas subalcalinas incluyen las rocas calcoalcalinas, o ricas en aluminio, y toleíticas, o pobres en potasio</skos:definition>
    <skos:definition xml:lang="en">Term used for igneous rocks that are not of alkaline nature. Subalkaline magmatic series include calc-alkaline, or aluminium-rich rocks, and tholeiitic, or potassium-poor rocks</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-fonolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca fonolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolitic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">fonolitoide</skos:altLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de rocas volcánicas básicas o intermedias, fuertemente alcalinas, compuestas esencialmente por feldespatos, de los que el feldespato alcalino constituye más del 50%, y feldespatoides, que constituyen entre el 10% y el 60% de los minerales félsicos, contienen cantidades menores de minerales ferromagnesianos, como piroxeno y, en ocasiones, anfíbol</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of basic or intermediate, strongly alkaline volcanic rocks, composed essentially of feldspars, of which alkali feldspar constitutes more than 50%, and feldspathoids, constituting between 10% and 60% of the felsic minerals, containing lesser amounts of ferromagnesian minerals, such as pyroxene and, occasionally, amphibole</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phonolitoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/aglutinado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">aglutinado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">agglutinate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica formada por piroclastos que se han depositado calientes y han quedado soldados, aplastados y deformados de manera plástica</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock formed by pyroclasts that have been deposited while still hot and have been welded, flattened and plastically deformed</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-mafica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca máfica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mafic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca con un contenido de minerales oscuros comprendido entre el 50 y el 90% en volumen</skos:definition>
    <skos:definition xml:lang="en">Rock with a dark mineral content between 50 and 90% by volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-dolomitico-impuro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento dolomítico impuro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure dolomitic sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento con un contenido de dolomita superior al de calcita más aragonito y en el que los minerales carbonatados constituyen entre el 50 y el 90% del total</skos:definition>
    <skos:definition xml:lang="en">Sediment with a dolomite content greater than that of calcite plus aragonite and in which carbonate minerals constitute between 50 and 90% of the total</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureDolomiticSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_dolomitic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/diorita-foidica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">diorita foídica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic diorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas dioríticas foídicas, en la que la plagioclasa constituye más del 90% de los feldespatos. es el equivalente intrusivo de la tefrita</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of foidic dioritic rocks, in which plagioclase constitutes more than 90% of the feldspars. It is the intrusive equivalent of tephrite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidDiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_diorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/colada-piroclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">colada piroclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic flow</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito originado por un flujo denso de material volcánico producido en una erupción volcánica y constituido esencialmente por fragmentos calientes de vidrio volcánico, pómez, fragmentos de rocas y gas, que se desplaza rasante sobre la ladera de un volcán y tiende a acumularse en las zonas más bajas del mismo</skos:definition>
    <skos:definition xml:lang="en">Deposit originating from a dense flow of volcanic material produced in a volcanic eruption, consisting essentially of hot fragments of volcanic glass, pumice, rock fragments and gas, which moves along the slopes of a volcano and tends to accumulate in the lowest areas</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/azabache">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">azabache</skos:prefLabel>
    <skos:prefLabel xml:lang="en">jet</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad del lignito, negra y brillante</skos:definition>
    <skos:definition xml:lang="en">Black and shiny variety of lignite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/lignite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/lignite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fonolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fonolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica intermedia perteneciente a la familia de las rocas fonolíticas, en la que el feldespato alcalino constituye más del 90% de los feldespatos. su equivalente plutónico es la sienita foídica</skos:definition>
    <skos:definition xml:lang="en">Intermediate volcanic rock belonging to the phonolitic rock family, in which alkali feldspar constitutes more than 90% of the feldspars. Its plutonic equivalent is foid syenite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phonolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolilte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metadacita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metadacita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metadacite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición dacítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of dacitic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-tobacea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena tobácea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuffaceous sand</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito mixto piroclástico-epiclástico formado en más de un 75% de su volumen por fragmentos de diámetro comprendido entre 1/16 mm y 2 mm</skos:definition>
    <skos:definition xml:lang="en">Mixed pyroclastic-epiclastic deposit formed by more than 75% by volume of fragments with a diameter between 1/16 mm and 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/melilitita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">melilitita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">melilitite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica ultrabásica y ultraalcalina del grupo de los melilitoides que tiene como minerales esenciales melilita en proporción superior al 10%, piroxeno y, con frecuencia, olivino y nefelina</skos:definition>
    <skos:definition xml:lang="en">Ultrabasic, ultraalkaline volcanic rock of the melilitoid group having melilite in proportions exceeding 10%, pyroxene and, frequently, olivine and nepheline as essential minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-carbonatada-pura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria carbonatada pura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure carbonate sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta en más de un 90% por minerales carbonatados</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock composed of more than 90% carbonate minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pureCarbonateSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_carbonate_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sanaita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sanaíta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sannaite</skos:prefLabel>
    <skos:definition xml:lang="es">Lamprófido alcalino con fenocristales de olivino, augita titanada, anfíbol y biotita, con feldespato alcalino dominante sobre plagioclasa en la matriz</skos:definition>
    <skos:definition xml:lang="en">Alkaline lamprophyre with phenocrysts of olivine, titanium augite, amphibole and biotite, with alkali feldspar dominating over plagioclase in the groundmass</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-clastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito clástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clastic deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">depósito detrítico, sedimento clástico, sedimento detrítico</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento compuesto en más de un 50% por fragmentos de otras rocas y minerales preexistentes</skos:definition>
    <skos:definition xml:lang="en">Sediment composed of more than 50% fragments from pre-existing rocks and minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ortogneis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ortogneis</skos:prefLabel>
    <skos:prefLabel xml:lang="en">orthogneiss</skos:prefLabel>
    <skos:definition xml:lang="es">Gneis cuyo protolito es una roca ígnea, generalmente plutónica</skos:definition>
    <skos:definition xml:lang="en">Gneiss whose protolith is an igneous rock, generally plutonic</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/orthogneiss"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/orthogneiss"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/escombro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">escombro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rubble</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación de materiales de tamaños distintos, originada por el derribo de edificios o el desmantelamiento de antiguos revestimientos de carreteras</skos:definition>
    <skos:definition xml:lang="en">Accumulation of materials of different sizes, originating from the demolition of buildings or the dismantling of old road surfaces</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/buildingRubble"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada en el exterior de la corteza terrestre mediante un proceso de sedimentación. presenta estructuras características, como, principalmente, la estratificación</skos:definition>
    <skos:definition xml:lang="en">Rock formed outside the Earth's crust by a sedimentary process. It exhibits characteristic structures, primarily stratification</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzosienita-nefelinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzosienita nefelínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nepheline monzosyenite</skos:prefLabel>
    <skos:definition xml:lang="es">Monzosienita foídica en la que la nefelina constituye el feldespatoide dominante</skos:definition>
    <skos:definition xml:lang="en">Foid monzosyenite in which nepheline constitutes the dominant feldspathoid</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidMonzosyenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_monzosyenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tufita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca piroclástica-epiclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuffite</skos:prefLabel>
    <skos:altLabel xml:lang="es">tufita</skos:altLabel>
    <skos:definition xml:lang="es">Roca de carácter mixto constituida tanto por fragmentos de origen piroclástico como de origen epiclástico, ambos en un porcentaje comprendido entre el 25 y el 75% del volumen de la roca</skos:definition>
    <skos:definition xml:lang="en">Rock of mixed character consisting of both pyroclastic and epiclastic fragments, each in a percentage between 25 and 75% of the rock volume</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tuffite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tuffite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-piroclastico-de-caida">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito piroclástico de caída</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic fall deposit</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito piroclástico originado por la caída individualizada de piroclastos, transportados siguiendo trayectorias balísticas o mediante la dispersión horizontal de las columna eruptiva y depositados como una lluvia</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic fall deposit originated by the individual fall of pyroclasts, transported along ballistic trajectories or through the horizontal dispersal of the eruptive column and deposited as a rain</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephra"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzogabro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzogabro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz gabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas gabroicas, que contiene cuarzo en una cantidad comprendida entre el 5 y el 20% de los minerales félsicos</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of gabbroic rocks, containing quartz in an amount between 5 and 20% of the felsic minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzGabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-carbonatado-impuro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento carbonatado impuro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure carbonate sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito con un contenido de minerales carbonatados comprendido entre el 50 y el 90%</skos:definition>
    <skos:definition xml:lang="en">Deposit with a carbonate mineral content between 50 and 90%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/nefelinolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">nefelinolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nephelinolite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad de foidolita en la que el feldespatoide es nefelina</skos:definition>
    <skos:definition xml:lang="en">Variety of foidolite in which the feldspathoid is nepheline</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/jotunita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">jotunita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">jotunite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca perteneciente a la familia de las rocas charnoquíticas, equivalente a una monzodiorita con ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Rock belonging to the charnockitic rock family, equivalent to a monzodiorite with orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-volcano-sedimentaria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca volcano-sedimentaria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcano-sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca en cuya formación se reconoce la participación de procesos volcánicos y sedimentarios</skos:definition>
    <skos:definition xml:lang="en">Rock in whose formation the participation of both volcanic and sedimentary processes is recognized</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/olistostroma">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">olistostroma</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olistostrome</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación, más o menos caótica, de materiales de muy diversa granulometría, desde bloques a lutitas, consolidado o no, que se ha emplazado gravitatoriamente en una cuenca sedimentaria</skos:definition>
    <skos:definition xml:lang="en">More or less chaotic accumulation of materials of very diverse grain size, from boulders to mudstones, consolidated or unconsolidated, emplaced gravitationally in a sedimentary basin</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fango-carbonatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fango carbonatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate mud</skos:prefLabel>
    <skos:definition xml:lang="es">Fango constituido, en más del 50%, por restos de esqueletos carbonatados</skos:definition>
    <skos:definition xml:lang="en">Mud consisting of more than 50% carbonate skeletal remains</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateOoze"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida en un 30-50% por clastos angulosos de más de 2 mm de diámetro y con un contenido de elementos de tamaño arena mayor que el de elementos de tamaño pelita</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of 30-50% angular clasts with a diameter exceeding 2 mm and with a sand-size element content greater than that of pelite-size elements</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/mariupolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">mariupolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mariupolite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad de sienita nefelínica carente de feldespato potásico</skos:definition>
    <skos:definition xml:lang="en">Variety of nepheline syenite lacking potassic feldspar</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingSyenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metarriolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metarriolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metarhyolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición riolítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of rhyolitic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carbonato-cristalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carbonato cristalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">crystalline carbonate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada de mineralogía indeterminada en la cual los procesos diagenéticos han destruido la textura deposicional original</skos:definition>
    <skos:definition xml:lang="en">Carbonate rock of indeterminate mineralogy in which diagenetic processes have destroyed the original depositional texture</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/crystallineCarbonate"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/crystalline_carbonate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/diatexita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">diatexita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diatexite</skos:prefLabel>
    <skos:definition xml:lang="es">Migmatita formada casi exclusivamente por neosoma, con escaso o ningún mesosoma</skos:definition>
    <skos:definition xml:lang="en">Migmatite formed almost exclusively by neosome, with little or no mesosome</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/migmatite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/migmatite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-arrecifal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza arrecifal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reef limestone</skos:prefLabel>
    <skos:altLabel xml:lang="es">biohermo, caliza biohérmica, caliza recifal</skos:altLabel>
    <skos:definition xml:lang="es">Caliza formada por organismos constructores de arrecifes, generalmente corales, que permanecen frecuentemente en posición de vida</skos:definition>
    <skos:definition xml:lang="en">Limestone formed by reef-building organisms, generally corals, which frequently remain in life position</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boundstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/molasa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">molasa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">molasse</skos:prefLabel>
    <skos:definition xml:lang="es">Tectofacies constituida por rocas detríticas que pueden alcanzar grandes espesores hasta de algunos miles de metros. con frecuencia presenta secuencias granodecrecientes que se inician con conglomerados. se deposita en las áreas subsidentes adyacentes a los nuevos relieves montañosos, inmediatamente después del plegamiento</skos:definition>
    <skos:definition xml:lang="en">Tectofacies consisting of detrital rocks that can reach great thicknesses of up to several thousands of metres. It frequently presents fining-upward sequences starting with conglomerates. It is deposited in the subsiding areas adjacent to new mountain reliefs, immediately after folding</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-arcosica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena arcósica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">arkosic sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que la proporción de granos de cuarzo es inferior al 75% y el contenido de granos de feldespatos es mayor que el de fragmentos de otras rocas</skos:definition>
    <skos:definition xml:lang="en">Sand in which the proportion of quartz grains is below 75% and the feldspar grain content is greater than that of rock fragments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/petroleo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">petróleo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">petroleum</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario constituido por hidrocarburos y formado a partir de la descomposición anaerobia de la materia orgánica. en condiciones normales de presión y temperatura se presenta fundamentalmente líquido petróleo crudo y gaseoso gas natural, aunque a veces, por oxidación, es sólido asfalto</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material consisting of hydrocarbons and formed from the anaerobic decomposition of organic matter. Under normal pressure and temperature conditions it occurs primarily as liquid (crude oil) and gas (natural gas), though it may sometimes, by oxidation, be solid (asphalt)</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSedimentaryMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metasienita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metasienita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metasyenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición sienítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of syenitic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/antracita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">antracita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anthracite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad de carbón dura, negra, con brillo semimetálico y fractura semiconcoidea, que arde con dificultad y quema sin humo. su contenido en carbono es mayor del 90% y el de volátiles, menor del 14%</skos:definition>
    <skos:definition xml:lang="en">Hard, black coal variety with semi-metallic lustre and semi-conchoidal fracture, which burns with difficulty and without smoke. Its carbon content exceeds 90% and the volatile matter content is below 14%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anthraciteCoal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthracite_coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-muy-gruesa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena muy gruesa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">very coarse sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que predominan los granos de diámetro comprendido entre 1.0 y 2.0 mm</skos:definition>
    <skos:definition xml:lang="en">Sand in which grains with a diameter between 1.0 and 2.0 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzosienita-foidica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzosienita foídica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic monzosyenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente a la familia de los sienitoides foídicos, en la que el feldespato alcalino constituye menos del 90% de los feldespatos. es el equivalente intrusivo de la fonolita tefrítica</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the family of foid syenitoids, in which alkali feldspar constitutes less than 90% of the feldspars. It is the intrusive equivalent of tephritic phonolite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidMonzosyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_monzosyenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granofido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granófido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granophyre</skos:prefLabel>
    <skos:definition xml:lang="es">Roca félsica de apariencia porfídica con una matriz compuesta de intercrecimientos gráficos de cuarzo y feldespato alcalino</skos:definition>
    <skos:definition xml:lang="en">Felsic rock of porphyritic appearance with a groundmass composed of graphic intergrowths of quartz and alkali feldspar</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ritmita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ritmita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rhythmite</skos:prefLabel>
    <skos:definition xml:lang="es">Facies constituida por la alternancia repetida de estratos de dos tipos de rocas diferentes</skos:definition>
    <skos:definition xml:lang="en">Facies consisting of repeated alternations of strata of two different rock types</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/yesoarenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">yesoarenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gypsarenite</skos:prefLabel>
    <skos:altLabel xml:lang="es">gypsarenita</skos:altLabel>
    <skos:definition xml:lang="es">Arenita constituida por granos de yeso</skos:definition>
    <skos:definition xml:lang="en">Arenite consisting of gypsum grains</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-microcristalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza microcristalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">microcrystalline limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza constituida esencialmente por elementos ortoquímicos microcristalinos, con una proporción de aloquímicos inferior al 10% del total de la roca</skos:definition>
    <skos:definition xml:lang="en">Limestone consisting essentially of microcrystalline orthochemical elements, with an allochem proportion below 10% of the total rock</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomia-con-intraclastos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomía con intraclastos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomite with intraclasts</skos:prefLabel>
    <skos:definition xml:lang="es">Dolomía en la que se reconocen fantasmas de aloquímicos, de entre los que predominan los intraclastos</skos:definition>
    <skos:definition xml:lang="en">Dolostone in which ghosts of allochems are recognized, among which intraclasts predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/relleno">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">relleno</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fill</skos:prefLabel>
    <skos:definition xml:lang="es">Materiales térreos que se usan principalmente para mejorar, nivelar o elevar la superficie del terreno</skos:definition>
    <skos:definition xml:lang="en">Earthy materials used mainly to improve, level or raise the ground surface</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicUnconsolidatedMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_unconsolidated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-materiales-igneos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Grandes Grupos de Materiales / Materiales Ígneos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Major Material Groups / Igneous Material</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Materiales Ígneos, que se caracteriza por representar el nivel superior de clasificación que agrupa todos los materiales resultantes del enfriamiento y la solidificación de un magma, tanto volcánicos como plutónicos.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the hierarchical category of Major Material Groups / Igneous Materials, characterized by representing the top-level classification that groups all materials resulting from the cooling and solidification of a magma, both volcanic and plutonic.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-igneo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-ignea"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutita-s.l.">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutita s.l.</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mudstone s.l.</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria constituida por menos de un 30% de fragmentos de diámetro superior a 2 mm y cuya relación entre las partículas de lutita y los granos de arena es mayor que 1. los fragmentos pueden ser de cualquier composición y origen</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock consisting of less than 30% fragments with a diameter exceeding 2 mm and whose ratio of mud particles to sand grains is greater than 1. The fragments may be of any composition and origin</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/genericMudstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/generic_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grauvaca-litica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grauvaca lítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithic graywacke</skos:prefLabel>
    <skos:definition xml:lang="es">Grauvaca en la que la proporción de cuarzo es inferior al 95% de los granos y el contenido de fragmentos de otras rocas es mayor que el de feldespatos</skos:definition>
    <skos:definition xml:lang="en">Greywacke in which the proportion of quartz is below 95% of the grains and the rock fragment content is greater than that of feldspars</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/wacke"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/wacke"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-de-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha de falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fault breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de falla sin foliación tectónica o con un desarrollo pobre de ella, constituida en más de un 30% por porfiroclastos, habitualmente angulosos, y fragmentos de roca, embebidos en una matriz de composición similar producida por deformación frágil con reducción del tamaño de grano cristalino y ligeramente recristalizada</skos:definition>
    <skos:definition xml:lang="en">Fault rock without tectonic foliation or with poorly developed foliation, consisting of more than 30% of porphyroclasts, usually angular, and rock fragments, embedded in a matrix of similar composition produced by brittle deformation with crystal grain size reduction and slightly recrystallized</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia-gougeSeries"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia_gouge_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/aplita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">aplita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">aplite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea de composición granítica, color claro y grano fino, con textura aplítica o sacaroidea, a veces asociada a pegmatitas. puede aparecer como diques o como pequeños stocks dentro de los plutones graníticos</skos:definition>
    <skos:definition xml:lang="en">Igneous rock of granitic composition, light-coloured and fine-grained, with aplitic or saccharoidal texture, sometimes associated with pegmatites. It may appear as dykes or small stocks within granitic plutons</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/aplite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/aplite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/charnoquita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">charnoquita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">charnockite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca perteneciente a la familia de las rocas charnoquíticas, equivalente a un granito con ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Rock belonging to the charnockitic rock family, equivalent to a granite with orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava-s.l.">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava s.l.</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gravel s.l.</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento constituido en más de un 30% por fragmentos de tamaño grava &gt;2 mm de diámetro, sin especificar su composición o su génesis</skos:definition>
    <skos:definition xml:lang="en">Sediment consisting of more than 30% gravel-size fragments (&gt;2 mm diameter), without specifying composition or genesis</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gravelSizeSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/melteigita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">melteigita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">melteigite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica de la familia de las foidolitas, más melanocrática que la ijolita, compuesta por un 70-90% de augita egirínica o egirina y el resto, nefelina</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock of the foidolite family, more melanocratic than ijolite, composed of 70-90% aegirine-augite or aegirine and the rest nepheline</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metarenisca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metarenisca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metasandstone</skos:prefLabel>
    <skos:altLabel xml:lang="es">metapsamita, metasamita</skos:altLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una arenisca</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a sandstone</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzonita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzonita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid-bearing monzonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas monzoníticas, que contiene feldespatoides. es el equivalente intrusivo de la latita con foides</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of monzonitic rocks, containing feldspathoids. It is the intrusive equivalent of foid-bearing latite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingMonzonite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzonite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/esquisto-micaceo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">esquisto micáceo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micaceous schist</skos:prefLabel>
    <skos:altLabel xml:lang="es">micacita, micaesquisto</skos:altLabel>
    <skos:definition xml:lang="es">Esquisto rico en mica, derivado de un protolito pelítico</skos:definition>
    <skos:definition xml:lang="en">Mica-rich schist derived from a pelitic protolith</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foliatedMetamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/micaSchist"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foliated_metamorphic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mica_schist"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/toba-de-ceniza-fina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">toba de ceniza fina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fine ash tuff</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica en la que los fragmentos de ceniza fina constituyen más del 75% en volumen del contenido piroclástico</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock in which fine ash fragments constitute more than 75% by volume of the pyroclastic content</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomía</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolostone</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca dolomítica</skos:altLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada cuyos constituyentes principales son la dolomita o carbonatos de composición parecida. La variedad pura tiene, al menos, un 95% de dolomita y las variedades impuras, más del 10% de calcita o de impurezas. Se origina por precipitación química dolomía primaria o, más frecuentemente, durante la diagénesis dolomía secundaria</skos:definition>
    <skos:definition xml:lang="en">Sedimentary carbonate rock whose principal constituents are dolomite or carbonates of similar composition. The pure variety has at least 95% dolomite and the impure varieties more than 10% calcite or impurities. It originates by chemical precipitation (primary dolomite) or, more frequently, during diagenesis (secondary dolomite)</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-coralina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza coralina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coral limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza organógena formada mayoritariamente por esqueletos de corales constructores de arrecifes</skos:definition>
    <skos:definition xml:lang="en">Organogenic limestone formed predominantly by skeletons of reef-building corals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boundstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada cuyo constituyente principal es el carbonato cálcico, de los componentes restantes, el más frecuente y dominante es el carbonato de magnesio, siendo accesorios los silicatos o los productos de su alteración como arcillas y sílice, así como la pirita y la siderita. La variedad pura tiene, al menos, un 95% de CaCO3 y las variedades impuras, más del 10% de dolomita o de impurezas. Su origen puede ser predominantemente biológico, químico o mixto</skos:definition>
    <skos:definition xml:lang="en">Sedimentary carbonate rock whose principal constituent is calcium carbonate; of the remaining components, magnesium carbonate is the most frequent and dominant, with silicates or their alteration products (clay and silica) as well as pyrite and siderite being accessory. The pure variety has at least 95% CaCO3 and the impure varieties more than 10% dolomite or impurities. Its origin may be predominantly biological, chemical or mixed</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-biogenica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca biogénica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biogenic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca producida por la acción o la presencia de organismos vivos o de sus restos</skos:definition>
    <skos:definition xml:lang="en">Rock produced by the action or presence of living organisms or their remains</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSilicaSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/biogenic_silica_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metabasalto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metabasalto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metabasalt</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición basáltica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of basaltic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-granoblastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca granoblástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granoblastic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">granoblastita, granofelsita</skos:altLabel>
    <skos:definition xml:lang="es">Roca metamórfica granuda, no foliada y masiva, de cualquier composición</skos:definition>
    <skos:definition xml:lang="en">Granular, non-foliated, massive metamorphic rock of any composition</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granofels"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granofels"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-limosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena limosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silty sand</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico en el que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 50 y el 90% y la relación de elementos de tamaño limo a tamaño arcilla es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 50 and 90% and the ratio of silt-size to clay-size elements exceeds 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-con-connotaciones-geneticas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos con Connotaciones Genéticas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Sedimentary Rocks And Sediments With Genetic Connotations</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos con Connotaciones Genéticas, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos clasificados según su proceso genético de formación.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Sedimentary Rocks and Sediments with Genetic Connotations, characterized by grouping, within sedimentary materials, those rocks and sediments classified according to their genetic formation process.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-biogenico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-biogenico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-biogenica"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/escoria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">escoria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slag</skos:prefLabel>
    <skos:definition xml:lang="es">Subproducto de la fundición y el procesado de metales</skos:definition>
    <skos:definition xml:lang="en">By-product of the smelting and processing of metals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/slag"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/kieserita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">kieserita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kieserite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula mgso4.h2o, perteneciente a la clase de los sulfatos, que cristaliza en el sistema monoclínico y se presenta en agregados granudos. es incoloro, blanco, gris o amarillento y presenta aspecto mate o brillo vítreo</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula MgSO4·H2O, belonging to the class of sulfates, crystallizing in the monoclinic system and occurring in granular aggregates. It is colourless, white, grey or yellowish and has a matt or vitreous lustre</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-faneritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca fanerítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phaneritic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea en la que los granos minerales se distinguen a simple vista</skos:definition>
    <skos:definition xml:lang="en">Igneous rock in which mineral grains are distinguishable with the naked eye</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phaneriticIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquita-de-feldespato-alcalino-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquita de feldespato alcalino con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar foid-bearing trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente al grupo de las rocas traquíticas de feldespato alcalino, que contiene feldespatoides. su equivalente plutónico es la sienita de feldespato alcalino con foides</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the group of alkali feldspar trachytic rocks, containing feldspathoids. Its plutonic equivalent is alkali feldspar foid-bearing syenite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAlkaliFeldsparTrachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_alkali_feldspar_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/micrita-con-intraclastos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">micrita con intraclastos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micrite with intraclasts</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza micrítica con aloquímicos, de entre los que predominan los intraclastos</skos:definition>
    <skos:definition xml:lang="en">Micritic limestone with allochems, among which intraclasts predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/protomilonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">protomilonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">protomylonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca milonítica cuya matriz constituye menos del 50% del volumen de la roca</skos:definition>
    <skos:definition xml:lang="en">Mylonitic rock whose matrix constitutes less than 50% of the rock volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pegmatita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pegmatita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pegmatite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de composición aproximadamente granítica, grano grueso o muy grueso, formada esencialmente por microclina, albita y cuarzo. como minerales varietales suele tener moscovita, turmalina, biotita y, más raramente, cordierita o granate. los cristales de cuarzo y ortosa aparecen formando intercrecimientos gráficos, con frecuencia perpendiculares a los contactos</skos:definition>
    <skos:definition xml:lang="en">Rock of approximately granitic composition, coarse- or very coarse-grained, formed essentially by microcline, albite and quartz. Muscovite, tourmaline, biotite and, more rarely, cordierite or garnet are common varietal minerals. Quartz and orthoclase crystals form graphic intergrowths, frequently perpendicular to contacts</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pegmatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pegmatite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/essexita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">essexita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">essexite</skos:prefLabel>
    <skos:definition xml:lang="es">Monzogabro o monzodiorita con nefelina</skos:definition>
    <skos:definition xml:lang="en">Monzogabbro or monzodiorite with nepheline</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingMonzogabbro"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingMonzodiorite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzogabbro"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/aglomerado-volcanico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">aglomerado volcánico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcanic agglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica formada en más de un 75% de su volumen por fragmentos de diámetro mayor de 64 mm, entre los que predominan las bombas volcánicas</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock formed by more than 75% by volume of fragments with a diameter greater than 64 mm, among which volcanic bombs predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tuffBrecciaAgglomerateOrPyroclasticBreccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tuff_breccia_agglomerate_or_pyroclastic_breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bindstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bindstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bindstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada originada por organismos ligados entre sí durante la sedimentación, por actividad de organismos encostrantes y envolventes</skos:definition>
    <skos:definition xml:lang="en">Carbonate rock produced by organisms bound together during sedimentation, by the activity of encrusting and enveloping organisms</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boundstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-dolomitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza dolomítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomitic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca calcárea en la que la calcita y la dolomita constituyen, conjuntamente, más del 90%, con un contenido de dolomita superior al 10% del total</skos:definition>
    <skos:definition xml:lang="en">Calcareous rock in which calcite and dolomite together constitute more than 90%, with a dolomite content exceeding 10% of the total</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureLimestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metagabro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metagabro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metagabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición gabroica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of gabbroic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/siliciclasto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">siliciclasto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">siliciclast</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento clástico silíceo, de cuarzo o de otros silicatos, presente en una roca sedimentaria</skos:definition>
    <skos:definition xml:lang="en">Siliceous clastic element, of quartz or other silicates, present in a sedimentary rock</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzograuvaca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzograuvaca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz graywacke</skos:prefLabel>
    <skos:definition xml:lang="es">Grauvaca en la que más del 95% de los granos son de cuarzo</skos:definition>
    <skos:definition xml:lang="en">Greywacke in which more than 95% of the grains are quartz</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/wacke"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/wacke"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/halita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">halita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">halite</skos:prefLabel>
    <skos:altLabel xml:lang="es">sal, sal gema</skos:altLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula nacl, perteneciente a la clase de los cloruros, que cristaliza en el sistema cúbico, frecuentemente en forma de cubos. es incoloro o blanco con diferentes tonalidades, tiene brillo vítreo, varía de transparente a translúcido y se caracteriza por su sabor salado</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula NaCl, belonging to the class of chlorides, crystallizing in the cubic system, frequently in the form of cubes. It is colourless or white with different shades, with vitreous lustre, varying from transparent to translucent and characterized by its salty taste</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/rockSalt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rock_salt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/benmoreita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">benmoreíta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">benmoreite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica alcalina de composición intermedia, variedad sódica de la traquiandesita</skos:definition>
    <skos:definition xml:lang="en">Alkaline intermediate volcanic rock of intermediate composition, sodic variety of trachyandesite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/andesite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutita-margosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutita margosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">marly mudstone</skos:prefLabel>
    <skos:altLabel xml:lang="es">lutita calcárea</skos:altLabel>
    <skos:definition xml:lang="es">Roca sedimentaria detrítica con un contenido conjunto de elementos de tamaño pelita y de carbonato cálcico igual o superior al 90% del total y en la que la relación de elementos de tamaño lutita con respecto al carbonato está comprendida entre el 65 y el 90%</skos:definition>
    <skos:definition xml:lang="en">Detrital sedimentary rock with a combined content of pelite-size elements and calcium carbonate equal to or exceeding 90% of the total, and in which the ratio of mudstone-size elements to carbonate is between 65 and 90%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/leucitita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">leucitita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">leucitite</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca leucítica</skos:altLabel>
    <skos:definition xml:lang="es">Roca volcánica ultrabásica, ultraalcalina, de color oscuro, perteneciente a la familia de las rocas foídicas, que tiene como minerales esenciales leucita, piroxeno y, en algunos tipos, olivino. es frecuente, además, la presencia de nefelina</skos:definition>
    <skos:definition xml:lang="en">Ultrabasic, ultraalkaline, dark-coloured volcanic rock belonging to the foidite family, having leucite, pyroxene and, in some types, olivine as essential minerals. The presence of nepheline is also frequent</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticCompositionIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_composition_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquiandesita-basaltica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquiandesita basáltica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basaltic trachyandesite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica o intermedia, alcalina, con plagioclasa cálcica y piroxeno como minerales principales. la variedad sódica recibe el nombre de mugearita y la potásica, de shoshonita</skos:definition>
    <skos:definition xml:lang="en">Basic or intermediate, alkaline volcanic rock, with calcic plagioclase and pyroxene as principal minerals. The sodic variety is called mugearite and the potassic variety, shoshonite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/andesite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefra-de-bombas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefra de bombas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bomb tephra</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito piroclástico formado en más de un 75% de su volumen por fragmentos de diámetro mayor de 64 mm, entre los que predominan las bombas volcánicas</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic deposit formed by more than 75% by volume of fragments with a diameter greater than 64 mm, among which volcanic bombs predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashBrecciaBombOrBlockTephra"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bauxita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bauxita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bauxite</skos:prefLabel>
    <skos:altLabel xml:lang="es">laterita alumínica</skos:altLabel>
    <skos:definition xml:lang="es">Duricreta de origen residual, formada por minerales cuya composición es de hidratos de aluminio, entre los que destacan la gibbsita, la boehmita y el diásporo, que se forma por la meteorización de los feldespatos y los feldespatoides en condiciones ambientales cálidas y húmedas</skos:definition>
    <skos:definition xml:lang="en">Highly aluminous material containing abundant aluminium hydroxides (gibbsite, less commonly boehmite, diaspore) and aluminium-substituted iron oxides or hydroxides and generally minor or negligible kaolin minerals; may contain up to 20 percent quartz. Commonly has a pisolitic or nodular texture, and may be cemented</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/bauxite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/bauxite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquibasalto-potasico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquibasalto potásico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">potassic trachybasalt</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica, alcalina, variedad potásica del traquibasalto</skos:definition>
    <skos:definition xml:lang="en">Basic, alkaline volcanic rock, potassic variety of trachybasalt</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/corneana">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">corneana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hornfels</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica originada por metamorfismo de contacto, masiva, muy dura y recristalizada, de grano fino a medio y que carece de planos de exfoliación</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock formed by contact metamorphism, massive, very hard and recrystallized, fine- to medium-grained and lacking cleavage planes</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hornfels"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hornfels"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/toba-con-bombas-o-bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">toba con bombas o bloques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bomb or block tuff</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica cuyo contenido en fragmentos de diámetro superior a 64 mm constituye más del 25% en volumen de los piroclastos</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock whose content of fragments with a diameter exceeding 64 mm constitutes more than 25% by volume of the pyroclasts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tuffBrecciaAgglomerateOrPyroclasticBreccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tuff-breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-osifera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha osífera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ossiferrous breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Brecha constituida por huesos y fragmentos de huesos cementados, que se forma en cuevas o rellena grietas o cavidades cársticas</skos:definition>
    <skos:definition xml:lang="en">Breccia consisting of cemented bones and bone fragments, forming in caves or filling karst fissures or cavities</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/komatiita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">komatiíta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">komatiite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea considerada como el único equivalente volcánico de las rocas ultramáficas. está formada a partir de magmas de muy alta temperatura, con un contenido en sio2 del 30-52%, mayor del 18% en mgo, menor del 2% en na2o+k2o y menor del 1% en tio2. presenta texturas spinifex formadas por cristales alargados y dendríticos de olivino, resultado de un enfriamiento muy rápido</skos:definition>
    <skos:definition xml:lang="en">Igneous rock considered to be the only volcanic equivalent of ultramafic rocks. It is formed from very high-temperature magmas with a SiO2 content of 30-52%, more than 18% MgO, less than 2% Na2O+K2O and less than 1% TiO2. It exhibits spinifex textures formed by elongated dendritic crystals of olivine, resulting from very rapid cooling</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticCompositionIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_composition_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-subvolcanicas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Subvolcánicas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Subvolcanic Rocks</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Subvolcánicas, que se caracteriza por incluir rocas originadas por la solidificación de un magma silicatado en el interior de la corteza terrestre a escasa profundidad, no superior a 3 km, asociadas a las rocas plutónicas o a las eruptivas, y que presentan diferencias texturales, más que de composición, con ambas.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Subvolcanic Rocks, characterized by including rocks formed by the solidification of a silicate magma in the interior of the Earth's crust at shallow depth, not exceeding 3 km, associated with plutonic rocks or extrusive rocks, and differing from both primarily in texture rather than composition.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/camptonita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/diabasa"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/espesartita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/granofido"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/kersantita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lamprofido"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/minette"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/monchiquita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/ofita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/porfido"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-doleritica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sanaita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/vitrofido"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/voguesita"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-esparitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza esparítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sparitic limestone</skos:prefLabel>
    <skos:altLabel xml:lang="es">esparita</skos:altLabel>
    <skos:definition xml:lang="es">Caliza compuesta por más del 90 % de esparita</skos:definition>
    <skos:definition xml:lang="en">Limestone composed of more than 90% sparite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-acido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material ácido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">acidic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material ígneo que contiene más del 66% de sílice</skos:definition>
    <skos:definition xml:lang="en">Igneous material containing more than 66% silica</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/acidicIgneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/acidic_igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-rico-en-materia-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito rico en materia orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organic matter-rich deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">sedimento rico en materia orgánica</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento cuyo contenido en materia orgánica es suficientemente alto como para tener efectos notables en la litología</skos:definition>
    <skos:definition xml:lang="en">Sediment whose organic matter content is sufficiently high to have notable effects on the lithology</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-kalsilitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca kalsilítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kalsilitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea que contiene kalsilita, además de clinopiroxeno, olivino, melilita, leucita o flogopita</skos:definition>
    <skos:definition xml:lang="en">Igneous rock containing kalsilite, in addition to clinopyroxene, olivine, melilite, leucite or phlogopite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/colemanita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">colemanita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">colemanite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula ca2b6o11.5h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema monoclínico formando cristales prismáticos incoloros o blancos, o masas granudas</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula Ca2B6O11·5H2O, belonging to the class of borates, crystallizing in the monoclinic system forming colourless or white prismatic crystals, or granular masses</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-tobacea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha tobácea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuffaceous breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Roca mixta piroclástica-epiclástica formada en más de un 75% de su volumen por fragmentos angulosos de diámetro mayor de 2 mm</skos:definition>
    <skos:definition xml:lang="en">Mixed pyroclastic-epiclastic rock formed by more than 75% by volume of angular fragments with a diameter greater than 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-traquitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca traquítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trachytic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica leucocrática, intermedia o ácida, alcalina, perteneciente al grupo de los traquitoides, compuesta principalmente por feldespatos, de entre los que el feldespato alcalino constituye entre el 65 y el 90%, en una matriz microcristalina, frecuentemente con textura traquítica. su equivalente plutónico es la roca sienítica</skos:definition>
    <skos:definition xml:lang="en">Leucocratic, intermediate or acid, alkaline volcanic rock belonging to the group of trachytoids, composed mainly of feldspars, of which alkali feldspar constitutes between 65 and 90%, in a microcrystalline groundmass, frequently with trachytic texture. Its plutonic equivalent is syenitic rock</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/trachyticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/trachytic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ankaratrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ankaratrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ankaratrite</skos:prefLabel>
    <skos:definition xml:lang="es">Nefelinita olivínica melanocrática con biotita</skos:definition>
    <skos:definition xml:lang="en">Melanocratic olivine nephelinite with biotite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-ricos-en-materia-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Sedimentarias y Sedimentos Ricos en Materia Orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Organic-Rich Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Sedimentarias y Sedimentos Ricos en Materia Orgánica, que se caracteriza por incluir rocas y sedimentos con una proporción significativa de materia orgánica, como el carbón, las pizarras bituminosas y los sapropeles.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Organic-Rich Sedimentary Rocks and Sediments, characterized by including rocks and sediments with a significant proportion of organic matter, such as coal, oil shales, and sapropels.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/ambar"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/antracita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/asfaltita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/asfalto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/azabache"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/bitumen"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/carbon"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/carbon-bituminoso"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/carbon-de-la-serie-humica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/carbon-de-la-serie-sapropelica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/carbon-impuro"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/carbon-sapropelico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/gilsonita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lignito"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lignito-negro"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lignito-pardo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lignito-sapropelico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lutita-bituminosa"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lutita-con-materia-organica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/petroleo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/sapropel"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/turba"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pizarra">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pizarra</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de grano muy fino que presenta una esquistosidad pizarrosa, formada a partir de lutitas bajo condiciones de grado metamórfico muy bajo</skos:definition>
    <skos:definition xml:lang="en">Very fine-grained metamorphic rock exhibiting slaty cleavage, formed from mudstones under conditions of very low metamorphic grade</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/slate"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/slate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-no-consolidado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material no consolidado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">unconsolidated material</skos:prefLabel>
    <skos:definition xml:lang="es">Material compuesto constituido por una agregación de partículas sin compactar</skos:definition>
    <skos:definition xml:lang="en">Composite material consisting of an aggregation of unconsolidated particles</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/unconsolidatedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/unconsolidated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/peridotita-piroxeno-hornblendica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">peridotita piroxeno-hornbléndica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroxene-hornblende peridotite</skos:prefLabel>
    <skos:definition xml:lang="es">Peridotita con un contenido representativo de piroxeno y hornblenda</skos:definition>
    <skos:definition xml:lang="en">Peridotite with a representative content of pyroxene and hornblende</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peridotite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/hormigon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">hormigón</skos:prefLabel>
    <skos:prefLabel xml:lang="en">concrete</skos:prefLabel>
    <skos:definition xml:lang="es">Material que resulta de la mezcla de agua, arena, grava y cemento o cal, y que, al fraguar, adquiere más resistencia</skos:definition>
    <skos:definition xml:lang="en">Material resulting from mixing water, sand, gravel and cement or lime, which upon setting acquires greater resistance</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/concrete"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ortoanfibolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ortoanfibolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">orthoamphibolite</skos:prefLabel>
    <skos:definition xml:lang="es">Anfibolita cuyo protolito es una roca ígnea, generalmente un basalto o un gabro</skos:definition>
    <skos:definition xml:lang="en">Amphibolite whose protolith is an igneous rock, generally a basalt or a gabbro</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/amphibolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/amphibolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/mangerita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">mangerita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mangerite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca perteneciente a la familia de las rocas charnoquíticas, equivalente a una monzonita con ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Rock belonging to the charnockitic rock family, equivalent to a monzonite with orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-volcano-sedimentario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito volcano-sedimentario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcano-sedimentary deposit</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito en cuya formación se reconoce la participación de procesos volcánicos y sedimentarios</skos:definition>
    <skos:definition xml:lang="en">Deposit in whose formation the participation of both volcanic and sedimentary processes is recognized</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousMaterial"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_material"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/mudstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">mudstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada matriz-soportada, constituida por menos del 10% de granos, siendo el resto matriz micrítica, según la clasificación de Dunham 1962</skos:definition>
    <skos:definition xml:lang="en">Matrix-supported carbonate rock, consisting of less than 10% grains, with the remainder being micritic matrix, according to the Dunham (1962) classification</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pureCarbonateMudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_carbonate_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-monzonitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca monzonítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzonitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Sienitoide en el que el feldespato alcalino y la plagioclasa se encuentran en proporciones similares 35-65% de los feldespatos, destacando el clinopiroxeno entre los componentes máficos. es el equivalente intrusivo de la roca latítica</skos:definition>
    <skos:definition xml:lang="en">Syenitoid in which alkali feldspar and plagioclase are in similar proportions (35-65% of feldspars), with clinopyroxene being prominent among the mafic components. It is the intrusive equivalent of latitic rock</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzoniticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzonitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/agpaita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">agpaíta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">agpaite</skos:prefLabel>
    <skos:definition xml:lang="es">Sienita nefelínica peralcalina en la que el índice agpaítico [na2o+k2o/al2o3, en proporciones molares] es superior a 1</skos:definition>
    <skos:definition xml:lang="en">Peralkaline nepheline syenite in which the agpaitic index [Na2O+K2O/Al2O3, in molar proportions] exceeds 1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingSyenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/flysch-calcareo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">flysch calcáreo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous flysch</skos:prefLabel>
    <skos:definition xml:lang="es">Tectofacies constituida por una ritmita de bancos de  areniscas turbidíticas con una mayoría de granos calcáreos y lutitas con un espesor de cientos o miles de metros, depositada en márgenes continentales en las etapas anteriores a su deformación orogénica</skos:definition>
    <skos:definition xml:lang="en">Tectofacies consisting of a rhythmite of turbiditic sandstone beds with a majority of calcareous grains and mudstones, hundreds to thousands of metres thick, deposited on continental margins in the stages prior to their orogenic deformation</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-carbonatada-lutitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca carbonatada lutítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lutaceous carbonate rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada con un contenido lutítico comprendido entre el 10 y el 50% del total</skos:definition>
    <skos:definition xml:lang="en">Carbonate rock with a mudstone content between 10 and 50% of the total</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateMudstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/boninita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">boninita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">boninite</skos:prefLabel>
    <skos:definition xml:lang="es">Andesita de alto contenido en mgo más del 8%, con cantidades de tio2 inferiores al 0,5% y de sio2 superiores al 52%, que suele contener olivino y piroxeno, en una matriz vítrea con texturas características de crecimiento rápido</skos:definition>
    <skos:definition xml:lang="en">Andesite with high MgO content (more than 8%), TiO2 contents below 0.5% and SiO2 above 52%, which usually contains olivine and pyroxene in a glassy groundmass with textures characteristic of rapid growth</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boninite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boninite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-calcareo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento calcáreo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado con un contenido de calcita más aragonito superior al de dolomita</skos:definition>
    <skos:definition xml:lang="en">Calcareous carbonate sediment with a calcite plus aragonite content greater than that of dolomite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/micrita-con-ooides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">micrita con ooides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micrite with ooids</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza micrítica con aloquímicos, de entre los que predominan los ooides</skos:definition>
    <skos:definition xml:lang="en">Micritic limestone with allochems, among which ooids predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/harina-glaciar">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">harina glaciar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glacial flour</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico fino, generalmente de tamaño limo o arena fina, formado por la abrasión de un glaciar</skos:definition>
    <skos:definition xml:lang="en">Fine-grained detrital sediment, generally silt or very fine sand size, formed by glacial abrasion</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/norita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">norita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">norite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica gabroica constituida por plagioclasa cálcica y ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Gabbroic plutonic rock consisting of calcic plagioclase and orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-milonitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca milonítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mylonitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de falla cohesiva, fuertemente foliada y habitualmente con una marcada lineación de minerales sobre las superficies de foliación. está constituida esencialmente por granos alargados con forma de tiras embebidos en una matriz de pequeños granos de la misma composición mineral, que es el resultado de una recristalización dinámica</skos:definition>
    <skos:definition xml:lang="en">Cohesive, strongly foliated fault rock, usually with a marked mineral lineation on foliation surfaces. It consists essentially of elongated ribbon-shaped grains embedded in a matrix of small grains of the same mineral composition, which results from dynamic recrystallization</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-de-falla-no-cohesivo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material de falla no cohesivo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">non-cohesive fault material</skos:prefLabel>
    <skos:definition xml:lang="es">Material de falla con rasgos que indican pérdida de cohesión durante la deformación, tales como espacios vacíos rellenos o no o material con matriz no consolidada entre los fragmentos. incluye las brechas y las harinas de falla</skos:definition>
    <skos:definition xml:lang="en">Fault material with features indicating loss of cohesion during deformation, such as empty or filled void spaces or non-consolidated matrix material between the fragments. Includes breccias and fault gouges</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia-gougeSeries"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia_gouge_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-basaltica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca basáltica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basaltic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica oscura, básica, subalcalina o alcalina, compuesta principalmente por plagioclasa, que constituye más del 65% de los feldespatos, piroxeno y, en ocasiones, olivino, pudiendo incluir cantidades menores de cuarzo o feldespatoides</skos:definition>
    <skos:definition xml:lang="en">Dark, basic, subalkaline or alkaline volcanic rock, composed mainly of plagioclase constituting more than 65% of the feldspars, pyroxene and, occasionally, olivine, and possibly including lesser amounts of quartz or feldspathoids</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/adakita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">adakita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">adakite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea ácida, de composición dacítica o granodiorítica-tonalítica, rica en na2o y con relaciones elevadas de la/yb y sr/y mayor de 40 en este último ratio. la adakita puede formarse por fusión directa de la corteza oceánica subducida o por fusión parcial de una corteza máfica en condiciones de alta presión</skos:definition>
    <skos:definition xml:lang="en">Acid igneous rock of dacitic or granodioritic-tonalitic composition, rich in Na2O and with high La/Yb and Sr/Y ratios (greater than 40 for the latter). Adakite may form by direct melting of subducted oceanic crust or by partial melting of a mafic crust under high-pressure conditions</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granodiorite"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tonalite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granodiorite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tonalite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-dolomitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca dolomítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">roca sedimentaria carbonatada cuyos constituyentes principales son la dolomita o carbonatos de composición parecida. la variedad pura tiene, al menos, un 95% de dolomita y las variedades impuras, más del 10% de calcita o de impurezas. se origina por precipitación química dolomía primaria o, más frecuentemente, durante la diagénesis dolomía secundaria</skos:definition>
    <skos:definition xml:lang="en">Sedimentary carbonate rock whose principal constituents are dolomite or carbonates of similar composition. The pure variety has at least 95% dolomite and the impure varieties more than 10% calcite or impurities. It originates by chemical precipitation (primary dolomite) or, more frequently, during diagenesis (secondary dolomite)</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomiticOrMagnesianSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_or_magnesian_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/espilita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">espilita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spilite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca basáltica retrogradada, generalmente vesicular, en la que el feldespato ha sido albitizado y aparece acompañado de clorita, epidota, prehnita y otros minerales de baja temperatura hidratados</skos:definition>
    <skos:definition xml:lang="en">Retrograded, generally vesicular basaltic rock in which the feldspar has been albitized and is accompanied by chlorite, epidote, prehnite and other low-temperature hydrated minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/spilite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/spilite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/anortosita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">anortosita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anorthosite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica compuesta casi exclusivamente por plagioclasa cálcica, los minerales ferromagmesianos olivino, piroxenos y, menos frecuentemente, anfíbol constituyen menos del 10% del volumen de la roca</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock composed almost exclusively of calcic plagioclase; ferromagnesian minerals (olivine, pyroxenes and, less frequently, amphibole) constitute less than 10% of the rock volume</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anorthosite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anorthosite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-compuesto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material compuesto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">composite material</skos:prefLabel>
    <skos:definition xml:lang="es">Material constituido por una agrupación de partículas de origen terrestre, pudiendo incluir otros materiales compuestos</skos:definition>
    <skos:definition xml:lang="en">Material consisting of a grouping of particles of terrestrial origin, which may include other composite materials</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/compoundMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/compound_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/latita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">latita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid-bearing latite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica intermedia, alcalina, perteneciente al grupo de las rocas latíticas, que contiene feldespatoides. su equivalente plutónico es la monzonita con foides</skos:definition>
    <skos:definition xml:lang="en">Intermediate, alkaline volcanic rock belonging to the latitic rock group, containing feldspathoids. Its plutonic equivalent is foid-bearing monzonite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingLatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_latite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fonolita-tefritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fonolita tefrítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephritic phonolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente a la familia de las rocas fonolíticas, en la que el feldespato alcalino constituye menos del 90% de los feldespatos. su equivalente plutónico es la monzosienita foídica</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the phonolitic rock family, in which alkali feldspar constitutes less than 90% of the feldspars. Its plutonic equivalent is foid monzosyenite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephriticPhonolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephritic_phonolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lignito-pardo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lignito pardo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">brown lignite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad del lignito, de color pardo, brillo mate, aspecto laminado y estructura fibrosa</skos:definition>
    <skos:definition xml:lang="en">Variety of lignite, brown in colour, matt lustre, laminated appearance and fibrous structure</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/lignite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/lignite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fango-de-espiculas-de-esponjas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fango de espículas de esponjas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sponge spicule ooze</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento de tamaño pelita compuesto por espículas de esponjas silíceas</skos:definition>
    <skos:definition xml:lang="en">Pelite-size sediment composed of sponge spicules</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/siliceousOoze"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/toba-brechoide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">toba brechoide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">brecciated tuff</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica cuyo contenido en fragmentos de diámetro superior a 64 mm está comprendido entre el 25 y el 75% del volumen de los piroclastos</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock whose content of fragments with a diameter exceeding 64 mm is between 25 and 75% of the pyroclast volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tuffBrecciaAgglomerateOrPyroclasticBreccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tuff_breccia_agglomerate_or_pyroclastic_breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granitoide-rico-en-cuarzo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granitoide rico en cuarzo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz-rich granitoid</skos:prefLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de rocas plutónicas leucocráticas en las que el cuarzo es el constituyente principal</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of leucocratic plutonic rocks in which quartz is the main constituent</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzRichIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_rich_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquidacita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquidacita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trachydacite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica mesocrática, intermedia o ácida, alcalina, perteneciente a la familia de las rocas traquíticas, diferenciada de la traquita por poseer más del 20% de cuarzo normativo</skos:definition>
    <skos:definition xml:lang="en">Mesocratic, intermediate or acid, alkaline volcanic rock belonging to the trachytic rock family, differentiated from trachyte by having more than 20% normative quartz</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/trachytoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/trachytoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-de-grano-muy-grueso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca de grano muy grueso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">very coarse-grained sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca en la que predominan los granos de diámetro comprendido entre 1.0 y 2.0 mm</skos:definition>
    <skos:definition xml:lang="en">Sandstone in which grains with a diameter between 1.0 and 2.0 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fango-de-diatomeas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fango de diatomeas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diatomaceous ooze</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento de tamaño pelita compuesto por caparazones de diatomeas</skos:definition>
    <skos:definition xml:lang="en">Pelite-size sediment composed of diatom frustules</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/siliceousOoze"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dacita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dacita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dacite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica ácida, subalcalina, leucocrática, de textura porfídica, compuesta por fenocristales de cuarzo y plagioclasa sódica englobados en una matriz vítrea o microcristalina. puede contener cantidades subordinadas de feldespato alcalino, biotita, hornblenda y piroxeno. sus equivalentes plutónicos son la granodiorita y la tonalita</skos:definition>
    <skos:definition xml:lang="en">Acid, subalkaline, leucocratic volcanic rock of porphyritic texture, composed of quartz and sodic plagioclase phenocrysts enclosed in a glassy or microcrystalline groundmass. It may contain subordinate amounts of alkali feldspar, biotite, hornblende and pyroxene. Its plutonic equivalents are granodiorite and tonalite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dacite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dacite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-antropico-consolidado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material antrópico consolidado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">consolidated anthropic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material consolidado de origen artificial (humano)</skos:definition>
    <skos:definition xml:lang="en">Consolidated material of artificial (human) origin</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicConsolidatedMaterial"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarcita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarcita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartzite</skos:prefLabel>
    <skos:altLabel xml:lang="es">metacuarcita</skos:altLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una arenisca, con más de un 80% de cuarzo</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a sandstone, with more than 80% quartz</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartzite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fortunita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fortunita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fortunite</skos:prefLabel>
    <skos:altLabel xml:lang="es">lamproíta con vidrio-enstatita-flogopita</skos:altLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente a la familia de las lamproítas, de composición traquítica, caracterizada por la presencia de flogopita</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the lamproite family, of trachytic composition, characterized by the presence of phlogopite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carbonatita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carbonatita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonatite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con un contenido en carbonatos primarios superior al 50% en volumen</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with a primary carbonate content exceeding 50% by volume</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonatite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metahornblendita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metahornblendita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metahornblendite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una hornblendita</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a hornblendite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/amphibolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/amphibolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzotraquita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzotraquita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar quartz trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente al grupo de las rocas traquíticas de feldespato alcalino, que contiene cuarzo en una cantidad superior al 5% de los minerales félsicos. su equivalente plutónico es la cuarzosienita de feldespato alcalino</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the group of alkali feldspar trachytic rocks, containing quartz in an amount exceeding 5% of the felsic minerals. Its plutonic equivalent is alkali feldspar quartz syenite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzAlkaliFeldsparTrachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_alkali_feldspar_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-material-antropico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Material Antrópico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Anthropogenic Material</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Material Antrópico, que se caracteriza por incluir acumulaciones de materiales, compactados o sin compactar, debidas exclusivamente a la acción humana.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Anthropic Material, characterized by including accumulations of materials, compacted or uncompacted, due exclusively to human action.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/desecho"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/dique"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/escombrera"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/escombro"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/escoria"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/espigon"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/fertilizante"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/hormigon"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lodo-de-depuradora"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/lodo-industrial"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/malecon"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/polder"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/relleno"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/salina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/vertedero"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-biogenico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito biogénico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biogenic deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">sedimento biogénico</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento producido por la acción o la presencia de organismos vivos o de sus restos</skos:definition>
    <skos:definition xml:lang="en">Sediment produced by the action or presence of living organisms or their remains</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/biogenic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-autoclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha autoclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">autoclastic breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Brecha constituida por fragmentos de rocas volcánicas generados por fricción mecánica durante el movimiento de la lava</skos:definition>
    <skos:definition xml:lang="en">Breccia composed of volcanic rock fragments generated by mechanical friction during lava movement</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/turbidita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">turbidita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">turbidite</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento o roca sedimentaria formados por corrientes de turbidez. se trata de arenas o areniscas que presentan secuencias granodecrecientes con una ordenación de estructuras sedimentarias internas muy singular, denominada secuencia de bouma</skos:definition>
    <skos:definition xml:lang="en">Sediment or sedimentary rock formed by turbidity currents. They consist of sands or sandstones with graded bedding sequences and a very distinctive arrangement of internal sedimentary structures known as the Bouma sequence</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-kalsilitica-melilitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca kalsilítica-melilítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kalsilitic-melilitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea subsaturada, generalmente máfica o ultramáfica, que contiene más de un 10% de kalsilita roca kalsilítica o melilita roca melilítica</skos:definition>
    <skos:definition xml:lang="en">Undersaturated, generally mafic or ultramafic igneous rock, containing more than 10% kalsilite (kalsilitic rock) or melilite (melilitic rock)</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ankaramita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ankaramita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ankaramite</skos:prefLabel>
    <skos:definition xml:lang="es">Basalto picrítico en el que son muy abundantes los fenocristales de clinopiroxeno debido al contenido anómalamente alto en ca del magma del que proceden</skos:definition>
    <skos:definition xml:lang="en">Picritic basalt in which clinopyroxene phenocrysts are very abundant owing to the anomalously high Ca content of the parent magma</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-tefritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca tefrítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephritic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Contienen cantidades menores de minerales ferromagnesianos, como piroxeno, anfíbol y, en ocasiones, olivino</skos:definition>
    <skos:definition xml:lang="en">Containing lesser amounts of ferromagnesian minerals, such as pyroxene, amphibole and, occasionally, olivine</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephritoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephritoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-foliada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca foliada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foliated rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica en la que al menos el 10% de sus componentes minerales tienen una fábrica planar o linear. la naturaleza cataclástica o vítrea excluyen la clasificación bajo este concepto</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock in which at least 10% of its mineral components exhibit a planar or linear fabric. Cataclastic or glassy nature excludes classification under this concept</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foliatedMetamorphicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foliated_metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-clastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material clástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clastic material</skos:prefLabel>
    <skos:altLabel xml:lang="es">material detrítico</skos:altLabel>
    <skos:definition xml:lang="es">Dimentario compuesto en más de un 50% por fragmentos de otras rocas y minerales preexistentes</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material composed of more than 50% fragments from pre-existing rocks and minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-conchifera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza conchífera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">shell limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza organógena formada mayoritariamente por conchas calcáreas, enteras o fragmentadas, fácilmente reconocibles</skos:definition>
    <skos:definition xml:lang="en">Organogenic limestone formed predominantly by whole or fragmented calcareous shells, easily recognizable</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-foidica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca foídica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">foiditoide</skos:altLabel>
    <skos:definition xml:lang="es">nombre utilizado en la descripción provisional de rocas volcánicas básicas o ultrabásicas, ultraalcalinas, en las que los feldespatoides representan más del 60% del total de los minerales félsicos, contienen cantidades menores de minerales ferromagnesianos, como piroxeno y, en ocasiones, anfíbol</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of basic or ultrabasic, ultraalkaline volcanic rocks in which feldspathoids represent more than 60% of the total felsic minerals, containing lesser amounts of ferromagnesian minerals, such as pyroxene and, occasionally, amphibole</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foiditoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foiditoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-hialocristalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca hialocristalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hyalocrystalline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea formada por cristales y vidrio</skos:definition>
    <skos:definition xml:lang="en">Igneous rock formed by crystals and glass</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/glassRichIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/glass_rich_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-calcarea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena calcárea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous sand</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico en el que el contenido conjunto de granos de arena independientemente de su composición y de material constituido por carbonato cálcico es igual o superior al 90% del total y en el que la relación de los granos de arena con respecto al material constituido por carbonato cálcico está comprendida entre el 50 y el 90%</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment in which the combined content of sand grains (regardless of composition) and calcium carbonate material equals or exceeds 90% of the total, and in which the ratio of sand grains to calcium carbonate material is between 50 and 90%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arcosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arcosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">arkose</skos:prefLabel>
    <skos:definition xml:lang="es">Arenita en la que la proporción de cuarzo es inferior al 75% con respecto al total de elementos terrígenos y en la que el contenido de feldespatos es mayor que el de fragmentos de otras rocas</skos:definition>
    <skos:definition xml:lang="en">Arenite in which the proportion of quartz is below 75% of the total terrigenous elements and in which the feldspar content is greater than that of rock fragments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carbon-bituminoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carbón bituminoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bituminous coal</skos:prefLabel>
    <skos:altLabel xml:lang="es">hulla</skos:altLabel>
    <skos:definition xml:lang="es">Variedad de carbón dura, de color negro intenso, brillo mate o graso y fractura rectangular. su contenido en carbono es del 75-90% y el de volátiles, del 14-46%</skos:definition>
    <skos:definition xml:lang="en">Hard coal variety of intense black colour, with matt or oily lustre and rectangular fracture. Its carbon content is 75-90% and the volatile matter content is 14-46%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/bituminousCoal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/bituminous_coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/peridotita-piroxenica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">peridotita piroxénica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroxene peridotite</skos:prefLabel>
    <skos:definition xml:lang="es">Peridotita con olivino y piroxeno como minerales esenciales</skos:definition>
    <skos:definition xml:lang="en">Peridotite with olivine and pyroxene as essential minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peridotite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-de-grano-muy-fino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca de grano muy fino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">very fine-grained sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca en la que predominan los granos de diámetro comprendido entre 0.062 y 0.125 mm</skos:definition>
    <skos:definition xml:lang="en">Sandstone in which grains with a diameter between 0.062 and 0.125 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-piroclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material piroclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material formado por piroclastos en más de un 75% de su volumen</skos:definition>
    <skos:definition xml:lang="en">Material formed by pyroclasts in more than 75% of its volume</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bioclasto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bioclasto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bioclast</skos:prefLabel>
    <skos:definition xml:lang="es">Elemento clástico procedente de la parte dura de un organismo, presente en una roca sedimentaria</skos:definition>
    <skos:definition xml:lang="en">Clastic element derived from the hard part of an organism, present in a sedimentary rock</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-pura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza pura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca calcárea con un contenido de carbonato cálcico superior al 95%</skos:definition>
    <skos:definition xml:lang="en">Calcareous rock with a calcium carbonate content exceeding 95%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/esquisto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">esquisto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">schist</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de grano medio, foliada y fisible, compuesta esencialmente por cuarzo y micas</skos:definition>
    <skos:definition xml:lang="en">Medium-grained, foliated and fissile metamorphic rock composed essentially of quartz and micas</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/schist"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/schist"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/espigon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">espigón</skos:prefLabel>
    <skos:prefLabel xml:lang="en">breakwater</skos:prefLabel>
    <skos:altLabel xml:lang="es">rompeolas</skos:altLabel>
    <skos:definition xml:lang="es">Macizo saliente que se construye a la orilla de un río o en la costa del mar, para defender las márgenes o modificar la corriente</skos:definition>
    <skos:definition xml:lang="en">Projecting mass constructed on a riverbank or sea coast to protect the margins or modify the current</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicUnconsolidatedMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_unconsolidated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-holocristalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca holocristalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">holocrystalline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea formada exclusivamente por cristales</skos:definition>
    <skos:definition xml:lang="en">Igneous rock formed exclusively by crystals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phaneriticIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phaneritic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/foidita-fonolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">foidita fonolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phonolitic foidite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente a la familia de las rocas foídicas que posee una mayor cantidad de feldespato alcalino que de plagioclasa y en la que los feldespatoides representan menos del 90% del total de los minerales félsicos</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the foidite family that has a greater amount of alkali feldspar than plagioclase, and in which feldspathoids represent less than 90% of the total felsic minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phonoliticFoidite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phonolitic_foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-piroclastico-epiclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito piroclástico-epiclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic-epiclastic deposit</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito de carácter mixto constituido tanto por fragmentos de origen piroclástico como de origen epiclástico, ambos en un porcentaje comprendido entre el 25 y el 75% del volumen del depósito</skos:definition>
    <skos:definition xml:lang="en">Deposit of mixed character consisting of both pyroclastic and epiclastic fragments, each in a percentage between 25 and 75% of the deposit volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephra"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephra"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/conglomerado-pelitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">conglomerado pelítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelitic conglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida en un 30-50% por clastos de más de 2 mm de diámetro y con un contenido de elementos de tamaño pelita mayor que el de elementos de tamaño arena</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of 30-50% clasts with a diameter exceeding 2 mm and with a pelite-size element content greater than that of sand-size elements</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/mugearita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">mugearita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mugearite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica o intermedia, alcalina, variedad sódica de la traquiandesita basáltica</skos:definition>
    <skos:definition xml:lang="en">Basic or intermediate, alkaline volcanic rock, sodic variety of basaltic trachyandesite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/andesite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-ferruginosos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Ferruginosos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Ferruginous Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Ferruginosos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos compuestos en más de un 50% por minerales ferruginosos.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Ferruginous Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments composed of more than 50% ferruginous minerals.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-ferruginoso"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-ferruginoso"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-ferruginosa"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/hawaiita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">hawaiita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hawaiite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica, alcalina, variedad sódica del traquibasalto</skos:definition>
    <skos:definition xml:lang="en">Basic, alkaline volcanic rock, sodic variety of trachybasalt</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lignito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lignito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lignite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad de carbón de aspecto consolidado, color pardo a negruzco, sin brillo, con fragmentos de plantas reconocibles y matriz orgánica de grano fino. su contenido en carbono es del 60-75% y el de volátiles, del 46-63%</skos:definition>
    <skos:definition xml:lang="en">Consolidated-appearing coal variety, brown to blackish in colour, without lustre, with recognizable plant fragments and fine-grained organic matrix. Its carbon content is 60-75% and the volatile matter content is 46-63%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/lignite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/lignite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-subvolcanica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca subvolcánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subvolcanic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca hipoabisal</skos:altLabel>
    <skos:definition xml:lang="es">Roca originada por la solidificación de un magma silicatado en el interior de la corteza terrestre a escasa profundidad no superior a 3 km. se encuentra asociada a las rocas plutónicas, formando salientes o apófisis, o bien a las eruptivas, en la parte profunda de complejos volcánicos, y presenta diferencias texturales, más que de composición, con ambas</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the solidification of a silicate magma in the interior of the Earth's crust at shallow depth, not exceeding 3 km. It is associated with plutonic rocks, forming apophyses or stocks, or with extrusive rocks in the deeper parts of volcanic complexes, and differs from both primarily in texture rather than composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutita-tobacea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutita tobácea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuffaceous mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca mixta piroclástica-epiclástica formada en más de un 75% de su volumen por fragmentos de diámetro inferior a 1/16 mm</skos:definition>
    <skos:definition xml:lang="en">Mixed pyroclastic-epiclastic rock formed by more than 75% by volume of fragments with a diameter below 1/16 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/claystone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/claystone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/diabasa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">diabasa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diabase</skos:prefLabel>
    <skos:altLabel xml:lang="es">dolerita</skos:altLabel>
    <skos:definition xml:lang="es">Roca subvolcánica, generalmente masiva y compacta, de tamaño de grano intermedio entre basalto y gabro, compuesta por plagioclasa, piroxeno y minerales opacos, a veces con olivino, ocasionalmente presenta textura dolerítica y, más frecuentemente, ofítica</skos:definition>
    <skos:definition xml:lang="en">Subvolcanic rock, generally massive and compact, of grain size intermediate between basalt and gabbro, composed of plagioclase, pyroxene and opaque minerals, sometimes with olivine; occasionally with doleritic texture and, more frequently, ophitic texture</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-tobacea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca tobácea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuffaceous sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca mixta piroclástica-epiclástica formada en más de un 75% de su volumen por fragmentos de diámetro comprendido entre 1/16 mm y 2 mm</skos:definition>
    <skos:definition xml:lang="en">Mixed pyroclastic-epiclastic rock formed by more than 75% by volume of fragments with a diameter between 1/16 mm and 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/meimechita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">meimechita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">meimechite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca komatiítica con un contenido de tio2 superior al 1%. si el contenido en tio2 es menor del 1% la roca se llama komatiíta</skos:definition>
    <skos:definition xml:lang="en">Komatiitic rock with a TiO2 content exceeding 1%. If the TiO2 content is below 1%, the rock is called komatiite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticCompositionIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_composition_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monzonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica que contiene cuarzo en una cantidad que no supera el 5% de los minerales félsicos y en la que la plagioclasa y el feldespato alcalino se encuentran en cantidades comprendidas entre el 35 y el 65%. es el equivalente intrusivo de la latita</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock containing quartz in an amount not exceeding 5% of the felsic minerals, and in which plagioclase and alkali feldspar are present in amounts between 35 and 65%. It is the intrusive equivalent of latite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzonite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzonite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gabronorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gabronorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gabbronorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica constituida por plagioclasa cálcica e igual cantidad de clinopiroxeno y ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock consisting of calcic plagioclase and equal amounts of clinopyroxene and orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/larvikita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">larvikita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">larvikite</skos:prefLabel>
    <skos:definition xml:lang="es">Sienita alcalina caracterizada por la presencia de abundantes  fenocristales de feldespato con formas romboidales que, cuando están pulidos, causan reflexiones brillantes azules o verdosas, la augita es el principal mineral máfico, pudiendo contener, como accesorio, abundante apatito</skos:definition>
    <skos:definition xml:lang="en">Alkaline syenite characterized by the presence of abundant rhomboidal-shaped feldspar phenocrysts which, when polished, cause bright blue or greenish reflections; augite is the principal mafic mineral and it may contain, as an accessory, abundant apatite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/syenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-peraluminosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca peraluminosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peraluminous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca con un índice de saturación en alúmina al2o3/k2o+na2o+cao, en proporciones molares mayor que la unidad. suele tener minerales ricos en aluminio como moscovita, cordierita, sillimanita, granate, turmalina y/o andalucita</skos:definition>
    <skos:definition xml:lang="en">Rock with an alumina saturation index Al2O3/K2O+Na2O+CaO, in molar proportions, greater than unity. It usually contains aluminium-rich minerals such as muscovite, cordierite, sillimanite, garnet, tourmaline and/or andalusite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-gravosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena gravosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gravelly sand</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico poco seleccionado, con un contenido de elementos de tamaño arena superior al de elementos de tamaño pelita y con un contenido de elementos de tamaño grava comprendido entre el 5 y el 30% del total</skos:definition>
    <skos:definition xml:lang="en">Poorly sorted detrital sediment with a sand-size element content greater than that of pelite-size elements and a gravel-size element content between 5 and 30% of the total</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/teschenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">teschenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">teschenite</skos:prefLabel>
    <skos:definition xml:lang="es">Gabro foídico en el que la analcima constituye el feldespatoide dominante</skos:definition>
    <skos:definition xml:lang="en">Foid gabbro in which analcime constitutes the dominant feldspathoid</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidGabbro"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metaconglomerado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metaconglomerado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metaconglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un conglomerado</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a conglomerate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-de-impacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas de Impacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Impact Rocks</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas de Impacto, que se caracteriza por incluir cualquier material producido por el impacto de un cuerpo extraterrestre.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Impact Rocks, characterized by including any material produced by the impact of an extraterrestrial body.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/brecha-de-impacto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-de-fundido-de-impacto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-de-impacto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/tectita"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/piroclasto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">piroclasto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclast</skos:prefLabel>
    <skos:definition xml:lang="es">Porción de roca, vidrio o cristal volcánico, de dimensiones variables, formado por fragmentación del magma o de las rocas de la pared del conducto, proyectado al aire por una erupción volcánica explosiva</skos:definition>
    <skos:definition xml:lang="en">Portion of rock, glass or volcanic crystal, of variable dimensions, formed by fragmentation of the magma or of the conduit wall rocks, projected into the air by an explosive volcanic eruption</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephra"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-piroclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha piroclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica formada en más de un 75% de su volumen por fragmentos de diámetro mayor de 64 mm, entre los que predominan los bloques piroclásticos</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock formed by more than 75% by volume of fragments with a diameter greater than 64 mm, among which pyroclastic blocks predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tuffBrecciaAgglomerateOrPyroclasticBreccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tuff_breccia_agglomerate_or_pyroclastic_breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-ignea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca ígnea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">igneous rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca magmática</skos:altLabel>
    <skos:definition xml:lang="es">Roca resultante del enfriamiento y la solidificación de un magma. puede ser volcánica o plutónica, según se emplace en la superficie o en el interior de la corteza terrestre</skos:definition>
    <skos:definition xml:lang="en">Rock resulting from the cooling and solidification of a magma. It can be volcanic or plutonic, depending on whether it is emplaced at the surface or in the interior of the Earth's crust</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/chert">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">chert</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chert</skos:prefLabel>
    <skos:altLabel xml:lang="es">pedernal, sílex</skos:altLabel>
    <skos:definition xml:lang="es">Roca sedimentaria silícea constituida por la variedad criptocristalina del cuarzo del mismo nombre. es densa, generalmente de porosidad inferior al 10%, muy dura y suele encontrarse en agregados de color variable, de pardo a amarillento o negro, asociada a formaciones sedimentarias. posee brillo vítreo</skos:definition>
    <skos:definition xml:lang="en">Siliceous sedimentary rock consisting of the cryptocrystalline quartz variety of the same name. It is dense, generally with porosity below 10%, very hard and commonly found in aggregates of variable colour, from brown to yellowish or black, associated with sedimentary formations. It has a vitreous lustre</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/silvina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">silvina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sylvine</skos:prefLabel>
    <skos:altLabel xml:lang="es">silvita</skos:altLabel>
    <skos:definition xml:lang="es">roca formada por el mineral del mismo nombre, de fórmula kcl, perteneciente a la clase de los cloruros, que cristaliza en el sistema cúbico, apareciendo en masas granudas o espáticas. es incoloro a blanco, tiene brillo vítreo y varía de transparente a translúcido</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula KCl, belonging to the class of chlorides, crystallizing in the cubic system, occurring in granular or sparitic masses. It is colourless to white, with vitreous lustre and varying from transparent to translucent</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gabro-nefelinico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gabro nefelínico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nepheline gabbro</skos:prefLabel>
    <skos:altLabel xml:lang="es">theralita</skos:altLabel>
    <skos:definition xml:lang="es">Gabro foídico en el que la nefelina constituye el feldespatoide dominante</skos:definition>
    <skos:definition xml:lang="en">Foid gabbro in which nepheline constitutes the dominant feldspathoid</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidGabbro"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquibasalto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquibasalto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trachybasalt</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica mesocrática básica, alcalina, formada esencialmente por plagioclasa y piroxeno, con contenidos menores de olivino. la variedad sódica recibe el nombre de hawaiita y la potásica, de traquibasalto potásico</skos:definition>
    <skos:definition xml:lang="en">Mesocratic, basic, alkaline volcanic rock formed essentially by plagioclase and pyroxene, with minor amounts of olivine. The sodic variety is called hawaiite and the potassic variety, potassic trachybasalt</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/peridotita-hornblendica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">peridotita hornbléndica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hornblende peridotite</skos:prefLabel>
    <skos:definition xml:lang="es">Peridotita con olivino y hornblenda como minerales esenciales</skos:definition>
    <skos:definition xml:lang="en">Peridotite with olivine and hornblende as essential minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peridotite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-fosfatada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria fosfatada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phosphate sedimentary rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">fosforita</skos:altLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta en más de un 50% por minerales fosfatados</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock composed of more than 50% phosphate minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phosphorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phosphorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metapiroxenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metapiroxenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metapyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una piroxenita</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a pyroxenite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzosienita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzosienita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas sieníticas, que contiene cuarzo en una cantidad comprendida entre el 5 y el 20% de los minerales félsicos. es el equivalente intrusivo de la cuarzotraquita</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of syenitic rocks, containing quartz in an amount between 5 and 20% of the felsic minerals. It is the intrusive equivalent of quartz trachyte</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/escoria-volcanica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">escoria volcánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcanic scoria</skos:prefLabel>
    <skos:definition xml:lang="es">Fragmento de lava vesicular y, por tanto, de baja densidad, de superficie irregular porosa, resultado del enfriamiento rápido de una proyección volcánica o de la superficie de una colada de lava</skos:definition>
    <skos:definition xml:lang="en">Fragment of vesicular and therefore low-density lava, with irregular porous surface, resulting from the rapid cooling of a volcanic projectile or the surface of a lava flow</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-epiclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca epiclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">epiclastic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">epiclastita</skos:altLabel>
    <skos:definition xml:lang="es">Roca volcanoclástica que contiene fragmentos de origen volcánico con evidencias de haber sido transportados por algún medio sedimentario</skos:definition>
    <skos:definition xml:lang="en">Volcaniclastic rock containing volcanic fragments showing evidence of having been transported by some sedimentary medium</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/subarcosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">subarcosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subarkose</skos:prefLabel>
    <skos:definition xml:lang="es">Arenita en la que la proporción de cuarzo está comprendida entre el 75 y el 95% con respecto al total de elementos terrígenos y en la que el contenido de feldespatos es mayor que el de fragmentos de otras rocas</skos:definition>
    <skos:definition xml:lang="en">Arenite in which the proportion of quartz is between 75 and 95% of the total terrigenous elements and in which the feldspar content is greater than that of rock fragments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/kainita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">kainita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kainite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula kmgso4cl.3h2o, perteneciente a la clase de los sulfatos, que cristaliza en el sistema monoclínico y se presenta en masas compactas granulares. el mineral puro es incoloro, pero con frecuencia presenta impurezas que le confieren color amarillo, marrón, verde-gris, rojo, violeta o azul, tiene brillo vítreo y varía de transparente a translúcido</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula KMgSO4Cl·3H2O, belonging to the class of sulfates, crystallizing in the monoclinic system and occurring as compact granular masses. The pure mineral is colourless, but it frequently presents impurities imparting yellow, brown, grey-green, red, violet or blue colour, with vitreous lustre and varying from transparent to translucent</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/andesita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">andesita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">andesite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica intermedia, calcoalcalina, de color gris claro y generalmente porfídica, formada por plagioclasa acompañada por uno o más minerales ferromagnesianos hornblenda, biotita, ortopiroxeno o clinopiroxeno. se distingue del basalto por la composición de la plagioclasa andesina o menos cálcica, la frecuente presencia de anfíbol y su composición básica-intermedia. su equivalente plutónico es la diorita-cuarzodiorita-cuarzomonzodiorita</skos:definition>
    <skos:definition xml:lang="en">Intermediate, calc-alkaline volcanic rock, light grey and generally porphyritic, formed by plagioclase accompanied by one or more ferromagnesian minerals (hornblende, biotite, orthopyroxene or clinopyroxene). It is distinguished from basalt by the composition of plagioclase (andesine or less calcic), the frequent presence of amphibole and its basic-intermediate composition. Its plutonic equivalent is diorite-quartz diorite-quartz monzodiorite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/andesite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/conglomerado-tobaceo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">conglomerado tobáceo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuffaceous conglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca mixta piroclástica-epiclástica formada en más de un 75% de su volumen por fragmentos de diámetro mayor de 2 mm</skos:definition>
    <skos:definition xml:lang="en">Mixed pyroclastic-epiclastic rock formed by more than 75% by volume of fragments with a diameter greater than 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tuffBrecciaAgglomerateOrPyroclasticBreccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tuff_breccia_agglomerate_or_pyroclastic_breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metacaliza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metacaliza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metalimestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición calcárea</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of calcareous composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/marble"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/marble"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carbon-sapropelico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carbón sapropélico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sapropelic coal</skos:prefLabel>
    <skos:definition xml:lang="es">Carbón de la serie sapropélica de aspecto variable entre finamente laminado y masivo. su contenido en carbono es superior al 70% y el de volátiles, inferior al 52%</skos:definition>
    <skos:definition xml:lang="en">Sapropelic series coal of variable appearance, between finely laminated and massive. Its carbon content exceeds 70% and the volatile matter content is below 52%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/coal"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-metamorficas-en-funcion-de-su-composicion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Metamórficas en Función de su Composición</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Metamorphic Rocks According To Composition</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Metamórficas en Función de su Composición, que se caracteriza por incluir rocas derivadas de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales, esencialmente en estado sólido, en respuesta a variaciones físico-químicas de presión y temperatura, clasificadas según su composición mineralógica resultante.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Metamorphic Rocks by Composition, characterized by including rocks derived from a pre-existing rock, through mineralogical, chemical or structural changes, essentially in solid state, in response to physicochemical variations of pressure and temperature, classified according to their resulting mineralogical composition.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/anfibolita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/calcoesquisto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/cipolino"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/corneana"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/cuarcita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/diatexita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/eclogita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/esquisto"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/esquisto-anfibolico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/esquisto-glaucofanico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/esquisto-micaceo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/filita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/garnierita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/gneis"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/gneis-bandeado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/gneis-glandular"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/granulita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/kinzigita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/marmol"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/metatexita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/migmatita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/pirigarnita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/pizarra"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-de-silicatos-calcicos"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-foliada"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-granoblastica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/serpentinita"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/foidita-basanitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">foidita basanítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basanitic foidite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente a la familia de las rocas foídicas en la que los feldespatoides representan menos del 90% del total de los minerales félsicos, la plagioclasa es más abundante que el feldespato alcalino y el olivino supera el 10% normativo</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the foidite family in which feldspathoids represent less than 90% of the total felsic minerals, plagioclase is more abundant than alkali feldspar, and olivine exceeds 10% normative</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basaniticFoidite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basanitic_foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/conglomerado-monomictico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">conglomerado monomíctico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monogenic conglomerate</skos:prefLabel>
    <skos:altLabel xml:lang="es">conglomerado monogénico</skos:altLabel>
    <skos:altLabel xml:lang="en">monomictic conglomerate</skos:altLabel>
    <skos:definition xml:lang="es">Conglomerado constituido por cantos de un mismo tipo de roca</skos:definition>
    <skos:definition xml:lang="en">Conglomerate consisting of clasts of a single rock type</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-carbonatada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria carbonatada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate sedimentary rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca carbonática</skos:altLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta en más de un 50% por minerales carbonatados</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock composed of more than 50% carbonate minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-peralcalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca peralcalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peralkaline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca con un índice agpaítico [na2o+k2o/al2o3, en proporciones molares] mayor que la unidad. suele tener minerales ricos en álcalis y pobres en aluminio, como piroxenos o anfíboles sódicos</skos:definition>
    <skos:definition xml:lang="en">Rock with an agpaitic index [Na2O+K2O/Al2O3, in molar proportions] greater than unity. It usually contains alkali-rich and aluminium-poor minerals, such as sodic pyroxenes or amphiboles</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-material-antropico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Grandes Grupos de Materiales / Material Antrópico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Major Material Groups / Anthropogenic Material</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Material Antrópico, que se caracteriza por representar el nivel superior de clasificación que agrupa todas las acumulaciones de materiales debidas exclusivamente a la acción humana.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the hierarchical category of Major Material Groups / Anthropic Material, characterized by representing the top-level classification that groups all accumulations of materials due exclusively to human action.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-antropico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-antropico-consolidado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-antropico-no-consolidado"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-siliceos-no-clasticos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Silíceos No Clásticos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Non-Clastic Siliceous Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Silíceos No Clásticos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos compuestos en más de un 50% por sílice de origen biogénico o químico, excluyendo las rocas detríticas.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Non-Clastic Siliceous Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments composed of more than 50% silica of biogenic or chemical origin, excluding detrital rocks.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-siliceo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-siliceo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-silicea"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-bioclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza bioclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bioclastic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza formada mayoritariamente por fragmentos de caparazones calcáreos de organismos</skos:definition>
    <skos:definition xml:lang="en">Limestone formed predominantly by fragments of calcite shells of organisms</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomia-calcarea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomía calcárea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous dolomite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca dolomítica en la que la calcita y la dolomita constituyen, conjuntamente, más del 90%, con un contenido de calcita superior al 10% del total</skos:definition>
    <skos:definition xml:lang="en">Dolomitic rock in which calcite and dolomite together constitute more than 90%, with a calcite content exceeding 10% of the total</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureDolomite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/escombrera">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">escombrera</skos:prefLabel>
    <skos:prefLabel xml:lang="en">waste dump</skos:prefLabel>
    <skos:definition xml:lang="es">Conjunto de escombros o desechos procedente de las excavaciones mineras</skos:definition>
    <skos:definition xml:lang="en">Set of rubble or waste from mining excavations</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mineDumpMaterial"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefra-con-bombas-o-bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefra con bombas o bloques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bomb or block tephra</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito piroclástico en el que los fragmentos de tamaño superior a 64 mm constituyen más del 25% en volumen de los piroclastos</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic deposit in which fragments larger than 64 mm constitute more than 25% by volume of the pyroclasts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashBrecciaBombOrBlockTephra"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/toba-de-lapilli">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">toba de lapilli</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lapilli tuff</skos:prefLabel>
    <skos:altLabel xml:lang="es">lapillita</skos:altLabel>
    <skos:definition xml:lang="es">Roca piroclástica en la que los fragmentos de lapilli constituyen más del 75% en volumen del contenido piroclástico</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock in which lapilli fragments constitute more than 75% by volume of the pyroclastic content</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gabroide-foidico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gabroide foídico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic gabbroid</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca gabroica foídica</skos:altLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de las rocas de tipo gabro y monzogabro foídicos</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of foidic gabbro and monzogabbro type rocks</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidGabbroid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_gabbroid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/albitita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">albitita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">albitite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea o metasomática compuesta esencialmente de albita</skos:definition>
    <skos:definition xml:lang="en">Igneous or metasomatic rock composed essentially of albite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparSyenite"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAlkaliFeldsparTrachyte"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-litarenitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena litarenítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithoarenitic sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que la proporción de granos de cuarzo es inferior al 75% y el contenido de granos de fragmentos de otras rocas es mayor que el de feldespatos</skos:definition>
    <skos:definition xml:lang="en">Sand in which the proportion of quartz grains is below 75% and the content of rock fragment grains is greater than that of feldspars</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-metamorficos-materiales-de-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Metamórficos / Materiales de Falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Metamorphic Materials / Fault Materials</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Metamórficos / Materiales de Falla, que se caracteriza por agrupar, dentro de los materiales metamórficos, aquellos materiales formados como resultado de la deformación en una zona de falla.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Metamorphic Materials / Fault Materials, characterized by grouping, within metamorphic materials, those materials formed as a result of deformation in a fault zone.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-de-falla"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-de-falla"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/megabrecha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">megabrecha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">megabreccia</skos:prefLabel>
    <skos:definition xml:lang="es">Brecha que contiene bloques de más de 400 m de longitud, generada por deslizamiento gravitacional pendiente abajo de un gran cabalgamiento. su origen es parcialmente tectónico y sedimentario</skos:definition>
    <skos:definition xml:lang="en">Breccia containing blocks more than 400 m long, generated by downslope gravitational sliding of a large thrust sheet. Its origin is partly tectonic and sedimentary</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava-fina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava fina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fine gravel</skos:prefLabel>
    <skos:altLabel xml:lang="es">gravilla</skos:altLabel>
    <skos:definition xml:lang="es">Grava constituida por cantos de tamaño comprendido entre 2 y 4 mm</skos:definition>
    <skos:definition xml:lang="en">Gravel consisting of clasts with a size between 2 and 4 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gravel"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lodo-industrial">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lodo industrial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">industrial sludge</skos:prefLabel>
    <skos:definition xml:lang="es">Subproducto, más o menos líquido en el momento de su vertido, de procesos industriales</skos:definition>
    <skos:definition xml:lang="en">More or less liquid by-product at the time of discharge, from industrial processes</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sludge"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tectita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tectita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tektite</skos:prefLabel>
    <skos:definition xml:lang="es">Pequeño cuerpo vítreo, normalmente de tamaño inferior a 5 cm, de color negruzco, contorno redondeado y forma de gota, lágrima o pera, a veces de superficie no lisa, rico en sílice y con escaso contenido en agua. se supone que se trata de material fundido formado por el impacto de grandes meteoritos sobre la superficie de la tierra y lanzado a centenares de kilómetros de distancia, concentrándose en niveles estratigráficos muy concretos y en amplias extensiones</skos:definition>
    <skos:definition xml:lang="en">Small glassy body, generally smaller than 5 cm, blackish in colour, rounded in outline and droplet-, tear- or pear-shaped, sometimes with a non-smooth surface, rich in silica and with low water content. It is thought to be melted material formed by the impact of large meteorites on the Earth's surface and projected hundreds of kilometres away, concentrated in very specific stratigraphic levels and over large areas</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impactGeneratedMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impact_generated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/conglomerado-s.l.">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">conglomerado s.l.</skos:prefLabel>
    <skos:prefLabel xml:lang="en">conglomerate s.l.</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria compuesta al menos por un 30% de fragmentos redondeados o subangulosos de diámetro superior a 2 mm. si la roca está mal seleccionada, con granulometría muy variada, también puede ser considerada una diamictita</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock composed of at least 30% rounded or subangular fragments with a diameter exceeding 2 mm. If the rock is poorly sorted with very variable grain size, it may also be considered a diamictite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/genericConglomerate"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/generic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/harburgita-harzburgita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">harburgita harzburgita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">harzburgite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultramáfica de la familia de las peridotitas compuesta por olivino y ortopiroxeno como minerales esenciales</skos:definition>
    <skos:definition xml:lang="en">Ultramafic rock of the peridotite family composed of olivine and orthopyroxene as essential minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peridotite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/nefelinita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">nefelinita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nephelinite</skos:prefLabel>
    <skos:definition xml:lang="es">Foidita de color oscuro, que tiene como minerales esenciales nefelina, piroxeno y, con frecuencia, olivino</skos:definition>
    <skos:definition xml:lang="en">Dark-coloured foidite having nepheline, pyroxene and frequently olivine as essential minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/riolita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">riolita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar rhyolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica leucocrática de la familia de las rocas riolíticas, en la que el feldespato alcalino constituye más del 90% del total de los feldespatos. su equivalente plutónico es el granito de feldespato alcalino</skos:definition>
    <skos:definition xml:lang="en">Leucocratic volcanic rock of the rhyolitic rock family, in which alkali feldspar constitutes more than 90% of the total feldspars. Its plutonic equivalent is alkali feldspar granite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparRhyolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_rhyolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ooesparita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ooesparita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oosparite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica esparítica en la que menos del 25% de los aloquímicos corresponden a intraclastos y más del 25%, a ooides</skos:definition>
    <skos:definition xml:lang="en">Sparitic allochemical limestone in which less than 25% of the allochems correspond to intraclasts and more than 25% to ooids</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/porfido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pórfido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">porphyry</skos:prefLabel>
    <skos:definition xml:lang="es">Roca subvolcánica o filoniana de textura porfídica, que contiene fenocristales de cuarzo o feldespato, incluidos en una matriz vítrea o microcristalina</skos:definition>
    <skos:definition xml:lang="en">Subvolcanic or dyke rock of porphyritic texture, containing quartz or feldspar phenocrysts enclosed in a glassy or microcrystalline groundmass</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/porphyry"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/porphyry"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sienita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sienita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid-bearing syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas sieníticas, que contiene feldespatoides. es el equivalente intrusivo de la traquita con foides</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of syenitic rocks, containing feldspathoids. It is the intrusive equivalent of foid-bearing trachyte</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ortopiroxenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ortopiroxenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">orthopyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Piroxenita constituida en más del 90% por ortopiroxeno, con otros minerales ferromagnesianos como accesorios</skos:definition>
    <skos:definition xml:lang="en">Pyroxenite consisting of more than 90% orthopyroxene, with other ferromagnesian minerals as accessories</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava-de-bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava de bloques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">block gravel</skos:prefLabel>
    <skos:definition xml:lang="es">Rudita sin cementar constituida en más de un 50% por bloques</skos:definition>
    <skos:definition xml:lang="en">Uncemented rudite consisting of more than 50% boulders</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boulderGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boulder_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-carbonatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito carbonatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">sedimento carbonatado</skos:altLabel>
    <skos:definition xml:lang="es">Depósito compuesto en más de un 50% por minerales carbonatados</skos:definition>
    <skos:definition xml:lang="en">Deposit composed of more than 50% carbonate minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/asfalto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">asfalto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">asphalt</skos:prefLabel>
    <skos:definition xml:lang="es">Bitumen negro, muy viscoso o sólido, raramente en estado libre, pero frecuente en impregnaciones de determinadas rocas sedimentarias o sedimentos</skos:definition>
    <skos:definition xml:lang="en">Black, highly viscous or solid bitumen, rarely in a free state, but frequently as impregnations in certain sedimentary rocks or sediments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/bitumen"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/blastomilonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">blastomilonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">blastomylonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca milonítica que ha sufrido recristalización estática de parte de la fábrica después de la deformación</skos:definition>
    <skos:definition xml:lang="en">Mylonitic rock that has undergone static recrystallization of part of its fabric after deformation</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/floatstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">floatstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">floatstone</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento o roca carbonática, matriz-soportados, con más del 10% de granos de tamaño superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Matrix-supported carbonate sediment or rock, with more than 10% grains with a diameter exceeding 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-de-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material de falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fault material</skos:prefLabel>
    <skos:definition xml:lang="es">Material formado como resultado de la deformación en una zona de falla</skos:definition>
    <skos:definition xml:lang="en">Material formed as a result of deformation in a fault zone</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fault-relatedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fault_related_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/biopelmicrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">biopelmicrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biopelmicrite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica micrítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides comprendida entre 1:3 y 3:1</skos:definition>
    <skos:definition xml:lang="en">Micritic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio between 1:3 and 3:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sanukita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sanukita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sanukite</skos:prefLabel>
    <skos:definition xml:lang="es">Andesita rica en mg caracterizada por la presencia de ortopiroxeno y plagioclasa en una matriz vítrea. se distingue de la boninita por tener un contenido en tio2 mayor del 0,5%</skos:definition>
    <skos:definition xml:lang="en">Mg-rich andesite characterized by the presence of orthopyroxene and plagioclase in a glassy groundmass. Distinguished from boninite by having a TiO2 content above 0.5%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/andesite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pantelerita-pantellerita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pantelerita pantellerita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pantellerite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad de riolita, peralcalina, más pobre en óxido de aluminio frente a óxido ferroso que la comendita</skos:definition>
    <skos:definition xml:lang="en">Variety of rhyolite, peralkaline, poorer in aluminium oxide relative to ferrous oxide than comendite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/rhyolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rhyolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-gabroica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca gabroica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gabbroic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Gabroide melanocrato en el que la plagioclasa, predominantemente cálcica, constituye más del 90% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Melanocratic gabbroid in which plagioclase, predominantly calcic, constitutes more than 90% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/clinopiroxenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">clinopiroxenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clinopyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Piroxenita constituida en más del 90% por clinopiroxeno, con otros minerales ferromagnesianos como accesorios</skos:definition>
    <skos:definition xml:lang="en">Pyroxenite consisting of more than 90% clinopyroxene, with other ferromagnesian minerals as accessories</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-siliceo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material sedimentario silíceo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">siliceous sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario compuesto en más de un 50% por sílice de origen biogénico o químico. se excluyen las rocas detríticas</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material composed of more than 50% silica of biogenic or chemical origin. Detrital rocks are excluded</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/biolitita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">biolitita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biolithite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza bioconstruida, formada por organismos en posición de vida, como las que se forman en los arrecifes</skos:definition>
    <skos:definition xml:lang="en">Bioclastic limestone formed by reef-building organisms, generally in life position, such as those forming in reefs</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boundstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boundstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gneis">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gneis</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gneiss</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica granuda que presenta estructura gnéisica, estructura definida por la orientación preferente de minerales de grano medio a grueso, que confiere a la roca una foliación grosera, peor definida, más espaciada y más discontinua que la estructura esquistosa, y en la que las bandas suelen ser de mineralogía, tamaño de grano o textura contrastados</skos:definition>
    <skos:definition xml:lang="en">Granular metamorphic rock showing a gneissic structure, defined by the preferred orientation of medium- to coarse-grained minerals, which imparts to the rock a coarse, less well-defined, more widely spaced and more discontinuous foliation than schistose structure, and in which the bands are usually of contrasting mineralogy, grain size or texture</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gneiss"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gneiss"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granito-calcoalcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granito calcoalcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calc-alkaline granite</skos:prefLabel>
    <skos:definition xml:lang="es">Granito metaluminoso o ligeramente peraluminoso, con valores de al2o3/na2o+k2o en proporciones molares superiores a 1, y relativamente rico en calcio. como minerales varietales suele contener biotita ± anfíbol cálcico ± titanita</skos:definition>
    <skos:definition xml:lang="en">Metaluminous or slightly peraluminous granite, with Al2O3/Na2O+K2O values in molar proportions greater than 1 and relatively rich in calcium. As varietal minerals it usually contains biotite ± calcic amphibole ± titanite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/foidita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">foidita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica o ultrabásica, ultraalcalina, perteneciente a la familia de las rocas foídicas, en la que los feldespatoides representan más del 90% del total de los minerales félsicos de la roca</skos:definition>
    <skos:definition xml:lang="en">Basic or ultrabasic, ultraalkaline volcanic rock belonging to the foidite family, in which feldspathoids represent more than 90% of the total felsic minerals of the rock</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sand</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento compuesto mayoritariamente por granos minerales de tamaño comprendido entre 0.062 y 2 mm</skos:definition>
    <skos:definition xml:lang="en">Sediment composed predominantly of mineral grains with a size between 0.062 and 2 mm</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/particula">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">partícula</skos:prefLabel>
    <skos:prefLabel xml:lang="en">particle</skos:prefLabel>
    <skos:definition xml:lang="es">Mineral detrítico o fragmento de roca de tamaño arcilla inferior a 0.004 mm</skos:definition>
    <skos:definition xml:lang="en">Detrital mineral or rock fragment of clay size (less than 0.004 mm)</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/shonkinita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">shonkinita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">shonkinite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica melanocrática perteneciente al grupo de los sienitoides foídicos, en la que el feldespato alcalino constituye más del 90% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Melanocratic plutonic rock belonging to the group of foid syenitoids, in which alkali feldspar constitutes more than 90% of the feldspars</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/syenitoid"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/syenitoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metafonolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metafonolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metaphonolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición fonolítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of phonolitic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lerzolita-lherzolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lerzolita lherzolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lherzolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultramáfica del grupo de las peridotitas compuesta por olivino y cantidades menores de ortopiroxeno y clinopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Ultramafic rock of the peridotite group composed of olivine and lesser amounts of orthopyroxene and clinopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peridotite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tilloide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tilloide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tilloid</skos:prefLabel>
    <skos:definition xml:lang="es">Roca parecida a las tillitas, pero en la que los caracteres glaciares no aparecen claramente</skos:definition>
    <skos:definition xml:lang="en">Rock similar to tillites, but in which glacial features do not appear clearly</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/yeso-anhidrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">yeso-anhidrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gypsum-anhydrite</skos:prefLabel>
    <skos:definition xml:lang="es">Evaporita compuesta, al menos, por un 50% de yeso o anhidrita</skos:definition>
    <skos:definition xml:lang="en">Evaporite composed of at least 50% gypsum or anhydrite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gypsumOrAnhydrite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rock_gypsum_or_anhydrite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/basalto-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">basalto alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkaline basalt</skos:prefLabel>
    <skos:definition xml:lang="es">Basalto subsaturado rico en álcalis, caracterizado por la ausencia de ortopiroxeno y cuarzo, así como por la presencia de olivino, augita rica en titanio y nefelina normativa</skos:definition>
    <skos:definition xml:lang="en">Undersaturated alkali-rich basalt, characterized by the absence of orthopyroxene and quartz, as well as by the presence of olivine, titanium-rich augite and normative nepheline</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliOlivineBasalt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali-olivine_basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-basica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca básica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea cuyo contenido en sílice está comprendido entre el 45 y el 52%</skos:definition>
    <skos:definition xml:lang="en">Igneous rock whose silica content is between 45 and 52%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basicIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pelita-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pelita arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy pelite</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico en el que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 10 y el 50% y la relación de elementos de tamaño arcilla a tamaño limo está comprendida entre 1:2 y 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 10 and 50% and the ratio of clay-size to silt-size elements is between 1:2 and 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mud"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-afanitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca afanítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">aphanitic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">afanita</skos:altLabel>
    <skos:definition xml:lang="es">Roca ígnea en la que los granos minerales no se distinguen a simple vista</skos:definition>
    <skos:definition xml:lang="en">Igneous rock in which mineral grains are not distinguishable with the naked eye</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/aphanite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/aphanite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arcilla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arcilla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clay</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento pelítico en el que la relación de componentes de tamaño arcilla menos de 0.004 mm a tamaño limo 0.004-0.062 mm es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Pelitic sediment in which the ratio of clay-size components (less than 0.004 mm) to silt-size components (0.004-0.062 mm) exceeds 2:1</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clay"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clay"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/kimberlita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">kimberlita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kimberlite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultrabásica potásica rica en volátiles, con textura inequigranular y macrocristales de olivino, ilmenita rica en mg, granate, diópsido, flogopita, enstatita y cromita rica en ti, incluidos en una matriz de grano fino formada por olivino, monticellita, flogopita, perovskita, espinela y apatito. generalmente, contiene xenolitos del manto en los que se pueden encontrar diamantes. ascienden rápido a través del manto superior y la corteza y se emplazan explosivamente formando diatremas</skos:definition>
    <skos:definition xml:lang="en">Potassic, volatile-rich ultrabasic rock with inequigranular texture and macrocrysts of olivine, Mg-rich ilmenite, garnet, diopside, phlogopite, enstatite and Ti-rich chromite, enclosed in a fine-grained groundmass of olivine, monticellite, phlogopite, perovskite, spinel and apatite. It generally contains mantle xenoliths in which diamonds may be found. It ascends rapidly through the upper mantle and crust and is emplaced explosively forming diatremes</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy gravel</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico poco seleccionado, constituido en un 30-50% por clastos de más de 2 mm de diámetro y que posee un contenido de elementos de tamaño arena mayor que el de elementos de tamaño pelita</skos:definition>
    <skos:definition xml:lang="en">Poorly sorted detrital sediment consisting of 30-50% clasts with a diameter exceeding 2 mm and with a sand-size element content greater than that of pelite-size elements</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gravel"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/polder">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pólder</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polder</skos:prefLabel>
    <skos:definition xml:lang="es">Materiales empleados para ganar artificialmente terreno al mar o a un lago</skos:definition>
    <skos:definition xml:lang="en">Materials used to artificially reclaim land from the sea or a lake</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-metamorfica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca metamórfica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metamorphic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca derivada de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales, esencialmente en estado sólido y sin cambiar significativamente la composición química del conjunto de la roca, en respuesta a variaciones físico-químicas, principalmente de presión y temperatura, quedando excluidas las rocas derivadas de procesos de meteorización o formación de suelos</skos:definition>
    <skos:definition xml:lang="en">Rock derived from a pre-existing rock, through mineralogical, chemical or structural changes, essentially in solid state and without significantly changing the overall chemical composition of the rock, in response to physicochemical variations, mainly of pressure and temperature, excluding rocks derived from weathering or soil-forming processes</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomia-con-bioclastos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomía con bioclastos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomite with bioclasts</skos:prefLabel>
    <skos:definition xml:lang="es">Dolomía en la que se reconocen fantasmas de aloquímicos, de entre los que predominan los bioclastos</skos:definition>
    <skos:definition xml:lang="en">Dolostone in which ghosts of allochems are recognized, among which bioclasts predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-oolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza oolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oolitic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza formada mayoritariamente por ooides cementados, parcial o totalmente, por carbonato cálcico</skos:definition>
    <skos:definition xml:lang="en">Limestone formed predominantly by ooids cemented, partially or totally, by calcium carbonate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/piroxenita-hornblendica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">piroxenita hornbléndica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hornblende pyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultramáfica constituida esencialmente por piroxeno y, en menor proporción, hornblenda</skos:definition>
    <skos:definition xml:lang="en">Ultramafic rock consisting essentially of pyroxene and, in lesser proportion, hornblende</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-de-impacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca de impacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impact rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">impactita</skos:altLabel>
    <skos:definition xml:lang="es">Cualquier material producido por el impacto de un cuerpo extraterrestre</skos:definition>
    <skos:definition xml:lang="en">Any material produced by the impact of an extraterrestrial body</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impactGeneratedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impact_generated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/conglomerado-polimictico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">conglomerado polimíctico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polymictic conglomerate</skos:prefLabel>
    <skos:altLabel xml:lang="es">conglomerado poligénico</skos:altLabel>
    <skos:altLabel xml:lang="en">polygenetic conglomerate</skos:altLabel>
    <skos:definition xml:lang="es">Conglomerado constituido por cantos de diferentes tipos de roca</skos:definition>
    <skos:definition xml:lang="en">Conglomerate consisting of clasts of different rock types</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/micrita-con-peloides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">micrita con peloides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micrite with peloids</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza micrítica con aloquímicos, de entre los que predominan los peloides</skos:definition>
    <skos:definition xml:lang="en">Micritic limestone with allochems, among which peloids predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/porcelanita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">porcelanita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">porcelanite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria silícea, generalmente con una porosidad del 15-30%, de aspecto semejante a la porcelana</skos:definition>
    <skos:definition xml:lang="en">Siliceous sedimentary rock, generally with 15-30% porosity, of porcelain-like appearance</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metarcosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metarcosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metarkose</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición arcósica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of arkosic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/canto-facetado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">canto facetado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">faceted pebble</skos:prefLabel>
    <skos:altLabel xml:lang="es">ventifacto</skos:altLabel>
    <skos:definition xml:lang="es">Canto que ha sido pulimentado por la acción del viento cargado de arena, produciendo planos en su superficie que le dan aspecto poliédrico</skos:definition>
    <skos:definition xml:lang="en">Clast polished by wind-blown sand, producing planes on its surface that give it a polyhedral appearance</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-media">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena media</skos:prefLabel>
    <skos:prefLabel xml:lang="en">medium sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que predominan los granos de diámetro comprendido entre 0.25 y 0.5 mm</skos:definition>
    <skos:definition xml:lang="en">Sand in which grains with a diameter between 0.25 and 0.5 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzodiorita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzodiorita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid-bearing monzodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas monzodioríticas, que contiene feldespatoides</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of monzodioritic rocks, containing feldspathoids</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingMonzodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_monzodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granulita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granulita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granulite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de grado alto a muy alto, de textura generalmente granoblástica y estructura gnéisica o masiva, dominada por minerales anhidros y feldespatos. en caso de composición máfica, está constituida por clinopiroxeno augítico, ortopiroxeno, plagioclasa cálcica, con o sin granate, y cuarzo. en caso de composición cuarzo-feldespática, está constituida por cuarzo, plagioclasa, feldespato potásico y ortopiroxeno, con o sin biotita, granate, cordierita y sillimanita</skos:definition>
    <skos:definition xml:lang="en">High- to very high-grade metamorphic rock, generally of granoblastic texture and gneissic or massive structure, dominated by anhydrous minerals and feldspars. In mafic composition, it consists of augitic clinopyroxene, orthopyroxene, calcic plagioclase, with or without garnet, and quartz. In quartz-feldspathic composition, it consists of quartz, plagioclase, potassic feldspar and orthopyroxene, with or without biotite, garnet, cordierite and sillimanite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/voguesita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">voguesita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">vogesite</skos:prefLabel>
    <skos:definition xml:lang="es">Lamprófido calcoalcalino rico en anfíbol y feldespato potásico</skos:definition>
    <skos:definition xml:lang="en">Calc-alkaline lamprophyre rich in amphibole and potassic feldspar</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/diatomita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">diatomita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diatomite</skos:prefLabel>
    <skos:altLabel xml:lang="es">trípoli</skos:altLabel>
    <skos:definition xml:lang="es">Roca silícea ligera, de color claro, generalmente con una porosidad del 50-90% y formada principalmente por caparazones de diatomeas</skos:definition>
    <skos:definition xml:lang="en">Lightweight, light-coloured siliceous rock, generally with 50-90% porosity and formed mainly by diatom frustules</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/siliceousOoze"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/siliceous_ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ortoconglomerado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ortoconglomerado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">orthoconglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Conglomerado constituido por cantos y bloques dispuestos en contacto entre sí, entre los que la matriz arenosa o pelítica se presenta en proporción inferior al 15%</skos:definition>
    <skos:definition xml:lang="en">Conglomerate consisting of clasts and blocks in mutual contact, with a sandy or pelitic matrix in proportions below 15%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/migmatita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">migmatita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">migmatite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca resultante de la cristalización del migma, formada por paleosoma y neosoma</skos:definition>
    <skos:definition xml:lang="en">Rock resulting from the crystallization of migma, formed by paleosome and neosome</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/migmatite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/migmatite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-travertinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza travertínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">travertine limestone</skos:prefLabel>
    <skos:altLabel xml:lang="es">masa travertínica, toba calcárea, travertino</skos:altLabel>
    <skos:definition xml:lang="es">Caliza de color claro, con textura a menudo porosa o tubular, formada por precipitación de carbonato cálcico en el seno del agua, muchas veces sobre restos vegetales</skos:definition>
    <skos:definition xml:lang="en">Light-coloured limestone, often with porous or tubular texture, formed by the precipitation of calcium carbonate in water, often around plant remains</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/travertine"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/travertine"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-calcarea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca calcárea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcareous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria carbonatada cuyo constituyente principal es el carbonato cálcico, de los componentes restantes, el más frecuente y dominante es el carbonato de magnesio, siendo accesorios los silicatos o los productos de su alteración como arcillas y sílice, así como la pirita y la siderita. la variedad pura tiene, al menos, un 95% de caco3 y las variedades impuras, más del 10% de dolomita o de impurezas. su origen puede ser predominantemente biológico, químico o mixto</skos:definition>
    <skos:definition xml:lang="en">Sedimentary carbonate rock whose principal constituent is calcium carbonate; of the remaining components, magnesium carbonate is the most frequent and dominant, with silicates or their alteration products (clay and silica) as well as pyrite and siderite being accessory. The pure variety has at least 95% CaCO3 and the impure varieties more than 10% dolomite or impurities. Its origin may be predominantly biological, chemical or mixed</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/calcareousCarbonateSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/calcareous_carbonate_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-arcillosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena arcillosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clayey sand</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico en el que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 50 y el 90% y la relación de elementos de tamaño arcilla a tamaño limo es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 50 and 90% and the ratio of clay-size to silt-size elements exceeds 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/diorita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">diorita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid-bearing diorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas dioríticas, que contiene feldespatoides</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of dioritic rocks, containing feldspathoids</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingDiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_diorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/turba">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">turba</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peat</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad de carbón constituida por un sedimento rico en materia orgánica, ligero, de color pardo amarillento a negro, que conserva la estructura vegetal. su contenido en carbono es inferior al 60% y el de volátiles, superior al 63%</skos:definition>
    <skos:definition xml:lang="en">Coal variety consisting of an organic matter-rich sediment, lightweight, brownish-yellow to black in colour, preserving plant structure. Its carbon content is below 60% and the volatile matter content exceeds 63%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/peat"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peat"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-epiclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material epiclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">epiclastic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material volcanoclástico que contiene fragmentos de origen volcánico con evidencias de haber sido transportados por algún medio sedimentario</skos:definition>
    <skos:definition xml:lang="en">Volcaniclastic material containing volcanic fragments showing evidence of having been transported by some sedimentary medium</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metandesita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metandesita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">meta-andesite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición andesítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of andesitic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/anortosita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">anortosita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid-bearing anorthosite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas anortosíticas, que contiene feldespatoides</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of anorthositic rocks, containing feldspathoids</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingAnorthosite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_anorthosite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metatraquita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metatraquita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metatrachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición traquítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of trachytic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-andesitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca andesítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">andesitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica/subvolcánica intermedia, calcoalcalina, constituida principalmente por plagioclasa, piroxeno y anfíbol, pudiendo incluir cantidades menores de biotita, olivino o cuarzo</skos:definition>
    <skos:definition xml:lang="en">Intermediate, calc-alkaline volcanic/subvolcanic rock, composed mainly of plagioclase, pyroxene and amphibole, and possibly including lesser amounts of biotite, olivine or quartz</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/andesite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/micrita-con-bioclastos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">micrita con bioclastos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micrite with bioclasts</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza micrítica con aloquímicos, de entre los que predominan los bioclastos</skos:definition>
    <skos:definition xml:lang="en">Micritic limestone with allochems, among which bioclasts predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-calcareo-impuro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento calcáreo impuro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure calcareous sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento con un contenido de calcita más aragonito superior al de dolomita y en el que los minerales carbonatados constituyen entre el 50 y el 90% del total</skos:definition>
    <skos:definition xml:lang="en">Sediment with a calcite plus aragonite content greater than that of dolomite and in which carbonate minerals constitute between 50 and 90% of the total</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureCalcareousCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_calcareous_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-fosfatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito fosfatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phosphate deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">sedimento fosfatado</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento compuesto en más de un 50% por minerales fosfatados</skos:definition>
    <skos:definition xml:lang="en">Sediment composed of more than 50% phosphate minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phosphateRichSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phosphate_rich_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arcilla-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arcilla arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy clay</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico en el que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 10 y el 50% y la relación de elementos de tamaño arcilla a tamaño limo es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 10 and 50% and the ratio of clay-size to silt-size elements exceeds 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clay"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clay"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fertilizante">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fertilizante</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fertilizer</skos:prefLabel>
    <skos:definition xml:lang="es">Material que se añade al suelo para mejorar el crecimiento y la calidad de las plantas</skos:definition>
    <skos:definition xml:lang="en">Material added to soil to improve plant growth and quality</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/soilImprover"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-toleitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca toleítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tholeiitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Término utilizado para rocas basálticas pobres en potasio que forman parte de series magmáticas subalcalinas con fuerte enriquecimiento en hierro en las etapas iniciales de la diferenciación</skos:definition>
    <skos:definition xml:lang="en">Term used for potassium-poor basaltic rocks forming part of subalkaline magmatic series with strong iron enrichment in the early stages of differentiation</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tholeiiticBasalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tholeiitic_basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/limolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">limolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">siltstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida, al menos en un 50%, por elementos de tamaño comprendido entre 0.004 y 0.062 mm</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of at least 50% elements with a size between 0.004 and 0.062 mm</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/siltstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/siltstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fango">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fango</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ooze</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento pelágico constituido en más de un 30% por restos de organismos y el resto, por minerales de la arcilla</skos:definition>
    <skos:definition xml:lang="en">Pelagic sediment consisting of more than 30% organic remains with the rest being clay minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ooze"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ooze"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-aloquimica-esparitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza aloquímica esparítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sparitic allochemical limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica con un contenido de esparita mayor que el de micrita</skos:definition>
    <skos:definition xml:lang="en">Allochemical limestone with a sparite content greater than that of micrite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-ultrabasica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca ultrabásica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultrabasic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea que contiene menos de un 45% de sílice</skos:definition>
    <skos:definition xml:lang="en">Igneous rock containing less than 45% silica</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ultrabasicIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ultrabasic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/milonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">milonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mylonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca milonítica cuya matriz constituye entre el 50 y el 90% del volumen de la roca</skos:definition>
    <skos:definition xml:lang="en">Mylonitic rock whose matrix constitutes between 50 and 90% of the rock volume</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzomonzonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzomonzonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz monzonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas monzoníticas, que contiene cuarzo en una cantidad comprendida entre el 5 y el 20% de los minerales félsicos. es el equivalente intrusivo de la cuarzolatita</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of monzonitic rocks, containing quartz in an amount between 5 and 20% of the felsic minerals. It is the intrusive equivalent of quartz latite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzMonzonite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_monzonite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gilsonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gilsonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gilsonite</skos:prefLabel>
    <skos:definition xml:lang="es">Asfaltita extraordinariamente pura, negra, brillante y de fractura concoidea. tiene una dureza de 2 a 2,5 y un peso específico de 1,07. contiene del 10 al 20% de carbono y arde fácilmente con llama luminosa</skos:definition>
    <skos:definition xml:lang="en">Extraordinarily pure asphaltite, black, shiny and with conchoidal fracture. It has a hardness of 2 to 2.5 and a specific gravity of 1.07. It contains 10 to 20% carbon and burns readily with a luminous flame</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/bitumen"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/toba-de-ceniza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">toba de ceniza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ash tuff</skos:prefLabel>
    <skos:altLabel xml:lang="es">cinerita, toba cinerítica</skos:altLabel>
    <skos:definition xml:lang="es">Roca piroclástica en la que los fragmentos de ceniza constituyen más del 75% en volumen del contenido piroclástico</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock in which ash fragments constitute more than 75% by volume of the pyroclastic content</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/websterita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">websterita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">websterite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad de piroxenita constituida esencialmente por orto y clinopironexo</skos:definition>
    <skos:definition xml:lang="en">Variety of pyroxenite consisting essentially of ortho- and clinopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grauvaca-feldespatica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grauvaca feldespática</skos:prefLabel>
    <skos:prefLabel xml:lang="en">feldspathic graywacke</skos:prefLabel>
    <skos:definition xml:lang="es">Grauvaca en la que la proporción de cuarzo es inferior al 95% de los granos y el contenido de feldespatos es mayor que el de fragmentos de otras rocas</skos:definition>
    <skos:definition xml:lang="en">Greywacke in which the proportion of quartz is below 95% of the grains and the feldspar content is greater than that of rock fragments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/wacke"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/wacke"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metabasita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metabasita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metabasite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una roca de composición básica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a rock of basic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/troctolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">troctolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">troctolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de la familia de los gabros constituida por plagioclasa cálcica y que tiene olivino como mineral ferromagnesiano dominante</skos:definition>
    <skos:definition xml:lang="en">Rock of the gabbro family consisting of calcic plagioclase and having olivine as the dominant ferromagnesian mineral</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grauvaca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grauvaca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">graywacke</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca en la que el contenido de matriz detrítica fina está comprendido entre el 15 y el 75% del total de la roca</skos:definition>
    <skos:definition xml:lang="en">Sandstone in which the content of fine detrital matrix is between 15 and 75% of the total rock</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/wacke"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/wacke"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutacea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutácea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lutaceous</skos:prefLabel>
    <skos:definition xml:lang="es">Clase, grupo o textura de las rocas sedimentarias o los sedimentos detríticos constituidos en más del 50% por partículas muy finas, de menos de 0.062 mm</skos:definition>
    <skos:definition xml:lang="en">Class, group or texture of sedimentary rocks or detrital sediments consisting of more than 50% very fine particles, less than 0.062 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mud"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/diamictita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">diamictita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diamictite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica que contiene clastos de un amplio rango de tamaños desde granos a bloques, rodeados de matriz fundamentalmente arcillosa</skos:definition>
    <skos:definition xml:lang="en">Detrital rock containing clasts of a wide size range, from grains to boulders, surrounded by a predominantly clayey matrix</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/diamictite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/diamictite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/werlita-wehrlita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">werlita wehrlita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wehrlite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultramáfica del grupo de las peridotitas compuesta por olivino y clinopiroxeno como minerales esenciales</skos:definition>
    <skos:definition xml:lang="en">Ultramafic rock of the peridotite group composed of olivine and clinopyroxene as essential minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/peridotite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/peridotite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pseudotaquilita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pseudotaquilita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pseudotachylite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cataclástica de aspecto vítreo, grano extrafino y color negro, originada como consecuencia de la fusión parcial debida al calor generado por el rozamiento de las rocas al deslizarse a lo largo de una superficie de falla. su formación puede deberse también al impacto de un meteorito</skos:definition>
    <skos:definition xml:lang="en">Glassy-appearing, extra-fine-grained, black cataclastic rock, originating as a consequence of partial melting due to the heat generated by friction of rocks sliding along a fault surface. Its formation may also be due to meteorite impact</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bioesparrudita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bioesparrudita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biosparrudite</skos:prefLabel>
    <skos:definition xml:lang="es">Bioesparita en la que más del 25% de los aloquímicos tienen un diámetro superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Biosparite in which more than 25% of the allochems have a diameter exceeding 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenacea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">psamita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">psammite</skos:prefLabel>
    <skos:altLabel xml:lang="es">arenácea</skos:altLabel>
    <skos:altLabel xml:lang="en">arenaceous</skos:altLabel>
    <skos:definition xml:lang="es">Clase, grupo o textura de los sedimentos o rocas sedimentarias detríticas cuyo tamaño medio de los granos está comprendido entre 0.062 y 2 mm</skos:definition>
    <skos:definition xml:lang="en">Class, group or texture of detrital sediments or sedimentary rocks whose mean grain size is between 0.062 and 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/encrinita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">encrinita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">encrinite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza bioclástica formada mayoritariamente por fragmentos de crinoides</skos:definition>
    <skos:definition xml:lang="en">Bioclastic limestone formed predominantly by crinoid fragments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/varva">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">varva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">varve</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento formado por asociaciones de láminas en las que alternan niveles más claros limo o arena muy fina con otros más oscuros arcilla, característico de medios lacustres, y cuyo origen va ligado a los cambios climáticos estacionales</skos:definition>
    <skos:definition xml:lang="en">Sediment formed by associations of laminae alternating lighter levels (silt or very fine sand) with darker levels (clay), characteristic of lacustrine environments, and whose origin is linked to seasonal climatic changes</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartzolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica en la que el cuarzo constituye más del 90% de los minerales félsicos</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock in which quartz constitutes more than 90% of the felsic minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-dolomitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento dolomítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomitic sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento carbonatado con un contenido de dolomita superior al de calcita más aragonito</skos:definition>
    <skos:definition xml:lang="en">Carbonate sediment with a dolomite content greater than that of calcite plus aragonite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomiticSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolomitic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-gruesa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena gruesa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coarse sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que predominan los granos de diámetro comprendido entre 0.5 y 1.0 mm</skos:definition>
    <skos:definition xml:lang="en">Sand in which grains with a diameter between 0.5 and 1.0 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomia-con-peloides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomía con peloides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomite with peloids</skos:prefLabel>
    <skos:definition xml:lang="es">Dolomía en la que se reconocen fantasmas de aloquímicos, de entre los que predominan los peloides</skos:definition>
    <skos:definition xml:lang="en">Dolostone in which ghosts of allochems are recognized, among which peloids predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/fenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">fenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metasomática, generalmente formada en torno a intrusiones de carbonatitas, ijolitas o, más raramente, sienitas nefelínicas, compuesta por feldespatos alcalinos, piroxenos y anfíboles sódicos y, ocasionalmente, feldespatoides y carbonatos</skos:definition>
    <skos:definition xml:lang="en">Metasomatic rock, generally formed around intrusions of carbonatites, ijolites or, more rarely, nepheline syenites, composed of alkali feldspars, sodic pyroxenes and amphiboles and, occasionally, feldspathoids and carbonates</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/alaskita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">alaskita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alaskite</skos:prefLabel>
    <skos:definition xml:lang="es">Granito muy leucocrático formado por cuarzo y feldespatos alcalinos</skos:definition>
    <skos:definition xml:lang="en">Very leucocratic granite formed by quartz and alkali feldspars</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefra-de-lapilli">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefra de lapilli</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lapilli tephra</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito piroclástico formado en más de un 75% de su volumen por fragmentos de diámetro comprendido entre 2 y 64 mm</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic deposit formed by more than 75% by volume of fragments with a diameter between 2 and 64 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashAndLapilli"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_and_lapilli"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/agata">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ágata</skos:prefLabel>
    <skos:prefLabel xml:lang="en">agate</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad de la calcedonia, de textura característica, que se presenta en zonas concéntricas de diversa coloración</skos:definition>
    <skos:definition xml:lang="en">Variety of chalcedony with a characteristic texture, presenting concentric zones of diverse colouration</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/borax">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bórax</skos:prefLabel>
    <skos:prefLabel xml:lang="en">borax</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula na2b4o7.10h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema monoclínico formando grandes cristales prismáticos o masas terrosas. es incoloro o blanquecino, aunque generalmente presenta tonalidades grises o azuladas, tiene brillo vítreo y varía de transparente a translúcido</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula Na2B4O7·10H2O, belonging to the class of borates, crystallizing in the monoclinic system forming large prismatic crystals or earthy masses. It is colourless or whitish, although it generally presents grey or bluish hues, with vitreous lustre and varying from transparent to translucent</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-igneo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material ígneo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">igneous material</skos:prefLabel>
    <skos:definition xml:lang="es">Material resultante del enfriamiento y la solidificación de un magma. puede ser volcánico o plutónico, según se emplace en la superficie o en el interior de la corteza terrestre</skos:definition>
    <skos:definition xml:lang="en">Material resulting from the cooling and solidification of a magma. It can be volcanic or plutonic, depending on whether it is emplaced at the surface or in the interior of the Earth's crust</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-ricos-en-materia-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Ricos en Materia Orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Organic-Rich Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Ricos en Materia Orgánica, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos con contenido significativo de materia orgánica.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Organic-Rich Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments with significant organic matter content.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-rico-en-materia-organica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-rica-en-materia-organica"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lidita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lidita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lydite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad del sílex, de color gris o negro debido su contenido de materia carbonosa, con radiolarios, formada por calcedonia y cuarzo criptocristalino</skos:definition>
    <skos:definition xml:lang="en">Variety of chert, grey or black in colour due to its carbonaceous matter content, with radiolarians, formed by chalcedony and cryptocrystalline quartz</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-doleritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca dolerítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">doleritic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca subvolcánica oscura de composición gabroica basáltica o diorítica andesítica, generalmente masiva y compacta, de tamaño de grano intermedio entre basalto y gabro, compuesta por plagioclasa, piroxeno y minerales opacos, a veces con olivino, ocasionalmente presenta textura dolerítica y, más frecuentemente, ofítica. incluye a dolerita, microdiorita, diabasa y microgabro</skos:definition>
    <skos:definition xml:lang="en">Dark subvolcanic rock of gabbroic-basaltic or dioritic-andesitic composition, generally massive and compact, of grain size intermediate between basalt and gabbro, composed of plagioclase, pyroxene and opaque minerals, sometimes with olivine; occasionally with doleritic texture and, more frequently, ophitic texture. Includes dolerite, microdiorite, diabase and microgabbro</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-detriticos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos detríticos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Detrital Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Detríticos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos compuestos en más de un 50% por fragmentos de otras rocas y minerales preexistentes.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Detrital Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments composed of more than 50% fragments from pre-existing rocks and minerals.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-clastico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-clastico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-clastica"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-polimictica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha polimíctica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polymictic breccia</skos:prefLabel>
    <skos:altLabel xml:lang="es">brecha poligénica</skos:altLabel>
    <skos:altLabel xml:lang="en">poligenic breccia</skos:altLabel>
    <skos:definition xml:lang="es">Brecha constituida por cantos de diferentes tipos de roca</skos:definition>
    <skos:definition xml:lang="en">Breccia consisting of clasts of different rock types</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/verita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">verita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">verite</skos:prefLabel>
    <skos:altLabel xml:lang="es">lamproíta con vidrio-olivino-diópsido-flogopita</skos:altLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente a la familia de las lamproítas, de color negro, con fenocristales de flogopita, olivino y diópsido, en una matriz vítrea</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the lamproite family, black in colour, with phenocrysts of phlogopite, olivine and diopside in a glassy groundmass</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metabrecha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metabrecha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metabreccia</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una brecha</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a breccia</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-metamorficos-rocas-metasomaticas-e-hidrotermales">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Metamórficos / Rocas Metasomáticas e Hidrotermales</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Metamorphic Materials / Metasomatic And Hydrothermal Rocks</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Metamórficos / Rocas Metasomáticas e Hidrotermales, que se caracteriza por agrupar, dentro de los materiales metamórficos, aquellas rocas derivadas de un proceso metamórfico por el que se produce un cambio importante en la composición química de la roca, debido a interacción con fluidos hidrotermales o magmas.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Metamorphic Materials / Metasomatic and Hydrothermal Rocks, characterized by grouping, within metamorphic materials, those rocks derived from a metamorphic process in which an important change in the chemical composition of the rock occurs, due to interaction with hydrothermal fluids or magmas.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-hidrotermal"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-metasomatica"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-fosfatados">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Fosfatados</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Phosphatic Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Fosfatados, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellas rocas y sedimentos compuestos en más de un 50% por minerales fosfatados.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Phosphatic Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those rocks and sediments composed of more than 50% phosphate minerals.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-fosfatado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/guano"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-fosfatado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-fosfatada"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/peperita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">peperita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">peperite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de textura clástica generada por la mezcla de una lava o magma con sedimentos no consolidados saturados en agua</skos:definition>
    <skos:definition xml:lang="en">Rock of clastic texture generated by the mixing of a lava or magma with water-saturated unconsolidated sediments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutita-carbonatada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutita carbonatada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carbonate-rich mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria detrítica con un contenido conjunto de elementos de tamaño pelita y de carbonatos igual o superior al 90% del total y en la que la relación de elementos de tamaño pelita con respecto al carbonato está comprendida entre el 50 y el 90%</skos:definition>
    <skos:definition xml:lang="en">Detrital sedimentary rock with a combined content of pelite-size elements and carbonates equal to or exceeding 90% of the total, and in which the ratio of pelite-size elements to carbonate is between 50 and 90%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateRichMudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/basalto-picritico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">basalto picrítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">picritic basalt</skos:prefLabel>
    <skos:definition xml:lang="es">Basalto rico en magnesio, con abundantes fenocristales de olivino y augita</skos:definition>
    <skos:definition xml:lang="en">Magnesium-rich basalt with abundant olivine and augite phenocrysts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/basalt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/basalt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/leucitita-tefritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">leucitita tefrítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephritic leucitite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente a la familia de las rocas foídicas, en la que la plagioclasa predomina sobre el feldespato alcalino y que tiene como minerales esenciales leucita y piroxeno</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the foidite family, in which plagioclase predominates over alkali feldspar and which has leucite and pyroxene as essential minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutita-con-materia-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutita con materia orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organic matter-rich shale</skos:prefLabel>
    <skos:definition xml:lang="es">Lutita con un contenido en materia orgánica del 10-20% del total de la roca</skos:definition>
    <skos:definition xml:lang="en">Mudstone with an organic matter content of 10-20% of the total rock</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/organicBearingMudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_bearing_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sienita-de-feldespato-alcalino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sienita de feldespato alcalino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alkali feldspar syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas sieníticas de feldespato alcalino, que contiene cuarzo, en una cantidad que no supera el 5% de los minerales félsicos, y feldespato alcalino, en proporción superior al 90% de los feldespatos. es el equivalente intrusivo de la traquita de feldespato alcalino</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of alkali feldspar syenitic rocks, containing quartz in an amount not exceeding 5% of the felsic minerals, and alkali feldspar in proportions exceeding 90% of the feldspars. It is the intrusive equivalent of alkali feldspar trachyte</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/alkaliFeldsparSyenite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/alkali_feldspar_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefra-de-bloques">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefra de bloques</skos:prefLabel>
    <skos:prefLabel xml:lang="en">block tephra</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito piroclástico formado en más de un 75% de su volumen por fragmentos de diámetro mayor de 64 mm, entre los que predominan los bloques piroclásticos</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic deposit formed by more than 75% by volume of fragments with a diameter greater than 64 mm, among which pyroclastic blocks predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashBrecciaBombOrBlockTephra"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_breccia_bomb_or_block_tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/flysch-siliceo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">flysch silíceo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silicious flysch</skos:prefLabel>
    <skos:definition xml:lang="es">Tectofacies constituida por una ritmita de de bancos de  areniscas turbidíticas con una mayoría de granos silíceos con un espesor de cientos o miles de metros, depositada en márgenes continentales en las etapas anteriores a su deformación orogénica</skos:definition>
    <skos:definition xml:lang="en">Tectofacies consisting of a rhythmite of turbiditic sandstone beds with a majority of siliceous grains, hundreds to thousands of metres thick, deposited on continental margins in the stages prior to their orogenic deformation</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pelita-s.l.">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pelita s.l.</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelite s.l.</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento que contiene menos de un 30% de clastos de tamaño grava &gt;2 mm de diámetro y una relación entre granos de arena 0.062-2 mm y partículas de lutita &lt;0.062 mm menor que 1, sin especificar su composición o su génesis</skos:definition>
    <skos:definition xml:lang="en">Sediment containing less than 30% gravel-size clasts (&gt;2 mm diameter) and with a ratio of sand grains (0.062-2 mm) to mud particles (&lt;0.062 mm) less than 1, without specifying composition or genesis</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudSizeSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bloque-piroclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bloque piroclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic block</skos:prefLabel>
    <skos:definition xml:lang="es">Piroclasto anguloso o subanguloso de diámetro superior a 64 mm</skos:definition>
    <skos:definition xml:lang="en">Angular or subangular pyroclast with a diameter exceeding 64 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephra"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephra"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dioritoide-foidico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dioritoide foídico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic dioritoid</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca diorítica foídica</skos:altLabel>
    <skos:definition xml:lang="es">Nombre utilizado en la descripción provisional de las rocas de tipo diorita y monzodiorita foídicas</skos:definition>
    <skos:definition xml:lang="en">Name used in the provisional description of foidic diorite and monzodiorite type rocks</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidDioritoid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_dioritoid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-anortositica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca anortosítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anorthositic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica leucocrática en la que la plagioclasa constituye más del 90% de la roca, siendo el piroxeno su mineral máfico más frecuente</skos:definition>
    <skos:definition xml:lang="en">Leucocratic plutonic rock in which plagioclase constitutes more than 90% of the rock, with pyroxene being its most common mafic mineral</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anorthositicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anorthositic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ceniza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ceniza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ash</skos:prefLabel>
    <skos:definition xml:lang="es">1. piroclasto de tamaño de grano inferior a 2 mm. 2. depósito piroclástico formado en más de un 75% de su volumen por fragmentos de diámetro inferior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">1. Pyroclast with a grain size below 2 mm. 2. Pyroclastic deposit formed by more than 75% by volume of fragments with a diameter below 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metaperidotita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metaperidotita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metaperidotite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición peridotítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of peridotitic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/wackestone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">wackestone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wackestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada matriz-soportada, constituida en más del 10% por granos, según la clasificación de dunham 1962</skos:definition>
    <skos:definition xml:lang="en">Matrix-supported carbonate rock, consisting of more than 10% grains, according to the Dunham (1962) classification</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateWackestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_wackestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/microconglomerado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">microconglomerado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">microconglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida, en más de un 50%, por cantos redondeados de entre 2 y 4 mm de diámetro, trabados por un cemento o una matriz detrítica fina</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of more than 50% rounded clasts between 2 and 4 mm in diameter, bound by a cement or fine detrital matrix</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-de-nube-ardiente">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito de nube ardiente</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nuée ardente deposit</skos:prefLabel>
    <skos:definition xml:lang="es">Colada piroclástica generada por el colapso de un domo o de una colada de lava</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic flow generated by the collapse of a dome or a lava flow</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lava-almohadillada">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lava almohadillada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pillow lava</skos:prefLabel>
    <skos:definition xml:lang="es">Tipo de lava cuya superficie está conformada por una serie de abultamientos esferoidales, adosados o interferentes, con aspecto de almohadones. se genera en fondos subacuáticos por enfriamiento rápido de efusiones volcánicas, preferentemente submarinas, y es característica del volcanismo asociado a las dorsales centrooceánicas</skos:definition>
    <skos:definition xml:lang="en">Type of lava whose surface is shaped by a series of spheroidal bulges, adjoined or interfering, with a pillow-like appearance. It is generated on submarine floors by the rapid cooling of volcanic effusions, preferentially submarine, and is characteristic of volcanism associated with mid-oceanic ridges</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/filonita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">filonita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phyllonite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca milonítica rica en mica que, macroscópicamente, tiene el aspecto de una filita, aunque más heterogéneo, pues suele incluir numerosas venas de cuarzo y abundantes superficies de cizalla</skos:definition>
    <skos:definition xml:lang="en">Mica-rich mylonitic rock that macroscopically resembles a phyllite, although more heterogeneous, as it usually includes numerous quartz veins and abundant shear surfaces</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phyllonite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phyllonite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/margocaliza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">margocaliza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">limestone-marl alternation</skos:prefLabel>
    <skos:definition xml:lang="es">Alternancia regular de capas decimétricas de calizas y margas. no es recomendable su uso para designar una caliza arcillosa o margosa</skos:definition>
    <skos:definition xml:lang="en">Regular alternation of decimetre-thick layers of limestones and marls. Its use is not recommended to designate a clayey or marly limestone</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/litarenita-feldespatica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">litarenita feldespática</skos:prefLabel>
    <skos:prefLabel xml:lang="en">feldspathic litharenite</skos:prefLabel>
    <skos:altLabel xml:lang="es">litarcosa</skos:altLabel>
    <skos:definition xml:lang="es">Litarenita cuya relación entre feldespatos y fragmentos de otras rocas no supera 1:3</skos:definition>
    <skos:definition xml:lang="en">Litharenite in which the ratio of feldspars to rock fragments does not exceed 1:3</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metadolerita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metadolerita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metadolerite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición dolerítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of doleritic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-igneo-intermedio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material ígneo intermedio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intermediate igneous material</skos:prefLabel>
    <skos:definition xml:lang="es">Material ígneo cuyo contenido en sílice está comprendido entre el 52 y el 66%</skos:definition>
    <skos:definition xml:lang="en">Igneous material whose silica content is between 52 and 66%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/intermediateCompositionIgneousMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/intermediate_composition_igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bioesparita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bioesparita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biosparite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica esparítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides superior a 3:1</skos:definition>
    <skos:definition xml:lang="en">Sparitic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio exceeding 3:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/hialoclastita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">hialoclastita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hyaloclastite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica formada por fragmentos angulosos de vidrio, más o menos desvitrificados, originados por el contacto súbito del magma que sale en una erupción volcánica submarina, con el agua o con sedimentos saturados en agua</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock formed by angular glass fragments, more or less devitrified, originating from the sudden contact of magma emerging in a submarine volcanic eruption with water or water-saturated sediments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-hibrido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material sedimentario híbrido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hybrid sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material que no puede incluirse en ninguna otra categoría de material sedimentario por su composición u origen. está integrado por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% del sedimento</skos:definition>
    <skos:definition xml:lang="en">Material that cannot be included in any other category of sedimentary material by its composition or origin. It is composed of three or more components, each of which constitutes between 5 and 50% of the sediment</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSediment"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/websterita-olivinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">websterita olivínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine websterite</skos:prefLabel>
    <skos:definition xml:lang="es">Piroxenita olivínica con orto y clinopiroxeno en cantidades superiores al 5%</skos:definition>
    <skos:definition xml:lang="en">Olivine pyroxenite with ortho- and clinopyroxene in amounts exceeding 5%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomia-pura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomía pura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure dolomite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria con un contenido de dolomita superior al 95%.</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock with a dolomite content exceeding 95%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/contornita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">contornita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contourite</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico semejante a una turbidita, pero formado por la acción de las corrientes de contorno</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment similar to a turbidite, but formed by the action of contour currents</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carniola">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carniola</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carniola</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada, rica en magnesio, de aspecto cavernoso y masivo, de color rojizo, anaranjado o amarillento</skos:definition>
    <skos:definition xml:lang="en">Carbonate rock, rich in magnesium, of cavernous and massive appearance, reddish, orange or yellowish in colour</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquita-con-foides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquita con foides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foid-bearing trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente al grupo de las rocas traquíticas, que contiene feldespatoides. su equivalente plutónico es la sienita con foides</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the group of trachytic rocks, containing feldspathoids. Its plutonic equivalent is foid-bearing syenite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingTrachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dique">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dique</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dike</skos:prefLabel>
    <skos:definition xml:lang="es">Muro o construcción para contener las aguas</skos:definition>
    <skos:definition xml:lang="en">Wall or construction to contain water</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicConsolidatedMaterial"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-litografica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza litográfica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lithographic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza de grano muy fino y homogéneo, de fractura lisa concoide</skos:definition>
    <skos:definition xml:lang="en">Very fine-grained, homogeneous limestone with a smooth conchoidal fracture</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metarenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metarenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metaarenite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una arenita</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from an arenite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/kernita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">kernita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kernite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula na2b4o7.4h2o, perteneciente a la clase de los boratos, que cristaliza en el sistema monoclínico en forma de masas espáticas. es incoloro o blanco, tiene brillo vítreo y varía de transparente a translúcido</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula Na2B4O7·4H2O, belonging to the class of borates, crystallizing in the monoclinic system in the form of sparitic masses. It is colourless or white, with vitreous lustre and varying from transparent to translucent</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lignito-sapropelico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lignito sapropélico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sapropelic lignite</skos:prefLabel>
    <skos:definition xml:lang="es">Carbón de la serie sapropélica semejante al lignito húmico, pero de aspecto homogéneo y apariencia no estratificada. su contenido en carbono es del 60-70% y el de volátiles, del 52-63%</skos:definition>
    <skos:definition xml:lang="en">Sapropelic series coal similar to humic lignite but of homogeneous appearance and non-stratified appearance. Its carbon content is 60-70% and the volatile matter content is 52-63%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/lignite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/lignite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gabro-foidico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gabro foídico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic gabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas gabroicas foídicas, en la que la plagioclasa constituye más del 90% de los feldespatos. es el equivalente intrusivo de la basanita</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of foidic gabbroic rocks, in which plagioclase constitutes more than 90% of the feldspars. It is the intrusive equivalent of basanite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidGabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_gabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-metasomaticas-e-hidrotermales">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Metasomáticas e Hidrotermales</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Metasomatic And Hydrothermal Rocks</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Metasomáticas e Hidrotermales, que se caracteriza por incluir rocas derivadas de un proceso metamórfico por el que se produce un cambio importante en la composición química de la roca, debido a interacción con fluidos hidrotermales o magmas, así como rocas cuyas características son el resultado de la acción de soluciones hidrotermales.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Metasomatic and Hydrothermal Rocks, characterized by including rocks derived from a metamorphic process in which an important change in the chemical composition of the rock occurs, due to interaction with hydrothermal fluids or magmas, as well as rocks whose characteristics are the result of the action of hydrothermal solutions.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/fenita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/greisen"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/rodingita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/skarn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-carbonatado-puro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento carbonatado puro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure carbonate sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito compuesto en más de un 90% por minerales carbonatados</skos:definition>
    <skos:definition xml:lang="en">Deposit composed of more than 90% carbonate minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pureCarbonateSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_carbonate_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-metasomatica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca metasomática</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metasomatic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca derivada de un proceso metamórfico por el que se produce un cambio importante en la composición química de la roca sujeta a metamorfismo, debido a interacción con fluidos hidrotermales o magmas</skos:definition>
    <skos:definition xml:lang="en">Rock derived from a metamorphic process in which an important change in the chemical composition of the rock subject to metamorphism occurs, due to interaction with hydrothermal fluids or magmas</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/opdalita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">opdalita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">opdalite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca perteneciente a la familia de las rocas charnoquíticas, equivalente a una granodiorita con ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Rock belonging to the charnockitic rock family, equivalent to a granodiorite with orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granulite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granulite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/anfibolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">anfibolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">amphibolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de color verde oscuro, compuesta principalmente por anfíbol y plagioclasa más del 75 % en conjunto y más del 30% de anfíbol y que puede contener, en cantidades más subordinadas, cuarzo, clinopiroxeno, granate, minerales del grupo de la epidota, biotita, titanita, rutilo, ilmenita y escapolita</skos:definition>
    <skos:definition xml:lang="en">Dark green metamorphic rock composed mainly of amphibole and plagioclase (more than 75% in total and more than 30% amphibole), which may contain, in more subordinate amounts, quartz, clinopyroxene, garnet, minerals of the epidote group, biotite, titanite, rutile, ilmenite and scapolite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/amphibolite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/amphibolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/salina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">salina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">salt works</skos:prefLabel>
    <skos:definition xml:lang="es">Laguna costera o continental, natural o artificial, donde se produce precipitación de sales</skos:definition>
    <skos:definition xml:lang="en">Coastal or inland lagoon, natural or artificial, where salt precipitation takes place</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/oomicrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">oomicrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oomicrite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica micrítica en la que menos del 25% de los aloquímicos corresponden a intraclastos y más del 25%, a ooides</skos:definition>
    <skos:definition xml:lang="en">Micritic allochemical limestone in which less than 25% of the allochems correspond to intraclasts and more than 25% to ooids</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-organogena">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza organógena</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organogenic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza constituida mayoritariamente por restos calcáreos de conchas y esqueletos de organismos lamelibranquios, crinoides, foraminíferos, corales, etc.</skos:definition>
    <skos:definition xml:lang="en">Limestone consisting predominantly of calcareous shell and skeletal remains of organisms (lamellibranchs, crinoids, foraminifera, corals, etc.)</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/limo-arenoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">limo arenoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy silt</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico en el que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 10 y el 50% y la relación de limo a arcilla es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 10 and 50% and the silt-to-clay ratio exceeds 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/silt"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/silt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-ferruginosos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Sedimentarias y Sedimentos Ferruginosos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Ferruginous Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Sedimentarias y Sedimentos Ferruginosos, que se caracteriza por incluir rocas sedimentarias compuestas en más de un 50% por minerales ferruginosos.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Ferruginous Sedimentary Rocks and Sediments, characterized by including sedimentary rocks composed of more than 50% ferruginous minerals.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/formacion-de-hierro-bandeado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/hierro-de-los-pantanos"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/canto-blando">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">canto blando</skos:prefLabel>
    <skos:prefLabel xml:lang="en">soft pebble</skos:prefLabel>
    <skos:definition xml:lang="es">Canto que se origina por una agregación de partículas de tamaño fino, como consecuencia de la erosión de las corrientes en materiales arcillosos</skos:definition>
    <skos:definition xml:lang="en">Clast originating by aggregation of fine-size particles, resulting from current erosion of clayey materials</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/melilitolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">melilitolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">melilitolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica ultrabásica y ultraalcalina del grupo de los melilitoides, que tiene como minerales esenciales melilita en proporción superior al 10%, piroxeno y, con frecuencia, olivino melilitita olivínica y nefelina</skos:definition>
    <skos:definition xml:lang="en">Ultrabasic, ultraalkaline plutonic rock of the melilitoid group, having melilite in proportions exceeding 10%, pyroxene and, frequently, olivine (olivine melilitolite) and nepheline as essential minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-s.l.">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena s.l.</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sand s.l.</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento que contiene menos de un 30% de clastos de tamaño grava &gt;2 mm de diámetro y una relación entre granos de arena 0.062-2 mm y partículas de lutita &lt;0.062 mm mayor que 1, sin especificar su composición o su génesis</skos:definition>
    <skos:definition xml:lang="en">Sediment containing less than 30% gravel-size clasts (&gt;2 mm diameter) and with a ratio of sand grains (0.062-2 mm) to mud particles (&lt;0.062 mm) greater than 1, without specifying composition or genesis</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandSizeSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-de-impacto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha de impacto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impact breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Brecha que contiene fragmentos que muestran evidencias inequívocas de haber sufrido un metamorfismo de choque, típicamente se produce alrededor, dentro y debajo de un cráter de impacto</skos:definition>
    <skos:definition xml:lang="en">Breccia containing fragments that show unequivocal evidence of having undergone shock metamorphism; typically produced around, within and below an impact crater</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impactGeneratedMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impact_generated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ftanita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ftanita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phtanite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad del sílex, de color gris a negro debido a la presencia de materia grafitosa y carbonosa, formada esencialmente por cuarzo criptocristalino y algo de ópalo, a veces con algunos radiolarios, tiene fractura finamente astillosa</skos:definition>
    <skos:definition xml:lang="en">Variety of chert, grey to black in colour due to the presence of graphitic and carbonaceous matter, formed essentially of cryptocrystalline quartz and some opal, sometimes with some radiolarians; it has a finely splintery fracture</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-fosfatado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material sedimentario fosfatado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">phosphate sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario compuesto en más de un 50% por fosfatos</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material composed of more than 50% phosphates</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/phosphateRichSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/phosphate_rich_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-volcanoclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito volcanoclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcaniclastic deposit</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito compuesto, al menos en un 10% de su volumen, por fragmentos de naturaleza volcánica, independientemente del mecanismo de fragmentación y de acumulación</skos:definition>
    <skos:definition xml:lang="en">Deposit composed of at least 10% by volume of fragments of volcanic nature, regardless of the fragmentation and accumulation mechanism</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/compoundMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/compound_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tonalita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tonalita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tonalite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica de la familia de los granitoides, en la que la plagioclasa constituye más del 90% de los feldespatos. además de biotita, puede contener hornblenda, titanita y/o piroxeno como minerales varietales</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock of the granitoid family, in which plagioclase constitutes more than 90% of the feldspars. In addition to biotite, it may contain hornblende, titanite and/or pyroxene as varietal minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tonalite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tonalite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cortlandtita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cortlandtita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cortlandtite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca máfica o casi ultramáfica con altos contenidos en mgo y k2o, que además de olivino tiene anfíbol, flogopita o ambos minerales. variedad más máfica que la appinita</skos:definition>
    <skos:definition xml:lang="en">Mafic or near-ultramafic rock with high MgO and K2O content, which in addition to olivine contains amphibole, phlogopite or both minerals. A more mafic variety than appinite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-volcanica-rica-en-magnesio">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca volcánica rica en magnesio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">high-magnesium volcanic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica con una concentración inusualmente elevada de mgo. en rocas con más del 52% de sio2, el contenido de mgo debe ser superior al 8% y en rocas con menos del 52% de sio2, el contenido de mgo debe ser superior al 12%</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock with an unusually high MgO concentration. In rocks with more than 52% SiO2, the MgO content must exceed 8%, and in rocks with less than 52% SiO2, the MgO content must exceed 12%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/highMagnesiumFineGrainedIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/high_magnesium_fine_grained_igneous_rocks"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-de-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca de falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fault rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada como resultado de la deformación en una zona de falla</skos:definition>
    <skos:definition xml:lang="en">Rock formed as a result of deformation in a fault zone</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/myloniticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mylonitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/parabrecha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">parabrecha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">parabreccia</skos:prefLabel>
    <skos:definition xml:lang="es">Brecha en la que la matriz arenosa o pelítica se presenta en proporción superior al 15%, con cantos y bloques angulosos flotando dentro de ella</skos:definition>
    <skos:definition xml:lang="en">Breccia in which the sandy or pelitic matrix is present in proportions exceeding 15%, with angular clasts and blocks floating within it</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/limo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">limo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silt</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento pelítico en el que la relación de componentes de tamaño limo a arcilla es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Pelitic sediment in which the ratio of silt-size to clay-size components exceeds 2:1</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/silt"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/silt"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granodiorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granodiorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica de la familia de los granitoides, en la que la plagioclasa constituye entre el 65 y el 90% de los feldespatos, contiene cantidades menores de biotita, hornblenda y, más raramente, piroxeno</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock of the granitoid family, in which plagioclase constitutes between 65 and 90% of the feldspars, containing lesser amounts of biotite, hornblende and, more rarely, pyroxene</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/diorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">diorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica de composición intermedia que generalmente está formada por plagioclasa cálcica andesina y hornblenda, a menudo con biotita o augita, así como cuarzo en una cantidad que no supera el 5% de los minerales félsicos. es el equivalente plutónico de la andesita</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock of intermediate composition generally formed by calcic plagioclase (andesine) and hornblende, often with biotite or augite, as well as quartz in an amount not exceeding 5% of the felsic minerals. It is the plutonic equivalent of andesite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/diorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/diorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria constituida, en más de un 50%, por elementos detríticos angulosos de más de 2 mm de diámetro y trabados por un cemento o una matriz detrítica fina</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock consisting of more than 50% angular detrital elements with a diameter exceeding 2 mm, bound by a cement or fine detrital matrix</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carnalita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carnalita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carnallite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula kcl, perteneciente a la clase de los cloruros, que cristaliza en el sistema rómbico formando masas granudas o nodulares. es incoloro cuando es puro y de color blanco con diferentes tonalidades cuando contiene impurezas, tiene brillo vítreo a graso y varía de transparente a translúcido</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula KCl, belonging to the class of chlorides, crystallizing in the orthorhombic system forming granular or nodular masses. It is colourless when pure and white with different shades when containing impurities, with vitreous to greasy lustre and varying from transparent to translucent</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/obsidiana">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">obsidiana</skos:prefLabel>
    <skos:prefLabel xml:lang="en">obsidian</skos:prefLabel>
    <skos:definition xml:lang="es">Vidrio volcánico de color negro brillante, frágil y con fractura concoidea. se origina por el enfriamiento rápido de lavas ácidas</skos:definition>
    <skos:definition xml:lang="en">Volcanic glass of bright black colour, brittle and with conchoidal fracture. It originates from the rapid cooling of acid lavas</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/glassyIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/glassy_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-carbonatada-impura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria carbonatada impura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure carbonate sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria con un contenido de minerales carbonatados comprendido entre el 50 y el 90% del total de la roca</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock composed of 50 to 90% carbonate minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureCarbonateSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_carbonate_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/formacion-de-hierro-bandeado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">formación de hierro bandeado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">banded iron formation</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria finamente bandeada, que contiene al menos un 15% de hierro y generalmente intercala capas de sílex. el hierro se presenta en forma de óxidos, carbonatos o sulfuros</skos:definition>
    <skos:definition xml:lang="en">Finely banded sedimentary rock containing at least 15% iron and generally interbedded with chert layers. The iron occurs as oxides, carbonates or sulfides</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ironRichSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/toba-de-ceniza-gruesa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">toba de ceniza gruesa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coarse ash tuff</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica en la que los fragmentos de ceniza gruesa constituyen más del 75% en volumen del contenido piroclástico</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock in which coarse ash fragments constitute more than 75% by volume of the pyroclastic content</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff_lapillistone_and_lapilli_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/taquilita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">taquilita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tachylite</skos:prefLabel>
    <skos:definition xml:lang="es">Vidrio basáltico de color negro y opaco, debido a las inclusiones muy pequeñas de cristales. es el constituyente fundamental de la mayoría de las escorias basálticas</skos:definition>
    <skos:definition xml:lang="en">Black, opaque basaltic glass due to very small crystal inclusions. It is the fundamental constituent of most basaltic scorias</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/glassyIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/glassy_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-arcillosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca arcillosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">clayey sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica en la que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 50 y el 90% y la relación de elementos de tamaño arcilla a tamaño limo es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital rock in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 50 and 90% and the ratio of clay-size to silt-size elements exceeds 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-materiales-sedimentarios">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Grandes Grupos de Materiales / Materiales Sedimentarios</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Major Material Groups / Sedimentary Material</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Materiales Sedimentarios, que se caracteriza por representar el nivel superior de clasificación que agrupa todos los materiales formados en el exterior de la corteza terrestre mediante un proceso de sedimentación.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the hierarchical category of Major Material Groups / Sedimentary Materials, characterized by representing the top-level classification that groups all materials formed outside the Earth's crust by a sedimentary process.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/alabastro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">alabastro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">alabaster</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad masiva del yeso formada por cristales de grano fino, generalmente blanca y translúcida, que se emplea en escultura y como piedra ornamental</skos:definition>
    <skos:definition xml:lang="en">Massive variety of gypsum formed by fine-grained crystals, generally white and translucent, used in sculpture and as ornamental stone</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gypsumOrAnhydrite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rock_gypsum_or_anhydrite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-estromatolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza estromatolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stromatolitic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza caracterizada por una fina laminación de forma variable domo, convexa, columnar, esferoidal, etc., que se origina principalmente por la actividad metabólica de las algas cianofíceas, que atrapan material sedimentario</skos:definition>
    <skos:definition xml:lang="en">Limestone characterized by fine lamination of variable form (dome, convex, columnar, spheroidal, etc.), originating mainly by the metabolic activity of cyanobacteria, which trap sedimentary material</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/canto-grande">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">canto grande</skos:prefLabel>
    <skos:prefLabel xml:lang="en">large cobble</skos:prefLabel>
    <skos:definition xml:lang="es">Canto de tamaño comprendido entre 64 y 256 mm</skos:definition>
    <skos:definition xml:lang="en">Clast with a size between 64 and 256 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lutita-conglomeratica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lutita conglomerática</skos:prefLabel>
    <skos:prefLabel xml:lang="en">conglomeratic mudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica poco seleccionada, con un contenido de elementos de tamaño pelita superior al de elementos de tamaño arena y con un contenido de tamaño grava comprendido entre el 5 y el 30% del total</skos:definition>
    <skos:definition xml:lang="en">Poorly sorted detrital rock with a pelite-size element content greater than that of sand-size elements and a gravel-size content between 5 and 30% of the total</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/intraesparita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">intraesparita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intrasparite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica esparítica en la que más del 25% de los aloquímicos corresponden a intraclastos</skos:definition>
    <skos:definition xml:lang="en">Sparitic allochemical limestone in which more than 25% of the allochems correspond to intraclasts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granito-rico-en-cuarzo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granito rico en cuarzo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz-rich granite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica leucocrática en la que el cuarzo constituye más del 60% de los minerales félsicos</skos:definition>
    <skos:definition xml:lang="en">Leucocratic plutonic rock in which quartz constitutes more than 60% of the felsic minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/silvinita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">silvinita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sylvinite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria formada por láminas alternantes de silvita y halita</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock formed by alternating laminae of sylvite and halite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/olistolito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">olistolito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olistolith</skos:prefLabel>
    <skos:definition xml:lang="es">Bloque de roca exótico transportado por un deslizamiento gravitatorio submarino o subaéreo, que se incluye dentro de rocas sedimentarias más modernas o que forma parte de un olistostroma</skos:definition>
    <skos:definition xml:lang="en">Exotic rock block transported by submarine or subaerial gravitational sliding, included within younger sedimentary rocks or forming part of an olistostrome</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/boulderGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/boulder_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metatoba">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metatoba</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metatuff</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica cuyo protolito es una toba volcánica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock whose protolith is a volcanic tuff</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/conglomerado-arenoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">conglomerado arenoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy conglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida en un 30-50% por clastos de más de 2 mm de diámetro y con un contenido de elementos de tamaño arena mayor que el de elementos de tamaño pelita</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of 30-50% clasts with a diameter exceeding 2 mm and with a sand-size element content greater than that of pelite-size elements</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-calcoalcalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca calcoalcalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calc-alkaline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea que forma parte de una suite de rocas generalmente básico-intermedias. se caracteriza por ser saturada o sobresaturada en sílice, con índice de peacok entre 56 y 61, y por mantener la relación fe/fe+mg relativamente constante a lo largo de la secuencia de diferenciación</skos:definition>
    <skos:definition xml:lang="en">Igneous rock forming part of a suite of generally basic-intermediate rocks. It is characterized by being saturated or oversaturated in silica, with a Peacock index between 56 and 61, and by maintaining the Fe/Fe+Mg ratio relatively constant throughout the differentiation sequence</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carbon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carbón</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coal</skos:prefLabel>
    <skos:altLabel xml:lang="es">carbón mineral</skos:altLabel>
    <skos:definition xml:lang="es">Roca sedimentaria rica en materia orgánica utilizada como combustible, de color pardo a negro y de consistencia pétrea o terrosa, constituida por carbono amorfo acompañado de hidrocarburos, compuestos orgánicos complejos y materiales inorgánicos. tiene su origen en la carbonificación de vegetales en épocas geológicas pasadas, tras quedar sepultados en ambientes anóxicos</skos:definition>
    <skos:definition xml:lang="en">Fine-grained organic matter-rich sedimentary rock used as fuel, brown to black in colour and of stony or earthy consistency, consisting of amorphous carbon accompanied by hydrocarbons, complex organic compounds and inorganic materials. It originates from the carbonification of plants in past geological periods after being buried in anoxic environments</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/coal"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/calcilimolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">calcilimolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcisiltite</skos:prefLabel>
    <skos:definition xml:lang="es">1. Caliza compuesta fundamentalmente por granos carbonáticos de tamaño limo. 2. Limolita constituida mayoritariamente por clastos de carbonatos</skos:definition>
    <skos:definition xml:lang="en">1. Limestone composed fundamentally of silt-size carbonate grains. 2. Siltstone consisting predominantly of carbonate clasts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/calcoesquisto">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">calcoesquisto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calc-schist</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de margas o pelitas calcáreas, constituida fundamentalmente por carbonatos y silicatos de calcio y magnesio zoisita/clinozoisita, lawsonita, margarita, talco, tremolita y que presenta esquistosidad producida por el paralelismo de minerales de hábito laminar, principalmente filosilicatos</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from marls or calcareous pelites, consisting fundamentally of calcium and magnesium silicates (zoisite/clinozoisite, lawsonite, margarite, talc, tremolite), and exhibiting schistosity produced by the parallel alignment of lamellar minerals, mainly phyllosilicates</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/marga">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">marga</skos:prefLabel>
    <skos:prefLabel xml:lang="en">marl</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria de aspecto terroso y fácilmente erosionable, que contiene entre un 35 y un 65% de carbonato cálcico y el resto, de lutita</skos:definition>
    <skos:definition xml:lang="en">Earthy-looking and easily erodible sedimentary rock containing between 35 and 65% calcium carbonate and the remainder mudstone</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateMudstone"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateRichMudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_rich_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomia-impura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomía impura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure dolomite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca dolomítica en la que el contenido conjunto de calcita y dolomita no sobrepasa el 90% del total de la roca y el de calcita es inferior al 10%</skos:definition>
    <skos:definition xml:lang="en">Dolomitic rock in which the combined content of calcite and dolomite does not exceed 90% of the total rock and the calcite content is below 10%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureDolomite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-evaporitas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Evaporitas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Evaporites</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Evaporitas, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellos sedimentos o rocas sedimentarias formados por precipitación química de sales no carbonatadas, principalmente sulfatos, cloruros y boratos.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Evaporites, characterized by grouping, within sedimentary materials, those sediments or sedimentary rocks formed by chemical precipitation of non-carbonate salts, mainly sulfates, chlorides, and borates.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-evaporitico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/evaporita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-evaporitica"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-monogenica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha monogénica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monogenic breccia</skos:prefLabel>
    <skos:altLabel xml:lang="es">brecha monomíctica</skos:altLabel>
    <skos:definition xml:lang="es">Brecha constituida por cantos de un mismo tipo de roca</skos:definition>
    <skos:definition xml:lang="en">Breccia consisting of clasts of a single rock type</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-cuarcitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena cuarcítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartzitic sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que más del 95% de los granos son de cuarzo</skos:definition>
    <skos:definition xml:lang="en">Sand in which more than 95% of the grains are quartz</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/conglomerado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">conglomerado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">conglomerate</skos:prefLabel>
    <skos:altLabel xml:lang="es">rudita</skos:altLabel>
    <skos:definition xml:lang="es">Roca sedimentaria constituida, en más de un 50%, por elementos detríticos de más de 2 mm de diámetro y trabados por un cemento o una matriz detrítica fina</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock consisting of more than 50% detrital elements with a diameter exceeding 2 mm, bound by a cement or fine detrital matrix</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ofita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ofita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ophite</skos:prefLabel>
    <skos:definition xml:lang="es">Dolerita con textura ofítica</skos:definition>
    <skos:definition xml:lang="en">Dolerite with ophitic texture</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/doleriticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/doleritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-de-grano-fino">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca de grano fino</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fine-grained sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca en la que predominan los granos de diámetro comprendido entre 0.125 y 0.25 mm</skos:definition>
    <skos:definition xml:lang="en">Sandstone in which grains with a diameter between 0.125 and 0.25 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-madre">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca madre</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bedrock</skos:prefLabel>
    <skos:altLabel xml:lang="es">substrato rocoso</skos:altLabel>
    <skos:definition xml:lang="es">Término general para designar la roca sólida que subyace a un suelo u otro material no consolidado expuesto en la superficie terrestre</skos:definition>
    <skos:definition xml:lang="en">General term to designate the solid rock underlying soil or other unconsolidated material exposed at the Earth's surface</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/compoundMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/compound_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ortopiroxenita-olivinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ortopiroxenita olivínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine orthopyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Piroxenita olivínica constituida esencialmente por olivino y ortopiroxeno</skos:definition>
    <skos:definition xml:lang="en">Olivine pyroxenite consisting essentially of olivine and orthopyroxene</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material sedimentario</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material formado en el exterior de la corteza terrestre mediante un proceso de sedimentación. presenta estructuras características, como, principalmente, la estratificación</skos:definition>
    <skos:definition xml:lang="en">Material formed outside the Earth's crust by a sedimentary process. It exhibits characteristic structures, primarily stratification</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/biostromo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">biostromo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biostrome</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica estratificada resultante de la diagénesis de los fragmentos desprendidos del biohermo y acumulados formando un talud en la parte exterior del arrecife barrera, hacia el mar libre</skos:definition>
    <skos:definition xml:lang="en">Stratified detrital rock resulting from the diagenesis of fragments derived from the bioherm and accumulated as a talus on the outer side of the barrier reef towards the open sea</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/canto-mediano">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">canto mediano</skos:prefLabel>
    <skos:prefLabel xml:lang="en">medium cobble</skos:prefLabel>
    <skos:definition xml:lang="es">Canto de tamaño comprendido entre 4 y 64 mm</skos:definition>
    <skos:definition xml:lang="en">Clast with a size between 4 and 64 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-piroclastica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca piroclástica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pyroclastic rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">toba</skos:altLabel>
    <skos:definition xml:lang="es">Roca formada en más de un 75% de su volumen por piroclastos</skos:definition>
    <skos:definition xml:lang="en">Rock formed by more than 75% by volume of pyroclasts</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-micritica-con-aloquimicos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza micrítica con aloquímicos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micritic limestone with allochemicals</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza microcristalina con un contenido de aloquímicos comprendido entre el 1 y el 10%</skos:definition>
    <skos:definition xml:lang="en">Microcrystalline limestone with an allochem content between 1 and 10%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-hidrotermal">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca hidrotermal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hydrothermal rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cuyas características son el resultado de la acción de soluciones hidrotermales</skos:definition>
    <skos:definition xml:lang="en">Rock whose characteristics are the result of the action of hydrothermal solutions</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metasomaticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metasomatic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/dolomia-con-ooides">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">dolomía con ooides</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dolomite with ooids</skos:prefLabel>
    <skos:definition xml:lang="es">Dolomía en la que se reconocen fantasmas de aloquímicos, de entre los que predominan los ooides</skos:definition>
    <skos:definition xml:lang="en">Dolostone in which ghosts of allochems are recognized, among which ooids predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dolomite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dolostone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arena-fina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arena fina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fine sand</skos:prefLabel>
    <skos:definition xml:lang="es">Arena en la que predominan los granos de diámetro comprendido entre 0.125 y 0.25 mm</skos:definition>
    <skos:definition xml:lang="en">Sand in which grains with a diameter between 0.125 and 0.25 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sand"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/sand"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/biopelesparita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">biopelesparita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biopelsparite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica esparítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides comprendida entre 1:3 y 3:1</skos:definition>
    <skos:definition xml:lang="en">Sparitic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio between 1:3 and 3:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-s.l.">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca s.l.</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandstone s.l.</skos:prefLabel>
    <skos:definition xml:lang="es">Roca sedimentaria constituida por menos de un 30% de fragmentos de diámetro superior a 2 mm y cuya relación entre el contenido de granos de arena y de partículas de lutita es al menos 1. los fragmentos pueden ser de cualquier composición y origen</skos:definition>
    <skos:definition xml:lang="en">Sedimentary rock consisting of less than 30% fragments with a diameter exceeding 2 mm and whose ratio of sand grain content to mud particle content is at least 1. The fragments may be of any composition and origin</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/genericSandstone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/generic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-ignea-fragmentaria">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca ígnea fragmentaria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fragmental igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea constituida en más del 75% por fragmentos producidos por procesos ígneos. incluye a las rocas piroclásticas y las brechas intrusivas y volcánicas</skos:definition>
    <skos:definition xml:lang="en">Igneous rock consisting of more than 75% fragments produced by igneous processes. Includes pyroclastic rocks and intrusive and volcanic breccias</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-oligomictica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha oligomíctica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oligomictic breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Brecha constituida por cantos de un reducido número de tipos de roca</skos:definition>
    <skos:definition xml:lang="en">Breccia consisting of clasts of a small number of rock types</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pelita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pelita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelite</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico constituido en más del 50% por partículas muy finas, de menos de 0.062 mm. contiene menos de un 10% de carbonatos</skos:definition>
    <skos:definition xml:lang="en">Detrital sediment consisting of more than 50% very fine particles, less than 0.062 mm. Contains less than 10% carbonates</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mud"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/silicateMud"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/silicate_mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-pisolitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza pisolítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pisolitic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza constituida mayoritariamente por pisoides ooides de más de 2 mm de diámetro y cemento calcítico</skos:definition>
    <skos:definition xml:lang="en">Limestone consisting predominantly of pisolites (ooids larger than 2 mm in diameter) and calcite cement</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzomonzodiorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzomonzodiorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz monzodiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas monzodioríticas, que contiene cuarzo en una cantidad comprendida entre el 5 y el 20% de los minerales félsicos</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of monzodioritic rocks, containing quartz in an amount between 5 and 20% of the felsic minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzMonzodiorite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_monzodiorite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/harina-de-falla">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">harina de falla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fault gouge</skos:prefLabel>
    <skos:definition xml:lang="es">Material de falla sin cohesión, de grano fino o muy fino y rico en arcillas, que puede poseer una foliación tectónica y que contiene menos del 30% de fragmentos visibles</skos:definition>
    <skos:definition xml:lang="en">Non-cohesive fault material, fine- or very fine-grained and clay-rich, which may possess tectonic foliation and contains less than 30% visible fragments</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia-gougeSeries"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia_gouge_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/garnierita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">garnierita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">garnierite</skos:prefLabel>
    <skos:definition xml:lang="es">Serpentina portadora de níquel</skos:definition>
    <skos:definition xml:lang="en">Nickel-bearing serpentine</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/serpentinite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/serpentinite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lignito-negro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lignito negro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">black lignite</skos:prefLabel>
    <skos:definition xml:lang="es">Variedad del lignito, de color negro, brillo sedoso y más dura que el lignito pardo</skos:definition>
    <skos:definition xml:lang="en">Variety of lignite, black in colour, silky lustre and harder than brown lignite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/lignite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/lignite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metachert">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metachert</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metachert</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un chert</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a chert</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-biogenico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material biogénico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biogenic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material producido por la acción o la presencia de organismos vivos o de sus restos</skos:definition>
    <skos:definition xml:lang="en">Material produced by the action or presence of living organisms or their remains</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSediment"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/biogenicSilicaSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/biogenic_sediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/biogenic_silica_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/rudstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">rudstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento o roca carbonática, grano-soportados, con más del 10% de los clastos de tamaño superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Grain-supported carbonate sediment or rock, with more than 10% clasts with a diameter exceeding 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metadiorita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metadiorita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metadiorite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición diorítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of dioritic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/paraconglomerado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">paraconglomerado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">paraconglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Conglomerado en el que la matriz arenosa o pelítica se presenta en proporción superior al 15%, con cantos y bloques flotando dentro de ella</skos:definition>
    <skos:definition xml:lang="en">Conglomerate in which the sandy or pelitic matrix is present in proportions exceeding 15%, with clasts and blocks floating within it</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/serpentinita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">serpentinita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">serpentinite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica compuesta mayoritariamente por minerales del grupo de la serpentina crisotilo, antigorita, con o sin cantidades subordinadas de talco, brucita, olivino, diópsido, tremolita y magnetita. se forma por hidratación de rocas ultramáficas lherzolitas, harzburgitas a temperaturas moderadas inferiores a 500ºc</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock composed predominantly of serpentine group minerals (chrysotile, antigorite), with or without subordinate amounts of talc, brucite, olivine, diopside, tremolite and magnetite. It is formed by hydration of ultramafic rocks (lherzolites, harzburgites) at moderate temperatures below 500°C</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/serpentinite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/serpentinite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/hierro-de-los-pantanos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">hierro de los pantanos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">bog iron</skos:prefLabel>
    <skos:definition xml:lang="es">Mineral o roca sedimentaria, variedad de la limonita, que se presenta en masas esponjosas de color negro y se forma actualmente en zonas pantanosas</skos:definition>
    <skos:definition xml:lang="en">Mineral or sedimentary rock, a variety of limonite, occurring as spongy black masses and currently forming in swampy areas</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ironRichSedimentaryMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-dolomitica-impura">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza dolomítica impura</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure dolomitic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca calcárea con un contenido superior al 10%, tanto de dolomita como de impurezas</skos:definition>
    <skos:definition xml:lang="en">Calcareous rock with a content exceeding 10% of both dolomite and impurities</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureLimestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ultracataclasita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ultracataclasita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultracataclasitee</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cataclástica constituida en más del 90% por matriz</skos:definition>
    <skos:definition xml:lang="en">Cataclastic rock consisting of more than 90% matrix</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/cataclasiteSeries"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/cataclasite_series"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/traquiandesita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">traquiandesita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">trachyandesite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica intermedia, alcalina, que contiene habitualmente plagioclasa, feldespato alcalino y piroxeno. la variedad sódica recibe el nombre de benmoreíta y la potásica, de latita</skos:definition>
    <skos:definition xml:lang="en">Intermediate, alkaline volcanic rock that usually contains plagioclase, alkali feldspar and pyroxene. The sodic variety is called benmoreite and the potassic variety, latite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/andesite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/biomicrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">biomicrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biomicrite</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza aloquímica micrítica cuyos aloquímicos están constituidos por menos del 25% de ooides y de intraclastos, con una relación entre bioclastos y peloides superior a 3:1</skos:definition>
    <skos:definition xml:lang="en">Micritic allochemical limestone whose allochems consist of less than 25% ooids and intraclasts, with a bioclast-to-peloid ratio exceeding 3:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza con un contenido arenoso comprendido entre el 10 y el 50% del total</skos:definition>
    <skos:definition xml:lang="en">Limestone with a sandy content between 10 and 50% of the total</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metaultrabasita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metaultrabasita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metaultrabasite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de una roca de composición ultrabásica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a rock of ultrabasic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-vitrea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca vítrea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glassy rock</skos:prefLabel>
    <skos:altLabel xml:lang="es">roca holohialina</skos:altLabel>
    <skos:definition xml:lang="es">Roca ígnea que ha sufrido un enfriamiento rápido, dando lugar a una masa amorfa, sin cristales, presentando las características de un vidrio: fragilidad, fractura concoidea y ausencia de exfoliación</skos:definition>
    <skos:definition xml:lang="en">Igneous rock that has undergone rapid cooling, giving rise to an amorphous, crystal-free mass, exhibiting the characteristics of a glass: brittleness, conchoidal fracture and absence of cleavage</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/glassyIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/glassy_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-intermedia">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca intermedia</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intermediate rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea cuyo contenido en sílice está comprendido entre el 52 y el 66%</skos:definition>
    <skos:definition xml:lang="en">Igneous rock whose silica content is between 52 and 66%</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/intermediateCompositionIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/intermediate_composition_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lava">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lava</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lava</skos:prefLabel>
    <skos:definition xml:lang="es">Material fundido viscoso que es expulsado al exterior por un volcán, a elevada temperatura, en el curso de una erupción. al enfriarse da lugar a la formación de rocas efusivas o a escorias volcánicas</skos:definition>
    <skos:definition xml:lang="en">Viscous molten material expelled to the exterior by a volcano at high temperature during an eruption. Upon cooling it gives rise to the formation of effusive rocks or volcanic scoria</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-antropico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material antrópico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">anthropic material</skos:prefLabel>
    <skos:definition xml:lang="es">Acumulación de materiales, compactados o sin compactar, debida exclusivamente a la acción humana</skos:definition>
    <skos:definition xml:lang="en">Accumulation of materials, compacted or uncompacted, due exclusively to human action</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-hibrida">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca sedimentaria híbrida</skos:prefLabel>
    <skos:prefLabel xml:lang="en">hybrid sedimentary rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca integrada por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% de la misma, y que no puede incluirse en ninguna otra categoría de roca por su composición u origen</skos:definition>
    <skos:definition xml:lang="en">Rock composed of three or more components, each of which constitutes between 5 and 50% of the rock, and which cannot be included in any other rock category by its composition or origin</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hybridSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hybrid_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metatexita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metatexita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metatexite</skos:prefLabel>
    <skos:definition xml:lang="es">Migmatita en la que el mesosoma domina sobre el neosoma</skos:definition>
    <skos:definition xml:lang="en">Migmatite in which mesosome dominates over neosome</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/migmatite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/migmatite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-rica-en-materia-organica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca rica en materia orgánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organic matter-rich rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cuyo contenido en materia orgánica es suficientemente alto como para tener efectos notables en la litología</skos:definition>
    <skos:definition xml:lang="en">Rock whose organic matter content is sufficiently high to have notable effects on the lithology</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSedimentaryRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/opalo">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ópalo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">opal</skos:prefLabel>
    <skos:definition xml:lang="es">Mineral amorfo del grupo de la sílice, de fórmula sio2.nh2o, que forma nódulos y concreciones. de coloraciones y tonalidades muy diversas, varía de transparente a opaco, posee brillo de vítreo a resinoso y tiene fractura concoidea</skos:definition>
    <skos:definition xml:lang="en">Amorphous mineral of the silica group, with the formula SiO2·nH2O, forming nodules and concretions. With very diverse colours and hues, varying from transparent to opaque, it has vitreous to resinous lustre and conchoidal fracture</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sublitarenita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sublitarenita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sublitharenite</skos:prefLabel>
    <skos:definition xml:lang="es">Arenita en la que la proporción de cuarzo está comprendida entre el 75 y el 95% con respecto al total de elementos terrígenos y en la que el contenido de fragmentos de otras rocas es mayor que el de feldespatos</skos:definition>
    <skos:definition xml:lang="en">Arenite in which the proportion of quartz is between 75 and 95% of the total terrigenous elements and in which the rock fragment content is greater than that of feldspars</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/arenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/arenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-volcanica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha volcánica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcanic breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Brecha constituida por fragmentos de rocas volcánicas, incluyendo fragmentos de lava solidificada y de material arrancado de los conductos volcánicos durante las erupciones</skos:definition>
    <skos:definition xml:lang="en">Breccia composed of volcanic rock fragments, including fragments of solidified lava and material torn from volcanic conduits during eruptions</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fragmentalIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fragmental_igneous_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-ferruginoso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material sedimentario ferruginoso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ferruginous sedimentary material</skos:prefLabel>
    <skos:definition xml:lang="es">Material sedimentario compuesto en más de un 50% por minerales ferruginosos</skos:definition>
    <skos:definition xml:lang="en">Sedimentary material composed of more than 50% ferruginous minerals</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ironRichSedimentaryMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/iron_rich_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/malecon">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">malecón</skos:prefLabel>
    <skos:prefLabel xml:lang="en">seawall</skos:prefLabel>
    <skos:definition xml:lang="es">Murallón o terraplén que se hace para defenderse de las aguas</skos:definition>
    <skos:definition xml:lang="en">Embankment or wall built to protect against water</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicConsolidatedMaterial"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/granito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">granito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">granite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica leucocrática compuesta por cantidades similares de cuarzo, feldespato potásico y plagioclasa sódica, como minerales esenciales, y cantidades menores de uno o más minerales como biotita, moscovita, cordierita, hornblenda, granate, etc. el cuarzo constituye entre el 20 y el 60% de los minerales félsicos y el feldespato alcalino, entre el 35 y el 90% de los feldespatos. es el equivalente plutónico de la riolita</skos:definition>
    <skos:definition xml:lang="en">Leucocratic plutonic rock composed of similar amounts of quartz, potassic feldspar and sodic plagioclase as essential minerals, and lesser amounts of one or more minerals such as biotite, muscovite, cordierite, hornblende, garnet, etc. Quartz constitutes between 20 and 60% of the felsic minerals and alkali feldspar between 35 and 90% of the feldspars. It is the plutonic equivalent of rhyolite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/granite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/granite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lamprofido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lamprófido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lamprophyre</skos:prefLabel>
    <skos:definition xml:lang="es">Grupo variado de rocas subvolcánicas de composición básica o ultrabásica, más raramente intermedia, que se caracterizan por una textura marcadamente porfídica. los fenocristales son exclusivamente de minerales máficos, generalmente anfíbol, biotita o flogopita y, ocasionalmente, piroxeno, en una matriz meso a melanocrática en la que están incluidos los feldespatos. suelen aparecer en diques y cuerpos intrusivos menores, asociados a rocas intrusivas</skos:definition>
    <skos:definition xml:lang="en">Varied group of subvolcanic rocks of basic or ultrabasic, more rarely intermediate composition, characterized by a markedly porphyritic texture. The phenocrysts are exclusively of mafic minerals, generally amphibole, biotite or phlogopite and, occasionally, pyroxene, in a meso- to melanocratic groundmass containing the feldspars. They commonly occur as dykes and minor intrusive bodies associated with intrusive rocks</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arcillita-arenosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arcillita arenosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sandy claystone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica en la que los elementos de diámetro inferior a 2 mm constituyen más del 95% del total y, de ellos, el contenido de granos de arena está comprendido entre el 10 y el 50% y la relación de elementos de tamaño arcilla a tamaño limo es superior a 2:1</skos:definition>
    <skos:definition xml:lang="en">Detrital rock in which elements with a diameter below 2 mm constitute more than 95% of the total, of which the sand grain content is between 10 and 50% and the ratio of clay-size to silt-size elements exceeds 2:1</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/claystone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/claystone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-ultrapotasica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca ultrapotásica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultrapotassic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea ultramáfica o máfica enriquecida en potasio, con una relación molar de k2o/na2o mayor que 3</skos:definition>
    <skos:definition xml:lang="en">Ultramafic or mafic igneous rock enriched in potassium, with a molar K2O/Na2O ratio greater than 3</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava-pelitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava pelítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelitic gravel</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico poco seleccionado, constituido en un 30-50% por clastos de más de 2 mm de diámetro y con un contenido de elementos de tamaño pelita mayor que el de elementos de tamaño arena</skos:definition>
    <skos:definition xml:lang="en">Poorly sorted detrital sediment consisting of 30-50% clasts with a diameter exceeding 2 mm and with a pelite-size element content greater than that of sand-size elements</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gravel"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-sedimentarios-rocas-sedimentarias-y-sedimentos-hibridos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Híbridos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Materials / Hybrid Sedimentary Rocks And Sediments</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la subcategoría de Materiales Sedimentarios / Rocas Sedimentarias y Sedimentos Híbridos, que se caracteriza por agrupar, dentro de los materiales sedimentarios, aquellos materiales que no pueden incluirse en ninguna otra categoría por su composición u origen, integrados por tres o más componentes, cada uno de los cuales constituye entre el 5 y el 50% del sedimento.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the subcategory of Sedimentary Materials / Hybrid Sedimentary Rocks and Sediments, characterized by grouping, within sedimentary materials, those materials that cannot be included in any other category by their composition or origin, composed of three or more components, each of which constitutes between 5 and 50% of the sediment.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-hibrido"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-sedimentario-hibrido"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-sedimentaria-hibrida"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-criptocristalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca criptocristalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">cryptocrystalline rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea que tiene cristales solamente perceptibles mediante microscopio electrónico</skos:definition>
    <skos:definition xml:lang="en">Igneous rock that has crystals perceptible only by electron microscopy</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/fineGrainedIgneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fine_grained_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/arenisca-de-grano-grueso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">arenisca de grano grueso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">coarse-grained sandstone</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca en la que predominan los granos de diámetro comprendido entre 0.5 y 1.0 mm</skos:definition>
    <skos:definition xml:lang="en">Sandstone in which grains with a diameter between 0.5 and 1.0 mm predominate</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pelita-gravosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pelita gravosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gravelly pelite</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento detrítico poco seleccionado, con un contenido de elementos de tamaño pelita superior al de elementos de tamaño arena y con un contenido de elementos de tamaño grava comprendido entre el 5 y el 30% del total</skos:definition>
    <skos:definition xml:lang="en">Poorly sorted detrital sediment with a pelite-size element content greater than that of sand-size elements and a gravel-size element content between 5 and 30% of the total</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mud"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-metaluminosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca metaluminosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metaluminous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca cuyos índices de saturación en alúmina al2o3/k2o+na2o+cao, en proporciones molares y agpaítico [na2o+k2o/al2o3, en proporciones molares] son menores que la unidad. suele tener minerales ricos en calcio como hornblenda, augita o epidota</skos:definition>
    <skos:definition xml:lang="en">Rock whose alumina saturation index Al2O3/K2O+Na2O+CaO, in molar proportions, and agpaitic index [Na2O+K2O/Al2O3, in molar proportions] are less than unity. It usually contains calcium-rich minerals such as hornblende, augite or epidote</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/igneousRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/cuarzotraquita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">cuarzotraquita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quartz trachyte</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica perteneciente al grupo de las rocas traquíticas, que contiene cuarzo en una cantidad superior al 5% de los minerales félsicos. su equivalente plutónico es la cuarzosienita</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock belonging to the group of trachytic rocks, containing quartz in an amount exceeding 5% of the felsic minerals. Its plutonic equivalent is quartz syenite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/quartzTrachyte"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/quartz_trachyte"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/jacupirangita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">jacupirangita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">jacupirangite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica formada casi enteramente por augita, con algo de nefelina, perovskita, apatito y granate. es el término ultramáfico de la familia de las foidolitas</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock formed almost entirely by augite, with some nepheline, perovskite, apatite and garnet. It is the ultramafic end-member of the foidolite family</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/brecha-pelitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">brecha pelítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pelitic breccia</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida en un 30-50% por clastos angulosos de más de 2 mm de diámetro y con un contenido de elementos de tamaño pelita mayor que el de elementos de tamaño arena</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of 30-50% angular clasts with a diameter exceeding 2 mm and with a pelite-size element content greater than that of sand-size elements</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/eolianita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">eolianita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">eolianite</skos:prefLabel>
    <skos:definition xml:lang="es">Arenisca formada por la consolidación de un sedimento arenoso acumulado por el viento</skos:definition>
    <skos:definition xml:lang="en">Sandstone formed by the consolidation of sandy sediment accumulated by wind</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sandstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sandstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/deposito-evaporitico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">depósito evaporítico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">evaporitic deposit</skos:prefLabel>
    <skos:altLabel xml:lang="es">sedimento evaporítico</skos:altLabel>
    <skos:definition xml:lang="es">Sedimento formado por precipitación química de sales no carbonatadas, principalmente por sulfatos, cloratos y boratos</skos:definition>
    <skos:definition xml:lang="en">Sediment formed by chemical precipitation of non-carbonate salts, mainly sulfates, chlorates and borates</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/chemicalSedimentaryMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/chemical_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/grava">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">grava</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gravel</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento rudáceo constituido en más de un 50 % por cantos sin cementar</skos:definition>
    <skos:definition xml:lang="en">Rudaceous sediment consisting of more than 50% uncemented clasts</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gravel"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/piroxenita-olivinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">piroxenita olivínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine pyroxenite</skos:prefLabel>
    <skos:definition xml:lang="es">Piroxenita constituida esencialmente por piroxeno y, en menor proporción, olivino</skos:definition>
    <skos:definition xml:lang="en">Pyroxenite consisting essentially of pyroxene and, in lesser proportion, olivine</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroxenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroxenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/kersantita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">kersantita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kersantite</skos:prefLabel>
    <skos:definition xml:lang="es">Lamprófido calcoalcalino con biotita y plagioclasa como minerales dominantes</skos:definition>
    <skos:definition xml:lang="en">Calc-alkaline lamprophyre with biotite and plagioclase as dominant minerals</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/microbrecha">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">microbrecha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">microbreccia</skos:prefLabel>
    <skos:definition xml:lang="es">Roca detrítica constituida, en más de un 50%, por cantos angulosos de entre 2 y 4 mm de diámetro, trabados por un cemento o una matriz detrítica fina</skos:definition>
    <skos:definition xml:lang="en">Detrital rock consisting of more than 50% angular clasts between 2 and 4 mm in diameter, bound by a cement or fine detrital matrix</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/breccia"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/breccia"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/calcirrudita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">calcirrudita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcirudite</skos:prefLabel>
    <skos:definition xml:lang="es">1. Caliza compuesta fundamentalmente por granos carbonáticos de tamaño grava. 2. Rudita constituida mayoritariamente por clastos de carbonatos</skos:definition>
    <skos:definition xml:lang="en">1. Limestone composed fundamentally of gravel-size carbonate grains. 2. Rudite consisting predominantly of carbonate clasts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/jumillita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">jumillita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">jumillite</skos:prefLabel>
    <skos:altLabel xml:lang="es">lamproíta con olivino-diópsido-richterita</skos:altLabel>
    <skos:definition xml:lang="es">Roca volcánica variedad de una leucitita fonolítica, compuesta esencialmente por leucita, diópsido y, en menor proporción, olivino, feldespato alcalino y flogopita</skos:definition>
    <skos:definition xml:lang="en">Volcanic rock, variety of phonolitic leucitite, composed essentially of leucite, diopside and, in lesser proportion, olivine, alkali feldspar and phlogopite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticAlkalineRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_alkaline_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/pelita-tobacea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">pelita tobácea</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tuffaceous pelite</skos:prefLabel>
    <skos:definition xml:lang="es">Depósito mixto piroclástico-epiclástico formado en más de un 75% de su volumen por fragmentos de diámetro menor de 1/16 mm</skos:definition>
    <skos:definition xml:lang="en">Mixed pyroclastic-epiclastic deposit formed by more than 75% by volume of fragments with a diameter below 1/16 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/mudSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashAndLapilli"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/mud_size_sediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_and_lapilli"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metagranito">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metagranito</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metagranite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición granítica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of granitic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gneiss"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gneiss"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/italita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">italita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">italite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica leucocrática perteneciente a la familia de las foiditas, formada casi completamente por leucita</skos:definition>
    <skos:definition xml:lang="en">Leucocratic volcanic rock belonging to the foidite family, formed almost completely by leucite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-metamorfico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material metamórfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metamorphic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material derivado de una roca preexistente, mediante cambios mineralógicos, químicos o estructurales, en estado sólido esencialmente, en respuesta a variaciones físico-químicas, principalmente de presión y temperatura, quedando excluidos los materiales derivados de procesos de meteorización o formación de suelos</skos:definition>
    <skos:definition xml:lang="en">Material derived from a pre-existing rock, through mineralogical, chemical or structural changes, essentially in solid state, in response to physicochemical variations, mainly of pressure and temperature, excluding materials derived from weathering or soil-forming processes</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/compositeGenesisRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/faultRelatedMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/composite_genesis_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/fault_related_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/leucotonalita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">leucotonalita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">leucotonalite</skos:prefLabel>
    <skos:altLabel xml:lang="es">plagiogranito, tronjemita trondhjemita</skos:altLabel>
    <skos:definition xml:lang="es">Roca plutónica constituida por plagioclasa de tipo oligoclasa-andesina y cuarzo, con biotita y anfíbol en cantidades inferiores al 10%</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock consisting of oligoclase-andesine plagioclase and quartz, with biotite and amphibole in amounts below 10%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tonalite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tonalite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/lodo-de-depuradora">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lodo de depuradora</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sewage sludge</skos:prefLabel>
    <skos:definition xml:lang="es">Subproducto, más o menos líquido en el momento de su vertido, procedente del tratamiento de las aguas residuales</skos:definition>
    <skos:definition xml:lang="en">More or less liquid by-product at the time of discharge, from the treatment of wastewater</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/sewageSludge"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/vaugnerita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">vaugnerita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">vaugnerite</skos:prefLabel>
    <skos:definition xml:lang="es">Monzodiorita o monzogabro con altos contenidos en mgo y k2o. también cuarzomonzodiorita o cuarzomonzogabro, aunque existen términos transicionales a monzonita y monzosienita</skos:definition>
    <skos:definition xml:lang="en">Monzodiorite or monzogabbro with high MgO and K2O content. Also quartz monzodiorite or quartz monzogabbro, although there are transitional terms to monzonite and monzosyenite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzodioriticRock"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/monzogabbroicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzodioritic_rock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/monzogabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sedimento-dolomitico-puro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sedimento dolomítico puro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">pure dolomitic sediment</skos:prefLabel>
    <skos:definition xml:lang="es">Sedimento compuesto en más de un 90% por minerales carbonatados y con un contenido de dolomita superior al de calcita más aragonito</skos:definition>
    <skos:definition xml:lang="en">Sediment composed of more than 90% carbonate minerals and with a dolomite content greater than that of calcite plus aragonite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pureDolomiticSediment"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pure_dolomitic_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/canto-estriado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">canto estriado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">striated pebble</skos:prefLabel>
    <skos:definition xml:lang="es">Canto que presenta estrías a causa del roce a que durante su transporte ha sido sometido con las paredes y el lecho rocoso de un glaciar, o debido a deformación tectónica</skos:definition>
    <skos:definition xml:lang="en">Clast exhibiting striations resulting from friction during its transport against the walls and rocky floor of a glacier, or due to tectonic deformation</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pebbleGravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pebble_gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-acida">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca ácida</skos:prefLabel>
    <skos:prefLabel xml:lang="en">acidic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea que contiene más del 66% de sílice</skos:definition>
    <skos:definition xml:lang="en">Igneous rock containing more than 66% silica</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/acidicIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/acidic_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-margosa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza margosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">marly limestone</skos:prefLabel>
    <skos:altLabel xml:lang="es">caliza arcillosa</skos:altLabel>
    <skos:definition xml:lang="es">Caliza con un contenido lutítico comprendido entre el 10 y el 35% del total</skos:definition>
    <skos:definition xml:lang="en">Limestone with a mudstone content between 10 and 35% of the total</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/impureLimestone"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/impure_limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-volcanoclastico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material volcanoclástico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volcaniclastic material</skos:prefLabel>
    <skos:definition xml:lang="es">Material, consolidado o no, compuesto por fragmentos de naturaleza volcánica al menos en un 10% de su volumen, independientemente del mecanismo de fragmentación y de acumulación</skos:definition>
    <skos:definition xml:lang="en">Material, consolidated or unconsolidated, composed of fragments of volcanic nature in at least 10% of its volume, regardless of the fragmentation and accumulation mechanism</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/calcimudstone">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">calcimudstone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">calcimudstone</skos:prefLabel>
    <skos:definition xml:lang="es">Roca carbonatada matriz-soportada, constituida por menos del 10% de granos, siendo el resto matriz micrítica, según la clasificación de Dunham 1962</skos:definition>
    <skos:definition xml:lang="en">Matrix-supported carbonate rock, consisting of less than 10% grains, with the remainder being micritic matrix, according to the Dunham (1962) classification</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/carbonateMudstone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/carbonate_mudstone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tsunamita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tsunamita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tsunamite</skos:prefLabel>
    <skos:definition xml:lang="es">Material clástico depositado en la costa durante el paso de un tsunami</skos:definition>
    <skos:definition xml:lang="en">Clastic material deposited on the coast during the passage of a tsunami</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/clasticSedimentaryMaterial"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_sedimentary_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/esquisto-anfibolico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">esquisto anfibólico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">amphibolic schist</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de baja temperatura y presión media-baja, esquistosa y de color verde debido a la presencia de clorita y anfíbol cálcico típicamente actinolita, además de epidota y albita, generalmente resultante del metamorfismo de rocas magmáticas de composición basáltica. se recomienda su uso en vez de esquisto verde, por ser éste un nombre de facies</skos:definition>
    <skos:definition xml:lang="en">Low-temperature, medium- to low-pressure metamorphic rock, schistose and green in colour due to the presence of chlorite and calcic amphibole (typically actinolite), in addition to epidote and albite, generally resulting from the metamorphism of mafic igneous rocks of basaltic composition. Its use is recommended instead of 'greenschist', as that is a facies name</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/chloriteActinoliteEpidoteMetamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/chlorite_actinolite_epidote_metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-latitica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca latítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">latitic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica intermedia, alcalina, perteneciente al grupo de los traquitoides, en la que el feldespato alcalino y la plagioclasa se encuentran en proporciones similares, entre el 35 y el 65% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Intermediate, alkaline volcanic rock belonging to the group of trachytoids, in which alkali feldspar and plagioclase are in similar proportions, between 35 and 65% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/latiticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/latitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-micritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza micrítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">micritic limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza microcristalina con una proporción de aloquímicos inferior al 1%</skos:definition>
    <skos:definition xml:lang="en">Microcrystalline limestone with an allochem proportion below 1%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-natural-no-consolidado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material natural no consolidado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">unconsolidated natural material</skos:prefLabel>
    <skos:definition xml:lang="es">Material de origen natural sin compactar. incluye los sedimentos, los depósitos volcanoclásticos y los materiales de falla no cohesivos</skos:definition>
    <skos:definition xml:lang="en">Natural, unconsolidated material. Includes sediments, volcaniclastic deposits and non-cohesive fault materials</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/naturalUnconsolidatedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/natural_unconsolidated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/hornblendita-olivinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">hornblendita olivínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine hornblendite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ultramáfica constituida esencialmente por hornblenda y, en menor proporción, olivino</skos:definition>
    <skos:definition xml:lang="en">Ultramafic rock consisting essentially of hornblende and, in lesser proportion, olivine</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/hornblendite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/hornblendite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi-gtwg">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:affiliation rdf:resource="https://linked.data.gov.au/org/cgi"/>
    <sdo:name>CGI Geoscience Terminology Working Group</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/toba-con-lapilli-o-ceniza">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">toba con lapilli o ceniza</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lapilli or ash tuff</skos:prefLabel>
    <skos:definition xml:lang="es">Roca piroclástica cuyo contenido en fragmentos de diámetro superior a 64 mm constituye menos del 25% en volumen de los piroclastos</skos:definition>
    <skos:definition xml:lang="en">Pyroclastic rock whose content of fragments with a diameter exceeding 64 mm constitutes less than 25% by volume of the pyroclasts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/ashTuffLapillistoneAndLapilliTuff"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/ash_tuff"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/biomicrudita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">biomicrudita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">biomicrudite</skos:prefLabel>
    <skos:definition xml:lang="es">Biomicrita en la que más del 25% de los aloquímicos tienen un diámetro superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Biomicrite in which more than 25% of the allochems have a diameter exceeding 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metadiabasa">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metadiabasa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metadiabase</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito de composición diabásica</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a protolith of diabasic composition</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/tefrita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">tefrita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">tephrite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica básica o ultrabásica perteneciente a la familia de las rocas tefríticas, de color grisáceo y textura generalmente porfídica, con fenocristales de plagioclasa que constituyen más del 90% de los feldespatos, clinopiroxeno y feldespatoides, generalmente en una matriz microcristalina, puede contener olivino en proporción inferior al 10% normativo. su equivalente plutónico es la diorita foídica</skos:definition>
    <skos:definition xml:lang="en">Basic or ultrabasic volcanic rock belonging to the tephrite family, greyish and generally porphyritic, with plagioclase phenocrysts constituting more than 90% of the feldspars, clinopyroxene and feldspathoids, generally in a microcrystalline groundmass; may contain olivine in proportions below 10% normative. Its plutonic equivalent is foid diorite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/tephrite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/tephrite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/geiserita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">geiserita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">geyserite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca de composición opalina blanca, ligera, depositada en forma de costras o concreciones por precipitación de las aguas de un géiser alrededor de la boca del mismo</skos:definition>
    <skos:definition xml:lang="en">White opaline rock, lightweight, deposited as crusts or concretions by precipitation of geyser waters around the vent</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/non-clasticSiliceousSedimentaryRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/non_clastic_siliceous_sedimentary_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/conglomerado-oligomictico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">conglomerado oligomíctico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">oligomictic conglomerate</skos:prefLabel>
    <skos:definition xml:lang="es">Conglomerado constituido por cantos de un reducido número de tipos de roca</skos:definition>
    <skos:definition xml:lang="en">Conglomerate consisting of clasts of a small number of rock types</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/yeso">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">yeso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gypsum</skos:prefLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula caso4.2h2o, perteneciente a la clase de los sulfatos, que cristaliza en el sistema monoclínico y se presenta con aspecto fibroso, en cristales de gran tamaño o en maclas, entre ellas las de punta de flecha. tiene dureza 2 en la escala de mohs, rayándose con la uña. es incoloro o presenta color blanco, gris, amarillo o rojo, tiene brillo vítreo o nacarado y varía de transparente a translúcido</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula CaSO4·2H2O, belonging to the class of sulfates, crystallizing in the monoclinic system and occurring in fibrous form, as large crystals or as twins, including arrowhead twins. It has a hardness of 2 on the Mohs scale, being scratched by a fingernail. It is colourless or white, grey, yellow or red, with vitreous or pearly lustre and varying from transparent to translucent</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gypsumOrAnhydrite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rock_gypsum_or_anhydrite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carbon-de-la-serie-sapropelica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carbón de la serie sapropélica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sapropelic series coal</skos:prefLabel>
    <skos:definition xml:lang="es">Carbón, consolidado o no, formado por procesos de putrefacción en medios subacuáticos y bajo condiciones anóxicas, de materia orgánica derivada de fitoplancton. presenta grano fino, aspecto compacto y homogéneo a simple vista, color oscuro, brillo mate y fractura concoidea</skos:definition>
    <skos:definition xml:lang="en">Consolidated or unconsolidated coal, formed by putrefaction in subaqueous environments and under anoxic conditions, from organic matter derived from phytoplankton. It is fine-grained, compact and homogeneous in appearance to the naked eye, dark in colour, with matt lustre and conchoidal fracture</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/coal"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-dioritica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca diorítica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dioritic rock</skos:prefLabel>
    <skos:definition xml:lang="es">Dioritoide en el que la plagioclasa, predominantemente cálcica, constituye más del 90% de los feldespatos</skos:definition>
    <skos:definition xml:lang="en">Dioritoid in which plagioclase, predominantly calcic, constitutes more than 90% of the feldspars</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/dioriticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/dioritic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/kalsilitita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">kalsilitita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">kalsilite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con más de un 10% modal de kalsilita, además de otros minerales como clinopiroxeno, olivino, melilita, leucita o flogopita. ya que la kalsilita no es estable en condiciones de enfriamiento lento, esta roca suele constituir lavas de grano fino o muy fino</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with more than 10 modal % of kalsilite, in addition to other minerals such as clinopyroxene, olivine, melilite, leucite or phlogopite. Since kalsilite is not stable under slow cooling conditions, this rock usually forms fine- to very fine-grained lavas</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/kalsiliticAndMeliliticRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/kalsilitic_and_melilitic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-grandes-grupos-de-materiales-material-metamorfico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Grandes Grupos de Materiales / Material Metamórfico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Major Material Groups / Metamorphic Material</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría jerárquica de Grandes Grupos de Materiales / Material Metamórfico, que se caracteriza por representar el nivel superior de clasificación que agrupa todos los materiales derivados de rocas preexistentes, mediante cambios mineralógicos, químicos o estructurales, en estado sólido, en respuesta a variaciones físico-químicas de presión y temperatura.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the hierarchical category of Major Material Groups / Metamorphic Material, characterized by representing the top-level classification that groups all materials derived from pre-existing rocks, through mineralogical, chemical or structural changes, in solid state, in response to physicochemical variations of pressure and temperature.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-metamorfico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-metamorfica"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/metapelita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">metapelita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">metapelite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica derivada de un protolito pelítico</skos:definition>
    <skos:definition xml:lang="en">Metamorphic rock derived from a pelitic protolith</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/metamorphicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gabroide">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gabroide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">gabbroid</skos:prefLabel>
    <skos:definition xml:lang="es">Término utilizado en la descripción provisional de rocas de tipo gabro o monzogabro</skos:definition>
    <skos:definition xml:lang="en">Term used in the provisional description of gabbro or monzogabbro type rocks</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroid"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroid"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca-ignea-exotica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca ígnea exótica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">exotic igneous rock</skos:prefLabel>
    <skos:definition xml:lang="es">Roca ígnea con características mineralógicas, texturales o de afloramiento poco comunes, entre las que se encuentran: un contenido mayor del 10% de melilita o leucita, la presencia de kalsilita o un porcentaje superior al 50% de minerales carbonatados. generalmente oscura y con abundantes fenocristales, incluye las carbonatitas, rocas kalsilíticas y melilíticas, kimberlitas, lamproítas, leucititas y los lamprófidos</skos:definition>
    <skos:definition xml:lang="en">Igneous rock with uncommon mineralogical, textural or outcrop characteristics, including: a melilite or leucite content greater than 10%, the presence of kalsilite, or a carbonate mineral percentage exceeding 50%. Generally dark and with abundant phenocrysts, it includes carbonatites, kalsilitic and melilitic rocks, kimberlites, lamproites, leucitites and lamprophyres</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/exoticCompositionIgneousRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/exotic_composition_igneous_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://linked.data.gov.au/org/cgi">
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <sdo:name>Commission for the Management and Application of Geoscience Information</sdo:name>
    <sdo:url rdf:resource="http://www.cgi-iugs.org"/>
  </rdf:Description>
</rdf:RDF>
