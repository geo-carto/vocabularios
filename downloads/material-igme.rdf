  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/gabronorita-olivinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">gabronorita olivínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">olivine gabbronorite</skos:prefLabel>
    <skos:definition xml:lang="es">Gabronorita con un contenido de olivino superior al 5%</skos:definition>
    <skos:definition xml:lang="en">Gabbronorite with an olivine content exceeding 5%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gabbroicRock"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gabbroic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/carbon-impuro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">carbón impuro</skos:prefLabel>
    <skos:prefLabel xml:lang="en">impure coal</skos:prefLabel>
    <skos:definition xml:lang="es">Carbón duro y compacto, con un contenido de impurezas superior al 50%</skos:definition>
    <skos:definition xml:lang="en">Hard and compact coal with an impurity content exceeding 50%</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/coal"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/coal"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-rocas-sedimentarias-y-sedimentos-con-connotaciones-geneticas">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Rocas Sedimentarias y Sedimentos con Connotaciones Genéticas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Sedimentary Rocks And Sediments With Genetic Connotations</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Rocas Sedimentarias y Sedimentos con Connotaciones Genéticas, que se caracteriza por clasificar las rocas y sedimentos según su origen o proceso de formación específico, como depósitos fluviales, eólicos, glaciares o lacustres.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Sedimentary Rocks and Sediments with Genetic Connotations, characterized by classifying rocks and sediments according to their specific origin or formation process, such as fluvial, aeolian, glacial, or lacustrine deposits.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/biostromo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/canto-estriado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/canto-facetado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/canto-rodado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/contornita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-hemipelagico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/dropstone"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/eolianita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/espeleotema"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/fanglomerado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/fango"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/fango-carbonatado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/flysch-calcareo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/flysch-siliceo"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/harina-glaciar"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/laterita"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/megabrecha"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/molasa"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/olistolito"/>
