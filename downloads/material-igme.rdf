  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/monzogabro-foidico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">monzogabro foídico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">foidic monzogabbro</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica perteneciente al grupo de las rocas gabroicas foídicas, en la que la plagioclasa constituye menos del 90% de los feldespatos. es el equivalente intrusivo de la basanita fonolítica</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock belonging to the group of foidic gabbroic rocks, in which plagioclase constitutes less than 90% of the feldspars. It is the intrusive equivalent of phonolitic basanite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidMonzogabbro"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_monzogabbro"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/barita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">barita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">barite</skos:prefLabel>
    <skos:altLabel xml:lang="es">baritina</skos:altLabel>
    <skos:definition xml:lang="es">Roca formada por el mineral del mismo nombre, de fórmula baso4, perteneciente a la clase de los sulfatos, que cristaliza en el sistema rómbico, formando masas espáticas compactas, fibrosas o granudas, de apariencia marmórea o estalactítica. es incoloro, blanco o amarillento y varía de transparente a opaco</skos:definition>
    <skos:definition xml:lang="en">Rock formed by the mineral of the same name, with the formula BaSO4, belonging to the class of sulfates, crystallizing in the orthorhombic system, forming compact sparitic, fibrous or granular masses of marble-like or stalactitic appearance. It is colourless, white or yellowish and varies from transparent to opaque</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/evaporite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/evaporite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-cristalina">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">caliza cristalina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">crystalline limestone</skos:prefLabel>
    <skos:definition xml:lang="es">Caliza constituida por mosaicos de cristales y cuya textura sedimentaria no es reconocible</skos:definition>
    <skos:definition xml:lang="en">Limestone consisting of crystal mosaics in which the sedimentary texture is not recognizable</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/caliza-lumaquelica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">lumaquela</skos:prefLabel>
    <skos:prefLabel xml:lang="en">shell bed limestone</skos:prefLabel>
    <skos:altLabel xml:lang="es">coquina, caliza lumaquélica</skos:altLabel>
    <skos:definition xml:lang="es">Roca clástica formada por aglomeración de conchas de moluscos o braquiópodos, o por fragmentos de las mismas, de tamaño superior a 2 mm</skos:definition>
    <skos:definition xml:lang="en">Clastic rock formed by the agglomeration of mollusc or brachiopod shells, or their fragments, with a size exceeding 2 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/limestone"/>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/conglomerate"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/limestone"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/clastic_conglomerate"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/eclogita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">eclogita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">eclogite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de alta presión formada a partir de rocas magmáticas de composición básica y constituida esencialmente por granate rico en magnesio y clinopiroxeno rico en sodio. puede contener cantidades subordinadas de otros minerales como lawsonita, epidota, glaucofana, barroisita, rutilo, cuarzo, coesita, paragonita o distena</skos:definition>
    <skos:definition xml:lang="en">High-pressure metamorphic rock formed from mafic igneous rocks, consisting essentially of magnesium-rich garnet and sodium-rich clinopyroxene. It may contain subordinate amounts of other minerals such as lawsonite, epidote, glaucophane, barroisite, rutile, quartz, coesite, paragonite or kyanite</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/eclogite"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/eclogite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/material-antropico-no-consolidado">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">material antrópico no consolidado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">unconsolidated anthropic material</skos:prefLabel>
    <skos:altLabel xml:lang="es">depósito antrópico</skos:altLabel>
    <skos:definition xml:lang="es">Material no consolidado de origen artificial humano</skos:definition>
    <skos:definition xml:lang="en">Unconsolidated material of artificial human origin</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/anthropogenicUnconsolidatedMaterial"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/anthropogenic_unconsolidated_material"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/andesita-basaltica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">andesita basáltica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">basaltic andesite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca volcánica intermedia o básica, subalcalina o calcoalcalina, con plagioclasa de composición similar a la de la andesita y con minerales ferromagnesianos característicos de los basaltos</skos:definition>
    <skos:definition xml:lang="en">Intermediate or basic, subalkaline or calc-alkaline volcanic rock, with plagioclase of similar composition to that of andesite and with ferromagnesian minerals characteristic of basalts</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/andesite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/andesite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/ijolita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">ijolita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ijolite</skos:prefLabel>
    <skos:definition xml:lang="es">Roca plutónica de la familia de las foidolitas, compuesta por cantidades similares de nefelina y clinopiroxeno, generalmente augita egirínica o egirina</skos:definition>
    <skos:definition xml:lang="en">Plutonic rock of the foidolite family, composed of similar amounts of nepheline and clinopyroxene, generally aegirine-augite or aegirine</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidolite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foidolite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/bloque">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">bloque</skos:prefLabel>
    <skos:prefLabel xml:lang="en">block</skos:prefLabel>
    <skos:definition xml:lang="es">Clasto de diámetro mayor de 256 mm</skos:definition>
    <skos:definition xml:lang="en">Clast with a diameter exceeding 256 mm</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/gravelSizeSediment"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/gravel_size_sediment"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/roca">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">roca</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rock</skos:prefLabel>
    <skos:definition xml:lang="es">Material sólido y compactado de origen natural formado, en la mayor parte de los casos, por una asociación de minerales de la misma o de distintas especies, excepcionalmente, algunas rocas volcánicas pueden estar constituidas por minerales y vidrio o solamente por vidrio</skos:definition>
    <skos:definition xml:lang="en">Solid, compacted material of natural origin formed, in most cases, by an association of minerals of the same or different species; exceptionally, some volcanic rocks may consist of minerals and glass or of glass only</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/rock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/malignita">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">malignita</skos:prefLabel>
    <skos:prefLabel xml:lang="en">malignite</skos:prefLabel>
    <skos:definition xml:lang="es">Sienita nefelínica peralcalina</skos:definition>
    <skos:definition xml:lang="en">Peralkaline nepheline syenite</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingSyenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/esquisto-glaucofanico">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">esquisto glaucofánico</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glaucophane schist</skos:prefLabel>
    <skos:definition xml:lang="es">Roca metamórfica de alta presión y temperatura media-baja, esquistosa y de color azulado debido a la presencia de anfíbol alcalino típicamente glaucofana, generalmente resultante del metamorfismo de rocas magmáticas de composición basáltica. se recomienda su uso en vez de esquisto azul, por ser éste un nombre de facies</skos:definition>
    <skos:definition xml:lang="en">High-pressure, medium- to low-temperature metamorphic rock, schistose and bluish in colour due to the presence of alkalic amphibole (typically glaucophane), generally resulting from the metamorphism of mafic igneous rocks of basaltic composition. Its use is recommended instead of 'blueschist', as that is a facies name</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/glaucophaneLawsoniteEpidoteMetamorphicRock"/>
    <skos:exactMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/glaucophane_lawsonite_epidote_metamorphic_rock"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/sienita-nefelinica">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">sienita nefelínica</skos:prefLabel>
    <skos:prefLabel xml:lang="en">nepheline syenite</skos:prefLabel>
    <skos:definition xml:lang="es">Sienita foídica en la que la nefelina constituye el feldespatoide dominante</skos:definition>
    <skos:definition xml:lang="en">Foid syenite in which nepheline constitutes the dominant feldspathoid</skos:definition>
    <skos:relatedMatch rdf:resource="http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingSyenite"/>
    <skos:relatedMatch rdf:resource="http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_syenite"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/material-igme/collection/coleccion-materiales-igneos">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/material-igme"/>
    <skos:prefLabel xml:lang="es">Colección - Materiales Ígneos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection - Igneous Materials</skos:prefLabel>
    <skos:definition xml:lang="es">Colección de materiales que pertenecen a la categoría de Materiales Ígneos, que se caracteriza por incluir materiales resultantes del enfriamiento y la solidificación de un magma, que pueden ser volcánicos o plutónicos, según se emplacen en la superficie o en el interior de la corteza terrestre.</skos:definition>
    <skos:definition xml:lang="en">Collection of materials belonging to the category of Igneous Materials, characterized by including materials resulting from the cooling and solidification of a magma, which can be volcanic or plutonic, depending on whether they are emplaced at the surface or in the interior of the Earth's crust.</skos:definition>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/brecha-intrusiva"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/cumulado"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/deposito-volcanoclastico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-acido"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-basico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-igneo-fragmentario"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-igneo-intermedio"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/material-piroclastico"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-acida"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-afanitica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-alcalina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-basica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-calcoalcalina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-criptocristalina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-faneritica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-felsica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-hialocristalina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-holocristalina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-ignea-exotica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-ignea-fragmentaria"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-intermedia"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-intrusiva"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-leucocratica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-mafica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-melanocratica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-mesocratica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-metaluminosa"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-microcristalina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-peralcalina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-peraluminosa"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-salica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-subalcalina"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-subvolcanica"/>
    <skos:member rdf:resource="https://geo-carto.github.io/vocabularios/material-igme/roca-toleitica"/>
