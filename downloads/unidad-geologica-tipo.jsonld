      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Unidad geológica producida por un desplazamiento de materiales pendiente abajo inducido por la gravedad y caracterizado por el tipo de movimiento que da lugar al depósito y por la relación que tienen en el tiempo y en el espacio los distintos tipos de movimiento presentes en el depósito."
      },
      {
        "@language": "en",
        "@value": "Geologic unit produced by gravity driven, down-slope displacement of material, and characterized by the type of movement giving rise to the deposit, and by how the individual movement types present in the deposit are related in time and space."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://inspire.ec.europa.eu/codelist/GeologicUnitTypeValue/massMovementUnit"
      },
      {
        "@id": "http://resource.geosciml.org/classifier/cgi/geologicunittype/mass_movement_unit"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://geo-carto.github.io/vocabularios/unidad-geologica-tipo"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "es",
        "@value": "unidad de movimiento en masa"
      },
      {
        "@language": "en",
        "@value": "mass movement unit"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@value": "Válido"
      }
    ]
  },
