    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "Unidad geológica definida a partir de características estructurales o de deformación, de relaciones mutuas, de su origen o de su evolución histórica. El material que contiene puede ser ígneo, sedimentario o metamórfico."
      },
      {
        "@language": "en",
        "@value": "Geologic unit defined on basis of structural or deformation features, mutual relations, origin or historical evolution. Contained material may be igneous, sedimentary, or metamorphic."
      }
