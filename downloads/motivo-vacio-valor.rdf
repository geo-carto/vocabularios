    <skos:prefLabel xml:lang="es">retenido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">withheld</skos:prefLabel>
    <skos:definition xml:lang="es">El valor no se hace público por motivos de confidencialidad, seguridad u otra política.</skos:definition>
    <skos:definition xml:lang="en">The value is not made publicly available for confidentiality, security, or other policy reasons.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/VoidReasonValue/Withheld"/>
    <adms:status>Válido</adms:status>
