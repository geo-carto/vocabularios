  </rdf:Description>
  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/motivo-vacio-valor/desconocido">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="https://geo-carto.github.io/vocabularios/motivo-vacio-valor"/>
    <rdfs:isDefinedBy rdf:resource="https://geo-carto.github.io/vocabularios/motivo-vacio-valor"/>
    <skos:topConceptOf rdf:resource="https://geo-carto.github.io/vocabularios/motivo-vacio-valor"/>
    <skos:prefLabel xml:lang="es">desconocido</skos:prefLabel>
    <skos:prefLabel xml:lang="en">unknown</skos:prefLabel>
    <skos:definition xml:lang="es">El valor correcto del tipo de datos específico no se conoce o no está proporcionado por la fuente de datos, o la fuente de datos no está disponible.</skos:definition>
    <skos:definition xml:lang="en">The correct value for the specific spatial data type is not known to, or not provided by the data provider, or the data source is not available.</skos:definition>
    <skos:exactMatch rdf:resource="http://inspire.ec.europa.eu/codelist/VoidReasonValue/Unknown"/>
    <adms:status>Válido</adms:status>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-01</dcterms:created>
  </rdf:Description>
