  <rdf:Description rdf:about="https://geo-carto.github.io/vocabularios/motivo-vacio-valor">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="es">Valor de motivo de vacío</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Void Reason Value</skos:prefLabel>
    <dcterms:title xml:lang="es">Valor de motivo de vacío</dcterms:title>
    <dcterms:title xml:lang="en">Void Reason Value</dcterms:title>
    <skos:definition xml:lang="es">Términos que describen las razones por las que un valor puede estar vacío o no proporcionado en un atributo.</skos:definition>
    <skos:definition xml:lang="en">Terms describing the reasons why a value may be void or not provided in an attribute.</skos:definition>
    <dcterms:description xml:lang="es">Términos que describen las razones por las que un valor puede estar vacío o no proporcionado en un atributo.</dcterms:description>
    <dcterms:description xml:lang="en">Terms describing the reasons why a value may be void or not provided in an attribute.</dcterms:description>
