    <skos:prefLabel xml:lang="es">no poblado</skos:prefLabel>
    <skos:prefLabel xml:lang="en">unpopulated</skos:prefLabel>
    <skos:definition xml:lang="es">El campo o atributo todavía no se ha proporcionado o rellenado, pero puede ser proporcionado en el futuro.</skos:definition>
    <skos:definition xml:lang="en">The attribute or field has not been provided or populated yet, but may be provided in the future.</skos:definition>
