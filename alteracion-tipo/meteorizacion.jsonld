{
  "id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion",
  "type": "Concept",
  "prefLabel": {
    "en": "weathering",
    "es": "meteorización"
  },
  "definition": {
    "en": "Group of physical, chemical and biological processes by which a rock, sediment or soil, near the Earth's surface, are changed in color, texture, composition, firmness or form, with little or no transport of the altered material.",
    "es": "Conjunto de procesos físicos, químicos y biológicos por los que una roca, sedimento o suelo, próximo a la superficie terrestre, cambia su color, textura, composición, resistencia o forma, sin o escaso transporte de los materiales alterados"
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/arenizacion",
      "prefLabel": {
        "en": "arenization",
        "es": "arenización"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/argilizacion",
      "prefLabel": {
        "en": "argillation",
        "es": "argilización"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/caolinizacion",
      "prefLabel": {
        "en": "kaolinitation",
        "es": "caolinización"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/carbonatacion",
      "prefLabel": {
        "en": "carbonation",
        "es": "carbonatación"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/ferruginizacion",
      "prefLabel": {
        "en": "ferrugination",
        "es": "ferruginización"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/alteracion-tipo/silicificacion",
      "prefLabel": {
        "en": "silification",
        "es": "silicificación"
      }
    }
  ],
  "broader": {
