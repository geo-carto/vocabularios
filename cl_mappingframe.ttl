    dcterms:provenance "Términos originales del estándar GeoSciML traducidos al español por el IGME" ;
    dcterms:publisher <https://www.igme.es/> ;
    owl:versionInfo "1.0.0" ;
    skos:definition "Terms referring to the mapping framework."@en,
        "Términos referidos al marco de cartografiado."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Marco de cartografiado."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/marco-de-cartografiado/base-del-cuaternario>,
        <https://geo-carto.github.io/vocabularios/marco-de-cartografiado/geologia-superficial>,
        <https://geo-carto.github.io/vocabularios/marco-de-cartografiado/techo-de-la-roca-madre>,
        <https://geo-carto.github.io/vocabularios/marco-de-cartografiado/techo-del-basamento> ;
    skos:prefLabel "Mapping frame"@en,
        "Marco de cartografiado"@es .

