@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geo-carto.github.io/vocabularios/marco-de-cartografiado/collection> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:definition "All concepts in this vocabulary."@en,
        "Todos los conceptos en este vocabulario."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:member <https://geo-carto.github.io/vocabularios/marco-de-cartografiado/base-del-cuaternario>,
        <https://geo-carto.github.io/vocabularios/marco-de-cartografiado/geologia-superficial>,
        <https://geo-carto.github.io/vocabularios/marco-de-cartografiado/techo-de-la-roca-madre>,
        <https://geo-carto.github.io/vocabularios/marco-de-cartografiado/techo-del-basamento> ;
    skos:prefLabel "Mapping frame - All concepts"@en,
        "Marco de cartografiado - Todos los conceptos"@es .

<https://linked.data.gov.au/org/cgi-gtwg> a sdo:Organization ;
    sdo:affiliation <https://linked.data.gov.au/org/cgi> ;
    sdo:name "CGI Geoscience Terminology Working Group" ;
    sdo:url <http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html> .

<https://linked.data.gov.au/org/cgi> a sdo:Organization ;
    sdo:name "Commission for the Management and Application of Geoscience Information" ;
    sdo:url <http://www.cgi-iugs.org> .

<https://geo-carto.github.io/vocabularios/marco-de-cartografiado/base-del-cuaternario> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:definition "Base of the predominantly unconsolidated sedimentary material of Quaternary age, also referred to as superficial deposits"@en,
        "Base de material sedimentario predominantemente no consolidado del período cuaternario"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/MappingFrameValue/baseOfQuaternary>,
        <http://resource.geosciml.org/classifier/cgi/mappingframe/base_of_quaternary> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:prefLabel "base of Quaternary"@en,
        "base del cuaternario"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/marco-de-cartografiado/geologia-superficial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:definition "Bedrock and predominantly unconsolidated sedimentary material of Quaternary age (superficial deposits) that would be visible if the overlying soil was removed or are exposed at the topographic surface"@en,
        "Roca y depósitos superficiales que se hacen visibles si se retira el suelo suprayacente o que están expuestos en la superficie topográfica"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/MappingFrameValue/surfaceGeology>,
        <http://resource.geosciml.org/classifier/cgi/mappingframe/surface_geology> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:prefLabel "surface geology"@en,
        "geología superficial"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/marco-de-cartografiado/techo-de-la-roca-madre> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:definition "The surface in the crust of the Earth below sedimentary or volcanic deposits, or tectonically transported rock unit. What constitutes basement can depend on the context and may comprise other sedimentary, igneous and/or metamorphic rocks"@en,
        "Superficie superior de la roca, generalmente consolidada, que o bien está expuesta en la superficie topográfica o bien está cubierta por otros depósitos no consolidados"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/MappingFrameValue/topOfBedrock>,
        <http://resource.geosciml.org/classifier/cgi/mappingframe/top_of_bedrock> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:prefLabel "top of bedrock"@en,
        "techo de la roca madre"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/marco-de-cartografiado/techo-del-basamento> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:definition "Top surface of the usually solid rock that may either be exposed at the topographic surface or covered by other younger unconsolidated deposits of Quaternary age (superficial deposits)"@en,
        "Superficie de la corteza terrestre existente debajo de los depósitos sedimentarios o volcánicos, o unidad de roca transportada tectónicamente"@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/MappingFrameValue/topOfBasement>,
        <http://resource.geosciml.org/classifier/cgi/mappingframe/top_of_basement> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    skos:prefLabel "top of basement"@en,
        "techo del basamento"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/marco-de-cartografiado> ;
    adms:status "Válido" .

