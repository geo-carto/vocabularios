{"id":"https://geo-carto.github.io/vocabularios/evento-proceso","type":"ConceptScheme","prefLabel":{"en":"Event Process","es":"Proceso asociado a evento"},"description":{"es":"Términos referidos a procesos asociados a eventos geológicos."},"publisher":{"id":"https://www.igme.es/"},"created":"2026-03-01","modified":"2026-03-01","creator":"https://commission.europa.eu/","provenance":"Términos originales de INSPIRE","versionInfo":"1.0.0","license":{"id":"https://creativecommons.org/licenses/by/4.0/"},"hasTopConcept":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/arado-profundo","prefLabel":{"en":"deep ploughing","es":"arado profundo"},"definition":{"en":"Mixing of loose surface material by ploughing deeper than frequently done during annual soil cultivation","es":"Mezcla de material suelto por arado más profundo que lo frecuentemente hecho durante el cultivo anual del suelo."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/cavado","prefLabel":{"en":"digging","es":"cavado"},"definition":{"en":"Repeated mixing of loose surface material by digging with a spade or similar tool","es":"Repetida pérdida de material superficial por cavar con una pala o herramienta similar."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/crecimiento-organismico-in-situ","prefLabel":{"en":"in-situ organismic growth","es":"crecimiento organísmico in-situ"},"definition":{"en":"Accumulation of dead organicmaterial originating from the plants, e.g. peat accumulation in bogs","es":"Acumulación de materia orgánica muerta originada por las plantas, e. g. acumulación de turba en pantanos"}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/crioturbacion","prefLabel":{"en":"cryoturbation","es":"crioturbación"},"definition":{"en":"A collective term to describe the stirring and churning of unconsolidated material resulting from frost action","es":"Término colectivo para describir la perturbación y alteración de material no consolidado como resultado de la acción de las heladas."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-el-agua","prefLabel":{"en":"deposition from water","es":"depósito desde el agua"},"definition":{"en":"Deposition of sediment from water, in which the sediment has been transported after entrainment in the moving water or after deposition from other moving fluids.","es":"Depósito de sedimento desde el agua, en la cual el sedimento ha sido transportado tras haber entrado en el agua en movimiento o tras haber sido depositado desde otros fluidos en movimiento."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-el-aire","prefLabel":{"en":"deposition from air","es":"depósito desde el aire"},"definition":{"en":"Deposition of sediment from air, in which the sediment has been transported after entrainment in the moving air.","es":"Depósito de sedimento desde el aire, en el cual el sedimento ha sido transportado tras su entrada en el aire en movimiento."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-un-fluido","prefLabel":{"en":"deposition from fluid","es":"depósito desde un fluido"},"definition":{"en":"Deposition of sediment from moving water or air, in which the sediment is transported by entrainment in the moving fluid. constrast with debris flow or turbidity current deposition in which movement of fluid/sediment mixture is due to incorporation of sediment in fluid.","es":"Depósito de sedimento desde agua o aire, en el cual el sedimento es depositado tras entrar en el fluido."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-o-desde-hielos-en-movimiento","prefLabel":{"en":"deposition by or from moving ice","es":"depósito por o desde hielos en movimiento"},"definition":{"en":"Deposition of sediment from ice by melting or pushing. the material has been transported in the ice after entrainment in the moving ice or after deposition from other moving fluids on the ice.","es":"Depósito de sedimentos a partir de hielo por fusión o empuje. el material ha sido transportado en el hielo tras su entrada en el hielo en movimiento o tras depósito sobre el hielo desde otros fluidos en movimiento."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/eluviacion","prefLabel":{"en":"deluviation","es":"eluviación"},"definition":{"en":"Process of non-linear, grain-size selective erosion","es":"Proceso de erosión selectiva no linear a escala granular."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/mezcla","prefLabel":{"en":"mixing","es":"mezcla"},"definition":{"en":"Mixing","es":"Mezcla"}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/moldeado","prefLabel":{"en":"casting","es":"moldeado"},"definition":{"en":"Covering of the surface with a material liquid during processing and solidifying afterwards","es":"Cubrimiento de la superficie con un material líquido durante el proceso y que se solidifica después."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geologico","prefLabel":{"en":"geologic process","es":"proceso geológico"},"definition":{"en":"Process that effects the geologic record","es":"Proceso que afecta al registro geológico."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/actividad-humana","prefLabel":{"en":"human activity","es":"actividad humana"},"definition":{"en":"Processes of human modification of the earth to produce geologic features.","es":"Proceso de modificación de la superficie o subsuelo de la tierra por la actividad humana que origina objetos geológicos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/excavacion","prefLabel":{"en":"excavation","es":"excavación"},"definition":{"en":"Removal of material, as in a mining operation","es":"Extracción de material, como en una operación minera."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/grada","prefLabel":{"en":"grading","es":"grada"},"definition":{"en":"Leveling of earth surface by rearrangement of prexisting material","es":"Nivelamiento de la superficie del terreno por redistribución de material pre-existente."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/transporte-y-deposito-de-material","prefLabel":{"en":"material transport and deposition","es":"transporte y depósito de material"},"definition":{"en":"Transport and heaping of material, as in a land fill, mine dump, dredging operations","es":"Transporte y amontonamiento de material, como en un vertedero, escombrera de mina, operaciones de dragado."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/agotamiento-del-oxigeno-en-aguas-profundas","prefLabel":{"en":"deep water oxygen depletion","es":"agotamiento del oxígeno en aguas profundas"},"definition":{"en":"Process of removal of oxygen from from the deep part of a body of water.","es":"Proceso de reducción de oxígeno de la parte profunda de una masa de agua."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deformacion","prefLabel":{"en":"deformation","es":"deformación"},"definition":{"en":"Movement of rock bodies by displacement on fault or shear zones, or change in shape of a body of earth material.","es":"Movimiento de masas de roca por desplazamiento en zonas de falla o de cizalla, o cambio en la forma de una masa de material terrestre."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/cizallamiento","prefLabel":{"en":"shearing","es":"cizallamiento"},"definition":{"en":"A deformation in which contiguous parts of a body are displaced relatively to each other in a direction parallel to a surface. the surface may be a discrete fault, or the deformation may be a penetrative strain and the shear surface is a geometric abstraction.","es":"Deformación en la que partes contiguas de un cuerpo son desplazadas relativamente la una de la otra en una dirección paralela a una superficie. la superficie puede ser una falla discreta, o la deformación puede ser un esfuerzo penetrativo y la superficie de cizalla ser una abstracción geométrica."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/fallamiento","prefLabel":{"en":"faulting","es":"fallamiento"},"definition":{"en":"The process of fracturing, frictional slip, and displacement accumulation that produces a fault","es":"Proceso de fracturación, deslizamiento friccional y acumulación de desplazamiento que produce una falla."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/flujo-ductil","prefLabel":{"en":"ductile flow","es":"flujo dúctil"},"definition":{"en":"Deformation without apparent loss of continuity at the scale of observation.","es":"Deformación sin aparente pérdida de continuidad a la escala de observación."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/arrastre-por-difusion-intracristalina","prefLabel":{"en":"diffusion creep","es":"arrastre por difusión intracristalina"},"definition":{"en":"Grain-scale, ductile deformation accomplished by the motion of atoms through crystals, along grain boundaries, and through pore fluids.","es":"Deformación dúctil a escala de grano producida por el movimiento de átomos a través de los cristales, a lo largo de los bordes de grano, y a través de fluidos intersticiales."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/arrastre-por-disolucion","prefLabel":{"en":"dissolution creep","es":"arrastre por disolución"},"definition":{"en":"Deformation by dissolution under the effects of differential stress and its transport to a new location by movement of fluid in the rock body.","es":"Deformación por disolución bajo los efectos de un esfuerzo diferencial y su transporte a una nueva localización por movimiento del fluido dentro del cuerpo de roca."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/maclado-mecanico","prefLabel":{"en":"deformation twinning","es":"maclado mecánico"},"definition":{"en":"Deformation of a crystal by gliding to produce crystallographic twinning.","es":"Deformación de un cristal por deslizamiento para producir maclado cristalográfico."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/fracturacion","prefLabel":{"en":"fracturing","es":"fracturación"},"definition":{"en":"The formation of a surface of failure resulting from stress","es":"Formación de una superficie de falla como resultado de esfuerzos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/microfracturacion","prefLabel":{"en":"microfracturing","es":"microfracturación"},"definition":{"en":"Development of fractures within a single grain or cutting several grains.","es":"Desarrollo de fracturas dentro de un único grano o cortando varios granos."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/plegamiento","prefLabel":{"en":"folding","es":"plegamiento"},"definition":{"en":"Deformation in which planar surfaces become regularly curviplanar surfaces with definable limbs (zones of lower curvature) and hinges (zones of higher curvature).","es":"Deformación en la cual las superficies planares se transforman en superficies regularmente curviplanares con flancos (zonas de menor curvatura) y charnelas (zonas de mayor curvatura) definidos."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/especiacion","prefLabel":{"en":"speciation","es":"especiación"},"definition":{"en":"Process that results inappearance of new species.","es":"Proceso que da lugar a la aparición de una nueva especie."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/extincion","prefLabel":{"en":"extinction","es":"extinción"},"definition":{"en":"Process of disappearance of a species or higher taxon, so that it no longer exists anywhere or in the subsequent fossil record.","es":"Proceso de desaparición de una especie o de un taxón superior, que tiene como consecuencia su inexistencia en el registro fósil posterior."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/impacto-de-bolido","prefLabel":{"en":"bolide impact","es":"impacto de bólido"},"definition":{"en":"The impact of an extraterrestrial body on the surface of the earth.","es":"Impacto de un cuerpo extraterrestre sobre la superficie de la tierra."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/impacto-cometario","prefLabel":{"en":"cometary impact","es":"impacto cometario"},"definition":{"en":"The impact of a comet on the surface of the earth","es":"Impacto de un cometa sobre la superficie de la tierra."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/impacto-meteoritico","prefLabel":{"en":"meteorite impact","es":"impacto meteorítico"},"definition":{"en":"The impact of a meteorite on the surface of the earth","es":"Impacto de un meteorito sobre la superficie de la tierra."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion","prefLabel":{"en":"weathering","es":"meteorización"},"definition":{"en":"The process or group of processes by which earth materials exposed to atmospheric agents at or near the earth's surface are changed in color, texture, composition, firmness, or form, with little or no transport of the loosened or altered material. processes typically include oxidation, hydration, and leaching of soluble constituents.","es":"Proceso o grupo de procesos en virtud de los cuales los materiales terrestres expuestos a los agentes atmosféricos en la superficie de la tierra o cerca de ella cambian de color, textura, composición, dureza o forma, con transporte nulo o escaso de materiales sueltos o alterados. entre estos procesos se incluyen típicamente los de oxidación, hidratación y lixiviación de componentes solubles."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-biologica","prefLabel":{"en":"biological weathering","es":"meteorización biológica"},"definition":{"en":"Breakdown of rocks by biological agents, e.g. the penetrating and expanding force of roots, the presence of moss and lichen causing humic acids to be retained in contact with rock, and the work of animals (worms, moles, rabbits) in modifying surface soil","es":"Destrucción de las rocas por agentes biológicos, e. g. la fuerza de penetración y expansión de las raíces, la presencia de musgos y líquenes causando que ácidos húmicos queden retenidos en contacto con la roca, y el trabajo de animales (lombrices, topos, conejos) modificando la superficie del suelo."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-fisica","prefLabel":{"en":"physical weathering","es":"meteorización física"},"definition":{"en":"The process of weathering by which frost action, salt-crystal growth, absorption of water, and other physical processes break down a rock to fragments, involving no chemical change","es":"Proceso de meteorización por el cual la acción de las heladas, el crecimiento de cristales de sal, la absorción de agua y otros procesos físicos deshacen una roca en fragmentos, sin involucrar cambios químicos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/gelifraccion","prefLabel":{"en":"frost shattering","es":"gelifracción"},"definition":{"en":"Propagation of fractures due to expansion of freezing water in intergranular spaces and fractures in a rock body. result is mechanical disintegration spliitting, or breakup of rock.","es":"Propagación de fracturas debida a la expansión del agua al congelarse en espacios intergranulares y fracturas en un cuerpo rocoso. produce la desintegración mecánica o rotura de la roca."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/haloclastia","prefLabel":{"en":"haloclasty","es":"haloclastia"},"definition":{"en":"Propagation of fractures in rock due to crytallization of mineral salts (typically sodium chloride) from interstitial water, or volumetrick expansion of salts in capillaries, or hydration pressure of interstitial, trapped salts. generally results in mechanical disintegration of the rock surface.","es":"Propagación de fracturas en la roca debido a la cristalización de sales minerales (típicamente cloruro sódico) desde el agua intersticial, o por la expansión volumétrica de las sales en capilares, o por la presión de hidratación de sales atrapadas en intersticios. generalmente resulta en la desintegración mecánica de la superficie de la roca."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-por-choque-termico","prefLabel":{"en":"thermal shock weathering","es":"meteorización por choque térmico"},"definition":{"en":"Propagation of fractures near the surface of solid rock due to expansion and contraction caused by temperature changes. fractures typically propagate along surfaces close to and subparallel to the surface of the outcrop.","es":"Propagación de fracturas cerca de la la superficie de la roca dura debida a la expansión y contracción causadas por cambios de temperatura. las fracturas típicamente se propagan a lo largo de superficies cercanas y subparalelas a la superficie del afloramiento."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-por-descompresion","prefLabel":{"en":"pressure release weathering","es":"meteorización por descompresión"},"definition":{"en":"Propagation of fractures near the surface of solid rock due to expansion related to release of confining pressure when deeply buried rock is unroofed. fractures typically propagate along surfaces close to and subparallel to the surface of the outcrop.","es":"Propagación de fracturas cerca de la superficie de la roca dura debido a la expansión relacionada con el descenso de la presión confinante cuando una roca profundamente enterrada es exhumada. las fracturas típicamente se propagan a lo largo de superficies cercanas y subparalelas a la superficie del afloramiento."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-quimica","prefLabel":{"en":"chemical weathering","es":"meteorización química"},"definition":{"en":"The process of weathering by which chemical reactions (hydrolysis, hydration, oxidation, carbonation, ion exchange, and solution) transform rocks and minerals into new chemical combinations that are stable under conditions prevailing at or near the earth's surface; e.g. the alteration of orthoclase to kaolinite.","es":"Proceso de meteorización por el cual las reacciones químicas (hidrólisis, hidratación, oxidación, carbonatación, intercambio iónico, y disolución) transforman las rocas y minerales en nuevas combinaciones químicas que son estables bajo las condiciones que prevalecen en o cerca de la superficie de la tierra; e. g. la alteración de ortoclasa a caolinita."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/disolucion","prefLabel":{"en":"dissolution","es":"disolución"},"definition":{"en":"The process of dissolving into a homogenous solution, as when an acidic solution dissolves limestone. in karst, refers to the process of dissolving rock to produce landforms, in contrast to solution, the chemical product of dissolution.","es":"Proceso de disolver en una solución homogénea, como cuando una solución ácida disuelve la caliza. en karsts, se refiere al proceso de disolución de la roca para producir formas del relieve, en contraste con la solución, el producto químico de la disolución."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/hidratacion","prefLabel":{"en":"hydration","es":"hidratación"},"definition":{"en":"The process of absorption of water into the crystal structure of a mineral, thereby changing its volume and fracturing and loosening grains","es":"Proceso de absorción de agua en la estructura cristalina de un mineral, cambiando así su volumen y fracturando y empequeñeciendo los granos."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/hidrolisis","prefLabel":{"en":"hydrolysis","es":"hidrólisis"},"definition":{"en":"A decomposition reaction involving water. in geology, it commonly indicates reaction between silicate minerals and either pure water or aqueous solution. in such reactions, h","es":"Reacción de descomposición que involucra al agua. en geología, indica comúnmente una reacción entre minerales silicatados y bien agua pura o una solución acuosa."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/oxidacion","prefLabel":{"en":"oxidation","es":"oxidación"},"definition":{"en":"Chemical reaction that involve stripping of electrons from cations. typicall reactions include converting sulfide minerals to oxide minerals, or increasing the oxidation state of cations in existing oxide minerals. the most commonly observed is the oxidation of fe","es":"Reacción química que involucra el secuestro de electrones de los cationes. las reacciones típicas incluyen la transformación de sulfuros minerales en óxidos minerales, o en el incremento del estado de oxidación de los cationes en los óxidos minerales existentes. la más comúnmente observada es la oxidación del fe."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/proceso-diagenetico","prefLabel":{"en":"diagenetic process","es":"proceso diagenético"},"definition":{"en":"Any chemical, physical, or biological process that affects a sedimentary earth material after initial deposition, and during or after lithification, exclusive of weathering and metamorphism.","es":"Cualquier proceso químico, físico o biológico que afecta a un material terrestre sedimentario después de su depósito inicial y durante o después de la litificación, con exclusión de la meteorización y el metamorfismo."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/proceso-geomagnetico","prefLabel":{"en":"geomagnetic process","es":"proceso geomagnético"},"definition":{"en":"Process that results in change in earth's magnetic field.","es":"Proceso que da lugar a un cambio en el campo magnético de la tierra."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deriva-polar","prefLabel":{"en":"polar wander","es":"deriva polar"},"definition":{"en":"Process of migration of the axis of the earth's dipole field relative to the rotation axis of the earth.","es":"Proceso de migración del eje del  campo dipolar de la tierra en relación con su eje de rotación."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/inversion-del-campo-magnetico","prefLabel":{"en":"magnetic field reversal","es":"inversión del campo magnético"},"definition":{"en":"Geomagnetic event","es":"Evento geomagnético."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/proceso-magmatico","prefLabel":{"en":"magmatic process","es":"proceso magmático"},"definition":{"en":"A process involving melted rock (magma).","es":"Proceso que implica la presencia de roca fundida (magma)."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/cristalizacion-magmatica","prefLabel":{"en":"magmatic crystallisation","es":"cristalización magmática"},"definition":{"en":"The process by which matter becomes crystalline, from a gaseous, fluid, or dispersed state","es":"Proceso por el cual se forma materia cristalina a partir de materia en estado gaseoso, fluido o disperso."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erupcion","prefLabel":{"en":"eruption","es":"erupción"},"definition":{"en":"The ejection of volcanic materials (lava, pyroclasts, and volcanic gases) onto the earth's surface, either from a central vent or from a fissure or group of fissures","es":"Eyección de materiales volcánicos (lava, piroclastos, y gases volcánicos) sobre la superficie de la tierra, bien desde un slidero central o bien desde una fisura o grupo de fisuras."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-efusiva","prefLabel":{"en":"effusive eruption","es":"erupción efusiva"},"definition":{"en":"Eruptions characterized by low volatile content of the erupting magma relative to ambient pressure","es":"Erupciones caracterizadas por un bajo contenido en volátiles del magma en relación con la presión ambiental."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-estromboliana","prefLabel":{"en":"strombolian eruption","es":"erupción estromboliana"},"definition":{"en":"Eruption characterized by jetting of clots or fountains of fluid, basaltic lava from a central crater","es":"Erupción caracterizada por la expulsión en chorro de grumos o fuentes de lava basáltica fluida de un cráter central."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-hawaiana","prefLabel":{"en":"hawaiian eruption","es":"erupción hawaiana"},"definition":{"en":"Eruption in which great quantities of extremely fluid basaltic lava are poured out, mainly issuing in lava fountains from fissures on the flanks of a volcano. explosive phenomena are rare, but much spatter and scoria are piled into cones and mounds along the vents. characteristic of shield volcanoes","es":"Erupción en la que son expulsadas grandes cantidades de lava basáltica extremadamente fluida, principalmente en forma de fuentes de lava en fisuras de los flancos de un volcán. los fenómenos explosivos son raros, pero mucho fango y escoria es apilado en conos y montículos a lo largo de los salideros. es característico de los volcanes en escudo."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-piroclastica","prefLabel":{"en":"pyroclastic eruption","es":"erupción piroclástica"},"definition":{"en":"Eruption produced by the generation and rapid expansion of a gas phase that disrupts magma, surrounding wall rock or sediment","es":"Erupción producida por la generación y rápida expansión de una fase gaseosa que disrupta el magma, expulsándolo junto con fragmentos de la roca encajante o de sedimento."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-pliniana","prefLabel":{"en":"plinian eruption","es":"erupción pliniana"},"definition":{"en":"An explosive eruption in which a steady, turbulent stream of fragmented magma and magmatic gas is released at a high velocity from a vent. large volumes of tephra and tall eruption columns are characteristic","es":"Erupción explosiva en la que una continuada corriente turbulenta de magma fragmentado y gases es expulsada a alta velocidad de un respiradero. son característicos los grandes volúmenes de tefra y las altas columnas de erupción."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erupcion-vulcaniana","prefLabel":{"en":"vulcanian eruption","es":"erupción vulcaniana"},"definition":{"en":"Eruption characterized by the explosive ejection of fragments of new lava, commonly incandescent when they leave the vent but either solid or too viscous to assume any appreciable degree of rounding during their flight through the air. with these there are often breadcrust bombs or blocks, and generally large proportions of ash","es":"Erupción caracterizada por la eyección explosiva de fragmentos de nueva lava, comúnmente incandescentes cuando dejan el conducto pero sólidos o demasiado viscosos para asumir ningún grado apreciable de redondeamiento durante su vuelo a través del aire. con estos hay a menudo bombas o bloques en corteza de pan, y generalmente grandes proporciones de ceniza."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/fusion","prefLabel":{"en":"melting","es":"fusión"},"definition":{"en":"Change of state from a solid to a liquid","es":"Cambio de estado sólido a líquido."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/fusion-parcial","prefLabel":{"en":"partial melting","es":"fusión parcial"},"definition":{"en":"Process of melting involving only some of the mineral phases in a rock, to produce a mixture of melt and residual particles.","es":"Proceso de fusión que involucra a sólo algunas de las fases minerales de una roca, para producir una mezcla de fundido y partículas residuales."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/intrusion","prefLabel":{"en":"intrusion","es":"intrusión"},"definition":{"en":"The process of emplacement of magma in pre-existing rock","es":"Proceso de emplazamiento de un magma en una roca pre-existente."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/proceso-metamorfico","prefLabel":{"en":"metamorphic process","es":"proceso metamórfico"},"definition":{"en":"Mineralogical, chemical, and structural adjustment of solid rocks to physical and chemical conditions that differ from the conditions under which the rocks in question originated, and are generally been imposed at depth, below the surface zones of weathering and cementation.","es":"Ajuste mineralógico, químico y estructural de rocas sólidas a condiciones físicas y químicas diferentes de aquellas en las que se originaron y que se da en general en zonas profundas bajo las zonas superficiales de meteorización y cementación."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/alteracion","prefLabel":{"en":"alteration","es":"alteración"},"definition":{"en":"General term for any change in the mineralogical or chemical composition of a rock. typically related to interaction with hydrous fluids.","es":"Término general para cualquier cambio en la composición mineralógica o química de una roca. típicamente relacionada con la interacción con fluidos hídricos."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/metamorfismo-de-contacto","prefLabel":{"en":"contact metamorphism","es":"metamorfismo de contacto"},"definition":{"en":"Metamorphism taking place in rocks at or near their contact with a genetically related body of igneous rock","es":"Metamorfismo que tiene lugar en rocas en o cerca de su contacto con un cuerpo de roca ígnea al que está genéticamente relacionado."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/metamorfismo-de-dislocacion","prefLabel":{"en":"dislocation metamorphism","es":"metamorfismo de dislocación"},"definition":{"en":"Metamorphism concentrated along narrow belts of shearing or crushing without an appreciable rise in temperature","es":"Metamorfismo concentrado a lo largo de estrechos corredores de cizallamiento o trituración sin un apreciable incremento en temperatura."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/precipitacion-quimica","prefLabel":{"en":"chemical precipitation","es":"precipitación química"},"definition":{"en":"The deposition of mineral matter by precipitation from solution or as a result of chemical reactions. may be sedimentary or hydrothermal.","es":"Depósito de materia mineral por precipitación desde una solución o como resulultado de reacciones químicas. puede ser sedimentaria o hidrotermal."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/proceso-sedimentario","prefLabel":{"en":"sedimentary process","es":"proceso sedimentario"},"definition":{"en":"A phenomenon that changes the distribution or physical properties of sediment at or near the earth's surface.","es":"Fenómeno que da lugar a una modificación de la distribución o de las propiedades físicas del sedimento en la superficie de la tierra o cerca de ella."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito","prefLabel":{"en":"deposition","es":"depósito"},"definition":{"en":"Accumulation of material; the constructive process of accumulation of sedimentary particles, chemical precipitation of mineral matter from solution, or the accumulation of organicmaterial on the death of plants and animals.","es":"Acumulación de material; el proceso constructivo de acumulación de partículas sedimentarias, precipitación química de materia mineral a partir de una solución, o la acumulación de materia orgánica a la muerte de plantas y animales."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/acumulacion-organica","prefLabel":{"en":"organic accumulation","es":"acumulación orgánica"},"definition":{"en":"Sediment accumulation of biologically produced organicmaterial, as in bog, coal swamps.","es":"Acumulación sedimentaria de materia orgánica biogénica, como en las turberas."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito-mecanico","prefLabel":{"en":"mechanical deposition","es":"depósito mecánico"},"definition":{"en":"Process by which material that is being transported as particles by moving air, water, ice, or other fluid comes to rest and accumulates.","es":"Proceso por el cual un material que es transportado en forma de partículas por el aire, el agua,  el hielo u otro fluido en movimiento, llega al descanso y se acumula."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito-desde-un-fluido-en-movimiento","prefLabel":{"en":"deposition from moving fluid","es":"depósito desde un fluido en movimiento"},"definition":{"en":"Deposition of sediment from moving water or air, in which the sediment is transported by entrainment in the moving fluid. constrast with debris flow or turbidity current deposition in which movement of fluid/sediment mixture is due to incorporation of sediment in fluid.","es":"Depósito de sedimento desde agua o aire en movimiento, en el que el sedimento es transportado por arrastre del fluido que se está moviendo. es diferente del depósito por flujo en masa o por corriente de turbidez en que la que el movimiento de la mezcla fluido/sedimento se debe a la incorporación del sedimento en el fluido."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-corriente-de-turbidez","prefLabel":{"en":"turbidity current deposition","es":"depósito por corriente de turbidez"},"definition":{"en":"Deposition from a turbulent, low concentration sediment-water mixture.","es":"Depósito desde una mezcla turbulenta de baja concentración sedimento-agua."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-flujo-en-masa","prefLabel":{"en":"debris flow deposition","es":"depósito por flujo en masa"},"definition":{"en":"Laminar high-concentration, generally cohesionless deposition process. flow types included liquefied flow, fluidized flow, grain flow, traction carpet or modified grain flow.","es":"Proceso de depósito laminar de alta concentración y generalmente sin cohesión. los tipos de flujo incluyen flujo licuefactado, flujo fluidificado, flujo granular, manto de tracción o flujo granular modificado."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/deposito-por-transporte-en-masa","prefLabel":{"en":"mass wasting deposition","es":"depósito por transporte en masa"},"definition":{"en":"A general term for the dislodgement and downslope transport of soil and rock material under the direct application of gravitational body stresses. in contrast to other erosion processes, the debris removed by mass wasting is not carried within, on, or under another medium. the mass properties of the material being transported depend on the interaction of the soil and rock particles and on the moisture content. mass wasting includes slow displacements, such as creep and solifluction, and rapid movements such as rockfalls, rockslides, and cohesive debris flows (jackson, 1997, p. 392). includes both subaerial mass-wasting processes and subaqueous mass-wasting processes.","es":"Término general para el desprendimiento y transporte ladera debajo de suelo y material rocoso bajo la aplicación directa de esfuerzos gravitacionales. en contraste a otros procesos de erosión, el material movilizado por deslizamiento en masa no es transportado dentro, sobre o bajo ningún otro medio. las propiedades físicas del material dependen de la interacción entre las partículas de suelo y roca y de su contenido relativo. el deslizamiento en masa incluye desplazamientos lentos, tales como el deslizamiento de laderas y la solifluxión, y desplazamientos rápidos como los desprendimientos de rocas, deslizamiento de bloques y flujos en masa cohesiva (jackson, 1997, p. 392). incluye tanto a los procesos subaéreos como a los subacuáticos."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/precipitacion-biologica","prefLabel":{"en":"biological precipitation","es":"precipitación biológica"},"definition":{"en":"The deposition of minerals from solution by the agency of organisms","es":"Depósito de minerales desde una solución por la acción de organismos."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/precipitacion-quimica","prefLabel":{"en":"chemical precipitation","es":"precipitación química"},"definition":{"en":"The deposition of mineral matter by precipitation from solution or as a result of chemical reactions. may be sedimentary or hydrothermal.","es":"Depósito de materia mineral por precipitación desde una solución o como resulultado de reacciones químicas. puede ser sedimentaria o hidrotermal."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erosion","prefLabel":{"en":"erosion","es":"erosión"},"definition":{"en":"The process of disaggregation of rock and displacement of the resultant particles (sediment) usually by the agents of currents such as, wind, water, or ice by downward or down-slope movement in response to gravity or by living organisms (in the case of bioerosion).","es":"El proceso de desagregación de las rocas y el desplazamiento de las partículas resultantes (sedimento) usualmente por los agentes de corrientes tales como el viento, el agua o el hielo por movimiento a favor de ladera en respuesta a la gravedad o por organismos vivos (en el caso de la bioerosión)."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erosion-del-agua","prefLabel":{"en":"water erosion","es":"erosión del agua"},"definition":{"en":"Erosion by clast impact or plucking by moving liquid water","es":"Erosión causada por el impacto o piqueteo de clastos por movimiento de agua líquida."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erosion-del-viento","prefLabel":{"en":"wind erosion","es":"erosión del viento"},"definition":{"en":"Erosion by clast impact or plucking by moving air (wind)","es":"Erosión causada por el impacto o piqueteo de clastos por movimiento de aire (viento)."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/erosion-glacial","prefLabel":{"en":"ice erosion","es":"erosión glacial"},"definition":{"en":"Erosion by corrasion or plucking by moving ice.","es":"Erosión por corrosión o abrasión por el hielo en movimiento."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/transporte-en-masa","prefLabel":{"en":"mass wasting","es":"transporte en masa"},"definition":{"en":"The dislodgement and downslope transport of soil and rock material under the direct application of gravitational body stresses. in contrast to other erosion processes, the debris removed by mass wasting is not carried within, on, or under another medium. the mass properties of the material being transported depend on the interaction of the soil and rock particles and on the moisture content.","es":"Desprendimiento y transporte ladera debajo de suelo y material rocoso bajo la aplicación directa de esfuerzos gravitacionales. en contraste a otros procesos de erosión, el material movilizado por deslizamiento en masa no es transportado dentro, sobre o bajo ningún otro medio. las propiedades físicas del material dependen de la interacción entre las partículas de suelo y roca y de su contenidoen humedad."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/proceso-tectonico","prefLabel":{"en":"tectonic process","es":"proceso tectónico"},"definition":{"en":"Processes related to the interaction between or deformation of rigid plates forming the crust of the earth.","es":"Proceso relacionado con la deformación o la interacción entre las placas rígidas que forman la corteza de la tierra."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/acreccion","prefLabel":{"en":"accretion","es":"acrección"},"definition":{"en":"The addition of material to a continent. typically involves convergent or transform motion.","es":"La adición de material a un continente. típicamente involucra movimiento convergente o transformante."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/colision-continental","prefLabel":{"en":"continental collision","es":"colisión continental"},"definition":{"en":"The amalgamation of two continental plates or blocks along a convergent margin.","es":"Amalgamación de dos placas o bloques continentales a lo largo de un margen convergente."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/expansion-oceanica","prefLabel":{"en":"spreading","es":"expansión oceánica"},"definition":{"en":"A process whereby new oceanic crust is formed by upwelling of magma at the center of mid-ocean ridges and by a moving-away of the new material from the site of upwelling at rates of one to ten centimeters per year.","es":"Proceso según el cual se forma nueva corteza oceánica por la surgencia de magma en el centro de dorsales meso-oceánicas y por alejamiento del nuevo material de el sitio de surgencia a velocidades de uno a diez centímetros por año."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/falla-transformante","prefLabel":{"en":"transform faulting","es":"falla transformante"},"definition":{"en":"A strike-slip fault that links two other faults or two other plate boundaries (e.g. two segments of a mid-ocean ridge). transform faults often exhibit characteristics that distinguish them from transcurrent faults: (1) for transform faults formed at the same time as the faults they link, slip on the transform fault has equal magnitude at all points along the transform; slip magnitude on the transform fault can exceed the length of the transform fault, and slip does not decrease to zero at the fault termini. (2) for transform faults linking two similar features, e.g. if two mid-ocean ridge segments linked by a transform have equal spreading rates, then the length of the transform does not change as slip accrues on it.","es":"Falla de desplazamiento en dirección que une otras dos fallas o límites de placas (e.g. dos segmentos de una dorsal meso-oceánica). las fallas transformantes a menudo exhiben características  que las distinguen de las fallas transcurrentes: [1] para fallas transformantes formadas al mismo tiempo que las fallas que conectan, el deslizamiento tiene igual magnitud en todos los puntos a lo largo de la falla transformante; la magnitud del deslizamiento puede exceder la longitud de la falla transformante, y el deslizamiento no decrece a cero en la terminación de la falla. [2] para fallas transformantes que conectan dos estructuras similares, e.g. si dos segmentos de dorsal meso-oceánica unidos por una transformante tienen velocidades de expansión iguales, entonces la longitud de la transformante no cambia según se acumula el desplazamiento."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/obduccion","prefLabel":{"en":"obduction","es":"obducción"},"definition":{"en":"The overthrusting of continental crust by oceanic crust or mantle rocks at a convergent plate boundary.","es":"El cabalgamiento de corteza continental por corteza oceánica o rocas del manto en un borde convergente de placa."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/proceso-orogenico","prefLabel":{"en":"orogenic process","es":"proceso orogénico"},"definition":{"en":"Mountain building process.","es":"Proceso de construcción de las montañas."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/ruptura-continental","prefLabel":{"en":"continental breakup","es":"ruptura continental"},"definition":{"en":"Fragmentation of a continental plate into two or more smaller plates; may involve rifting or strike slip faulting.","es":"Fragmentación de una placa continental en dos o más placas menores; puede involucrar procesos de rifting (apertura cortical) o de fracturación con movimiento en dirección (transcurrencia)."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/apertura-cortical","prefLabel":{"en":"rifting","es":"apertura cortical"},"definition":{"en":"Extension of the crust to form one or more long, narrow graben of regional extent.","es":"Extensión de la corteza para formar una o más fosas tectónicas alargadas y estrechas de alcance regional."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/subduccion","prefLabel":{"en":"subduction","es":"subducción"},"definition":{"en":"The process of one lithospheric plate descending beneath another","es":"Proceso por el cual una placa litosférica desciende debajo de otra."}}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/variacion-del-nivel-del-mar","prefLabel":{"en":"sea level change","es":"variación del nivel del mar"},"definition":{"en":"Process of mean sea level changing relative to some datum.","es":"Proceso de cambio del nivel medio del mar en relación con algún datum."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/ascenso-del-nivel-del-mar","prefLabel":{"en":"sea level rise","es":"ascenso del nivel del mar"},"definition":{"en":"Process of mean sea level rising relative to some datum","es":"Proceso de ascenso del nivel medio del mar relativo a algún datum."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/caida-del-nivel-del-mar","prefLabel":{"en":"sea level fall","es":"caída del nivel del mar"},"definition":{"en":"Process of mean sea level falling relative to some datum","es":"Proceso de caída del nivel medio del mar relativa a algún datum."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/retrabajamiento","prefLabel":{"en":"reworking","es":"retrabajamiento"},"definition":{"en":"Near-range transport by water with predominantly changing the inner physical organisation of the sediment particles","es":"Transporte corto por agua que cambia predominantemente la organización física interna de las partículas sedomentarias."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/sellado","prefLabel":{"en":"sealing","es":"sellado"},"definition":{"en":"Covering of the surface with a non-liquid material not or little permeable for water after processing","es":"Cubrimiento de la superficie con un material no líquido, nada o poco permeable al agua tras el proceso."}},{"id":"https://geo-carto.github.io/vocabularios/evento-proceso/vertido","prefLabel":{"en":"dumping","es":"vertido"},"definition":{"en":"Heaping of mostly solid material, as in a land fill, mine dump, dredging operations","es":"Amontonamiento de material mayoritariamente sólido, como en un vertedero, escombrera de mina u operaciones de dragado."}}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","contributor":"dct:contributor","provenance":"dct:provenance","publisher":"dct:publisher","versionInfo":"owl:versionInfo","status":{"@id":"http://www.w3.org/ns/adms#status"},"preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container":"@language"},"narrower":{"@container":"@set"},"related":{"@container":"@set"},"relatedMatch":{"@container":"@set"},"narrowerTransitive":{"@container":"@set"},"broaderTransitive":{"@container":"@set"},"broadMatch":{"@container":"@set"},"narrowMatch":{"@container":"@set"},"closeMatch":{"@container":"@set"},"exactMatch":{"@container":"@set"},"hasTopConcept":{"@container":"@set"},"inScheme":{"@container":"@set"},"topConceptOf":{"@container":"@set"},"deprecated":{"@id":"owl:deprecated","@type":"xsd:boolean"},"isReplacedBy":{"@id":"dct:isReplacedBy","@container":"@set"}}}