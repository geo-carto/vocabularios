{
  "id": "https://geo-carto.github.io/vocabularios/file-type/ps",
  "type": "Concept",
  "prefLabel": {
    "en": "PS",
    "es": "PS"
  },
  "altLabel": {
    "en": [
      "PostScript File"
    ],
    "es": [
      "PostScript File"
    ]
  },
  "definition": {
    "en": "PS – PostScript – is a page description language in the electronic publishing and desktop publishing business. It is a dynamically typed, concatenative programming language.",
    "es": "PS – PostScript – es un lenguaje de descripción de páginas en el negocio de la publicación electrónica y la autoedición. Es un lenguaje de programación de tipo dinámico y concatenativo."
  },
  "notation": [
    "application/postscript",
    ".ps"
  ],
