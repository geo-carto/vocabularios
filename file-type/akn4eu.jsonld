{
  "id": "https://geo-carto.github.io/vocabularios/file-type/akn4eu",
  "type": "Concept",
  "prefLabel": {
    "en": "AKN4EU file",
    "es": "AKN4EU file"
  },
  "altLabel": {
    "en": [
      "Akoma Ntoso file"
    ],
    "es": [
      "Akoma Ntoso file"
    ]
  },
  "definition": {
    "en": "AKN4EU file is an Akoma Ntoso XML file conforming to the AKN4EU (Akoma Ntoso for European Union) specifications. One or more AKN4EU files can be part of an AKN4EU ZIP file. A special AKN4EU file called ‘main.xml’ is the entry point of an AKN4EU ZIP file.",
    "es": "Un archivo AKN4EU es un archivo XML Akoma Ntoso que cumple con las especificaciones AKN4EU (Akoma Ntoso for European Union). Uno o más archivos AKN4EU pueden formar parte de un archivo ZIP AKN4EU. Un archivo AKN4EU especial llamado 'main.xml' es el punto de entrada de un archivo ZIP AKN4EU."
  },
  "notation": [
    ".xml; .akn",
    "application/xml"
  ],
  "exactMatch": [
    {
      "id": "http://publications.europa.eu/resource/authority/file-type/AKN4EU"
    },
    {
      "id": "https://www.iana.org/assignments/media-types/application/xml"
    }
  ],
