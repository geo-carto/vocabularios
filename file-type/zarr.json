{
  "id": "https://geo-carto.github.io/vocabularios/file-type/zarr",
  "type": "Concept",
  "prefLabel": {
    "en": "Zarr",
    "es": "Zarr"
  },
  "altLabel": {
    "en": [
      "Zarr format"
    ],
    "es": [
      "Formato Zarr"
    ]
  },
  "definition": {
    "en": "Zarr is a data storage format designed for chunked, compressed, N-dimensional arrays. It supports storage across multiple backends (file system, cloud storage, databases) and is suitable for scientific and Earth observation data. It enables parallel and concurrent access to data chunks.",
    "es": "Zarr es un formato de almacenamiento de datos diseñado para matrices multidimensionales N-dimensionales chunked, comprimidas. Soporta almacenamiento en múltiples backends (sistema de archivos, almacenamiento en la nube, bases de datos) y es adecuado para datos científicos y de observación de la Tierra. Permite el acceso paralelo y concurrente a fragmentos de datos."
  },
  "notation": [
    ".zarr",
    "application/x-zarr"
  ],
