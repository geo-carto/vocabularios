  "type": "Concept",
  "prefLabel": {
    "es": "MPEG-4 AVC",
    "en": "MPEG-4 AVC"
  },
  "altLabel": {
    "es": [
      "Moving Picture Experts Group 4 Advanced Video Coding"
    ],
    "en": [
      "Moving Picture Experts Group 4 Advanced Video Coding"
    ]
  },
  "definition": {
    "es": "MPEG-4 – Moving Picture Experts Group – Parte 10, Advanced Video Coding, es un estándar de compresión de vídeo basado en compensación de movimiento orientado a bloques. Es uno de los formatos más utilizados para la grabación, compresión y distribución de contenido de vídeo.",
    "en": "MPEG-4 – Moving Picture Experts Group – Part 10, Advanced Video Coding is a block-oriented motion-compensation-based video compression standard. It is one of the most commonly used formats for the recording, compression and distribution of video content."
  },
