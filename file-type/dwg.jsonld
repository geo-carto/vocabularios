{
  "id": "https://geo-carto.github.io/vocabularios/file-type/dwg",
  "type": "Concept",
  "prefLabel": {
    "en": "DWG",
    "es": "DWG"
  },
  "altLabel": {
    "en": [
      "DWG file"
    ],
    "es": [
      "DWG file"
    ]
  },
  "definition": {
    "en": "A DWG file is a 2D or 3D drawing created with Autodesk AutoCAD, a professional CAD program. It contains vector image data and metadata that AutoCAD and other CAD applications use to load a drawing. DWG files are related to .DXF files, which are ASCII versions of DWG files.",
    "es": "Un archivo DWG es un dibujo 2D o 3D creado con Autodesk AutoCAD, un programa CAD profesional. Contiene datos de imagen vectorial y metadatos que AutoCAD y otras aplicaciones CAD utilizan para cargar un dibujo. Los archivos DWG están relacionados con los archivos .DXF, que son versiones ASCII de los archivos DWG."
  },
  "notation": [
    ".dwg",
    "image/vnd.dwg; application/dwg"
  ],
  "exactMatch": [
    {
      "id": "http://publications.europa.eu/resource/authority/file-type/DWG"
    },
    {
      "id": "https://www.iana.org/assignments/media-types/application/dwg"
    },
    {
      "id": "https://www.iana.org/assignments/media-types/image/vnd.dwg"
    }
  ],
