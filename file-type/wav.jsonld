{
  "id": "https://geo-carto.github.io/vocabularios/file-type/wav",
  "type": "Concept",
  "prefLabel": {
    "en": "WAV",
    "es": "WAV"
  },
  "altLabel": {
    "en": [
      "Waveform Audio File"
    ],
    "es": [
      "Waveform Audio File"
    ]
  },
  "definition": {
    "en": "Waveform Audio File (WAV) is a format is used for storing uncompressed digital audio files. It is the default audio format for Windows but it is supported by most operating systems.",
    "es": "El formato de archivo de audio Waveform (WAV) se utiliza para almacenar archivos de audio digital sin comprimir. Es el formato de audio predeterminado para Windows, pero es soportado por la mayoría de los sistemas operativos."
  },
  "notation": [
    ".wav; .wave",
    "audio/vnd.wave; audio/wav; audio/wave; audio/x-wav"
  ],
