{
  "id": "https://geo-carto.github.io/vocabularios/file-type/ics",
  "type": "Concept",
  "prefLabel": {
    "en": "ICalendar",
    "es": "ICalendar"
  },
  "altLabel": {
    "en": [
      "iCalendar"
    ],
    "es": [
      "iCalendar"
    ]
  },
  "definition": {
    "en": "iCalendar is a computer file format which allows Internet users to send meeting requests and tasks to other Internet users by sharing or sending files in this format through various methods.",
    "es": "iCalendar es un formato de archivo informático que permite a los usuarios de Internet enviar solicitudes de reuniones y tareas a otros usuarios de Internet compartiendo o enviando archivos en este formato a través de diversos métodos."
  },
  "notation": [
    ".ical; .icalendar; .ifb; .ics",
    "text/calendar"
  ],
