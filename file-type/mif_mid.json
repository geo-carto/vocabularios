{
  "id": "https://geo-carto.github.io/vocabularios/file-type/mif_mid",
  "type": "Concept",
  "prefLabel": {
    "en": "MIF/MID",
    "es": "MIF/MID"
  },
  "altLabel": {
    "en": [
      "MapInfo interchange format"
    ],
    "es": [
      "MapInfo interchange format"
    ]
  },
  "definition": {
    "en": "MapInfo interchange format is a map and database exporting file format of MapInfo software product. The MIF-file filename usually ends with .mif-suffix. Some MIF-files also have a related MID-file. The filename of a MID-file usually ends with .mid-suffix.",
    "es": "El formato de intercambio MapInfo es un formato de archivo de exportación de mapas y bases de datos del producto de software MapInfo. El nombre de archivo MIF generalmente termina con el sufijo .mif. Algunos archivos MIF también tienen un archivo MID relacionado. El nombre de archivo MID generalmente termina con el sufijo .mid."
  },
  "notation": [
    "text/plain",
    ".mid; .mif"
  ],
