        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-registro-geofisico-de-sondeo>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/levantamiento-inercial>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/mapa-publicado>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observacion-directa>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-a-partir-de-datos-de-elevacion>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento-lejano>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-imagenes-aereas>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-material-de-sondeo>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-recortes-de-sondeo>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-testigo-de-sondeo>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-bajo-material-superficial-no-cartografiado>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-bajo-unidad-cartografiada-suprayacente>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-entre-ubicaciones-observadas>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-oculta-por-vegetacion>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/ubicacion-de-afloramiento-observada-con-GPS>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/ubicacion-de-afloramiento-observada-en-mapa-topografico> ;
