    sdo:url <http://www.cgi-iugs.org> .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/compilacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:definition "Mapped feature geometry derived from one or more published or unpublished data sources, involving some interpretation or generalization by the compiler, not an exact digital reproduction of the sources."@en,
        "La geometría del elemento cartografiado se deriva de una o más fuentes de datos publicadas o no publicadas, e implica cierta interpretación o generalización por parte del compilador; no es una reproducción digital exacta de las fuentes."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/compilation> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "compilation"@en,
        "compilación"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-datos-gravimetricos> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto> ;
    skos:definition "Location and specification inferred based on measured variations in the acceleration of gravity related to mass of underlying Earth material."@en,
        "La ubicación y especificación se infieren a partir de variaciones medidas en la aceleración de la gravedad, relacionadas con la masa del material terrestre subyacente."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_gravity_data> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred gravity data"@en,
        "inferido a partir de datos gravimétricos"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-imagenes-de-teledeteccion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto> ;
    skos:definition "Location and specification inferred based on spectral characteristics of light measured by airborne or satellite based sensor. Phenomenon visible on standard (visible light) air photographs are considered 'observable'."@en,
        "La ubicación y especificación se infieren a partir de características espectrales de la luz medida por sensores aerotransportados o satelitales. Los fenómenos visibles en fotografías aéreas estándar (luz visible) se consideran \"observables\"."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_remote_sensing_imagery> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred remote sensing imagery"@en,
        "inferido a partir de imágenes de teledetección"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-levantamiento-aeromagnetico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto> ;
    skos:definition "Location and specification inferred based on magnetic field data acquired by airborne sensor."@en,
        "La ubicación y especificación se infieren a partir de datos del campo magnético adquiridos por sensores aerotransportados."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_aeromagnetic_survey> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred aeromagnetic survey"@en,
        "inferido a partir de levantamiento aeromagnético"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-levantamiento-magnetico-terrestre> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto> ;
    skos:definition "Location and specification inferred based on magnetic field data acquired by sensor on the earth surface, either at manually occupied stations, or by a vehicle-based continuously collected sensor data."@en,
        "La ubicación y especificación se infieren a partir de datos del campo magnético adquiridos por sensores en la superficie terrestre, ya sea en estaciones ocupadas manualmente o mediante sensores móviles en vehículos."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_ground_magnetic_survey> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred ground magnetic survey"@en,
        "inferido a partir de levantamiento magnético terrestre"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-levantamiento-radiometrico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto> ;
    skos:definition "Location and specification inferred based on flux or intensity of radiation related to the decay of radioactive elements in observed Earth material. Use for both airborne and ground-surface based sensor."@en,
        "La ubicación y especificación se infieren a partir del flujo o intensidad de radiación relacionada con la desintegración de elementos radiactivos en el material terrestre observado. Se aplica tanto a sensores aerotransportados como de superficie."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_radiometric_survey> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred radiometric survey"@en,
        "inferido a partir de levantamiento radiométrico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-recortes-de-sondeo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido> ;
    skos:definition "Geologic feature in bore hole inferred based on interpretation of drill cuttings."@en,
        "El elemento geológico en el sondeo se infiere a partir de la interpretación de recortes de sondeo."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_drill_cuttings> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred drill cuttings"@en,
        "inferido a partir de recortes de sondeo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-registro-geofisico-de-sondeo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto> ;
    skos:definition "Location and specification inferred based on measurements made by electronic bore hole logging device(s) that measure geophysical properties."@en,
        "La ubicación y especificación se infieren a partir de mediciones realizadas por dispositivos electrónicos de registro geofísico en sondeos."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_borehole_geophysical_log> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred borehole geophysical log"@en,
        "inferido a partir de registro geofísico de sondeo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/levantamiento-inercial> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/cartografiado> ;
    skos:definition "mapped feature is located by inertial survey methods"@en,
        "El elemento cartografiado se ubica mediante métodos de levantamiento inercial."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inertial_survey> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inertial survey"@en,
        "levantamiento inercial"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/mapa-publicado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:definition "Mapped feature geometry was digitized from a published map, specification of feature based on map unit explanation"@en,
        "La geometría del elemento cartografiado fue digitalizada a partir de un mapa publicado; su especificación se basa en la leyenda o explicación de unidades del mapa."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/published_map> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "published map"@en,
        "mapa publicado"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-a-partir-de-datos-de-elevacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:definition "Geomorphic features located and specified based on surface morphology determined by elevation (or bathemetry) data, e.g. DEM, LIDAR"@en,
        "Los elementos geomorfológicos se ubican y especifican en función de la morfología superficial determinada por datos de elevación (o batimetría), por ejemplo, DEM o LIDAR."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_elevation_data> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "observed based on elevation data"@en,
        "observado a partir de datos de elevación"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento-lejano> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento> ;
    skos:definition "Phenomenon observed and located from a distance."@en,
        "Fenómeno observado y ubicado desde la distancia."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_distant_outcrop> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "observed distant outcrop"@en,
        "observado en afloramiento lejano"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-imagenes-aereas> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observacion-directa> ;
    skos:definition "Phenomenon observed and located using aerial imagery (standard visible light)"@en,
        "Fenómeno observado y ubicado mediante imágenes aéreas (luz visible estándar)."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_aerial_imagery> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "observed in aerial imagery"@en,
        "observado en imágenes aéreas"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-recortes-de-sondeo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-material-de-sondeo> ;
    skos:definition "Geologic feature observed in cuttings obtained from a borehole."@en,
        "Elemento geológico observado en recortes de sondeo obtenidos de un pozo."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_borehole_cuttings> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "observed in borehole cuttings"@en,
        "observado en recortes de sondeo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-testigo-de-sondeo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-material-de-sondeo> ;
    skos:definition "Geologic feature observed in core obtained from a borehole."@en,
        "Elemento geológico observado en testigo de sondeo obtenido de un pozo."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_borehole_core> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "observed in borehole core"@en,
        "observado en testigo de sondeo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-bajo-material-superficial-no-cartografiado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-entre-ubicaciones-observadas> ;
    skos:definition "Location and specification determined based on inferred continuity with observed locations, and assumption of continuity of the feature. Not observable because of covering mantle of soil, talus or colluvium, not mapped as separate geologic units."@en,
        "La ubicación y especificación se determinan por continuidad inferida entre ubicaciones observadas, asumiendo continuidad del elemento. No es observable debido a un manto superficial de suelo, detritos o coluvión, que no ha sido cartografiado como unidad geológica separada."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection_unmapped_surficial_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred projection beneath unmapped surficial material"@en,
        "proyección inferida bajo material superficial no cartografiado"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-bajo-unidad-cartografiada-suprayacente> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-entre-ubicaciones-observadas> ;
    skos:definition "Phenomenon inferred to exist based on continuity with observed locations, and assumption of continuity of the feature. Mappable feature is covered by mapped younger geologic unit. Concealed feature."@en,
        "Se infiere la existencia del fenómeno por continuidad entre ubicaciones observadas, asumiendo continuidad del elemento. El elemento cartografiable está cubierto por una unidad geológica más joven. Elemento oculto."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection_covering_mapped_unit> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred projection beneath covering mapped unit"@en,
        "proyección inferida bajo unidad cartografiada suprayacente"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-oculta-por-vegetacion> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-entre-ubicaciones-observadas> ;
    skos:definition "Location and specification determined based on inferred continuity with observed locations, and assumption of continuity of the feature. Not observable because of obscuring vegetation, but inferred to crop out at surface."@en,
        "La ubicación y especificación se determinan por continuidad inferida entre ubicaciones observadas, asumiendo continuidad del elemento. No es observable por estar oculto por vegetación, pero se infiere que aflora en la superficie."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection_vegetation> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "inferred projection obscured by vegetation"@en,
        "proyección inferida oculta por vegetación"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/ubicacion-de-afloramiento-observada-con-GPS> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento> ;
    skos:definition "Phenomenon observed directly in outcrop, and located using GPS"@en,
        "Fenómeno observado directamente en afloramiento y ubicado mediante GPS."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_outcrop_gps_location> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "observed outcrop gps location"@en,
        "ubicación de afloramiento observada con GPS"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/ubicacion-de-afloramiento-observada-en-mapa-topografico> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento> ;
    skos:definition "Phenomenon observed directly in outcrop, and located by positioning on a topographic base map relative to physiographic or cultural features"@en,
        "Fenómeno observado directamente en afloramiento y ubicado mediante posicionamiento sobre un mapa topográfico, en relación con elementos fisiográficos o culturales."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_outcrop__topographic_map_location> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:prefLabel "observed outcrop topographic map location"@en,
        "ubicación de afloramiento observada en mapa topográfico"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/cartografiado> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:definition "mapped feature is located by survey methods"@en,
        "El elemento cartografiado se ubica mediante métodos de levantamiento topográfico."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/surveyed> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/levantamiento-inercial> ;
    skos:prefLabel "surveyed"@en,
        "cartografiado"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-material-de-sondeo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observacion-directa> ;
    skos:definition "Geologic feature observed in material obtained from a borehole."@en,
        "Elemento geológico observado en material obtenido de un sondeo."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_borehole_material> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-recortes-de-sondeo>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-testigo-de-sondeo> ;
    skos:prefLabel "observed in borehole material"@en,
        "observado en material de sondeo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:definition "Indicates that mapped feature is not directly observable, location and specification based on inference from available evidence."@en,
        "Indica que el elemento cartografiado no es directamente observable; su ubicación y especificación se basan en inferencias a partir de la evidencia disponible."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-recortes-de-sondeo>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-entre-ubicaciones-observadas> ;
    skos:prefLabel "inferred"@en,
        "inferido"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observacion-directa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:definition "Indicates that mapped feature was delineated and a specifier assigned by direct visual observation."@en,
        "Indica que el elemento cartografiado fue delimitado y caracterizado mediante observación visual directa."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/direct_observation> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-imagenes-aereas>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-material-de-sondeo> ;
    skos:prefLabel "direct observation"@en,
        "observación directa"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observacion-directa> ;
    skos:definition "Phenomenon observed and located directly in outcrop, geologist occupied location of phenomenon, and traced it explicitly over mapped extent."@en,
        "Fenómeno observado y ubicado directamente en afloramiento; el geólogo estuvo presente en la ubicación del fenómeno y lo trazó explícitamente en su extensión cartografiada."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/observed_outcrop> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento-lejano>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/ubicacion-de-afloramiento-observada-con-GPS>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/ubicacion-de-afloramiento-observada-en-mapa-topografico> ;
    skos:prefLabel "observed in outcrop"@en,
        "observado en afloramiento"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-entre-ubicaciones-observadas> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido> ;
    skos:definition "Location and specification determined based on inferred continuity with observed locations, and assumption of continuity of the feature."@en,
        "La ubicación y especificación se determinan por continuidad inferida entre ubicaciones observadas, asumiendo continuidad del elemento."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_projection__observed_locations> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-bajo-material-superficial-no-cartografiado>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-bajo-unidad-cartografiada-suprayacente>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/proyeccion-inferida-oculta-por-vegetacion> ;
    skos:prefLabel "inferred projection between observed locations"@en,
        "proyección inferida entre ubicaciones observadas"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-mediante-metodo-indirecto> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:broader <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido> ;
    skos:definition "Location and specification inferred based on properties related to lithology, e.g. geophysical or geochemical signature, vegetation, surface texture, reflectance."@en,
        "La ubicación y especificación se infieren a partir de propiedades relacionadas con la litología, como firmas geofísicas o geoquímicas, vegetación, textura superficial o reflectancia."@es ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/mappedfeatureobservationmethod/inferred_indirect_method> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/mappedfobservationmethod> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-datos-gravimetricos>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-imagenes-de-teledeteccion>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-levantamiento-aeromagnetico>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-levantamiento-magnetico-terrestre>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-levantamiento-radiometrico>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido-a-partir-de-registro-geofisico-de-sondeo> ;
    skos:prefLabel "inferred using indirect method"@en,
        "inferido mediante método indirecto"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/mappedfobservationmethod> a skos:ConceptScheme ;
    dcterms:created "2025-10-07"^^xsd:date ;
    dcterms:creator "Commission for the Management and Application of Geoscience Information (CGI) (IUGS)" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2025-10-07"^^xsd:date ;
    dcterms:provenance "Términos originales del estándar GeoSciML traducidos al español por el IGME" ;
    dcterms:publisher <https://www.igme.es/> ;
    owl:versionInfo "1.0.0" ;
    skos:definition "These are terms that specify how a MappedFeature instance was mapped. MappedFeature ObservationMethod is essentially a metadata snippet indicating how the spatial extent of the mapped feature was determined."@en,
        "Términos que especifican el método por el cual se ha determinado la extensión espaical de un determinado objeto MappedFeature"@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Método de observación de objetos cartografiados."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/cartografiado>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/compilacion>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/inferido>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/mapa-publicado>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observacion-directa>,
        <https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-a-partir-de-datos-de-elevacion> ;
    skos:prefLabel "Mapped feature observation method"@en,
        "Método de observación de objetos cartografiados"@es .

