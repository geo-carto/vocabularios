    owl:versionInfo "1.0.0" ;
    skos:definition "Terms referring to bedding surfaces."@en,
        "Términos referidos a superficies de estratificación."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Superfices de estratificación."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/superficies-de-estratificacion/biohorizonte>,
