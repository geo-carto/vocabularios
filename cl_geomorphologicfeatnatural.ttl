    skos:topConceptOf <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    skos:definition "Geomorphologic landscapes and landforms related to to glacial, glaciofluvial, glaciolacustrine and glaciomarine environments."@en,
        "Paisajes geomorfológicos y formas del relieve relativos a entornos glaciales, glaciofluviales, glaciolacustres y glaciomarinos."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/glacial> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    skos:prefLabel "glacial, glaciofluvial, glaciolacustrine and glaciomarine features"@en,
        "objetos glaciales, glaciofluviales, glaciolacustres y glaciomarinos"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-fluvioglaciares-y-de-permafrost> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    skos:definition "Geomorphologic landscapes and landforms related to snow, non-glacial, cold climate environments; geomorphologic landscapes and landforms occurring in the vicinity of glaciers and ice sheets; geomorphologic landscapes and landforms related to ground, soil, or rock that remains at or below 0º C for at least two years."@en,
        "Paisajes geomorfológicos y formas del relieve relativos a entornos de clima frío, con nieve, pero no glaciales; paisajes geomorfológicos y formas de relieve próximos a glaciares y placas de hielo; paisajes geomorfológicos y formas del relieve relativos a tierras, suelos o rocas que se mantienen a 0º C o menos durante dos años como mínimo."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/nivalPeriglacialPermafrost> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    skos:prefLabel "nival, periglacial and permafrost features"@en,
        "objetos glaciales, fluvioglaciares y de permafrost"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-hidrotermales> a skos:Concept ;
