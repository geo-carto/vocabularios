    skos:exactMatch <http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/alluvialFluvial> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    skos:prefLabel "alluvial and fluvial features"@en,
        "objetos geográficos aluviales y fluviales"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    skos:definition "Geomorphologic landscapes and landforms dominated by mineral dissolution, and commonly, subsurface drainage."@en,
        "Paisajes geomorfológicos y formas del relieve dominados por la disolución de minerales y, en general, por el drenaje subsuperficial."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/karstChemicalWeathering> ;
