    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    skos:definition "Landforms, geomorphologic surfaces, or paleosols covered by younger sediments."@en,
        "Forma del relieve, superficie geomorfológica o paleosuelo cubierto por sedimentos más jóvenes."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/NaturalGeomorphologicFeatureTypeValue/buriedFeature> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural> ;
    skos:prefLabel "buried feature"@en,
