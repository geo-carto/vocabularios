{
  "id": "https://geo-carto.github.io/vocabularios/material-igme/sienita-con-foides",
  "type": "Concept",
  "prefLabel": {
    "en": "foid-bearing syenite",
    "es": "sienita con foides"
  },
  "definition": {
    "en": "Plutonic rock belonging to the group of syenitic rocks, containing feldspathoids. It is the intrusive equivalent of foid-bearing trachyte",
    "es": "Roca plutónica perteneciente al grupo de las rocas sieníticas, que contiene feldespatoides. es el equivalente intrusivo de la traquita con foides"
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/LithologyValue/foidBearingSyenite"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/foid_bearing_syenite"
    }
  ],
