{
  "id": "https://geo-carto.github.io/vocabularios/material-igme/piedra-pomez",
  "type": "Concept",
  "prefLabel": {
    "en": "pumice stone",
    "es": "piedra pómez"
  },
  "altLabel": {
    "es": [
      "pómez, pumita"
    ]
  },
  "definition": {
    "en": "Light-coloured, very porous and low-density glassy volcanic rock that floats on water, formed from fragments of viscous lava projected into the air by a volcano and undergoing a large pressure drop causing degassing and the formation of bubbles separated by thin walls of volcanic glass",
    "es": "Roca volcánica vítrea de color claro, muy porosa y de baja densidad, que flota en el agua, formada a partir de fragmentos de lava viscosa proyectados al aire por un volcán y que sufren un gran descenso de presión que provoca una desgasificación y la formación de burbujas, separadas por delgadas paredes de vidrio volcánico"
  },
  "relatedMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/LithologyValue/pyroclasticRock"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/pyroclastic_rock"
    }
  ],
