{
  "id": "https://geo-carto.github.io/vocabularios/material-igme/petroleo",
  "type": "Concept",
  "prefLabel": {
    "en": "petroleum",
    "es": "petróleo"
  },
  "definition": {
    "en": "Sedimentary material consisting of hydrocarbons and formed from the anaerobic decomposition of organic matter. Under normal pressure and temperature conditions it occurs primarily as liquid (crude oil) and gas (natural gas), though it may sometimes, by oxidation, be solid (asphalt)",
    "es": "Material sedimentario constituido por hidrocarburos y formado a partir de la descomposición anaerobia de la materia orgánica. en condiciones normales de presión y temperatura se presenta fundamentalmente líquido petróleo crudo y gaseoso gas natural, aunque a veces, por oxidación, es sólido asfalto"
  },
  "relatedMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/LithologyValue/organicRichSedimentaryMaterial"
    },
    {
      "id": "http://resource.geosciml.org/classifier/cgi/lithology/organic_rich_sedimentary_material"
    }
  ],
