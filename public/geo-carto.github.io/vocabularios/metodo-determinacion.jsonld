{"id":"https://geo-carto.github.io/vocabularios/metodo-determinacion","type":"ConceptScheme","prefLabel":{"en":"Determination Method","es":"Método de determinación"},"description":{"es":"Método utilizado para determinar la orientación de una estructura geológica."},"publisher":{"id":"https://www.igme.es/"},"license":{"id":"https://creativecommons.org/licenses/by/4.0/"},"hasTopConcept":[{"id":"https://geo-carto.github.io/vocabularios/metodo-determinacion/determinacion-fotogeologica","prefLabel":{"en":"photogeologic determination","es":"determinación fotogeológica"},"definition":{"en":"Orientation determined based on measurements from aerial photography or satellite imagery (in conjunction with an elevation model.","es":"Orientación determinada a partir de mediciones sobre fotografía aérea o imágenes de satélite (junto con un modelo de elevación)."}},{"id":"https://geo-carto.github.io/vocabularios/metodo-determinacion/determinacion-por-tres-puntos","prefLabel":{"en":"three point determination","es":"determinación por tres puntos"},"definition":{"en":"Orientation determined by fitting a plane to three or more points located on the geologic surface of interest.","es":"Orientación determinada ajustando un plano a tres o más puntos situados en la superficie geológica de interés."}},{"id":"https://geo-carto.github.io/vocabularios/metodo-determinacion/estimacion-a-distancia","prefLabel":{"en":"estimate from distance","es":"estimación a distancia"},"definition":{"en":"Orientation of a geologic structure based on observation from a distance great enough to preclude direct inspection of the structure to determine orientation.","es":"Orientación de una estructura geológica basada en la observación a una distancia suficiente como para impedir la inspección directa de la estructura."}},{"id":"https://geo-carto.github.io/vocabularios/metodo-determinacion/estimacion-a-partir-de-fotografia-aerea","prefLabel":{"en":"estimate from air photo","es":"estimación a partir de fotografía aérea"},"definition":{"en":"Orientation of a geologic structure estimated based on inspection or measurements on an air photograph.","es":"Orientación de una estructura geológica estimada a partir de la inspección o mediciones sobre una fotografía aérea."}},{"id":"https://geo-carto.github.io/vocabularios/metodo-determinacion/medida-en-afloramiento","prefLabel":{"en":"measure on outcrop","es":"medida en afloramiento"},"definition":{"en":"Orientation of surface or line is measured on an outcrop of that surface or line directly, e.g. by measuring a particular bedding surface, a 3-D exposure of a fold hinge, a particular stretched mineral grain in a foliation surface.","es":"La orientación de la superficie o línea se mide directamente sobre un afloramiento de dicha superficie o línea, por ejemplo, midiendo una superficie de estratificación particular, una exposición 3D de una charnela de pliegue, un grano mineral estirado en una superficie de foliación."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/metodo-determinacion/estimacion-visual-en-afloramiento","prefLabel":{"en":"visual surface estimation on outcrop","es":"estimación visual en afloramiento"},"definition":{"en":"Orientation of a surface is measured by visually averaging across one or more outcrops in a small area--e.g. approximating dip by looking down strike of beds, approximating strike by outcrop trace of one or more beds.","es":"Orientación de una superficie medida promediando visualmente en uno o más afloramientos en un área reducida, por ejemplo, aproximando el buzamiento mirando a lo largo del rumbo de las capas."}},{"id":"https://geo-carto.github.io/vocabularios/metodo-determinacion/medida-instrumental-en-campo","prefLabel":{"en":"standard on site measure","es":"medida instrumental en campo"},"definition":{"en":"Orientation measured using compass or other instrument directly on or at an outcrop of the structure.","es":"Orientación medida usando brújula u otro instrumento directamente sobre o en un afloramiento de la estructura."}}]},{"id":"https://geo-carto.github.io/vocabularios/metodo-determinacion/orientacion-media-calculada","prefLabel":{"en":"calculated average orientation","es":"orientación media calculada"},"definition":{"en":"Orientation value is specified using a calculated average of a collection of related orientations (computer generalization).","es":"El valor de orientación se especifica usando una media calculada de un conjunto de orientaciones relacionadas (generalización por computador)."}}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","publisher":"dct:publisher","preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container":"@language"},"narrower":{"@container":"@set"},"related":{"@container":"@set"},"relatedMatch":{"@container":"@set"},"narrowerTransitive":{"@container":"@set"},"broaderTransitive":{"@container":"@set"},"broadMatch":{"@container":"@set"},"narrowMatch":{"@container":"@set"},"closeMatch":{"@container":"@set"},"exactMatch":{"@container":"@set"},"hasTopConcept":{"@container":"@set"},"inScheme":{"@container":"@set"},"topConceptOf":{"@container":"@set"},"deprecated":{"@id":"owl:deprecated","@type":"xsd:boolean"},"isReplacedBy":{"@id":"dct:isReplacedBy","@container":"@set"}}}