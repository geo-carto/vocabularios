{
  "id": "https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento",
  "type": "Concept",
  "prefLabel": {
    "en": "observed in outcrop",
    "es": "observado en afloramiento"
  },
  "definition": {
    "en": "Phenomenon observed and located directly in outcrop, geologist occupied location of phenomenon, and traced it explicitly over mapped extent.",
    "es": "Fenómeno observado y ubicado directamente en afloramiento; el geólogo estuvo presente en la ubicación del fenómeno y lo trazó explícitamente en su extensión cartografiada."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observado-en-afloramiento-lejano",
      "prefLabel": {
        "en": "observed distant outcrop",
        "es": "observado en afloramiento lejano"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/mappedfobservationmethod/ubicacion-de-afloramiento-observada-con-GPS",
      "prefLabel": {
        "en": "observed outcrop gps location",
        "es": "ubicación de afloramiento observada con GPS"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/mappedfobservationmethod/ubicacion-de-afloramiento-observada-en-mapa-topografico",
      "prefLabel": {
        "en": "observed outcrop topographic map location",
        "es": "ubicación de afloramiento observada en mapa topográfico"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/mappedfobservationmethod/observacion-directa",
    "prefLabel": {
      "en": "direct observation",
      "es": "observación directa"
    }
  },
