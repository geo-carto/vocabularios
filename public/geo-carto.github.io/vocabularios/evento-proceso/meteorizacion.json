        "es": "meteorización física"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-proceso/meteorizacion-quimica",
      "prefLabel": {
        "en": "chemical weathering",
        "es": "meteorización química"
      }
    }
  ],
