{
  "id": "https://geo-carto.github.io/vocabularios/file-type/exe",
  "type": "Concept",
  "prefLabel": {
    "en": "EXE",
    "es": "EXE"
  },
  "altLabel": {
    "en": [
      "Executable file"
    ],
    "es": [
      "Executable file"
    ]
  },
  "definition": {
    "en": "An executable file (the main execution point of a computer program) for DOS, OpenVMS, Microsoft Windows, Symbian or OS/2. Besides the executable program, many .exe files contain other components called resources, such as bitmap graphics and icons which the executable program may use for its graphical user interface.",
    "es": "Un archivo ejecutable (el punto de ejecución principal de un programa informático) para DOS, OpenVMS, Microsoft Windows, Symbian u OS/2. Además del programa ejecutable, muchos archivos .exe contienen otros componentes llamados recursos, como gráficos de mapa de bits e iconos que el programa ejecutable puede usar para su interfaz gráfica de usuario."
  },
  "notation": [
    "application/octet-stream",
    ".exe"
  ],
  "exactMatch": [
    {
      "id": "https://www.iana.org/assignments/media-types/application/octet-stream"
    },
    {
      "id": "http://publications.europa.eu/resource/authority/file-type/EXE"
    }
  ],
