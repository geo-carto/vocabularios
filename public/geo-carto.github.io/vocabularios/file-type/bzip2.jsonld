{
  "id": "https://geo-carto.github.io/vocabularios/file-type/bzip2",
  "type": "Concept",
  "prefLabel": {
    "en": "bzip2",
    "es": "bzip2"
  },
  "altLabel": {
    "en": [
      "bzip2 compressed file"
    ],
    "es": [
      "bzip2 compressed file"
    ]
  },
  "definition": {
    "en": "An open source, patent- and royalty-free compression format. The compression algorithm is a Burrows-Wheeler transform followed by a move-to-front transform and finally Huffman coding.",
    "es": "Un formato de compresión de código abierto, libre de patentes y regalías. El algoritmo de compresión es una transformada de Burrows-Wheeler seguida de una transformada de movimiento al frente y finalmente una codificación Huffman."
  },
  "notation": [
    ".bz2",
    "application/x-bzip2"
  ],
  "exactMatch": [
    {
      "id": "http://publications.europa.eu/resource/authority/file-type/BZIP2"
    },
    {
      "id": "https://www.iana.org/assignments/media-types/application/x-bzip2"
    }
  ],
