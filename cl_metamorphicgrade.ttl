    skos:member <https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-alto>,
        <https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-bajo>,
        <https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-desconocido>,
        <https://geo-carto.github.io/vocabularios/metamorfismo-grado/grado-metamorfico-medio>,
