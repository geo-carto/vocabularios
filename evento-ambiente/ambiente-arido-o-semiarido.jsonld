      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-playa-endorreica",
      "prefLabel": {
        "en": "playa setting",
        "es": "ambiente de playa endorreica"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-sabkha-marina-marginal",
      "prefLabel": {
        "en": "marginal marine sabkha setting",
        "es": "ambiente sabkha marina marginal"
      }
    }
  ],
