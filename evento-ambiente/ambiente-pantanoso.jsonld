{
  "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-pantanoso",
  "type": "Concept",
  "prefLabel": {
    "en": "bog setting",
    "es": "ambiente pantanoso"
  },
  "definition": {
    "en": "Waterlogged, spongy ground, consisting primarily of mosses, containing acidic, decaying vegetation that may develop into peat.",
    "es": "Suelo esponjoso y empapado en agua, principalmente consistente en musgos, que contiene vegetación ácida en descomposición que puede convertirse en turba."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cuenca-pantanosa",
      "prefLabel": {
        "en": "basin bog setting",
        "es": "ambiente de cuenca pantanosa"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-manto-pantanoso",
      "prefLabel": {
        "en": "blanket bog",
        "es": "ambiente de manto pantanoso"
      }
    }
  ],
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/bogSetting"
    },
