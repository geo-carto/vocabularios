        "es": "ambiente de delta estuarino"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-laguna-litoral-estuarina",
      "prefLabel": {
        "en": "estuarine lagoon setting",
        "es": "ambiente de laguna litoral estuarina"
      }
    }
  ],
