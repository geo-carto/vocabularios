{
  "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-punto-caliente",
  "type": "Concept",
  "prefLabel": {
    "en": "hot spot setting",
    "es": "ambiente de punto caliente"
  },
  "definition": {
    "en": "Setting in a zone of high heat flow from the mantle. Typically identified in intraplate settings, but hot spot may also interact with active plate margins (Iceland...). Includes surface manifestations like volcanic center, but also includes crust and mantle manifestations as well.",
    "es": "Ambiente en una zona de alto flujo de calor del manto. Típicamente identificado en ambientes de intraplaca, pero el punto caliente puede también interactuar con márgenes activos de placa (Islandia…). Incluye manifestaciones superficiales como los centros volcánicos, pero también incluye igualmente manifestaciones corticales y mantélicas."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-tectonicamente-definido",
    "prefLabel": {
      "en": "tectonically defined setting",
      "es": "ambiente tectónicamente definido"
    }
  },
