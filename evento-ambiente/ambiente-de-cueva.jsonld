{
  "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-de-cueva",
  "type": "Concept",
  "prefLabel": {
    "en": "cave setting",
    "es": "ambiente de cueva"
  },
  "definition": {
    "en": "A natural underground open space; it generally has a connection to the surface, is large enough for a person to enter, and extends into darkness. The most common type of cave is formed in limestone by dissolution.",
    "es": "Un espacio natural abierto y subterránea; generalmente tiene una conexión con la superficie, es suficiente grande para que una persona penetre, y se prolonga en la oscuridad. El tipo más común de cueva se forma en las calizas por disolución."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-en-la-superficie-de-la-tierra",
    "prefLabel": {
      "en": "earth surface setting",
      "es": "ambiente en la superficie de la Tierra"
    }
  },
  "exactMatch": [
    {
      "id": "http://inspire.ec.europa.eu/codelist/EventEnvironmentValue/caveSetting"
    },
