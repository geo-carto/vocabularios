{
  "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico",
  "type": "Concept",
  "prefLabel": {
    "en": "neritic setting",
    "es": "ambiente nerítico"
  },
  "definition": {
    "en": "The ocean environment at depths between low-tide level and 200 metres, or between low-tide level and approximately the edge of the continental shelf.",
    "es": "El ambiente oceánico a profundidades comprendidas entre el nivel de marea baja y 200 metros, o entre el nivel de marea baja y aproximadamente el borde de la plataforma continental."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-externo",
      "prefLabel": {
        "en": "outer neritic setting",
        "es": "ambiente nerítico externo"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-interno",
      "prefLabel": {
        "en": "inner neritic setting",
        "es": "ambiente nerítico interno"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-neritico-medio",
      "prefLabel": {
        "en": "middle neritic setting",
        "es": "ambiente nerítico medio"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/evento-ambiente/ambiente-marino",
    "prefLabel": {
      "en": "marine setting",
      "es": "ambiente marino"
    }
  },
