{
  "id": "https://geo-carto.github.io/vocabularios/rocas-igme/carbon-de-la-serie-sapropelica",
  "type": "Concept",
  "prefLabel": {
    "es": "carbón de la serie sapropélica",
    "en": "sapropelic series coal"
  },
  "definition": {
    "es": "Carbón, consolidado o no, formado por procesos de putrefacción en medios subacuáticos y bajo condiciones anóxicas, de materia orgánica derivada de fitoplancton. presenta grano fino, aspecto compacto y homogéneo a simple vista, color oscuro, brillo mate y fractura concoidea"
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/rocas-igme/material-rico-en-materia-organica",
    "prefLabel": {
      "es": "material rico en materia orgánica",
      "en": "organic matter-rich material"
    }
  },
