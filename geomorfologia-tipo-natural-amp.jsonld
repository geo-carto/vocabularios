ios/geomorfologia-tipo-natural/domo-exogeno","prefLabel":{"en":"exogenous dome","es":"domo exógeno"},"definition":{"en":"A volcanic dome formed by lava extrusion at the surface.","es":"Domo volcánico formado por extrusión de lava en superficie."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe","prefLabel":{"en":"scarp","es":"escarpe"},"definition":{"en":"An abrupt slope of polygenetic origin.","es":"Talud abrupto de origen poligénico."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fondo-de-valle-de-origen-mixto","prefLabel":{"en":"mixed-origin valley floor","es":"fondo de valle de origen mixto"},"definition":{"en":"Valley floor formed by combined fluvial and gravitational processes.","es":"Fondo de valle formado por procesos fluviales y gravitacionales combinados."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-cobertera-pedimento-cubierto-glacis-mixto","prefLabel":{"en":"covered glacis; covered pediment","es":"glacis de cobertera; pedimento cubierto; glacis mixto"},"definition":{"en":"A glacis covered by a thin mantle of sediments.","es":"Glacis cubierto por un manto delgado de sedimentos."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-cobertera-degradado-o-disectado","prefLabel":{"en":"degraded or dissected covered glacis","es":"glacis de cobertera degradado o disectado"},"definition":{"en":"A covered glacis incised by channels.","es":"Glacis de cobertera incidido por cauces."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-erosion-pediment","prefLabel":{"en":"erosion glacis; pediment","es":"glacis de erosión; pediment"},"definition":{"en":"Gently inclined erosion surface at the foot of a relief.","es":"Superficie suavemente inclinada de erosión al pie de un relieve."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-