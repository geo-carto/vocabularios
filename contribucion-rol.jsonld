{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol","type":"ConceptScheme","prefLabel":{"es":"Rol de contribuyente","en":"Contributor role"},"publisher":{"id":"https://www.igme.es/"},"license":{"id":"https://creativecommons.org/licenses/by/4.0/"},"hasTopConcept":[{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/administrador-base-de-datos","prefLabel":{"es":"administrador de base de datos","en":"database administrator"},"definition":{"es":"Persona o entidad responsable de la gestión, mantenimiento y administración de la base de datos que contiene la información del recurso.","en":"Person or entity responsible for managing, maintaining and administering the database containing the resource information."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/autor","prefLabel":{"es":"autor","en":"author"},"definition":{"es":"Persona o entidad responsable de la creación intelectual del contenido del recurso.","en":"Person or entity responsible for the intellectual creation of the resource content."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/cartografo-de-campo","prefLabel":{"es":"cartógrafo de campo","en":"field cartographer"},"definition":{"es":"Persona o entidad responsable de la elaboración de la cartografía geológica mediante observaciones y levantamientos realizados en campo.","en":"Person or entity responsible for producing geological cartography based on field observations and mapping."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/co-autor","prefLabel":{"es":"co-autor","en":"co-author"},"definition":{"es":"Persona o entidad que contribuye significativamente a la creación intelectual del contenido del recurso junto con el autor principal.","en":"Person or entity who significantly contributes to the intellectual creation of the resource content together with the main author."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-cientifico","prefLabel":{"es":"coordinador científico","en":"scientific coordinator"},"definition":{"es":"Persona o entidad responsable de la coordinación de los aspectos científicos del proyecto y de garantizar la coherencia y calidad científica de los resultados.","en":"Person or entity responsible for coordinating the scientific aspects of the project and ensuring the scientific consistency and quality of the results."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/coordinador-tecnico","prefLabel":{"es":"coordinador técnico","en":"technical coordinator"},"definition":{"es":"Persona o entidad responsable de la coordinación de los aspectos técnicos del proyecto, incluyendo metodologías, herramientas y flujos de trabajo.","en":"Person or entity responsible for coordinating the technical aspects of the project, including methodologies, tools and workflows."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/creador-de-servicios-web","prefLabel":{"es":"creador de servicios web","en":"web service publisher"},"definition":{"es":"Persona o entidad responsable de la creación y configuración de servicios web para la publicación y acceso al recurso.","en":"Person or entity responsible for creating and configuring web services for publishing and accessing the resource."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/creador-metadatos","prefLabel":{"es":"creador de metadatos","en":"metadata creator"},"definition":{"es":"Persona o entidad responsable de crear y documentar los metadatos que describen el recurso y sus características.","en":"Person or entity responsible for creating and documenting the metadata describing the resource and its characteristics."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/digitalizador","prefLabel":{"es":"digitalizador","en":"digitiser"},"definition":{"es":"Persona o entidad responsable de la digitalización de datos.","en":"Person or entity responsible for the digitisation of data."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/director-proyecto","prefLabel":{"es":"director proyecto","en":"project manager"},"definition":{"es":"Persona o entidad responsable de la planificación, organización, coordinación y supervisión general del proyecto.","en":"Person or entity responsible for the planning, organisation, coordination and overall supervision of the project."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/editor-cartográfico","prefLabel":{"es":"editor cartográfico","en":"cartographic editor"},"definition":{"es":"Persona o entidad responsable de la revisión y preparación cartográfica del recurso para su publicación.","en":"Person or entity responsible for reviewing and preparing the cartographic resource for publication."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/revisor-científico","prefLabel":{"es":"revisor científico","en":"scientific reviewer"},"definition":{"es":"Persona o entidad encargada de revisar la calidad y exactitud científica del recurso.","en":"Person or entity responsible for reviewing the scientific quality and accuracy of the resource."}},{"id":"https://geo-carto.github.io/vocabularios/contribucion-rol/revisor-informacion-digital","prefLabel":{"es":"revisor información digital","en":"digital data reviewer"},"definition":{"es":"Persona o entidad responsable de revisar la calidad, coherencia y consistencia de la información digital asociada al recurso.","en":"Person or entity responsible for reviewing the quality, coherence and consistency of the digital information associated with the resource."}}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","publisher":"dct:publisher","preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container":"@language"},"narrower":{"@container":"@set"},"related":{"@container":"@set"},"relatedMatch":{"@container":"@set"},"narrowerTransitive":{"@container":"@set"},"broaderTransitive":{"@container":"@set"},"broadMatch":{"@container":"@set"},"narrowMatch":{"@container":"@set"},"closeMatch":{"@container":"@set"},"exactMatch":{"@container":"@set"},"hasTopConcept":{"@container":"@set"},"inScheme":{"@container":"@set"},"topConceptOf":{"@container":"@set"},"deprecated":{"@id":"owl:deprecated","@type":"xsd:boolean"},"isReplacedBy":{"@id":"dct:isReplacedBy","@container":"@set"}}}