<https://geo-carto.github.io/vocabularios/falla-tipo/falla> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:definition "Superficie discreta, o zona de superficies discretas, con un cierto espesor, que separa dos cuerpos rocosos y a lo largo de la cual uno de los cuerpos se ha deslizado con respecto al otro."@es ,
         "A discrete surface, or zone of discrete surfaces, with some thickness, separating two rock masses across which one mass has slid past the other and characterized by brittle deformation."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-en-tijera> ,
    <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre> ;
    skos:prefLabel "falla"@es ,
        "fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Falla cuyos dos lados se han aproximado notablemente entre sí en la dirección perpendicular a la falla."@es ,
         "A fault whose two sides have approached each other substantially in the direction perpendicular to the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/extraction_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/extractionFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-mixta> ,
    <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-pura> ;
    skos:prefLabel "falla contraccional"@es ,
        "extraction fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-mixta> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional> ;
    skos:definition "Falla contracional con algo de desplazamiento en la dirección del plano de falla."@es ,
         "An extraction fault with some displacement within the fault plane."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/mixed_extraction_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/mixedExtractionFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla contraccional mixta"@es ,
        "mixed extraction fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-pura> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional> ;
    skos:definition "Falla contracional sin  desplazamiento apreciable a lo largo del plano de falla."@es ,
         "An extraction fault with no discernible displacement within the fault plane."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/pure_extraction_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/pureExtractionFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla contraccional pura"@es ,
        "pure extraction fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Falla cuyo plano buza más de 45 grados sobre más de la mitad de su extensión reconocida, y para la cual el deslizamiento o separación no se especifica explícitamente."@es ,
         "Fault that dips at least 45 degrees over more than half of its recognized extent, for which slip or separation is not explicitly specified."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/high_angle_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/highAngleFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-de-alto-angulo> ,
    <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-con-buzamiento-elevado> ;
    skos:prefLabel "falla de alto ángulo"@es ,
        "high angle fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo>, <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal> ;
    skos:definition "Falla normal cuyo plano buza más de 45 grados sobre más de la mitad de su extensión reconocida."@es ,
         "Fault that dips at least 45 degrees over more than half of the recognized extent of the fault with the hanging wall displaced from a structurally higher position relative to footwall rocks."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/high_angle_normal_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/highAngleNormalFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla normal de alto ángulo"@es ,
        "high angle normal fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-de-alto-angulo> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo>, <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa> ;
    skos:definition "Falla inversa cuyo plano buza más de 45 grados sobre más de la mitad de su extensión reconocida."@es ,
         "Reverse fault that dips at least 45 degrees over more than half of its recognized extent, for which slip or separation is not explicitly specified"@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/high_angle_reverse>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/highAngleReverse> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla inversa de alto ángulo"@es ,
        "high angle reverse"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-de-alto-angulo> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo>, <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre> ;
    skos:definition "Falla de desgarre cuyo plano de falla buza como mínimo 45 grados en más de la mitad de la extensión en la que se ha reconocido.\n."@es ,
         "A strike slip fault in which the fault plane dips at least 45 degrees over more than half of the recognized extent of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/wrench_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/wrenchFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla de desgarre de alto ángulo"@es ,
        "wrench fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Falla cuyo plano buza menos de 45 grados sobre más de la mitad de su extensión reconocida."@es ,
         "Fault that dips less than 45 degrees over more than half of the recognized extent of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/low_angle_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/lowAngleFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-horizontal> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo> ,
    <https://geo-carto.github.io/vocabularios/falla-tipo/cabalgamiento> ;
    skos:prefLabel "falla de bajo ángulo"@es ,
        "low angle fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-horizontal> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo> ;
    skos:definition "Falla que buza menos de 10 grados sobre más de la mitad de la extensión reconocida de la falla."@es ,
         "Fault that dips less than 10 degrees over more than half the recognized extent of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/horizontal_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/horizontalFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla horizontal"@es ,
        "horizontal fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo>, <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal> ;
    skos:definition "Falla normal que buza menos de 45 grados en más de la mitad de la extensión reconocida de la falla."@es ,
         "Fault that dips less than 45 degrees over more than half of the recognized extent of the fault with the hanging wall displaced from a structurally higher position relative to footwall rocks."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/low_angle_normal_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/lowAngleNormalFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/superficie-de-despegue> ;
    skos:prefLabel "falla normal de bajo ángulo"@es ,
        "low angle normal fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/superficie-de-despegue> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo> ;
    skos:definition "Falla normal de bajo ángulo con gran desplazamiento y escala regional."@es ,
         "A regional-scale, large displacement, low-angle normal fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/detachment_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/detachmentFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "superficie de despegue"@es ,
        "detachment fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/cabalgamiento> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo> ;
    skos:definition "Falla que buza menos de 45 grados en más de la mitad de la extensión reconocida de la falla, con un bloque superior desplazado desde una posición estructuralmente más profunda en relación con las rocas del bloque inferior."@es ,
         "Fault that dips less than 45 degrees over more than half of the recognized extent of the fault, with a hanging wall displaced from a structurally deeper position relative to footwall rocks."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/thrust_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/thrustFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "cabalgamiento"@es ,
        "thrust fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Falla cuyo bloque elevado es el inferior y su superficie buza hacia el bloque hundido y en la que la componente del desplazamiento paralelo al buzamiento es más de 10 veces superior a la componente del desplazamiento paralelo al rumbo en más de la mitad de la extensión en la que ha sido reconocida."@es ,
         "Fault with dip-parallel displacement component of slip vector more than 10 times the strike-parallel component of the slip vector over more than half recognized extent of the fault, and for which the fault dips consistently in the same direction, and for which the hanging wall has been displaced down relative to the footwall."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/normal_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/normalFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo> ,
    <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo> ;
    skos:prefLabel "falla normal"@es ,
        "normal fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Falla en la que ambas componentes del desplazamiento: en la  dirección de la capa y en la dirección de buzamiento tienen un valor apreciable."@es ,
         "Fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/oblique_slip_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/obliqueSlipFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-sinistra> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-sinistra> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-dextra> ,
    <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-dextra> ;
    skos:prefLabel "falla de desplazamiento oblicuo"@es ,
        "oblique slip fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-sinistra> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> ;
    skos:definition "Falla normal de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la izquierda del bloque desde donde se hace la observación."@es ,
         "High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with left-lateral strike-parallel component and normal dip-parallel component over at least half the mapped trace of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/left_normal_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/leftNormalFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla normal sinistra"@es ,
        "left normal fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-sinistra> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> ;
    skos:definition "Falla inversa de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la izquierda del bloque desde donde se hace la observación."@es ,
         "High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with left-lateral strike-parallel component and reverse dip-parallel component over at least half the mapped trace of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/left_reverse_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/leftReverseFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla inversa sinistra"@es ,
        "left reverse fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-dextra> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> ;
    skos:definition "Falla normal de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la derecha del bloque desde donde se hace la observación."@es ,
         "High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with right-lateral strike-parallel component and normal dip-parallel component of slip over at least half the mapped trace of the fault"@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/right_normal_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/rightNormalFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla normal dextra"@es ,
        "right normal fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-dextra> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> ;
    skos:definition "Falla inversa de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la derecha del bloque desde donde se hace la observación."@es ,
         "High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with a right-lateral strike-parallel component and reverse dip-parallel component of slip over at least half the mapped trace of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/right_reverse_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/rightReverseFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla inversa dextra"@es ,
        "right reverse fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Falla en la que el componente de desplazamiento paralelo al buzamiento es más de 10 veces superior al componente de desplazamiento paralelo al rumbo al menos en un lugar del trazado cartografiado y la falla buza sistemáticamente en la misma dirección, estando el labio levantado desplazado hacia arriba en relación con el labio hundido al menos la mitad del trazado cartografiado."@es ,
         "Fault with dip-parallel displacement component of slip vector more than 10 times the strike-parallel component of the slip vector at at least one location along the mapped trace of the fault, and the fault dips consistently in the same direction with the hanging wall displaced up relative to the footwall over at least half the mapped trace of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/reverse_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/reverseFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla inversa"@es ,
        "reverse fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-en-tijera> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Falla en la que, a partir de un punto inicial sin ninguna separación, se da una separación creciente a lo largo de la dirección de la falla y una separación decreciente en la dirección opuesta."@es ,
         "A fault on which there is increasing offset or separation along the strike from an initial point of no offset, with the opposite sense of offset in the opposite direction."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/scissor_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/scissorFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla en tijera"@es ,
        "scissor fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Falla en la que el componente de desplazamiento paralelo a la dirección de la superficie de falla es más de 10 veces superior al desplazamiento paralelo al buzamiento al menos en una zona del trazado cartografiado."@es ,
         "Fault with strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the mapped trace of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/strike_slip_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/strikeSlipFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-dextra> ,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-sinestral> ,
    <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-de-alto-angulo> ;
    skos:prefLabel "falla de desgarre"@es ,
        "strike slip fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-dextra> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre> ;
    skos:definition "Falla de desgarre en la que un bloque se desplaza hacia la derecha del bloque desde donde se hace la observación."@es ,
         "Fault with right-lateral strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the fault, and right-lateral displacement over more than half the mapped trace of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/dextral_strike_slip_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/dextralStrikeSlipFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla de desgarre dextra"@es ,
        "dextral strike slip fault"@en .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-sinestral> a skos:Concept ;
    dcterms:provenance "this vocabulary"@en ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre> ;
    skos:definition "Falla de desgarre en la que un bloque se desplaza hacia la izquierda del bloque desde donde se hace la observación."@es ,
         "Fault with left-lateral strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the fault, and left-lateral displacement over more than half the mapped trace of the fault."@en ;
    skos:exactMatch <http://resource.geosciml.org/classifier/cgi/faulttype/siniestral_strike_slip_fault>,
        <http://inspire.ec.europa.eu/codelist/FaultTypeValue/siniestralStrikeSlipFault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "falla de desgarre sinestral"@es ,
        "siniestral strike slip fault"@en .
