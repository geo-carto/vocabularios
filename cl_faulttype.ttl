@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geo-carto.github.io/vocabularios/falla-tipo/collection> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:definition "All concepts in this vocabulary."@en,
        "Todos los conceptos en este vocabulario."@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:member <https://geo-carto.github.io/vocabularios/falla-tipo/cabalgamiento>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-mixta>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-pura>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-dextra>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-sinestral>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-en-tijera>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-horizontal>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-dextra>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-sinistra>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-dextra>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-sinistra>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/superficie-de-despegue> ;
    skos:prefLabel "Fault type - All concepts"@en,
        "Tipo de falla - Todos los conceptos"@es .

<https://linked.data.gov.au/org/cgi-gtwg> a sdo:Organization ;
    sdo:affiliation <https://linked.data.gov.au/org/cgi> ;
    sdo:name "CGI Geoscience Terminology Working Group" ;
    sdo:url <http://www.cgi-iugs.org/tech_collaboration/geoscience_terminology_working_group.html> .

<https://linked.data.gov.au/org/cgi> a sdo:Organization ;
    sdo:name "Commission for the Management and Application of Geoscience Information" ;
    sdo:url <http://www.cgi-iugs.org> .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-mixta> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional> ;
    skos:definition "An extraction fault with some displacement within the fault plane."@en,
        "Falla contracional con algo de desplazamiento en la dirección del plano de falla."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/mixedExtractionFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/mixed_extraction_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "mixed extraction fault"@en,
        "falla contraccional mixta"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-pura> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional> ;
    skos:definition "An extraction fault with no discernible displacement within the fault plane."@en,
        "Falla contracional sin  desplazamiento apreciable a lo largo del plano de falla."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/pureExtractionFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/pure_extraction_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "pure extraction fault"@en,
        "falla contraccional pura"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-dextra> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre> ;
    skos:definition "Fault with right-lateral strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the fault, and right-lateral displacement over more than half the mapped trace of the fault."@en,
        "Falla de desgarre en la que un bloque se desplaza hacia la derecha del bloque desde donde se hace la observación."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/dextralStrikeSlipFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/dextral_strike_slip_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "dextral strike slip fault"@en,
        "falla de desgarre dextra"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-sinestral> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre> ;
    skos:definition "Fault with left-lateral strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the fault, and left-lateral displacement over more than half the mapped trace of the fault."@en,
        "Falla de desgarre en la que un bloque se desplaza hacia la izquierda del bloque desde donde se hace la observación."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/sinistralStrikeSlipFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/sinistral_strike_slip_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "siniestral strike slip fault"@en,
        "falla de desgarre sinestral"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-en-tijera> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "A fault on which there is increasing offset or separation along the strike from an initial point of no offset, with the opposite sense of offset in the opposite direction."@en,
        "Falla en la que, a partir de un punto inicial sin ninguna separación, se da una separación creciente a lo largo de la dirección de la falla y una separación decreciente en la dirección opuesta."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/scissorFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/scissor_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "scissor fault"@en,
        "falla en tijera"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-horizontal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo> ;
    skos:definition "Fault that dips less than 10 degrees over more than half the recognized extent of the fault."@en,
        "Falla que buza menos de 10 grados sobre más de la mitad de la extensión reconocida de la falla."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/horizontalFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/horizontal_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "horizontal fault"@en,
        "falla horizontal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-dextra> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> ;
    skos:definition "High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with a right-lateral strike-parallel component and reverse dip-parallel component of slip over at least half the mapped trace of the fault."@en,
        "Falla inversa de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la derecha del bloque desde donde se hace la observación."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/rightReverseFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/right_reverse_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "right reverse fault"@en,
        "falla inversa dextra"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-sinistra> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> ;
    skos:definition "High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with left-lateral strike-parallel component and reverse dip-parallel component over at least half the mapped trace of the fault."@en,
        "Falla inversa de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la izquierda del bloque desde donde se hace la observación."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/leftReverseFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/left_reverse_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "left reverse fault"@en,
        "falla inversa sinistra"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-dextra> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> ;
    skos:definition "High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with right-lateral strike-parallel component and normal dip-parallel component of slip over at least half the mapped trace of the fault"@en,
        "Falla normal de alto ángulo en la que la componente del desplazamiento paralelo al rumbo tiene una relación de 10 a 1 como mínimo en un tramo a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la derecha del bloque desde donde se hace la observación."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/rightNormalFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/right_normal_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "right normal fault"@en,
        "falla normal dextra"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-sinistra> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> ;
    skos:definition "High angle fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace, with left-lateral strike-parallel component and normal dip-parallel component over at least half the mapped trace of the fault."@en,
        "Falla normal de alto ángulo en la que la relación del desplazamiento paralelo al rumbo respecto al desplazamiento perpendicular al mismo tiene un valor comprendido entre 10 a 1 y 1 a 10 en, como mínimo, una zona a lo largo de su traza cartográfica y en la que un bloque se desplaza hacia la izquierda del bloque desde donde se hace la observación."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/leftNormalFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/left_normal_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "left normal fault"@en,
        "falla normal sinistra"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/superficie-de-despegue> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo> ;
    skos:definition "A regional-scale, large displacement, low-angle normal fault."@en,
        "Falla normal de bajo ángulo con gran desplazamiento y escala regional."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/detachmentFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/detachment_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "detachment fault"@en,
        "superficie de despegue"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/cabalgamiento> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa> ;
    skos:definition "Fault that dips less than 45 degrees over more than half of the recognized extent of the fault, with a hanging wall displaced from a structurally deeper position relative to footwall rocks."@en,
        "Falla que buza menos de 45 grados en más de la mitad de la extensión reconocida de la falla, con un bloque superior desplazado desde una posición estructuralmente más profunda en relación con las rocas del bloque inferior."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/thrustFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/thrust_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "thrust fault"@en,
        "cabalgamiento"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-de-alto-angulo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre> ;
    skos:definition "A strike slip fault in which the fault plane dips at least 45 degrees over more than half of the recognized extent of the fault."@en,
        """Falla de desgarre cuyo plano de falla buza como mínimo 45 grados en más de la mitad de la extensión en la que se ha reconocido.
."""@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/wrenchFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/wrench_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "wrench fault"@en,
        "falla de desgarre de alto ángulo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-de-alto-angulo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa> ;
    skos:definition "Reverse fault that dips at least 45 degrees over more than half of its recognized extent, for which slip or separation is not explicitly specified"@en,
        "Falla inversa cuyo plano buza más de 45 grados sobre más de la mitad de su extensión reconocida."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/highAngleReverse>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/high_angle_reverse> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "high angle reverse"@en,
        "falla inversa de alto ángulo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal> ;
    skos:definition "Fault that dips at least 45 degrees over more than half of the recognized extent of the fault with the hanging wall displaced from a structurally higher position relative to footwall rocks."@en,
        "Falla normal cuyo plano buza más de 45 grados sobre más de la mitad de su extensión reconocida."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/highAngleNormalFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/high_angle_normal_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:prefLabel "high angle normal fault"@en,
        "falla normal de alto ángulo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "A fault whose two sides have approached each other substantially in the direction perpendicular to the fault."@en,
        "Falla cuyos dos lados se han aproximado notablemente entre sí en la dirección perpendicular a la falla."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/extractionFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/extraction_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-mixta>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional-pura> ;
    skos:prefLabel "extraction fault"@en,
        "falla contraccional"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Fault with dip-parallel displacement component of slip vector more than 10 times the strike-parallel component of the slip vector at at least one location along the mapped trace of the fault, and the fault dips consistently in the same direction with the hanging wall displaced up relative to the footwall over at least half the mapped trace of the fault."@en,
        "Falla en la que el componente de desplazamiento paralelo al buzamiento es más de 10 veces superior al componente de desplazamiento paralelo al rumbo al menos en un lugar del trazado cartografiado y la falla buza sistemáticamente en la misma dirección, estando el labio levantado desplazado hacia arriba en relación con el labio hundido al menos la mitad del trazado cartografiado."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/reverseFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/reverse_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/cabalgamiento>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-de-alto-angulo> ;
    skos:prefLabel "reverse fault"@en,
        "falla inversa"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Fault with dip-parallel displacement component of slip vector more than 10 times the strike-parallel component of the slip vector over more than half recognized extent of the fault, and for which the fault dips consistently in the same direction, and for which the hanging wall has been displaced down relative to the footwall."@en,
        "Falla cuyo bloque elevado es el inferior y su superficie buza hacia el bloque hundido y en la que la componente del desplazamiento paralelo al buzamiento es más de 10 veces superior a la componente del desplazamiento paralelo al rumbo en más de la mitad de la extensión en la que ha sido reconocida."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/normalFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/normal_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo> ;
    skos:prefLabel "normal fault"@en,
        "falla normal"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal> ;
    skos:definition "Fault that dips less than 45 degrees over more than half of the recognized extent of the fault with the hanging wall displaced from a structurally higher position relative to footwall rocks."@en,
        "Falla normal que buza menos de 45 grados en más de la mitad de la extensión reconocida de la falla."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/lowAngleNormalFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/low_angle_normal_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/superficie-de-despegue> ;
    skos:prefLabel "low angle normal fault"@en,
        "falla normal de bajo ángulo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Fault that dips at least 45 degrees over more than half of its recognized extent, for which slip or separation is not explicitly specified."@en,
        "Falla cuyo plano buza más de 45 grados sobre más de la mitad de su extensión reconocida, y para la cual el deslizamiento o separación no se especifica explícitamente."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/highAngleFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/high_angle_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-alto-angulo> ;
    skos:prefLabel "high angle fault"@en,
        "falla de alto ángulo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Fault that dips less than 45 degrees over more than half of the recognized extent of the fault."@en,
        "Falla cuyo plano buza menos de 45 grados sobre más de la mitad de su extensión reconocida."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/lowAngleFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/low_angle_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/cabalgamiento>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-horizontal>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-de-bajo-angulo> ;
    skos:prefLabel "low angle fault"@en,
        "falla de bajo ángulo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Fault with strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the mapped trace of the fault."@en,
        "Falla en la que el componente de desplazamiento paralelo a la dirección de la superficie de falla es más de 10 veces superior al desplazamiento paralelo al buzamiento al menos en una zona del trazado cartografiado."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/strikeSlipFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/strike_slip_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-dextra>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre-sinestral> ;
    skos:prefLabel "strike slip fault"@en,
        "falla de desgarre"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:broader <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:definition "Fault with slip vector that has ratio of strike-parallel to dip-parallel displacement between 10 to 1 and 1 to 10 at at least one location along the mapped trace of the fault."@en,
        "Falla en la que ambas componentes del desplazamiento: en la  dirección de la capa y en la dirección de buzamiento tienen un valor apreciable."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/obliqueSlipFault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/oblique_slip_fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-dextra>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa-sinistra>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-dextra>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal-sinistra> ;
    skos:prefLabel "oblique slip fault"@en,
        "falla de desplazamiento oblicuo"@es ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo/falla> a skos:Concept ;
    dcterms:created "2026-03-01"^^xsd:date ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:definition "A discrete surface, or zone of discrete surfaces, with some thickness, separating two rock masses across which one mass has slid past the other and characterized by brittle deformation."@en,
        "Superficie discreta, o zona de superficies discretas, con un cierto espesor, que separa dos cuerpos rocosos y a lo largo de la cual uno de los cuerpos se ha deslizado con respecto al otro."@es ;
    skos:exactMatch <http://inspire.ec.europa.eu/codelist/FaultTypeValue/fault>,
        <http://resource.geosciml.org/classifier/cgi/faulttype/fault> ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    skos:narrower <https://geo-carto.github.io/vocabularios/falla-tipo/falla-contraccional>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-alto-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-bajo-angulo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desgarre>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-de-desplazamiento-oblicuo>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-en-tijera>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-inversa>,
        <https://geo-carto.github.io/vocabularios/falla-tipo/falla-normal> ;
    skos:prefLabel "fault"@en,
        "falla"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/falla-tipo> ;
    adms:status "Válido" .

<https://geo-carto.github.io/vocabularios/falla-tipo> a skos:ConceptScheme ;
    dcterms:created "2026-03-01"^^xsd:date ;
    dcterms:creator "https://commission.europa.eu/" ;
    dcterms:description "Términos que clasifican el tipo de falla"@es ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-03-01"^^xsd:date ;
    dcterms:provenance "Términos originales de INSPIRE" ;
    dcterms:publisher <https://www.igme.es/> ;
    owl:versionInfo "1.0.0" ;
    skos:definition "Terms that classify the type of fault."@en,
        "Términos que clasifican el tipo de falla"@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Tipo de falla."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/falla-tipo/falla> ;
    skos:prefLabel "Fault type"@en,
        "Tipo de falla"@es .

