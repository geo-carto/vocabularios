<https://geo-carto.github.io/vocabularios/estratificacion-grosor> a skos:ConceptScheme ;
    dcterms:created "2026-03-01"^^xsd:date ;
    dcterms:creator "https://www.igme.es" ;
    dcterms:description "The property beddingThickness provides a term from a controlled vocabulary characterizing the thickness of bedding in the unit."@en,
        "Término de un vocabulario controlado que caracteriza el espesor de la estratificación en la unidad."@es ;
