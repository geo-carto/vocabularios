    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/estratificacion-grosor> ;
    skos:definition "Mean strata thickness comprised between 1 and 10 cm"@en,
        "Espesor medio de las capas comprendido entre 1 y 10 cm"@es ;
    skos:inScheme <https://geo-carto.github.io/vocabularios/estratificacion-grosor> ;
    skos:prefLabel "centimetric"@en,
        "centimétrica"@es ;
    skos:topConceptOf <https://geo-carto.github.io/vocabularios/estratificacion-grosor> ;
    adms:status "Válido" .

