    dcterms:provenance "Términos propios definidos por el IGME" ;
    dcterms:publisher <https://www.igme.es/> ;
    dcterms:title "Bedding thickness"@en,
        "Grosor de estratificación"@es ;
    owl:versionInfo "1.0.0" ;
    skos:definition "The property beddingThickness provides a term from a controlled vocabulary characterizing the thickness of bedding in the unit."@en,
        "Término de un vocabulario controlado que caracteriza el espesor de la estratificación en la unidad."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Grosor de estratificación."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/estratificacion-grosor/centimetrica>,
        <https://geo-carto.github.io/vocabularios/estratificacion-grosor/decametrica>,
