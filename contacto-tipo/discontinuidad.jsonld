{
  "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/discontinuidad",
  "type": "Concept",
  "prefLabel": {
    "en": "unconformable contact",
    "es": "discontinuidad"
  },
  "definition": {
    "en": "A contact separating two geological units in which the younger unit succeeds the older after a substantial hiatus in deposition.",
    "es": "Contacto que separa dos unidades geológicas en el que la unidad más joven sucede a la más antigua tras una interrupción medible de la sedimentación."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-discordante",
      "prefLabel": {
        "en": "angular unconformable contact",
        "es": "contacto discordante"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/disconformidad",
      "prefLabel": {
        "en": "disconformable contact",
        "es": "disconformidad"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/disconformidad-con-paleorrelieve",
      "prefLabel": {
        "en": "buttress unconformity",
        "es": "discontinuidad con paleorrelieve"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/inconformidad",
      "prefLabel": {
        "en": "nonconformable contact",
        "es": "inconformidad"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/paraconformidad",
      "prefLabel": {
        "en": "paraconformable contact",
        "es": "paraconformidad"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-deposicional",
    "prefLabel": {
      "en": "depositional contact",
      "es": "contacto deposicional"
    }
  },
  "exactMatch": [
    {
      "id": "http://resource.geosciml.org/classifier/cgi/contacttype/unconformable_contact"
    }
  ],
