{
  "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-mecanico",
  "type": "Concept",
  "prefLabel": {
    "es": "contacto mecánico",
    "en": "mechanic contact"
  },
  "definition": {
    "es": "Superficie que separa dos unidades geológicas y que se ha originado principalmente por procesos físicos, como la actividad tectónica (fallas, cabalgamientos) o erosivos (discordancias). Este tipo de contacto no implica necesariamente un cambio en el ambiente de sedimentación.",
    "en": "Surface separating two geological units formed mainly by physical processes such as tectonic activity (faults, thrusts) or erosion (unconformities). This type of contact does not necessarily reflect a change in depositional environment."
  },
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto",
    "prefLabel": {
      "es": "contacto",
      "en": "contact"
    }
  },
