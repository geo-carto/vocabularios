        "es": "contacto de zona deformada"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-deposicional",
      "prefLabel": {
        "en": "depositional contact",
        "es": "contacto deposicional"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-entre-facies-igneas",
      "prefLabel": {
        "en": "igneous phase contact",
        "es": "contacto entre fases ígneas"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-intrusivo",
      "prefLabel": {
        "en": "igneous intrusive contact",
        "es": "contacto intrusivo"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-lateral-de-facies-sedimentarias",
      "prefLabel": {
        "en": "sedimentary facies contact",
        "es": "contacto lateral de facies sedimentarias"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-metamorfico",
      "prefLabel": {
        "en": "metamorphic contact",
        "es": "contacto metamórfico"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-por-intrusion-de-material-sedimentario",
      "prefLabel": {
        "en": "sedimentary intrusive contact",
        "es": "contacto por intrusión de material sedimentario"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-por-meteorizacion",
      "prefLabel": {
        "en": "weathering contact",
        "es": "contacto por meteorización"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/limite-de-estructura-de-impacto",
      "prefLabel": {
        "en": "impact structure boundary",
        "es": "límite de estructura de impacto"
      }
    },
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/limite-de-zona-de-subsidencia-volcanica",
      "prefLabel": {
        "en": "volcanic subsidence zone boundary",
        "es": "límite de zona de subsidencia volcánica"
      }
    }
  ],
  "broader": {
    "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto",
