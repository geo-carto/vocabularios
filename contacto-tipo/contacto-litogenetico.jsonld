{
  "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-litogenetico",
  "type": "Concept",
  "prefLabel": {
    "en": "lithogenetic contact",
    "es": "contacto litogenético"
  },
  "definition": {
    "en": "A non-faulted contact separating bodies of material in the earth that have different lithologic character or geologic history.",
    "es": "Cualquier tipo de contacto, excepto  por falla, que separa cuerpos geológicos que tienen diferente carácter litológico o historia geológica."
  },
  "narrower": [
    {
      "id": "https://geo-carto.github.io/vocabularios/contacto-tipo/contacto-de-zona-deformada",
      "prefLabel": {
