{"componentChunkName":"component---src-components-concept-jsx","path":"/alteracion-producto/arcilla.html","result":{"pageContext":{"node":{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto/arcilla","type":"Concept","prefLabel":{"es":"arcilla","en":"clay","vl":null},"altLabel":null,"hiddenLabel":null,"definition":{"es":"a) Partícula de diámetro igual o inferior a 1/256 mm. b) Mineral del grupo de los aluminosilicatos hidratados que cristalizan en partículas de tamaño arcilla y se caracaterizan por presentar un comportamiento plástico cuando contienen agua. Incluyen los grupos de la caolinita, illita, esmectita y vermiculita. c) Sedimento con un contenido en minerales arcillosos superior al 67%.","en":"a) Particle having a diameter equal to or less than 1/256 mm. b) Minerals, especially hydrous aluminosilicates, cristallized in the clay-sized fraction and characterized by a plastic behaviour in relation to water content. Included are the kaolinite, illite, smectite or vermiculite groups. c) Sediment with more than 67 per cent clay-sized minerals.","vl":null},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto/caolin","prefLabel":{"es":"caolín","en":"kaolin","vl":null}}],"narrowerTransitive":[],"broader":{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto/alterita","prefLabel":{"es":"alterita","en":"alterite","vl":null}},"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto","title":null}],"inSchemeAll":[{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto/collection","type":"Collecti