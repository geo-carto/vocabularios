{"componentChunkName":"component---src-components-concept-jsx","path":"/alteracion-producto/grus.html","result":{"pageContext":{"node":{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto/grus","type":"Concept","prefLabel":{"en":"grus","es":"grus"},"altLabel":{"en":null,"es":["arena"]},"hiddenLabel":null,"definition":{"en":"Alterite caused by physical processes of granular disintegration of coarsed-grained rocks, transformed into minerals and rock fragments with no cohesion, characterized by its grain-size distribution, where the sand (0,1-2,0 mm) and gravel (>2,0 mm) fraction predominate (Migon, 2004). Some authors restrict the term arene to the grus derived from the weathering of plutonic rocks, mainly granites and diorites (Campy and Macaire, 1989).","es":"Alterita originada por procesos físicos de desintegración granular de rocas de grano grueso, transformadas en minerales y fragmentos de roca sin cohesión, caracterizados por su tamaño de grano, en el que las arenas (0,1-2,0 mm) y gravas (>2,0 mm) son la fracción predominante (Migon, 2004). Algunos autores restringen el término arene al grus derivado de la alteración de rocas plutónicas, fundamentalmente granitos y dioritas (Campy y Macaire, 1989)."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto/alterita","prefLabel":{"en":"alterite","es":"alterita"}},"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto","title":{"en":"Alteration product","es":"Producto de alteración"}}],"inSchemeAll":[{"id":"https://geo-carto.github.io/vocabularios/alteracion-producto"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null,"created":"2026-03-01","modified":null,"status":