{"componentChunkName":"component---src-components-concept-jsx","path":"/pliegue-tipo/sinforma.html","result":{"pageContext":{"node":{"id":"https://geo-carto.github.io/vocabularios/pliegue-tipo/sinforma","type":"Concept","prefLabel":{"es":"sinforma","en":"synform"},"altLabel":null,"hiddenLabel":null,"definition":{"es":"Pliegue cuyos flancos se cierran hacia la parte inferior. Este término se utiliza generalmente cuando las capas plegadas no poseen un orden estratigráfico, cuando no se conoce la sucesión estratigráfica de las capas plegadas o cuando el núcleo del pliegue también contiene las rocas estratigráficamente más antiguas.","en":"Any fold whose limbs close at the bottom. The term is usually used when the folded layers do not possess a stratigraphic order, when the stratigraphic order of the folded layers is not known, or when the fold core also contains the stratigraphically older rock."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":null,"notation":null,"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":[{"id":"http://inspire.ec.europa.eu/codelist/FoldProfileTypeValue/synform"}],"inScheme":[{"id":"https://geo-carto.github.io/vocabularios/pliegue-tipo","title":null}],"inSchemeAll":[{"id":"https://geo-carto.github.io/vocabularios/pliegue-tipo"}],"topConceptOf":[{"id":"https://geo-carto.github.io/vocabularios/pliegue-tipo","title":null}],"deprecated":null,"isReplacedBy":null},"collections":[{"id":"https://geo-carto.github.io/vocabularios/pliegue-tipo/collection","type":"Collection","prefLabel":{"es":"Tipo de pliegue - Todos los conceptos","en":null},"member":[{"id":"https://geo-carto.github.io/vocabularios/pliegue-tipo/anticlinal","prefLabel":{"es":"anticlinal","en":"anticline"}},{"id":"https://geo-carto.github.io/vocabularios/pliegue-tipo/anticlinal-tumbado","prefLabel":{"es":"anticlin