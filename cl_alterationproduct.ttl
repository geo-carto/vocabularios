<https://geo-carto.github.io/vocabularios/alteracion-producto/collection> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/alteracion-producto> ;
    skos:definition "All concepts in this vocabulary."@en,
