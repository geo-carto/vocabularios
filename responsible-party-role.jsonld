{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role","type":"ConceptScheme","title":{"en":"Responsible Party Role","es":"Rol de parte responsable"},"prefLabel":{"en":"Responsible Party Role","es":"Rol de parte responsable"},"description":{"en":"Function performed by the responsible party according to ISO 19115 CI_RoleCode.","es":"Función desempeñada por la parte responsable según ISO 19115 CI_RoleCode."},"publisher":{"id":"https://www.igme.es/"},"created":"2026-03-01","modified":"2026-03-01","creator":"https://www.iso.org/","provenance":"Términos originales de ISO 19115","versionInfo":"1.0.0","theme":"TE","license":{"id":"https://creativecommons.org/licenses/by/4.0/"},"hasTopConcept":[{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/autor","prefLabel":{"en":"author","es":"autor"},"definition":{"en":"Party who authored the resource.","es":"Parte que es el autor del recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/co-autor","prefLabel":{"en":"coAuthor","es":"co-autor"},"definition":{"en":"Party who jointly authors the resource.","es":"Parte que coautoriza el recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/colaborador","prefLabel":{"en":"collaborator","es":"colaborador"},"definition":{"en":"Party who assists with the generation of the resource other than the principal investigator.","es":"Parte que ayuda en la generación del recurso distinta del investigador principal."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/contribuyente","prefLabel":{"en":"contributor","es":"contribuyente"},"definition":{"en":"Party contributing to the resource.","es":"Parte que contribuye al recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/creador","prefLabel":{"en":"originator","es":"creador"},"definition":{"en":"Party who created the resource.","es":"Parte que creó el recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/custodio","prefLabel":{"en":"custodian","es":"custodio"},"definition":{"en":"Party that accepts accountability and responsibility for the resource and ensures appropriate care and maintenance of the resource.","es":"Parte que acepta la responsabilidad de los datos y asegura el cuidado y mantenimiento apropiados del recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/distribuidor","prefLabel":{"en":"distributor","es":"distribuidor"},"definition":{"en":"Party who distributes the resource.","es":"Parte que distribuye el recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/editor","prefLabel":{"en":"editor","es":"editor"},"definition":{"en":"Party who reviewed or modified the resource to improve the content.","es":"Parte que revisó o modificó el recurso para mejorar el contenido."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/esponsor","prefLabel":{"en":"sponsor","es":"espónsor"},"definition":{"en":"Party who speaks for the resource.","es":"Parte que habla en nombre del recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/financiador","prefLabel":{"en":"funder","es":"financiador"},"definition":{"en":"Party providing monetary support for the resource.","es":"Parte que proporciona apoyo financiero para el recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/interesado","prefLabel":{"en":"stakeholder","es":"interesado"},"definition":{"en":"Party who has an interest in the resource. or the use of the resource.","es":"Parte que tiene interés en el recurso o en su uso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/investigador-principal","prefLabel":{"en":"principalInvestigator","es":"investigador principal"},"definition":{"en":"Key party responsible for gathering information and conducting research","es":"Parte principal responsable de la recopilación de información y la dirección de la investigación."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/mediador","prefLabel":{"en":"mediator","es":"mediador"},"definition":{"en":"A class of entity that mediates access to the resource and for whom the resource is intended or useful.","es":"Clase de entidad que media el acceso al recurso y para la cual el recurso está destinado o resulta útil."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/procesador","prefLabel":{"en":"processor","es":"procesador"},"definition":{"en":"Party who has processed the data in a manner such that the resource has been modified.","es":"Parte que ha procesado los datos de una manera tal que ha modificado el recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/propietario","prefLabel":{"en":"owner","es":"propietario"},"definition":{"en":"Party that owns the resource.","es":"Parte propietaria del recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/proveedor-de-recursos","prefLabel":{"en":"resourceProvider","es":"proveedor de recursos"},"definition":{"en":"Party that supplies the resource.","es":"Parte que suministra el recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/publicador","prefLabel":{"en":"publisher","es":"publicador"},"definition":{"en":"Party who published the resource.","es":"Parte que publica el recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/punto-de-contacto","prefLabel":{"en":"pointOfContact","es":"punto de contacto"},"definition":{"en":"Party who can be contacted for acquiring knowledge about or acquisition of the resource.","es":"Parte con la que se puede contactar para adquirir conocimiento o acceder al recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/titular-de-los-derechos","prefLabel":{"en":"rightsHolder","es":"titular de los derechos"},"definition":{"en":"Party owning or managing rights over the resource.","es":"Parte propietaria o gestora de los derechos sobre el recurso."}},{"id":"https://geo-carto.github.io/vocabularios/responsible-party-role/usuario","prefLabel":{"en":"user","es":"usuario"},"definition":{"en":"Party who uses the resource.","es":"Parte que usa el recurso."}}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","dcat":"http://www.w3.org/ns/dcat#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","contributor":"dct:contributor","provenance":"dct:provenance","publisher":"dct:publisher","versionInfo":"owl:versionInfo","status":{"@id":"http://www.w3.org/ns/adms#status"},"preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","theme":"dcat:theme","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container"