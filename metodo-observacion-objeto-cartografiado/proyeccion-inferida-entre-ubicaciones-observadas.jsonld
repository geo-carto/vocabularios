{
  "id": "https://geo-carto.github.io/vocabularios/metodo-observacion-objeto-cartografiado/proyeccion-inferida-entre-ubicaciones-observadas",
  "type": "Concept",
  "prefLabel": {
    "en": "inferred projection between observed locations",
    "es": "proyección inferida entre ubicaciones observadas"
  },
  "definition": {
    "en": "Location and specification determined based on inferred continuity with observed locations, and assumption of continuity of the feature.",
    "es": "La ubicación y especificación se determinan por continuidad inferida entre ubicaciones observadas, asumiendo continuidad del elemento."
  },
