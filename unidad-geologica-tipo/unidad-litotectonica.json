{
  "id": "https://geo-carto.github.io/vocabularios/unidad-geologica-tipo/unidad-litotectonica",
  "type": "Concept",
  "prefLabel": {
    "en": "lithotectonic unit",
    "es": "unidad litotectónica"
  },
  "definition": {
    "en": "Geologic unit defined on basis of structural or deformation features, mutual relations, origin or historical evolution. Contained material may be igneous, sedimentary, or metamorphic.",
    "es": "Unidad geológica definida a partir de características estructurales o de deformación, de relaciones mutuas, de su origen o de su evolución histórica. El material que contiene puede ser ígneo, sedimentario o metamórfico."
  },
