{
  "id": "https://geo-carto.github.io/vocabularios/metamorfismo-facies/facies-metamorfica-de-las-anfibolitas",
  "type": "Concept",
  "prefLabel": {
    "en": "amphibolite metamorphic facies",
    "es": "facies metamórfica de las anfibolitas"
  },
  "definition": {
    "en": "Metamorphic facies characterized in rocks of basaltic composition by hornblende-plagioclase (plagioclase more calcic than An17).",
    "es": "Facies metamórfica caracterizada en rocas de composición basáltica por hornblenda-plagioclasa (plagioclasa más cálcica que An17)"
  },
