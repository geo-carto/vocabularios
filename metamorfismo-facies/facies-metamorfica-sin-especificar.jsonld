{
  "id": "https://geo-carto.github.io/vocabularios/metamorfismo-facies/facies-metamorfica-sin-especificar",
  "type": "Concept",
  "prefLabel": {
    "en": "metamorphic facies not specified",
    "es": "facies metamórfica sin especificar"
  },
  "definition": {
    "en": "Metamorphosed, but facies not specified in more detail. For use in normative description to indicate that any metamorphic facies value is valid.",
    "es": "Metamorfizado, pero en facies no especificada con más detalle. Para su uso en descripción normativa para indicar que cualquier valor de facies metamórfica es válido."
  },
