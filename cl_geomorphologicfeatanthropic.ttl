@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/collection> a skos:Collection ;
    rdfs:isDefinedBy <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico> ;
    skos:definition "All concepts in this vocabulary."@en,
        "Todos los conceptos en este vocabulario."@es ;
