        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/drenaje-artificial>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/embalse>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/escombrera>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/explanada>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/mina-a-cielo-abierto>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/pozo>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/tierra-recuperada>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/vertedero> ;
    skos:prefLabel "Geomorphological anthropogenic feature"@en,
        "Objeto geomorfológico antrópico"@es .

