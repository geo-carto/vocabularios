    dcterms:publisher <https://www.igme.es/> ;
    owl:versionInfo "1.0.0" ;
    skos:definition "Terms referring to anthropogenic geomorphological features."@en,
        "Términos referidos al objeto geomorfológico antrópico."@es ;
    skos:editorialNote "Este archivo contiene el vocabulario Objeto geomorfológico antrópico."@es ;
    skos:hasTopConcept <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/acumulo>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/area-de-subsidencia-antropogenica>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/canal-dragado>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/cantera>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/crater-de-impacto-antropogenico>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/deposito-de-relleno>,
        <https://geo-carto.github.io/vocabularios/geomorfologia-tipo-antropogenico/depresion-artificial>,
