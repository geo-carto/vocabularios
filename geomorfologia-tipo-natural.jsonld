s":"Zona con acumulaciones de arena formadas por el viento.","en":"Area with sand accumulations formed by the wind."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-dunas-con-vegetacion","prefLabel":{"es":"campo de dunas con vegetación","en":"vegetated dune field"},"definition":{"es":"Campo de dunas parcial o totalmente estabilizado por vegetación.","en":"A dune field partially or totally stabilized by vegetation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-dunas-fosiles","prefLabel":{"es":"campo de dunas fósiles","en":"fossil dune field"},"definition":{"es":"Campo de dunas inactivas, fijadas y consolidadas.","en":"A field of inactive, fixed and consolidated dunes."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cresta-dunar","prefLabel":{"es":"cresta dunar","en":"dune crest"},"definition":{"es":"Línea más alta de una duna.","en":"The highest line of a dune."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cubetas-de-deflaccion","prefLabel":{"es":"cubetas de deflacción","en":"deflation hollows"},"definition":{"es":"Depresiones poco profundas excavadas por la acción del viento.","en":"Shallow depressions excavated by wind action."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dunas","prefLabel":{"es":"dunas","en":"dunes"},"definition":{"es":"Montículos de arena formados por acción eólica.","en":"Sand mounds formed by wind action."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/barjanes","prefLabel":{"es":"barjanes","en":"barchans"},"definition":{"es":"Dunas en forma de media luna con las puntas orientadas a sotavento.","en":"Crescent-shaped dunes with horns pointing downwind."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dunas-longitudinales","prefLabel":{"es":"dunas longitudinales","en":"longitudinal dunes"},"definition":{"es":"Dunas alargadas paralelas a la dirección del viento.","en":"Elongated dunes parallel to the wind direction."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dunas-parabolicas","prefLabel":{"es":"dunas parabólicas","en":"parabolic dunes"},"definition":{"es":"Dunas con forma de U o parábola abiertas en la dirección del viento.","en":"U-shaped or parabolic dunes open in the wind direction."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dunas-transversales","prefLabel":{"es":"dunas transversales","en":"transverse dunes"},"definition":{"es":"Dunas alargadas perpendiculares a la dirección del viento.","en":"Elongated dunes perpendicular to the wind direction."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dunas-trepadoras","prefLabel":{"es":"dunas trepadoras","en":"climbing dunes"},"definition":{"es":"Dunas que ascienden por una ladera empujadas por el viento.","en":"Dunes that climb up a slope driven by the wind."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/loess","prefLabel":{"es":"loess","en":"loess"},"definition":{"es":"Depósito de limo transportado y depositado por el viento.","en":"A deposit of silt transported and deposited by the wind."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ventifactos","prefLabel":{"es":"ventifactos","en":"ventifacts"},"definition":{"es":"Cantos con caras pulidas y facetas producidas por abrasión eólica.","en":"Pebbles with polished faces and facets produced by wind abrasion."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/viento-dominante","prefLabel":{"es":"viento dominante","en":"prevailing wind"},"definition":{"es":"Dirección predominante del viento en una zona.","en":"Predominant wind direction in an area."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-aluviales-y-fluviales","prefLabel":{"es":"objetos geográficos aluviales y fluviales","en":"alluvial and fluvial features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relacionados predominantemente con corrientes de agua concentradas (corrientes canalizadas).","en":"Geomorphologic landscapes and landforms dominantly related to concentrated water flow (channel flow)."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/abanico-aluvial-de-baja-pendiente","prefLabel":{"es":"abanico aluvial de baja pendiente","en":"low-gradient alluvial fan"},"definition":{"es":"Abanico aluvial de gran extensión y baja pendiente.","en":"An alluvial fan of great extent and low gradient."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/albardon-dique-natural-levee","prefLabel":{"es":"albardón; dique natural; levée","en":"natural levee"},"definition":{"es":"Elevación alargada a lo largo de las márgenes de un río formada por desbordamiento.","en":"An elongated elevation along river margins formed by overbank flooding."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/arista-o-divisoria-montanyosa","prefLabel":{"es":"arista o divisoria montañosa","en":"mountain ridge; divide"},"definition":{"es":"Cresta estrecha y aguda que separa cuencas hidrográficas en zonas montañosas.","en":"A narrow and sharp crest separating drainage basins in mountainous areas."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/aristas-en-interfluvios","prefLabel":{"es":"aristas en interfluvios","en":"interfluve ridges"},"definition":{"es":"Crestas agudas que separan cauces fluviales adyacentes.","en":"Sharp ridges separating adjacent fluvial channels."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/arroyada-en-regueros-permanentes-o-cambiantes","prefLabel":{"es":"arroyada en regueros, permanentes o cambiantes","en":"rill wash"},"definition":{"es":"Erosión superficial por flujo concentrado en pequeños surcos.","en":"Surface erosion by concentrated flow in small rills."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/banco-barra","prefLabel":{"es":"banco; barra","en":"bank; bar"},"definition":{"es":"Acumulación de sedimentos en el interior de un cauce fluvial.","en":"Sediment accumulation within a river channel."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/banco-barra-con-cicatrices-de-acrecion-lateral","prefLabel":{"es":"banco; barra con cicatrices de acreción lateral","en":"bar with lateral accretion scars"},"definition":{"es":"Barra fluvial con marcas visibles de crecimiento lateral.","en":"A fluvial bar with visible marks of lateral growth."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/borde-de-terraza-en-niveles-solapados","prefLabel":{"es":"borde de terraza en niveles solapados","en":"overlapping terrace levels edge"},"definition":{"es":"Borde de terrazas fluviales que se solapan en su extensión lateral.","en":"Edge of fluvial terraces that overlap in their lateral extent."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cambio-brusco-de-pendiente-salto-de-agua-cascada","prefLabel":{"es":"cambio brusco de pendiente; salto de agua; cascada","en":"waterfall; cascade"},"definition":{"es":"Caída vertical o casi vertical del agua en un cauce fluvial.","en":"Vertical or near-vertical water drop in a river channel."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cambio-de-pendiente-rapidos","prefLabel":{"es":"cambio de pendiente; rápidos","en":"slope change; rapids"},"definition":{"es":"Zona de aumento de pendiente en un cauce fluvial con flujo turbulento.","en":"Zone of slope increase in a river channel with turbulent flow."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canal-principal-cauce-activo-en-grandes-rios-limite-del-lecho","prefLabel":{"es":"canal principal; cauce activo en grandes ríos; límite del lecho","en":"main channel; active bed limit"},"definition":{"es":"Cauce principal de un río o límite del lecho activo.","en":"Main channel of a river or limit of the active bed."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canal-temporal-o-de-avenida-brazo-de-corriente-aliviadero-chute","prefLabel":{"es":"canal temporal o de avenida, brazo de corriente, aliviadero; chute","en":"flood channel; chute"},"definition":{"es":"Canal que solo funciona durante crecidas o avenidas.","en":"A channel that only functions during floods."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/captura-fluvial","prefLabel":{"es":"captura fluvial","en":"river capture"},"definition":{"es":"Proceso por el cual un río desvía las aguas de otro al erosionar su divisoria.","en":"Process by which a river diverts the waters of another by eroding its divide."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/carcavas","prefLabel":{"es":"cárcavas","en":"gullies"},"definition":{"es":"Incisiones profundas y estrechas en materiales blandos producidas por erosión hídrica concentrada.","en":"Deep and narrow incisions in soft materials produced by concentrated water erosion."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/area-acarcavada","prefLabel":{"es":"área acarcavada","en":"gullied area"},"definition":{"es":"Zona con una alta densidad de cárcavas.","en":"An area with a high density of gullies."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cabecera-de-carcavas","prefLabel":{"es":"cabecera de cárcavas","en":"gully head"},"definition":{"es":"Parte superior de una cárcava donde se produce el retroceso erosivo.","en":"Upper part of a gully where erosional retreat occurs."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/carcavas-puntual","prefLabel":{"es":"cárcavas (puntual)","en":"gully (point feature)"},"definition":{"es":"Representación puntual de una cárcava individual.","en":"Point representation of an individual gully."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cauce-o-meandro-abandonado","prefLabel":{"es":"cauce o meandro abandonado","en":"abandoned channel; abandoned meander"},"definition":{"es":"Antiguo cauce o meandro que ya no es funcional.","en":"A former channel or meander that is no longer functional."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cauce-o-meandro-abandonado-temporalmente-inundado-oxbow","prefLabel":{"es":"cauce o meandro abandonado, temporalmente inundado; oxbow","en":"oxbow lake"},"definition":{"es":"Meandro abandonado que se inunda temporalmente formando un lago en herradura.","en":"An abandoned meander that temporarily floods forming an oxbow lake."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/collado","prefLabel":{"es":"collado; puerto; col","en":"pass; col"},"definition":{"es":"Depresión en una divisoria que permite el paso.","en":"A depression in a divide allowing passage."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/confluencia-anomala-de-cauces","prefLabel":{"es":"confluencia anómala de cauces","en":"anomalous channel confluence"},"definition":{"es":"Unión de cauces fluviales con un ángulo o disposición inusual que sugiere control estructural.","en":"Junction of fluvial channels with an unusual angle or arrangement suggesting structural control."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cono-de-deyeccion-abanico-aluvial-con-pendiente-elevada","prefLabel":{"es":"cono de deyección; abanico aluvial con pendiente elevada","en":"alluvial fan; high-gradient fan"},"definition":{"es":"Depósito en forma de cono al pie de una montaña formado por corrientes torrenciales.","en":"Cone-shaped deposit at the foot of a mountain formed by torrential streams."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cuerda-o-divisoria-montanyosa-redondeada","prefLabel":{"es":"cuerda o divisoria montañosa redondeada","en":"rounded mountain divide"},"definition":{"es":"Divisoria de aguas con perfil redondeado y suave.","en":"A watershed divide with a rounded and gentle profile."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/deposito-de-arroyada-aluvial-coluvial-relleno-de-vaguada","prefLabel":{"es":"depósito de arroyada; aluvial-coluvial; relleno de vaguada","en":"wash deposit; alluvial-colluvial fill"},"definition":{"es":"Depósito formado por arroyada difusa en vaguadas y laderas.","en":"Deposit formed by diffuse wash in thalwegs and slopes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/derrame-de-canal-crevasse-splay","prefLabel":{"es":"derrame de canal; crevasse splay","en":"crevasse splay"},"definition":{"es":"Depósito en abanico formado por la rotura del dique natural de un río.","en":"Fan-shaped deposit formed by the breach of a river natural levee."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/divisoria-de-aguas-poco-definida","prefLabel":{"es":"divisoria de aguas poco definida","en":"poorly defined watershed"},"definition":{"es":"Divisoria de aguas de trazado difuso y difícil de localizar con precisión.","en":"A watershed divide with a diffuse trace, difficult to locate precisely."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/erosion-lateral-zapamiento-socavamiento","prefLabel":{"es":"erosión lateral; zapamiento; socavamiento","en":"lateral erosion; undercutting"},"definition":{"es":"Erosión que actúa horizontalmente sobre las márgenes de un cauce.","en":"Erosion acting horizontally on the banks of a channel."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-fluvial","prefLabel":{"es":"escarpe fluvial","en":"fluvial scarp"},"definition":{"es":"Talud vertical o subvertical tallado por la acción erosiva de un río.","en":"Vertical or subvertical slope carved by river erosive action."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-entre-25-100-metros","prefLabel":{"es":"escarpe entre 25-100 metros","en":"scarp 25-100 m"},"definition":{"es":"Escarpe fluvial de entre 25 y 100 metros de altura.","en":"A fluvial scarp between 25 and 100 metres high."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-inferior-a-25-metros","prefLabel":{"es":"escarpe inferior a 25 metros","en":"scarp less than 25 m"},"definition":{"es":"Escarpe fluvial de menos de 25 metros de altura.","en":"A fluvial scarp less than 25 metres high."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-superior-a-100-metros","prefLabel":{"es":"escarpe superior a 100 metros","en":"scarp over 100 m"},"definition":{"es":"Escarpe fluvial de más de 100 metros de altura.","en":"A fluvial scarp over 100 metres high."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-o-borde-de-terraza-colgada-e-indicacion-de-cota-en-metros","prefLabel":{"es":"escarpe o borde de terraza colgada e indicación de cota en metros","en":"hanging terrace scarp with elevation in metres"},"definition":{"es":"Borde de una terraza fluvial colgada con indicación de su cota.","en":"Edge of a hanging fluvial terrace with elevation indication."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-o-borde-de-terraza-degradado","prefLabel":{"es":"escarpe o borde de terraza degradado","en":"degraded terrace scarp"},"definition":{"es":"Borde de terraza fluvial suavizado por procesos erosivos.","en":"Fluvial terrace edge smoothed by erosional processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fondo-de-rambla-torrencial","prefLabel":{"es":"fondo de rambla torrencial","en":"ephemeral stream bed"},"definition":{"es":"Lecho de un curso de agua torrencial con flujo intermitente.","en":"Bed of a torrential watercourse with intermittent flow."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fondo-de-valle","prefLabel":{"es":"fondo de valle","en":"valley floor"},"definition":{"es":"Parte más baja y generalmente plana de un valle fluvial.","en":"The lowest and generally flat part of a fluvial valley."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fondo-de-valle-colgado","prefLabel":{"es":"fondo de valle colgado","en":"hanging valley floor"},"definition":{"es":"Fondo plano de un valle colgado respecto al valle principal.","en":"Flat floor of a valley hanging above the main valley."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/garganta-canyon-fluvial-desfiladero","prefLabel":{"es":"garganta; cañón fluvial; desfiladero","en":"gorge; fluvial canyon"},"definition":{"es":"Valle muy estrecho y profundo con paredes verticales o subverticales.","en":"A very narrow and deep valley with vertical or subvertical walls."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/hombrera","prefLabel":{"es":"hombrera; rellano","en":"shoulder; bench"},"definition":{"es":"Superficie subhorizontal que interrumpe una pendiente.","en":"A subhorizontal surface interrupting a slope."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/incision-dominada-por-sufusion-piping","prefLabel":{"es":"incisión dominada por sufusión; piping","en":"piping-dominated incision"},"definition":{"es":"Incisión del terreno dominada por procesos de erosión interna (piping).","en":"Terrain incision dominated by internal erosion processes (piping)."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/incision-lineal-en-cuna-vaguada","prefLabel":{"es":"incisión lineal en cuna; vaguada","en":"wedge-shaped incision; thalweg"},"definition":{"es":"Incisión fluvial de perfil transversal en cuña o fondo plano poco desarrollado.","en":"Fluvial incision with a wedge-shaped or poorly developed flat-bottom cross section."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/incision-lineal-en-v-barranco","prefLabel":{"es":"incisión lineal en v; barranco","en":"V-shaped incision; ravine"},"definition":{"es":"Incisión fluvial de perfil transversal en forma de V.","en":"Fluvial incision with a V-shaped cross section."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/linea-de-drenaje-difusa","prefLabel":{"es":"línea de drenaje difusa","en":"diffuse drainage line"},"definition":{"es":"Línea de escorrentía sin cauce definido.","en":"A runoff line without a defined channel."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/llanura-de-inundacion","prefLabel":{"es":"llanura de inundación","en":"floodplain"},"definition":{"es":"Superficie plana adyacente a un río que se inunda periódicamente.","en":"A flat surface adjacent to a river that is periodically flooded."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/manantial","prefLabel":{"es":"manantial","en":"spring"},"definition":{"es":"Surgencia natural de agua subterránea en la superficie.","en":"Natural emergence of groundwater at the surface."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/perdida-de-drenaje","prefLabel":{"es":"pérdida de drenaje","en":"drainage loss"},"definition":{"es":"Punto donde un cauce fluvial pierde agua por infiltración.","en":"Point where a river channel loses water by infiltration."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/surgencia-por-sufusion-piping","prefLabel":{"es":"surgencia por sufusión; piping","en":"piping spring"},"definition":{"es":"Surgencia de agua producida por erosión interna del terreno.","en":"Water emergence produced by internal terrain erosion."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza","prefLabel":{"es":"terraza","en":"terrace"},"definition":{"es":"Superficie plana elevada respecto al cauce actual, que representa un antiguo nivel del río.","en":"A flat surface elevated above the current channel, representing a former river level."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza-erosiva","prefLabel":{"es":"terraza erosiva","en":"erosional terrace"},"definition":{"es":"Terraza tallada en la roca sin depósito aluvial significativo.","en":"A terrace carved into rock without significant alluvial deposit."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza-no-ciclica-de-encajamiento-convergente","prefLabel":{"es":"terraza no cíclica (de encajamiento; convergente)","en":"non-cyclic terrace (entrenching; convergent)"},"definition":{"es":"Terraza formada por encajamiento progresivo sin relación con ciclos climáticos.","en":"Terrace formed by progressive entrenchment without relation to climatic cycles."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza-travertinica","prefLabel":{"es":"terraza travertínica","en":"travertine terrace"},"definition":{"es":"Terraza formada por precipitación de carbonato cálcico (travertino).","en":"Terrace formed by calcium carbonate (travertine) precipitation."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/valle-colgado","prefLabel":{"es":"valle colgado","en":"hanging valley"},"definition":{"es":"Valle tributario cuyo fondo se encuentra a una cota más elevada que el valle principal.","en":"A tributary valley whose floor is at a higher elevation than the main valley."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/valle-o-vaguada-con-fondo-plano","prefLabel":{"es":"valle o vaguada con fondo plano","en":"flat-bottomed valley"},"definition":{"es":"Valle fluvial con fondo plano ocupado por depósitos aluviales.","en":"A fluvial valley with a flat bottom occupied by alluvial deposits."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-geograficos-karsticos-y-de-meteorizacion-quimica","prefLabel":{"es":"objetos geográficos kársticos y de meteorización química","en":"karst and chemical weathering features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve dominados por la disolución de minerales y, en general, por el drenaje subsuperficial.","en":"Geomorphologic landscapes and landforms dominated by mineral dissolution, and commonly, subsurface drainage."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/aplanamiento-karstico-superficie-de-corrosion","prefLabel":{"es":"aplanamiento kárstico; superficie de corrosión","en":"karst planation surface"},"definition":{"es":"Superficie plana resultante de la disolución kárstica generalizada.","en":"A flat surface resulting from widespread karst dissolution."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/area-con-relieves-residuales-karsticos-hums","prefLabel":{"es":"área con relieves residuales kársticos; hums","en":"karst residual relief area; hums"},"definition":{"es":"Zona con abundantes relieves residuales kársticos.","en":"An area with abundant karst residual reliefs."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/arenizacion-lehm-granitico","prefLabel":{"es":"arenización; lehm granítico","en":"arenization; granitic lehm"},"definition":{"es":"Meteorización que transforma la roca granítica en arena o lehm.","en":"Weathering that transforms granitic rock into sand or lehm."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/argilizaciones","prefLabel":{"es":"argilizaciones","en":"argillization"},"definition":{"es":"Transformación de minerales en arcilla por meteorización química.","en":"Transformation of minerals into clay by chemical weathering."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/berrocal","prefLabel":{"es":"berrocal","en":"boulder field; tor field"},"definition":{"es":"Zona con abundantes bolos graníticos residuales.","en":"An area with abundant residual granite boulders."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/bolos","prefLabel":{"es":"bolos","en":"boulders; corestones"},"definition":{"es":"Bloques redondeados residuales producidos por meteorización esferoidal.","en":"Rounded residual blocks produced by spheroidal weathering."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canyon-garganta-desfiladero","prefLabel":{"es":"cañón; garganta; desfiladero","en":"canyon; gorge"},"definition":{"es":"Valle muy profundo y estrecho con paredes verticales en terreno kárstico.","en":"A very deep and narrow valley with vertical walls in karst terrain."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/caolinizaciones","prefLabel":{"es":"caolinizaciones","en":"kaolinization"},"definition":{"es":"Transformación de feldespatos en minerales del grupo de la caolinita.","en":"Transformation of feldspars into kaolinite group minerals."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/carbonataciones","prefLabel":{"es":"carbonataciones","en":"carbonation"},"definition":{"es":"Formación de costras o acumulaciones de carbonato por precipitación.","en":"Formation of carbonate crusts or accumulations by precipitation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-ruiniforme","prefLabel":{"es":"cerro ruiniforme; caos de bloques","en":"ruiniform hill; block chaos"},"definition":{"es":"Relieve con aspecto de ruinas por meteorización y desmantelamiento.","en":"Relief with a ruin-like appearance due to weathering and dismantling."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-ruiniforme-caos-de-bloques","prefLabel":{"es":"cerro ruiniforme poligenetico","en":"ruiniform hill; block chaos"},"altLabel":{"es":["caos de bloques"]},"definition":{"es":"Relieve con aspecto de ruinas por meteorización y desmantelamiento.","en":"Relief with a ruin-like appearance due to weathering and dismantling."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cueva","prefLabel":{"es":"cueva","en":"cave"},"definition":{"es":"Cavidad subterránea natural de origen kárstico.","en":"A natural underground cavity of karst origin."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina","prefLabel":{"es":"dolina","en":"doline; sinkhole"},"definition":{"es":"Depresión cerrada de planta circular o elíptica formada por disolución kárstica.","en":"A closed depression of circular or elliptical plan formed by karst dissolution."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina-capturada","prefLabel":{"es":"dolina capturada","en":"captured doline"},"definition":{"es":"Dolina conectada al drenaje superficial por captura.","en":"A doline connected to surface drainage by capture."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina-con-borde-difuso","prefLabel":{"es":"dolina con borde difuso","en":"doline with diffuse rim"},"definition":{"es":"Dolina cuyo borde ha sido suavizado por erosión.","en":"A doline whose rim has been smoothed by erosion."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina-con-fondo-plano","prefLabel":{"es":"dolina con fondo plano","en":"flat-bottomed doline"},"definition":{"es":"Dolina con fondo horizontal ocupado generalmente por arcillas de descalcificación.","en":"A doline with a horizontal bottom generally occupied by decalcification clays."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina-de-hundimiento-o-dolina-en-ventana","prefLabel":{"es":"dolina de hundimiento o dolina en ventana","en":"collapse doline; window doline"},"definition":{"es":"Dolina formada por colapso del techo de una cavidad subterránea.","en":"A doline formed by collapse of the roof of an underground cavity."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina-de-karst-cubierto-dolina-aluvial","prefLabel":{"es":"dolina de karst cubierto; dolina aluvial","en":"covered karst doline; alluvial doline"},"definition":{"es":"Dolina formada en materiales que recubren el karst subyacente.","en":"A doline formed in materials covering the underlying karst."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/dolina-en-embudo","prefLabel":{"es":"dolina en embudo","en":"funnel-shaped doline"},"definition":{"es":"Dolina con forma de embudo y paredes inclinadas convergentes.","en":"A funnel-shaped doline with converging inclined walls."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/pequenya-dolina","prefLabel":{"es":"pequeña dolina","en":"small doline"},"definition":{"es":"Dolina de dimensiones reducidas.","en":"A doline of small dimensions."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-pequenyas-dolinas","prefLabel":{"es":"campo de pequeñas dolinas","en":"small doline field"},"definition":{"es":"Zona con alta densidad de dolinas de pequeño tamaño.","en":"An area with a high density of small dolines."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo-y-dorso-de-ballena","prefLabel":{"es":"domo y dorso de ballena","en":"dome and whaleback"},"definition":{"es":"Forma redondeada en roca desnuda producida por meteorización.","en":"A rounded form in bare rock produced by weathering."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ferruginizaciones-rubefacciones","prefLabel":{"es":"ferruginizaciones; rubefacciones","en":"ferruginization; rubefaction"},"definition":{"es":"Enriquecimiento en óxidos de hierro que da coloración rojiza a la roca o suelo.","en":"Iron oxide enrichment giving a reddish coloration to rock or soil."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/lapiaz","prefLabel":{"es":"lapiaz","en":"karren; lapiaz"},"definition":{"es":"Formas de disolución en la superficie de rocas calcáreas.","en":"Dissolution forms on the surface of calcareous rocks."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-lapiaces","prefLabel":{"es":"campo de lapiaces","en":"karren field"},"definition":{"es":"Zona con desarrollo extenso de lapiaces.","en":"An area with extensive karren development."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/lapiaz-cubierto","prefLabel":{"es":"lapiaz cubierto","en":"covered karren"},"definition":{"es":"Lapiaz totalmente cubierto por suelo, visible solo en corte.","en":"Karren totally covered by soil, visible only in cross section."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/lapiaz-semicubierto","prefLabel":{"es":"lapiaz semicubierto","en":"semi-covered karren"},"definition":{"es":"Lapiaz parcialmente cubierto por suelo o vegetación.","en":"Karren partially covered by soil or vegetation."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/limite-de-alveolo-de-alteracion-nava","prefLabel":{"es":"límite de alveolo de alteración; nava","en":"weathering depression limit; nava"},"definition":{"es":"Límite de una depresión cerrada formada por meteorización química intensa.","en":"Limit of a closed depression formed by intense chemical weathering."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/limite-de-area-con-intensa-karstificacion","prefLabel":{"es":"límite de área con intensa karstificación","en":"intensely karstified area limit"},"definition":{"es":"Límite de una zona con desarrollo kárstico muy avanzado.","en":"Limit of a zone with very advanced karst development."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/limite-de-cuenca-endorreica-de-origen-karstico","prefLabel":{"es":"límite de cuenca endorreica de origen kárstico","en":"karst endorheic basin limit"},"definition":{"es":"Límite de una cuenca sin drenaje externo originada por procesos kársticos.","en":"Limit of a basin without external drainage originated by karst processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/limite-de-paleopolje","prefLabel":{"es":"límite de paleopolje","en":"palaeo-polje limit"},"definition":{"es":"Límite de un antiguo polje ya no funcional.","en":"Limit of a former polje no longer functional."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/limite-de-polje-funcional","prefLabel":{"es":"límite de polje funcional","en":"functional polje limit"},"definition":{"es":"Límite de un polje actualmente funcional con drenaje kárstico.","en":"Limit of a currently functional polje with karst drainage."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/meteorizacion-en-general","prefLabel":{"es":"meteorización en general","en":"weathering (general)"},"definition":{"es":"Procesos de alteración de la roca por agentes atmosféricos y químicos.","en":"Rock alteration processes by atmospheric and chemical agents."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/microformas-de-alteracion","prefLabel":{"es":"microformas de alteración","en":"weathering microforms"},"definition":{"es":"Formas de pequeña escala producidas por meteorización en superficies rocosas.","en":"Small-scale forms produced by weathering on rock surfaces."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ponor","prefLabel":{"es":"ponor","en":"ponor"},"definition":{"es":"Abertura en la roca por donde el agua de un polje o depresión kárstica drena al subsuelo.","en":"An opening in rock through which water from a polje or karst depression drains underground."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/puente-o-tunel-natural","prefLabel":{"es":"puente o túnel natural","en":"natural bridge or tunnel"},"definition":{"es":"Arco o túnel natural en roca formado por disolución kárstica o erosión.","en":"A natural arch or tunnel in rock formed by karst dissolution or erosion."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/relieve-karstico-hum","prefLabel":{"es":"relieve kárstico; hum","en":"karst relief; hum"},"definition":{"es":"Relieve residual positivo en un paisaje kárstico.","en":"Positive residual relief in a karst landscape."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/roca-aislada-pinaculo-rocoso-tor","prefLabel":{"es":"roca aislada; pináculo rocoso; tor","en":"tor; isolated rock pillar"},"definition":{"es":"Relieve residual aislado formado por meteorización diferencial.","en":"An isolated residual relief formed by differential weathering."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/sales","prefLabel":{"es":"sales","en":"salt deposits"},"definition":{"es":"Acumulaciones de sales en superficie por evaporación.","en":"Surface salt accumulations by evaporation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/silicificaciones","prefLabel":{"es":"silicificaciones","en":"silicification"},"definition":{"es":"Reemplazamiento por sílice de los minerales originales de la roca.","en":"Replacement of original rock minerals by silica."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/sima","prefLabel":{"es":"sima","en":"pothole; shaft"},"definition":{"es":"Cavidad vertical profunda en terreno kárstico.","en":"A deep vertical cavity in karst terrain."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/sumidero","prefLabel":{"es":"sumidero","en":"swallow hole; sinkhole"},"definition":{"es":"Punto donde un curso de agua superficial desaparece en el subsuelo kárstico.","en":"Point where a surface watercourse disappears into the karst underground."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/surgencia","prefLabel":{"es":"surgencia","en":"karst spring; resurgence"},"definition":{"es":"Punto de salida de aguas subterráneas kársticas a la superficie.","en":"Emergence point of karst groundwater at the surface."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/tafoni","prefLabel":{"es":"tafoni","en":"tafoni"},"definition":{"es":"Cavidades de meteorización en superficies rocosas.","en":"Weathering cavities on rock surfaces."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/toba-travertino","prefLabel":{"es":"toba; travertino","en":"tufa; travertine"},"definition":{"es":"Depósito de carbonato cálcico precipitado por aguas ricas en CO2.","en":"Calcium carbonate deposit precipitated by CO2-rich waters."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/toba-masa-travertinica","prefLabel":{"es":"toba; masa travertínica","en":"tufa; travertine mass"},"definition":{"es":"Masa o edificio de travertino de dimensiones significativas.","en":"A travertine mass or edifice of significant dimensions."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/uvala","prefLabel":{"es":"uvala","en":"uvala"},"definition":{"es":"Depresión kárstica de mayor tamaño formada por coalescencia de varias dolinas.","en":"A larger karst depression formed by coalescence of several dolines."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/valle-ciego","prefLabel":{"es":"valle ciego","en":"blind valley"},"definition":{"es":"Valle fluvial que termina bruscamente en un sumidero kárstico.","en":"A fluvial valley that ends abruptly at a karst sinkhole."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales","prefLabel":{"es":"objetos glaciales, glaciofluviales, glaciolacustres y glaciomarinos","en":"glacial, glaciofluvial, glaciolacustrine and glaciomarine features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relativos a entornos glaciales, glaciofluviales, glaciolacustres y glaciomarinos.","en":"Geomorphologic landscapes and landforms related to to glacial, glaciofluvial, glaciolacustrine and glaciomarine environments."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-glaciales-fluvioglaciares-y-de-permafrost","prefLabel":{"es":"objetos glaciales, fluvioglaciares y de permafrost","en":"nival, periglacial and permafrost features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relativos a entornos de clima frío, con nieve, pero no glaciales; paisajes geomorfológicos y formas de relieve próximos a glaciares y placas de hielo; paisajes geomorfológicos y formas del relieve relativos a tierras, suelos o rocas que se mantienen a 0º C o menos durante dos años como mínimo.","en":"Geomorphologic landscapes and landforms related to snow, non-glacial, cold climate environments; geomorphologic landscapes and landforms occurring in the vicinity of glaciers and ice sheets; geomorphologic landscapes and landforms related to ground, soil, or rock that remains at or below 0º C for at least two years."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-hidrotermales","prefLabel":{"es":"objetos hidrotermales","en":"hydrothermal features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relacionados con procesos hidrotermales.","en":"Geomorphologic landscapes and landforms related to hydrothermal processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-lacustres","prefLabel":{"es":"objetos lacustres","en":"lacustrine features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relacionados con masas de agua interiores permanentes (lagos).","en":"Geomorphologic landscapes and landforms related to inland permanent water bodies (lakes)."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/area-endorreica-con-salinizacion-superficial-playa-salina","prefLabel":{"es":"área endorreica con salinización superficial; playa salina","en":"salt flat; saline playa"},"definition":{"es":"Área endorréica con precipitación de sales en superficie.","en":"An endorheic area with surface salt precipitation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/area-endorreica-playa-encharcamiento-temporal","prefLabel":{"es":"área endorréica; playa; encharcamiento temporal","en":"endorheic area; playa"},"definition":{"es":"Zona sin drenaje externo donde el agua se acumula temporalmente.","en":"An area without external drainage where water accumulates temporarily."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/area-pantanosa","prefLabel":{"es":"área pantanosa","en":"marshy area"},"definition":{"es":"Zona con suelo permanentemente saturado de agua.","en":"An area with permanently waterlogged soil."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/charca-labajo-bodon-estacional","prefLabel":{"es":"charca; labajo; bodón estacional","en":"seasonal pond"},"definition":{"es":"Pequeña masa de agua estancada de carácter estacional.","en":"A small seasonal body of standing water."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/charca-labajo-bodon-permanente","prefLabel":{"es":"charca; labajo; bodón permanente","en":"permanent pond"},"definition":{"es":"Pequeña masa de agua estancada de carácter permanente.","en":"A small permanent body of standing water."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe","prefLabel":{"es":"escarpe","en":"scarp"},"definition":{"es":"Talud abrupto de origen poligénico.","en":"An abrupt slope of polygenetic origin."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-fosil","prefLabel":{"es":"escarpe fosil","en":"fossil scarp"},"definition":{"es":"Escarpe lacustre que ya no está en contacto con una masa de agua.","en":"A lacustrine scarp no longer in contact with a water body."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpeescarpe-en-ambiente-lacustre","prefLabel":{"es":"escarpe en ambiente lacustre","en":"scarp"},"definition":{"es":"Talud abrupto de origen poligénico.","en":"An abrupt slope of polygenetic origin."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna","prefLabel":{"es":"laguna","en":"lagoon; small lake"},"definition":{"es":"Masa de agua de pequeña extensión y poca profundidad.","en":"A water body of small extent and shallow depth."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna-colmatada-o-desecada","prefLabel":{"es":"laguna colmatada o desecada","en":"infilled or desiccated lagoon"},"definition":{"es":"Laguna rellenada por sedimentos o desecada.","en":"A lagoon filled with sediments or desiccated."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna-estacional","prefLabel":{"es":"laguna estacional","en":"seasonal lagoon"},"definition":{"es":"Laguna que se seca en determinadas épocas del año.","en":"A lagoon that dries up during certain times of the year."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/laguna-permanente","prefLabel":{"es":"laguna permanente","en":"permanent lagoon"},"definition":{"es":"Laguna con agua durante todo el año.","en":"A lagoon with water throughout the year."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/limite-de-cuenca-endorreica","prefLabel":{"es":"límite de cuenca endorréica","en":"endorheic basin limit"},"definition":{"es":"Divisoria que delimita una cuenca sin drenaje al mar.","en":"Divide delimiting a basin without drainage to the sea."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ojos-de-agua","prefLabel":{"es":"ojos de agua","en":"water eyes; springs"},"definition":{"es":"Surgencias puntuales de agua subterránea.","en":"Point emergences of groundwater."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/reborde-de-terraza-con-indicacion-de-cota-en-metros","prefLabel":{"es":"reborde de terraza con indicación de cota en metros","en":"terrace edge with elevation in metres"},"definition":{"es":"Borde de una terraza lacustre con indicación de su cota.","en":"Edge of a lacustrine terrace with elevation indication."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza-lacustre","prefLabel":{"es":"terraza lacustre","en":"lacustrine terrace"},"definition":{"es":"Superficie plana elevada que representa un antiguo nivel de un lago.","en":"An elevated flat surface representing a former lake level."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/turbera","prefLabel":{"es":"turbera","en":"peat bog"},"definition":{"es":"Zona pantanosa con acumulación de materia orgánica parcialmente descompuesta (turba).","en":"Marshy area with accumulation of partially decomposed organic matter (peat)."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/turbera-en-ambiente-lacustre","prefLabel":{"es":"turbera en ambiente lacustre","en":"peat bog"},"definition":{"es":"Zona pantanosa con acumulación de materia orgánica parcialmente descompuesta (turba).","en":"Marshy area with accumulation of partially decomposed organic matter (peat)."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-marinos-litorales-y-de-humedales-costeros","prefLabel":{"es":"objetos marinos, litorales y de humedales costeros","en":"marine, littoral and coastal wetlands features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relativos a la dinámica del oleaje y de las mareas desarrollada en entornos marinos, de aguas poco profundas, cercanos a la costa y litorales, y relativos a humedales con vegetación y poco profundos.","en":"Geomorphologic landscapes and landforms related to wave or tidal dynamics developed in marine, shallow marine, near-shore and littoral zone environments, and those related to vegetated and / or shallow wet areas"},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/abanico-de-arena-washover-fan","prefLabel":{"es":"abanico de arena; washover fan","en":"washover fan"},"definition":{"es":"Depósito en abanico de arena transportada por olas de tormenta sobre un cordón litoral.","en":"Fan-shaped sand deposit transported by storm waves over a beach ridge."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado","prefLabel":{"es":"acantilado","en":"cliff"},"definition":{"es":"Escarpe vertical o subvertical costero tallado por erosión marina.","en":"A vertical or subvertical coastal scarp carved by marine erosion."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-entre-25-y-100-metros","prefLabel":{"es":"acantilado entre 25 y 100 metros","en":"cliff 25-100 m"},"definition":{"es":"Acantilado costero de entre 25 y 100 metros de altura.","en":"A coastal cliff between 25 and 100 metres high."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-fosil","prefLabel":{"es":"acantilado fósil","en":"fossil cliff"},"definition":{"es":"Acantilado relicto separado de la línea de costa actual.","en":"A relict cliff separated from the current coastline."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-inferior-a-25-metros","prefLabel":{"es":"acantilado inferior a 25 metros","en":"cliff less than 25 m"},"definition":{"es":"Acantilado costero de menos de 25 metros de altura.","en":"A coastal cliff less than 25 metres high."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acantilado-superior-a-100-metros","prefLabel":{"es":"acantilado superior a 100 metros","en":"cliff over 100 m"},"definition":{"es":"Acantilado costero de más de 100 metros de altura.","en":"A coastal cliff over 100 metres high."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/albardon-natural-dique-levee","prefLabel":{"es":"albardón natural; dique; levée","en":"natural levee"},"definition":{"es":"Elevación alargada en las márgenes de un cauce deltaico.","en":"An elongated elevation along the margins of a deltaic channel."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/albufera-laguna-costera-lagoon","prefLabel":{"es":"albufera; laguna costera; lagoon","en":"coastal lagoon"},"definition":{"es":"Masa de agua somera separada del mar por un cordón litoral.","en":"Shallow water body separated from the sea by a beach ridge."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/albufera-colmatada-o-desecada","prefLabel":{"es":"albufera colmatada o desecada","en":"infilled or desiccated coastal lagoon"},"definition":{"es":"Albufera rellenada por sedimentos o desecada.","en":"A coastal lagoon filled with sediments or desiccated."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/banco-barra-fluvial","prefLabel":{"es":"banco; barra fluvial","en":"fluvial bank; bar"},"definition":{"es":"Acumulación de sedimentos en un cauce fluvial deltaico.","en":"Sediment accumulation in a deltaic river channel."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/barra-de-arena","prefLabel":{"es":"barra de arena","en":"sand bar"},"definition":{"es":"Acumulación alargada de arena sumergida o parcialmente emergida.","en":"An elongated sand accumulation submerged or partially emerged."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/barra-sumergida","prefLabel":{"es":"barra sumergida","en":"submerged bar"},"definition":{"es":"Acumulación de sedimentos bajo el agua.","en":"An underwater sediment accumulation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/boca-de-albufera-grao","prefLabel":{"es":"boca de albufera; grao","en":"lagoon inlet"},"definition":{"es":"Abertura de comunicación entre una albufera y el mar.","en":"Opening connecting a coastal lagoon with the sea."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/borde-de-terraza-con-indicacion-de-cota-en-metros","prefLabel":{"es":"borde de terraza con indicación de cota en metros","en":"terrace edge with elevation in metres"},"definition":{"es":"Borde de una terraza litoral con indicación de su cota sobre el nivel del mar.","en":"Edge of a coastal terrace with indication of its elevation above sea level."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/brazo-fluvial","prefLabel":{"es":"brazo fluvial","en":"distributary channel"},"definition":{"es":"Canal de distribución en un delta.","en":"A distribution channel in a delta."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/brazo-fluvial-abandonado","prefLabel":{"es":"brazo fluvial abandonado","en":"abandoned distributary channel"},"definition":{"es":"Canal de distribución deltaico ya no funcional.","en":"A deltaic distribution channel no longer functional."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/brazo-fluvial-abandonado-inundado-temporalmente","prefLabel":{"es":"brazo fluvial abandonado inundado temporalmente","en":"temporarily flooded abandoned distributary"},"definition":{"es":"Canal deltaico abandonado que se inunda temporalmente.","en":"An abandoned deltaic channel that is temporarily flooded."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/brazo-fluvial-con-flujo-de-marea","prefLabel":{"es":"brazo fluvial con flujo de marea","en":"tidal distributary channel"},"definition":{"es":"Canal de distribución deltaico afectado por mareas.","en":"A deltaic distribution channel affected by tides."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canal-de-marea","prefLabel":{"es":"canal de marea","en":"tidal channel"},"definition":{"es":"Canal excavado por las corrientes de marea.","en":"A channel carved by tidal currents."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canal-de-marea-abandonado","prefLabel":{"es":"canal de marea abandonado","en":"abandoned tidal channel"},"definition":{"es":"Canal de marea que ya no es funcional.","en":"A tidal channel that is no longer functional."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canal-de-marea-sumergido","prefLabel":{"es":"canal de marea sumergido","en":"submerged tidal channel"},"definition":{"es":"Canal de marea permanentemente bajo el agua.","en":"A tidal channel permanently underwater."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/construcciones-biogenicas","prefLabel":{"es":"construcciones biogénicas","en":"biogenic constructions"},"definition":{"es":"Estructuras construidas por organismos marinos como arrecifes de coral.","en":"Structures built by marine organisms such as coral reefs."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cordon-litoral","prefLabel":{"es":"cordón litoral","en":"beach ridge; barrier"},"definition":{"es":"Cresta alargada de sedimentos paralela a la costa.","en":"An elongated sediment ridge parallel to the coast."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/delta","prefLabel":{"es":"delta","en":"delta"},"definition":{"es":"Depósito sedimentario en la desembocadura de un río.","en":"A sedimentary deposit at the mouth of a river."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/delta-sumergido-de-flujo","prefLabel":{"es":"delta sumergido; de flujo","en":"submerged delta; flow delta"},"definition":{"es":"Parte del delta situada bajo el nivel del agua.","en":"Part of the delta located below water level."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/frente-deltaico","prefLabel":{"es":"frente deltaico","en":"delta front"},"definition":{"es":"Zona frontal de un delta en contacto con el mar.","en":"The frontal zone of a delta in contact with the sea."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/llanura-deltaica","prefLabel":{"es":"llanura deltaica","en":"delta plain"},"definition":{"es":"Superficie plana de un delta emergido.","en":"The flat surface of an emerged delta."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/deriva-litoral","prefLabel":{"es":"deriva litoral","en":"longshore drift"},"definition":{"es":"Transporte de sedimentos a lo largo de la costa por corrientes litorales.","en":"Sediment transport along the coast by longshore currents."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/derrame-delta-de-ruptura-de-mota","prefLabel":{"es":"derrame; delta de ruptura de mota","en":"crevasse splay"},"definition":{"es":"Depósito formado por la rotura del dique natural en un delta.","en":"Deposit formed by the breach of a natural levee in a delta."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/direccion-del-viento-dominante","prefLabel":{"es":"dirección del viento dominante","en":"prevailing wind direction"},"definition":{"es":"Dirección predominante del viento en la zona litoral.","en":"Predominant wind direction in the coastal area."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/estuario-marisma","prefLabel":{"es":"estuario; marisma","en":"estuary; salt marsh"},"definition":{"es":"Desembocadura de un río donde se mezclan aguas dulces y saladas.","en":"River mouth where fresh and salt water mix."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/flecha-litoral","prefLabel":{"es":"flecha litoral","en":"spit"},"definition":{"es":"Lengua de arena que se extiende desde la costa hacia el mar.","en":"A tongue of sand extending from the coast towards the sea."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/llanura-de-marea","prefLabel":{"es":"llanura de marea","en":"tidal flat"},"definition":{"es":"Superficie plana inundada periódicamente por las mareas.","en":"A flat surface periodically flooded by tides."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/llanura-de-marea-arenosa","prefLabel":{"es":"llanura de marea arenosa","en":"sandy tidal flat"},"definition":{"es":"Llanura de marea con substrato arenoso.","en":"A tidal flat with a sandy substrate."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/marisma-alta-schorre","prefLabel":{"es":"marisma alta; schorre","en":"high marsh; schorre"},"definition":{"es":"Zona de marisma solo inundada en mareas vivas.","en":"Marsh zone only flooded during spring tides."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/marisma-baja-slikke","prefLabel":{"es":"marisma baja; slikke","en":"low marsh; slikke"},"definition":{"es":"Zona de marisma inundada en cada marea.","en":"Marsh zone flooded at each tide."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/marisma-baja-arenosa","prefLabel":{"es":"marisma baja arenosa","en":"sandy low marsh"},"definition":{"es":"Marisma baja con substrato arenoso.","en":"Low marsh with a sandy substrate."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/plataforma-de-abrasion-rasa","prefLabel":{"es":"plataforma de abrasión; rasa","en":"wave-cut platform; strandflat"},"definition":{"es":"Superficie rocosa plana tallada por la erosión marina.","en":"A flat rock surface carved by marine erosion."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/plataforma-de-abrasion-degradada","prefLabel":{"es":"plataforma de abrasión degradada","en":"degraded wave-cut platform"},"definition":{"es":"Plataforma de abrasión cuya superficie ha sido modificada por meteorización.","en":"A wave-cut platform whose surface has been modified by weathering."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/playa","prefLabel":{"es":"playa","en":"beach"},"definition":{"es":"Acumulación de sedimentos en la zona litoral.","en":"Sediment accumulation in the coastal zone."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/playa-de-arena","prefLabel":{"es":"playa de arena","en":"sand beach"},"definition":{"es":"Playa constituida principalmente por arena.","en":"A beach mainly composed of sand."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/playa-de-cantos-o-bloques","prefLabel":{"es":"playa de cantos o bloques","en":"pebble or boulder beach"},"definition":{"es":"Playa constituida principalmente por cantos rodados o bloques.","en":"A beach mainly composed of pebbles or boulders."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/playa-fangosa","prefLabel":{"es":"playa fangosa","en":"muddy beach"},"definition":{"es":"Playa constituida principalmente por fango.","en":"A beach mainly composed of mud."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/playa-fosil","prefLabel":{"es":"playa fósil","en":"fossil beach"},"definition":{"es":"Playa relicta elevada respecto al nivel del mar actual.","en":"A relict beach elevated above the current sea level."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/surcos-lineas-de-crecimiento-del-cordon-litoral","prefLabel":{"es":"surcos; líneas de crecimiento del cordón litoral","en":"beach ridge growth lines"},"definition":{"es":"Marcas que indican las fases de crecimiento de un cordón litoral.","en":"Marks indicating the growth phases of a beach ridge."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza","prefLabel":{"es":"terraza","en":"terrace"},"definition":{"es":"Superficie plana elevada respecto al cauce actual, que representa un antiguo nivel del río.","en":"A flat surface elevated above the current channel, representing a former river level."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza-erosiva","prefLabel":{"es":"terraza erosiva","en":"erosional terrace"},"definition":{"es":"Terraza tallada en la roca sin depósito aluvial significativo.","en":"A terrace carved into rock without significant alluvial deposit."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza-no-ciclica-de-encajamiento-convergente","prefLabel":{"es":"terraza no cíclica (de encajamiento; convergente)","en":"non-cyclic terrace (entrenching; convergent)"},"definition":{"es":"Terraza formada por encajamiento progresivo sin relación con ciclos climáticos.","en":"Terrace formed by progressive entrenchment without relation to climatic cycles."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza-travertinica","prefLabel":{"es":"terraza travertínica","en":"travertine terrace"},"definition":{"es":"Terraza formada por precipitación de carbonato cálcico (travertino).","en":"Terrace formed by calcium carbonate (travertine) precipitation."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terraza-litoral","prefLabel":{"es":"terraza litoral","en":"terrace"},"definition":{"es":"Superficie plana elevada respecto al cauce actual, que representa un antiguo nivel del río.","en":"A flat surface elevated above the current channel, representing a former river level."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/turbera","prefLabel":{"es":"turbera","en":"peat bog"},"definition":{"es":"Zona pantanosa con acumulación de materia orgánica parcialmente descompuesta (turba).","en":"Marshy area with accumulation of partially decomposed organic matter (peat)."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/zona-de-rompiente-zona-intermareal","prefLabel":{"es":"zona de rompiente; zona intermareal","en":"surf zone; intertidal zone"},"definition":{"es":"Franja litoral entre los niveles de marea alta y baja.","en":"Coastal strip between high and low tide levels."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-relacionados-con-las-laderas-y-con-la-gravedad","prefLabel":{"es":"objetos relacionados con las laderas y con la gravedad","en":"slope and gravitational features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relacionados con entornos de ladera; paisajes geomorfológicos y formas de relieve desarrollados por efecto de la acción de la gravedad.","en":"Geomorphologic landscapes and landforms related to slope environments; geomorphologic landscapes and landforms developed under the action of the gravitational force."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/acarcavamiento-embrionario","prefLabel":{"es":"acarcavamiento embrionario","en":"incipient gullying"},"definition":{"es":"Fase inicial de formación de cárcavas en una vertiente.","en":"Initial phase of gully formation on a slope."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/caidas-de-bloques-desprendimientos-derrumbes","prefLabel":{"es":"caídas de bloques; desprendimientos; derrumbes","en":"rockfall; rock collapse"},"definition":{"es":"Desprendimiento de bloques rocosos de un escarpe o pared.","en":"Detachment of rock blocks from a scarp or wall."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cambio-brusco-de-pendiente","prefLabel":{"es":"cambio brusco de pendiente","en":"abrupt slope break"},"definition":{"es":"Cambio repentino del ángulo de la pendiente en una vertiente.","en":"A sudden change in slope angle on a hillside."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/canchal-pedriza","prefLabel":{"es":"canchal; pedriza","en":"scree; block field"},"definition":{"es":"Acumulación de fragmentos rocosos angulosos en una ladera.","en":"Accumulation of angular rock fragments on a slope."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cicatriz-de-despegue-producida-por-movimientos-en-masa","prefLabel":{"es":"cicatriz de despegue producida por movimientos en masa","en":"mass movement detachment scar"},"definition":{"es":"Superficie de rotura visible en la zona de arranque de un movimiento en masa.","en":"Visible rupture surface at the head zone of a mass movement."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/coluvion","prefLabel":{"es":"coluvión","en":"colluvium"},"definition":{"es":"Depósito de materiales sueltos acumulados al pie de una ladera por gravedad.","en":"A deposit of loose materials accumulated at the foot of a slope by gravity."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cono-o-talud-de-derrubios","prefLabel":{"es":"cono o talud de derrubios","en":"talus cone; scree slope"},"definition":{"es":"Acumulación de fragmentos rocosos al pie de una pared o escarpe formando un cono o talud.","en":"Accumulation of rock fragments at the foot of a wall or scarp forming a cone or talus."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/derrubios-ordenados","prefLabel":{"es":"derrubios ordenados","en":"stratified slope deposits"},"definition":{"es":"Depósitos de ladera con cierta ordenación o estratificación.","en":"Slope deposits with some ordering or stratification."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/derrumbe-avalancha","prefLabel":{"es":"derrumbe; avalancha","en":"rock avalanche"},"definition":{"es":"Movimiento rápido y masivo de rocas y derrubios ladera abajo.","en":"Rapid and massive downslope movement of rocks and debris."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/deslizamiento","prefLabel":{"es":"deslizamiento","en":"landslide"},"definition":{"es":"Movimiento en masa de materiales ladera abajo a lo largo de una superficie de rotura.","en":"Downslope mass movement of materials along a failure surface."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/deslizamiento-cartografiable","prefLabel":{"es":"deslizamiento cartografiable","en":"mappable landslide"},"definition":{"es":"Deslizamiento de dimensiones suficientes para ser representado en un mapa.","en":"A landslide of sufficient dimensions to be represented on a map."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/facetas-triangulares-de-vertiente","prefLabel":{"es":"facetas triangulares de vertiente","en":"triangular slope facets"},"definition":{"es":"Superficies triangulares en vertientes producidas por la intersección de valles transversales.","en":"Triangular surfaces on slopes produced by the intersection of transverse valleys."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/flujo","prefLabel":{"es":"flujo","en":"flow"},"definition":{"es":"Movimiento en masa con comportamiento de fluido viscoso.","en":"A mass movement with viscous fluid behavior."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ladera-con-reptacion","prefLabel":{"es":"ladera con reptación","en":"slope with creep"},"definition":{"es":"Vertiente afectada por movimiento lento y continuo del suelo o regolito.","en":"A slope affected by slow and continuous movement of soil or regolith."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/lajamiento-sheeting","prefLabel":{"es":"lajamiento; sheeting","en":"sheeting"},"definition":{"es":"Fracturación de la roca en láminas paralelas a la superficie topográfica.","en":"Rock fracturing into sheets parallel to the topographic surface."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/lobulo-o-colada-de-solifluxion","prefLabel":{"es":"lóbulo o colada de solifluxión","en":"solifluction lobe"},"definition":{"es":"Forma lobulada producida por solifluxión en una ladera.","en":"A lobe-shaped form produced by solifluction on a slope."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/terracillas","prefLabel":{"es":"terracillas","en":"terracettes"},"definition":{"es":"Pequeños escalones paralelos a las curvas de nivel en una ladera, producidos por reptación o pisoteo.","en":"Small steps parallel to contour lines on a slope, produced by creep or trampling."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/vertiente-con-bloques","prefLabel":{"es":"vertiente con bloques","en":"block-covered slope"},"definition":{"es":"Vertiente cubierta por bloques rocosos procedentes de la parte superior.","en":"A slope covered by rock blocks from the upper part."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/vertiente-con-surcos-de-erosion-rills","prefLabel":{"es":"vertiente con surcos de erosión (rills)","en":"slope with rills"},"definition":{"es":"Vertiente con pequeños surcos lineales formados por escorrentía superficial.","en":"A slope with small linear grooves formed by surface runoff."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/vertiente-regularizada","prefLabel":{"es":"vertiente regularizada","en":"regularized slope"},"definition":{"es":"Vertiente cuyo perfil ha sido suavizado por procesos de erosión y sedimentación.","en":"A slope whose profile has been smoothed by erosion and sedimentation processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/vertiente-regularizada-y-disectada","prefLabel":{"es":"vertiente regularizada y disectada","en":"regularized and dissected slope"},"definition":{"es":"Vertiente regularizada que ha sido posteriormente incidida por cauces.","en":"A regularized slope that has been subsequently incised by channels."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/zona-con-solifluxion","prefLabel":{"es":"zona con solifluxión","en":"solifluction zone"},"definition":{"es":"Área afectada por flujo lento del suelo saturado sobre un substrato helado o impermeable.","en":"Area affected by slow flow of saturated soil over a frozen or impermeable substrate."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-tectonicos-y-estructurales","prefLabel":{"es":"objetos tectónicos y estructurales","en":"tectonic and structural features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve resultantes de estructuras regionales o locales de roca o de movimientos tectónicos o corticales; asimismo, paisajes geomorfológicos y formas de relieve de origen tectónico o exhumados predominantemente por la erosión del agua, con exclusión de las corrientes canalizadas perennes (es decir, fluviales o glaciofluviales), o por la erosión eólica.","en":"Geomorphologic landscapes and landforms related to regional or local bedrock structures, or crustal movement; and geomorphologic landscapes and landforms related dominantly to water erosion but excluding perennial, channel flow (i.e. fluvial, glaciofluvial), or eolian erosion."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/alineacion-morfologica-con-control-estructural","prefLabel":{"es":"alineación morfológica con control estructural","en":"structurally controlled morphological alignment"},"definition":{"es":"Alineación de formas del relieve controlada por la estructura geológica subyacente.","en":"Alignment of relief forms controlled by the underlying geological structure."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/basculamiento","prefLabel":{"es":"basculamiento","en":"tilting"},"definition":{"es":"Inclinación de un bloque o superficie por movimientos tectónicos.","en":"Inclination of a block or surface due to tectonic movements."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-conico","prefLabel":{"es":"cerro cónico","en":"conical hill"},"definition":{"es":"Elevación del terreno de forma cónica.","en":"A conical terrain elevation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cresta-barra","prefLabel":{"es":"cresta; barra","en":"ridge; bar"},"definition":{"es":"Relieve positivo alargado y estrecho controlado por capas resistentes.","en":"Elongated and narrow positive relief controlled by resistant layers."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-contacto-diapirico","prefLabel":{"es":"escarpe de contacto diapírico","en":"diapiric contact scarp"},"definition":{"es":"Escarpe topográfico originado en el contacto de un cuerpo diapírico con las rocas adyacentes.","en":"A topographic scarp formed at the contact of a diapiric body with adjacent rocks."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-contacto-intrusivo","prefLabel":{"es":"escarpe de contacto intrusivo","en":"intrusive contact scarp"},"definition":{"es":"Escarpe topográfico originado en el contacto entre una roca intrusiva y la roca encajante.","en":"A topographic scarp formed at the contact between an intrusive rock and the host rock."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla","prefLabel":{"es":"escarpe de línea de falla","en":"fault-line scarp"},"definition":{"es":"Escarpe topográfico coincidente con el trazado de una falla.","en":"A topographic scarp coinciding with the trace of a fault."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-degradado","prefLabel":{"es":"escarpe de línea de falla degradado","en":"degraded fault-line scarp"},"definition":{"es":"Escarpe de falla cuya morfología ha sido suavizada por procesos erosivos.","en":"A fault-line scarp whose morphology has been smoothed by erosional processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-en-retroceso","prefLabel":{"es":"escarpe de línea de falla en retroceso","en":"retreating fault-line scarp"},"definition":{"es":"Escarpe de falla cuya posición se desplaza progresivamente por retroceso erosivo.","en":"A fault-line scarp whose position progressively shifts due to erosional retreat."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-exhumado","prefLabel":{"es":"escarpe de línea de falla exhumado","en":"exhumed fault-line scarp"},"definition":{"es":"Escarpe de falla que ha sido re-expuesto tras haber estado cubierto por materiales más recientes.","en":"A fault-line scarp re-exposed after having been covered by younger materials."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-inversa-o-cabalgamiento","prefLabel":{"es":"escarpe de línea de falla inversa o cabalgamiento","en":"reverse or thrust fault-line scarp"},"definition":{"es":"Escarpe topográfico asociado a una falla inversa o cabalgamiento.","en":"A topographic scarp associated with a reverse or thrust fault."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-de-linea-de-falla-originado-por-erosion-diferencial","prefLabel":{"es":"escarpe de línea de falla originado por erosión diferencial","en":"differential erosion fault-line scarp"},"definition":{"es":"Escarpe resultante de la erosión diferencial a lo largo de una línea de falla.","en":"A scarp resulting from differential erosion along a fault line."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural","prefLabel":{"es":"escarpe estructural","en":"structural scarp"},"definition":{"es":"Escarpe topográfico controlado por la disposición de las capas geológicas.","en":"A topographic scarp controlled by the arrangement of geological layers."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural-en-capas-horizontales-entre-25-100-metros","prefLabel":{"es":"escarpe estructural en capas horizontales (entre 25-100 metros)","en":"structural scarp in horizontal layers (25-100 m)"},"definition":{"es":"Escarpe de 25 a 100 m de altura en capas horizontales.","en":"A scarp 25 to 100 m high in horizontal layers."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural-en-capas-horizontales-inferior-a-25-metros","prefLabel":{"es":"escarpe estructural en capas horizontales (inferior a 25 metros)","en":"structural scarp in horizontal layers (<25 m)"},"definition":{"es":"Escarpe de menos de 25 m de altura en capas horizontales.","en":"A scarp less than 25 m high in horizontal layers."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural-en-capas-horizontales-superior-a-100-metros","prefLabel":{"es":"escarpe estructural en capas horizontales (superior a 100 metros)","en":"structural scarp in horizontal layers (>100 m)"},"definition":{"es":"Escarpe de más de 100 m de altura en capas horizontales.","en":"A scarp over 100 m high in horizontal layers."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural-en-capas-monoclinales-entre-25-100-metros-cuesta","prefLabel":{"es":"escarpe estructural en capas monoclinales (entre 25-100 metros); cuesta","en":"cuesta scarp (25-100 m)"},"definition":{"es":"Escarpe de 25 a 100 m en capas monoclinales formando una cuesta.","en":"A scarp 25 to 100 m in monoclinal layers forming a cuesta."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural-en-capas-monoclinales-inferior-a-25-metros-cuesta","prefLabel":{"es":"escarpe estructural en capas monoclinales (inferior a 25 metros); cuesta","en":"cuesta scarp (<25 m)"},"definition":{"es":"Escarpe de menos de 25 m en capas monoclinales formando una cuesta.","en":"A scarp less than 25 m in monoclinal layers forming a cuesta."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-estructural-en-capas-monoclinales-superior-a-100-metros-cuesta","prefLabel":{"es":"escarpe estructural en capas monoclinales (superior a 100 metros); cuesta","en":"cuesta scarp (>100 m)"},"definition":{"es":"Escarpe de más de 100 m en capas monoclinales formando una cuesta.","en":"A scarp over 100 m in monoclinal layers forming a cuesta."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/facetas-triangulares-de-escarpe-de-falla","prefLabel":{"es":"facetas triangulares de escarpe de falla","en":"triangular facets of fault scarp"},"definition":{"es":"Superficies triangulares en la ladera de un escarpe de falla producidas por la intersección de valles transversales.","en":"Triangular surfaces on the slope of a fault scarp produced by the intersection of transverse valleys."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla","prefLabel":{"es":"falla","en":"fault"},"definition":{"es":"Fractura o zona de fractura a lo largo de la cual ha habido desplazamiento de los bloques contiguos.","en":"A fracture or zone of fractures along which there has been displacement of the adjacent blocks."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla-en-direccion-desgarre","prefLabel":{"es":"falla en dirección; desgarre","en":"strike-slip fault"},"definition":{"es":"Falla en la que el desplazamiento es predominantemente horizontal y paralelo al rumbo de la falla.","en":"A fault in which the displacement is predominantly horizontal and parallel to the strike of the fault."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla-inversa-frente-de-cabalgamiento","prefLabel":{"es":"falla inversa; frente de cabalgamiento","en":"reverse fault; thrust front"},"definition":{"es":"Falla en la que el bloque superior se ha desplazado hacia arriba respecto al bloque inferior; cuando el ángulo es bajo se denomina cabalgamiento.","en":"A fault in which the hanging wall has moved upward relative to the footwall; when the angle is low it is called a thrust."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla-normal-con-indicacion-de-labio-hundido","prefLabel":{"es":"falla normal con indicación de labio hundido","en":"normal fault with downthrown side indication"},"definition":{"es":"Falla en la que el bloque superior se ha desplazado hacia abajo respecto al bloque inferior, con indicación del labio hundido.","en":"A fault in which the hanging wall has moved downward relative to the footwall, with indication of the downthrown side."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/falla-supuesta","prefLabel":{"es":"falla supuesta","en":"inferred fault"},"definition":{"es":"Falla cuya existencia se deduce de evidencias indirectas pero no se ha observado directamente.","en":"A fault whose existence is inferred from indirect evidence but has not been directly observed."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/flexion-monoclinal","prefLabel":{"es":"flexión monoclinal","en":"monoclinal flexure"},"definition":{"es":"Inflexión o cambio de buzamiento en capas que forman un relieve monoclinal.","en":"An inflection or change in dip in layers forming a monoclinal relief."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/frente-montanyoso-lineal","prefLabel":{"es":"frente montañoso lineal","en":"linear mountain front"},"definition":{"es":"Frente montañoso de trazado rectilíneo controlado por una falla o estructura tectónica.","en":"A mountain front with a rectilinear trace controlled by a fault or tectonic structure."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/linea-de-capa-con-indicacion-de-buzamiento","prefLabel":{"es":"línea de capa con indicación de buzamiento","en":"bedding trace with dip indication"},"definition":{"es":"Traza de una capa sedimentaria en superficie con indicación del ángulo de buzamiento.","en":"Trace of a sedimentary bed at the surface with indication of the dip angle."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/relieve-conforme-anticlinal-mont","prefLabel":{"es":"relieve conforme anticlinal; mont","en":"anticlinal conform relief; mont"},"definition":{"es":"Relieve positivo cuya morfología coincide con la forma de un anticlinal subyacente.","en":"Positive relief whose morphology coincides with the shape of an underlying anticline."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/relieve-conforme-sinclinal-val","prefLabel":{"es":"relieve conforme sinclinal; val","en":"synclinal conform relief; val"},"definition":{"es":"Relieve negativo cuya morfología coincide con la forma de un sinclinal subyacente.","en":"Negative relief whose morphology coincides with the shape of an underlying syncline."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/relieve-invertido","prefLabel":{"es":"relieve invertido","en":"inverted relief"},"definition":{"es":"Relieve en el que las formas topográficas son opuestas a la estructura geológica subyacente.","en":"Relief in which the topographic forms are opposite to the underlying geological structure."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/resalte-de-capas-subverticales","prefLabel":{"es":"resalte de capas subverticales","en":"ledge of subvertical layers"},"definition":{"es":"Saliente rocoso formado por capas subverticales resistentes.","en":"A rock ledge formed by resistant subvertical layers."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/resalte-de-diques","prefLabel":{"es":"resalte de diques","en":"dyke ridge"},"definition":{"es":"Resalte topográfico causado por erosión diferencial de un dique volcánico resistente.","en":"A topographic ridge caused by differential erosion of a resistant volcanic dyke."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/resalte-en-capas-horizontales","prefLabel":{"es":"resalte en capas horizontales","en":"ledge in horizontal layers"},"definition":{"es":"Saliente rocoso en capas horizontales que forma un escalón en la topografía.","en":"A rock ledge in horizontal layers forming a step in the topography."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/resalte-en-capas-inclinadas-chevrons","prefLabel":{"es":"resalte en capas inclinadas; chevrons","en":"inclined layer ledge; chevrons"},"definition":{"es":"Resalte topográfico en capas inclinadas que presenta formas en V o chevron.","en":"A topographic ledge in inclined layers displaying V-shapes or chevron patterns."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/rumbo-e-inclinacion-o-buzamiento","prefLabel":{"es":"rumbo e inclinación o buzamiento","en":"strike and dip"},"definition":{"es":"Representación de la orientación de una capa o estructura planar mediante su rumbo y buzamiento.","en":"Representation of the orientation of a bed or planar structure by its strike and dip."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-estructural-degradada","prefLabel":{"es":"superficie estructural degradada","en":"degraded structural surface"},"definition":{"es":"Superficie estructural cuya forma original ha sido modificada por procesos erosivos.","en":"A structural surface whose original form has been modified by erosional processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-estructural-exhumada","prefLabel":{"es":"superficie estructural (exhumada)","en":"exhumed structural surface"},"definition":{"es":"Superficie de un estrato resistente expuesta por erosión de los materiales suprayacentes.","en":"A resistant stratum surface exposed by erosion of overlying materials."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-subestructural-terminal","prefLabel":{"es":"superficie subestructural (terminal)","en":"substructural surface"},"definition":{"es":"Superficie erosiva desarrollada próxima y subparalela a un estrato resistente subyacente.","en":"An erosional surface developed close to and subparallel to an underlying resistant stratum."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/valle-de-fractura","prefLabel":{"es":"valle de fractura","en":"fracture valley"},"definition":{"es":"Valle excavado a favor de una zona de fractura o falla.","en":"A valley carved along a fracture zone or fault."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/zona-intensamente-fracturada","prefLabel":{"es":"zona intensamente fracturada","en":"intensely fractured zone"},"definition":{"es":"Zona con una densidad muy elevada de fracturas que condiciona la morfología del terreno.","en":"A zone with a very high density of fractures that conditions the terrain morphology."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/objetos-volcanicos","prefLabel":{"es":"objetos volcánicos","en":"volcanic features"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relativos a procesos ígneos en virtud de los cuales magma y gases asociados atraviesan la corteza y son expulsados sobre la superficie terrestre y a la atmósfera.","en":"Geomorphologic landscapes and landforms related to the deep seated (igneous) processes by which magma and associated gases rise through the crust and are extruded onto the earth's surface and into the atmosphere."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/bombas-bloques-erraticos","prefLabel":{"es":"bombas; bloques erráticos","en":"volcanic bombs; erratic blocks"},"definition":{"es":"Fragmentos de lava de gran tamaño expulsados durante una erupción volcánica.","en":"Large lava fragments expelled during a volcanic eruption."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/borde-de-caldera","prefLabel":{"es":"borde de caldera","en":"caldera rim"},"definition":{"es":"Borde topográfico que delimita una caldera volcánica.","en":"The topographic rim that delimits a volcanic caldera."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/borde-de-caldera-degradado","prefLabel":{"es":"borde de caldera degradado","en":"degraded caldera rim"},"definition":{"es":"Borde de caldera volcánica parcialmente destruido por erosión.","en":"A volcanic caldera rim partially destroyed by erosion."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/borde-de-crater-de-explosion-hidro-magmatica-con-anillo-de-toba-conservado","prefLabel":{"es":"borde de cráter de explosión hidro-magmática con anillo de toba conservado","en":"hydromagmatic explosion crater rim with preserved tuff ring"},"definition":{"es":"Borde de cráter de maar con anillo de tobas piroclásticas conservado.","en":"Maar crater rim with a preserved ring of pyroclastic tuffs."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/campo-de-cenizas","prefLabel":{"es":"campo de cenizas","en":"ash field"},"definition":{"es":"Zona cubierta por cenizas volcánicas.","en":"An area covered by volcanic ash."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/centro-de-emision","prefLabel":{"es":"centro de emisión","en":"emission centre"},"definition":{"es":"Punto o zona desde donde se produce la emisión de material volcánico.","en":"A point or zone from which volcanic material is emitted."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/chimenea","prefLabel":{"es":"chimenea","en":"volcanic chimney"},"definition":{"es":"Conducto vertical por el que asciende el magma hasta la superficie.","en":"A vertical conduit through which magma rises to the surface."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cicatriz-de-deslizamiento-inducido-por-actividad-volcanica","prefLabel":{"es":"cicatriz de deslizamiento inducido por actividad volcánica","en":"volcano-induced landslide scar"},"definition":{"es":"Cicatriz de un deslizamiento provocado por actividad volcánica.","en":"Scar of a landslide caused by volcanic activity."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-de-lava","prefLabel":{"es":"colada de lava","en":"lava flow"},"definition":{"es":"Masa de lava que fluye o ha fluido sobre la superficie del terreno.","en":"A mass of lava that flows or has flowed over the ground surface."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-de-lava-lineal-salideros-lavicos","prefLabel":{"es":"colada de lava lineal; salideros lávicos","en":"linear lava flow; lava outbreak"},"definition":{"es":"Colada de lava de morfología lineal o salida lateral de lava.","en":"A lava flow with linear morphology or lateral lava outbreak."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-de-lava-tipo-aa-con-bloques-y-escorias-malpais","prefLabel":{"es":"colada de lava tipo aa; con bloques y escorias; malpaís","en":"aa lava flow; malpais"},"definition":{"es":"Colada de lava de superficie rugosa con bloques y escorias.","en":"A lava flow with a rough surface of blocks and scoriae."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-de-lava-tipo-pahoehoe-lava-cordada","prefLabel":{"es":"colada de lava tipo pahoehoe; lava cordada","en":"pahoehoe lava flow; ropy lava"},"definition":{"es":"Colada de lava de superficie lisa con morfología cordada.","en":"A lava flow with a smooth surface and ropy morphology."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-masiva-con-superficie-lisa","prefLabel":{"es":"colada masiva con superficie lisa","en":"massive lava flow with smooth surface"},"definition":{"es":"Colada de lava compacta con superficie lisa y homogénea.","en":"A compact lava flow with a smooth and homogeneous surface."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/colada-meteorizada-o-degradada","prefLabel":{"es":"colada meteorizada o degradada","en":"weathered or degraded lava flow"},"definition":{"es":"Colada de lava cuya superficie ha sido alterada por meteorización.","en":"A lava flow whose surface has been altered by weathering."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cono-de-piroclastos","prefLabel":{"es":"cono de piroclastos","en":"pyroclastic cone"},"definition":{"es":"Edificio volcánico formado por acumulación de piroclastos alrededor de un centro de emisión.","en":"A volcanic edifice formed by accumulation of pyroclastic material around an emission centre."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cono-de-piroclastos-alomado-cabezo","prefLabel":{"es":"cono de piroclastos alomado; cabezo","en":"rounded pyroclastic cone"},"definition":{"es":"Cono de piroclastos con forma redondeada por degradación avanzada.","en":"A pyroclastic cone with a rounded shape due to advanced degradation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cono-de-piroclastos-degradado-con-centro-de-emision","prefLabel":{"es":"cono de piroclastos degradado con centro de emisión","en":"degraded pyroclastic cone with emission centre"},"definition":{"es":"Cono de piroclastos cuya morfología ha sido degradada por erosión, conservando el centro de emisión.","en":"A pyroclastic cone whose morphology has been degraded by erosion, preserving the emission centre."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cono-volcanico-con-crater","prefLabel":{"es":"cono volcánico con cráter","en":"volcanic cone with crater"},"definition":{"es":"Edificio volcánico cónico que conserva su cráter en la cima.","en":"A conical volcanic edifice that preserves its summit crater."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/crater","prefLabel":{"es":"cráter","en":"crater"},"definition":{"es":"Depresión circular o subcircular en la cima de un edificio volcánico.","en":"A circular or subcircular depression at the summit of a volcanic edifice."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/crater-activo","prefLabel":{"es":"cráter activo","en":"active crater"},"definition":{"es":"Cráter volcánico con actividad fumarólica, sísmica o eruptiva actual.","en":"A volcanic crater with current fumarolic, seismic or eruptive activity."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/crater-con-lago","prefLabel":{"es":"cráter con lago","en":"crater lake"},"definition":{"es":"Cráter volcánico que contiene un lago.","en":"A volcanic crater containing a lake."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/crater-inactivo","prefLabel":{"es":"cráter inactivo","en":"inactive crater"},"definition":{"es":"Cráter volcánico sin actividad actual.","en":"A volcanic crater without current activity."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/crater-de-domo-colada","prefLabel":{"es":"cráter de domo-colada","en":"dome-flow crater"},"definition":{"es":"Cráter asociado a un domo volcánico y sus coladas asociadas.","en":"A crater associated with a volcanic dome and its associated flows."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/crater-de-explosion","prefLabel":{"es":"cráter de explosión","en":"explosion crater"},"definition":{"es":"Depresión circular o subcircular producida por una explosión volcánica.","en":"A circular or subcircular depression produced by a volcanic explosion."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/depresion-intralavica","prefLabel":{"es":"depresión intralávica","en":"intralava depression"},"definition":{"es":"Depresión formada dentro de una colada de lava por colapso o deflación.","en":"A depression formed within a lava flow by collapse or deflation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/direccion-de-flujo-de-lava","prefLabel":{"es":"dirección de flujo de lava","en":"lava flow direction"},"definition":{"es":"Indicación de la dirección de movimiento de una colada de lava.","en":"Indication of the direction of movement of a lava flow."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/disyuncion-columnar","prefLabel":{"es":"disyunción columnar","en":"columnar jointing"},"definition":{"es":"Fracturación en columnas prismáticas de rocas volcánicas por enfriamiento.","en":"Prismatic columnar fracturing of volcanic rocks due to cooling."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo","prefLabel":{"es":"domo","en":"dome"},"definition":{"es":"Elevación redondeada formada por extrusión de lava viscosa.","en":"A rounded elevation formed by extrusion of viscous lava."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo-endogeno","prefLabel":{"es":"domo endógeno","en":"endogenous dome"},"definition":{"es":"Domo volcánico formado por inyección de magma que levanta las capas superficiales.","en":"A volcanic dome formed by magma injection that uplifts surface layers."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo-exogeno","prefLabel":{"es":"domo exógeno","en":"exogenous dome"},"definition":{"es":"Domo volcánico formado por extrusión de lava en superficie.","en":"A volcanic dome formed by lava extrusion at the surface."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo-volcanico","prefLabel":{"es":"domo volcánico","en":"dome"},"definition":{"es":"Elevación redondeada formada por extrusión de lava viscosa.","en":"A rounded elevation formed by extrusion of viscous lava."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe-frente-de-colada","prefLabel":{"es":"escarpe; frente de colada","en":"scarp; lava flow front"},"definition":{"es":"Frente o borde abrupto de una colada de lava.","en":"The front or abrupt edge of a lava flow."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fisura","prefLabel":{"es":"fisura","en":"fissure"},"definition":{"es":"Fractura abierta en un edificio volcánico por la que puede producirse emisión de lava o gases.","en":"An open fracture in a volcanic edifice through which lava or gases may be emitted."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fisura-con-fumarola-emergente","prefLabel":{"es":"fisura con fumarola emergente","en":"fissure with active fumarole"},"definition":{"es":"Fractura volcánica con emisión activa de gases y vapor.","en":"A volcanic fracture with active gas and steam emission."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fuente-termal","prefLabel":{"es":"fuente termal","en":"thermal spring"},"definition":{"es":"Manantial de agua calentada por actividad geotérmica.","en":"A spring of water heated by geothermal activity."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/geiser","prefLabel":{"es":"geiser","en":"geyser"},"definition":{"es":"Fuente termal que emite periódicamente chorros de agua caliente y vapor.","en":"A thermal spring that periodically emits jets of hot water and steam."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/gruta-jameo","prefLabel":{"es":"gruta; jameo","en":"grotto; jameo"},"definition":{"es":"Cavidad de origen volcánico, frecuentemente asociada a un tubo de lava colapsado.","en":"A cavity of volcanic origin, frequently associated with a collapsed lava tube."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/hornito","prefLabel":{"es":"hornito","en":"hornito"},"definition":{"es":"Pequeño montículo de lava proyectada formado sobre una colada.","en":"A small mound of ejected lava formed on a flow."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/hundimiento-subsidencia","prefLabel":{"es":"hundimiento; subsidencia","en":"collapse; subsidence"},"definition":{"es":"Descenso del terreno por colapso o subsidencia de origen volcánico.","en":"Ground lowering by collapse or subsidence of volcanic origin."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/meteorizacion-fumarolica","prefLabel":{"es":"meteorización fumarólica","en":"fumarolic weathering"},"definition":{"es":"Alteración de la roca volcánica por acción de gases fumarólicos.","en":"Alteration of volcanic rock by fumarolic gas action."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/muro-o-dique-lateral-de-enfriamiento-levee","prefLabel":{"es":"muro o dique lateral de enfriamiento; levée","en":"lateral cooling levee"},"definition":{"es":"Dique lateral formado por enfriamiento del borde de una colada de lava.","en":"A lateral dyke formed by cooling of the edge of a lava flow."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ojivas-de-presion","prefLabel":{"es":"ojivas de presión","en":"pressure ridges"},"definition":{"es":"Crestas arqueadas en la superficie de una colada de lava causadas por presión interna.","en":"Arched ridges on a lava flow surface caused by internal pressure."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/piton-aguja-necks","prefLabel":{"es":"pitón; aguja; necks","en":"volcanic plug; neck"},"definition":{"es":"Masa de lava solidificada en el interior de la chimenea volcánica expuesta por erosión.","en":"A mass of solidified lava in the volcanic chimney exposed by erosion."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/resalte-de-diques","prefLabel":{"es":"resalte de diques","en":"dyke ridge"},"definition":{"es":"Resalte topográfico causado por erosión diferencial de un dique volcánico resistente.","en":"A topographic ridge caused by differential erosion of a resistant volcanic dyke."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/resalte-de-diques-volcanico","prefLabel":{"es":"resalte de diques volcánico","en":"dyke ridge"},"definition":{"es":"Resalte topográfico causado por erosión diferencial de un dique volcánico resistente.","en":"A topographic ridge caused by differential erosion of a resistant volcanic dyke."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ruptura-de-pendiente-cascada-en-colada","prefLabel":{"es":"ruptura de pendiente; cascada en colada","en":"slope break; lava cascade"},"definition":{"es":"Cambio brusco de pendiente en una colada de lava.","en":"An abrupt slope change in a lava flow."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/ruptura-de-pendiente-debido-a-reflejos-de-antiguos-bordes-de-crateres","prefLabel":{"es":"ruptura de pendiente debido a reflejos de antiguos bordes de cráteres","en":"slope break due to ancient crater rim remnants"},"definition":{"es":"Cambio de pendiente asociado a restos de antiguos bordes de cráteres volcánicos.","en":"Slope change associated with remnants of ancient volcanic crater rims."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-apilamiento-con-indicacion-de-inclinacion-de-la-misma","prefLabel":{"es":"superficie de apilamiento con indicación de inclinación de la misma","en":"stacking surface with dip indication"},"definition":{"es":"Superficie de contacto entre coladas o unidades volcánicas apiladas con indicación de su inclinación.","en":"Contact surface between stacked lava flows or volcanic units with dip indication."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/surgencia-lavica-bajo-colada-solidificada","prefLabel":{"es":"surgencia lávica bajo colada solidificada","en":"lava upwelling beneath solidified flow"},"definition":{"es":"Salida de lava fluida bajo la costra solidificada de una colada.","en":"Fluid lava emerging beneath the solidified crust of a flow."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/trazas-resaltes-de-capas-en-apilamientos-volcanicos-inclinados","prefLabel":{"es":"trazas, resaltes de capas en apilamientos volcánicos inclinados","en":"layer traces in inclined volcanic stacks"},"definition":{"es":"Resaltes topográficos de capas en secuencias volcánicas inclinadas.","en":"Topographic ledges of layers in inclined volcanic sequences."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/trazas-resaltes-de-capas-en-apilamientos-volcanicos-subhorizontales","prefLabel":{"es":"trazas, resaltes de capas en apilamientos volcánicos subhorizontales","en":"layer traces in subhorizontal volcanic stacks"},"definition":{"es":"Resaltes topográficos de capas en secuencias volcánicas subhorizontales.","en":"Topographic ledges of layers in subhorizontal volcanic sequences."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/tunel-de-lava","prefLabel":{"es":"túnel de lava","en":"lava tube"},"definition":{"es":"Conducto subterráneo formado por el flujo de lava bajo una costra solidificada.","en":"An underground conduit formed by lava flowing beneath a solidified crust."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/volcan-de-barro","prefLabel":{"es":"volcán de barro","en":"mud volcano"},"definition":{"es":"Estructura formada por emisión de barro, agua y gases a la superficie.","en":"A structure formed by the emission of mud, water and gases at the surface."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/volcan-de-barro-con-deposito-fangoso","prefLabel":{"es":"volcán de barro con depósito fangoso","en":"mud volcano with mud deposit"},"definition":{"es":"Volcán de barro con acumulación visible de depósitos fangosos.","en":"A mud volcano with visible accumulation of muddy deposits."}}]}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/pedimento","prefLabel":{"es":"pedimento","en":"pediment"},"definition":{"es":"Superficie erosiva de baja pendiente desarrollada al pie de un relieve montañoso, generalmente con un perfil algo cóncavo hacia arriba, que corta los estratos de roca o de sedimentos que se extienden bajo las tierras altas adyacentes.","en":"A gently sloping erosional surface developed at the foot of a receding hill or mountain slope, commonly with a slightly concave-upward profile, that cross-cuts rock or sediment strata that extend beneath adjacent uplands."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/pendiente-de-cabecera","prefLabel":{"es":"pendiente de cabecera","en":"head slope"},"definition":{"es":"Elemento geomorfológico de una colina constituido por un área de la ladera lateralmente cóncava, especialmente en la cabecera de una vía de drenaje, que determina que las corrientes de agua sean convergentes.","en":"A geomorphologic component of hills consisting of a laterally concave area of a hillside, especially at the head of a drainage way, resulting in converging overland water flow."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/relicto","prefLabel":{"es":"relicto","en":"relic"},"definition":{"es":"Forma de relieve que ha sobrevivido a la degradación o desintegración, o que ha permanecido tras desaparecer la mayor parte del material subyacente, como por ejemplo, un monte isla.","en":"A landform that has survived decay or disintegration, or one that has been left behind after the disappearance of the greater part of its substance such as a remnant island."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion","prefLabel":{"es":"superficie de erosión","en":"erosion surface"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relacionados predominantemente con la erosión del agua, con exclusión de las corrientes canalizadas perennes (es decir, fluviales, glaciofluviales), o a la erosión eólica.","en":"Geomorphologic landscapes and landforms related dominantly to water erosion but excluding perennial channel flow (i.e. fluvial, glaciofluvial) or eolian erosion."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-conico","prefLabel":{"es":"cerro cónico","en":"conical hill"},"definition":{"es":"Elevación del terreno de forma cónica.","en":"A conical terrain elevation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-conico-poligenetico","prefLabel":{"es":"cerro cónico poligenético","en":"conical hill"},"definition":{"es":"Elevación del terreno de forma cónica.","en":"A conical terrain elevation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-ruiniforme-caos-de-bloques","prefLabel":{"es":"cerro ruiniforme poligenetico","en":"ruiniform hill; block chaos"},"altLabel":{"es":["caos de bloques"]},"definition":{"es":"Relieve con aspecto de ruinas por meteorización y desmantelamiento.","en":"Relief with a ruin-like appearance due to weathering and dismantling."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/collado","prefLabel":{"es":"collado; puerto; col","en":"pass; col"},"definition":{"es":"Depresión en una divisoria que permite el paso.","en":"A depression in a divide allowing passage."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/collado-poligenetico","prefLabel":{"es":"collado poligenetico","en":"pass; col"},"altLabel":{"es":["puerto; col"]},"definition":{"es":"Depresión en una divisoria que permite el paso.","en":"A depression in a divide allowing passage."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/depresion-cerrada-o-semicerrada-de-origen-mixto","prefLabel":{"es":"depresión cerrada o semicerrada de origen mixto","en":"closed or semi-closed depression of mixed origin"},"definition":{"es":"Depresión topográfica cerrada originada por procesos múltiples.","en":"Closed topographic depression originated by multiple processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo","prefLabel":{"es":"domo","en":"dome"},"definition":{"es":"Elevación redondeada formada por extrusión de lava viscosa.","en":"A rounded elevation formed by extrusion of viscous lava."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo-endogeno","prefLabel":{"es":"domo endógeno","en":"endogenous dome"},"definition":{"es":"Domo volcánico formado por inyección de magma que levanta las capas superficiales.","en":"A volcanic dome formed by magma injection that uplifts surface layers."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo-exogeno","prefLabel":{"es":"domo exógeno","en":"exogenous dome"},"definition":{"es":"Domo volcánico formado por extrusión de lava en superficie.","en":"A volcanic dome formed by lava extrusion at the surface."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe","prefLabel":{"es":"escarpe","en":"scarp"},"definition":{"es":"Talud abrupto de origen poligénico.","en":"An abrupt slope of polygenetic origin."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fondo-de-valle-de-origen-mixto","prefLabel":{"es":"fondo de valle de origen mixto","en":"mixed-origin valley floor"},"definition":{"es":"Fondo de valle formado por procesos fluviales y gravitacionales combinados.","en":"Valley floor formed by combined fluvial and gravitational processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-cobertera-pedimento-cubierto-glacis-mixto","prefLabel":{"es":"glacis de cobertera; pedimento cubierto; glacis mixto","en":"covered glacis; covered pediment"},"definition":{"es":"Glacis cubierto por un manto delgado de sedimentos.","en":"A glacis covered by a thin mantle of sediments."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-cobertera-degradado-o-disectado","prefLabel":{"es":"glacis de cobertera degradado o disectado","en":"degraded or dissected covered glacis"},"definition":{"es":"Glacis de cobertera incidido por cauces.","en":"A covered glacis incised by channels."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-erosion-pediment","prefLabel":{"es":"glacis de erosión; pediment","en":"erosion glacis; pediment"},"definition":{"es":"Superficie suavemente inclinada de erosión al pie de un relieve.","en":"Gently inclined erosion surface at the foot of a relief."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-erosion-degradado","prefLabel":{"es":"glacis de erosión degradado","en":"degraded erosion glacis"},"definition":{"es":"Glacis de erosión modificado por procesos erosivos posteriores.","en":"An erosion glacis modified by subsequent erosional processes."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-vertiente-glacis-coluvial","prefLabel":{"es":"glacis de vertiente; glacis coluvial","en":"slope glacis; colluvial glacis"},"definition":{"es":"Glacis formado por depósitos coluviales al pie de una vertiente.","en":"A glacis formed by colluvial deposits at the foot of a slope."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/hombrera","prefLabel":{"es":"hombrera; rellano","en":"shoulder; bench"},"definition":{"es":"Superficie subhorizontal que interrumpe una pendiente.","en":"A subhorizontal surface interrupting a slope."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/hombrera-poligenetica","prefLabel":{"es":"hombrera poligenética","en":"shoulder; bench"},"definition":{"es":"Superficie subhorizontal que interrumpe una pendiente.","en":"A subhorizontal surface interrupting a slope."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monte-isla-relieve-aislado-inselberg","prefLabel":{"es":"monte isla, relieve aislado; inselberg","en":"inselberg"},"definition":{"es":"Relieve aislado de paredes empinadas que se eleva sobre una llanura.","en":"Isolated steep-walled relief rising above a plain."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monte-isla-con-acanaladuras","prefLabel":{"es":"monte isla con acanaladuras","en":"fluted inselberg"},"definition":{"es":"Inselberg con surcos verticales en sus paredes.","en":"An inselberg with vertical grooves on its walls."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monte-isla-con-derrubios","prefLabel":{"es":"monte isla con derrubios","en":"debris-mantled inselberg"},"definition":{"es":"Inselberg parcialmente cubierto por derrubios.","en":"An inselberg partially covered by debris."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monte-isla-con-descamacion","prefLabel":{"es":"monte isla con descamación","en":"exfoliating inselberg"},"definition":{"es":"Inselberg con descamación de la roca en láminas.","en":"An inselberg with rock exfoliation in sheets."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monte-isla-de-cumbre-plana","prefLabel":{"es":"monte isla de cumbre plana","en":"flat-topped inselberg"},"definition":{"es":"Inselberg con la cima aplanada.","en":"An inselberg with a flattened summit."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monte-isla-lineal-cresta-barra","prefLabel":{"es":"monte isla lineal; cresta; barra","en":"linear inselberg; ridge"},"definition":{"es":"Inselberg de forma alargada y estrecha.","en":"An elongated and narrow inselberg."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/monticulo-loma","prefLabel":{"es":"montículo; loma","en":"hillock; knoll"},"definition":{"es":"Pequeña elevación suave del terreno.","en":"A small gentle terrain elevation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/otros-depositos","prefLabel":{"es":"otros depósitos","en":"other deposits"},"definition":{"es":"Depósitos no clasificados en las categorías anteriores.","en":"Deposits not classified in the previous categories."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/pico-principal-aguja-horn","prefLabel":{"es":"pico principal; aguja; horn","en":"main peak; horn"},"definition":{"es":"Cima aguda y prominente en un relieve poligénico.","en":"Sharp and prominent summit in a polygenetic relief."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/reborde-de-deposito-glacis","prefLabel":{"es":"reborde de depósito (glacis)","en":"deposit edge (glacis)"},"definition":{"es":"Borde de un depósito de glacis o piedemonte.","en":"Edge of a glacis or piedmont deposit."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/relieve-residual-monadnok","prefLabel":{"es":"relieve residual; monadnok","en":"residual relief; monadnock"},"definition":{"es":"Relieve aislado que sobresale de una superficie de erosión.","en":"Isolated relief rising above an erosion surface."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-cumbres-cresta-apalachiana","prefLabel":{"es":"superficie de cumbres; cresta apalachiana","en":"summit surface; Appalachian ridge"},"definition":{"es":"Superficie de cumbres que mantiene una altitud homogénea.","en":"A summit surface maintaining a homogeneous altitude."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/superficie-de-erosion","prefLabel":{"es":"superficie de erosión","en":"erosion surface"},"definition":{"es":"Paisajes geomorfológicos y formas del relieve relacionados predominantemente con la erosión del agua, con exclusión de las corrientes canalizadas perennes (es decir, fluviales, glaciofluviales), o a la erosión eólica.","en":"Geomorphologic landscapes and landforms related dominantly to water erosion but excluding perennial channel flow (i.e. fluvial, glaciofluvial) or eolian erosion."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-conico","prefLabel":{"es":"cerro cónico","en":"conical hill"},"definition":{"es":"Elevación del terreno de forma cónica.","en":"A conical terrain elevation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-conico-poligenetico","prefLabel":{"es":"cerro cónico poligenético","en":"conical hill"},"definition":{"es":"Elevación del terreno de forma cónica.","en":"A conical terrain elevation."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/cerro-ruiniforme-caos-de-bloques","prefLabel":{"es":"cerro ruiniforme poligenetico","en":"ruiniform hill; block chaos"},"altLabel":{"es":["caos de bloques"]},"definition":{"es":"Relieve con aspecto de ruinas por meteorización y desmantelamiento.","en":"Relief with a ruin-like appearance due to weathering and dismantling."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/collado","prefLabel":{"es":"collado; puerto; col","en":"pass; col"},"definition":{"es":"Depresión en una divisoria que permite el paso.","en":"A depression in a divide allowing passage."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/collado-poligenetico","prefLabel":{"es":"collado poligenetico","en":"pass; col"},"altLabel":{"es":["puerto; col"]},"definition":{"es":"Depresión en una divisoria que permite el paso.","en":"A depression in a divide allowing passage."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/depresion-cerrada-o-semicerrada-de-origen-mixto","prefLabel":{"es":"depresión cerrada o semicerrada de origen mixto","en":"closed or semi-closed depression of mixed origin"},"definition":{"es":"Depresión topográfica cerrada originada por procesos múltiples.","en":"Closed topographic depression originated by multiple processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo","prefLabel":{"es":"domo","en":"dome"},"definition":{"es":"Elevación redondeada formada por extrusión de lava viscosa.","en":"A rounded elevation formed by extrusion of viscous lava."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo-endogeno","prefLabel":{"es":"domo endógeno","en":"endogenous dome"},"definition":{"es":"Domo volcánico formado por inyección de magma que levanta las capas superficiales.","en":"A volcanic dome formed by magma injection that uplifts surface layers."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/domo-exogeno","prefLabel":{"es":"domo exógeno","en":"exogenous dome"},"definition":{"es":"Domo volcánico formado por extrusión de lava en superficie.","en":"A volcanic dome formed by lava extrusion at the surface."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/escarpe","prefLabel":{"es":"escarpe","en":"scarp"},"definition":{"es":"Talud abrupto de origen poligénico.","en":"An abrupt slope of polygenetic origin."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/fondo-de-valle-de-origen-mixto","prefLabel":{"es":"fondo de valle de origen mixto","en":"mixed-origin valley floor"},"definition":{"es":"Fondo de valle formado por procesos fluviales y gravitacionales combinados.","en":"Valley floor formed by combined fluvial and gravitational processes."}},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-cobertera-pedimento-cubierto-glacis-mixto","prefLabel":{"es":"glacis de cobertera; pedimento cubierto; glacis mixto","en":"covered glacis; covered pediment"},"definition":{"es":"Glacis cubierto por un manto delgado de sedimentos.","en":"A glacis covered by a thin mantle of sediments."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-cobertera-degradado-o-disectado","prefLabel":{"es":"glacis de cobertera degradado o disectado","en":"degraded or dissected covered glacis"},"definition":{"es":"Glacis de cobertera incidido por cauces.","en":"A covered glacis incised by channels."}}]},{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-erosion-pediment","prefLabel":{"es":"glacis de erosión; pediment","en":"erosion glacis; pediment"},"definition":{"es":"Superficie suavemente inclinada de erosión al pie de un relieve.","en":"Gently inclined erosion surface at the foot of a relief."},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/geomorfologia-tipo-natural/glacis-de-erosion-degradado","prefLabel":{"es":"glacis de erosión degradado","en":"degraded erosion glacis"},"definition":{"es":"Glacis de erosión modificado por procesos erosivos posteriores.","en":