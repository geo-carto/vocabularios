{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo","type":"ConceptScheme","prefLabel":{"en":"Alteration type","es":"Tipo de alteración"},"description":{"es":"Término de un vocabulario controlado de tipos de alteración (por ejemplo, potásica, argílica, argílica avanzada)."},"publisher":{"id":"https://www.igme.es/"},"created":"2026-03-01","modified":"2026-03-01","creator":"https://www.igme.es","provenance":"Términos propios definidos por el IGME","versionInfo":"1.0.0","license":{"id":"https://creativecommons.org/licenses/by/4.0/"},"hasTopConcept":[{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo/alteracion-no-especificada","prefLabel":{"en":"alteration type not specified","es":"alteración no especificada"},"definition":{"en":"Rock is altered, but type not specified. Any alteration type allowed","es":"La roca está alterada, pero el tipo de alteración no está especificada"},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo/meteorizacion","prefLabel":{"en":"weathering","es":"meteorización"},"definition":{"en":"Group of physical, chemical and biological processes by which a rock, sediment or soil, near the Earth's surface, are changed in color, texture, composition, firmness or form, with little or no transport of the altered material.","es":"Conjunto de procesos físicos, químicos y biológicos por los que una roca, sedimento o suelo, próximo a la superficie terrestre, cambia su color, textura, composición, resistencia o forma, sin o escaso transporte de los materiales alterados"},"narrower":[{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo/arenizacion","prefLabel":{"en":"arenization","es":"arenización"},"definition":{"en":"Weathering process that disaggregates coarsed-grained rocks (> 0,1 mm) into minerals and rock fragments with no cohesion. The products, may or may not be silica-enriched, are usually known as grus, grus saprolites, sandy saprolites, grus mantles, arenaceous mantles or lem when the weathering is mainly physical (Migón, 2004), growan, jabre or xabre when it is chemical (Vidal Romaní and Twidale, 1998), or arenes when they are derived from plutonic rocks, mainly granites and diorites (Campy and Macaire, 1989).","es":"Proceso de meteorización que disgrega rocas de grano grueso (> 0,1 mm) en minerales y fragmentos de rocas sin cohesión. Los residuos, enriquecidos o no en sílice, se suelen denominar grus, grus saprolites, sandy saprolites, grus mantles, arenaceous mantles o lem cuando la meteorización es fundamentalmente física (Migon, 2004), growan, jabre o xabre cuando es química (Vidal Romaní y Twidale, 1998), o arenes cuando derivan de rocas plutónicas, fundamentalmente granitos y dioritas (Campy y Macaire, 1989)"}},{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo/argilizacion","prefLabel":{"en":"argillation","es":"argilización"},"definition":{"en":"Transformation of minerals, especially feldespars and other silicates, into clay minerals.","es":"Transformación de minerales, especialmente feldespatos y otros silicatos, en minerales arcillosos"}},{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo/caolinizacion","prefLabel":{"en":"kaolinitation","es":"caolinización"},"definition":{"en":"Transformation of minerals, especially feldespars and other silicates into kaolinite-group clay minerals.","es":"Transformación de minerales, especialmente feldespatos y otros silicatos, en minerales arcillosos del grupo de la caolinita."}},{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo/carbonatacion","prefLabel":{"en":"carbonation","es":"carbonatación"},"definition":{"en":"Transformation of calcium, magnesium, sodium, potassium or iron minerals into carbonates or bicarbonates, by carbon dioxide contained in water.","es":"Transformación de minerales de calcio, magnesio, sodio, potasio o hierro en carbonatos o bicarbonatos, debido a la acción del dióxido de carbono contenido en el agua"}},{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo/ferruginizacion","prefLabel":{"en":"ferrugination","es":"ferruginización"},"definition":{"en":"Enrichment of a rock, sediment or soil in iron.","es":"Enriquecimiento de una roca, sedimento o suelo en hierro"}},{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo/silicificacion","prefLabel":{"en":"silification","es":"silicificación"},"definition":{"en":"Enrichment of a rock, sediment or soil in silica.","es":"Enriquecimiento de una roca, sedimento o suelo en sílice"}}]}]},{"id":"https://geo-carto.github.io/vocabularios/alteracion-tipo/no-alterada","prefLabel":{"en":"not altered","es":"no alterada"},"definition":{"en":"Rock es not altered","es":"La roca no está alterada"}}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","contributor":"dct:contributor","provenance":"dct:provenance","publisher":"dct:publisher","versionInfo":"owl:versionInfo","status":{"@id":"http://www.w3.org/ns/adms#status"},"preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container":"@language"},"narrower":{"@container":"@set"},"related":{"@container":"@set"},"relatedMatch":{"@container":"@set"},"narrowerTransitive":{"@container":"@set"},"broaderTransitive":{"@container":"@set"},"broadMatch":{"@container":"@set"},"narrowMatch":{"@container":"@set"},"closeMatch":{"@container":"@set"},"exactMatch":{"@container":"@set"},"hasTopConcept":{"@container":"@set"},"inScheme":{"@container":"@set"},"topConceptOf":{"@container":"@set"},"deprecated":{"@id":"owl:deprecated","@type":"xsd:boolean"},"isReplacedBy":{"@id":"dct:isReplacedBy","@container":"@set"}}}